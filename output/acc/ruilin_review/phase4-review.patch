@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {normalizeReport, buildGuidIndex, summarize, verdictStatus, escapeHtml, formatNumber, clearanceBarPercent} from '../result-data.js';
+const sha = 'a'.repeat(64);
+const row = (extra={}) => ({entity_ids:['A','B'],clause:'IBC2021-1208.2',regulation_excerpt:'Source text',verdict:'pass',measured_value:{value:2.3,unit:'m'},threshold:{value:2286,unit:'mm'}, ...extra});
+const sheet = rows => ({contract_version:2,model:{sha256:sha},inputs:[{trust_tier:'quarantine'}],results:rows});
+const options = {expectedModelSha256:sha};
+
+test('v2 model identity and pending-rule disclosure', () => {
+  const result = normalizeReport(sheet([row()]),options);
+  assert.match(result.provenance,/below gold/);
+  assert.equal(result.rows[0].threshold.unit,'m');
+  assert.equal(result.rows[0].threshold.value,2.286);
+  assert.equal(result.rows[0].verdict,'pass');
+  assert.throws(()=>normalizeReport(sheet([row()]),{expectedModelSha256:'b'.repeat(64)}));
+  assert.throws(()=>normalizeReport(sheet([row()])));
+});
+test('legacy array requires explicit demo provenance', () => {
+  assert.throws(()=>normalizeReport([row()]));
+  assert.match(normalizeReport([row()],{legacyDemo:true}).provenance,/DEMO/);
+});
+test('all targets and multiple rules survive reverse indexing', () => {
+  const a=row(), b=row({clause:'second rule',governing:{guid:'C',ifc_class:'IfcBeam'},contributing_elements:[{guid:'B',ifc_class:'IfcSpace'}]});
+  const index=buildGuidIndex([a,b]);
+  assert.deepEqual(index.get('B'),[a,b]);
+  assert.deepEqual(index.get('C'),[b]);
+});
+test('exempt and undecided never counted as pass', () => {
+  const counts=summarize(['pass','fail','exempt','alert','not-found','not-supported'].map(verdict=>row({verdict})));
+  assert.deepEqual(counts,{pass:1,fail:1,exempt:1,warn:3,completion_rate:0.4,pass_rate:0.5});
+  assert.equal(verdictStatus('exempt'),'exempt');
+  assert.equal(summarize([row({verdict:'exempt'})]).pass_rate,null);
+});
+test('geometry units convert independently from quantities', () => {
+  const r=normalizeReport(sheet([row({measurement_geometry:{point:[1,2,3],reference_point:[1,2,0],unit:'m'}})]),options).rows[0];
+  assert.deepEqual(r.measurement_geometry.point,[1000,2000,3000]);
+  assert.equal(r.measurement_geometry.unit,'mm');
+});
+test('invalid shape, verdict, quantities, identities and points fail visibly', () => {
+  for(const bad of [{verdict:'unknown'},{entity_ids:[]},{governing:{}},{contributing_elements:[null]},{measured_value:{value:Infinity,unit:'mm'}},{threshold:{value:1,unit:'count'}},{measurement_geometry:{point:[0,NaN,0],unit:'mm'}}]) {
+    assert.throws(()=>normalizeReport(sheet([row(bad)]),options));
+  }
+  assert.throws(()=>normalizeReport({results:[]},options));
+});
+test('imported text cannot become HTML markup',()=>{
+  assert.equal(escapeHtml('<img onerror="bad">&\''),'&lt;img onerror=&quot;bad&quot;&gt;&amp;&#39;');
+});
+
+test('display rounding and the 120-percent bar use the same threshold scale',()=>{
+ assert.equal(formatNumber(1600-2133.6),'-533.6');
+ assert.ok(Math.abs(clearanceBarPercent(2286,2286)-100/1.2)<1e-10);
+ assert.equal(clearanceBarPercent(2400,2000),100);
+ assert.equal(clearanceBarPercent(null,null),0);
+});
