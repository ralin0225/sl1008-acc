@@ -0,0 +1,76 @@
+// Data boundary for Phase 4. No DOM/WebGL dependency; no verdict recomputation.
+const VERDICTS = new Set(['pass','fail','exempt','alert','not-found','not-supported']);
+const LENGTH = {mm: 1, m: 1000};
+const fail = message => { throw new Error(message); };
+export const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+export const verdictStatus = value => value === 'exempt' ? 'exempt' : value === 'pass' || value === 'fail' ? value : 'warn';
+
+function quantity(q) {
+  if (!q || !Object.hasOwn(q, 'value')) fail('Missing quantity');
+  if (q.value !== null && (typeof q.value !== 'number' || !Number.isFinite(q.value))) fail('Invalid quantity');
+  if (![null,'mm','m','m2','count','deg'].includes(q.unit)) fail('Unsupported quantity unit');
+  return {...q};
+}
+
+export function normalizeReport(data, {expectedModelSha256, legacyDemo = false} = {}) {
+  let rows, provenance;
+  if (Array.isArray(data)) {
+    if (!legacyDemo) fail('Legacy rows have no model identity; explicit demo mode required');
+    rows = data;
+    provenance = 'DEMO: hand-written legacy rows; not engine output or human-verified evidence.';
+  } else {
+    if (!data || data.contract_version !== 2 || !Array.isArray(data.results)) fail('Invalid v2 result sheet');
+    if (!/^[a-f0-9]{64}$/.test(expectedModelSha256 || '') || data.model?.sha256 !== expectedModelSha256) fail('Result sheet does not match the configured source IFC');
+    rows = data.results;
+    const pending = Array.isArray(data.inputs) && data.inputs.some(i => i.trust_tier !== 'gold');
+    provenance = `Model-bound engine results; human verification not established.${pending ? ' Includes rules below gold trust tier.' : ''}`;
+  }
+  return {provenance, rows: rows.map(row => {
+    if (!row || !VERDICTS.has(row.verdict) || typeof row.clause !== 'string' || !row.clause.trim() || typeof row.regulation_excerpt !== 'string') fail('Invalid verdict or clause');
+    if (!Array.isArray(row.entity_ids) || row.entity_ids.some(id => typeof id !== 'string' || !id)) fail('Invalid entity identities');
+    if (row.verdict !== 'not-supported' && !row.entity_ids.length) fail('Missing target identity');
+    if (row.governing != null && (typeof row.governing.guid !== 'string' || typeof row.governing.ifc_class !== 'string')) fail('Invalid governing element');
+    if (row.contributing_elements != null && (!Array.isArray(row.contributing_elements) || row.contributing_elements.some(e => !e || typeof e.guid !== 'string' || typeof e.ifc_class !== 'string'))) fail('Invalid contributing elements');
+    const measured = quantity(row.measured_value), threshold = quantity(row.threshold);
+    // The clearance renderer computes a gap: put both quantities in the same unit.
+    if (measured.value != null && threshold.value != null && measured.unit !== threshold.unit) {
+      if (!LENGTH[measured.unit] || !LENGTH[threshold.unit]) fail('Incompatible comparison units');
+      threshold.value *= LENGTH[threshold.unit] / LENGTH[measured.unit];
+      threshold.unit = measured.unit;
+    }
+    let geometry = row.measurement_geometry;
+    if (geometry != null) {
+      if (!LENGTH[geometry.unit]) fail('Unsupported geometry unit');
+      const convert = point => {
+        if (!Array.isArray(point) || point.length !== 3 || point.some(v => typeof v !== 'number' || !Number.isFinite(v))) fail('Invalid measurement point');
+        return point.map(v => v * LENGTH[geometry.unit]);
+      };
+      geometry = {...geometry, point: convert(geometry.point), reference_point: geometry.reference_point ? convert(geometry.reference_point) : undefined, unit: 'mm'};
+    }
+    return {...row, measured_value: measured, threshold, measurement_geometry: geometry};
+  })};
+}
+
+export function buildGuidIndex(rows) {
+  const index = new Map();
+  for (const row of rows) {
+    const ids = new Set([...row.entity_ids, row.governing?.guid, ...(row.contributing_elements || []).map(e => e.guid)].filter(Boolean));
+    for (const id of ids) {
+      if (!index.has(id)) index.set(id, []);
+      index.get(id).push(row);
+    }
+  }
+  return index;
+}
+
+export function summarize(rows) {
+  const counts = {pass:0, fail:0, exempt:0, warn:0};
+  for (const row of rows) counts[verdictStatus(row.verdict)]++;
+  const decided = counts.pass + counts.fail, applicable = decided + counts.warn;
+  return {...counts, completion_rate: applicable ? decided/applicable : null, pass_rate: decided ? counts.pass/decided : null};
+}
+
+// Display rounding only; thresholds and verdicts are not changed.
+export const formatNumber = value => typeof value === 'number' ? new Intl.NumberFormat('en-US',{useGrouping:false,maximumFractionDigits:4}).format(value) : '—';
+
+export const clearanceBarPercent = (measured, threshold) => Number.isFinite(measured) && Number.isFinite(threshold) && threshold > 0 ? Math.max(0, Math.min(100, measured / (threshold * 1.2) * 100)) : 0;
