+// Set PLAYWRIGHT_MODULE to an installed Playwright package; serve the viewer on 8872.
+const {chromium}=require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const assert=require('node:assert/strict'), fs=require('node:fs'), path=require('node:path'), crypto=require('node:crypto');
+const root=path.resolve(__dirname,'..'), base=process.env.REVIEW_VIEWER_URL || 'http://127.0.0.1:8872/';
+const legacy=JSON.parse(fs.readFileSync(path.join(root,'results/result_sheet.json'),'utf8'));
+const sha=crypto.createHash('sha256').update(fs.readFileSync(path.join(root,'kitchen6_test.ifc'))).digest('hex');
+(async()=>{
+ const browser=await chromium.launch({channel:'msedge',headless:true,args:['--enable-unsafe-swiftshader']});
+ const page=await browser.newPage({viewport:{width:1440,height:1000}}), errors=[];
+ page.on('pageerror',e=>errors.push(e.message));
+ try {
+  await page.goto(base);
+  await page.locator('#dataStatus').filter({hasText:'DEMO:'}).waitFor();
+  await page.selectOption('#clauseSelect',legacy[0].clause);
+  assert.equal(await page.locator('.room-card').count(),2);
+  await page.locator('#loader.hidden').waitFor({timeout:60000});
+  await page.locator('.room-card').first().click();
+  assert.match(await page.locator('#detailContent').innerText(),/HAND-WRITTEN DEMO/);
+  if(process.env.REVIEW_SCREENSHOT_DIR) {
+   fs.mkdirSync(process.env.REVIEW_SCREENSHOT_DIR,{recursive:true});
+   await page.screenshot({path:path.join(process.env.REVIEW_SCREENSHOT_DIR,'phase4-review.png')});
+  }
+  await page.route('**/results/result_sheet.json',r=>r.fulfill({status:404,body:'missing'}));
+  await page.reload();
+  await page.locator('#dataStatus').filter({hasText:'No example verdicts substituted'}).waitFor();
+  assert.equal(await page.locator('.room-card').count(),0);
+  assert.equal(await page.locator('#clauseSelect').isDisabled(),true);
+  const rows=[{...legacy[0],verdict:'exempt',note:'<img src=x onerror="window.injected=1">',_room_name:'<b>Room</b>'},{...legacy[1],entity_ids:[...legacy[1].entity_ids,...legacy[0].entity_ids],clause:'SECOND RULE'}];
+  const report={contract_version:2,model:{sha256:sha},inputs:[{trust_tier:'quarantine'}],results:rows};
+  await page.unroute('**/results/result_sheet.json');
+  await page.route('**/results/result_sheet.json',r=>r.fulfill({json:report}));
+  await page.reload();
+  await page.locator('#dataStatus').filter({hasText:'below gold'}).waitFor();
+  await page.selectOption('#clauseSelect',rows[0].clause);
+  assert.match(await page.locator('#statsRow').innerText(),/0 passed/);
+  assert.match(await page.locator('#statsRow').innerText(),/1 exempt/);
+  assert.equal(await page.locator('#roomList img').count(),0);
+  assert.match(await page.locator('.room-name').innerText(),/<b>Room<\/b>/);
+  await page.locator('#loader.hidden').waitFor({timeout:60000});
+  await page.locator('.room-card').click();
+  assert.equal(await page.locator('#detailContent img').count(),0);
+  assert.equal(await page.evaluate(()=>window.injected),undefined);
+  report.model.sha256='0'.repeat(64);
+  await page.reload();
+  await page.locator('#dataStatus').filter({hasText:'does not match'}).waitFor();
+  assert.equal(await page.locator('.room-card').count(),0);
+  assert.deepEqual(errors,[]);
+  console.log(JSON.stringify({legacy_demo:true,missing_data_fails_closed:true,exempt_separate:true,escaped_imports:true,model_hash_guard:true,page_errors:errors}));
+ } finally {await browser.close();}
+})().catch(e=>{console.error(e.stack);process.exit(1)});
