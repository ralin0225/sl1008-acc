{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "const": "1.0.0"
          },
          "source_node_id": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "enum": [
              10,
              11
            ]
          },
          "topic": {
            "enum": [
              "Accessibility",
              "Egress"
            ]
          },
          "kind": {
            "enum": [
              "count",
              "topology",
              "information",
              "dimension"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_pdf": {
                "type": "string",
                "minLength": 1
              },
              "pdf_file": {
                "type": "string",
                "minLength": 1
              },
              "fragments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "pdf_page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source_pdf_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "pdf_page_number",
                    "source_pdf_page",
                    "bbox"
                  ]
                }
              },
              "context": {
                "type": "object"
              },
              "tables": {
                "type": "array"
              }
            },
            "required": [
              "text",
              "sha256",
              "source_pdf",
              "pdf_file",
              "fragments",
              "context",
              "tables"
            ]
          },
          "applicability": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "exceptions": {
                "type": "array"
              }
            },
            "required": [
              "method",
              "scope",
              "exceptions"
            ]
          },
          "required_ifc_data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "data_type": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "methods": {
                  "type": "array",
                  "minItems": 1
                },
                "entities": {
                  "type": "array",
                  "minItems": 1
                }
              },
              "required": [
                "field",
                "data_type",
                "unit",
                "methods",
                "entities"
              ]
            }
          },
          "target_selector": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "minItems": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "complete_inventory_required": {
                "const": true
              },
              "zero_targets_result": {
                "const": "NOT_CHECKABLE"
              }
            },
            "required": [
              "entities",
              "method",
              "complete_inventory_required",
              "zero_targets_result"
            ]
          },
          "check_function": {
            "enum": [
              "legacy_count",
              "legacy_connectivity",
              "required_information",
              "clear_width"
            ]
          },
          "parameters": {
            "type": "object",
            "properties": {
              "comparison": {
                "type": "string",
                "minLength": 1
              },
              "thresholds": {
                "type": "object"
              },
              "threshold_source": {
                "type": "string",
                "minLength": 1
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              },
              "tolerance_basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "comparison",
              "thresholds",
              "threshold_source",
              "tolerance",
              "tolerance_basis"
            ]
          },
          "result_scope": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "PENDING",
              "APPROVED"
            ]
          },
          "review_evidence": {
            "type": "array"
          },
          "execution_ready": {
            "type": "boolean"
          },
          "execution_gate": {
            "type": "string",
            "minLength": 1
          },
          "test_cases": {
            "type": "object"
          },
          "contract_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "full_clause_compliance_evaluated": {
            "const": false
          }
        },
        "required": [
          "rule_id",
          "rule_version",
          "source_node_id",
          "chapter",
          "topic",
          "kind",
          "evidence",
          "applicability",
          "required_ifc_data",
          "target_selector",
          "check_function",
          "parameters",
          "result_scope",
          "review_status",
          "review_evidence",
          "execution_ready",
          "execution_gate",
          "test_cases",
          "contract_sha256",
          "full_clause_compliance_evaluated"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "rules"
  ]
}
