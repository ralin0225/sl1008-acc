{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "full_clause_compliance_evaluated": {
      "const": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "rule_count": {
          "type": "integer",
          "minimum": 0
        },
        "instance_count": {
          "type": "integer",
          "minimum": 0
        },
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "NOT CHECKABLE": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_APPLICABLE": {
          "type": "integer",
          "minimum": 0
        },
        "completed_determination_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "determined_pass_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "rule_count",
        "instance_count",
        "PASS",
        "FAIL",
        "NOT CHECKABLE",
        "NOT_APPLICABLE",
        "completed_determination_rate",
        "determined_pass_rate"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "enum": [
              10,
              11
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "MANUAL_REVIEW",
              "CHECK_ERROR",
              "NOT_APPLICABLE"
            ]
          },
          "display_status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT CHECKABLE",
              "NOT_APPLICABLE"
            ]
          },
          "result_scope": {
            "type": "string",
            "minLength": 1
          },
          "full_clause_compliance_evaluated": {
            "const": false
          },
          "why": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_pdf": {
                "type": "string",
                "minLength": 1
              },
              "pdf_file": {
                "type": "string",
                "minLength": 1
              },
              "fragments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "pdf_page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source_pdf_page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "pdf_page_number",
                    "source_pdf_page",
                    "bbox"
                  ]
                }
              },
              "context": {
                "type": "object"
              },
              "tables": {
                "type": "array"
              },
              "source_node_id": {
                "type": "string",
                "minLength": 1
              },
              "rule_version": {
                "type": "string",
                "minLength": 1
              },
              "contract_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "applicability": {
                "type": "object"
              }
            },
            "required": [
              "text",
              "sha256",
              "source_pdf",
              "pdf_file",
              "fragments",
              "context",
              "tables",
              "source_node_id",
              "rule_version",
              "contract_sha256",
              "applicability"
            ]
          },
          "what": {
            "type": "object",
            "properties": {
              "check_function": {
                "type": "string",
                "minLength": 1
              },
              "required": {},
              "actual": {},
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "comparison": {
                "type": "string",
                "minLength": 1
              },
              "tolerance": {
                "type": "number"
              },
              "tolerance_basis": {
                "type": "string",
                "minLength": 1
              },
              "reason_code": {
                "enum": [
                  null,
                  "MISSING_DATA",
                  "INVALID_DATA",
                  "INVALID_GEOMETRY",
                  "UNKNOWN_APPLICABILITY",
                  "INCOMPLETE_TARGET_SET",
                  "UNRESOLVED_REFERENCE",
                  "REQUIRES_MANUAL_REVIEW",
                  "CHECK_ERROR"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "calculation": {
                "type": "object"
              }
            },
            "required": [
              "check_function",
              "required",
              "actual",
              "unit",
              "comparison",
              "tolerance",
              "tolerance_basis",
              "reason_code",
              "explanation",
              "calculation"
            ]
          },
          "where": {
            "type": "object",
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "global_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "global_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ifc_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "storey": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "location": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "step_id": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "global_id",
                    "ifc_type",
                    "name",
                    "storey",
                    "location",
                    "step_id"
                  ]
                }
              },
              "scope_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_binding": {
                "enum": [
                  "reviewed",
                  "candidate_unreviewed",
                  "excluded_reviewed",
                  "unavailable"
                ]
              },
              "camera": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "model_id",
              "model_sha256",
              "global_ids",
              "objects",
              "scope_id",
              "target_binding",
              "camera"
            ]
          },
          "run": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "checker_version": {
                "type": "string",
                "minLength": 1
              },
              "checker_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "review": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "facts": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "observations": {
                "type": "array"
              }
            },
            "required": [
              "run_id",
              "timestamp",
              "checker_version",
              "checker_sha256",
              "input_sha256",
              "review",
              "facts",
              "observations"
            ]
          }
        },
        "required": [
          "instance_id",
          "rule_id",
          "rule_version",
          "chapter",
          "topic",
          "status",
          "display_status",
          "result_scope",
          "full_clause_compliance_evaluated",
          "why",
          "what",
          "where",
          "run"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "display_status": {
                  "const": "NOT CHECKABLE"
                }
              }
            },
            "then": {
              "properties": {
                "what": {
                  "properties": {
                    "reason_code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "model_id",
    "model_sha256",
    "input_sha256",
    "is_synthetic",
    "full_clause_compliance_evaluated",
    "summary",
    "results"
  ]
}
