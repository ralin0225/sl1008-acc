ibc:ibc-2021-chapter-11-accessibility a ibco:Document ;
    rdfs:label "Accessibility" .

ibc:ibc2021-10 a ibco:ListItem ;
    ibco:bbox "[319.79, 630.812, 550.79, 652.754]" ;
    ibco:label "10" ;
    ibco:partOf ibc:ibc2021-9 ;
    ibco:precedes ibc:ibc2021-1110.10 ;
    ibco:sourcePage 369 ;
    ibco:text "10. An accessible route where existing exterior site constraints make use of a ramp or elevator infeasible." .

ibc:ibc2021-10-0297 a ibco:ListItem ;
    ibco:bbox "[58.769, 329.741, 289.651, 351.802]" ;
    ibco:label "10" ;
    ibco:partOf ibc:ibc2021-9-0296 ;
    ibco:precedes ibc:ibc2021-1112.2 ;
    ibco:sourcePage 373 ;
    ibco:text "10. In recreational facilities, lockers that are required to be accessible in accordance with Section 1110.10." .

ibc:ibc2021-1101.1 a ibco:Provision ;
    ibco:bbox "[61.197, 334.8, 304.258, 367.778]" ;
    ibco:heading "Scope" ;
    ibco:label "1101.1" ;
    ibco:partOf ibc:ibc2021-1101 ;
    ibco:precedes ibc:ibc2021-1102 ;
    ibco:sourcePage 356 ;
    ibco:text "1101.1 Scope. The provisions of this chapter shall control the design and construction of facilities for accessibility for individuals with disabilities." .

ibc:ibc2021-1102.1 a ibco:Provision ;
    ibco:bbox "[61.188, 414.829, 304.144, 447.806]" ;
    ibco:heading "Design" ;
    ibco:label "1102.1" ;
    ibco:partOf ibc:ibc2021-1102 ;
    ibco:precedes ibc:ibc2021-1103 ;
    ibco:sourcePage 356 ;
    ibco:text "1102.1 Design. Buildings and facilities shall be designed and constructed to be accessible in accordance with this code and ICC A117.1." .

ibc:ibc2021-1103.1 a ibco:Provision ;
    ibco:bbox "[61.188, 494.738, 304.332, 527.835]" ;
    ibco:heading "Where required" ;
    ibco:label "1103.1" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.1 Where required. Sites, buildings, structures, facilities, elements and spaces, temporary or permanent, shall be accessible to individuals with disabilities." .

ibc:ibc2021-1103.2 a ibco:Provision ;
    ibco:bbox "[61.188, 531.809, 304.171, 564.786]" ;
    ibco:heading "General exceptions" ;
    ibco:label "1103.2" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.1 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2 General exceptions. Sites, buildings, structures, facilities, elements and spaces shall be exempt from this chapter to the extent specified in this section." .

ibc:ibc2021-1103.2.1 a ibco:Provision ;
    ibco:bbox "[73.199, 568.76, 304.212, 601.738]" ;
    ibco:heading "Specific requirements" ;
    ibco:label "1103.2.1" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.2 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.1 Specific requirements. Accessibility is not required in buildings and facilities, or portions thereof, to the extent permitted by Sections 1104 through 1112." .

ibc:ibc2021-1103.2.10 a ibco:Provision ;
    ibco:bbox "[58.799, 117.712, 289.81, 161.725]" ;
    ibco:heading "Highway tollbooths" ;
    ibco:label "1103.2.10" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.11 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.10 Highway tollbooths. Highway tollbooths where the access is provided only by bridges above the vehicular traffic or underground tunnels are not required to comply with this chapter." .

ibc:ibc2021-1103.2.11 a ibco:Provision ;
    ibco:bbox "[58.799, 165.699, 289.811, 209.713]" ;
    ibco:heading "Residential Group R-1" ;
    ibco:label "1103.2.11" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.12 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.11 Residential Group R-1. Buildings of Group R-1 containing not more than five sleeping units for rent or hire that are also occupied as the residence of the proprietor are not required to comply with this chapter." .

ibc:ibc2021-1103.2.12 a ibco:Provision ;
    ibco:bbox "[58.799, 213.687, 289.776, 257.82]" ;
    ibco:heading "Day care facilities" ;
    ibco:label "1103.2.12" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.13 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.12 Day care facilities. Where a day care facility is part of a dwelling unit, only the portion of the structure utilized for the day care facility is required to comply with this chapter." .

ibc:ibc2021-1103.2.13 a ibco:Provision ;
    ibco:bbox "[58.789, 261.794, 289.797, 327.759]" ;
    ibco:heading "Detention and correctional facilities" ;
    ibco:label "1103.2.13" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.14 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.13 Detention and correctional facilities. In detention and correctional facilities, common use areas that are used only by inmates or detainees and security personnel, and that do not serve holding cells or housing cells required to be Accessible units, are not required to comply with this chapter." .

ibc:ibc2021-1103.2.14 a ibco:Provision ;
    ibco:bbox "[58.789, 331.733, 289.777, 364.71]" ;
    ibco:heading "Walk-in coolers and freezers" ;
    ibco:label "1103.2.14" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1104 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.14 Walk-in coolers and freezers. Walk-in cooler and freezer equipment accessed only from employee work areas is not required to comply with this chapter." .

ibc:ibc2021-1103.2.2 a ibco:Provision ;
    ibco:bbox "[334.2, 308.757, 565.17, 330.818]",
        "[73.198, 605.712, 304.246, 715.782]" ;
    ibco:heading "Employee work areas" ;
    ibco:label "1103.2.2" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.3 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.2 Employee work areas. Spaces and elements within employee work areas shall only be required to comply with Sections 907.5.2.3.1, 1009 and 1104.3.1 and shall be designed and constructed so that individuals with disabilities can approach, enter and exit the work area. Work areas, or portions of work areas, other than raised courtroom stations in accordance with Section 1109.4.1.4, that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the ground or finished floor where the change in elevation is essential to the function of the space shall be exempt from all requirements." .

ibc:ibc2021-1103.2.3 a ibco:Provision ;
    ibco:bbox "[334.2, 334.792, 565.161, 378.806]" ;
    ibco:heading "Detached dwellings" ;
    ibco:label "1103.2.3" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.4 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.3 Detached dwellings. Detached one- and twofamily dwellings, their accessory structures and their associated sites and facilities are not required to comply with this chapter." .

ibc:ibc2021-1103.2.4 a ibco:Provision ;
    ibco:bbox "[334.21, 382.78, 565.238, 477.788]" ;
    ibco:heading "Utility buildings" ;
    ibco:label "1103.2.4" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.5 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.4 Utility buildings. Group U occupancies are not required to comply with this chapter other than the following: 1. In agricultural buildings, access is required to paved work areas and areas open to the general public. 2. Private garages or carports that contain required accessible parking." .

ibc:ibc2021-1103.2.5 a ibco:Provision ;
    ibco:bbox "[334.21, 481.762, 565.222, 536.811]" ;
    ibco:heading "Construction sites" ;
    ibco:label "1103.2.5" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.6 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.5 Construction sites. Structures, sites and equipment directly associated with the actual processes of construction including, but not limited to, scaffolding, bridging, materials hoists, materials storage or construction trailers are not required to comply with this chapter." .

ibc:ibc2021-1103.2.6 a ibco:Provision ;
    ibco:bbox "[334.21, 540.785, 565.191, 595.714]" ;
    ibco:heading "Raised areas" ;
    ibco:label "1103.2.6" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.7 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.6 Raised areas. Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands are not required to comply with this chapter." .

ibc:ibc2021-1103.2.7 a ibco:Provision ;
    ibco:bbox "[334.21, 599.688, 565.287, 643.702]" ;
    ibco:heading "Limited access spaces" ;
    ibco:label "1103.2.7" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.8 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.7 Limited access spaces. Spaces accessed only by ladders, catwalks, crawl spaces, freight elevators or very narrow passageways are not required to comply with this chapter." .

ibc:ibc2021-1103.2.8 a ibco:Provision ;
    ibco:bbox "[334.202, 647.676, 565.252, 724.774]" ;
    ibco:heading "Areas in places of religious worship" ;
    ibco:label "1103.2.8" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.9 ;
    ibco:sourcePage 356 ;
    ibco:text "1103.2.8 Areas in places of religious worship. Raised or lowered areas, or portions of areas, in places of religious worship that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the finished floor and used primarily for the performance of religious ceremonies are not required to comply with this chapter." .

ibc:ibc2021-1103.2.9 a ibco:Provision ;
    ibco:bbox "[58.799, 69.725, 289.825, 113.738]" ;
    ibco:heading "Equipment spaces" ;
    ibco:label "1103.2.9" ;
    ibco:partOf ibc:ibc2021-1103 ;
    ibco:precedes ibc:ibc2021-1103.2.10 ;
    ibco:sourcePage 357 ;
    ibco:text "1103.2.9 Equipment spaces. Spaces frequented only by service personnel for maintenance, repair or occasional monitoring of equipment are not required to comply with this chapter." .

ibc:ibc2021-1104.2 a ibco:Provision ;
    ibco:bbox "[46.787, 529.688, 289.904, 672.683]" ;
    ibco:heading "Within a site" ;
    ibco:label "1104.2" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.3 ;
    ibco:sourcePage 357 ;
    ibco:text "1104.2 Within a site. At least one accessible route shall connect accessible buildings, accessible facilities, accessible elements and accessible spaces that are on the same site. Exceptions: 1. An accessible route is not required between accessible buildings, accessible facilities, accessible elements and accessible spaces that have, as the only means of access between them, a vehicular way not providing for pedestrian access. 2. An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:ibc2021-1104.3 a ibco:Provision ;
    ibco:bbox "[307.799, 69.575, 550.915, 262.769]",
        "[46.787, 676.657, 289.782, 698.719]" ;
    ibco:heading "Connected spaces" ;
    ibco:label "1104.3" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.3.1 ;
    ibco:sourcePage 357 ;
    ibco:text "1104.3 Connected spaces. Where a building or portion of a building is required to be accessible, at least one accessible route shall be provided to each portion of the building, to accessible building entrances connecting accessible pedestrian walkways and to the public way. Exceptions: 1. Stories and mezzanines exempted by Section 1104.4. 2. In a building, room or space used for assembly purposes with fixed seating, an accessible route shall not be required to serve levels where wheelchair spaces are not provided. 3. Vertical access to elevated employee work stations within a courtroom complying with Section 1109.4.1.4. 4. An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:ibc2021-1104.3.1 a ibco:Provision ;
    ibco:bbox "[319.8, 266.743, 550.912, 478.761]" ;
    ibco:heading "Employee work areas" ;
    ibco:label "1104.3.1" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.3.2 ;
    ibco:sourcePage 357 ;
    ibco:text "1104.3.1 Employee work areas. Common use circulation paths within employee work areas shall be accessible routes. Exceptions: 1. Common use circulation paths, located within employee work areas that are less than 1,000 square feet (93 m2) in size and defined by permanently installed partitions, counters, casework or furnishings, shall not be required to be accessible routes. 2. Common use circulation paths, located within employee work areas, that are an integral component of equipment, shall not be required to be accessible routes. 3. Common use circulation paths, located within exterior employee work areas that are fully exposed to the weather, shall not be required to be accessible routes." .

ibc:ibc2021-1104.3.2 a ibco:Provision ;
    ibco:bbox "[319.784, 482.735, 550.807, 669.83]" ;
    ibco:heading "Press boxes" ;
    ibco:label "1104.3.2" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.4 ;
    ibco:sourcePage 357 ;
    ibco:text "1104.3.2 Press boxes. Press boxes in a building, room or space used for assembly purposes shall be on an accessible route. Exceptions: 1. An accessible route shall not be required to press boxes in bleachers that have a single point of entry from the bleachers, provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2). 2. An accessible route shall not be required to free-standing press boxes that are more than 12 feet (3660 mm) above grade provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:ibc2021-1104.4 a ibco:Provision ;
    ibco:bbox "[307.799, 673.804, 550.916, 695.866]",
        "[61.199, 69.725, 304.302, 486.777]" ;
    ibco:heading "Multistory buildings and facilities" ;
    ibco:label "1104.4" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.5 ;
    ibco:sourcePage 357,
        358 ;
    ibco:text "1104.4 Multistory buildings and facilities. At least one accessible route shall connect each accessible story, mezzanine and occupied roofs in multilevel buildings and facilities. Exceptions: 1. An accessible route is not required to stories, mezzanines and occupied roofs that have an aggregate area of not more than 3,000 square feet (278.7 m2) and are located above and below accessible levels. This exception shall not apply to: 1.1. Multiple tenant facilities of Group M occupancies containing five or more tenant spaces used for the sales or rental of goods and where at least one such tenant space is located on a floor level above or below the accessible levels. 1.2. Stories or mezzanines containing offices of health care providers (Group B or I). 1.3. Passenger transportation facilities and airports (Group A-3 or B). 1.4. Government buildings. 1.5. Structures with four or more dwelling units. 2. Stories, mezzanines or occupied roofs that do not contain accessible elements or other spaces as determined by Section 1108 or 1109 are not required to be served by an accessible route from an accessible level. 3. In air traffic control towers, an accessible route is not required to serve the cab and the floor immediately below the cab. 4. Where a two-story building or facility has one story or mezzanine with an occupant load of five or fewer persons that does not contain public use space, that story or mezzanine shall not be required to be connected by an accessible route to the story above or below." .

ibc:ibc2021-1104.5 a ibco:Provision ;
    ibco:bbox "[61.163, 490.751, 304.177, 644.783]" ;
    ibco:heading "Location" ;
    ibco:label "1104.5" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-1104.6 ;
    ibco:sourcePage 358 ;
    ibco:text "1104.5 Location. Accessible routes shall coincide with or be located in the same area as a general circulation path. Where the circulation path is interior, the accessible route shall be interior. Where only one accessible route is provided, the accessible route shall not pass through kitchens, storage rooms, restrooms, closets or similar spaces. Exceptions: 1. Accessible routes from parking garages contained within and serving Type B units are not required to be interior. 2. A single accessible route is permitted to pass through a kitchen or storage room in an Accessible unit, Type A unit or Type B unit." .

ibc:ibc2021-1105.1 a ibco:Provision ;
    ibco:bbox "[322.197, 182.741, 565.318, 281.833]" ;
    ibco:heading "Public entrances" ;
    ibco:label "1105.1" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.1 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1 Public entrances. In addition to accessible entrances required by Sections 1105.1.2 through 1105.1.8, at least 60 percent of all public entrances shall be accessible. Exceptions: 1. An accessible entrance is not required to areas not required to be accessible. 2. Loading and service entrances that are not the only entrance to a tenant space." .

ibc:ibc2021-1105.1.2 a ibco:Provision ;
    ibco:bbox "[334.199, 489.845, 565.151, 522.822]" ;
    ibco:heading "Parking garage entrances" ;
    ibco:label "1105.1.2" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.3 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.2 Parking garage entrances. Where provided, direct access for pedestrians from parking structures to buildings or facility entrances shall be accessible." .

ibc:ibc2021-1105.1.3 a ibco:Provision ;
    ibco:bbox "[334.189, 526.796, 565.243, 581.845]" ;
    ibco:label "1105.1.3" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.4 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.3 Entrances from tunnels or elevated walkways. Where direct access is provided for pedestrians from a pedestrian tunnel or elevated walkway to a building or facility, at least one entrance to the building or facility from each tunnel or walkway shall be accessible." .

ibc:ibc2021-1105.1.4 a ibco:Provision ;
    ibco:bbox "[334.189, 585.819, 565.239, 629.833]" ;
    ibco:label "1105.1.4" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.5 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.4 Restricted entrances. Where restricted entrances are provided to a building or facility, at least one restricted entrance to the building or facility shall be accessible." .

ibc:ibc2021-1105.1.5 a ibco:Provision ;
    ibco:bbox "[334.199, 633.807, 565.212, 688.736]" ;
    ibco:heading "Entrances for inmates or detainees" ;
    ibco:label "1105.1.5" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.6 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.5 Entrances for inmates or detainees. Where entrances used only by inmates or detainees and security personnel are provided at judicial facilities, detention facilities or correctional facilities, at least one such entrance shall be accessible." .

ibc:ibc2021-1105.1.6 a ibco:Provision ;
    ibco:bbox "[334.189, 692.71, 565.181, 725.807]" ;
    ibco:heading "Service entrances" ;
    ibco:label "1105.1.6" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-1105.1.7 ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.6 Service entrances. If a service entrance is the only entrance to a building or a tenant space in a facility, that entrance shall be accessible." .

ibc:ibc2021-1106.1 a ibco:Provision ;
    ibco:bbox "[46.797, 249.812, 289.778, 282.789]" ;
    ibco:heading "General" ;
    ibco:label "1106.1" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.2 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.1 General. Parking shall comply with Sections 1106.2 through 1106.8. Passenger loading zones shall comply with Section 1106.9." .

ibc:ibc2021-1106.3 a ibco:Provision ;
    ibco:bbox "[319.803, 69.7, 550.919, 210.784]",
        "[46.799, 638.765, 289.844, 719.849]" ;
    ibco:heading "Groups I-1, R-1, R-2, R-3 and R-4" ;
    ibco:label "1106.3" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.4 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.3 Groups I-1, R-1, R-2, R-3 and R-4. Accessible parking spaces shall be provided in Group I-1, R-1, R-2, R-3 and R-4 occupancies in accordance with Items 1 through 4 as applicable. 1. In Group R-2, R-3 and R-4 occupancies that are required to have Accessible, Type A or Type B dwelling units or sleeping units, at least 2 percent, but not less than one, of each type of parking space provided shall be accessible. 2. In Group I-1 and R-1 occupancies, accessible parking shall be provided in accordance with Table 1106.2. 3. Where at least one parking space is provided for each dwelling unit or sleeping unit, at least one accessible parking space shall be provided for each Accessible and Type A unit. 4. Where parking is provided within or beneath a building, accessible parking spaces shall be provided within or beneath the building." .

ibc:ibc2021-1106.4 a ibco:Provision ;
    ibco:bbox "[307.801, 214.758, 550.795, 258.771]" ;
    ibco:heading "Hospital outpatient facilities" ;
    ibco:label "1106.4" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.5 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.4 Hospital outpatient facilities. At least 10 percent, but not less than one, of care recipient and visitor parking spaces provided to serve hospital outpatient facilities shall be accessible." .

ibc:ibc2021-1106.5 a ibco:Provision ;
    ibco:bbox "[307.801, 262.745, 550.851, 328.71]" ;
    ibco:label "1106.5" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.6 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.5 Rehabilitation facilities and outpatient physical therapy facilities. At least 20 percent, but not less than one, of the portion of care recipient and visitor parking spaces serving rehabilitation facilities specializing in treating conditions that affect mobility and outpatient physical therapy facilities shall be accessible." .

ibc:ibc2021-1106.7 a ibco:Provision ;
    ibco:bbox "[307.791, 428.659, 550.893, 637.629]" ;
    ibco:heading "Location" ;
    ibco:label "1106.7" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.8 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.7 Location. Accessible parking spaces shall be located on the shortest accessible route of travel from adjacent parking to an accessible building entrance. In parking facilities that do not serve a particular building, accessible parking spaces shall be located on the shortest route to an accessible pedestrian entrance to the parking facility. Where buildings have multiple accessible entrances with adjacent parking, accessible parking spaces shall be dispersed and located near the accessible entrances. Exceptions: 1. In multilevel parking structures, van-accessible parking spaces are permitted on one level. 2. Accessible parking spaces shall be permitted to be located in different parking facilities if substantially equivalent or greater accessibility is provided in terms of distance from an accessible entrance or entrances, parking fee and user convenience." .

ibc:ibc2021-1106.8 a ibco:Provision ;
    ibco:bbox "[307.791, 641.603, 550.823, 674.7]" ;
    ibco:heading "Parking meters and pay stations" ;
    ibco:label "1106.8" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.9 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.8 Parking meters and pay stations. Where parking meters and pay stations serve accessible parking spaces, such parking meters and pay stations shall be accessible." .

ibc:ibc2021-1106.9 a ibco:Provision ;
    ibco:bbox "[307.791, 678.674, 550.821, 700.616]" ;
    ibco:heading "Passenger loading zones" ;
    ibco:label "1106.9" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.9.1 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.9 Passenger loading zones. Passenger loading zones shall be accessible." .

ibc:ibc2021-1106.9.1 a ibco:Provision ;
    ibco:bbox "[319.783, 704.59, 550.773, 726.652]",
        "[73.199, 69.725, 304.177, 91.786]" ;
    ibco:heading "Continuous loading zones" ;
    ibco:label "1106.9.1" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.9.2 ;
    ibco:sourcePage 359,
        360 ;
    ibco:text "1106.9.1 Continuous loading zones. Where passenger loading zones are provided, one passenger loading zone in every continuous 100 linear feet (30.4 m) maximum of loading zone space shall be accessible." .

ibc:ibc2021-1106.9.2 a ibco:Provision ;
    ibco:bbox "[73.199, 95.76, 304.287, 150.809]" ;
    ibco:heading "Medical facilities" ;
    ibco:label "1106.9.2" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.9.3 ;
    ibco:sourcePage 360 ;
    ibco:text "1106.9.2 Medical facilities. A passenger loading zone shall be provided at an accessible entrance to licensed medical and long-term care facilities where people receive physical or medical treatment or care and where the period of stay exceeds 24 hours." .

ibc:ibc2021-1106.9.3 a ibco:Provision ;
    ibco:bbox "[73.199, 154.783, 304.222, 176.725]" ;
    ibco:heading "Valet parking" ;
    ibco:label "1106.9.3" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1106.9.4 ;
    ibco:sourcePage 360 ;
    ibco:text "1106.9.3 Valet parking. A passenger loading zone shall be provided at valet parking services." .

ibc:ibc2021-1106.9.4 a ibco:Provision ;
    ibco:bbox "[73.199, 180.699, 304.203, 224.712]" ;
    ibco:heading "Mechanical access parking garages" ;
    ibco:label "1106.9.4" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-1107 ;
    ibco:sourcePage 360 ;
    ibco:text "1106.9.4 Mechanical access parking garages. Mechanical access parking garages shall provide at least one passenger loading zone at vehicle drop-off and vehicle pick-up areas." .

ibc:ibc2021-1107.1 a ibco:Provision ;
    ibco:bbox "[61.197, 271.763, 304.215, 304.741]" ;
    ibco:heading "General" ;
    ibco:label "1107.1" ;
    ibco:partOf ibc:ibc2021-1107 ;
    ibco:precedes ibc:ibc2021-1107.2 ;
    ibco:sourcePage 360 ;
    ibco:text "1107.1 General. Electrical vehicle charging stations shall comply with Section 1107.2. Fuel-dispensing systems shall comply with Section 1107.3." .

ibc:ibc2021-1107.2.1 a ibco:Provision ;
    ibco:bbox "[73.199, 382.738, 304.189, 437.787]" ;
    ibco:heading "Number of accessible vehicle spaces" ;
    ibco:label "1107.2.1" ;
    ibco:partOf ibc:ibc2021-1107 ;
    ibco:precedes ibc:ibc2021-1107.2.2 ;
    ibco:sourcePage 360 ;
    ibco:text "1107.2.1 Number of accessible vehicle spaces. Not less than 5 percent of vehicle spaces on the site served by electrical vehicle charging systems, but not fewer than one for each type of electric vehicle charging system, shall be accessible." .

ibc:ibc2021-1107.2.2 a ibco:Provision ;
    ibco:bbox "[32.159, 441.761, 304.184, 512.269]" ;
    ibco:heading "Vehicle space size" ;
    ibco:label "1107.2.2" ;
    ibco:partOf ibc:ibc2021-1107 ;
    ibco:precedes ibc:ibc2021-1107.3 ;
    ibco:sourcePage 360 ;
    ibco:text "1107.2.2 Vehicle space size. Accessible vehicle spaces shall comply with the requirements for a van accessible parking space that is 132 inches (3350 mm) minimum in width with an adjoining access aisle that is 60 inches (1525 mm) minimum in width. **" .

ibc:ibc2021-1107.3 a ibco:Provision ;
    ibco:bbox "[61.197, 500.664, 304.129, 522.726]" ;
    ibco:heading "Fuel-dispensing systems" ;
    ibco:label "1107.3" ;
    ibco:partOf ibc:ibc2021-1107 ;
    ibco:precedes ibc:ibc2021-1108 ;
    ibco:sourcePage 360 ;
    ibco:text "1107.3 Fuel-dispensing systems. Fuel-dispensing systems shall be accessible." .

ibc:ibc2021-1108.1 a ibco:Provision ;
    ibco:bbox "[61.187, 569.657, 304.173, 613.67]" ;
    ibco:heading "General" ;
    ibco:label "1108.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.2 ;
    ibco:sourcePage 360 ;
    ibco:text "1108.1 General. In addition to the other requirements of this chapter, occupancies having dwelling units or sleeping units shall be provided with accessible features in accordance with this section." .

ibc:ibc2021-1108.2 a ibco:Provision ;
    ibco:bbox "[61.177, 617.644, 304.174, 694.645]" ;
    ibco:heading "Design" ;
    ibco:label "1108.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.3 ;
    ibco:sourcePage 360 ;
    ibco:text "1108.2 Design. Dwelling units and sleeping units that are required to be Accessible units, Type A units and Type B units shall comply with the applicable portions of Chapter 11 of ICC A117.1. Units required to be Type A units are permitted to be designed and constructed as Accessible units. Units required to be Type B units are permitted to be designed and constructed as Accessible units or as Type A units." .

ibc:ibc2021-1108.3 a ibco:Provision ;
    ibco:bbox "[322.189, 69.575, 565.21, 237.812]",
        "[61.187, 698.619, 304.163, 720.681]" ;
    ibco:heading "Accessible spaces" ;
    ibco:label "1108.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.4 ;
    ibco:sourcePage 360 ;
    ibco:text "1108.3 Accessible spaces. Rooms and spaces available to the general public or available for use by residents and serving Accessible units, Type A units or Type B units shall be accessible. Accessible spaces shall include toilet and bathing rooms, kitchen, living and dining areas and any exterior spaces, including patios, terraces and balconies. Exceptions: 1. Stories and mezzanines exempted by Section 1108.4. 2. Recreational facilities in accordance with Section 1111.2. 3. Exterior decks, patios or balconies that are part of Type B units and have impervious surfaces, and that are not more than 4 inches (102 mm) below the finished floor level of the adjacent interior space of the unit." .

ibc:ibc2021-1108.4 a ibco:Provision ;
    ibco:bbox "[322.177, 241.787, 565.265, 723.814]",
        "[70.779, 69.725, 289.828, 182.721]" ;
    ibco:heading "Accessible route" ;
    ibco:label "1108.4" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5 ;
    ibco:sourcePage 360,
        361 ;
    ibco:text "1108.4 Accessible route. Not fewer than one accessible route shall connect accessible building or facility entrances with the primary entrance of each Accessible unit, Type A unit and Type B unit within the building or facility and with those exterior and interior spaces and facilities that serve the units. Exceptions: 1. If due to circumstances outside the control of the owner, either the slope of the finished ground level between accessible facilities and buildings exceeds one unit vertical in 12 units horizontal (1:12), or where physical barriers or legal restrictions prevent the installation of an accessible route, a vehicular route with parking that complies with Section 1106 at each public or common use facility or building is permitted in place of the accessible route. 2. In Group I-3 facilities, an accessible route is not required to connect stories or mezzanines where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route. 3. In Group R-2 facilities with Type A units complying with Section 1108.6.2.2.1, an accessible route is not required to connect stories or mezzanines where Type A units, all common use areas serving Type A units and all public use areas are on an accessible route. 4. In other than Group R-2 dormitory housing provided by places of education, in Group R-2 facilities with Accessible units complying with Section 1108.6.2.3.1, an accessible route is not required to connect stories or mezzanines where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route. 5. In Group R-1, an accessible route is not required to connect stories or mezzanines within individual units, provided the accessible level meets the provisions for Accessible units and sleeping accommodations for two persons minimum and a toilet facility are provided on that level. 6. In congregate residences in Groups R-3 and R-4, an accessible route is not required to connect stories or mezzanines where Accessible units or Type B units, all common use areas serving Accessible units and Type B units and all public use areas serving Accessible units and Type B units are on an accessible route. 7. An accessible route between stories is not required where Type B units are exempted by Section 1108.7." .

ibc:ibc2021-1108.5 a ibco:Provision ;
    ibco:bbox "[46.756, 186.695, 289.847, 219.792]" ;
    ibco:heading "Group I" ;
    ibco:label "1108.5" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.1 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5 Group I. Accessible units and Type B units shall be provided in Group I occupancies in accordance with Sections 1108.5.1 through 1108.5.5." .

ibc:ibc2021-1108.5.1 a ibco:Provision ;
    ibco:bbox "[58.757, 223.766, 289.774, 256.744]" ;
    ibco:heading "Group I-1" ;
    ibco:label "1108.5.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.1.1 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.1 Group I-1. Accessible units and Type B units shall be provided in Group I-1 occupancies in accordance with Sections 1108.5.1.1 and 1108.5.1.3." .

ibc:ibc2021-1108.5.1.1 a ibco:Provision ;
    ibco:bbox "[70.769, 260.718, 289.832, 447.737]" ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.5.1.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.1.2 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.1.1 Accessible units. In Group I-1, Condition 1, at least 4 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units. Accessible dwelling units and sleeping units shall be dispersed among the various classes of units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of the Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 50 percent of the Accessible units." .

ibc:ibc2021-1108.5.2 a ibco:Provision ;
    ibco:bbox "[319.795, 69.705, 550.881, 113.718]" ;
    ibco:heading "Group I-2 nursing homes" ;
    ibco:label "1108.5.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.2.1 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.2 Group I-2 nursing homes. Accessible units and Type B units shall be provided in nursing homes of Group I-2, Condition 1 occupancies in accordance with Sections 1108.5.2.1 and 1108.5.2.2." .

ibc:ibc2021-1108.5.2.1 a ibco:Provision ;
    ibco:bbox "[331.797, 117.692, 550.84, 282.759]" ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.5.2.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.2.2 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.2.1 Accessible units. At least 50 percent but not less than one of each type of the dwelling units and sleeping units shall be Accessible units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 90 percent of the Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 90 percent of the Accessible units." .

ibc:ibc2021-1108.5.3 a ibco:Provision ;
    ibco:bbox "[319.795, 371.672, 550.854, 426.721]" ;
    ibco:heading "Group I-2 hospitals" ;
    ibco:label "1108.5.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.3.1 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.3 Group I-2 hospitals. Accessible units and Type B units shall be provided in general-purpose hospitals, psychiatric facilities and detoxification facilities of Group I-2 occupancies in accordance with Sections 1108.5.3.1 and 1108.5.3.2." .

ibc:ibc2021-1108.5.4 a ibco:Provision ;
    ibco:bbox "[319.795, 600.827, 550.882, 729.779]",
        "[97.199, 69.725, 304.23, 113.738]" ;
    ibco:heading "Group I-2 rehabilitation facilities" ;
    ibco:label "1108.5.4" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.5 ;
    ibco:sourcePage 361,
        362 ;
    ibco:text "1108.5.4 Group I-2 rehabilitation facilities. In hospitals and rehabilitation facilities of Group I-2 occupancies that specialize in treating conditions that affect mobility, or units within either that specialize in treating conditions that affect mobility, 100 percent of the dwelling units and sleeping units shall be Accessible units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-in-type showers comply with Section 1110.2.3, in not more than 50 percent of Accessible units." .

ibc:ibc2021-1108.5.5 a ibco:Provision ;
    ibco:bbox "[73.195, 117.712, 304.18, 150.809]" ;
    ibco:heading "Group I-3" ;
    ibco:label "1108.5.5" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.5.1 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.5.5 Group I-3. Accessible units shall be provided in Group I-3 occupancies in accordance with Sections 1108.5.5.1 through 1108.5.5.3." .

ibc:ibc2021-1108.5.5.1 a ibco:Provision ;
    ibco:bbox "[85.197, 154.783, 304.215, 198.797]" ;
    ibco:heading "Group I-3 sleeping units" ;
    ibco:label "1108.5.5.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.5.5.2 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.5.5.1 Group I-3 sleeping units. In Group I-3 occupancies, at least 3 percent of the total number of sleeping units in the facility, but not less than one unit in each classification level, shall be Accessible units." .

ibc:ibc2021-1108.5.5.3 a ibco:Provision ;
    ibco:bbox "[85.167, 364.72, 304.192, 419.769]" ;
    ibco:heading "Medical care facilities" ;
    ibco:label "1108.5.5.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.5.5.3 Medical care facilities. Patient sleeping units or cells required to be Accessible units in medical care facilities shall be provided in addition to any medical isolation cells required to comply with Section 1108.5.5.2." .

ibc:ibc2021-1108.6 a ibco:Provision ;
    ibco:bbox "[61.164, 423.743, 304.249, 456.721]" ;
    ibco:heading "Group R" ;
    ibco:label "1108.6" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.1 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6 Group R. Accessible units, Type A units and Type B units shall be provided in Group R occupancies in accordance with Sections 1108.6.1 through 1108.6.4." .

ibc:ibc2021-1108.6.1 a ibco:Provision ;
    ibco:bbox "[73.166, 460.695, 304.207, 493.672]" ;
    ibco:heading "Group R-1" ;
    ibco:label "1108.6.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.1.1 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.1 Group R-1. Accessible units and Type B units shall be provided in Group R-1 occupancies in accordance with Sections 1108.6.1.1 and 1108.6.1.2." .

ibc:ibc2021-1108.6.1.1 a ibco:Provision ;
    ibco:bbox "[346.159, 69.605, 565.326, 168.826]",
        "[85.167, 497.646, 304.241, 519.708]" ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.6.1.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.1.2 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.1.1 Accessible units. Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1. On a multiple-building site, where structures contain more than 50 dwelling units or sleeping units, the number of Accessible units shall be determined per structure. On a multiple-building site, where structures contain 50 or fewer dwelling units or sleeping units, all dwelling units and sleeping units on a site shall be considered to determine the total number of Accessible units. Accessible units shall be dispersed among the various classes of units." .

ibc:ibc2021-1108.6.2 a ibco:Provision ;
    ibco:bbox "[334.177, 257.739, 565.245, 301.752]" ;
    ibco:heading "Group R-2" ;
    ibco:label "1108.6.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.2.1 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.2 Group R-2. Accessible units, Type A units and Type B units shall be provided in Group R-2 occupancies in accordance with Sections 1108.6.2.1 through 1108.6.2.3." .

ibc:ibc2021-1108.6.2.2 a ibco:Provision ;
    ibco:bbox "[207.721, 535.711, 418.685, 544.549]",
        "[279.84, 401.701, 565.197, 535.552]" ;
    ibco:label "1108.6.2.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.2.2.1 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.2.2 Apartment houses, monasteries and convents. Type A units and Type B units shall be provided in apartment houses, monasteries and convents in accordance with Sections 1108.6.2.2.1 and 1108.6.2.2.2. Bedrooms in monasteries and convents shall be counted as units for the purpose of determining the number of units. Where the bedrooms are grouped in sleeping units, only one bedroom in each sleeping unit shall count toward the number of required Type A units. TABLE 1108.6.1.1 ACCESSIBLE DWELLING UNITS AND SLEEPING UNITS" .

ibc:ibc2021-1108.6.2.2.1 a ibco:Provision ;
    ibco:bbox "[82.799, 69.725, 289.832, 246.784]" ;
    ibco:heading "Type A units" ;
    ibco:label "1108.6.2.2.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.2.2.2 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.2.2.1 Type A units. In Group R-2 occupancies containing more than 20 dwelling units or sleeping units, at least 2 percent but not less than one of the units shall be a Type A unit. All Group R-2 units on a site shall be considered to determine the total number of units and the required number of Type A units. Type A units shall be dispersed among the various classes of units. Exceptions: 1. The number of Type A units is permitted to be reduced in accordance with Section 1108.7. 2. Existing structures on a site shall not contribute to the total number of units on a site." .

ibc:ibc2021-1108.6.2.3 a ibco:Provision ;
    ibco:bbox "[70.807, 346.732, 289.914, 511.66]" ;
    ibco:label "1108.6.2.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.2.3.1 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.2.3 Group R-2 other than live/work units, apartment houses, monasteries and convents. In Group R-2 occupancies, other than live/work units, apartment houses, monasteries and convents falling within the scope of Sections 1108.6.2.1 and 1108.6.2.2, Accessible units and Type B units shall be provided in accordance with Sections 1108.6.2.3.1 and 1108.6.2.3.2. Bedrooms within congregate living facilities, dormitories, sororities, fraternities and boarding houses shall be counted as sleeping units for the purpose of determining the number of units. Where the bedrooms are grouped into dwelling or sleeping units, only one bedroom in each dwelling or sleeping unit shall be permitted to count toward the number of required Accessible units." .

ibc:ibc2021-1108.6.2.3.1 a ibco:Provision ;
    ibco:bbox "[82.819, 515.634, 289.894, 548.731]" ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.6.2.3.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.2.3.2 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.2.3.1 Accessible units. Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1." .

ibc:ibc2021-1108.6.4 a ibco:Provision ;
    ibco:bbox "[319.799, 121.746, 550.846, 187.711]" ;
    ibco:heading "Group R-4" ;
    ibco:label "1108.6.4" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.4.1 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.4 Group R-4. Accessible units and Type B units shall be provided in Group R-4 occupancies in accordance with Sections 1108.6.4.1 and 1108.6.4.2. Bedrooms in Group R-4 facilities shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:ibc2021-1108.6.4.1 a ibco:Provision ;
    ibco:bbox "[331.79, 191.685, 550.792, 235.698]" ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.6.4.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.6.4.2 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.4.1 Accessible units. In Group R-4, Condition 1, at least one of the sleeping units shall be an Accessible unit. In Group R-4, Condition 2, at least two of the sleeping units shall be an Accessible unit." .

ibc:ibc2021-1108.7 a ibco:Provision ;
    ibco:bbox "[307.777, 313.695, 550.861, 357.708]" ;
    ibco:heading "General exceptions" ;
    ibco:label "1108.7" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.1 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.7 General exceptions. Where specifically permitted by Section 1108.5 or 1108.6, the required number of Type A units and Type B units is permitted to be reduced in accordance with Sections 1108.7.1 through 1108.7.5." .

ibc:ibc2021-1108.7.1 a ibco:Provision ;
    ibco:bbox "[319.789, 361.682, 550.825, 438.81]" ;
    ibco:heading "Structures without elevator service" ;
    ibco:label "1108.7.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.1.1 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.7.1 Structures without elevator service. Where elevator service is not provided in a structure, only the dwelling units and sleeping units that are located on stories indicated in Sections 1108.7.1.1 and 1108.7.1.2 are required to be Type A units and Type B units, respectively. The number of Type A units shall be determined in accordance with Section 1108.6.2.2.1." .

ibc:ibc2021-1108.7.1.1 a ibco:Provision ;
    ibco:bbox "[331.791, 442.784, 550.856, 508.749]" ;
    ibco:heading "One story with Type B units required" ;
    ibco:label "1108.7.1.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.1.2 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.7.1.1 One story with Type B units required. At least one story containing dwelling units or sleeping units intended to be occupied as a residence shall be provided with an accessible entrance from the exterior of the structure and all units intended to be occupied as a residence on that story shall be Type B units." .

ibc:ibc2021-1108.7.1.2 a ibco:Provision ;
    ibco:bbox "[331.771, 512.723, 550.838, 717.73]",
        "[85.203, 69.725, 304.19, 113.738]" ;
    ibco:heading "Additional stories with Type B units" ;
    ibco:label "1108.7.1.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.2 ;
    ibco:sourcePage 363,
        364 ;
    ibco:text "1108.7.1.2 Additional stories with Type B units. Where stories have entrances not included in determining compliance with Section 1108.7.1.1, and such entrances are proximate to arrival points intended to serve units on that story, as indicated in Items 1 and 2, all dwelling units and sleeping units intended to be occupied as a residence served by that entrance on that story shall be Type B units. 1. Where the slopes of the undisturbed site measured between the planned entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less. 2. Where the slopes of the planned finished grade measured between the entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less. Where arrival points are not within 50 feet (15 240 mm) of the entrance, the closest arrival point shall be used to determine access unless that arrival point serves the story required by Section 1108.7.1.1." .

ibc:ibc2021-1108.7.2 a ibco:Provision ;
    ibco:bbox "[73.191, 117.712, 304.29, 216.784]" ;
    ibco:heading "Multistory units" ;
    ibco:label "1108.7.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.3 ;
    ibco:sourcePage 364 ;
    ibco:text "1108.7.2 Multistory units. A multistory dwelling unit or sleeping unit that is not provided with elevator service is not required to be a Type B unit. Where a multistory unit is provided with external elevator service to only one floor, the floor provided with elevator service shall be the primary entry to the unit, shall comply with the requirements for a Type B unit and, where provided within the unit, a living area, a kitchen and a toilet facility shall be provided on that floor." .

ibc:ibc2021-1108.7.3 a ibco:Provision ;
    ibco:bbox "[73.191, 220.758, 304.399, 297.759]" ;
    ibco:label "1108.7.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.4 ;
    ibco:sourcePage 364 ;
    ibco:text "1108.7.3 Elevator service to the lowest story with units. Where elevator service in the building provides an accessible route only to the lowest story containing dwelling units or sleeping units intended to be occupied as a residence, only the units on that story that are intended to be occupied as a residence are required to be Type B units." .

ibc:ibc2021-1108.7.4 a ibco:Provision ;
    ibco:bbox "[73.201, 301.733, 304.33, 556.659]" ;
    ibco:heading "Site impracticality" ;
    ibco:label "1108.7.4" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1108.7.5 ;
    ibco:sourcePage 364 ;
    ibco:text "1108.7.4 Site impracticality. On a site with multiple nonelevator buildings, the number of units required by Section 1108.7.1 to be Type B units is permitted to be reduced to a percentage that is equal to the percentage of the entire site having grades, prior to development, that are less than 10 percent, provided that all of the following conditions are met: 1. Not less than 20 percent of the units required by Section 1108.7.1 on the site are Type B units. 2. Units required by Section 1108.7.1, where the slope between the building entrance serving the units on that story and a pedestrian or vehicular arrival point is not greater than 8.33 percent, are Type B units. 3. Units required by Section 1108.7.1, where an elevated walkway is planned between a building entrance serving the units on that story and a pedestrian or vehicular arrival point and the slope between them is 10 percent or less, are Type B units. 4. Units served by an elevator in accordance with Section 1108.7.3 are Type B units." .

ibc:ibc2021-1108.7.5 a ibco:Provision ;
    ibco:bbox "[334.2, 69.556, 565.269, 128.732]",
        "[73.201, 560.633, 304.363, 721.627]" ;
    ibco:heading "Flood hazard areas" ;
    ibco:label "1108.7.5" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-1109 ;
    ibco:sourcePage 364 ;
    ibco:text "1108.7.5 Flood hazard areas. Type A units and Type B units shall not be required for buildings without elevator service that are located in flood hazard areas as established in Section 1612.3, where the minimum required elevation of the lowest floor or lowest supporting horizontal structural member, as applicable, results in all of the following: 1. A difference in elevation between the minimum required floor elevation at the primary entrances and vehicular and pedestrian arrival points within 50 feet (15 240 mm) exceeding 30 inches (762 mm). 2. A slope exceeding 10 percent between the minimum required floor elevation at the primary entrances and vehicular and pedestrian arrival points within 50 feet (15 240 mm). Where such arrival points are not within 50 feet (15 240 mm) of the primary entrances, the closest arrival points shall be used." .

ibc:ibc2021-1109.1 a ibco:Provision ;
    ibco:bbox "[322.199, 175.783, 565.281, 208.761]" ;
    ibco:heading "General" ;
    ibco:label "1109.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.1 General. In addition to the other requirements of this chapter, the requirements of Sections 1109.2 through 1109.4 shall apply to specific occupancies." .

ibc:ibc2021-1109.2 a ibco:Provision ;
    ibco:bbox "[322.199, 212.735, 565.3, 300.771]" ;
    ibco:heading "Assembly area seating" ;
    ibco:label "1109.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.1 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2 Assembly area seating. A building, room or space used for assembly purposes with fixed seating shall comply with Sections 1109.2.1 through 1109.2.5. Lawn seating shall comply with Section 1109.2.6. Assistive listening systems shall comply with Section 1109.2.7. Performance areas viewed from assembly seating areas shall comply with Section 1109.2.8. Dining areas shall comply with Section 1109.2.9." .

ibc:ibc2021-1109.2.1 a ibco:Provision ;
    ibco:bbox "[334.2, 304.745, 565.249, 348.759]" ;
    ibco:heading "Services" ;
    ibco:label "1109.2.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.2 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2.1 Services. If a service or facility is provided in an area that is not accessible, the same service or facility shall be provided on an accessible level and shall be accessible." .

ibc:ibc2021-1109.2.2 a ibco:Provision ;
    ibco:bbox "[334.2, 352.733, 565.19, 396.746]" ;
    ibco:heading "Wheelchair spaces" ;
    ibco:label "1109.2.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.2.1 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2.2 Wheelchair spaces. In rooms and spaces used for assembly purposes with fixed seating, accessible wheelchair spaces shall be provided in accordance with Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:ibc2021-1109.2.2.1 a ibco:Provision ;
    ibco:bbox "[346.202, 400.72, 565.223, 450.947]" ;
    ibco:heading "General seating" ;
    ibco:label "1109.2.2.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.2.2 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2.2.1 General seating. Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1. TABLE 1109.2.2.1 ACCESSIBLE WHEELCHAIR SPACES" .

ibc:ibc2021-1109.2.2.2 a ibco:Provision ;
    ibco:bbox "[346.199, 595.805, 565.237, 639.818]" ;
    ibco:heading "Luxury boxes, club boxes and suites" ;
    ibco:label "1109.2.2.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.2.3 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2.2.2 Luxury boxes, club boxes and suites. In each luxury box, club box and suite within arenas, stadiums and grandstands, wheelchair spaces shall be provided in accordance with Table 1109.2.2.1." .

ibc:ibc2021-1109.2.2.3 a ibco:Provision ;
    ibco:bbox "[346.199, 643.792, 565.198, 709.757]" ;
    ibco:heading "Other boxes" ;
    ibco:label "1109.2.2.3" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.3 ;
    ibco:sourcePage 364 ;
    ibco:text "1109.2.2.3 Other boxes. In boxes other than those required to comply with Section 1109.2.2.2, the total number of wheelchair spaces provided shall be determined in accordance with Table 1109.2.2.1. Wheelchair spaces shall be located in not less than 20 percent of all boxes provided." .

ibc:ibc2021-1109.2.3 a ibco:Provision ;
    ibco:bbox "[58.789, 69.725, 289.875, 102.822]" ;
    ibco:heading "Companion seats" ;
    ibco:label "1109.2.3" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.4 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.3 Companion seats. At least one companion seat shall be provided for each wheelchair space required by Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:ibc2021-1109.2.4 a ibco:Provision ;
    ibco:bbox "[58.789, 106.796, 289.94, 362.798]" ;
    ibco:label "1109.2.4" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.5 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.4 Dispersion of wheelchair spaces in multilevel assembly seating areas. In multilevel assembly seating areas, wheelchair spaces shall be provided on the main floor level and on one of each two additional floor or mezzanine levels. Wheelchair spaces shall be provided in each luxury box, club box and suite within assembly facilities. Exceptions: 1. In multilevel assembly seating areas utilized for worship services where the second floor or mezzanine level contains 25 percent or less of the total seating capacity, wheelchair spaces shall be permitted to all be located on the main level. 2. In multilevel assembly seating areas where the second floor or mezzanine level provides 25 percent or less of the total seating capacity and 300 or fewer seats, all wheelchair spaces shall be permitted to be located on the main level. 3. Wheelchair spaces in team or player seating serving areas of sport activity are not required to be dispersed." .

ibc:ibc2021-1109.2.6 a ibco:Provision ;
    ibco:bbox "[58.809, 440.675, 289.821, 473.772]" ;
    ibco:heading "Lawn seating" ;
    ibco:label "1109.2.6" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.7 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.6 Lawn seating. Lawn seating areas and exterior overflow seating areas, where fixed seats are not provided, shall connect to an accessible route." .

ibc:ibc2021-1109.2.7.1 a ibco:Provision ;
    ibco:bbox "[331.813, 69.605, 550.847, 311.683]" ;
    ibco:heading "Receivers" ;
    ibco:label "1109.2.7.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.7.2 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.7.1 Receivers. The number and type of receivers shall be provided for assistive listening systems in accordance with Table 1109.2.7.1. Exceptions: 1. Where a building contains more than one room or space used for assembly purposes, the total number of required receivers shall be permitted to be calculated based on the total number of seats in the building, provided that all receivers are usable with all systems and if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management. 2. Where all seats in a building, room or space used for assembly purposes are served by an induction loop assistive listening system, the minimum number of receivers required by Table 1109.2.7.1 to be hearing-aid compatible shall not be required." .

ibc:ibc2021-1109.2.7.2 a ibco:Provision ;
    ibco:bbox "[331.823, 315.657, 550.842, 359.671]" ;
    ibco:heading "Ticket windows" ;
    ibco:label "1109.2.7.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.7.3 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.7.2 Ticket windows. Where ticket windows are provided in stadiums and arenas, at least one window at each location shall have an assistive listening system." .

ibc:ibc2021-1109.2.7.3 a ibco:Provision ;
    ibco:bbox "[331.823, 363.645, 550.922, 418.574]" ;
    ibco:heading "Public address systems" ;
    ibco:label "1109.2.7.3" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.8 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.7.3 Public address systems. Where stadiums, arenas and grandstands have 15,000 fixed seats or more and provide audible public announcements, they shall also provide prerecorded or real-time captions of those audible public announcements." .

ibc:ibc2021-1109.2.8 a ibco:Provision ;
    ibco:bbox "[319.793, 422.548, 550.808, 488.849]" ;
    ibco:heading "Performance areas" ;
    ibco:label "1109.2.8" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.2.9 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.8 Performance areas. An accessible route shall directly connect the performance area to the assembly seating area where a circulation path directly connects a performance area to an assembly seating area. An accessible route shall be provided from performance areas to ancillary areas or facilities used by performers." .

ibc:ibc2021-1109.2.9.1 a ibco:Provision ;
    ibco:bbox "[85.167, 244.762, 304.26, 310.727]" ;
    ibco:heading "Dining surfaces" ;
    ibco:label "1109.2.9.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.3 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.2.9.1 Dining surfaces. Where dining surfaces for the consumption of food or drink are provided, at least 5 percent, but not less than one, of the dining surfaces for the seating and standing spaces shall be accessible and be distributed throughout the facility and located on a level accessed by an accessible route." .

ibc:ibc2021-1109.3 a ibco:Provision ;
    ibco:bbox "[61.164, 314.701, 304.186, 375.947]" ;
    ibco:heading "Self-service storage facilities" ;
    ibco:label "1109.3" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.3.1 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.3 Self-service storage facilities. Self-service storage facilities shall provide accessible individual self-storage spaces in accordance with Table 1109.3. TABLE 1109.3 ACCESSIBLE SELF-SERVICE STORAGE FACILITIES" .

ibc:ibc2021-1109.3.1 a ibco:Provision ;
    ibco:bbox "[73.199, 430.805, 304.333, 518.841]" ;
    ibco:heading "Dispersion" ;
    ibco:label "1109.3.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.3.1 Dispersion. Accessible individual self-service storage spaces shall be dispersed throughout the various classes of spaces provided. Where more classes of spaces are provided than the number of required accessible spaces, the number of accessible spaces shall not be required to exceed that required by Table 1109.3. Accessible spaces are permitted to be dispersed in a single building of a multiple-building facility." .

ibc:ibc2021-1109.4 a ibco:Provision ;
    ibco:bbox "[61.197, 522.815, 304.124, 544.757]" ;
    ibco:heading "Judicial facilities" ;
    ibco:label "1109.4" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.1 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4 Judicial facilities. Judicial facilities shall comply with Sections 1109.4.1 and 1109.4.2." .

ibc:ibc2021-1109.4.1 a ibco:Provision ;
    ibco:bbox "[73.199, 548.731, 304.179, 581.828]" ;
    ibco:heading "Courtrooms" ;
    ibco:label "1109.4.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.1.1 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1 Courtrooms. Each courtroom shall be accessible and comply with Sections 1109.4.1.1 through 1109.4.1.5." .

ibc:ibc2021-1109.4.1.2 a ibco:Provision ;
    ibco:bbox "[85.201, 637.754, 304.289, 681.767]" ;
    ibco:heading "Gallery seating" ;
    ibco:label "1109.4.1.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.1.3 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1.2 Gallery seating. Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1. Designated aisle seats shall be provided in accordance with Section 1109.2.5." .

ibc:ibc2021-1109.4.1.3 a ibco:Provision ;
    ibco:bbox "[346.203, 69.655, 565.191, 91.716]",
        "[85.201, 685.741, 304.216, 707.802]" ;
    ibco:heading "Assistive listening systems" ;
    ibco:label "1109.4.1.3" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.1.4 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1.3 Assistive listening systems. An assistive listening system must be provided. Receivers shall be provided for the assistive listening system in accordance with Section 1109.2.7.1." .

ibc:ibc2021-1109.4.1.4 a ibco:Provision ;
    ibco:bbox "[346.203, 95.691, 565.309, 194.643]" ;
    ibco:heading "Employee work stations" ;
    ibco:label "1109.4.1.4" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.1.5 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1.4 Employee work stations. The judge’s bench, clerk’s station, bailiff’s station, deputy clerk’s station and court reporter’s station shall be located on an accessible route. The vertical access to elevated employee work stations within a courtroom is not required at the time of initial construction, provided a ramp, lift or elevator can be installed without requiring reconfiguration or extension of the courtroom or extension of the electrical system." .

ibc:ibc2021-1109.4.1.5 a ibco:Provision ;
    ibco:bbox "[346.203, 198.617, 565.26, 231.714]" ;
    ibco:heading "Other work stations" ;
    ibco:label "1109.4.1.5" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.2 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1.5 Other work stations. The litigant’s and counsel stations, including the lectern, shall be accessible." .

ibc:ibc2021-1109.4.2 a ibco:Provision ;
    ibco:bbox "[334.191, 235.688, 565.153, 268.666]" ;
    ibco:heading "Holding cells" ;
    ibco:label "1109.4.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.2.1 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.2 Holding cells. Central holding cells and courtfloor holding cells shall comply with Sections 1109.4.2.1 and 1109.4.2.2." .

ibc:ibc2021-1109.4.2.1 a ibco:Provision ;
    ibco:bbox "[346.183, 272.64, 565.291, 338.725]" ;
    ibco:heading "Central holding cells" ;
    ibco:label "1109.4.2.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1109.4.2.2 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.2.1 Central holding cells. Where separate central holding cells are provided for adult males, juvenile males, adult females or juvenile females, one of each type shall be accessible. Where central holding cells are provided and are not separated by age or sex, at least one accessible cell shall be provided." .

ibc:ibc2021-1109.4.2.2 a ibco:Provision ;
    ibco:bbox "[346.153, 342.699, 565.153, 441.651]" ;
    ibco:heading "Court-floor holding cells" ;
    ibco:label "1109.4.2.2" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-1110 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.2.2 Court-floor holding cells. Where separate court-floor holding cells are provided for adult males, juvenile males, adult females or juvenile females, each courtroom shall be served by one accessible cell of each type. Where court-floor holding cells are provided and are not separated by age or sex, courtrooms shall be served by at least one accessible cell. Accessible cells shall be permitted to serve more than one courtroom." .

ibc:ibc2021-1110.10 a ibco:Provision ;
    ibco:bbox "[307.779, 656.728, 550.839, 711.777]" ;
    ibco:heading "Storage" ;
    ibco:label "1110.10" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.10.1 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.10 Storage. Where fixed or built-in storage elements such as cabinets, coat hooks, shelves, medicine cabinets, lockers, closets and drawers are provided in required accessible spaces, at least 5 percent, but not less than one of each type shall be accessible." .

ibc:ibc2021-1110.10.1 a ibco:Provision ;
    ibco:bbox "[73.199, 69.725, 304.179, 102.822]" ;
    ibco:heading "Equity" ;
    ibco:label "1110.10.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.10.2 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.10.1 Equity. Accessible facilities and spaces shall be provided with the same storage elements as provided in the similar nonaccessible facilities and spaces." .

ibc:ibc2021-1110.10.2 a ibco:Provision ;
    ibco:bbox "[73.199, 106.796, 304.322, 150.809]" ;
    ibco:heading "Shelving and display units" ;
    ibco:label "1110.10.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.11 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.10.2 Shelving and display units. Self-service shelves and display units shall be located on an accessible route. Such shelving and display units shall not be required to comply with reach-range provisions." .

ibc:ibc2021-1110.12.1 a ibco:Provision ;
    ibco:bbox "[73.189, 313.745, 304.156, 357.758]" ;
    ibco:heading "Dispersion" ;
    ibco:label "1110.12.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.12.2 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.12.1 Dispersion. Accessible fixed or built-in seating at tables, counters or work surfaces shall be distributed throughout the space or facility containing such elements and located on a level accessed by an accessible route." .

ibc:ibc2021-1110.12.2 a ibco:Provision ;
    ibco:bbox "[73.189, 361.732, 304.162, 394.71]" ;
    ibco:heading "Visiting areas" ;
    ibco:label "1110.12.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.12.2.1 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.12.2 Visiting areas. Visiting areas in judicial facilities and Group I-3 shall comply with Sections 1110.12.2.1 and 1110.12.2.2." .

ibc:ibc2021-1110.12.2.2 a ibco:Provision ;
    ibco:bbox "[85.181, 494.658, 304.281, 538.672]" ;
    ibco:heading "Partitions" ;
    ibco:label "1110.12.2.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.13 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.12.2.2 Partitions. Where solid partitions or security glazing separate visitors from detainees, at least one of each type of cubicle or counter partition shall be accessible." .

ibc:ibc2021-1110.13 a ibco:Provision ;
    ibco:bbox "[39.599, 542.646, 304.25, 589.669]" ;
    ibco:heading "Service facilities" ;
    ibco:label "1110.13" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.13.1 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.13 Service facilities. Service facilities shall provide for accessible features in accordance with Sections 1110.14 through 1110.13.4. *" .

ibc:ibc2021-1110.13.2 a ibco:Provision ;
    ibco:bbox "[334.189, 178.805, 565.22, 255.806]" ;
    ibco:heading "Sales and service counters and windows" ;
    ibco:label "1110.13.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.13.3 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.13.2 Sales and service counters and windows. Where counters or windows are provided for sale or distribution of goods or services, at least one of each type of counter and window provided shall be accessible. Where such counters or windows are dispersed throughout the building or facility, accessible counters or windows shall also be dispersed." .

ibc:ibc2021-1110.13.3 a ibco:Provision ;
    ibco:bbox "[334.189, 259.78, 565.188, 303.793]" ;
    ibco:heading "Food service lines" ;
    ibco:label "1110.13.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.13.4 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.13.3 Food service lines. Food service lines shall be accessible. Where self-service shelves are provided, at least 50 percent, but not less than one, of each type provided shall be accessible." .

ibc:ibc2021-1110.13.4 a ibco:Provision ;
    ibco:bbox "[334.189, 307.767, 590.372, 346.79]" ;
    ibco:heading "Queue and waiting lines" ;
    ibco:label "1110.13.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.14 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.13.4 Queue and waiting lines. Queue and waiting lines servicing accessible counters or check-out aisles ** shall be accessible." .

ibc:ibc2021-1110.14 a ibco:Provision ;
    ibco:bbox "[322.177, 344.718, 565.234, 388.732]" ;
    ibco:heading "Dressing, fitting and locker rooms" ;
    ibco:label "1110.14" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.15 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.14 Dressing, fitting and locker rooms. Where dressing rooms, fitting rooms or locker rooms are provided, at least 5 percent, but not less than one, of each type of use in each cluster provided shall be accessible." .

ibc:ibc2021-1110.15 a ibco:Provision ;
    ibco:bbox "[322.177, 392.706, 586.799, 585.709]" ;
    ibco:heading "Controls, operating mechanisms and hardware" ;
    ibco:label "1110.15" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.16 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.15 Controls, operating mechanisms and hardware. Controls, operating mechanisms and hardware intended for operation by the occupant, including switches that control lighting and ventilation and electrical convenience outlets, in accessible spaces, along accessible routes or as parts of accessible elements shall be accessible. Exceptions: 1. Operable parts that are intended for use only by service or maintenance personnel shall not be required to be accessible.  2. Access doors or gates in barrier walls and fences protecting pools, spas and hot tubs shall be permitted to comply with Section 1010.2.3. 3. Operable parts exempted in accordance with ICC A117.1 are not required to be accessible. *" .

ibc:ibc2021-1110.16 a ibco:Provision ;
    ibco:bbox "[322.167, 575.671, 565.299, 630.72]" ;
    ibco:heading "Gaming machines and gaming tables" ;
    ibco:label "1110.16" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1111 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.16 Gaming machines and gaming tables. At least two percent of the total, but not fewer than one, of each gaming machine type and gaming table type shall be accessible. Where multiple gaming areas occur, accessible gaming machines and gaming tables shall be distributed throughout." .

ibc:ibc2021-1110.2 a ibco:Provision ;
    ibco:bbox "[322.201, 551.761, 565.231, 713.82]",
        "[70.769, 69.725, 289.859, 453.753]" ;
    ibco:heading "Toilet and bathing facilities" ;
    ibco:label "1110.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.1 ;
    ibco:sourcePage 366,
        367 ;
    ibco:text "1110.2 Toilet and bathing facilities. Each toilet room and bathing room shall be accessible. Where a floor level is not required to be connected by an accessible route, the only toilet rooms or bathing rooms provided within the facility shall not be located on the inaccessible floor. Except as provided for in Sections 1110.2.4 and 1110.2.5, at least one of each type of fixture, element, control or dispenser in each accessible toilet room and bathing room shall be accessible. Exceptions: 1. Toilet rooms or bathing rooms accessed only through a private office, not for common or public use and intended for use by a single occupant, shall be permitted to comply with the specific exceptions in ICC A117.1. 2. This section is not applicable to toilet and bathing rooms that serve dwelling units or sleeping units that are not required to be accessible by Section 1108. 3. Where multiple single-user toilet rooms or bathing rooms are clustered at a single location, at least 50 percent but not less than one room for each use at each cluster shall be accessible. 4. Where no more than one urinal is provided in a toilet room or bathing room, the urinal is not required to be accessible. 5. Toilet rooms or bathing rooms that are part of critical care or intensive care patient sleeping rooms serving Accessible units are not required to be accessible. 6. Toilet rooms or bathing rooms designed for bariatrics patients are not required to comply with the toilet room and bathing room requirement in ICC A117.1. The sleeping units served by bariatrics toilet or bathing rooms shall not count toward the required number of Accessible sleeping units. 7. Where permitted in Section 1108, in toilet rooms or bathrooms serving Accessible units, water closets designed for assisted toileting shall comply with Section 1110.2.2. 8. Where permitted in Section 1108, in bathrooms serving Accessible units, showers designed for assisted bathing shall comply with Section 1110.2.3. 9. Where toilet facilities are primarily for children’s use, required accessible water closets, toilet compartments and lavatories shall be permitted to comply with children’s provision of ICC A117.1." .

ibc:ibc2021-1110.2.1.1 a ibco:Provision ;
    ibco:bbox "[70.769, 652.664, 289.786, 685.641]" ;
    ibco:heading "Standard" ;
    ibco:label "1110.2.1.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.1.2 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.1 Standard. Family or assisted-use toilet and bathing rooms shall comply with Sections 1110.2.1.2 through 1110.2.1.6." .

ibc:ibc2021-1110.2.1.3 a ibco:Provision ;
    ibco:bbox "[331.771, 175.639, 550.823, 263.676]" ;
    ibco:heading "Family or assisted-use bathing rooms" ;
    ibco:label "1110.2.1.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.1.4 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.3 Family or assisted-use bathing rooms. Family or assisted-use bathing rooms shall include only one shower or bathtub fixture. Family or assisteduse bathing rooms shall also include one water closet and one lavatory. Where storage facilities are provided for separate-sex bathing rooms, accessible storage facilities shall be provided for family or assisted-use bathing rooms." .

ibc:ibc2021-1110.2.1.4 a ibco:Provision ;
    ibco:bbox "[331.771, 267.65, 550.822, 344.651]" ;
    ibco:heading "Location" ;
    ibco:label "1110.2.1.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.1.5 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.4 Location. Family or assisted-use toilet and bathing rooms shall be located on an accessible route. Family or assisted-use toilet rooms shall be located not more than one story above or below separate-sex toilet rooms. The accessible route from any separate-sex toilet room to a family or assisted-use toilet room shall not exceed 500 feet (152 m)." .

ibc:ibc2021-1110.2.1.5 a ibco:Provision ;
    ibco:bbox "[331.771, 348.625, 572.399, 414.227]" ;
    ibco:heading "Prohibited location" ;
    ibco:label "1110.2.1.5" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.1.6 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.5 Prohibited location. In passenger transportation facilities and airports, the accessible route from separate-sex toilet rooms to a family or assisteduse toilet room shall not pass through security checkpoints. " .

ibc:ibc2021-1110.2.1.6 a ibco:Provision ;
    ibco:bbox "[331.771, 407.528, 550.868, 440.866]" ;
    ibco:heading "Privacy" ;
    ibco:label "1110.2.1.6" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.6 Privacy. Doors to family or assisted-use toilet and bathing rooms shall be securable from within the room and be provided with an “occupied” indicator." .

ibc:ibc2021-1110.2.2 a ibco:Provision ;
    ibco:bbox "[319.797, 444.84, 550.811, 477.818]" ;
    ibco:heading "Water closets designed for assisted toileting" ;
    ibco:label "1110.2.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.1 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2 Water closets designed for assisted toileting. Water closets designed for assisted toileting shall comply with Sections 1110.2.2.1 through 1110.2.2.6." .

ibc:ibc2021-1110.2.2.1 a ibco:Provision ;
    ibco:bbox "[331.799, 481.792, 550.876, 525.805]" ;
    ibco:heading "Location" ;
    ibco:label "1110.2.2.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.2 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2.1 Location. The centerline of the water closet shall be not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from one side of the required clearance." .

ibc:ibc2021-1110.2.2.2 a ibco:Provision ;
    ibco:bbox "[331.799, 529.779, 550.801, 562.757]" ;
    ibco:heading "Clearance" ;
    ibco:label "1110.2.2.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.2.1 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2.2 Clearance. Clearance around the water closet shall comply with Sections 1110.2.2.2.1 through 1110.2.2.2.3." .

ibc:ibc2021-1110.2.2.2.1 a ibco:Provision ;
    ibco:bbox "[343.801, 566.731, 550.867, 632.815]" ;
    ibco:heading "Clearance width" ;
    ibco:label "1110.2.2.2.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.2.2 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2.2.1 Clearance width. Clearance around a water closet shall be not less than 66 inches (1675 mm) in width, measured perpendicularly from the side of the clearance that is not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from the water closet centerline." .

ibc:ibc2021-1110.2.2.2.2 a ibco:Provision ;
    ibco:bbox "[343.801, 636.789, 550.89, 680.802]" ;
    ibco:heading "Clearance depth" ;
    ibco:label "1110.2.2.2.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.2.3 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2.2.2 Clearance depth. Clearance around the water closet shall be not less than 78 inches (1980 mm) in depth, measured perpendicularly from the rear wall" .

ibc:ibc2021-1110.2.2.2.3 a ibco:Provision ;
    ibco:bbox "[343.801, 684.776, 550.885, 717.754]" ;
    ibco:heading "Clearance overlap" ;
    ibco:label "1110.2.2.2.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.3 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.2.2.3 Clearance overlap. The required clearance around the water closet shall permit overlaps per ICC A117.1, Section 604.3.3" .

ibc:ibc2021-1110.2.2.3 a ibco:Provision ;
    ibco:bbox "[85.199, 69.725, 304.164, 91.786]" ;
    ibco:heading "Height" ;
    ibco:label "1110.2.2.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.4 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.2.3 Height. The height of the water closet seats shall comply with ICC A117.1, Section 604.4." .

ibc:ibc2021-1110.2.2.4 a ibco:Provision ;
    ibco:bbox "[85.199, 95.76, 304.346, 281.823]" ;
    ibco:heading "Swing-up grab bars" ;
    ibco:label "1110.2.2.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.5 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.2.4 Swing-up grab bars. Swing-up grab bars shall comply with ICC A117.1, Sections 609.2 and 609.8. Swing-up grab bars shall be provided on both sides of the water closet and shall comply with all of the following: 1. The centerline of the grab bar shall be not less than 14 inches (356 mm) and not greater than 16 inches (405 mm) from the centerline of the water closet. 2. The length of the grab bar is not less than 36 inches (915 mm) in length, measured from the rear wall to the end of the grab bar. 3. The top of the grab bar in the down position is not less than 30 inches (760 mm) and not greater than34 inches (865 mm) above the floor." .

ibc:ibc2021-1110.2.2.5 a ibco:Provision ;
    ibco:bbox "[85.199, 285.797, 304.215, 307.739]" ;
    ibco:heading "Flush controls" ;
    ibco:label "1110.2.2.5" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.2.6 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.2.5 Flush controls. Flush controls shall comply with ICC A117.1, Section 604.6." .

ibc:ibc2021-1110.2.2.6 a ibco:Provision ;
    ibco:bbox "[85.199, 311.713, 304.223, 366.762]" ;
    ibco:label "1110.2.2.6" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.2.6 Dispensers Toilet paper dispensers shall be mounted on at least one of the swing-up grab bars and the outlet of the dispenser shall be located not less than 24 inches (610 mm) and not greater than 36 inches (915 mm) from the rear wall." .

ibc:ibc2021-1110.2.3 a ibco:Provision ;
    ibco:bbox "[73.197, 370.736, 304.188, 414.749]" ;
    ibco:label "1110.2.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.1 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3 Standard roll-in-type shower compartment designed for assisted bathing. Standard roll-in-type shower compartments designed for assisted bathing shall comply with Sections 1110.2.3.1 through 1110.2.3.9." .

ibc:ibc2021-1110.2.3.1 a ibco:Provision ;
    ibco:bbox "[85.199, 418.723, 304.254, 484.688]" ;
    ibco:label "1110.2.3.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.2 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.1 Size. Standard roll-in-type shower compartments shall have a clear inside dimension of not less than 60 inches (1525 mm) in width and 30 inches (760 mm) in depth, measured at the center point of opposing sides. An entry not less than 60 inches (1525 mm) in width shall be provided." .

ibc:ibc2021-1110.2.3.2 a ibco:Provision ;
    ibco:bbox "[85.199, 488.662, 304.267, 653.729]" ;
    ibco:heading "Clearance" ;
    ibco:label "1110.2.3.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.3 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.2 Clearance. A clearance of not less than 60 inches (1525 mm) in length adjacent to the 60-inch (1525 mm) width of the open face of the shower compartment, and not less than 30 inches (760 mm) in depth, shall be provided. Exceptions: 1. A lavatory complying with ICC A117.1, Section 606 shall be permitted at one end of the clearance. 2. Where the shower compartment exceeds minimum sizes, the clear floor space shall be placed adjacent to the grab bars and not less than 30 inches (762 mm) from the back wall." .

ibc:ibc2021-1110.2.3.3 a ibco:Provision ;
    ibco:bbox "[346.211, 69.556, 565.157, 91.617]",
        "[85.209, 657.703, 304.251, 734.704]" ;
    ibco:heading "Grab bars" ;
    ibco:label "1110.2.3.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.3.1 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.3 Grab bars. Grab bars shall comply with ICC A117.1, Section 609 and shall be provided in accordance with Sections 1110.2.3.3.1 and 1110.2.3.3.2. In standard roll-in-type shower compartments, grab bars shall be provided on three walls. Where multiple grab bars are used, required horizontal grab bars shall be installed at the same height above the floor. Grab bars can be separate bars or one continuous bar." .

ibc:ibc2021-1110.2.3.3.2 a ibco:Provision ;
    ibco:bbox "[358.213, 213.517, 565.571, 368.625]" ;
    ibco:heading "Sidewall grab bars" ;
    ibco:label "1110.2.3.3.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.4 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.3.2 Sidewall grab bars. The sidewall grab bars shall extend the length of the wall and extend within 6 inches (150 mm) of the adjacent back wall. Exceptions: 1. The sidewall grab bar shall not be required to exceed 30 inches (760 mm) in length. The side grab bar shall be located with one end within 6 inches (152 mm) of the back wall with a grab bar complying with Section 1110.2.3.3.1. 2. Where the sidewalls are located 72 inches (1830 mm) or greater apart, a grab bar is not required on one of the sidewalls." .

ibc:ibc2021-1110.2.3.4 a ibco:Provision ;
    ibco:bbox "[346.221, 372.599, 565.211, 394.54]" ;
    ibco:heading "Seats" ;
    ibco:label "1110.2.3.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.5 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.4 Seats. Wall-mounted folding seats shall not be installed." .

ibc:ibc2021-1110.2.3.5 a ibco:Provision ;
    ibco:bbox "[346.221, 398.514, 565.215, 464.599]" ;
    ibco:heading "Controls and hand showers" ;
    ibco:label "1110.2.3.5" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.6 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.5 Controls and hand showers. In standard roll-in-type showers, the controls and hand shower shall be located not less than 38 inches (965 mm) and not greater than 48 inches (1220 mm) above the shower floor. Controls shall be located to facilitate caregiver access." .

ibc:ibc2021-1110.2.3.6 a ibco:Provision ;
    ibco:bbox "[346.231, 468.573, 565.232, 490.515]" ;
    ibco:heading "Hand showers" ;
    ibco:label "1110.2.3.6" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.7 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.6 Hand showers. Hand showers shall comply with ICC A117.1, Section 608.5." .

ibc:ibc2021-1110.2.3.7 a ibco:Provision ;
    ibco:bbox "[346.231, 494.489, 565.152, 516.55]" ;
    ibco:heading "Thresholds" ;
    ibco:label "1110.2.3.7" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.8 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.7 Thresholds. Thresholds shall comply with ICC A117.1, Section 608.6." .

ibc:ibc2021-1110.2.3.8 a ibco:Provision ;
    ibco:bbox "[346.231, 520.524, 565.38, 553.502]" ;
    ibco:heading "Shower enclosures" ;
    ibco:label "1110.2.3.8" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.3.9 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.8 Shower enclosures. Shower compartment enclosures for shower compartments shall comply with ICC A117.1, Section 608.7." .

ibc:ibc2021-1110.2.3.9 a ibco:Provision ;
    ibco:bbox "[346.231, 557.476, 565.259, 579.826]" ;
    ibco:heading "Water temperature" ;
    ibco:label "1110.2.3.9" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.4 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.9 Water temperature. Water temperature shall comply with ICC A117.1, Section 608.8." .

ibc:ibc2021-1110.2.4 a ibco:Provision ;
    ibco:bbox "[334.194, 583.8, 565.272, 682.753]" ;
    ibco:heading "Water closet compartment" ;
    ibco:label "1110.2.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.2.5 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.4 Water closet compartment. Where water closet compartments are provided in a toilet room or bathing room, at least 5 percent of the total number of compartments shall be wheelchair accessible. Where the combined total water closet compartments and urinals provided in a toilet room or bathing room is six or more, at least 5 percent of the total number of compartments shall be ambulatory accessible, provided in addition to the wheelchair-accessible compartment." .

ibc:ibc2021-1110.2.5 a ibco:Provision ;
    ibco:bbox "[334.184, 686.727, 565.23, 730.74]",
        "[58.799, 69.725, 289.815, 124.774]" ;
    ibco:heading "Lavatories" ;
    ibco:label "1110.2.5" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.3 ;
    ibco:sourcePage 368,
        369 ;
    ibco:text "1110.2.5 Lavatories. Where lavatories are provided, at least 5 percent, but not less than one, shall be accessible. Where an accessible lavatory is located within the accessible water closet compartment at least one additional accessible lavatory shall be provided in the multicompartment toilet room outside the water closet compartment. Where the total lavatories provided in a toilet room or bathing facility is six or more, at least one lavatory with enhanced reach ranges shall be provided." .

ibc:ibc2021-1110.4 a ibco:Provision ;
    ibco:bbox "[46.787, 191.735, 289.753, 224.712]" ;
    ibco:heading "Kitchens and kitchenettes" ;
    ibco:label "1110.4" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.5 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.4 Kitchens and kitchenettes. Where kitchens and kitchenettes are provided in accessible spaces or rooms, they shall be accessible." .

ibc:ibc2021-1110.5 a ibco:Provision ;
    ibco:bbox "[46.777, 228.686, 289.773, 272.819]" ;
    ibco:heading "Drinking fountains" ;
    ibco:label "1110.5" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.5.1 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.5 Drinking fountains. Where drinking fountains are provided on an exterior site, on a floor or within a secured area, the drinking fountains shall be provided in accordance with Sections 1110.5.1 and 1110.5.2." .

ibc:ibc2021-1110.5.1 a ibco:Provision ;
    ibco:bbox "[58.779, 276.793, 289.797, 485.764]" ;
    ibco:heading "Minimum number" ;
    ibco:label "1110.5.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.5.2 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.5.1 Minimum number. Not fewer than two drinking fountains shall be provided. One drinking fountain shall comply with the requirements for people who use a wheelchair and one drinking fountain shall comply with the requirements for standing persons. Exceptions: 1. A single drinking fountain with two separate spouts that complies with the requirements for people who use a wheelchair and standing persons shall be permitted to be substituted for two separate drinking fountains. 2. Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:ibc2021-1110.5.2 a ibco:Provision ;
    ibco:bbox "[361.782, 69.556, 550.737, 91.617]",
        "[58.779, 489.738, 289.797, 720.661]" ;
    ibco:heading "More than the minimum number" ;
    ibco:label "1110.5.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.6 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.5.2 More than the minimum number. Where more than the minimum number of drinking fountains specified in Section 1110.5.1 is provided, 50 percent of the total number of drinking fountains provided shall comply with the requirements for persons who use a wheelchair and 50 percent of the total number of drinking fountains provided shall comply with the requirements for standing persons. Exceptions: 1. Where 50 percent of the drinking fountains yields a fraction, 50 percent shall be permitted to be rounded up or down, provided that the total number of drinking fountains complying with this section equals 100 percent of the drinking fountains. 2. Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:ibc2021-1110.8 a ibco:Provision ;
    ibco:bbox "[307.789, 243.636, 550.774, 265.578]" ;
    ibco:heading "Elevators" ;
    ibco:label "1110.8" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1110.9 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.8 Elevators. Passenger elevators on an accessible route shall be accessible and comply with Chapter 30." .

ibc:ibc2021-1111.1 a ibco:Provision ;
    ibco:bbox "[322.167, 677.651, 565.171, 710.748]" ;
    ibco:heading "General" ;
    ibco:label "1111.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.2 ;
    ibco:sourcePage 370 ;
    ibco:text "1111.1 General. Recreational facilities shall be provided with accessible features in accordance with Sections 1111.2 through 1111.4." .

ibc:ibc2021-1111.2 a ibco:Provision ;
    ibco:bbox "[46.799, 69.725, 289.889, 113.738]" ;
    ibco:label "1111.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.2.1 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.2 Facilities serving Group R-2, R-3 and R-4 occupancies. Recreational facilities that serve Group R-2, R-3 and Group R-4 occupancies shall comply with Sections 1111.2.1 through 1111.2.3, as applicable." .

ibc:ibc2021-1111.2.1 a ibco:Provision ;
    ibco:bbox "[58.801, 117.712, 289.859, 161.725]" ;
    ibco:heading "Facilities serving Accessible units" ;
    ibco:label "1111.2.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.2.2 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.2.1 Facilities serving Accessible units. In Group R-2 and R-4 occupancies where recreational facilities serve Accessible units, every recreational facility of each type serving Accessible units shall be accessible." .

ibc:ibc2021-1111.2.2 a ibco:Provision ;
    ibco:bbox "[58.801, 165.699, 290.023, 253.736]" ;
    ibco:label "1111.2.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.2.3 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.2.2 Facilities serving Type A and Type B units in a single building. In Group R-2, R-3 and R-4 occupancies where recreational facilities serve a single building containing Type A units or Type B units, 25 percent, but not less than one, of each type of recreational facility shall be accessible. Every recreational facility of each type on a site shall be considered to determine the total number of each type that is required to be accessible." .

ibc:ibc2021-1111.2.3 a ibco:Provision ;
    ibco:bbox "[58.791, 257.71, 290.014, 367.698]" ;
    ibco:label "1111.2.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.3 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.2.3 Facilities serving Type A and Type B units in multiple buildings. In Group R-2, R-3 and R-4 occupancies on a single site where multiple buildings containing Type A units or Type B units are served by recreational facilities, 25 percent, but not less than one, of each type of recreational facility serving each building shall be accessible. The total number of each type of recreational facility that is required to be accessible shall be determined by considering every recreational facility of each type serving each building on the site." .

ibc:ibc2021-1111.3 a ibco:Provision ;
    ibco:bbox "[46.789, 371.672, 289.753, 393.734]" ;
    ibco:heading "Other occupancies" ;
    ibco:label "1111.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.3 Other occupancies. Recreational facilities not falling within the purview of Section 1111.2 shall be accessible." .

ibc:ibc2021-1111.4 a ibco:Provision ;
    ibco:bbox "[46.779, 397.708, 289.77, 430.685]" ;
    ibco:heading "Recreational facilities" ;
    ibco:label "1111.4" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.1 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4 Recreational facilities. Recreational facilities shall be accessible and shall be on an accessible route to the extent specified in this section." .

ibc:ibc2021-1111.4.1 a ibco:Provision ;
    ibco:bbox "[58.771, 434.659, 289.825, 478.673]" ;
    ibco:heading "Area of sport activity" ;
    ibco:label "1111.4.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.2 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.1 Area of sport activity. Each area of sport activity shall be on an accessible route and shall not be required to be accessible except as provided for in Sections 1111.4.2 through 1111.4.15." .

ibc:ibc2021-1111.4.10 a ibco:Provision ;
    ibco:bbox "[73.187, 413.735, 304.322, 446.833]" ;
    ibco:heading "Exercise machines and equipment" ;
    ibco:label "1111.4.10" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.11 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.10 Exercise machines and equipment. At least one of each type of exercise machine and equipment shall be on an accessible route." .

ibc:ibc2021-1111.4.11 a ibco:Provision ;
    ibco:bbox "[73.187, 450.807, 304.171, 483.784]" ;
    ibco:heading "Fishing piers and platforms" ;
    ibco:label "1111.4.11" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.12 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.11 Fishing piers and platforms. Fishing piers and platforms shall be accessible and be on an accessible route." .

ibc:ibc2021-1111.4.12 a ibco:Provision ;
    ibco:bbox "[73.187, 487.758, 304.155, 520.736]" ;
    ibco:heading "Miniature golf facilities" ;
    ibco:label "1111.4.12" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.12.1 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.12 Miniature golf facilities. Miniature golf facilities shall comply with Sections 1111.4.12.1 through 1111.4.12.3." .

ibc:ibc2021-1111.4.12.1 a ibco:Provision ;
    ibco:bbox "[85.189, 524.71, 304.182, 546.771]" ;
    ibco:heading "Minimum number" ;
    ibco:label "1111.4.12.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.12.2 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.12.1 Minimum number. At least 50 percent of holes on miniature golf courses shall be accessible." .

ibc:ibc2021-1111.4.12.3 a ibco:Provision ;
    ibco:bbox "[85.189, 668.672, 304.161, 701.769]" ;
    ibco:heading "Accessible route" ;
    ibco:label "1111.4.12.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.13 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.12.3 Accessible route. Holes required to comply with Section 1111.4.12.1, including the start of play, shall be on an accessible route." .

ibc:ibc2021-1111.4.13 a ibco:Provision ;
    ibco:bbox "[334.189, 69.627, 565.244, 102.724]" ;
    ibco:heading "Play areas" ;
    ibco:label "1111.4.13" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.14 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.13 Play areas. Play areas containing play components designed and constructed for children shall be located on an accessible route." .

ibc:ibc2021-1111.4.14 a ibco:Provision ;
    ibco:bbox "[334.189, 106.699, 565.256, 340.629]" ;
    ibco:label "1111.4.14" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.14.1 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.14 Swimming pools, wading pools, cold baths, hot tubs and spas. Swimming pools, wading pools, cold baths, hot tubs and spas shall be accessible and be on an accessible route. Exceptions: 1. Catch pools or a designated section of a pool used as a terminus for a water slide flume shall not be required to provide an accessible means of entry, provided that a portion of the catch pool edge is on an accessible route. 2. Where spas, cold baths or hot tubs are provided in a cluster, at least 5 percent, but not less than one of each type of spa, cold bath or hot tub in each cluster, shall be accessible and be on an accessible route. 3. Swimming pools, wading pools, spas, cold baths and hot tubs that are required to be accessible by Sections 1111.2.2 and 1111.2.3 are not required to provide accessible means of entry into the water." .

ibc:ibc2021-1111.4.14.1 a ibco:Provision ;
    ibco:bbox "[346.191, 344.603, 565.22, 388.616]" ;
    ibco:label "1111.4.14.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.14.2 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.14.1 Raised diving boards and diving platforms. Raised diving boards and diving platforms are not required to be accessible or to be on an accessible route." .

ibc:ibc2021-1111.4.14.2 a ibco:Provision ;
    ibco:bbox "[346.181, 392.59, 565.23, 425.862]" ;
    ibco:heading "Water slides" ;
    ibco:label "1111.4.14.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.15 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.14.2 Water slides. Water slides are not required to be accessible or to be on an accessible route." .

ibc:ibc2021-1111.4.3 a ibco:Provision ;
    ibco:bbox "[58.781, 567.705, 289.778, 600.682]" ;
    ibco:heading "Bowling lanes" ;
    ibco:label "1111.4.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.4 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.3 Bowling lanes. An accessible route shall be provided to at least 5 percent, but not less than one, of each type of bowling lane." .

ibc:ibc2021-1111.4.4 a ibco:Provision ;
    ibco:bbox "[58.791, 604.656, 289.745, 626.718]" ;
    ibco:heading "Court sports" ;
    ibco:label "1111.4.4" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.5 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.4 Court sports. In court sports, at least one accessible route shall directly connect both sides of the court." .

ibc:ibc2021-1111.4.5 a ibco:Provision ;
    ibco:bbox "[58.801, 630.692, 289.784, 663.83]" ;
    ibco:heading "Raised boxing or wrestling rings" ;
    ibco:label "1111.4.5" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.6 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.5 Raised boxing or wrestling rings. Raised boxing or wrestling rings are not required to be accessible or to be on an accessible route." .

ibc:ibc2021-1111.4.6 a ibco:Provision ;
    ibco:bbox "[58.799, 667.804, 289.942, 711.818]" ;
    ibco:heading "Raised refereeing, judging and scoring areas" ;
    ibco:label "1111.4.6" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.7 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.6 Raised refereeing, judging and scoring areas. Raised structures used solely for refereeing, judging or scoring a sport are not required to be accessible or to be on an accessible route." .

ibc:ibc2021-1111.4.7 a ibco:Provision ;
    ibco:bbox "[319.801, 69.716, 550.823, 102.813]" ;
    ibco:heading "Animal containment areas" ;
    ibco:label "1111.4.7" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.8 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.7 Animal containment areas. Animal containment areas that are not within public use areas are not required to be accessible or to be on an accessible route." .

ibc:ibc2021-1111.4.8.1 a ibco:Provision ;
    ibco:bbox "[331.793, 169.775, 550.817, 235.74]" ;
    ibco:heading "Load and unload areas" ;
    ibco:label "1111.4.8.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.8.2 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.8.1 Load and unload areas. Load and unload areas serving amusement rides shall be accessible and be on an accessible route. Where load and unload areas have more than one loading or unloading position, at least one loading and unloading position shall be on an accessible route." .

ibc:ibc2021-1111.4.8.2 a ibco:Provision ;
    ibco:bbox "[331.793, 239.714, 550.822, 326.814]" ;
    ibco:label "1111.4.8.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.8.3 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.8.2 Wheelchair spaces, ride seats designed for transfer and transfer devices. Where amusement rides are in the load and unload position, the following shall be on an accessible route. 1. The position serving a wheelchair space. 2. Amusement ride seats designed for transfer. 3. Transfer devices." .

ibc:ibc2021-1111.4.8.3 a ibco:Provision ;
    ibco:bbox "[331.793, 330.788, 550.866, 509.779]" ;
    ibco:heading "Minimum number" ;
    ibco:label "1111.4.8.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.9 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.8.3 Minimum number. Amusement rides shall provide at least one wheelchair space, amusement ride seat designed for transfer or transfer device. Exceptions: 1. Amusement rides that are controlled or operated by the rider are not required to comply with this section. 2. Amusement rides designed primarily for children, where children are assisted on and off the ride by an adult, are not required to comply with this section. 3. Amusement rides that do not provide seats that are built-in or mechanically fastened shall not be required to comply with this section." .

ibc:ibc2021-1111.4.9 a ibco:Provision ;
    ibco:bbox "[319.801, 513.753, 550.877, 568.683]" ;
    ibco:heading "Recreational boating facilities" ;
    ibco:label "1111.4.9" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.9.1 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.9 Recreational boating facilities. Boat slips required to be accessible by Sections 1111.4.9.1 and 1111.4.9.2 and boarding piers at boat launch ramps required to be accessible by Section 1111.4.9.3 shall be on an accessible route." .

ibc:ibc2021-1111.4.9.2 a ibco:Provision ;
    ibco:bbox "[85.199, 306.845, 304.23, 361.774]" ;
    ibco:heading "Dispersion" ;
    ibco:label "1111.4.9.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.9.3 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.9.2 Dispersion. Accessible boat slips shall be dispersed throughout the various types of boat slips provided. Where the minimum number of accessible boat slips has been met, further dispersion shall not be required." .

ibc:ibc2021-1111.4.9.3 a ibco:Provision ;
    ibco:bbox "[85.199, 365.748, 304.204, 409.761]" ;
    ibco:heading "Boarding piers at boat launch ramps" ;
    ibco:label "1111.4.9.3" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-1111.4.10 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.9.3 Boarding piers at boat launch ramps. Where boarding piers are provided at boat launch ramps, at least 5 percent, but not less than one, of the boarding piers shall be accessible." .

ibc:ibc2021-1112.2 a ibco:Provision ;
    ibco:bbox "[46.768, 355.776, 289.783, 443.812]" ;
    ibco:heading "Signs identifying toilet or bathing rooms" ;
    ibco:label "1112.2" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-1112.3 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.2 Signs identifying toilet or bathing rooms. Signs required in Section 403.4 of the International Plumbing Code identifying toilet rooms and bathing rooms shall be visual characters, raised characters and braille complying with ICC A117.1. Where pictograms are provided as designations for toilet rooms and bathing rooms, the pictograms shall have visual characters, raised characters and braille complying with ICC A117.1." .

ibc:ibc2021-1112.3 a ibco:Provision ;
    ibco:bbox "[46.768, 447.787, 289.836, 708.729]" ;
    ibco:heading "Directional signage" ;
    ibco:label "1112.3" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-1112.4 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.3 Directional signage. Directional signage indicating the route to the nearest like accessible element shall be provided at the following locations. These directional signs shall include the International Symbol of Accessibility and sign characters shall meet the visual character requirements in accordance with ICC A117.1. 1. Inaccessible building entrances. 2. Inaccessible public toilets and bathing facilities. 3. Elevators not serving an accessible route. 4. At each separate-sex toilet and bathing room indicating the location of the nearest family/assisted use toilet or bathing room where provided in accordance with Section 1110.2.1. 5. At exits and exit stairways serving a required accessible space, but not providing an approved accessible means of egress, signage shall be provided in accordance with Section 1009.10. 6. Where drinking fountains for persons using wheelchairs and drinking fountains for standing persons are not located adjacent to each other, directional signage shall be provided indicating the location of the other drinking fountains." .

ibc:ibc2021-1112.5 a ibco:Provision ;
    ibco:bbox "[307.829, 507.755, 550.867, 551.768]" ;
    ibco:heading "Variable message signs" ;
    ibco:label "1112.5" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-1112.5.1 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.5 Variable message signs. Where provided in the locations in Sections 1112.5.1 and 1112.5.2, variable message signs shall comply with the variable message sign requirements of ICC A117.1." .

ibc:ibc2021-1112.5.1 a ibco:Provision ;
    ibco:bbox "[319.831, 555.742, 550.843, 599.755]" ;
    ibco:heading "Transportation facilities" ;
    ibco:label "1112.5.1" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-1112.5.2 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.5.1 Transportation facilities. Where provided in transportation facilities, variable message signs conveying transportation-related information shall comply with Section 1112.5." .

ibc:ibc2021-2 a ibco:ListItem ;
    ibco:bbox "[70.799, 462.746, 289.875, 649.646]" ;
    ibco:label "2" ;
    ibco:partOf ibc:ibc2021-1108.5.1.2 ;
    ibco:precedes ibc:ibc2021-1108.5.1.3 ;
    ibco:sourcePage 361 ;
    ibco:text "2. In Group I-1, Condition 2, at least 10 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units. Accessible dwelling units and sleeping units shall be dispersed among the various classes of units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of the Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 50 percent of the Accessible units." .

ibc:ibc2021-a a ibco:ListItem ;
    ibco:bbox "[322.199, 457.222, 565.221, 483.984]" ;
    ibco:label "a" ;
    ibco:partOf ibc:ibc2021-1105.1.1 ;
    ibco:precedes ibc:ibc2021-1105.1.2 ;
    ibco:sourcePage 358 ;
    ibco:text "a. In mixed-use facilities where the total sum of the building occupant load is greater than those listed, the most restrictive building occupant load shall apply." .

ibc:ibc2021-n0002 a ibco:BuildingCodeEntity ;
    ibco:bbox "[250.679, 89.595, 375.641, 107.407]" ;
    ibco:partOf ibc:ibc2021-11 ;
    ibco:precedes ibc:ibc2021-n0003 ;
    ibco:sourcePage 356 ;
    ibco:text "ACCESSIBILITY" .

ibc:ibc2021-n0003 a ibco:BuildingCodeEntity ;
    ibco:bbox "[61.199, 128.191, 565.21, 275.03]" ;
    ibco:partOf ibc:ibc2021-11 ;
    ibco:precedes ibc:ibc2021-1101 ;
    ibco:sourcePage 356 ;
    ibco:text "User note: About this chapter: Chapter 11 contains provisions that set forth requirements for accessibility of buildings and their associated sites and facilities for people with physical disabilities. The fundamental philosophy of the code on the subject of accessibility is that everything is required to be accessible. This is reflected in the basic applicability requirement (see Section 1103.1). The code’s scoping requirements then address the conditions under which accessibility is not required in terms of exceptions to this general mandate. While the IBC contains scoping provisions for accessibility (for example, what, where and how many), ICC A117.1, Accessible and Usable Buildings and Facilities, is the referenced standard for the technical provisions (in other words, how). Accessibility criteria for existing buildings are addressed in the International Existing Building Code®. The International Residential Code® references Chapter 11 for accessibility provisions; therefore, this chapter may be applicable to housing covered under the International Residential Code. The provisions in the I-Codes are intended to meet or exceed the requirements in the federal accessibility requirement found in the Americans with Disabilities Act and the Fair Housing Act. There are many accessibility issues that not only benefit people with disabilities, but also provide a tangible benefit to people without disabilities. This type of requirement can be set forth in the code as generally applicable without necessarily identifying it specifically as an accessibility-related issue. Such a requirement would then be considered as having been “mainstreamed.” For example, visible alarms are located in Chapter 9 and accessible means of egress and ramp requirements are addressed in Chapter 10." .

ibc:ibc2021-n0027 a ibco:Exception ;
    ibco:bbox "[58.789, 470.665, 289.92, 525.714]" ;
    ibco:partOf ibc:ibc2021-1104.1 ;
    ibco:precedes ibc:ibc2021-1104.2 ;
    ibco:sourcePage 357 ;
    ibco:text "Exception: Other than in buildings or facilities containing or serving Type B units, an accessible route shall not be required between site arrival points and the building or facility entrance if the only means of access between them is a vehicular way not providing for pedestrian access." .

ibc:ibc2021-n0035 a ibco:Exception ;
    ibco:bbox "[334.157, 69.613, 565.282, 135.809]",
        "[73.155, 696.744, 304.164, 729.721]" ;
    ibco:partOf ibc:ibc2021-1104.6 ;
    ibco:precedes ibc:ibc2021-1105 ;
    ibco:sourcePage 358 ;
    ibco:text "Exception: Where security barriers incorporate elements that cannot comply with these requirements, such as certain metal detectors, fluoroscopes or other similar devices, the accessible route shall be permitted to be provided adjacent to security screening devices. The accessible route shall permit persons with disabilities passing around security barriers to maintain visual contact with their personal items to the same extent provided others passing through the security barrier." .

ibc:ibc2021-n0046 a ibco:Exception ;
    ibco:bbox "[70.801, 95.76, 289.939, 128.738]" ;
    ibco:partOf ibc:ibc2021-1105.1.7 ;
    ibco:precedes ibc:ibc2021-1105.1.8 ;
    ibco:sourcePage 359 ;
    ibco:text "Exception: An accessible entrance is not required to self-service storage facilities that are not required to be accessible." .

ibc:ibc2021-n0048 a ibco:Exception ;
    ibco:bbox "[70.801, 169.783, 289.795, 202.761]" ;
    ibco:partOf ibc:ibc2021-1105.1.8 ;
    ibco:precedes ibc:ibc2021-1106 ;
    ibco:sourcePage 359 ;
    ibco:text "Exception: An accessible entrance is not required to dwelling units and sleeping units that are not required to be Accessible units, Type A units or Type B units." .

ibc:ibc2021-n0052 a ibco:Exception ;
    ibco:bbox "[58.799, 356.702, 289.827, 440.027]" ;
    ibco:partOf ibc:ibc2021-1106.2 ;
    ibco:precedes ibc:ibc2021-1106.3 ;
    ibco:sourcePage 359 ;
    ibco:text "Exception: This section does not apply to parking spaces used exclusively for buses, trucks, other delivery vehicles, law enforcement vehicles or vehicular impound and motor pools where lots accessed by the public are provided with an accessible passenger loading zone. TABLE 1106.2 ACCESSIBLE PARKING SPACES" .

ibc:ibc2021-n0057 a ibco:Exception ;
    ibco:bbox "[319.793, 369.755, 550.863, 424.685]" ;
    ibco:partOf ibc:ibc2021-1106.6 ;
    ibco:precedes ibc:ibc2021-1106.7 ;
    ibco:sourcePage 359 ;
    ibco:text "Exception: In Group U private garages that serve Group R-2 and R-3 occupancies, van-accessible spaces shall be permitted to have vehicular routes, entrances, parking spaces and access aisles with a minimum vertical clearance of 7 feet (2134 mm)." .

ibc:ibc2021-n0068 a ibco:Exception ;
    ibco:bbox "[73.199, 345.786, 304.242, 378.764]" ;
    ibco:partOf ibc:ibc2021-1107.2 ;
    ibco:precedes ibc:ibc2021-1107.2.1 ;
    ibco:sourcePage 360 ;
    ibco:text "Exception: Electrical vehicle charging stations provided to serve Group R-2, R-3 and R-4 occupancies are not required to comply with this section." .

ibc:ibc2021-n0083 a ibco:Exception ;
    ibco:bbox "[82.797, 712.792, 289.78, 734.853]" ;
    ibco:partOf ibc:ibc2021-1108.5.1.3 ;
    ibco:precedes ibc:ibc2021-1108.5.2 ;
    ibco:sourcePage 361 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0087 a ibco:Exception ;
    ibco:bbox "[343.799, 345.756, 550.781, 367.698]" ;
    ibco:partOf ibc:ibc2021-1108.5.2.2 ;
    ibco:precedes ibc:ibc2021-1108.5.3 ;
    ibco:sourcePage 361 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0090 a ibco:Exception ;
    ibco:bbox "[343.789, 467.646, 550.829, 511.66]" ;
    ibco:partOf ibc:ibc2021-1108.5.3.1 ;
    ibco:precedes ibc:ibc2021-1108.5.3.2 ;
    ibco:sourcePage 361 ;
    ibco:text "Exception: Entry doors to Accessible dwelling units or sleeping units shall not be required to provide the maneuvering clearance beyond the latch side of the door." .

ibc:ibc2021-n0092 a ibco:Exception ;
    ibco:bbox "[343.799, 574.792, 550.782, 596.853]" ;
    ibco:partOf ibc:ibc2021-1108.5.3.2 ;
    ibco:precedes ibc:ibc2021-1108.5.4 ;
    ibco:sourcePage 361 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0097 a ibco:Exception ;
    ibco:bbox "[97.179, 316.733, 304.182, 360.746]" ;
    ibco:partOf ibc:ibc2021-1108.5.5.2 ;
    ibco:precedes ibc:ibc2021-1108.5.5.3 ;
    ibco:sourcePage 362 ;
    ibco:text "Exception: Cells or rooms specially designed without protrusions and that are used solely for purposes of suicide prevention shall not be required to include grab bars." .

ibc:ibc2021-n0103 a ibco:Exception ;
    ibco:bbox "[358.191, 231.704, 565.174, 253.765]" ;
    ibco:partOf ibc:ibc2021-1108.6.1.2 ;
    ibco:precedes ibc:ibc2021-1108.6.2 ;
    ibco:sourcePage 362 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0106 a ibco:Exception ;
    ibco:bbox "[358.161, 375.785, 565.144, 397.727]" ;
    ibco:partOf ibc:ibc2021-1108.6.2.1 ;
    ibco:precedes ibc:ibc2021-1108.6.2.2 ;
    ibco:sourcePage 362 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0110 a ibco:Exception ;
    ibco:bbox "[94.811, 309.781, 289.745, 342.758]" ;
    ibco:partOf ibc:ibc2021-1108.6.2.2.2 ;
    ibco:precedes ibc:ibc2021-1108.6.2.3 ;
    ibco:sourcePage 363 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0114 a ibco:Exception ;
    ibco:bbox "[94.802, 611.748, 289.736, 644.845]" ;
    ibco:partOf ibc:ibc2021-1108.6.2.3.2 ;
    ibco:precedes ibc:ibc2021-1108.6.3 ;
    ibco:sourcePage 363 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0116 a ibco:Exception ;
    ibco:bbox "[331.8, 95.711, 550.787, 117.772]" ;
    ibco:partOf ibc:ibc2021-1108.6.3 ;
    ibco:precedes ibc:ibc2021-1108.6.4 ;
    ibco:sourcePage 363 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0120 a ibco:Exception ;
    ibco:bbox "[343.782, 287.66, 550.765, 309.721]" ;
    ibco:partOf ibc:ibc2021-1108.6.4.2 ;
    ibco:precedes ibc:ibc2021-1108.7 ;
    ibco:sourcePage 363 ;
    ibco:text "Exception: The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:ibc2021-n0140 a ibco:Exception ;
    ibco:bbox "[70.811, 414.759, 289.744, 436.701]" ;
    ibco:partOf ibc:ibc2021-1109.2.5 ;
    ibco:precedes ibc:ibc2021-1109.2.6 ;
    ibco:sourcePage 365 ;
    ibco:text "Exception: Designated aisle seats are not required in team or player seating serving areas of sport activity." .

ibc:ibc2021-n0143 a ibco:Exception ;
    ibco:bbox "[70.811, 525.733, 332.359, 609.351]" ;
    ibco:partOf ibc:ibc2021-1109.2.7 ;
    ibco:precedes ibc:ibc2021-1109.2.7.1 ;
    ibco:sourcePage 365 ;
    ibco:text "Exception: Other than in courtrooms, an assistive listening system is not required where there is no audio amplification system. TABLE 1109.2.7.1" .

ibc:ibc2021-n0149 a ibco:BuildingCodeEntity ;
    ibco:bbox "[46.791, 729.624, 138.109, 738.391]",
        "[97.169, 69.725, 304.207, 240.788]" ;
    ibco:partOf ibc:ibc2021-1109.2.9 ;
    ibco:precedes ibc:ibc2021-1109.2.9.1 ;
    ibco:sourcePage 365,
        366 ;
    ibco:text "Note: * = or fraction thereof 2. An accessible route to dining and drinking areas in a mezzanine is not required, provided that the mezzanine contains less than 25 percent of the total combined area for dining and drinking and the same services, and decor are provided in the accessible area. 3. In sports facilities, tiered dining areas providing seating required to be accessible shall be required to have accessible routes serving at least 25 percent of the dining area, provided that accessible routes serve accessible seating and where each tier is provided with the same services. 4. Employee-only work areas shall comply with Sections 1103.2.2 and 1104.3.1." .

ibc:ibc2021-n0156 a ibco:Exception ;
    ibco:bbox "[97.203, 611.718, 304.241, 633.78]" ;
    ibco:partOf ibc:ibc2021-1109.4.1.1 ;
    ibco:precedes ibc:ibc2021-1109.4.1.2 ;
    ibco:sourcePage 366 ;
    ibco:text "Exception: Adjacent companion seating is not required." .

ibc:ibc2021-n0166 a ibco:Exception ;
    ibco:bbox "[334.151, 525.654, 565.172, 547.787]" ;
    ibco:partOf ibc:ibc2021-1110.1 ;
    ibco:precedes ibc:ibc2021-1110.2 ;
    ibco:sourcePage 366 ;
    ibco:text "Exception: Accessible units, Type A units and Type B units shall comply with Chapter 10 of ICC A117.1." .

ibc:ibc2021-n0169 a ibco:Exception ;
    ibco:bbox "[70.769, 615.712, 289.77, 648.69]" ;
    ibco:partOf ibc:ibc2021-1110.2.1 ;
    ibco:precedes ibc:ibc2021-1110.2.1.1 ;
    ibco:sourcePage 367 ;
    ibco:text "Exception: Where each separate-sex bathing room has only one shower or bathtub fixture, a family or assisted-use bathing room is not required." .

ibc:ibc2021-n0172 a ibco:Exception ;
    ibco:bbox "[343.773, 106.637, 550.809, 171.665]" ;
    ibco:partOf ibc:ibc2021-1110.2.1.2 ;
    ibco:precedes ibc:ibc2021-1110.2.1.3 ;
    ibco:sourcePage 367 ;
    ibco:text "Exception: The following additional fixtures shall be permitted in a family or assisted-use toilet room: 1. A urinal. 2. A child-height water closet. 3. A child-height lavatory." .

ibc:ibc2021-n0192 a ibco:Exception ;
    ibco:bbox "[370.215, 143.578, 565.208, 209.543]" ;
    ibco:partOf ibc:ibc2021-1110.2.3.3.1 ;
    ibco:precedes ibc:ibc2021-1110.2.3.3.2 ;
    ibco:sourcePage 368 ;
    ibco:text "Exception: The back-wall grab bar shall not be required to exceed 48 inches (1220 mm) in length. The rear grab bar shall be located with one end within 6 inches maximum of a sidewall with a grab bar complying with Section 1110.2.3.3.2." .

ibc:ibc2021-n0203 a ibco:Exception ;
    ibco:bbox "[58.789, 165.699, 289.788, 187.761]" ;
    ibco:partOf ibc:ibc2021-1110.3 ;
    ibco:precedes ibc:ibc2021-1110.4 ;
    ibco:sourcePage 369 ;
    ibco:text "Exception: Mop or service sinks are not required to be accessible." .

ibc:ibc2021-n0209 a ibco:Exception ;
    ibco:bbox "[319.781, 121.626, 550.891, 165.64]" ;
    ibco:partOf ibc:ibc2021-1110.6 ;
    ibco:precedes ibc:ibc2021-1110.7 ;
    ibco:sourcePage 369 ;
    ibco:text "Exception: Bottle-filling stations over drinking fountains for standing persons are not required to be accessible, provided that bottle-filling stations are also located over the drinking fountains for persons using wheelchairs." .

ibc:ibc2021-n0211 a ibco:Exception ;
    ibco:bbox "[319.781, 195.53, 550.85, 239.543]" ;
    ibco:partOf ibc:ibc2021-1110.7 ;
    ibco:precedes ibc:ibc2021-1110.8 ;
    ibco:sourcePage 369 ;
    ibco:text "Exception: Where saunas or steam rooms are clustered at a single location, at least 5 percent of the saunas and steam rooms, but not less than one, of each type in each cluster shall be accessible." .

ibc:ibc2021-n0228 a ibco:Exception ;
    ibco:bbox "[73.189, 191.735, 304.236, 213.796]" ;
    ibco:partOf ibc:ibc2021-1110.11 ;
    ibco:precedes ibc:ibc2021-1110.12 ;
    ibco:sourcePage 370 ;
    ibco:text "Exception: Detectable warnings are not required at bus stops." .

ibc:ibc2021-n0230 a ibco:Exception ;
    ibco:bbox "[73.189, 276.793, 304.188, 309.771]" ;
    ibco:partOf ibc:ibc2021-1110.12 ;
    ibco:precedes ibc:ibc2021-1110.12.1 ;
    ibco:sourcePage 370 ;
    ibco:text "Exception: Check-writing surfaces at check-out aisles not required to comply with Section 1110.13.1 are not required to be accessible." .

ibc:ibc2021-n0234 a ibco:Exception ;
    ibco:bbox "[97.183, 457.707, 304.433, 490.684]" ;
    ibco:partOf ibc:ibc2021-1110.12.2.1 ;
    ibco:precedes ibc:ibc2021-1110.12.2.2 ;
    ibco:sourcePage 370 ;
    ibco:text "Exception: This requirement shall not apply to the detainee side of cubicles or counters at noncontact visiting areas not serving Accessible unit holding cells." .

ibc:ibc2021-n0238 a ibco:Exception ;
    ibco:bbox "[377.28, 70.112, 510.027, 87.947]",
        "[85.171, 693.679, 304.32, 726.826]" ;
    ibco:partOf ibc:ibc2021-1110.13.1 ;
    ibco:precedes ibc:ibc2021-1110.13.2 ;
    ibco:sourcePage 370 ;
    ibco:text "Exception: Where the public use area is under 5,000 square feet (465 m2) not more than one accessible check-out aisle shall be required. TABLE 1110.13.1 ACCESSIBLE CHECK-OUT AISLES" .

ibc:ibc2021-n0255 a ibco:Exception ;
    ibco:bbox "[70.783, 519.718, 289.899, 563.731]" ;
    ibco:partOf ibc:ibc2021-1111.4.2 ;
    ibco:precedes ibc:ibc2021-1111.4.3 ;
    ibco:sourcePage 371 ;
    ibco:text "Exception: Wheelchair spaces shall not be required in team or player seating areas serving bowling lanes that are not required to be accessible in accordance with Section 1111.4.3." .

ibc:ibc2021-n0262 a ibco:Exception ;
    ibco:bbox "[331.803, 143.739, 550.818, 165.801]" ;
    ibco:partOf ibc:ibc2021-1111.4.8 ;
    ibco:precedes ibc:ibc2021-1111.4.8.1 ;
    ibco:sourcePage 371 ;
    ibco:text "Exception: Mobile or portable amusement rides shall not be required to be accessible." .

ibc:ibc2021-n0268 a ibco:Exception ;
    ibco:bbox "[149.399, 70.112, 215.965, 87.947]",
        "[343.814, 664.667, 550.893, 697.645]" ;
    ibco:partOf ibc:ibc2021-1111.4.9.1 ;
    ibco:precedes ibc:ibc2021-1111.4.9.2 ;
    ibco:sourcePage 371,
        372 ;
    ibco:text "Exception: Boat slips not designed for embarking or disembarking are not required to be accessible or be on an accessible route. TABLE 1111.4.9.1 BOAT SLIPS" .

ibc:ibc2021-n0276 a ibco:Exception ;
    ibco:bbox "[97.191, 620.684, 304.233, 664.698]" ;
    ibco:partOf ibc:ibc2021-1111.4.12.2 ;
    ibco:precedes ibc:ibc2021-1111.4.12.3 ;
    ibco:sourcePage 372 ;
    ibco:text "Exception: One break in the sequence of consecutive holes shall be permitted provided that the last hole on the miniature golf course is the last hole in the sequence." .

ibc:ibc2021-n0283 a ibco:Exception ;
    ibco:bbox "[346.195, 488.739, 565.217, 554.866]" ;
    ibco:partOf ibc:ibc2021-1111.4.15 ;
    ibco:precedes ibc:ibc2021-1112 ;
    ibco:sourcePage 372 ;
    ibco:text "Exception: Shooting facilities with firing positions on free-standing platforms that are elevated more than 12 feet (3660 mm) above grade, provided that the aggregate area of the elevated firing positions is not more than 500 square feet (46 m2), are not required to be accessible." .

ibc:ibc2021-n0301 a ibco:Exception ;
    ibco:bbox "[319.791, 165.708, 550.896, 503.781]" ;
    ibco:partOf ibc:ibc2021-1112.4 ;
    ibco:precedes ibc:ibc2021-1112.5 ;
    ibco:sourcePage 373 ;
    ibco:text "Exception: Where ticket offices or windows are provided, signs are not required at each assembly area provided that signs are displayed at each ticket office or window informing patrons of the availability of assistive listening systems. 2. At each door to an area of refuge providing direct access to a stairway, exterior area for assisted rescue, exit stairway, exit passageway or exit discharge, signage shall be provided in accordance with Section 1013.4. 3. At areas of refuge, signage shall be provided in accordance with Section 1009.11. 4. At exterior areas for assisted rescue, signage shall be provided in accordance with Section 1009.11. 5. At two-way communication systems, signage shall be provided in accordance with Section 1009.8.2. 6. In interior exit stairways and ramps, floor level signage shall be provided in accordance with Section 1023.9. 7. Signs identifying the type of access provided on amusement rides required to be accessible by Section 1111.4.8 shall be provided at entries to queues and waiting lines. In addition, where accessible unload areas also serve as accessible load areas, signs indicating the location of the accessible load and unload areas shall be provided at entries to queues and waiting lines. These directional sign characters shall meet the visual character requirements in accordance with ICC A117.1." .

ibc:ibc2021-n0305 a ibco:Exception ;
    ibco:bbox "[331.833, 651.716, 550.862, 684.694]" ;
    ibco:partOf ibc:ibc2021-1112.5.2 ;
    ibco:sourcePage 373 ;
    ibco:text "Exception: Where equivalent information is provided in an audible manner, variable message signs are not required to comply with ICC A117.1." .

ibc:ibc2021-1 a ibco:ListItem ;
    ibco:bbox "[324.831, 328.575, 550.773, 350.637]" ;
    ibco:hasChild ibc:ibc2021-2-0215 ;
    ibco:label "1" ;
    ibco:partOf ibc:ibc2021-1110.9 ;
    ibco:precedes ibc:ibc2021-2-0215 ;
    ibco:sourcePage 369 ;
    ibco:text "1. An accessible route to a performing area and speaker platforms." .

ibc:ibc2021-1-0286 a ibco:ListItem ;
    ibco:bbox "[339.239, 638.749, 565.181, 660.811]" ;
    ibco:hasChild ibc:ibc2021-n0287 ;
    ibco:label "1" ;
    ibco:partOf ibc:ibc2021-1112.1 ;
    ibco:precedes ibc:ibc2021-n0287 ;
    ibco:sourcePage 372 ;
    ibco:text "1. Accessible parking spaces required by Section 1106.2." .

ibc:ibc2021-1101 a ibco:Section ;
    ibco:bbox "[147.959, 308.625, 217.433, 330.776]" ;
    ibco:hasChild ibc:ibc2021-1101.1 ;
    ibco:heading "GENERAL" ;
    ibco:label "1101" ;
    ibco:partOf ibc:ibc2021-11 ;
    ibco:precedes ibc:ibc2021-1101.1 ;
    ibco:sourcePage 356 ;
    ibco:text "SECTION 1101 GENERAL" .

ibc:ibc2021-1102 a ibco:Section ;
    ibco:bbox "[147.959, 388.654, 217.433, 410.805]" ;
    ibco:hasChild ibc:ibc2021-1102.1 ;
    ibco:heading "COMPLIANCE" ;
    ibco:label "1102" ;
    ibco:partOf ibc:ibc2021-11 ;
    ibco:precedes ibc:ibc2021-1102.1 ;
    ibco:sourcePage 356 ;
    ibco:text "SECTION 1102 COMPLIANCE" .

ibc:ibc2021-1104.1 a ibco:Provision ;
    ibco:bbox "[46.787, 411.761, 289.822, 466.691]" ;
    ibco:hasChild ibc:ibc2021-n0027 ;
    ibco:heading "Site arrival points" ;
    ibco:label "1104.1" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-n0027 ;
    ibco:sourcePage 357 ;
    ibco:text "1104.1 Site arrival points. At least one accessible route within the site shall be provided from public transportation stops, accessible parking, accessible passenger loading zones, and public streets or sidewalks to the accessible building entrance served." .

ibc:ibc2021-1104.6 a ibco:Provision ;
    ibco:bbox "[61.153, 648.757, 304.298, 692.77]" ;
    ibco:hasChild ibc:ibc2021-n0035 ;
    ibco:heading "Security barriers" ;
    ibco:label "1104.6" ;
    ibco:partOf ibc:ibc2021-1104 ;
    ibco:precedes ibc:ibc2021-n0035 ;
    ibco:sourcePage 358 ;
    ibco:text "1104.6 Security barriers. Security barriers including, but not limited to, security bollards and security check points shall not obstruct a required accessible route or accessible means of egress." .

ibc:ibc2021-1105.1.1 a ibco:Provision ;
    ibco:bbox "[334.189, 285.807, 565.187, 401.987]" ;
    ibco:hasChild ibc:ibc2021-a ;
    ibco:heading "Automatic doors" ;
    ibco:label "1105.1.1" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-a ;
    ibco:sourcePage 358 ;
    ibco:text "1105.1.1 Automatic doors. In facilities with the occupancies and building occupant loads indicated in Table 1105.1.1, public entrances that are required to be accessible shall have one door be either a full power-operated door or a low-energy power-operated door. Where the public entrance includes a vestibule, at least one door into and one door out of the vestibule shall meet the requirements of this section. TABLE 1105.1.1 PUBLIC ENTRANCE WITH POWER-OPERATED DOORa" .

ibc:ibc2021-1105.1.7 a ibco:Provision ;
    ibco:bbox "[58.799, 69.725, 289.766, 91.786]" ;
    ibco:hasChild ibc:ibc2021-n0046 ;
    ibco:heading "Tenant spaces" ;
    ibco:label "1105.1.7" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-n0046 ;
    ibco:sourcePage 359 ;
    ibco:text "1105.1.7 Tenant spaces. At least one accessible entrance shall be provided to each tenant in a facility." .

ibc:ibc2021-1105.1.8 a ibco:Provision ;
    ibco:bbox "[58.799, 132.712, 289.936, 165.809]" ;
    ibco:hasChild ibc:ibc2021-n0048 ;
    ibco:heading "Dwelling units and sleeping units" ;
    ibco:label "1105.1.8" ;
    ibco:partOf ibc:ibc2021-1105 ;
    ibco:precedes ibc:ibc2021-n0048 ;
    ibco:sourcePage 359 ;
    ibco:text "1105.1.8 Dwelling units and sleeping units. At least one accessible entrance shall be provided to each dwelling unit and sleeping unit in a facility." .

ibc:ibc2021-1106.2 a ibco:Provision ;
    ibco:bbox "[46.797, 286.763, 289.893, 352.728]" ;
    ibco:hasChild ibc:ibc2021-n0052 ;
    ibco:heading "Required" ;
    ibco:label "1106.2" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-n0052 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.2 Required. Where parking is provided, accessible parking spaces shall be provided in compliance with Table 1106.2, except as required by Sections 1106.3 through 1106.5. Where more than one parking facility is provided on a site, the number of parking spaces required to be accessible shall be calculated separately for each parking facility." .

ibc:ibc2021-1106.6 a ibco:Provision ;
    ibco:bbox "[307.801, 332.684, 550.839, 365.781]" ;
    ibco:hasChild ibc:ibc2021-n0057 ;
    ibco:heading "Van spaces" ;
    ibco:label "1106.6" ;
    ibco:partOf ibc:ibc2021-1106 ;
    ibco:precedes ibc:ibc2021-n0057 ;
    ibco:sourcePage 359 ;
    ibco:text "1106.6 Van spaces. For every six or fraction of six accessible parking spaces, at least one shall be a van-accessible parking space." .

ibc:ibc2021-1107.2 a ibco:Provision ;
    ibco:bbox "[61.197, 308.715, 304.213, 341.812]" ;
    ibco:hasChild ibc:ibc2021-n0068 ;
    ibco:heading "Electrical vehicle charging stations" ;
    ibco:label "1107.2" ;
    ibco:partOf ibc:ibc2021-1107 ;
    ibco:precedes ibc:ibc2021-n0068 ;
    ibco:sourcePage 360 ;
    ibco:text "1107.2 Electrical vehicle charging stations. Electrical vehicle charging stations shall comply with Sections 1107.2.1 and 1107.2.2." .

ibc:ibc2021-1108.5.1.2 a ibco:Provision ;
    ibco:bbox "[70.799, 451.711, 289.84, 462.736]" ;
    ibco:hasChild ibc:ibc2021-2 ;
    ibco:label "1108.5.1.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-2 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.1.2 Accessible units in Group I-1, Condition" .

ibc:ibc2021-1108.5.1.3 a ibco:Provision ;
    ibco:bbox "[70.805, 653.62, 289.813, 708.818]" ;
    ibco:hasChild ibc:ibc2021-n0083 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.5.1.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0083 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.1.3 Type B units. In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.5.2.2 a ibco:Provision ;
    ibco:bbox "[331.807, 286.733, 550.834, 341.782]" ;
    ibco:hasChild ibc:ibc2021-n0087 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.5.2.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0087 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.2.2 Type B units. In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.5.3.1 a ibco:Provision ;
    ibco:bbox "[331.797, 430.695, 550.816, 463.672]" ;
    ibco:hasChild ibc:ibc2021-n0090 ;
    ibco:heading "Accessible units" ;
    ibco:label "1108.5.3.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0090 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.3.1 Accessible units. At least 10 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units." .

ibc:ibc2021-1108.5.3.2 a ibco:Provision ;
    ibco:bbox "[331.787, 515.634, 550.834, 570.818]" ;
    ibco:hasChild ibc:ibc2021-n0092 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.5.3.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0092 ;
    ibco:sourcePage 361 ;
    ibco:text "1108.5.3.2 Type B units. In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.5.5.2 a ibco:Provision ;
    ibco:bbox "[85.187, 202.771, 304.219, 312.759]" ;
    ibco:hasChild ibc:ibc2021-n0097 ;
    ibco:label "1108.5.5.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0097 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.5.5.2 Special holding cells and special housing cells or rooms. In addition to the Accessible units required by Section 1108.5.5.1, where special holding cells or special housing cells or rooms are provided, at least one serving each purpose shall be an Accessible unit. Cells or rooms subject to this requirement include, but are not limited to, those used for purposes of orientation, protective custody, administrative or disciplinary detention or segregation, detoxification and medical isolation." .

ibc:ibc2021-1108.6.1.2 a ibco:Provision ;
    ibco:bbox "[346.199, 172.8, 565.226, 227.73]" ;
    ibco:hasChild ibc:ibc2021-n0103 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.6.1.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0103 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.1.2 Type B units. In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.6.2.1 a ibco:Provision ;
    ibco:bbox "[346.169, 305.726, 565.36, 371.811]" ;
    ibco:hasChild ibc:ibc2021-n0106 ;
    ibco:heading "Live/work units" ;
    ibco:label "1108.6.2.1" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0106 ;
    ibco:sourcePage 362 ;
    ibco:text "1108.6.2.1 Live/work units. In live/work units constructed in accordance with Section 419, the nonresidential portion is required to be accessible. In a structure where there are four or more live/work units intended to be occupied as a residence, the residential portion of the live/work unit shall be a Type B unit." .

ibc:ibc2021-1108.6.2.2.2 a ibco:Provision ;
    ibco:bbox "[82.819, 250.758, 289.87, 305.807]" ;
    ibco:hasChild ibc:ibc2021-n0110 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.6.2.2.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0110 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.2.2.2 Type B units. Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.6.2.3.2 a ibco:Provision ;
    ibco:bbox "[82.8, 552.705, 289.946, 607.774]" ;
    ibco:hasChild ibc:ibc2021-n0114 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.6.2.3.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0114 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.2.3.2 Type B units. Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and every sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1108.6.3 a ibco:Provision ;
    ibco:bbox "[319.799, 69.675, 550.727, 91.737]",
        "[58.787, 648.819, 289.958, 725.82]" ;
    ibco:hasChild ibc:ibc2021-n0116 ;
    ibco:heading "Group R-3" ;
    ibco:label "1108.6.3" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0116 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.3 Group R-3. In Group R-3 occupancies where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit. Bedrooms within congregate living facilities, dormitories, sororities, fraternities, and boarding houses shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:ibc2021-1108.6.4.2 a ibco:Provision ;
    ibco:bbox "[331.79, 239.672, 550.818, 283.686]" ;
    ibco:hasChild ibc:ibc2021-n0120 ;
    ibco:heading "Type B units" ;
    ibco:label "1108.6.4.2" ;
    ibco:partOf ibc:ibc2021-1108 ;
    ibco:precedes ibc:ibc2021-n0120 ;
    ibco:sourcePage 363 ;
    ibco:text "1108.6.4.2 Type B units. In structures with four or more sleeping units intended to be occupied as a residence, every sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:ibc2021-1109.2.5 a ibco:Provision ;
    ibco:bbox "[58.809, 366.772, 289.957, 410.785]" ;
    ibco:hasChild ibc:ibc2021-n0140 ;
    ibco:heading "Designated aisle seats" ;
    ibco:label "1109.2.5" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-n0140 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.5 Designated aisle seats. At least 5 percent, but not less than one, of the total number of aisle seats provided shall be designated aisle seats and shall be the aisle seats located closest to accessible routes." .

ibc:ibc2021-1109.2.7 a ibco:Provision ;
    ibco:bbox "[58.809, 477.746, 289.834, 521.759]" ;
    ibco:hasChild ibc:ibc2021-n0143 ;
    ibco:heading "Assistive listening systems" ;
    ibco:label "1109.2.7" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-n0143 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.7 Assistive listening systems. Each building, room or space used for assembly purposes where audible communications are integral to the use of the space shall have an assistive listening system." .

ibc:ibc2021-1109.2.9 a ibco:Provision ;
    ibco:bbox "[201.833, 609.509, 396.495, 618.348]",
        "[319.793, 492.823, 550.945, 577.752]" ;
    ibco:hasChild ibc:ibc2021-n0149 ;
    ibco:heading "Dining and drinking areas" ;
    ibco:label "1109.2.9" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-n0149 ;
    ibco:sourcePage 365 ;
    ibco:text "1109.2.9 Dining and drinking areas. In dining and drinking areas, all interior and exterior floor areas shall be accessible and be on an accessible route. Exceptions: 1. An accessible route between accessible levels and stories above or below is not required where permitted by Section 1104.4, Exception 1. RECEIVERS FOR ASSISTIVE LISTENING SYSTEMS" .

ibc:ibc2021-1109.4.1.1 a ibco:Provision ;
    ibco:bbox "[85.201, 585.802, 304.18, 607.744]" ;
    ibco:hasChild ibc:ibc2021-n0156 ;
    ibco:heading "Jury box" ;
    ibco:label "1109.4.1.1" ;
    ibco:partOf ibc:ibc2021-1109 ;
    ibco:precedes ibc:ibc2021-n0156 ;
    ibco:sourcePage 366 ;
    ibco:text "1109.4.1.1 Jury box. A wheelchair space shall be provided within the jury box." .

ibc:ibc2021-1110.1 a ibco:Provision ;
    ibco:bbox "[322.149, 488.583, 565.187, 521.68]" ;
    ibco:hasChild ibc:ibc2021-n0166 ;
    ibco:heading "General" ;
    ibco:label "1110.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0166 ;
    ibco:sourcePage 366 ;
    ibco:text "1110.1 General. Accessible building features and facilities shall be provided in accordance with Sections 1110.2 through 1110.16." .

ibc:ibc2021-1110.11 a ibco:Provision ;
    ibco:bbox "[61.197, 154.783, 304.321, 187.761]" ;
    ibco:hasChild ibc:ibc2021-n0228 ;
    ibco:heading "Detectable warnings" ;
    ibco:label "1110.11" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0228 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.11 Detectable warnings. Passenger transit platform edges bordering a drop-off and not protected by platform screens or guards shall have a detectable warning." .

ibc:ibc2021-1110.12 a ibco:Provision ;
    ibco:bbox "[61.187, 217.77, 304.286, 272.819]" ;
    ibco:hasChild ibc:ibc2021-n0230 ;
    ibco:heading "Seating at tables, counters and work surfaces" ;
    ibco:label "1110.12" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0230 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.12 Seating at tables, counters and work surfaces. Where seating or standing space at fixed or built-in tables, counters or work surfaces is provided in accessible spaces, at least 5 percent of the seating and standing spaces, but not less than one, shall be accessible." .

ibc:ibc2021-1110.12.2.1 a ibco:Provision ;
    ibco:bbox "[85.191, 398.684, 304.248, 453.733]" ;
    ibco:hasChild ibc:ibc2021-n0234 ;
    ibco:heading "Cubicles and counters" ;
    ibco:label "1110.12.2.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0234 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.12.2.1 Cubicles and counters. At least 5 percent, but not less than one of the cubicles, shall be accessible on both the visitor and detainee sides. Where counters are provided, at least one shall be accessible on both the visitor and detainee sides." .

ibc:ibc2021-1110.13.1 a ibco:Provision ;
    ibco:bbox "[73.179, 579.717, 304.244, 689.705]" ;
    ibco:hasChild ibc:ibc2021-n0238 ;
    ibco:heading "Check-out aisles" ;
    ibco:label "1110.13.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0238 ;
    ibco:sourcePage 370 ;
    ibco:text "1110.13.1 Check-out aisles. Where check-out aisles are provided, accessible check-out aisles shall be provided in accordance with Table 1110.13.1. Where check-out aisles serve different functions, accessible check-out aisles shall be provided in accordance with Table 1110.13.1 for each function. Where check-out aisles are dispersed throughout the building or facility, accessible check-out aisles shall also be dispersed. Traffic control devices, security devices and turnstiles located in accessible check-out aisles or lanes shall be accessible." .

ibc:ibc2021-1110.2.1 a ibco:Provision ;
    ibco:bbox "[58.767, 457.727, 289.833, 611.738]" ;
    ibco:hasChild ibc:ibc2021-n0169 ;
    ibco:label "1110.2.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0169 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1 Family or assisted-use toilet and bathing rooms. In assembly and mercantile occupancies, an accessible family or assisted-use toilet room shall be provided where an aggregate of six or more male and female water closets is required. In buildings of mixed occupancy, only those water closets required for the assembly or mercantile occupancy shall be used to determine the family or assisted-use toilet room requirement. In recreational facilities where separate-sex bathing rooms are provided, an accessible family or assisted-use bathing room shall be provided. Fixtures located within family or assisted-use toilet and bathing rooms shall be included in determining the number of fixtures provided in an occupancy." .

ibc:ibc2021-1110.2.1.2 a ibco:Provision ;
    ibco:bbox "[331.771, 69.565, 550.724, 102.662]",
        "[70.769, 689.615, 289.833, 722.712]" ;
    ibco:hasChild ibc:ibc2021-n0172 ;
    ibco:heading "Family or assisted-use toilet rooms" ;
    ibco:label "1110.2.1.2" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0172 ;
    ibco:sourcePage 367 ;
    ibco:text "1110.2.1.2 Family or assisted-use toilet rooms. Family or assisted-use toilet rooms shall include only one water closet and only one lavatory. A family or assisted-use bathing room in accordance with Section 1110.2.1.3 shall be considered to be a family or assisted-use toilet room." .

ibc:ibc2021-1110.2.3.3.1 a ibco:Provision ;
    ibco:bbox "[358.213, 95.591, 565.229, 139.604]" ;
    ibco:hasChild ibc:ibc2021-n0192 ;
    ibco:heading "Back-wall grab bar" ;
    ibco:label "1110.2.3.3.1" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0192 ;
    ibco:sourcePage 368 ;
    ibco:text "1110.2.3.3.1 Back-wall grab bar. The back-wall grab bar shall extend the length of the back wall and extend within 6 inches (150 mm) maximum from the two adjacent sidewalls." .

ibc:ibc2021-1110.3 a ibco:Provision ;
    ibco:bbox "[46.797, 128.748, 289.818, 161.725]" ;
    ibco:hasChild ibc:ibc2021-n0203 ;
    ibco:heading "Sinks" ;
    ibco:label "1110.3" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0203 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.3 Sinks. Where sinks are provided, at least 5 percent but not less than one provided in accessible spaces shall be accessible." .

ibc:ibc2021-1110.6 a ibco:Provision ;
    ibco:bbox "[307.779, 95.591, 550.867, 117.652]" ;
    ibco:hasChild ibc:ibc2021-n0209 ;
    ibco:heading "Bottle-filling stations" ;
    ibco:label "1110.6" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0209 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.6 Bottle-filling stations. Where bottle-filling stations are provided, they shall be accessible." .

ibc:ibc2021-1110.7 a ibco:Provision ;
    ibco:bbox "[307.779, 169.614, 550.849, 191.556]" ;
    ibco:hasChild ibc:ibc2021-n0211 ;
    ibco:heading "Saunas and steam rooms" ;
    ibco:label "1110.7" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-n0211 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.7 Saunas and steam rooms. Where provided, saunas and steam rooms shall be accessible." .

ibc:ibc2021-1110.9 a ibco:Provision ;
    ibco:bbox "[307.789, 269.552, 550.892, 324.601]" ;
    ibco:hasChild ibc:ibc2021-1 ;
    ibco:heading "Lifts" ;
    ibco:label "1110.9" ;
    ibco:partOf ibc:ibc2021-1110 ;
    ibco:precedes ibc:ibc2021-1 ;
    ibco:sourcePage 369 ;
    ibco:text "1110.9 Lifts. Platform (wheelchair) lifts are permitted to be a part of a required accessible route in new construction where indicated in Items 1 through 10. Platform (wheelchair) lifts shall be installed in accordance with ASME A18.1." .

ibc:ibc2021-1111.4.12.2 a ibco:Provision ;
    ibco:bbox "[85.189, 550.745, 304.221, 616.71]" ;
    ibco:hasChild ibc:ibc2021-n0276 ;
    ibco:heading "Miniature golf course configuration" ;
    ibco:label "1111.4.12.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-n0276 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.12.2 Miniature golf course configuration. Miniature golf courses shall be configured so that the accessible holes are consecutive. Miniature golf courses shall provide an accessible route from the last accessible hole to the course entrance or exit without requiring travel through any other holes on the course." .

ibc:ibc2021-1111.4.15 a ibco:Provision ;
    ibco:bbox "[334.203, 429.836, 565.336, 484.765]" ;
    ibco:hasChild ibc:ibc2021-n0283 ;
    ibco:heading "Shooting facilities with firing positions" ;
    ibco:label "1111.4.15" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-n0283 ;
    ibco:sourcePage 372 ;
    ibco:text "1111.4.15 Shooting facilities with firing positions. Where shooting facilities with firing positions are designed and constructed at a site, at least 5 percent, but not less than one, of each type of firing position shall be accessible and be on an accessible route." .

ibc:ibc2021-1111.4.2 a ibco:Provision ;
    ibco:bbox "[58.781, 482.647, 289.753, 515.744]" ;
    ibco:hasChild ibc:ibc2021-n0255 ;
    ibco:heading "Team or player seating" ;
    ibco:label "1111.4.2" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-n0255 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.2 Team or player seating. At least one wheelchair space shall be provided in team or player seating areas serving areas of sport activity." .

ibc:ibc2021-1111.4.8 a ibco:Provision ;
    ibco:bbox "[319.801, 106.788, 550.953, 139.765]" ;
    ibco:hasChild ibc:ibc2021-n0262 ;
    ibco:heading "Amusement rides" ;
    ibco:label "1111.4.8" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-n0262 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.8 Amusement rides. Amusement rides that move persons through a fixed course within a defined area shall comply with Sections 1111.4.8.1 through 1111.4.8.3." .

ibc:ibc2021-1111.4.9.1 a ibco:Provision ;
    ibco:bbox "[331.813, 572.657, 550.833, 660.693]" ;
    ibco:hasChild ibc:ibc2021-n0268 ;
    ibco:heading "Boat slips" ;
    ibco:label "1111.4.9.1" ;
    ibco:partOf ibc:ibc2021-1111 ;
    ibco:precedes ibc:ibc2021-n0268 ;
    ibco:sourcePage 371 ;
    ibco:text "1111.4.9.1 Boat slips. Accessible boat slips shall be provided in accordance with Table 1111.4.9.1. All units on the site shall be combined to determine the number of accessible boat slips required. Where the number of boat slips is not identified, each 40 feet (12 m) of boat slip edge provided along the perimeter of the pier shall be counted as one boat slip for the purpose of this section." .

ibc:ibc2021-1112.1 a ibco:Provision ;
    ibco:bbox "[322.197, 601.797, 565.234, 634.775]" ;
    ibco:hasChild ibc:ibc2021-1-0286 ;
    ibco:heading "Signs" ;
    ibco:label "1112.1" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-1-0286 ;
    ibco:sourcePage 372 ;
    ibco:text "1112.1 Signs. Required accessible elements shall be identified by the International Symbol of Accessibility at the following locations." .

ibc:ibc2021-1112.4 a ibco:Provision ;
    ibco:bbox "[307.769, 69.625, 550.877, 161.734]" ;
    ibco:hasChild ibc:ibc2021-n0301 ;
    ibco:heading "Other signs" ;
    ibco:label "1112.4" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-n0301 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.4 Other signs. Signage indicating special accessibility provisions shall be provided as shown. 1. Each assembly area required to comply with Section 1109.2.7 shall provide a sign notifying patrons of the availability of assistive listening systems. The sign shall comply with ICC A117.1 requirements for visual characters and include the International Symbol of Access for Hearing Loss." .

ibc:ibc2021-1112.5.2 a ibco:Provision ;
    ibco:bbox "[319.831, 603.729, 550.845, 647.742]" ;
    ibco:hasChild ibc:ibc2021-n0305 ;
    ibco:heading "Emergency shelters" ;
    ibco:label "1112.5.2" ;
    ibco:partOf ibc:ibc2021-1112 ;
    ibco:precedes ibc:ibc2021-n0305 ;
    ibco:sourcePage 373 ;
    ibco:text "1112.5.2 Emergency shelters. Where provided in buildings that are designated as emergency shelters, variable message signs conveying emergency-related information shall comply with Section 1112.5." .

ibc:ibc2021-2-0215 a ibco:ListItem ;
    ibco:bbox "[324.831, 353.535, 550.789, 386.862]" ;
    ibco:hasChild ibc:ibc2021-3 ;
    ibco:label "2" ;
    ibco:partOf ibc:ibc2021-1 ;
    ibco:precedes ibc:ibc2021-3 ;
    ibco:sourcePage 369 ;
    ibco:text "2. An accessible route to wheelchair spaces required to comply with the wheelchair space dispersion requirements of Sections 1109.2.2 through 1109.2.6." .

ibc:ibc2021-2-0288 a ibco:ListItem ;
    ibco:bbox "[63.839, 69.725, 289.752, 91.786]" ;
    ibco:hasChild ibc:ibc2021-n0289 ;
    ibco:label "2" ;
    ibco:partOf ibc:ibc2021-n0287 ;
    ibco:precedes ibc:ibc2021-n0289 ;
    ibco:sourcePage 373 ;
    ibco:text "2. Accessible parking spaces required by Section 1106.3." .

ibc:ibc2021-3 a ibco:ListItem ;
    ibco:bbox "[324.84, 389.76, 550.804, 422.857]" ;
    ibco:hasChild ibc:ibc2021-4 ;
    ibco:label "3" ;
    ibco:partOf ibc:ibc2021-2-0215 ;
    ibco:precedes ibc:ibc2021-4 ;
    ibco:sourcePage 369 ;
    ibco:text "3. An accessible route to spaces that are not open to the general public with an occupant load of not more than five." .

ibc:ibc2021-3-0290 a ibco:ListItem ;
    ibco:bbox "[63.819, 143.748, 221.101, 154.773]" ;
    ibco:hasChild ibc:ibc2021-4-0291 ;
    ibco:label "3" ;
    ibco:partOf ibc:ibc2021-n0289 ;
    ibco:precedes ibc:ibc2021-4-0291 ;
    ibco:sourcePage 373 ;
    ibco:text "3. Accessible passenger loading zones." .

ibc:ibc2021-4 a ibco:ListItem ;
    ibco:bbox "[324.84, 425.756, 550.897, 458.853]" ;
    ibco:hasChild ibc:ibc2021-5 ;
    ibco:label "4" ;
    ibco:partOf ibc:ibc2021-3 ;
    ibco:precedes ibc:ibc2021-5 ;
    ibco:sourcePage 369 ;
    ibco:text "4. An accessible route within an individual dwelling unit or sleeping unit required to be an Accessible unit, Type A unit or Type B unit." .

ibc:ibc2021-4-0291 a ibco:ListItem ;
    ibco:bbox "[63.819, 157.791, 289.795, 179.733]" ;
    ibco:hasChild ibc:ibc2021-5-0292 ;
    ibco:label "4" ;
    ibco:partOf ibc:ibc2021-3-0290 ;
    ibco:precedes ibc:ibc2021-5-0292 ;
    ibco:sourcePage 373 ;
    ibco:text "4. Accessible toilet or bathing rooms where not all toilet or bathing rooms are accessible." .

ibc:ibc2021-5 a ibco:ListItem ;
    ibco:bbox "[324.82, 461.751, 550.823, 516.8]" ;
    ibco:hasChild ibc:ibc2021-6 ;
    ibco:label "5" ;
    ibco:partOf ibc:ibc2021-4 ;
    ibco:precedes ibc:ibc2021-6 ;
    ibco:sourcePage 369 ;
    ibco:text "5. An accessible route to jury boxes and witness stands; raised courtroom stations including judges’ benches, clerks’ stations, bailiffs’ stations, deputy clerks’ stations and court reporters’ stations; and to depressed areas such as the well of the court." .

ibc:ibc2021-5-0292 a ibco:ListItem ;
    ibco:bbox "[63.819, 182.751, 289.728, 204.812]" ;
    ibco:hasChild ibc:ibc2021-6-0293 ;
    ibco:label "5" ;
    ibco:partOf ibc:ibc2021-4-0291 ;
    ibco:precedes ibc:ibc2021-6-0293 ;
    ibco:sourcePage 373 ;
    ibco:text "5. Accessible entrances where not all entrances are accessible." .

ibc:ibc2021-6 a ibco:ListItem ;
    ibco:bbox "[324.82, 519.818, 550.715, 541.76]" ;
    ibco:hasChild ibc:ibc2021-7 ;
    ibco:label "6" ;
    ibco:partOf ibc:ibc2021-5 ;
    ibco:precedes ibc:ibc2021-7 ;
    ibco:sourcePage 369 ;
    ibco:text "6. An accessible route to load and unload areas serving amusement rides." .

ibc:ibc2021-6-0293 a ibco:ListItem ;
    ibco:bbox "[25.199, 207.711, 289.735, 258.051]" ;
    ibco:hasChild ibc:ibc2021-7-0294 ;
    ibco:label "6" ;
    ibco:partOf ibc:ibc2021-5-0292 ;
    ibco:precedes ibc:ibc2021-7-0294 ;
    ibco:sourcePage 373 ;
    ibco:text "6. Accessible check-out aisles where not all aisles are accessible. The sign, where provided, shall be above the check-out aisle in the same location as the checkout aisle number or type of check-out identification. " .

ibc:ibc2021-7 a ibco:ListItem ;
    ibco:bbox "[324.82, 544.778, 550.789, 566.839]" ;
    ibco:hasChild ibc:ibc2021-8 ;
    ibco:label "7" ;
    ibco:partOf ibc:ibc2021-6 ;
    ibco:precedes ibc:ibc2021-8 ;
    ibco:sourcePage 369 ;
    ibco:text "7. An accessible route to play components or soft contained play structures." .

ibc:ibc2021-7-0294 a ibco:ListItem ;
    ibco:bbox "[63.809, 254.742, 289.721, 276.803]" ;
    ibco:hasChild ibc:ibc2021-8-0295 ;
    ibco:label "7" ;
    ibco:partOf ibc:ibc2021-6-0293 ;
    ibco:precedes ibc:ibc2021-8-0295 ;
    ibco:sourcePage 373 ;
    ibco:text "7. Accessible dressing, fitting and locker rooms where not all such rooms are accessible." .

ibc:ibc2021-8 a ibco:ListItem ;
    ibco:bbox "[324.82, 569.737, 550.851, 591.799]" ;
    ibco:hasChild ibc:ibc2021-9 ;
    ibco:label "8" ;
    ibco:partOf ibc:ibc2021-7 ;
    ibco:precedes ibc:ibc2021-9 ;
    ibco:sourcePage 369 ;
    ibco:text "8. An accessible route to team or player seating areas serving areas of sport activity." .

ibc:ibc2021-8-0295 a ibco:ListItem ;
    ibco:bbox "[63.809, 279.821, 289.684, 301.763]" ;
    ibco:hasChild ibc:ibc2021-9-0296 ;
    ibco:label "8" ;
    ibco:partOf ibc:ibc2021-7-0294 ;
    ibco:precedes ibc:ibc2021-9-0296 ;
    ibco:sourcePage 373 ;
    ibco:text "8. Accessible areas of refuge in accordance with Section 1009.9." .

ibc:ibc2021-9 a ibco:ListItem ;
    ibco:bbox "[324.83, 594.817, 550.869, 627.794]" ;
    ibco:hasChild ibc:ibc2021-10 ;
    ibco:label "9" ;
    ibco:partOf ibc:ibc2021-8 ;
    ibco:precedes ibc:ibc2021-10 ;
    ibco:sourcePage 369 ;
    ibco:text "9. An accessible route instead of gangways serving recreational boating facilities and fishing piers and platforms." .

ibc:ibc2021-9-0296 a ibco:ListItem ;
    ibco:bbox "[63.809, 304.781, 289.708, 326.842]" ;
    ibco:hasChild ibc:ibc2021-10-0297 ;
    ibco:label "9" ;
    ibco:partOf ibc:ibc2021-8-0295 ;
    ibco:precedes ibc:ibc2021-10-0297 ;
    ibco:sourcePage 373 ;
    ibco:text "9. Exterior areas for assisted rescue in accordance with Section 1009.9." .

ibc:ibc2021-n0287 a ibco:Exception ;
    ibco:bbox "[358.193, 664.785, 565.203, 697.762]" ;
    ibco:hasChild ibc:ibc2021-2-0288 ;
    ibco:partOf ibc:ibc2021-1-0286 ;
    ibco:precedes ibc:ibc2021-2-0288 ;
    ibco:sourcePage 372 ;
    ibco:text "Exception: Where the total number of parking spaces provided is four or less, identification of accessible parking spaces is not required." .

ibc:ibc2021-n0289 a ibco:Exception ;
    ibco:bbox "[82.783, 95.76, 289.807, 139.773]" ;
    ibco:hasChild ibc:ibc2021-3-0290 ;
    ibco:partOf ibc:ibc2021-2-0288 ;
    ibco:precedes ibc:ibc2021-3-0290 ;
    ibco:sourcePage 373 ;
    ibco:text "Exception: In Group I-1, R-2, R-3 and R-4 facilities, where parking spaces are assigned to specific dwelling units or sleeping units, identification of accessible parking spaces is not required." .

