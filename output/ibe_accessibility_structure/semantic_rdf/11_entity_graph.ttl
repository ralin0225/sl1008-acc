ibc:sem-ibc2021-1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1 ;
    ibco:confidence 0.81 ;
    ibco:modality "unspecified" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1 ;
    ibco:statementType "declarative" ;
    ibco:text "1. An accessible route to a performing area and speaker platforms." .

ibc:sem-ibc2021-1-0286 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1-0286 ;
    ibco:confidence 0.81 ;
    ibco:hasException ibc:ibc2021-n0287 ;
    ibco:modality "unspecified" ;
    ibco:references ibc:ibc2021-1106-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1-0286 ;
    ibco:statementType "declarative" ;
    ibco:text "1. Accessible parking spaces required by Section 1106.2." .

ibc:sem-ibc2021-10 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-10 ;
    ibco:confidence 0.81 ;
    ibco:hasCondition ibc:sem-ibc2021-10-condition-1 ;
    ibco:modality "unspecified" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-10 ;
    ibco:statementType "declarative" ;
    ibco:text "10. An accessible route where existing exterior site constraints make use of a ramp or elevator infeasible." .

ibc:sem-ibc2021-10-0297 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-10-0297 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-10-0297-atomic-1 ;
    ibco:modality "required" ;
    ibco:references ibc:ibc2021-1110-10 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-10-0297 ;
    ibco:statementType "obligation" ;
    ibco:text "10. In recreational facilities, lockers that are required to be accessible in accordance with Section 1110.10." .

ibc:sem-ibc2021-1101.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1101.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1101.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1101.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1101.1 Scope. The provisions of this chapter shall control the design and construction of facilities for accessibility for individuals with disabilities." .

ibc:sem-ibc2021-1102.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1102.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1102.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1102.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1102.1 Design. Buildings and facilities shall be designed and constructed to be accessible in accordance with this code and ICC A117.1." .

ibc:sem-ibc2021-1103.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1103.1 Where required. Sites, buildings, structures, facilities, elements and spaces, temporary or permanent, shall be accessible to individuals with disabilities." .

ibc:sem-ibc2021-1103.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1103.2 General exceptions. Sites, buildings, structures, facilities, elements and spaces shall be exempt from this chapter to the extent specified in this section." .

ibc:sem-ibc2021-1103.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.1-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:references ibc:ibc2021-1104,
        ibc:ibc2021-1112 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.1 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.1 Specific requirements. Accessibility is not required in buildings and facilities, or portions thereof, to the extent permitted by Sections 1104 through 1112." .

ibc:sem-ibc2021-1103.2.10 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.10 ;
    ibco:appliesTo ibc:concept-highway-tollbooths-where-the-access-is-provided-only-by-bridges-above-the-vehicular-traffic-or-underground-tunnels ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.10-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1103.2.10-condition-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.10 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.10 Highway tollbooths. Highway tollbooths where the access is provided only by bridges above the vehicular traffic or underground tunnels are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.11 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.11 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.11-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.11 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.11 Residential Group R-1. Buildings of Group R-1 containing not more than five sleeping units for rent or hire that are also occupied as the residence of the proprietor are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.12 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.12 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-dwellingunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.12-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1103.2.12-condition-1 ;
    ibco:modality "required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.12 ;
    ibco:statementType "obligation" ;
    ibco:text "1103.2.12 Day care facilities. Where a day care facility is part of a dwelling unit, only the portion of the structure utilized for the day care facility is required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.13 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.13 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.13-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.13 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.13 Detention and correctional facilities. In detention and correctional facilities, common use areas that are used only by inmates or detainees and security personnel, and that do not serve holding cells or housing cells required to be Accessible units, are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.14 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.14 ;
    ibco:appliesTo ibc:concept-walk-in-cooler-and-freezer-equipment-accessed-only-from-employee-work-areas ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.14-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.14 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.14 Walk-in coolers and freezers. Walk-in cooler and freezer equipment accessed only from employee work areas is not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.2 ;
    ibco:appliesTo ibc:concept-spaces-and-elements-within-employee-work-areas ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.2-atomic-1,
        ibc:sem-ibc2021-1103.2.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1103.2.2-condition-1,
        ibc:sem-ibc2021-1103.2.2-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1103.2.2-measurement-1,
        ibc:sem-ibc2021-1103.2.2-measurement-2 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1009,
        ibc:ibc2021-1104-3-1,
        ibc:ibc2021-1109-4-1-4 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1103.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1103.2.2 Employee work areas. Spaces and elements within employee work areas shall only be required to comply with Sections 907.5.2.3.1, 1009 and 1104.3.1 and shall be designed and constructed so that individuals with disabilities can approach, enter and exit the work area. Work areas, or portions of work areas, other than raised courtroom stations in accordance with Section 1109.4.1.4, that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the ground or finished floor where the change in elevation is essential to the function of the space shall be exempt from all requirements." .

ibc:sem-ibc2021-1103.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.3 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.3-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.3 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.3 Detached dwellings. Detached one- and twofamily dwellings, their accessory structures and their associated sites and facilities are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.4-atomic-1,
        ibc:sem-ibc2021-1103.2.4-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1103.2.4-condition-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.4 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.4 Utility buildings. Group U occupancies are not required to comply with this chapter other than the following: 1. In agricultural buildings, access is required to paved work areas and areas open to the general public. 2. Private garages or carports that contain required accessible parking." .

ibc:sem-ibc2021-1103.2.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.5 ;
    ibco:appliesTo ibc:concept-structures-sites-and-equipment-directly-associated-with-the-actual-processes-of-construction-including-but-not-limited-to-scaffolding-bridging-materials-hoists-materials-storage-or-construction-trailers ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.5-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.5 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.5 Construction sites. Structures, sites and equipment directly associated with the actual processes of construction including, but not limited to, scaffolding, bridging, materials hoists, materials storage or construction trailers are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.6 ;
    ibco:appliesTo ibc:concept-raised-areas-used-primarily-for-purposes-of-security-life-safety-or-fire-safety-including-but-not-limited-to-observation-galleries-prison-guard-towers-fire-towers-or-lifeguard-stands ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.6-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.6 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.6 Raised areas. Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.7 ;
    ibco:appliesTo ibc:concept-spaces-accessed-only-by-ladders-catwalks-crawl-spaces-freight-elevators-or-very-narrow-passageways ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.7-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.7 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.7 Limited access spaces. Spaces accessed only by ladders, catwalks, crawl spaces, freight elevators or very narrow passageways are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.8 ;
    ibco:appliesTo ibc:concept-raised-or-lowered-areas-or-portions-of-areas-in-places-of-religious-worship-that-are-less-than-300-square-feet-30-m2-in-area-and-located-7-inches-178-mm-or-more-above-or-below-the-finished-floor-and-used-primarily-for-the-performance-of-religious-ceremonies ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.8-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1103.2.8-measurement-1,
        ibc:sem-ibc2021-1103.2.8-measurement-2 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1103.2.8 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.8 Areas in places of religious worship. Raised or lowered areas, or portions of areas, in places of religious worship that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the finished floor and used primarily for the performance of religious ceremonies are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1103.2.9 ;
    ibco:appliesTo ibc:concept-spaces-frequented-only-by-service-personnel-for-maintenance-repair-or-occasional-monitoring-of-equipment ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1103.2.9-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1103.2.9 ;
    ibco:statementType "exemption" ;
    ibco:text "1103.2.9 Equipment spaces. Spaces frequented only by service personnel for maintenance, repair or occasional monitoring of equipment are not required to comply with this chapter." .

ibc:sem-ibc2021-1104.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.1 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility,
        ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.1-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0027 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.1 Site arrival points. At least one accessible route within the site shall be provided from public transportation stops, accessible parking, accessible passenger loading zones, and public streets or sidewalks to the accessible building entrance served." .

ibc:sem-ibc2021-1104.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.2 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.2-atomic-1,
        ibc:sem-ibc2021-1104.2-atomic-2,
        ibc:sem-ibc2021-1104.2-atomic-3 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.2 Within a site. At least one accessible route shall connect accessible buildings, accessible facilities, accessible elements and accessible spaces that are on the same site. Exceptions: 1. An accessible route is not required between accessible buildings, accessible facilities, accessible elements and accessible spaces that have, as the only means of access between them, a vehicular way not providing for pedestrian access. 2. An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:sem-ibc2021-1104.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.3 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility,
        ibc:concept-wheelchairspace ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.3-atomic-1,
        ibc:sem-ibc2021-1104.3-atomic-2,
        ibc:sem-ibc2021-1104.3-atomic-3,
        ibc:sem-ibc2021-1104.3-atomic-4,
        ibc:sem-ibc2021-1104.3-atomic-5 ;
    ibco:hasCondition ibc:sem-ibc2021-1104.3-condition-1,
        ibc:sem-ibc2021-1104.3-condition-2 ;
    ibco:modality "required" ;
    ibco:references ibc:ibc2021-1104-4,
        ibc:ibc2021-1109-4-1-4,
        ibc:ibc2021-1111 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.3 Connected spaces. Where a building or portion of a building is required to be accessible, at least one accessible route shall be provided to each portion of the building, to accessible building entrances connecting accessible pedestrian walkways and to the public way. Exceptions: 1. Stories and mezzanines exempted by Section 1104.4. 2. In a building, room or space used for assembly purposes with fixed seating, an accessible route shall not be required to serve levels where wheelchair spaces are not provided. 3. Vertical access to elevated employee work stations within a courtroom complying with Section 1109.4.1.4. 4. An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:sem-ibc2021-1104.3.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.3.1 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.3.1-atomic-1,
        ibc:sem-ibc2021-1104.3.1-atomic-2,
        ibc:sem-ibc2021-1104.3.1-atomic-3,
        ibc:sem-ibc2021-1104.3.1-atomic-4 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1104.3.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.3.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.3.1 Employee work areas. Common use circulation paths within employee work areas shall be accessible routes. Exceptions: 1. Common use circulation paths, located within employee work areas that are less than 1,000 square feet (93 m2) in size and defined by permanently installed partitions, counters, casework or furnishings, shall not be required to be accessible routes. 2. Common use circulation paths, located within employee work areas, that are an integral component of equipment, shall not be required to be accessible routes. 3. Common use circulation paths, located within exterior employee work areas that are fully exposed to the weather, shall not be required to be accessible routes." .

ibc:sem-ibc2021-1104.3.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.3.2 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.3.2-atomic-1,
        ibc:sem-ibc2021-1104.3.2-atomic-2,
        ibc:sem-ibc2021-1104.3.2-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1104.3.2-condition-1,
        ibc:sem-ibc2021-1104.3.2-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1104.3.2-measurement-1,
        ibc:sem-ibc2021-1104.3.2-measurement-2,
        ibc:sem-ibc2021-1104.3.2-measurement-3 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.3.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.3.2 Press boxes. Press boxes in a building, room or space used for assembly purposes shall be on an accessible route. Exceptions: 1. An accessible route shall not be required to press boxes in bleachers that have a single point of entry from the bleachers, provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2). 2. An accessible route shall not be required to free-standing press boxes that are more than 12 feet (3660 mm) above grade provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:sem-ibc2021-1104.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.4 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.4-atomic-1,
        ibc:sem-ibc2021-1104.4-atomic-10,
        ibc:sem-ibc2021-1104.4-atomic-11,
        ibc:sem-ibc2021-1104.4-atomic-2,
        ibc:sem-ibc2021-1104.4-atomic-3,
        ibc:sem-ibc2021-1104.4-atomic-4,
        ibc:sem-ibc2021-1104.4-atomic-5,
        ibc:sem-ibc2021-1104.4-atomic-6,
        ibc:sem-ibc2021-1104.4-atomic-7,
        ibc:sem-ibc2021-1104.4-atomic-8,
        ibc:sem-ibc2021-1104.4-atomic-9 ;
    ibco:hasCondition ibc:sem-ibc2021-1104.4-condition-1,
        ibc:sem-ibc2021-1104.4-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1104.4-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108,
        ibc:ibc2021-1109 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.4 Multistory buildings and facilities. At least one accessible route shall connect each accessible story, mezzanine and occupied roofs in multilevel buildings and facilities. Exceptions: 1. An accessible route is not required to stories, mezzanines and occupied roofs that have an aggregate area of not more than 3,000 square feet (278.7 m2) and are located above and below accessible levels. This exception shall not apply to: 1.1. Multiple tenant facilities of Group M occupancies containing five or more tenant spaces used for the sales or rental of goods and where at least one such tenant space is located on a floor level above or below the accessible levels. 1.2. Stories or mezzanines containing offices of health care providers (Group B or I). 1.3. Passenger transportation facilities and airports (Group A-3 or B). 1.4. Government buildings. 1.5. Structures with four or more dwelling units. 2. Stories, mezzanines or occupied roofs that do not contain accessible elements or other spaces as determined by Section 1108 or 1109 are not required to be served by an accessible route from an accessible level. 3. In air traffic control towers, an accessible route is not required to serve the cab and the floor immediately below the cab. 4. Where a two-story building or facility has one story or mezzanine with an occupant load of five or fewer persons that does not contain public use space, that story or mezzanine shall not be required to be connected by an accessible route to the story above or below." .

ibc:sem-ibc2021-1104.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.5 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.5-atomic-1,
        ibc:sem-ibc2021-1104.5-atomic-2,
        ibc:sem-ibc2021-1104.5-atomic-3,
        ibc:sem-ibc2021-1104.5-atomic-4,
        ibc:sem-ibc2021-1104.5-atomic-5 ;
    ibco:hasCondition ibc:sem-ibc2021-1104.5-condition-1,
        ibc:sem-ibc2021-1104.5-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1104.5 Location. Accessible routes shall coincide with or be located in the same area as a general circulation path. Where the circulation path is interior, the accessible route shall be interior. Where only one accessible route is provided, the accessible route shall not pass through kitchens, storage rooms, restrooms, closets or similar spaces. Exceptions: 1. Accessible routes from parking garages contained within and serving Type B units are not required to be interior. 2. A single accessible route is permitted to pass through a kitchen or storage room in an Accessible unit, Type A unit or Type B unit." .

ibc:sem-ibc2021-1104.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1104.6 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1104.6-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0035 ;
    ibco:modality "shall_not" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1104.6 ;
    ibco:statementType "prohibition" ;
    ibco:text "1104.6 Security barriers. Security barriers including, but not limited to, security bollards and security check points shall not obstruct a required accessible route or accessible means of egress." .

ibc:sem-ibc2021-1105.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1 ;
    ibco:appliesTo ibc:concept-accessibleentrance ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1-atomic-1,
        ibc:sem-ibc2021-1105.1-atomic-2,
        ibc:sem-ibc2021-1105.1-atomic-3 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1105.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1105-1-2,
        ibc:ibc2021-1105-1-8 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1 Public entrances. In addition to accessible entrances required by Sections 1105.1.2 through 1105.1.8, at least 60 percent of all public entrances shall be accessible. Exceptions: 1. An accessible entrance is not required to areas not required to be accessible. 2. Loading and service entrances that are not the only entrance to a tenant space." .

ibc:sem-ibc2021-1105.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.1-atomic-1,
        ibc:sem-ibc2021-1105.1.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.1-condition-1 ;
    ibco:modality "required" ;
    ibco:references ibc:ibc2021-1105-1-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.1 Automatic doors. In facilities with the occupancies and building occupant loads indicated in Table 1105.1.1, public entrances that are required to be accessible shall have one door be either a full power-operated door or a low-energy power-operated door. Where the public entrance includes a vestibule, at least one door into and one door out of the vestibule shall meet the requirements of this section. TABLE 1105.1.1 PUBLIC ENTRANCE WITH POWER-OPERATED DOORa" .

ibc:sem-ibc2021-1105.1.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.2 Parking garage entrances. Where provided, direct access for pedestrians from parking structures to buildings or facility entrances shall be accessible." .

ibc:sem-ibc2021-1105.1.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.3 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.3-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.3-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.3 Entrances from tunnels or elevated walkways. Where direct access is provided for pedestrians from a pedestrian tunnel or elevated walkway to a building or facility, at least one entrance to the building or facility from each tunnel or walkway shall be accessible." .

ibc:sem-ibc2021-1105.1.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.4-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.4-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.4 Restricted entrances. Where restricted entrances are provided to a building or facility, at least one restricted entrance to the building or facility shall be accessible." .

ibc:sem-ibc2021-1105.1.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.5 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.5-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.5-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.5 Entrances for inmates or detainees. Where entrances used only by inmates or detainees and security personnel are provided at judicial facilities, detention facilities or correctional facilities, at least one such entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.6 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.6-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1105.1.6-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.6 Service entrances. If a service entrance is the only entrance to a building or a tenant space in a facility, that entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.7 ;
    ibco:appliesTo ibc:concept-accessibleentrance,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.7-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0046 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.7 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.7 Tenant spaces. At least one accessible entrance shall be provided to each tenant in a facility." .

ibc:sem-ibc2021-1105.1.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1105.1.8 ;
    ibco:appliesTo ibc:concept-accessibleentrance,
        ibc:concept-buildingorfacility,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1105.1.8-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0048 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1105.1.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1105.1.8 Dwelling units and sleeping units. At least one accessible entrance shall be provided to each dwelling unit and sleeping unit in a facility." .

ibc:sem-ibc2021-1106.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.1 ;
    ibco:appliesTo ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.1-atomic-1,
        ibc:sem-ibc2021-1106.1-atomic-2 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1106-2,
        ibc:ibc2021-1106-8,
        ibc:ibc2021-1106-9 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1106.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.1 General. Parking shall comply with Sections 1106.2 through 1106.8. Passenger loading zones shall comply with Section 1106.9." .

ibc:sem-ibc2021-1106.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-parkingspace ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.2-atomic-1,
        ibc:sem-ibc2021-1106.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.2-condition-1,
        ibc:sem-ibc2021-1106.2-condition-2 ;
    ibco:hasException ibc:ibc2021-n0052 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1106-2,
        ibc:ibc2021-1106-3,
        ibc:ibc2021-1106-5 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1106.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.2 Required. Where parking is provided, accessible parking spaces shall be provided in compliance with Table 1106.2, except as required by Sections 1106.3 through 1106.5. Where more than one parking facility is provided on a site, the number of parking spaces required to be accessible shall be calculated separately for each parking facility." .

ibc:sem-ibc2021-1106.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.3 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-parkingspace,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.3-atomic-1,
        ibc:sem-ibc2021-1106.3-atomic-2,
        ibc:sem-ibc2021-1106.3-atomic-3,
        ibc:sem-ibc2021-1106.3-atomic-4,
        ibc:sem-ibc2021-1106.3-atomic-5 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.3-condition-1,
        ibc:sem-ibc2021-1106.3-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1106.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1106-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1106.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.3 Groups I-1, R-1, R-2, R-3 and R-4. Accessible parking spaces shall be provided in Group I-1, R-1, R-2, R-3 and R-4 occupancies in accordance with Items 1 through 4 as applicable. 1. In Group R-2, R-3 and R-4 occupancies that are required to have Accessible, Type A or Type B dwelling units or sleeping units, at least 2 percent, but not less than one, of each type of parking space provided shall be accessible. 2. In Group I-1 and R-1 occupancies, accessible parking shall be provided in accordance with Table 1106.2. 3. Where at least one parking space is provided for each dwelling unit or sleeping unit, at least one accessible parking space shall be provided for each Accessible and Type A unit. 4. Where parking is provided within or beneath a building, accessible parking spaces shall be provided within or beneath the building." .

ibc:sem-ibc2021-1106.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-parkingspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.4-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1106.4-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1106.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.4 Hospital outpatient facilities. At least 10 percent, but not less than one, of care recipient and visitor parking spaces provided to serve hospital outpatient facilities shall be accessible." .

ibc:sem-ibc2021-1106.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.5 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-parkingspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.5-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1106.5-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1106.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.5 Rehabilitation facilities and outpatient physical therapy facilities. At least 20 percent, but not less than one, of the portion of care recipient and visitor parking spaces serving rehabilitation facilities specializing in treating conditions that affect mobility and outpatient physical therapy facilities shall be accessible." .

ibc:sem-ibc2021-1106.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.6 ;
    ibco:appliesTo ibc:concept-parkingspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.6-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0057 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1106.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.6 Van spaces. For every six or fraction of six accessible parking spaces, at least one shall be a van-accessible parking space." .

ibc:sem-ibc2021-1106.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.7 ;
    ibco:appliesTo ibc:concept-accessibleentrance,
        ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility,
        ibc:concept-parkingspace ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.7-atomic-1,
        ibc:sem-ibc2021-1106.7-atomic-2,
        ibc:sem-ibc2021-1106.7-atomic-3,
        ibc:sem-ibc2021-1106.7-atomic-4,
        ibc:sem-ibc2021-1106.7-atomic-5 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.7-condition-1,
        ibc:sem-ibc2021-1106.7-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1106.7 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.7 Location. Accessible parking spaces shall be located on the shortest accessible route of travel from adjacent parking to an accessible building entrance. In parking facilities that do not serve a particular building, accessible parking spaces shall be located on the shortest route to an accessible pedestrian entrance to the parking facility. Where buildings have multiple accessible entrances with adjacent parking, accessible parking spaces shall be dispersed and located near the accessible entrances. Exceptions: 1. In multilevel parking structures, van-accessible parking spaces are permitted on one level. 2. Accessible parking spaces shall be permitted to be located in different parking facilities if substantially equivalent or greater accessibility is provided in terms of distance from an accessible entrance or entrances, parking fee and user convenience." .

ibc:sem-ibc2021-1106.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.8 ;
    ibco:appliesTo ibc:concept-parkingspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.8-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.8-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1106.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.8 Parking meters and pay stations. Where parking meters and pay stations serve accessible parking spaces, such parking meters and pay stations shall be accessible." .

ibc:sem-ibc2021-1106.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.9 ;
    ibco:appliesTo ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.9-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1106.9 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.9 Passenger loading zones. Passenger loading zones shall be accessible." .

ibc:sem-ibc2021-1106.9.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.9.1 ;
    ibco:appliesTo ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.9.1-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.9.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1106.9.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.9.1 Continuous loading zones. Where passenger loading zones are provided, one passenger loading zone in every continuous 100 linear feet (30.4 m) maximum of loading zone space shall be accessible." .

ibc:sem-ibc2021-1106.9.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.9.2 ;
    ibco:appliesTo ibc:concept-accessibleentrance,
        ibc:concept-buildingorfacility,
        ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.9.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1106.9.2-condition-1,
        ibc:sem-ibc2021-1106.9.2-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1106.9.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.9.2 Medical facilities. A passenger loading zone shall be provided at an accessible entrance to licensed medical and long-term care facilities where people receive physical or medical treatment or care and where the period of stay exceeds 24 hours." .

ibc:sem-ibc2021-1106.9.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.9.3 ;
    ibco:appliesTo ibc:concept-passengerloadingzone ;
