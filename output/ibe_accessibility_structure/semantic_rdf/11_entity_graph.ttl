    ibco:statementType "declarative" ;
    ibco:text "1108.5.1.2 Accessible units in Group I-1, Condition" .

ibc:sem-ibc2021-1108.5.1.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.1.3 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.1.3-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0083 ;
    ibco:modality "shall" ;
