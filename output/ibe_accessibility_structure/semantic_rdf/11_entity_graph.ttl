    ibco:sourceNode ibc:ibc2021-1106.9.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.9.3 Valet parking. A passenger loading zone shall be provided at valet parking services." .

ibc:sem-ibc2021-1106.9.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1106.9.4 ;
    ibco:appliesTo ibc:concept-passengerloadingzone ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1106.9.4-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1106.9.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1106.9.4 Mechanical access parking garages. Mechanical access parking garages shall provide at least one passenger loading zone at vehicle drop-off and vehicle pick-up areas." .

ibc:sem-ibc2021-1107.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1107.1 ;
    ibco:appliesTo ibc:concept-electrical-vehicle-charging-stations ;
    ibco:confidence 0.93 ;
