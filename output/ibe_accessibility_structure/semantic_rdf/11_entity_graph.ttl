        "topological" ;
    ibco:sourceNode ibc:ibc2021-n0027 ;
    ibco:statementType "exception" ;
    ibco:text "Exception: Other than in buildings or facilities containing or serving Type B units, an accessible route shall not be required between site arrival points and the building or facility entrance if the only means of access between them is a vehicular way not providing for pedestrian access." .

ibc:sem-ibc2021-n0035 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-n0035 ;
