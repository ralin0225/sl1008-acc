        ibc:ibc2021-1108-6,
        ibc:ibc2021-1108-7-1,
        ibc:ibc2021-1108-7-5 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.7 ;
    ibco:statementType "permission" ;
    ibco:text "1108.7 General exceptions. Where specifically permitted by Section 1108.5 or 1108.6, the required number of Type A units and Type B units is permitted to be reduced in accordance with Sections 1108.7.1 through 1108.7.5." .

ibc:sem-ibc2021-1108.7.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.1 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.1-atomic-1,
        ibc:sem-ibc2021-1108.7.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.1-condition-1 ;
    ibco:modality "required" ;
    ibco:references ibc:ibc2021-1108-6-2-2-1,
        ibc:ibc2021-1108-7-1-1,
        ibc:ibc2021-1108-7-1-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.7.1 Structures without elevator service. Where elevator service is not provided in a structure, only the dwelling units and sleeping units that are located on stories indicated in Sections 1108.7.1.1 and 1108.7.1.2 are required to be Type A units and Type B units, respectively. The number of Type A units shall be determined in accordance with Section 1108.6.2.2.1." .

ibc:sem-ibc2021-1108.7.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.1.1 ;
    ibco:appliesTo ibc:concept-accessibleentrance,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.1.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.1.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.7.1.1 One story with Type B units required. At least one story containing dwelling units or sleeping units intended to be occupied as a residence shall be provided with an accessible entrance from the exterior of the structure and all units intended to be occupied as a residence on that story shall be Type B units." .

ibc:sem-ibc2021-1108.7.1.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.1.2 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.65 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.1.2-atomic-1,
        ibc:sem-ibc2021-1108.7.1.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.1.2-condition-1,
        ibc:sem-ibc2021-1108.7.1.2-condition-2,
        ibc:sem-ibc2021-1108.7.1.2-condition-3,
        ibc:sem-ibc2021-1108.7.1.2-condition-4,
        ibc:sem-ibc2021-1108.7.1.2-condition-5 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.7.1.2-measurement-1,
        ibc:sem-ibc2021-1108.7.1.2-measurement-2,
        ibc:sem-ibc2021-1108.7.1.2-measurement-3,
        ibc:sem-ibc2021-1108.7.1.2-measurement-4,
        ibc:sem-ibc2021-1108.7.1.2-measurement-5 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-7-1-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.1.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.7.1.2 Additional stories with Type B units. Where stories have entrances not included in determining compliance with Section 1108.7.1.1, and such entrances are proximate to arrival points intended to serve units on that story, as indicated in Items 1 and 2, all dwelling units and sleeping units intended to be occupied as a residence served by that entrance on that story shall be Type B units. 1. Where the slopes of the undisturbed site measured between the planned entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less. 2. Where the slopes of the planned finished grade measured between the entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less. Where arrival points are not within 50 feet (15 240 mm) of the entrance, the closest arrival point shall be used to determine access unless that arrival point serves the story required by Section 1108.7.1.1." .

ibc:sem-ibc2021-1108.7.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.2-atomic-1,
        ibc:sem-ibc2021-1108.7.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.2-condition-1,
        ibc:sem-ibc2021-1108.7.2-condition-2 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.2 ;
    ibco:statementType "exemption" ;
    ibco:text "1108.7.2 Multistory units. A multistory dwelling unit or sleeping unit that is not provided with elevator service is not required to be a Type B unit. Where a multistory unit is provided with external elevator service to only one floor, the floor provided with elevator service shall be the primary entry to the unit, shall comply with the requirements for a Type B unit and, where provided within the unit, a living area, a kitchen and a toilet facility shall be provided on that floor." .

ibc:sem-ibc2021-1108.7.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.3 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.3-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.3-condition-1 ;
    ibco:modality "required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.7.3 Elevator service to the lowest story with units. Where elevator service in the building provides an accessible route only to the lowest story containing dwelling units or sleeping units intended to be occupied as a residence, only the units on that story that are intended to be occupied as a residence are required to be Type B units." .

ibc:sem-ibc2021-1108.7.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-typebunit ;
    ibco:confidence 0.65 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.4-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.4-condition-1,
        ibc:sem-ibc2021-1108.7.4-condition-2,
        ibc:sem-ibc2021-1108.7.4-condition-3 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.7.4-measurement-1,
        ibc:sem-ibc2021-1108.7.4-measurement-2,
        ibc:sem-ibc2021-1108.7.4-measurement-3,
        ibc:sem-ibc2021-1108.7.4-measurement-4 ;
    ibco:modality "may" ;
    ibco:references ibc:ibc2021-1108-7-1,
        ibc:ibc2021-1108-7-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.4 ;
    ibco:statementType "permission" ;
    ibco:text "1108.7.4 Site impracticality. On a site with multiple nonelevator buildings, the number of units required by Section 1108.7.1 to be Type B units is permitted to be reduced to a percentage that is equal to the percentage of the entire site having grades, prior to development, that are less than 10 percent, provided that all of the following conditions are met: 1. Not less than 20 percent of the units required by Section 1108.7.1 on the site are Type B units. 2. Units required by Section 1108.7.1, where the slope between the building entrance serving the units on that story and a pedestrian or vehicular arrival point is not greater than 8.33 percent, are Type B units. 3. Units required by Section 1108.7.1, where an elevated walkway is planned between a building entrance serving the units on that story and a pedestrian or vehicular arrival point and the slope between them is 10 percent or less, are Type B units. 4. Units served by an elevator in accordance with Section 1108.7.3 are Type B units." .

ibc:sem-ibc2021-1108.7.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.7.5 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.7.5-atomic-1,
        ibc:sem-ibc2021-1108.7.5-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.7.5-condition-1,
        ibc:sem-ibc2021-1108.7.5-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.7.5-measurement-1,
        ibc:sem-ibc2021-1108.7.5-measurement-2,
        ibc:sem-ibc2021-1108.7.5-measurement-3,
        ibc:sem-ibc2021-1108.7.5-measurement-4,
        ibc:sem-ibc2021-1108.7.5-measurement-5 ;
    ibco:modality "shall_not" ;
    ibco:references ibc:ibc2021-1612-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.7.5 ;
    ibco:statementType "prohibition" ;
    ibco:text "1108.7.5 Flood hazard areas. Type A units and Type B units shall not be required for buildings without elevator service that are located in flood hazard areas as established in Section 1612.3, where the minimum required elevation of the lowest floor or lowest supporting horizontal structural member, as applicable, results in all of the following: 1. A difference in elevation between the minimum required floor elevation at the primary entrances and vehicular and pedestrian arrival points within 50 feet (15 240 mm) exceeding 30 inches (762 mm). 2. A slope exceeding 10 percent between the minimum required floor elevation at the primary entrances and vehicular and pedestrian arrival points within 50 feet (15 240 mm). Where such arrival points are not within 50 feet (15 240 mm) of the primary entrances, the closest arrival points shall be used." .

ibc:sem-ibc2021-1109.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.1 ;
    ibco:appliesTo ibc:concept-in-addition-to-the-other-requirements-of-this-chapter-the-requirements-of-sections-1109-2-through-1109-4 ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2,
        ibc:ibc2021-1109-4 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.1 General. In addition to the other requirements of this chapter, the requirements of Sections 1109.2 through 1109.4 shall apply to specific occupancies." .

ibc:sem-ibc2021-1109.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2-atomic-1,
        ibc:sem-ibc2021-1109.2-atomic-2,
        ibc:sem-ibc2021-1109.2-atomic-3,
        ibc:sem-ibc2021-1109.2-atomic-4,
        ibc:sem-ibc2021-1109.2-atomic-5 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-1,
        ibc:ibc2021-1109-2-5,
        ibc:ibc2021-1109-2-6,
        ibc:ibc2021-1109-2-7,
        ibc:ibc2021-1109-2-8,
        ibc:ibc2021-1109-2-9 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2 Assembly area seating. A building, room or space used for assembly purposes with fixed seating shall comply with Sections 1109.2.1 through 1109.2.5. Lawn seating shall comply with Section 1109.2.6. Assistive listening systems shall comply with Section 1109.2.7. Performance areas viewed from assembly seating areas shall comply with Section 1109.2.8. Dining areas shall comply with Section 1109.2.9." .

ibc:sem-ibc2021-1109.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.1-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.1 Services. If a service or facility is provided in an area that is not accessible, the same service or facility shall be provided on an accessible level and shall be accessible." .

ibc:sem-ibc2021-1109.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.2 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1,
        ibc:ibc2021-1109-2-2-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.2 Wheelchair spaces. In rooms and spaces used for assembly purposes with fixed seating, accessible wheelchair spaces shall be provided in accordance with Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:sem-ibc2021-1109.2.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.2.1 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.2.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.2.1 General seating. Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1. TABLE 1109.2.2.1 ACCESSIBLE WHEELCHAIR SPACES" .

ibc:sem-ibc2021-1109.2.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.2.2 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.2.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.2.2 Luxury boxes, club boxes and suites. In each luxury box, club box and suite within arenas, stadiums and grandstands, wheelchair spaces shall be provided in accordance with Table 1109.2.2.1." .

ibc:sem-ibc2021-1109.2.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.2.3 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.2.3-atomic-1,
        ibc:sem-ibc2021-1109.2.2.3-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.2.3-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1109.2.2.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1,
        ibc:ibc2021-1109-2-2-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.2.3 Other boxes. In boxes other than those required to comply with Section 1109.2.2.2, the total number of wheelchair spaces provided shall be determined in accordance with Table 1109.2.2.1. Wheelchair spaces shall be located in not less than 20 percent of all boxes provided." .

ibc:sem-ibc2021-1109.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.3 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1,
        ibc:ibc2021-1109-2-2-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.3 Companion seats. At least one companion seat shall be provided for each wheelchair space required by Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:sem-ibc2021-1109.2.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-wheelchairspace ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.4-atomic-1,
        ibc:sem-ibc2021-1109.2.4-atomic-2,
        ibc:sem-ibc2021-1109.2.4-atomic-3,
        ibc:sem-ibc2021-1109.2.4-atomic-4,
        ibc:sem-ibc2021-1109.2.4-atomic-5 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.4-condition-1,
        ibc:sem-ibc2021-1109.2.4-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1109.2.4-measurement-1,
        ibc:sem-ibc2021-1109.2.4-measurement-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.4 Dispersion of wheelchair spaces in multilevel assembly seating areas. In multilevel assembly seating areas, wheelchair spaces shall be provided on the main floor level and on one of each two additional floor or mezzanine levels. Wheelchair spaces shall be provided in each luxury box, club box and suite within assembly facilities. Exceptions: 1. In multilevel assembly seating areas utilized for worship services where the second floor or mezzanine level contains 25 percent or less of the total seating capacity, wheelchair spaces shall be permitted to all be located on the main level. 2. In multilevel assembly seating areas where the second floor or mezzanine level provides 25 percent or less of the total seating capacity and 300 or fewer seats, all wheelchair spaces shall be permitted to be located on the main level. 3. Wheelchair spaces in team or player seating serving areas of sport activity are not required to be dispersed." .

ibc:sem-ibc2021-1109.2.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.5 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.5-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0140 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1109.2.5-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.5 Designated aisle seats. At least 5 percent, but not less than one, of the total number of aisle seats provided shall be designated aisle seats and shall be the aisle seats located closest to accessible routes." .

ibc:sem-ibc2021-1109.2.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.6 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.6-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.6-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.6 Lawn seating. Lawn seating areas and exterior overflow seating areas, where fixed seats are not provided, shall connect to an accessible route." .

ibc:sem-ibc2021-1109.2.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.7 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.7-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.7-condition-1 ;
    ibco:hasException ibc:ibc2021-n0143 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.7 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.7 Assistive listening systems. Each building, room or space used for assembly purposes where audible communications are integral to the use of the space shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.7.1 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.7.1-atomic-1,
        ibc:sem-ibc2021-1109.2.7.1-atomic-2,
        ibc:sem-ibc2021-1109.2.7.1-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.7.1-condition-1,
        ibc:sem-ibc2021-1109.2.7.1-condition-2,
        ibc:sem-ibc2021-1109.2.7.1-condition-3,
        ibc:sem-ibc2021-1109.2.7.1-condition-4 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-7-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.7.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.7.1 Receivers. The number and type of receivers shall be provided for assistive listening systems in accordance with Table 1109.2.7.1. Exceptions: 1. Where a building contains more than one room or space used for assembly purposes, the total number of required receivers shall be permitted to be calculated based on the total number of seats in the building, provided that all receivers are usable with all systems and if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management. 2. Where all seats in a building, room or space used for assembly purposes are served by an induction loop assistive listening system, the minimum number of receivers required by Table 1109.2.7.1 to be hearing-aid compatible shall not be required." .

ibc:sem-ibc2021-1109.2.7.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.7.2 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.7.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.7.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.7.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.7.2 Ticket windows. Where ticket windows are provided in stadiums and arenas, at least one window at each location shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.7.3 ;
    ibco:appliesTo ibc:concept-where-stadiums-arenas-and-grandstands-have-15-000-fixed-seats-or-more-and-provide-audible-public-announcements-they ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.7.3-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.7.3-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.2.7.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.7.3 Public address systems. Where stadiums, arenas and grandstands have 15,000 fixed seats or more and provide audible public announcements, they shall also provide prerecorded or real-time captions of those audible public announcements." .

ibc:sem-ibc2021-1109.2.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.8 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.8-atomic-1,
        ibc:sem-ibc2021-1109.2.8-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.8-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.8 Performance areas. An accessible route shall directly connect the performance area to the assembly seating area where a circulation path directly connects a performance area to an assembly seating area. An accessible route shall be provided from performance areas to ancillary areas or facilities used by performers." .

ibc:sem-ibc2021-1109.2.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.9 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-assistivelisteningsystem ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.9-atomic-1,
        ibc:sem-ibc2021-1109.2.9-atomic-2,
        ibc:sem-ibc2021-1109.2.9-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.9-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1104-4 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.9 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.9 Dining and drinking areas. In dining and drinking areas, all interior and exterior floor areas shall be accessible and be on an accessible route. Exceptions: 1. An accessible route between accessible levels and stories above or below is not required where permitted by Section 1104.4, Exception 1. RECEIVERS FOR ASSISTIVE LISTENING SYSTEMS" .

ibc:sem-ibc2021-1109.2.9.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.2.9.1 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.2.9.1-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.2.9.1-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1109.2.9.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.2.9.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.2.9.1 Dining surfaces. Where dining surfaces for the consumption of food or drink are provided, at least 5 percent, but not less than one, of the dining surfaces for the seating and standing spaces shall be accessible and be distributed throughout the facility and located on a level accessed by an accessible route." .

ibc:sem-ibc2021-1109.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.3 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.3 Self-service storage facilities. Self-service storage facilities shall provide accessible individual self-storage spaces in accordance with Table 1109.3. TABLE 1109.3 ACCESSIBLE SELF-SERVICE STORAGE FACILITIES" .

ibc:sem-ibc2021-1109.3.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.3.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.3.1-atomic-1,
        ibc:sem-ibc2021-1109.3.1-atomic-2,
        ibc:sem-ibc2021-1109.3.1-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.3.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.3.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.3.1 Dispersion. Accessible individual self-service storage spaces shall be dispersed throughout the various classes of spaces provided. Where more classes of spaces are provided than the number of required accessible spaces, the number of accessible spaces shall not be required to exceed that required by Table 1109.3. Accessible spaces are permitted to be dispersed in a single building of a multiple-building facility." .

ibc:sem-ibc2021-1109.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-4-1,
        ibc:ibc2021-1109-4-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4 Judicial facilities. Judicial facilities shall comply with Sections 1109.4.1 and 1109.4.2." .

ibc:sem-ibc2021-1109.4.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1 ;
    ibco:appliesTo ibc:concept-each-courtroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-4-1-1,
        ibc:ibc2021-1109-4-1-5 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1 Courtrooms. Each courtroom shall be accessible and comply with Sections 1109.4.1.1 through 1109.4.1.5." .

ibc:sem-ibc2021-1109.4.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1.1 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1.1-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0156 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1.1 Jury box. A wheelchair space shall be provided within the jury box." .

ibc:sem-ibc2021-1109.4.1.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1.2 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1.2-atomic-1,
        ibc:sem-ibc2021-1109.4.1.2-atomic-2 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-2-1,
        ibc:ibc2021-1109-2-5 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1.2 Gallery seating. Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1. Designated aisle seats shall be provided in accordance with Section 1109.2.5." .

ibc:sem-ibc2021-1109.4.1.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1.3 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1.3-atomic-1,
        ibc:sem-ibc2021-1109.4.1.3-atomic-2 ;
    ibco:modality "must" ;
    ibco:references ibc:ibc2021-1109-2-7-1 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1.3 Assistive listening systems. An assistive listening system must be provided. Receivers shall be provided for the assistive listening system in accordance with Section 1109.2.7.1." .

ibc:sem-ibc2021-1109.4.1.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1.4 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1.4-atomic-1,
        ibc:sem-ibc2021-1109.4.1.4-atomic-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1.4 Employee work stations. The judge’s bench, clerk’s station, bailiff’s station, deputy clerk’s station and court reporter’s station shall be located on an accessible route. The vertical access to elevated employee work stations within a courtroom is not required at the time of initial construction, provided a ramp, lift or elevator can be installed without requiring reconfiguration or extension of the courtroom or extension of the electrical system." .

ibc:sem-ibc2021-1109.4.1.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.1.5 ;
    ibco:appliesTo ibc:concept-the-litigant-s-and-counsel-stations-including-the-lectern ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.1.5-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.1.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.1.5 Other work stations. The litigant’s and counsel stations, including the lectern, shall be accessible." .

ibc:sem-ibc2021-1109.4.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.2 ;
    ibco:appliesTo ibc:concept-central-holding-cells-and-courtfloor-holding-cells ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-4-2-1,
        ibc:ibc2021-1109-4-2-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.2 Holding cells. Central holding cells and courtfloor holding cells shall comply with Sections 1109.4.2.1 and 1109.4.2.2." .

ibc:sem-ibc2021-1109.4.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.2.1 ;
    ibco:appliesTo ibc:concept-where-separate-central-holding-cells-are-provided-for-adult-males-juvenile-males-adult-females-or-juvenile-females-one-of-each-type ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.2.1-atomic-1,
        ibc:sem-ibc2021-1109.4.2.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.4.2.1-condition-1,
        ibc:sem-ibc2021-1109.4.2.1-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.2.1 Central holding cells. Where separate central holding cells are provided for adult males, juvenile males, adult females or juvenile females, one of each type shall be accessible. Where central holding cells are provided and are not separated by age or sex, at least one accessible cell shall be provided." .

ibc:sem-ibc2021-1109.4.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1109.4.2.2 ;
    ibco:appliesTo ibc:concept-where-separate-court-floor-holding-cells-are-provided-for-adult-males-juvenile-males-adult-females-or-juvenile-females-each-courtroom ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1109.4.2.2-atomic-1,
        ibc:sem-ibc2021-1109.4.2.2-atomic-2,
        ibc:sem-ibc2021-1109.4.2.2-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1109.4.2.2-condition-1,
        ibc:sem-ibc2021-1109.4.2.2-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1109.4.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1109.4.2.2 Court-floor holding cells. Where separate court-floor holding cells are provided for adult males, juvenile males, adult females or juvenile females, each courtroom shall be served by one accessible cell of each type. Where court-floor holding cells are provided and are not separated by age or sex, courtrooms shall be served by at least one accessible cell. Accessible cells shall be permitted to serve more than one courtroom." .

ibc:sem-ibc2021-1110.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.1-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0166 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-16,
        ibc:ibc2021-1110-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.1 General. Accessible building features and facilities shall be provided in accordance with Sections 1110.2 through 1110.16." .

ibc:sem-ibc2021-1110.10 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.10 ;
    ibco:appliesTo ibc:concept-where-fixed-or-built-in-storage-elements-such-as-cabinets-coat-hooks-shelves-medicine-cabinets-lockers-closets-and-drawers-are-provided-in-required-accessible-spaces-at-least-5-percent-but-not-less-than-one-of-each-type ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.10-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.10-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.10-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.10 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.10 Storage. Where fixed or built-in storage elements such as cabinets, coat hooks, shelves, medicine cabinets, lockers, closets and drawers are provided in required accessible spaces, at least 5 percent, but not less than one of each type shall be accessible." .

ibc:sem-ibc2021-1110.10.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.10.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.10.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.10.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.10.1 Equity. Accessible facilities and spaces shall be provided with the same storage elements as provided in the similar nonaccessible facilities and spaces." .

ibc:sem-ibc2021-1110.10.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.10.2 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.10.2-atomic-1,
        ibc:sem-ibc2021-1110.10.2-atomic-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.10.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.10.2 Shelving and display units. Self-service shelves and display units shall be located on an accessible route. Such shelving and display units shall not be required to comply with reach-range provisions." .

ibc:sem-ibc2021-1110.11 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.11 ;
    ibco:appliesTo ibc:concept-passenger-transit-platform-edges-bordering-a-drop-off-and-not-protected-by-platform-screens-or-guards ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.11-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0228 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.11 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.11 Detectable warnings. Passenger transit platform edges bordering a drop-off and not protected by platform screens or guards shall have a detectable warning." .

ibc:sem-ibc2021-1110.12 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.12 ;
    ibco:appliesTo ibc:concept-where-seating-or-standing-space-at-fixed-or-built-in-tables-counters-or-work-surfaces-is-provided-in-accessible-spaces-at-least-5-percent-of-the-seating-and-standing-spaces-but-not-less-than-one ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.12-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.12-condition-1 ;
    ibco:hasException ibc:ibc2021-n0230 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.12-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.12 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.12 Seating at tables, counters and work surfaces. Where seating or standing space at fixed or built-in tables, counters or work surfaces is provided in accessible spaces, at least 5 percent of the seating and standing spaces, but not less than one, shall be accessible." .

ibc:sem-ibc2021-1110.12.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.12.1 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.12.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.12.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.12.1 Dispersion. Accessible fixed or built-in seating at tables, counters or work surfaces shall be distributed throughout the space or facility containing such elements and located on a level accessed by an accessible route." .

ibc:sem-ibc2021-1110.12.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.12.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.12.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-12-2-1,
        ibc:ibc2021-1110-12-2-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.12.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.12.2 Visiting areas. Visiting areas in judicial facilities and Group I-3 shall comply with Sections 1110.12.2.1 and 1110.12.2.2." .

ibc:sem-ibc2021-1110.12.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.12.2.1 ;
    ibco:appliesTo ibc:concept-at-least-5-percent-but-not-less-than-one-of-the-cubicles ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.12.2.1-atomic-1,
        ibc:sem-ibc2021-1110.12.2.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.12.2.1-condition-1 ;
    ibco:hasException ibc:ibc2021-n0234 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.12.2.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.12.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.12.2.1 Cubicles and counters. At least 5 percent, but not less than one of the cubicles, shall be accessible on both the visitor and detainee sides. Where counters are provided, at least one shall be accessible on both the visitor and detainee sides." .

ibc:sem-ibc2021-1110.12.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.12.2.2 ;
    ibco:appliesTo ibc:concept-where-solid-partitions-or-security-glazing-separate-visitors-from-detainees-at-least-one-of-each-type-of-cubicle-or-counter-partition ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.12.2.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.12.2.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.12.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.12.2.2 Partitions. Where solid partitions or security glazing separate visitors from detainees, at least one of each type of cubicle or counter partition shall be accessible." .

ibc:sem-ibc2021-1110.13 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.13 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.13-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-13-4,
        ibc:ibc2021-1110-14 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.13 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.13 Service facilities. Service facilities shall provide for accessible features in accordance with Sections 1110.14 through 1110.13.4. *" .

ibc:sem-ibc2021-1110.13.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.13.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.13.1-atomic-1,
        ibc:sem-ibc2021-1110.13.1-atomic-2,
        ibc:sem-ibc2021-1110.13.1-atomic-3,
        ibc:sem-ibc2021-1110.13.1-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.13.1-condition-1,
        ibc:sem-ibc2021-1110.13.1-condition-2,
        ibc:sem-ibc2021-1110.13.1-condition-3 ;
    ibco:hasException ibc:ibc2021-n0238 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-13-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.13.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.13.1 Check-out aisles. Where check-out aisles are provided, accessible check-out aisles shall be provided in accordance with Table 1110.13.1. Where check-out aisles serve different functions, accessible check-out aisles shall be provided in accordance with Table 1110.13.1 for each function. Where check-out aisles are dispersed throughout the building or facility, accessible check-out aisles shall also be dispersed. Traffic control devices, security devices and turnstiles located in accessible check-out aisles or lanes shall be accessible." .

ibc:sem-ibc2021-1110.13.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.13.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.13.2-atomic-1,
        ibc:sem-ibc2021-1110.13.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.13.2-condition-1,
        ibc:sem-ibc2021-1110.13.2-condition-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.13.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.13.2 Sales and service counters and windows. Where counters or windows are provided for sale or distribution of goods or services, at least one of each type of counter and window provided shall be accessible. Where such counters or windows are dispersed throughout the building or facility, accessible counters or windows shall also be dispersed." .

ibc:sem-ibc2021-1110.13.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.13.3 ;
    ibco:appliesTo ibc:concept-food-service-lines ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.13.3-atomic-1,
        ibc:sem-ibc2021-1110.13.3-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.13.3-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.13.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.13.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.13.3 Food service lines. Food service lines shall be accessible. Where self-service shelves are provided, at least 50 percent, but not less than one, of each type provided shall be accessible." .

ibc:sem-ibc2021-1110.13.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.13.4 ;
    ibco:appliesTo ibc:concept-queue-and-waiting-lines-servicing-accessible-counters-or-check-out-aisles ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.13.4-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.13.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.13.4 Queue and waiting lines. Queue and waiting lines servicing accessible counters or check-out aisles ** shall be accessible." .

ibc:sem-ibc2021-1110.14 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.14 ;
    ibco:appliesTo ibc:concept-where-dressing-rooms-fitting-rooms-or-locker-rooms-are-provided-at-least-5-percent-but-not-less-than-one-of-each-type-of-use-in-each-cluster-provided ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.14-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.14-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.14-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.14 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.14 Dressing, fitting and locker rooms. Where dressing rooms, fitting rooms or locker rooms are provided, at least 5 percent, but not less than one, of each type of use in each cluster provided shall be accessible." .

ibc:sem-ibc2021-1110.15 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.15 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.15-atomic-1,
        ibc:sem-ibc2021-1110.15-atomic-2,
        ibc:sem-ibc2021-1110.15-atomic-3,
        ibc:sem-ibc2021-1110.15-atomic-4 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1010-2-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.15 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.15 Controls, operating mechanisms and hardware. Controls, operating mechanisms and hardware intended for operation by the occupant, including switches that control lighting and ventilation and electrical convenience outlets, in accessible spaces, along accessible routes or as parts of accessible elements shall be accessible. Exceptions: 1. Operable parts that are intended for use only by service or maintenance personnel shall not be required to be accessible.  2. Access doors or gates in barrier walls and fences protecting pools, spas and hot tubs shall be permitted to comply with Section 1010.2.3. 3. Operable parts exempted in accordance with ICC A117.1 are not required to be accessible. *" .

ibc:sem-ibc2021-1110.16 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.16 ;
    ibco:appliesTo ibc:concept-at-least-two-percent-of-the-total-but-not-fewer-than-one-of-each-gaming-machine-type-and-gaming-table-type ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.16-atomic-1,
        ibc:sem-ibc2021-1110.16-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.16-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.16 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.16 Gaming machines and gaming tables. At least two percent of the total, but not fewer than one, of each gaming machine type and gaming table type shall be accessible. Where multiple gaming areas occur, accessible gaming machines and gaming tables shall be distributed throughout." .

ibc:sem-ibc2021-1110.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-bathingroom,
        ibc:concept-buildingorfacility,
        ibc:concept-toiletroom ;
    ibco:confidence 0.65 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2-atomic-1,
        ibc:sem-ibc2021-1110.2-atomic-10,
        ibc:sem-ibc2021-1110.2-atomic-11,
        ibc:sem-ibc2021-1110.2-atomic-12,
        ibc:sem-ibc2021-1110.2-atomic-13,
        ibc:sem-ibc2021-1110.2-atomic-2,
        ibc:sem-ibc2021-1110.2-atomic-3,
        ibc:sem-ibc2021-1110.2-atomic-4,
        ibc:sem-ibc2021-1110.2-atomic-5,
        ibc:sem-ibc2021-1110.2-atomic-6,
        ibc:sem-ibc2021-1110.2-atomic-7,
        ibc:sem-ibc2021-1110.2-atomic-8,
        ibc:sem-ibc2021-1110.2-atomic-9 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2-condition-1,
        ibc:sem-ibc2021-1110.2-condition-2,
        ibc:sem-ibc2021-1110.2-condition-3,
        ibc:sem-ibc2021-1110.2-condition-4,
        ibc:sem-ibc2021-1110.2-condition-5,
        ibc:sem-ibc2021-1110.2-condition-6 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108,
        ibc:ibc2021-1110-2-2,
        ibc:ibc2021-1110-2-3,
        ibc:ibc2021-1110-2-4,
        ibc:ibc2021-1110-2-5 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2 Toilet and bathing facilities. Each toilet room and bathing room shall be accessible. Where a floor level is not required to be connected by an accessible route, the only toilet rooms or bathing rooms provided within the facility shall not be located on the inaccessible floor. Except as provided for in Sections 1110.2.4 and 1110.2.5, at least one of each type of fixture, element, control or dispenser in each accessible toilet room and bathing room shall be accessible. Exceptions: 1. Toilet rooms or bathing rooms accessed only through a private office, not for common or public use and intended for use by a single occupant, shall be permitted to comply with the specific exceptions in ICC A117.1. 2. This section is not applicable to toilet and bathing rooms that serve dwelling units or sleeping units that are not required to be accessible by Section 1108. 3. Where multiple single-user toilet rooms or bathing rooms are clustered at a single location, at least 50 percent but not less than one room for each use at each cluster shall be accessible. 4. Where no more than one urinal is provided in a toilet room or bathing room, the urinal is not required to be accessible. 5. Toilet rooms or bathing rooms that are part of critical care or intensive care patient sleeping rooms serving Accessible units are not required to be accessible. 6. Toilet rooms or bathing rooms designed for bariatrics patients are not required to comply with the toilet room and bathing room requirement in ICC A117.1. The sleeping units served by bariatrics toilet or bathing rooms shall not count toward the required number of Accessible sleeping units. 7. Where permitted in Section 1108, in toilet rooms or bathrooms serving Accessible units, water closets designed for assisted toileting shall comply with Section 1110.2.2. 8. Where permitted in Section 1108, in bathrooms serving Accessible units, showers designed for assisted bathing shall comply with Section 1110.2.3. 9. Where toilet facilities are primarily for children’s use, required accessible water closets, toilet compartments and lavatories shall be permitted to comply with children’s provision of ICC A117.1." .

ibc:sem-ibc2021-1110.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1 ;
    ibco:appliesTo ibc:concept-bathingroom,
        ibc:concept-buildingorfacility,
        ibc:concept-toiletroom ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1-atomic-1,
        ibc:sem-ibc2021-1110.2.1-atomic-2,
        ibc:sem-ibc2021-1110.2.1-atomic-3,
        ibc:sem-ibc2021-1110.2.1-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.1-condition-1,
        ibc:sem-ibc2021-1110.2.1-condition-2 ;
    ibco:hasException ibc:ibc2021-n0169 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1 Family or assisted-use toilet and bathing rooms. In assembly and mercantile occupancies, an accessible family or assisted-use toilet room shall be provided where an aggregate of six or more male and female water closets is required. In buildings of mixed occupancy, only those water closets required for the assembly or mercantile occupancy shall be used to determine the family or assisted-use toilet room requirement. In recreational facilities where separate-sex bathing rooms are provided, an accessible family or assisted-use bathing room shall be provided. Fixtures located within family or assisted-use toilet and bathing rooms shall be included in determining the number of fixtures provided in an occupancy." .

ibc:sem-ibc2021-1110.2.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.1 ;
    ibco:appliesTo ibc:concept-bathingroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-1-2,
        ibc:ibc2021-1110-2-1-6 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1.1 Standard. Family or assisted-use toilet and bathing rooms shall comply with Sections 1110.2.1.2 through 1110.2.1.6." .

ibc:sem-ibc2021-1110.2.1.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.2 ;
    ibco:appliesTo ibc:concept-bathingroom,
        ibc:concept-toiletroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.2-atomic-1,
        ibc:sem-ibc2021-1110.2.1.2-atomic-2 ;
    ibco:hasException ibc:ibc2021-n0172 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-1-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1.2 Family or assisted-use toilet rooms. Family or assisted-use toilet rooms shall include only one water closet and only one lavatory. A family or assisted-use bathing room in accordance with Section 1110.2.1.3 shall be considered to be a family or assisted-use toilet room." .

ibc:sem-ibc2021-1110.2.1.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.3 ;
    ibco:appliesTo ibc:concept-bathingroom,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.3-atomic-1,
        ibc:sem-ibc2021-1110.2.1.3-atomic-2,
        ibc:sem-ibc2021-1110.2.1.3-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.1.3-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1.3 Family or assisted-use bathing rooms. Family or assisted-use bathing rooms shall include only one shower or bathtub fixture. Family or assisteduse bathing rooms shall also include one water closet and one lavatory. Where storage facilities are provided for separate-sex bathing rooms, accessible storage facilities shall be provided for family or assisted-use bathing rooms." .

ibc:sem-ibc2021-1110.2.1.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.4 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-bathingroom,
        ibc:concept-toiletroom ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.4-atomic-1,
        ibc:sem-ibc2021-1110.2.1.4-atomic-2,
        ibc:sem-ibc2021-1110.2.1.4-atomic-3 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.1.4-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1.4 Location. Family or assisted-use toilet and bathing rooms shall be located on an accessible route. Family or assisted-use toilet rooms shall be located not more than one story above or below separate-sex toilet rooms. The accessible route from any separate-sex toilet room to a family or assisted-use toilet room shall not exceed 500 feet (152 m)." .

ibc:sem-ibc2021-1110.2.1.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.5 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility,
        ibc:concept-toiletroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.5-atomic-1 ;
    ibco:modality "shall_not" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.5 ;
    ibco:statementType "prohibition" ;
    ibco:text "1110.2.1.5 Prohibited location. In passenger transportation facilities and airports, the accessible route from separate-sex toilet rooms to a family or assisteduse toilet room shall not pass through security checkpoints. " .

ibc:sem-ibc2021-1110.2.1.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.1.6 ;
    ibco:appliesTo ibc:concept-bathingroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.1.6-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.1.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.1.6 Privacy. Doors to family or assisted-use toilet and bathing rooms shall be securable from within the room and be provided with an “occupied” indicator." .

ibc:sem-ibc2021-1110.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2 ;
    ibco:appliesTo ibc:concept-water-closets-designed-for-assisted-toileting ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-2-1,
        ibc:ibc2021-1110-2-2-6 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2 Water closets designed for assisted toileting. Water closets designed for assisted toileting shall comply with Sections 1110.2.2.1 through 1110.2.2.6." .

ibc:sem-ibc2021-1110.2.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.1 ;
    ibco:appliesTo ibc:concept-the-centerline-of-the-water-closet ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.1-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.2.1-measurement-1,
        ibc:sem-ibc2021-1110.2.2.1-measurement-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.1 Location. The centerline of the water closet shall be not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from one side of the required clearance." .

ibc:sem-ibc2021-1110.2.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.2 ;
    ibco:appliesTo ibc:concept-clearance-around-the-water-closet ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-2-2-1,
        ibc:ibc2021-1110-2-2-2-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.2 Clearance. Clearance around the water closet shall comply with Sections 1110.2.2.2.1 through 1110.2.2.2.3." .

ibc:sem-ibc2021-1110.2.2.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.2.1 ;
    ibco:appliesTo ibc:concept-clearance-around-a-water-closet ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.2.1-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.2.2.1-measurement-1,
        ibc:sem-ibc2021-1110.2.2.2.1-measurement-2,
        ibc:sem-ibc2021-1110.2.2.2.1-measurement-3 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.2.1 Clearance width. Clearance around a water closet shall be not less than 66 inches (1675 mm) in width, measured perpendicularly from the side of the clearance that is not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from the water closet centerline." .

ibc:sem-ibc2021-1110.2.2.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.2.2 ;
    ibco:appliesTo ibc:concept-clearance-around-the-water-closet ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.2.2-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.2.2.2-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.2.2 Clearance depth. Clearance around the water closet shall be not less than 78 inches (1980 mm) in depth, measured perpendicularly from the rear wall" .

ibc:sem-ibc2021-1110.2.2.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.2.3 ;
    ibco:appliesTo ibc:concept-the-required-clearance-around-the-water-closet ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.2.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.2.3 Clearance overlap. The required clearance around the water closet shall permit overlaps per ICC A117.1, Section 604.3.3" .

ibc:sem-ibc2021-1110.2.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.3 ;
    ibco:appliesTo ibc:concept-the-height-of-the-water-closet-seats ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.3 Height. The height of the water closet seats shall comply with ICC A117.1, Section 604.4." .

ibc:sem-ibc2021-1110.2.2.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.4 ;
    ibco:appliesTo ibc:concept-swing-up-grab-bars ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.4-atomic-1,
        ibc:sem-ibc2021-1110.2.2.4-atomic-2,
        ibc:sem-ibc2021-1110.2.2.4-atomic-3 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.2.4-measurement-1,
        ibc:sem-ibc2021-1110.2.2.4-measurement-2,
        ibc:sem-ibc2021-1110.2.2.4-measurement-3,
        ibc:sem-ibc2021-1110.2.2.4-measurement-4,
        ibc:sem-ibc2021-1110.2.2.4-measurement-5 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.4 Swing-up grab bars. Swing-up grab bars shall comply with ICC A117.1, Sections 609.2 and 609.8. Swing-up grab bars shall be provided on both sides of the water closet and shall comply with all of the following: 1. The centerline of the grab bar shall be not less than 14 inches (356 mm) and not greater than 16 inches (405 mm) from the centerline of the water closet. 2. The length of the grab bar is not less than 36 inches (915 mm) in length, measured from the rear wall to the end of the grab bar. 3. The top of the grab bar in the down position is not less than 30 inches (760 mm) and not greater than34 inches (865 mm) above the floor." .

ibc:sem-ibc2021-1110.2.2.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.5 ;
    ibco:appliesTo ibc:concept-flush-controls ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.5-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.5 Flush controls. Flush controls shall comply with ICC A117.1, Section 604.6." .

ibc:sem-ibc2021-1110.2.2.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.2.6 ;
    ibco:appliesTo ibc:concept-dispensers-toilet-paper-dispensers ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.2.6-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.2.6-measurement-1,
        ibc:sem-ibc2021-1110.2.2.6-measurement-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.2.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.2.6 Dispensers Toilet paper dispensers shall be mounted on at least one of the swing-up grab bars and the outlet of the dispenser shall be located not less than 24 inches (610 mm) and not greater than 36 inches (915 mm) from the rear wall." .

ibc:sem-ibc2021-1110.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3 ;
    ibco:appliesTo ibc:concept-standard-roll-in-type-shower-compartment-designed-for-assisted-bathing-standard-roll-in-type-shower-compartments-designed-for-assisted-bathing ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-3-1,
        ibc:ibc2021-1110-2-3-9 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3 Standard roll-in-type shower compartment designed for assisted bathing. Standard roll-in-type shower compartments designed for assisted bathing shall comply with Sections 1110.2.3.1 through 1110.2.3.9." .

ibc:sem-ibc2021-1110.2.3.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.1 ;
    ibco:appliesTo ibc:concept-size-standard-roll-in-type-shower-compartments ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.1-atomic-1,
        ibc:sem-ibc2021-1110.2.3.1-atomic-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.3.1-measurement-1,
        ibc:sem-ibc2021-1110.2.3.1-measurement-2,
        ibc:sem-ibc2021-1110.2.3.1-measurement-3 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.1 Size. Standard roll-in-type shower compartments shall have a clear inside dimension of not less than 60 inches (1525 mm) in width and 30 inches (760 mm) in depth, measured at the center point of opposing sides. An entry not less than 60 inches (1525 mm) in width shall be provided." .

ibc:sem-ibc2021-1110.2.3.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.2 ;
    ibco:appliesTo ibc:concept-a-clearance-of-not-less-than-60-inches-1525-mm-in-length-adjacent-to-the-60-inch-1525-mm-width-of-the-open-face-of-the-shower-compartment-and-not-less-than-30-inches-760-mm-in-depth ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.2-atomic-1,
        ibc:sem-ibc2021-1110.2.3.2-atomic-2,
        ibc:sem-ibc2021-1110.2.3.2-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.3.2-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.3.2-measurement-1,
        ibc:sem-ibc2021-1110.2.3.2-measurement-2,
        ibc:sem-ibc2021-1110.2.3.2-measurement-3 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.2 Clearance. A clearance of not less than 60 inches (1525 mm) in length adjacent to the 60-inch (1525 mm) width of the open face of the shower compartment, and not less than 30 inches (760 mm) in depth, shall be provided. Exceptions: 1. A lavatory complying with ICC A117.1, Section 606 shall be permitted at one end of the clearance. 2. Where the shower compartment exceeds minimum sizes, the clear floor space shall be placed adjacent to the grab bars and not less than 30 inches (762 mm) from the back wall." .

ibc:sem-ibc2021-1110.2.3.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.3 ;
    ibco:appliesTo ibc:concept-grab-bars ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.3-atomic-1,
        ibc:sem-ibc2021-1110.2.3.3-atomic-2,
        ibc:sem-ibc2021-1110.2.3.3-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.3.3-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-3-3-1,
        ibc:ibc2021-1110-2-3-3-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.3 Grab bars. Grab bars shall comply with ICC A117.1, Section 609 and shall be provided in accordance with Sections 1110.2.3.3.1 and 1110.2.3.3.2. In standard roll-in-type shower compartments, grab bars shall be provided on three walls. Where multiple grab bars are used, required horizontal grab bars shall be installed at the same height above the floor. Grab bars can be separate bars or one continuous bar." .

ibc:sem-ibc2021-1110.2.3.3.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.3.1 ;
    ibco:appliesTo ibc:concept-the-back-wall-grab-bar ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.3.1-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0192 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.3.3.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.3.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.3.1 Back-wall grab bar. The back-wall grab bar shall extend the length of the back wall and extend within 6 inches (150 mm) maximum from the two adjacent sidewalls." .

ibc:sem-ibc2021-1110.2.3.3.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.3.2 ;
    ibco:appliesTo ibc:concept-the-sidewall-grab-bars ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.3.2-atomic-1,
        ibc:sem-ibc2021-1110.2.3.3.2-atomic-2,
        ibc:sem-ibc2021-1110.2.3.3.2-atomic-3,
        ibc:sem-ibc2021-1110.2.3.3.2-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.3.3.2-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.3.3.2-measurement-1,
        ibc:sem-ibc2021-1110.2.3.3.2-measurement-2,
        ibc:sem-ibc2021-1110.2.3.3.2-measurement-3,
        ibc:sem-ibc2021-1110.2.3.3.2-measurement-4 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-3-3-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.3.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.3.2 Sidewall grab bars. The sidewall grab bars shall extend the length of the wall and extend within 6 inches (150 mm) of the adjacent back wall. Exceptions: 1. The sidewall grab bar shall not be required to exceed 30 inches (760 mm) in length. The side grab bar shall be located with one end within 6 inches (152 mm) of the back wall with a grab bar complying with Section 1110.2.3.3.1. 2. Where the sidewalls are located 72 inches (1830 mm) or greater apart, a grab bar is not required on one of the sidewalls." .

ibc:sem-ibc2021-1110.2.3.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.4 ;
    ibco:appliesTo ibc:concept-wall-mounted-folding-seats ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.4-atomic-1 ;
    ibco:modality "shall_not" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.4 ;
    ibco:statementType "prohibition" ;
    ibco:text "1110.2.3.4 Seats. Wall-mounted folding seats shall not be installed." .

ibc:sem-ibc2021-1110.2.3.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.5 ;
    ibco:appliesTo ibc:concept-in-standard-roll-in-type-showers-the-controls-and-hand-shower ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.5-atomic-1,
        ibc:sem-ibc2021-1110.2.3.5-atomic-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.3.5-measurement-1,
        ibc:sem-ibc2021-1110.2.3.5-measurement-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.5 Controls and hand showers. In standard roll-in-type showers, the controls and hand shower shall be located not less than 38 inches (965 mm) and not greater than 48 inches (1220 mm) above the shower floor. Controls shall be located to facilitate caregiver access." .

ibc:sem-ibc2021-1110.2.3.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.6 ;
    ibco:appliesTo ibc:concept-hand-showers ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.6-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.6 Hand showers. Hand showers shall comply with ICC A117.1, Section 608.5." .

ibc:sem-ibc2021-1110.2.3.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.7 ;
    ibco:appliesTo ibc:concept-thresholds ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.7-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.7 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.7 Thresholds. Thresholds shall comply with ICC A117.1, Section 608.6." .

ibc:sem-ibc2021-1110.2.3.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.8 ;
    ibco:appliesTo ibc:concept-shower-compartment-enclosures-for-shower-compartments ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.8-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.8 Shower enclosures. Shower compartment enclosures for shower compartments shall comply with ICC A117.1, Section 608.7." .

ibc:sem-ibc2021-1110.2.3.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.3.9 ;
    ibco:appliesTo ibc:concept-water-temperature ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.3.9-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.3.9 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.3.9 Water temperature. Water temperature shall comply with ICC A117.1, Section 608.8." .

ibc:sem-ibc2021-1110.2.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.4 ;
    ibco:appliesTo ibc:concept-bathingroom,
        ibc:concept-toiletroom ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.4-atomic-1,
        ibc:sem-ibc2021-1110.2.4-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.4-condition-1,
        ibc:sem-ibc2021-1110.2.4-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.4-measurement-1,
        ibc:sem-ibc2021-1110.2.4-measurement-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.2.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.4 Water closet compartment. Where water closet compartments are provided in a toilet room or bathing room, at least 5 percent of the total number of compartments shall be wheelchair accessible. Where the combined total water closet compartments and urinals provided in a toilet room or bathing room is six or more, at least 5 percent of the total number of compartments shall be ambulatory accessible, provided in addition to the wheelchair-accessible compartment." .

ibc:sem-ibc2021-1110.2.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.2.5 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-toiletroom ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.2.5-atomic-1,
        ibc:sem-ibc2021-1110.2.5-atomic-2,
        ibc:sem-ibc2021-1110.2.5-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.2.5-condition-1,
        ibc:sem-ibc2021-1110.2.5-condition-2,
        ibc:sem-ibc2021-1110.2.5-condition-3 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.2.5-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.2.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.2.5 Lavatories. Where lavatories are provided, at least 5 percent, but not less than one, shall be accessible. Where an accessible lavatory is located within the accessible water closet compartment at least one additional accessible lavatory shall be provided in the multicompartment toilet room outside the water closet compartment. Where the total lavatories provided in a toilet room or bathing facility is six or more, at least one lavatory with enhanced reach ranges shall be provided." .

ibc:sem-ibc2021-1110.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.3 ;
    ibco:appliesTo ibc:concept-where-sinks-are-provided-at-least-5-percent-but-not-less-than-one-provided-in-accessible-spaces ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.3-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.3-condition-1 ;
    ibco:hasException ibc:ibc2021-n0203 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.3 Sinks. Where sinks are provided, at least 5 percent but not less than one provided in accessible spaces shall be accessible." .

ibc:sem-ibc2021-1110.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.4 ;
    ibco:appliesTo ibc:concept-where-kitchens-and-kitchenettes-are-provided-in-accessible-spaces-or-rooms-they ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.4-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.4-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.4 Kitchens and kitchenettes. Where kitchens and kitchenettes are provided in accessible spaces or rooms, they shall be accessible." .

ibc:sem-ibc2021-1110.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.5 ;
    ibco:appliesTo ibc:concept-where-drinking-fountains-are-provided-on-an-exterior-site-on-a-floor-or-within-a-secured-area-the-drinking-fountains ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.5-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.5-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-5-1,
        ibc:ibc2021-1110-5-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.5 Drinking fountains. Where drinking fountains are provided on an exterior site, on a floor or within a secured area, the drinking fountains shall be provided in accordance with Sections 1110.5.1 and 1110.5.2." .

ibc:sem-ibc2021-1110.5.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.5.1 ;
    ibco:appliesTo ibc:concept-not-fewer-than-two-drinking-fountains ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.5.1-atomic-1,
        ibc:sem-ibc2021-1110.5.1-atomic-2,
        ibc:sem-ibc2021-1110.5.1-atomic-3,
        ibc:sem-ibc2021-1110.5.1-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.5.1-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.5.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.5.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.5.1 Minimum number. Not fewer than two drinking fountains shall be provided. One drinking fountain shall comply with the requirements for people who use a wheelchair and one drinking fountain shall comply with the requirements for standing persons. Exceptions: 1. A single drinking fountain with two separate spouts that complies with the requirements for people who use a wheelchair and standing persons shall be permitted to be substituted for two separate drinking fountains. 2. Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:sem-ibc2021-1110.5.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.5.2 ;
    ibco:appliesTo ibc:concept-where-more-than-the-minimum-number-of-drinking-fountains-specified-in-section-1110-5-1-is-provided-50-percent-of-the-total-number-of-drinking-fountains-provided ;
    ibco:confidence 0.65 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.5.2-atomic-1,
        ibc:sem-ibc2021-1110.5.2-atomic-2,
        ibc:sem-ibc2021-1110.5.2-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.5.2-condition-1,
        ibc:sem-ibc2021-1110.5.2-condition-2,
        ibc:sem-ibc2021-1110.5.2-condition-3,
        ibc:sem-ibc2021-1110.5.2-condition-4 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1110.5.2-measurement-1,
        ibc:sem-ibc2021-1110.5.2-measurement-2,
        ibc:sem-ibc2021-1110.5.2-measurement-3,
        ibc:sem-ibc2021-1110.5.2-measurement-4,
        ibc:sem-ibc2021-1110.5.2-measurement-5,
        ibc:sem-ibc2021-1110.5.2-measurement-6 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-5-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1110.5.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.5.2 More than the minimum number. Where more than the minimum number of drinking fountains specified in Section 1110.5.1 is provided, 50 percent of the total number of drinking fountains provided shall comply with the requirements for persons who use a wheelchair and 50 percent of the total number of drinking fountains provided shall comply with the requirements for standing persons. Exceptions: 1. Where 50 percent of the drinking fountains yields a fraction, 50 percent shall be permitted to be rounded up or down, provided that the total number of drinking fountains complying with this section equals 100 percent of the drinking fountains. 2. Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:sem-ibc2021-1110.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.6 ;
    ibco:appliesTo ibc:concept-where-bottle-filling-stations-are-provided-they ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.6-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.6-condition-1 ;
    ibco:hasException ibc:ibc2021-n0209 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.6 Bottle-filling stations. Where bottle-filling stations are provided, they shall be accessible." .

ibc:sem-ibc2021-1110.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.7 ;
    ibco:appliesTo ibc:concept-where-provided-saunas-and-steam-rooms ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.7-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.7-condition-1 ;
    ibco:hasException ibc:ibc2021-n0211 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1110.7 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.7 Saunas and steam rooms. Where provided, saunas and steam rooms shall be accessible." .

ibc:sem-ibc2021-1110.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.8 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.8-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1110.8 Elevators. Passenger elevators on an accessible route shall be accessible and comply with Chapter 30." .

ibc:sem-ibc2021-1110.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1110.9 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1110.9-atomic-1,
        ibc:sem-ibc2021-1110.9-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1110.9-condition-1 ;
    ibco:modality "may" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1110.9 ;
    ibco:statementType "permission" ;
    ibco:text "1110.9 Lifts. Platform (wheelchair) lifts are permitted to be a part of a required accessible route in new construction where indicated in Items 1 through 10. Platform (wheelchair) lifts shall be installed in accordance with ASME A18.1." .

ibc:sem-ibc2021-1111.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-2,
        ibc:ibc2021-1111-4 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1111.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.1 General. Recreational facilities shall be provided with accessible features in accordance with Sections 1111.2 through 1111.4." .

ibc:sem-ibc2021-1111.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-2-1,
        ibc:ibc2021-1111-2-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.2 Facilities serving Group R-2, R-3 and R-4 occupancies. Recreational facilities that serve Group R-2, R-3 and Group R-4 occupancies shall comply with Sections 1111.2.1 through 1111.2.3, as applicable." .

ibc:sem-ibc2021-1111.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.2.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.2.1-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.2.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.2.1 Facilities serving Accessible units. In Group R-2 and R-4 occupancies where recreational facilities serve Accessible units, every recreational facility of each type serving Accessible units shall be accessible." .

ibc:sem-ibc2021-1111.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.2.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.2.2-atomic-1,
        ibc:sem-ibc2021-1111.2.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.2.2-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.2.2-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.2.2 Facilities serving Type A and Type B units in a single building. In Group R-2, R-3 and R-4 occupancies where recreational facilities serve a single building containing Type A units or Type B units, 25 percent, but not less than one, of each type of recreational facility shall be accessible. Every recreational facility of each type on a site shall be considered to determine the total number of each type that is required to be accessible." .

ibc:sem-ibc2021-1111.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.2.3 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.2.3-atomic-1,
        ibc:sem-ibc2021-1111.2.3-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.2.3-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.2.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.2.3 Facilities serving Type A and Type B units in multiple buildings. In Group R-2, R-3 and R-4 occupancies on a single site where multiple buildings containing Type A units or Type B units are served by recreational facilities, 25 percent, but not less than one, of each type of recreational facility serving each building shall be accessible. The total number of each type of recreational facility that is required to be accessible shall be determined by considering every recreational facility of each type serving each building on the site." .

ibc:sem-ibc2021-1111.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.3 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.3 Other occupancies. Recreational facilities not falling within the purview of Section 1111.2 shall be accessible." .

ibc:sem-ibc2021-1111.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4 Recreational facilities. Recreational facilities shall be accessible and shall be on an accessible route to the extent specified in this section." .

ibc:sem-ibc2021-1111.4.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.1 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-15,
        ibc:ibc2021-1111-4-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.1 Area of sport activity. Each area of sport activity shall be on an accessible route and shall not be required to be accessible except as provided for in Sections 1111.4.2 through 1111.4.15." .

ibc:sem-ibc2021-1111.4.10 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.10 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.10-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.10 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.10 Exercise machines and equipment. At least one of each type of exercise machine and equipment shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.11 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.11 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.11-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.11 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.11 Fishing piers and platforms. Fishing piers and platforms shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.12 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.12 ;
    ibco:appliesTo ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.12-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-12-1,
        ibc:ibc2021-1111-4-12-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.12 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.12 Miniature golf facilities. Miniature golf facilities shall comply with Sections 1111.4.12.1 through 1111.4.12.3." .

ibc:sem-ibc2021-1111.4.12.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.12.1 ;
    ibco:appliesTo ibc:concept-at-least-50-percent-of-holes-on-miniature-golf-courses ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.12.1-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.12.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.12.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.12.1 Minimum number. At least 50 percent of holes on miniature golf courses shall be accessible." .

ibc:sem-ibc2021-1111.4.12.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.12.2 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.12.2-atomic-1,
        ibc:sem-ibc2021-1111.4.12.2-atomic-2 ;
    ibco:hasException ibc:ibc2021-n0276 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.12.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.12.2 Miniature golf course configuration. Miniature golf courses shall be configured so that the accessible holes are consecutive. Miniature golf courses shall provide an accessible route from the last accessible hole to the course entrance or exit without requiring travel through any other holes on the course." .

ibc:sem-ibc2021-1111.4.12.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.12.3 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.12.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-12-1 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.12.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.12.3 Accessible route. Holes required to comply with Section 1111.4.12.1, including the start of play, shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.13 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.13 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.13-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.13 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.13 Play areas. Play areas containing play components designed and constructed for children shall be located on an accessible route." .

ibc:sem-ibc2021-1111.4.14 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.14 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.14-atomic-1,
        ibc:sem-ibc2021-1111.4.14-atomic-2,
        ibc:sem-ibc2021-1111.4.14-atomic-3,
        ibc:sem-ibc2021-1111.4.14-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.14-condition-1,
        ibc:sem-ibc2021-1111.4.14-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.14-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-2-2,
        ibc:ibc2021-1111-2-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.14 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.14 Swimming pools, wading pools, cold baths, hot tubs and spas. Swimming pools, wading pools, cold baths, hot tubs and spas shall be accessible and be on an accessible route. Exceptions: 1. Catch pools or a designated section of a pool used as a terminus for a water slide flume shall not be required to provide an accessible means of entry, provided that a portion of the catch pool edge is on an accessible route. 2. Where spas, cold baths or hot tubs are provided in a cluster, at least 5 percent, but not less than one of each type of spa, cold bath or hot tub in each cluster, shall be accessible and be on an accessible route. 3. Swimming pools, wading pools, spas, cold baths and hot tubs that are required to be accessible by Sections 1111.2.2 and 1111.2.3 are not required to provide accessible means of entry into the water." .

ibc:sem-ibc2021-1111.4.14.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.14.1 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.14.1-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.14.1 ;
    ibco:statementType "exemption" ;
    ibco:text "1111.4.14.1 Raised diving boards and diving platforms. Raised diving boards and diving platforms are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.14.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.14.2 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.14.2-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.14.2 ;
    ibco:statementType "exemption" ;
    ibco:text "1111.4.14.2 Water slides. Water slides are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.15 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.15 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.15-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.15-condition-1 ;
    ibco:hasException ibc:ibc2021-n0283 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.15-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.15 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.15 Shooting facilities with firing positions. Where shooting facilities with firing positions are designed and constructed at a site, at least 5 percent, but not less than one, of each type of firing position shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.2 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.2-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0255 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.2 Team or player seating. At least one wheelchair space shall be provided in team or player seating areas serving areas of sport activity." .

ibc:sem-ibc2021-1111.4.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.3 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.3-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.3 Bowling lanes. An accessible route shall be provided to at least 5 percent, but not less than one, of each type of bowling lane." .

ibc:sem-ibc2021-1111.4.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.4 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.4-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.4 Court sports. In court sports, at least one accessible route shall directly connect both sides of the court." .

ibc:sem-ibc2021-1111.4.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.5 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.5-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.5 ;
    ibco:statementType "exemption" ;
    ibco:text "1111.4.5 Raised boxing or wrestling rings. Raised boxing or wrestling rings are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.6 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.6-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.6 ;
    ibco:statementType "exemption" ;
    ibco:text "1111.4.6 Raised refereeing, judging and scoring areas. Raised structures used solely for refereeing, judging or scoring a sport are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.7 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.7 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.7-atomic-1 ;
    ibco:modality "not_required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.7 ;
    ibco:statementType "exemption" ;
    ibco:text "1111.4.7 Animal containment areas. Animal containment areas that are not within public use areas are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.8 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.8 ;
    ibco:appliesTo ibc:concept-amusement-rides-that-move-persons-through-a-fixed-course-within-a-defined-area ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.8-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0262 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-8-1,
        ibc:ibc2021-1111-4-8-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.8 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.8 Amusement rides. Amusement rides that move persons through a fixed course within a defined area shall comply with Sections 1111.4.8.1 through 1111.4.8.3." .

ibc:sem-ibc2021-1111.4.8.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.8.1 ;
    ibco:appliesTo ibc:concept-accessibleroute ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.8.1-atomic-1,
        ibc:sem-ibc2021-1111.4.8.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.8.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.8.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.8.1 Load and unload areas. Load and unload areas serving amusement rides shall be accessible and be on an accessible route. Where load and unload areas have more than one loading or unloading position, at least one loading and unloading position shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.8.2 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-wheelchairspace ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.8.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.8.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.8.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.8.2 Wheelchair spaces, ride seats designed for transfer and transfer devices. Where amusement rides are in the load and unload position, the following shall be on an accessible route. 1. The position serving a wheelchair space. 2. Amusement ride seats designed for transfer. 3. Transfer devices." .

ibc:sem-ibc2021-1111.4.8.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.8.3 ;
    ibco:appliesTo ibc:concept-wheelchairspace ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.8.3-atomic-1,
        ibc:sem-ibc2021-1111.4.8.3-atomic-2,
        ibc:sem-ibc2021-1111.4.8.3-atomic-3,
        ibc:sem-ibc2021-1111.4.8.3-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.8.3-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.8.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.8.3 Minimum number. Amusement rides shall provide at least one wheelchair space, amusement ride seat designed for transfer or transfer device. Exceptions: 1. Amusement rides that are controlled or operated by the rider are not required to comply with this section. 2. Amusement rides designed primarily for children, where children are assisted on and off the ride by an adult, are not required to comply with this section. 3. Amusement rides that do not provide seats that are built-in or mechanically fastened shall not be required to comply with this section." .

ibc:sem-ibc2021-1111.4.9 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.9 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-buildingorfacility ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.9-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-9-1,
        ibc:ibc2021-1111-4-9-2,
        ibc:ibc2021-1111-4-9-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-1111.4.9 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.9 Recreational boating facilities. Boat slips required to be accessible by Sections 1111.4.9.1 and 1111.4.9.2 and boarding piers at boat launch ramps required to be accessible by Section 1111.4.9.3 shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.9.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.9.1 ;
    ibco:appliesTo ibc:concept-accessible-boat-slips ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.9.1-atomic-1,
        ibc:sem-ibc2021-1111.4.9.1-atomic-2,
        ibc:sem-ibc2021-1111.4.9.1-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.9.1-condition-1 ;
    ibco:hasException ibc:ibc2021-n0268 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.9.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1111-4-9-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.9.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.9.1 Boat slips. Accessible boat slips shall be provided in accordance with Table 1111.4.9.1. All units on the site shall be combined to determine the number of accessible boat slips required. Where the number of boat slips is not identified, each 40 feet (12 m) of boat slip edge provided along the perimeter of the pier shall be counted as one boat slip for the purpose of this section." .

ibc:sem-ibc2021-1111.4.9.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.9.2 ;
    ibco:appliesTo ibc:concept-accessible-boat-slips ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.9.2-atomic-1,
        ibc:sem-ibc2021-1111.4.9.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.9.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.9.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.9.2 Dispersion. Accessible boat slips shall be dispersed throughout the various types of boat slips provided. Where the minimum number of accessible boat slips has been met, further dispersion shall not be required." .

ibc:sem-ibc2021-1111.4.9.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1111.4.9.3 ;
    ibco:appliesTo ibc:concept-where-boarding-piers-are-provided-at-boat-launch-ramps-at-least-5-percent-but-not-less-than-one-of-the-boarding-piers ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1111.4.9.3-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1111.4.9.3-condition-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1111.4.9.3-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1111.4.9.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1111.4.9.3 Boarding piers at boat launch ramps. Where boarding piers are provided at boat launch ramps, at least 5 percent, but not less than one, of the boarding piers shall be accessible." .

ibc:sem-ibc2021-1112.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.1 ;
    ibco:appliesTo ibc:concept-signage ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1112.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.1 Signs. Required accessible elements shall be identified by the International Symbol of Accessibility at the following locations." .

ibc:sem-ibc2021-1112.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.2 ;
    ibco:appliesTo ibc:concept-bathingroom,
        ibc:concept-signage,
        ibc:concept-toiletroom ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.2-atomic-1,
        ibc:sem-ibc2021-1112.2-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1112.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1112.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.2 Signs identifying toilet or bathing rooms. Signs required in Section 403.4 of the International Plumbing Code identifying toilet rooms and bathing rooms shall be visual characters, raised characters and braille complying with ICC A117.1. Where pictograms are provided as designations for toilet rooms and bathing rooms, the pictograms shall have visual characters, raised characters and braille complying with ICC A117.1." .

ibc:sem-ibc2021-1112.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.3 ;
    ibco:appliesTo ibc:concept-accessibleroute,
        ibc:concept-bathingroom,
        ibc:concept-buildingorfacility,
        ibc:concept-signage ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.3-atomic-1,
        ibc:sem-ibc2021-1112.3-atomic-2,
        ibc:sem-ibc2021-1112.3-atomic-3,
        ibc:sem-ibc2021-1112.3-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1112.3-condition-1,
        ibc:sem-ibc2021-1112.3-condition-2 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1009-10,
        ibc:ibc2021-1110-2-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1112.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.3 Directional signage. Directional signage indicating the route to the nearest like accessible element shall be provided at the following locations. These directional signs shall include the International Symbol of Accessibility and sign characters shall meet the visual character requirements in accordance with ICC A117.1. 1. Inaccessible building entrances. 2. Inaccessible public toilets and bathing facilities. 3. Elevators not serving an accessible route. 4. At each separate-sex toilet and bathing room indicating the location of the nearest family/assisted use toilet or bathing room where provided in accordance with Section 1110.2.1. 5. At exits and exit stairways serving a required accessible space, but not providing an approved accessible means of egress, signage shall be provided in accordance with Section 1009.10. 6. Where drinking fountains for persons using wheelchairs and drinking fountains for standing persons are not located adjacent to each other, directional signage shall be provided indicating the location of the other drinking fountains." .

ibc:sem-ibc2021-1112.4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.4 ;
    ibco:appliesTo ibc:concept-assistivelisteningsystem,
        ibc:concept-signage ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.4-atomic-1,
        ibc:sem-ibc2021-1112.4-atomic-2,
        ibc:sem-ibc2021-1112.4-atomic-3 ;
    ibco:hasException ibc:ibc2021-n0301 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1109-2-7 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1112.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.4 Other signs. Signage indicating special accessibility provisions shall be provided as shown. 1. Each assembly area required to comply with Section 1109.2.7 shall provide a sign notifying patrons of the availability of assistive listening systems. The sign shall comply with ICC A117.1 requirements for visual characters and include the International Symbol of Access for Hearing Loss." .

ibc:sem-ibc2021-1112.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.5 ;
    ibco:appliesTo ibc:concept-signage ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.5-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1112.5-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1112-5-1,
        ibc:ibc2021-1112-5-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1112.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.5 Variable message signs. Where provided in the locations in Sections 1112.5.1 and 1112.5.2, variable message signs shall comply with the variable message sign requirements of ICC A117.1." .

ibc:sem-ibc2021-1112.5.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.5.1 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-signage ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.5.1-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1112.5.1-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1112-5 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1112.5.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.5.1 Transportation facilities. Where provided in transportation facilities, variable message signs conveying transportation-related information shall comply with Section 1112.5." .

ibc:sem-ibc2021-1112.5.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1112.5.2 ;
    ibco:appliesTo ibc:concept-buildingorfacility,
        ibc:concept-signage ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1112.5.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1112.5.2-condition-1 ;
    ibco:hasException ibc:ibc2021-n0305 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1112-5 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1112.5.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1112.5.2 Emergency shelters. Where provided in buildings that are designated as emergency shelters, variable message signs conveying emergency-related information shall comply with Section 1112.5." .

ibc:sem-ibc2021-2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-2 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-2-atomic-1,
        ibc:sem-ibc2021-2-atomic-2,
        ibc:sem-ibc2021-2-atomic-3,
        ibc:sem-ibc2021-2-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-2-condition-1,
        ibc:sem-ibc2021-2-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-2-measurement-1,
        ibc:sem-ibc2021-2-measurement-2,
        ibc:sem-ibc2021-2-measurement-3 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-2,
        ibc:ibc2021-1110-2-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-2 ;
    ibco:statementType "obligation" ;
    ibco:text "2. In Group I-1, Condition 2, at least 10 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units. Accessible dwelling units and sleeping units shall be dispersed among the various classes of units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of the Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 50 percent of the Accessible units." .

ibc:sem-ibc2021-2-0215 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-2-0215 ;
    ibco:confidence 0.81 ;
    ibco:modality "unspecified" ;
    ibco:references ibc:ibc2021-1109-2-2,
        ibc:ibc2021-1109-2-6 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "topological" ;
    ibco:sourceNode ibc:ibc2021-2-0215 ;
    ibco:statementType "declarative" ;
    ibco:text "2. An accessible route to wheelchair spaces required to comply with the wheelchair space dispersion requirements of Sections 1109.2.2 through 1109.2.6." .

ibc:sem-ibc2021-2-0288 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-2-0288 ;
    ibco:confidence 0.81 ;
    ibco:hasException ibc:ibc2021-n0289 ;
    ibco:modality "unspecified" ;
    ibco:references ibc:ibc2021-1106-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-2-0288 ;
    ibco:statementType "declarative" ;
    ibco:text "2. Accessible parking spaces required by Section 1106.3." .

ibc:sem-ibc2021-3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-3 ;
    ibco:confidence 0.81 ;
    ibco:modality "unspecified" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-3 ;
    ibco:statementType "declarative" ;
    ibco:text "3. An accessible route to spaces that are not open to the general public with an occupant load of not more than five." .

ibc:sem-ibc2021-3-0290 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-3-0290 ;
    ibco:confidence 0.81 ;
    ibco:modality "unspecified" ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-3-0290 ;
    ibco:statementType "declarative" ;
    ibco:text "3. Accessible passenger loading zones." .

ibc:sem-ibc2021-4 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-4 ;
    ibco:confidence 0.81 ;
