    ibco:sourceNode ibc:ibc2021-1108.6.2.3.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.3.1 Accessible units. Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1." .

ibc:sem-ibc2021-1108.6.2.3.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.3.2 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.3.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.2.3.2-condition-1 ;
    ibco:hasException ibc:ibc2021-n0114 ;
