    ibco:sourceNode ibc:ibc2021-1107.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1107.1 General. Electrical vehicle charging stations shall comply with Section 1107.2. Fuel-dispensing systems shall comply with Section 1107.3." .

ibc:sem-ibc2021-1107.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1107.2 ;
