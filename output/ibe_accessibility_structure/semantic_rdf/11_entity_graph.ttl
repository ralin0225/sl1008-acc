    rdfs:label "Water temperature" .

ibc:concept-where-boarding-piers-are-provided-at-boat-launch-ramps-at-least-5-percent-but-not-less-than-one-of-the-boarding-piers a ibco:DomainConcept ;
    rdfs:label "Where boarding piers are provided at boat launch ramps, at least 5 percent, but not less than one, of the boarding piers" .

ibc:concept-where-bottle-filling-stations-are-provided-they a ibco:DomainConcept ;
    rdfs:label "Where bottle-filling stations are provided, they" .

ibc:concept-where-dressing-rooms-fitting-rooms-or-locker-rooms-are-provided-at-least-5-percent-but-not-less-than-one-of-each-type-of-use-in-each-cluster-provided a ibco:DomainConcept ;
    rdfs:label "Where dressing rooms, fitting rooms or locker rooms are provided, at least 5 percent, but not less than one, of each type of use in each cluster provided" .

ibc:concept-where-drinking-fountains-are-provided-on-an-exterior-site-on-a-floor-or-within-a-secured-area-the-drinking-fountains a ibco:DomainConcept ;
    rdfs:label "Where drinking fountains are provided on an exterior site, on a floor or within a secured area, the drinking fountains" .

ibc:concept-where-fixed-or-built-in-storage-elements-such-as-cabinets-coat-hooks-shelves-medicine-cabinets-lockers-closets-and-drawers-are-provided-in-required-accessible-spaces-at-least-5-percent-but-not-less-than-one-of-each-type a ibco:DomainConcept ;
    rdfs:label "Where fixed or built-in storage elements such as cabinets, coat hooks, shelves, medicine cabinets, lockers, closets and drawers are provided in required accessible spaces, at least 5 percent, but not less than one of each type" .

ibc:concept-where-kitchens-and-kitchenettes-are-provided-in-accessible-spaces-or-rooms-they a ibco:DomainConcept ;
    rdfs:label "Where kitchens and kitchenettes are provided in accessible spaces or rooms, they" .

ibc:concept-where-more-than-the-minimum-number-of-drinking-fountains-specified-in-section-1110-5-1-is-provided-50-percent-of-the-total-number-of-drinking-fountains-provided a ibco:DomainConcept ;
    rdfs:label "Where more than the minimum number of drinking fountains specified in Section 1110.5.1 is provided, 50 percent of the total number of drinking fountains provided" .

ibc:concept-where-provided-saunas-and-steam-rooms a ibco:DomainConcept ;
    rdfs:label "Where provided, saunas and steam rooms" .

ibc:concept-where-seating-or-standing-space-at-fixed-or-built-in-tables-counters-or-work-surfaces-is-provided-in-accessible-spaces-at-least-5-percent-of-the-seating-and-standing-spaces-but-not-less-than-one a ibco:DomainConcept ;
    rdfs:label "Where seating or standing space at fixed or built-in tables, counters or work surfaces is provided in accessible spaces, at least 5 percent of the seating and standing spaces, but not less than one" .

ibc:concept-where-separate-central-holding-cells-are-provided-for-adult-males-juvenile-males-adult-females-or-juvenile-females-one-of-each-type a ibco:DomainConcept ;
    rdfs:label "Where separate central holding cells are provided for adult males, juvenile males, adult females or juvenile females, one of each type" .

ibc:concept-where-separate-court-floor-holding-cells-are-provided-for-adult-males-juvenile-males-adult-females-or-juvenile-females-each-courtroom a ibco:DomainConcept ;
    rdfs:label "Where separate court-floor holding cells are provided for adult males, juvenile males, adult females or juvenile females, each courtroom" .

ibc:concept-where-sinks-are-provided-at-least-5-percent-but-not-less-than-one-provided-in-accessible-spaces a ibco:DomainConcept ;
    rdfs:label "Where sinks are provided, at least 5 percent but not less than one provided in accessible spaces" .

ibc:concept-where-solid-partitions-or-security-glazing-separate-visitors-from-detainees-at-least-one-of-each-type-of-cubicle-or-counter-partition a ibco:DomainConcept ;
    rdfs:label "Where solid partitions or security glazing separate visitors from detainees, at least one of each type of cubicle or counter partition" .

ibc:concept-where-stadiums-arenas-and-grandstands-have-15-000-fixed-seats-or-more-and-provide-audible-public-announcements-they a ibco:DomainConcept ;
    rdfs:label "Where stadiums, arenas and grandstands have 15,000 fixed seats or more and provide audible public announcements, they" .

ibc:sem-ibc2021-10-0297-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "In recreational facilities, lockers that are required to be accessible in accordance with Section 1110.10." .

ibc:sem-ibc2021-10-condition-1 a ibco:Condition ;
    ibco:text "where existing exterior site constraints make use of a ramp or elevator infeasible." .

ibc:sem-ibc2021-1101.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The provisions of this chapter shall control the design and construction of facilities for accessibility for individuals with disabilities." .

ibc:sem-ibc2021-1102.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Buildings and facilities shall be designed and constructed to be accessible in accordance with this code and ICC A117.1." .

ibc:sem-ibc2021-1103.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Sites, buildings, structures, facilities, elements and spaces, temporary or permanent, shall be accessible to individuals with disabilities." .

ibc:sem-ibc2021-1103.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Sites, buildings, structures, facilities, elements and spaces shall be exempt from this chapter to the extent specified in this section." .

ibc:sem-ibc2021-1103.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Accessibility is not required in buildings and facilities, or portions thereof, to the extent permitted by Sections 1104 through 1112." .

ibc:sem-ibc2021-1103.2.10-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Highway tollbooths where the access is provided only by bridges above the vehicular traffic or underground tunnels are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.10-condition-1 a ibco:Condition ;
    ibco:text "where the access is provided only by bridges above the vehicular traffic or underground tunnels are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.11-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Buildings of Group R-1 containing not more than five sleeping units for rent or hire that are also occupied as the residence of the proprietor are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.12-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "Where a day care facility is part of a dwelling unit, only the portion of the structure utilized for the day care facility is required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.12-condition-1 a ibco:Condition ;
    ibco:text "Where a day care facility is part of a dwelling unit, only the portion of the structure utilized for the day care facility is required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.13-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "In detention and correctional facilities, common use areas that are used only by inmates or detainees and security personnel, and that do not serve holding cells or housing cells required to be Accessible units, are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.14-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Walk-in cooler and freezer equipment accessed only from employee work areas is not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Spaces and elements within employee work areas shall only be required to comply with Sections 907.5.2.3.1, 1009 and 1104.3.1 and shall be designed and constructed so that individuals with disabilities can approach, enter and exit the work area." .

ibc:sem-ibc2021-1103.2.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Work areas, or portions of work areas, other than raised courtroom stations in accordance with Section 1109.4.1.4, that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the ground or finished floor where the change in elevation is essential to the function of the space shall be exempt from all requirements." .

ibc:sem-ibc2021-1103.2.2-condition-1 a ibco:Condition ;
    ibco:text "where the change in elevation is essential to the function of the space shall be exempt from all requirements." .

ibc:sem-ibc2021-1103.2.2-condition-2 a ibco:Condition ;
    ibco:text "other than raised courtroom stations in accordance with Section 1109." .

ibc:sem-ibc2021-1103.2.2-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than" ;
    ibco:unitCode "FT2" ;
    ibco:value 300.0 .

ibc:sem-ibc2021-1103.2.2-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 7.0 .

ibc:sem-ibc2021-1103.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Detached one- and twofamily dwellings, their accessory structures and their associated sites and facilities are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Group U occupancies are not required to comply with this chapter other than the following: 1." .

ibc:sem-ibc2021-1103.2.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "In agricultural buildings, access is required to paved work areas and areas open to the general public." .

ibc:sem-ibc2021-1103.2.4-condition-1 a ibco:Condition ;
    ibco:text "other than the following: 1." .

ibc:sem-ibc2021-1103.2.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Structures, sites and equipment directly associated with the actual processes of construction including, but not limited to, scaffolding, bridging, materials hoists, materials storage or construction trailers are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Spaces accessed only by ladders, catwalks, crawl spaces, freight elevators or very narrow passageways are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Raised or lowered areas, or portions of areas, in places of religious worship that are less than 300 square feet (30 m2) in area and located 7 inches (178 mm) or more above or below the finished floor and used primarily for the performance of religious ceremonies are not required to comply with this chapter." .

ibc:sem-ibc2021-1103.2.8-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than" ;
    ibco:unitCode "FT2" ;
    ibco:value 300.0 .

ibc:sem-ibc2021-1103.2.8-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 7.0 .

ibc:sem-ibc2021-1103.2.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Spaces frequented only by service personnel for maintenance, repair or occasional monitoring of equipment are not required to comply with this chapter." .

ibc:sem-ibc2021-1104.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one accessible route within the site shall be provided from public transportation stops, accessible parking, accessible passenger loading zones, and public streets or sidewalks to the accessible building entrance served." .

ibc:sem-ibc2021-1104.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one accessible route shall connect accessible buildings, accessible facilities, accessible elements and accessible spaces that are on the same site." .

ibc:sem-ibc2021-1104.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route is not required between accessible buildings, accessible facilities, accessible elements and accessible spaces that have, as the only means of access between them, a vehicular way not providing for pedestrian access." .

ibc:sem-ibc2021-1104.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:sem-ibc2021-1104.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "Where a building or portion of a building is required to be accessible, at least one accessible route shall be provided to each portion of the building, to accessible building entrances connecting accessible pedestrian walkways and to the public way." .

ibc:sem-ibc2021-1104.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Stories and mezzanines exempted by Section 1104.4." .

ibc:sem-ibc2021-1104.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "In a building, room or space used for assembly purposes with fixed seating, an accessible route shall not be required to serve levels where wheelchair spaces are not provided." .

ibc:sem-ibc2021-1104.3-atomic-4 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Vertical access to elevated employee work stations within a courtroom complying with Section 1109.4.1.4." .

ibc:sem-ibc2021-1104.3-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route to recreational facilities shall only be required to the extent specified in Section 1111." .

ibc:sem-ibc2021-1104.3-condition-1 a ibco:Condition ;
    ibco:text "Where a building or portion of a building is required to be accessible, at least one accessible route shall be provided to each portion of the building, to accessible building entrances connecting accessible pedestrian walkways and to the public way." .

ibc:sem-ibc2021-1104.3-condition-2 a ibco:Condition ;
    ibco:text "where wheelchair spaces are not provided." .

ibc:sem-ibc2021-1104.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Common use circulation paths within employee work areas shall be accessible routes." .

ibc:sem-ibc2021-1104.3.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Common use circulation paths, located within employee work areas that are less than 1,000 square feet (93 m2) in size and defined by permanently installed partitions, counters, casework or furnishings, shall not be required to be accessible routes." .

ibc:sem-ibc2021-1104.3.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Common use circulation paths, located within employee work areas, that are an integral component of equipment, shall not be required to be accessible routes." .

ibc:sem-ibc2021-1104.3.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Common use circulation paths, located within exterior employee work areas that are fully exposed to the weather, shall not be required to be accessible routes." .

ibc:sem-ibc2021-1104.3.1-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than" ;
    ibco:unitCode "FT2" ;
    ibco:value 0.0 .

ibc:sem-ibc2021-1104.3.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Press boxes in a building, room or space used for assembly purposes shall be on an accessible route." .

ibc:sem-ibc2021-1104.3.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route shall not be required to press boxes in bleachers that have a single point of entry from the bleachers, provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:sem-ibc2021-1104.3.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route shall not be required to free-standing press boxes that are more than 12 feet (3660 mm) above grade provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:sem-ibc2021-1104.3.2-condition-1 a ibco:Condition ;
    ibco:text "provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:sem-ibc2021-1104.3.2-condition-2 a ibco:Condition ;
    ibco:text "provided that the aggregate area of all press boxes for each playing field is not more than 500 square feet (46 m2)." .

ibc:sem-ibc2021-1104.3.2-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "FT2" ;
    ibco:value 500.0 .

ibc:sem-ibc2021-1104.3.2-measurement-2 a ibco:Measurement ;
    ibco:operator "greater_than" ;
    ibco:unitCode "FT" ;
    ibco:value 12.0 .

ibc:sem-ibc2021-1104.3.2-measurement-3 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "FT2" ;
    ibco:value 500.0 .

ibc:sem-ibc2021-1104.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one accessible route shall connect each accessible story, mezzanine and occupied roofs in multilevel buildings and facilities." .

ibc:sem-ibc2021-1104.4-atomic-10 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In air traffic control towers, an accessible route is not required to serve the cab and the floor immediately below the cab." .

ibc:sem-ibc2021-1104.4-atomic-11 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Where a two-story building or facility has one story or mezzanine with an occupant load of five or fewer persons that does not contain public use space, that story or mezzanine shall not be required to be connected by an accessible route to the story above or below." .

ibc:sem-ibc2021-1104.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route is not required to stories, mezzanines and occupied roofs that have an aggregate area of not more than 3,000 square feet (278.7 m2) and are located above and below accessible levels." .

ibc:sem-ibc2021-1104.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "This exception shall not apply to: 1.1." .

ibc:sem-ibc2021-1104.4-atomic-4 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Multiple tenant facilities of Group M occupancies containing five or more tenant spaces used for the sales or rental of goods and where at least one such tenant space is located on a floor level above or below the accessible levels." .

ibc:sem-ibc2021-1104.4-atomic-5 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Stories or mezzanines containing offices of health care providers (Group B or I)." .

ibc:sem-ibc2021-1104.4-atomic-6 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Passenger transportation facilities and airports (Group A-3 or B)." .

ibc:sem-ibc2021-1104.4-atomic-7 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Government buildings." .

ibc:sem-ibc2021-1104.4-atomic-8 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Structures with four or more dwelling units." .

ibc:sem-ibc2021-1104.4-atomic-9 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Stories, mezzanines or occupied roofs that do not contain accessible elements or other spaces as determined by Section 1108 or 1109 are not required to be served by an accessible route from an accessible level." .

ibc:sem-ibc2021-1104.4-condition-1 a ibco:Condition ;
    ibco:text "where at least one such tenant space is located on a floor level above or below the accessible levels." .

ibc:sem-ibc2021-1104.4-condition-2 a ibco:Condition ;
    ibco:text "Where a two-story building or facility has one story or mezzanine with an occupant load of five or fewer persons that does not contain public use space, that story or mezzanine shall not be required to be connected by an accessible route to the story above or below." .

ibc:sem-ibc2021-1104.4-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "FT2" ;
    ibco:value 0.0 .

ibc:sem-ibc2021-1104.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible routes shall coincide with or be located in the same area as a general circulation path." .

ibc:sem-ibc2021-1104.5-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the circulation path is interior, the accessible route shall be interior." .

ibc:sem-ibc2021-1104.5-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Where only one accessible route is provided, the accessible route shall not pass through kitchens, storage rooms, restrooms, closets or similar spaces." .

ibc:sem-ibc2021-1104.5-atomic-4 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Accessible routes from parking garages contained within and serving Type B units are not required to be interior." .

ibc:sem-ibc2021-1104.5-atomic-5 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "A single accessible route is permitted to pass through a kitchen or storage room in an Accessible unit, Type A unit or Type B unit." .

ibc:sem-ibc2021-1104.5-condition-1 a ibco:Condition ;
    ibco:text "Where the circulation path is interior, the accessible route shall be interior." .

ibc:sem-ibc2021-1104.5-condition-2 a ibco:Condition ;
    ibco:text "Where only one accessible route is provided, the accessible route shall not pass through kitchens, storage rooms, restrooms, closets or similar spaces." .

ibc:sem-ibc2021-1104.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Security barriers including, but not limited to, security bollards and security check points shall not obstruct a required accessible route or accessible means of egress." .

ibc:sem-ibc2021-1105.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In addition to accessible entrances required by Sections 1105.1.2 through 1105.1.8, at least 60 percent of all public entrances shall be accessible." .

ibc:sem-ibc2021-1105.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible entrance is not required to areas not required to be accessible." .

ibc:sem-ibc2021-1105.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Loading and service entrances that are not the only entrance to a tenant space." .

ibc:sem-ibc2021-1105.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 60.0 .

ibc:sem-ibc2021-1105.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "In facilities with the occupancies and building occupant loads indicated in Table 1105.1.1, public entrances that are required to be accessible shall have one door be either a full power-operated door or a low-energy power-operated door." .

ibc:sem-ibc2021-1105.1.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the public entrance includes a vestibule, at least one door into and one door out of the vestibule shall meet the requirements of this section." .

ibc:sem-ibc2021-1105.1.1-condition-1 a ibco:Condition ;
    ibco:text "Where the public entrance includes a vestibule, at least one door into and one door out of the vestibule shall meet the requirements of this section." .

ibc:sem-ibc2021-1105.1.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where provided, direct access for pedestrians from parking structures to buildings or facility entrances shall be accessible." .

ibc:sem-ibc2021-1105.1.2-condition-1 a ibco:Condition ;
    ibco:text "Where provided, direct access for pedestrians from parking structures to buildings or facility entrances shall be accessible." .

ibc:sem-ibc2021-1105.1.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where direct access is provided for pedestrians from a pedestrian tunnel or elevated walkway to a building or facility, at least one entrance to the building or facility from each tunnel or walkway shall be accessible." .

ibc:sem-ibc2021-1105.1.3-condition-1 a ibco:Condition ;
    ibco:text "Where direct access is provided for pedestrians from a pedestrian tunnel or elevated walkway to a building or facility, at least one entrance to the building or facility from each tunnel or walkway shall be accessible." .

ibc:sem-ibc2021-1105.1.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where restricted entrances are provided to a building or facility, at least one restricted entrance to the building or facility shall be accessible." .

ibc:sem-ibc2021-1105.1.4-condition-1 a ibco:Condition ;
    ibco:text "Where restricted entrances are provided to a building or facility, at least one restricted entrance to the building or facility shall be accessible." .

ibc:sem-ibc2021-1105.1.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where entrances used only by inmates or detainees and security personnel are provided at judicial facilities, detention facilities or correctional facilities, at least one such entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.5-condition-1 a ibco:Condition ;
    ibco:text "Where entrances used only by inmates or detainees and security personnel are provided at judicial facilities, detention facilities or correctional facilities, at least one such entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "If a service entrance is the only entrance to a building or a tenant space in a facility, that entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.6-condition-1 a ibco:Condition ;
    ibco:text "If a service entrance is the only entrance to a building or a tenant space in a facility, that entrance shall be accessible." .

ibc:sem-ibc2021-1105.1.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one accessible entrance shall be provided to each tenant in a facility." .

ibc:sem-ibc2021-1105.1.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one accessible entrance shall be provided to each dwelling unit and sleeping unit in a facility." .

ibc:sem-ibc2021-1106.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Parking shall comply with Sections 1106.2 through 1106.8." .

ibc:sem-ibc2021-1106.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Passenger loading zones shall comply with Section 1106.9." .

ibc:sem-ibc2021-1106.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where parking is provided, accessible parking spaces shall be provided in compliance with Table 1106.2, except as required by Sections 1106.3 through 1106.5." .

ibc:sem-ibc2021-1106.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where more than one parking facility is provided on a site, the number of parking spaces required to be accessible shall be calculated separately for each parking facility." .

ibc:sem-ibc2021-1106.2-condition-1 a ibco:Condition ;
    ibco:text "Where parking is provided, accessible parking spaces shall be provided in compliance with Table 1106." .

ibc:sem-ibc2021-1106.2-condition-2 a ibco:Condition ;
    ibco:text "Where more than one parking facility is provided on a site, the number of parking spaces required to be accessible shall be calculated separately for each parking facility." .

ibc:sem-ibc2021-1106.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible parking spaces shall be provided in Group I-1, R-1, R-2, R-3 and R-4 occupancies in accordance with Items 1 through 4 as applicable." .

ibc:sem-ibc2021-1106.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2, R-3 and R-4 occupancies that are required to have Accessible, Type A or Type B dwelling units or sleeping units, at least 2 percent, but not less than one, of each type of parking space provided shall be accessible." .

ibc:sem-ibc2021-1106.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group I-1 and R-1 occupancies, accessible parking shall be provided in accordance with Table 1106.2." .

ibc:sem-ibc2021-1106.3-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where at least one parking space is provided for each dwelling unit or sleeping unit, at least one accessible parking space shall be provided for each Accessible and Type A unit." .

ibc:sem-ibc2021-1106.3-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where parking is provided within or beneath a building, accessible parking spaces shall be provided within or beneath the building." .

ibc:sem-ibc2021-1106.3-condition-1 a ibco:Condition ;
    ibco:text "Where at least one parking space is provided for each dwelling unit or sleeping unit, at least one accessible parking space shall be provided for each Accessible and Type A unit." .

ibc:sem-ibc2021-1106.3-condition-2 a ibco:Condition ;
    ibco:text "Where parking is provided within or beneath a building, accessible parking spaces shall be provided within or beneath the building." .

ibc:sem-ibc2021-1106.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 2.0 .

ibc:sem-ibc2021-1106.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 10 percent, but not less than one, of care recipient and visitor parking spaces provided to serve hospital outpatient facilities shall be accessible." .

ibc:sem-ibc2021-1106.4-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1106.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 20 percent, but not less than one, of the portion of care recipient and visitor parking spaces serving rehabilitation facilities specializing in treating conditions that affect mobility and outpatient physical therapy facilities shall be accessible." .

ibc:sem-ibc2021-1106.5-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 20.0 .

ibc:sem-ibc2021-1106.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "For every six or fraction of six accessible parking spaces, at least one shall be a van-accessible parking space." .

ibc:sem-ibc2021-1106.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible parking spaces shall be located on the shortest accessible route of travel from adjacent parking to an accessible building entrance." .

ibc:sem-ibc2021-1106.7-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In parking facilities that do not serve a particular building, accessible parking spaces shall be located on the shortest route to an accessible pedestrian entrance to the parking facility." .

ibc:sem-ibc2021-1106.7-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where buildings have multiple accessible entrances with adjacent parking, accessible parking spaces shall be dispersed and located near the accessible entrances." .

ibc:sem-ibc2021-1106.7-atomic-4 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "In multilevel parking structures, van-accessible parking spaces are permitted on one level." .

ibc:sem-ibc2021-1106.7-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Accessible parking spaces shall be permitted to be located in different parking facilities if substantially equivalent or greater accessibility is provided in terms of distance from an accessible entrance or entrances, parking fee and user convenience." .

ibc:sem-ibc2021-1106.7-condition-1 a ibco:Condition ;
    ibco:text "Where buildings have multiple accessible entrances with adjacent parking, accessible parking spaces shall be dispersed and located near the accessible entrances." .

ibc:sem-ibc2021-1106.7-condition-2 a ibco:Condition ;
    ibco:text "if substantially equivalent or greater accessibility is provided in terms of distance from an accessible entrance or entrances, parking fee and user convenience." .

ibc:sem-ibc2021-1106.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where parking meters and pay stations serve accessible parking spaces, such parking meters and pay stations shall be accessible." .

ibc:sem-ibc2021-1106.8-condition-1 a ibco:Condition ;
    ibco:text "Where parking meters and pay stations serve accessible parking spaces, such parking meters and pay stations shall be accessible." .

ibc:sem-ibc2021-1106.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Passenger loading zones shall be accessible." .

ibc:sem-ibc2021-1106.9.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where passenger loading zones are provided, one passenger loading zone in every continuous 100 linear feet (30.4 m) maximum of loading zone space shall be accessible." .

ibc:sem-ibc2021-1106.9.1-condition-1 a ibco:Condition ;
    ibco:text "Where passenger loading zones are provided, one passenger loading zone in every continuous 100 linear feet (30." .

ibc:sem-ibc2021-1106.9.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A passenger loading zone shall be provided at an accessible entrance to licensed medical and long-term care facilities where people receive physical or medical treatment or care and where the period of stay exceeds 24 hours." .

ibc:sem-ibc2021-1106.9.2-condition-1 a ibco:Condition ;
    ibco:text "where people receive physical or medical treatment or care and where the period of stay exceeds 24 hours." .

ibc:sem-ibc2021-1106.9.2-condition-2 a ibco:Condition ;
    ibco:text "where the period of stay exceeds 24 hours." .

ibc:sem-ibc2021-1106.9.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A passenger loading zone shall be provided at valet parking services." .

ibc:sem-ibc2021-1106.9.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Mechanical access parking garages shall provide at least one passenger loading zone at vehicle drop-off and vehicle pick-up areas." .

ibc:sem-ibc2021-1107.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Electrical vehicle charging stations shall comply with Section 1107.2." .

ibc:sem-ibc2021-1107.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Fuel-dispensing systems shall comply with Section 1107.3." .

ibc:sem-ibc2021-1107.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Electrical vehicle charging stations shall comply with Sections 1107.2.1 and 1107.2.2." .

ibc:sem-ibc2021-1107.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Not less than 5 percent of vehicle spaces on the site served by electrical vehicle charging systems, but not fewer than one for each type of electric vehicle charging system, shall be accessible." .

ibc:sem-ibc2021-1107.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1107.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible vehicle spaces shall comply with the requirements for a van accessible parking space that is 132 inches (3350 mm) minimum in width with an adjoining access aisle that is 60 inches (1525 mm) minimum in width. **" .

ibc:sem-ibc2021-1107.2.2-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 132.0 .

ibc:sem-ibc2021-1107.2.2-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 60.0 .

ibc:sem-ibc2021-1107.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Fuel-dispensing systems shall be accessible." .

ibc:sem-ibc2021-1108.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In addition to the other requirements of this chapter, occupancies having dwelling units or sleeping units shall be provided with accessible features in accordance with this section." .

ibc:sem-ibc2021-1108.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "Dwelling units and sleeping units that are required to be Accessible units, Type A units and Type B units shall comply with the applicable portions of Chapter 11 of ICC A117.1." .

ibc:sem-ibc2021-1108.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "Units required to be Type A units are permitted to be designed and constructed as Accessible units." .

ibc:sem-ibc2021-1108.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "Units required to be Type B units are permitted to be designed and constructed as Accessible units or as Type A units." .

ibc:sem-ibc2021-1108.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Rooms and spaces available to the general public or available for use by residents and serving Accessible units, Type A units or Type B units shall be accessible." .

ibc:sem-ibc2021-1108.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible spaces shall include toilet and bathing rooms, kitchen, living and dining areas and any exterior spaces, including patios, terraces and balconies." .

ibc:sem-ibc2021-1108.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Stories and mezzanines exempted by Section 1108.4." .

ibc:sem-ibc2021-1108.3-atomic-4 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Recreational facilities in accordance with Section 1111.2." .

ibc:sem-ibc2021-1108.3-atomic-5 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "Exterior decks, patios or balconies that are part of Type B units and have impervious surfaces, and that are not more than 4 inches (102 mm) below the finished floor level of the adjacent interior space of the unit." .

ibc:sem-ibc2021-1108.3-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 4.0 .

ibc:sem-ibc2021-1108.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Not fewer than one accessible route shall connect accessible building or facility entrances with the primary entrance of each Accessible unit, Type A unit and Type B unit within the building or facility and with those exterior and interior spaces and facilities that serve the units." .

ibc:sem-ibc2021-1108.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "If due to circumstances outside the control of the owner, either the slope of the finished ground level between accessible facilities and buildings exceeds one unit vertical in 12 units horizontal (1:12), or where physical barriers or legal restrictions prevent the installation of an accessible route, a vehicular route with parking that complies with Section 1106 at each public or common use facility or building is permitted in place of the accessible route." .

ibc:sem-ibc2021-1108.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In Group I-3 facilities, an accessible route is not required to connect stories or mezzanines where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-atomic-4 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In Group R-2 facilities with Type A units complying with Section 1108.6.2.2.1, an accessible route is not required to connect stories or mezzanines where Type A units, all common use areas serving Type A units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-atomic-5 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In other than Group R-2 dormitory housing provided by places of education, in Group R-2 facilities with Accessible units complying with Section 1108.6.2.3.1, an accessible route is not required to connect stories or mezzanines where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-atomic-6 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In Group R-1, an accessible route is not required to connect stories or mezzanines within individual units, provided the accessible level meets the provisions for Accessible units and sleeping accommodations for two persons minimum and a toilet facility are provided on that level." .

ibc:sem-ibc2021-1108.4-atomic-7 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In congregate residences in Groups R-3 and R-4, an accessible route is not required to connect stories or mezzanines where Accessible units or Type B units, all common use areas serving Accessible units and Type B units and all public use areas serving Accessible units and Type B units are on an accessible route." .

ibc:sem-ibc2021-1108.4-atomic-8 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route between stories is not required where Type B units are exempted by Section 1108.7." .

ibc:sem-ibc2021-1108.4-condition-1 a ibco:Condition ;
    ibco:text "where physical barriers or legal restrictions prevent the installation of an accessible route, a vehicular route with parking that complies with Section 1106 at each public or common use facility or building is permitted in place of the accessible route." .

ibc:sem-ibc2021-1108.4-condition-2 a ibco:Condition ;
    ibco:text "where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-condition-3 a ibco:Condition ;
    ibco:text "where Type A units, all common use areas serving Type A units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-condition-4 a ibco:Condition ;
    ibco:text "where Accessible units, all common use areas serving Accessible units and all public use areas are on an accessible route." .

ibc:sem-ibc2021-1108.4-condition-5 a ibco:Condition ;
    ibco:text "where Accessible units or Type B units, all common use areas serving Accessible units and Type B units and all public use areas serving Accessible units and Type B units are on an accessible route." .

ibc:sem-ibc2021-1108.4-condition-6 a ibco:Condition ;
    ibco:text "where Type B units are exempted by Section 1108." .

ibc:sem-ibc2021-1108.4-condition-7 a ibco:Condition ;
    ibco:text "If due to circumstances outside the control of the owner, either the slope of the finished ground level between accessible facilities and buildings exceeds one unit vertical in 12 units horizontal (1:12), or where physical barriers or legal restrictions prevent the installation of an accessible route, a vehicular route with parking that complies with Section 1106 at each public or common use facility or building is permitted in place of the accessible route." .

ibc:sem-ibc2021-1108.4-condition-8 a ibco:Condition ;
    ibco:text "other than Group R-2 dormitory housing provided by places of education, in Group R-2 facilities with Accessible units complying with Section 1108." .

ibc:sem-ibc2021-1108.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in Group I occupancies in accordance with Sections 1108.5.1 through 1108.5.5." .

ibc:sem-ibc2021-1108.5.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in Group I-1 occupancies in accordance with Sections 1108.5.1.1 and 1108.5.1.3." .

ibc:sem-ibc2021-1108.5.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group I-1, Condition 1, at least 4 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units." .

ibc:sem-ibc2021-1108.5.1.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible dwelling units and sleeping units shall be dispersed among the various classes of units." .

ibc:sem-ibc2021-1108.5.1.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of the Accessible units." .

ibc:sem-ibc2021-1108.5.1.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 50 percent of the Accessible units." .

ibc:sem-ibc2021-1108.5.1.1-condition-1 a ibco:Condition ;
    ibco:text "where such water closets comply with Section 1110." .

ibc:sem-ibc2021-1108.5.1.1-condition-2 a ibco:Condition ;
    ibco:text "where roll-intype showers comply with Section 1110." .

ibc:sem-ibc2021-1108.5.1.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 4.0 .

ibc:sem-ibc2021-1108.5.1.1-measurement-2 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.5.1.1-measurement-3 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.5.1.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.5.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in nursing homes of Group I-2, Condition 1 occupancies in accordance with Sections 1108.5.2.1 and 1108.5.2.2." .

ibc:sem-ibc2021-1108.5.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 50 percent but not less than one of each type of the dwelling units and sleeping units shall be Accessible units." .

ibc:sem-ibc2021-1108.5.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 90 percent of the Accessible units." .

ibc:sem-ibc2021-1108.5.2.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 90 percent of the Accessible units." .

ibc:sem-ibc2021-1108.5.2.1-condition-1 a ibco:Condition ;
    ibco:text "where such water closets comply with Section 1110." .

ibc:sem-ibc2021-1108.5.2.1-condition-2 a ibco:Condition ;
    ibco:text "where roll-intype showers comply with Section 1110." .

ibc:sem-ibc2021-1108.5.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.5.2.1-measurement-2 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 90.0 .

ibc:sem-ibc2021-1108.5.2.1-measurement-3 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 90.0 .

ibc:sem-ibc2021-1108.5.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.5.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in general-purpose hospitals, psychiatric facilities and detoxification facilities of Group I-2 occupancies in accordance with Sections 1108.5.3.1 and 1108.5.3.2." .

ibc:sem-ibc2021-1108.5.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 10 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units." .

ibc:sem-ibc2021-1108.5.3.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.5.3.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.5.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In hospitals and rehabilitation facilities of Group I-2 occupancies that specialize in treating conditions that affect mobility, or units within either that specialize in treating conditions that affect mobility, 100 percent of the dwelling units and sleeping units shall be Accessible units." .

ibc:sem-ibc2021-1108.5.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of Accessible units." .

ibc:sem-ibc2021-1108.5.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-in-type showers comply with Section 1110.2.3, in not more than 50 percent of Accessible units." .

ibc:sem-ibc2021-1108.5.4-condition-1 a ibco:Condition ;
    ibco:text "where such water closets comply with Section 1110." .

ibc:sem-ibc2021-1108.5.4-condition-2 a ibco:Condition ;
    ibco:text "where roll-in-type showers comply with Section 1110." .

ibc:sem-ibc2021-1108.5.4-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 100.0 .

ibc:sem-ibc2021-1108.5.4-measurement-2 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.5.4-measurement-3 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.5.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units shall be provided in Group I-3 occupancies in accordance with Sections 1108.5.5.1 through 1108.5.5.3." .

ibc:sem-ibc2021-1108.5.5.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group I-3 occupancies, at least 3 percent of the total number of sleeping units in the facility, but not less than one unit in each classification level, shall be Accessible units." .

ibc:sem-ibc2021-1108.5.5.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 3.0 .

ibc:sem-ibc2021-1108.5.5.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In addition to the Accessible units required by Section 1108.5.5.1, where special holding cells or special housing cells or rooms are provided, at least one serving each purpose shall be an Accessible unit." .

ibc:sem-ibc2021-1108.5.5.2-condition-1 a ibco:Condition ;
    ibco:text "where special holding cells or special housing cells or rooms are provided, at least one serving each purpose shall be an Accessible unit." .

ibc:sem-ibc2021-1108.5.5.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Patient sleeping units or cells required to be Accessible units in medical care facilities shall be provided in addition to any medical isolation cells required to comply with Section 1108.5.5.2." .

ibc:sem-ibc2021-1108.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units, Type A units and Type B units shall be provided in Group R occupancies in accordance with Sections 1108.6.1 through 1108.6.4." .

ibc:sem-ibc2021-1108.6.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in Group R-1 occupancies in accordance with Sections 1108.6.1.1 and 1108.6.1.2." .

ibc:sem-ibc2021-1108.6.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1." .

ibc:sem-ibc2021-1108.6.1.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "On a multiple-building site, where structures contain more than 50 dwelling units or sleeping units, the number of Accessible units shall be determined per structure." .

ibc:sem-ibc2021-1108.6.1.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "On a multiple-building site, where structures contain 50 or fewer dwelling units or sleeping units, all dwelling units and sleeping units on a site shall be considered to determine the total number of Accessible units." .

ibc:sem-ibc2021-1108.6.1.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units shall be dispersed among the various classes of units." .

ibc:sem-ibc2021-1108.6.1.1-condition-1 a ibco:Condition ;
    ibco:text "where structures contain more than 50 dwelling units or sleeping units, the number of Accessible units shall be determined per structure." .

ibc:sem-ibc2021-1108.6.1.1-condition-2 a ibco:Condition ;
    ibco:text "where structures contain 50 or fewer dwelling units or sleeping units, all dwelling units and sleeping units on a site shall be considered to determine the total number of Accessible units." .

ibc:sem-ibc2021-1108.6.1.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units, Type A units and Type B units shall be provided in Group R-2 occupancies in accordance with Sections 1108.6.2.1 through 1108.6.2.3." .

ibc:sem-ibc2021-1108.6.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "In live/work units constructed in accordance with Section 419, the nonresidential portion is required to be accessible." .

ibc:sem-ibc2021-1108.6.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In a structure where there are four or more live/work units intended to be occupied as a residence, the residential portion of the live/work unit shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.1-condition-1 a ibco:Condition ;
    ibco:text "where there are four or more live/work units intended to be occupied as a residence, the residential portion of the live/work unit shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Type A units and Type B units shall be provided in apartment houses, monasteries and convents in accordance with Sections 1108.6.2.2.1 and 1108.6.2.2.2." .

ibc:sem-ibc2021-1108.6.2.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Bedrooms in monasteries and convents shall be counted as units for the purpose of determining the number of units." .

ibc:sem-ibc2021-1108.6.2.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the bedrooms are grouped in sleeping units, only one bedroom in each sleeping unit shall count toward the number of required Type A units." .

ibc:sem-ibc2021-1108.6.2.2-condition-1 a ibco:Condition ;
    ibco:text "Where the bedrooms are grouped in sleeping units, only one bedroom in each sleeping unit shall count toward the number of required Type A units." .

ibc:sem-ibc2021-1108.6.2.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2 occupancies containing more than 20 dwelling units or sleeping units, at least 2 percent but not less than one of the units shall be a Type A unit." .

ibc:sem-ibc2021-1108.6.2.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "All Group R-2 units on a site shall be considered to determine the total number of units and the required number of Type A units." .

ibc:sem-ibc2021-1108.6.2.2.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Type A units shall be dispersed among the various classes of units." .

ibc:sem-ibc2021-1108.6.2.2.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type A units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-1108.6.2.2.1-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Existing structures on a site shall not contribute to the total number of units on a site." .

ibc:sem-ibc2021-1108.6.2.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 2.0 .

ibc:sem-ibc2021-1108.6.2.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.2.2-condition-1 a ibco:Condition ;
    ibco:text "Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2 occupancies, other than live/work units, apartment houses, monasteries and convents falling within the scope of Sections 1108.6.2.1 and 1108.6.2.2, Accessible units and Type B units shall be provided in accordance with Sections 1108.6.2.3.1 and 1108.6.2.3.2." .

ibc:sem-ibc2021-1108.6.2.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Bedrooms within congregate living facilities, dormitories, sororities, fraternities and boarding houses shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:sem-ibc2021-1108.6.2.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the bedrooms are grouped into dwelling or sleeping units, only one bedroom in each dwelling or sleeping unit shall be permitted to count toward the number of required Accessible units." .

ibc:sem-ibc2021-1108.6.2.3-condition-1 a ibco:Condition ;
    ibco:text "Where the bedrooms are grouped into dwelling or sleeping units, only one bedroom in each dwelling or sleeping unit shall be permitted to count toward the number of required Accessible units." .

ibc:sem-ibc2021-1108.6.2.3-condition-2 a ibco:Condition ;
    ibco:text "other than live/work units, apartment houses, monasteries and convents." .

ibc:sem-ibc2021-1108.6.2.3-condition-3 a ibco:Condition ;
    ibco:text "other than live/work units, apartment houses, monasteries and convents falling within the scope of Sections 1108." .

ibc:sem-ibc2021-1108.6.2.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1." .

ibc:sem-ibc2021-1108.6.2.3.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and every sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.3.2-condition-1 a ibco:Condition ;
    ibco:text "Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and every sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-3 occupancies where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Bedrooms within congregate living facilities, dormitories, sororities, fraternities, and boarding houses shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:sem-ibc2021-1108.6.3-condition-1 a ibco:Condition ;
    ibco:text "where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible units and Type B units shall be provided in Group R-4 occupancies in accordance with Sections 1108.6.4.1 and 1108.6.4.2." .

ibc:sem-ibc2021-1108.6.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Bedrooms in Group R-4 facilities shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:sem-ibc2021-1108.6.4.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-4, Condition 1, at least one of the sleeping units shall be an Accessible unit." .

ibc:sem-ibc2021-1108.6.4.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-4, Condition 2, at least two of the sleeping units shall be an Accessible unit." .

ibc:sem-ibc2021-1108.6.4.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In structures with four or more sleeping units intended to be occupied as a residence, every sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "Where specifically permitted by Section 1108.5 or 1108.6, the required number of Type A units and Type B units is permitted to be reduced in accordance with Sections 1108.7.1 through 1108.7.5." .

ibc:sem-ibc2021-1108.7-condition-1 a ibco:Condition ;
    ibco:text "Where specifically permitted by Section 1108." .

ibc:sem-ibc2021-1108.7.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "Where elevator service is not provided in a structure, only the dwelling units and sleeping units that are located on stories indicated in Sections 1108.7.1.1 and 1108.7.1.2 are required to be Type A units and Type B units, respectively." .

ibc:sem-ibc2021-1108.7.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The number of Type A units shall be determined in accordance with Section 1108.6.2.2.1." .

ibc:sem-ibc2021-1108.7.1-condition-1 a ibco:Condition ;
    ibco:text "Where elevator service is not provided in a structure, only the dwelling units and sleeping units that are located on stories indicated in Sections 1108." .

ibc:sem-ibc2021-1108.7.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one story containing dwelling units or sleeping units intended to be occupied as a residence shall be provided with an accessible entrance from the exterior of the structure and all units intended to be occupied as a residence on that story shall be Type B units." .

ibc:sem-ibc2021-1108.7.1.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where stories have entrances not included in determining compliance with Section 1108.7.1.1, and such entrances are proximate to arrival points intended to serve units on that story, as indicated in Items 1 and 2, all dwelling units and sleeping units intended to be occupied as a residence served by that entrance on that story shall be Type B units." .

ibc:sem-ibc2021-1108.7.1.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where arrival points are not within 50 feet (15 240 mm) of the entrance, the closest arrival point shall be used to determine access unless that arrival point serves the story required by Section 1108.7.1.1." .

ibc:sem-ibc2021-1108.7.1.2-condition-1 a ibco:Condition ;
    ibco:text "Where stories have entrances not included in determining compliance with Section 1108." .

ibc:sem-ibc2021-1108.7.1.2-condition-2 a ibco:Condition ;
    ibco:text "Where the slopes of the undisturbed site measured between the planned entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less." .

ibc:sem-ibc2021-1108.7.1.2-condition-3 a ibco:Condition ;
    ibco:text "Where the slopes of the planned finished grade measured between the entrance and all vehicular or pedestrian arrival points within 50 feet (15 240 mm) of the planned entrance are 10 percent or less." .

ibc:sem-ibc2021-1108.7.1.2-condition-4 a ibco:Condition ;
    ibco:text "Where arrival points are not within 50 feet (15 240 mm) of the entrance, the closest arrival point shall be used to determine access unless that arrival point serves the story required by Section 1108." .

ibc:sem-ibc2021-1108.7.1.2-condition-5 a ibco:Condition ;
    ibco:text "unless that arrival point serves the story required by Section 1108." .

ibc:sem-ibc2021-1108.7.1.2-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.7.1.2-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.7.1.2-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.7.1.2-measurement-4 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.7.1.2-measurement-5 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.7.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "A multistory dwelling unit or sleeping unit that is not provided with elevator service is not required to be a Type B unit." .

ibc:sem-ibc2021-1108.7.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where a multistory unit is provided with external elevator service to only one floor, the floor provided with elevator service shall be the primary entry to the unit, shall comply with the requirements for a Type B unit and, where provided within the unit, a living area, a kitchen and a toilet facility shall be provided on that floor." .

ibc:sem-ibc2021-1108.7.2-condition-1 a ibco:Condition ;
    ibco:text "Where a multistory unit is provided with external elevator service to only one floor, the floor provided with elevator service shall be the primary entry to the unit, shall comply with the requirements for a Type B unit and, where provided within the unit, a living area, a kitchen and a toilet facility shall be provided on that floor." .

ibc:sem-ibc2021-1108.7.2-condition-2 a ibco:Condition ;
    ibco:text "where provided within the unit, a living area, a kitchen and a toilet facility shall be provided on that floor." .

ibc:sem-ibc2021-1108.7.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "Where elevator service in the building provides an accessible route only to the lowest story containing dwelling units or sleeping units intended to be occupied as a residence, only the units on that story that are intended to be occupied as a residence are required to be Type B units." .

ibc:sem-ibc2021-1108.7.3-condition-1 a ibco:Condition ;
    ibco:text "Where elevator service in the building provides an accessible route only to the lowest story containing dwelling units or sleeping units intended to be occupied as a residence, only the units on that story that are intended to be occupied as a residence are required to be Type B units." .

ibc:sem-ibc2021-1108.7.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "On a site with multiple nonelevator buildings, the number of units required by Section 1108.7.1 to be Type B units is permitted to be reduced to a percentage that is equal to the percentage of the entire site having grades, prior to development, that are less than 10 percent, provided that all of the following conditions are met: 1." .

ibc:sem-ibc2021-1108.7.4-condition-1 a ibco:Condition ;
    ibco:text "where the slope between the building entrance serving the units on that story and a pedestrian or vehicular arrival point is not greater than 8." .

ibc:sem-ibc2021-1108.7.4-condition-2 a ibco:Condition ;
    ibco:text "where an elevated walkway is planned between a building entrance serving the units on that story and a pedestrian or vehicular arrival point and the slope between them is 10 percent or less, are Type B units." .

ibc:sem-ibc2021-1108.7.4-condition-3 a ibco:Condition ;
    ibco:text "provided that all of the following conditions are met: 1." .

ibc:sem-ibc2021-1108.7.4-measurement-1 a ibco:Measurement ;
    ibco:operator "less_than" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.7.4-measurement-2 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 20.0 .

ibc:sem-ibc2021-1108.7.4-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 8.33 .

ibc:sem-ibc2021-1108.7.4-measurement-4 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.7.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Type A units and Type B units shall not be required for buildings without elevator service that are located in flood hazard areas as established in Section 1612.3, where the minimum required elevation of the lowest floor or lowest supporting horizontal structural member, as applicable, results in all of the following: 1." .

ibc:sem-ibc2021-1108.7.5-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where such arrival points are not within 50 feet (15 240 mm) of the primary entrances, the closest arrival points shall be used." .

ibc:sem-ibc2021-1108.7.5-condition-1 a ibco:Condition ;
    ibco:text "where the minimum required elevation of the lowest floor or lowest supporting horizontal structural member, as applicable, results in all of the following: 1." .

ibc:sem-ibc2021-1108.7.5-condition-2 a ibco:Condition ;
    ibco:text "Where such arrival points are not within 50 feet (15 240 mm) of the primary entrances, the closest arrival points shall be used." .

ibc:sem-ibc2021-1108.7.5-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.7.5-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1108.7.5-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-1108.7.5-measurement-4 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1108.7.5-measurement-5 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1109.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In addition to the other requirements of this chapter, the requirements of Sections 1109.2 through 1109.4 shall apply to specific occupancies." .

ibc:sem-ibc2021-1109.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A building, room or space used for assembly purposes with fixed seating shall comply with Sections 1109.2.1 through 1109.2.5." .

ibc:sem-ibc2021-1109.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Lawn seating shall comply with Section 1109.2.6." .

ibc:sem-ibc2021-1109.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Assistive listening systems shall comply with Section 1109.2.7." .

ibc:sem-ibc2021-1109.2-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Performance areas viewed from assembly seating areas shall comply with Section 1109.2.8." .

ibc:sem-ibc2021-1109.2-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Dining areas shall comply with Section 1109.2.9." .

ibc:sem-ibc2021-1109.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "If a service or facility is provided in an area that is not accessible, the same service or facility shall be provided on an accessible level and shall be accessible." .

ibc:sem-ibc2021-1109.2.1-condition-1 a ibco:Condition ;
    ibco:text "If a service or facility is provided in an area that is not accessible, the same service or facility shall be provided on an accessible level and shall be accessible." .

ibc:sem-ibc2021-1109.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In rooms and spaces used for assembly purposes with fixed seating, accessible wheelchair spaces shall be provided in accordance with Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:sem-ibc2021-1109.2.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1." .

ibc:sem-ibc2021-1109.2.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In each luxury box, club box and suite within arenas, stadiums and grandstands, wheelchair spaces shall be provided in accordance with Table 1109.2.2.1." .

ibc:sem-ibc2021-1109.2.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In boxes other than those required to comply with Section 1109.2.2.2, the total number of wheelchair spaces provided shall be determined in accordance with Table 1109.2.2.1." .

ibc:sem-ibc2021-1109.2.2.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Wheelchair spaces shall be located in not less than 20 percent of all boxes provided." .

ibc:sem-ibc2021-1109.2.2.3-condition-1 a ibco:Condition ;
    ibco:text "other than those required to comply with Section 1109." .

ibc:sem-ibc2021-1109.2.2.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 20.0 .

ibc:sem-ibc2021-1109.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one companion seat shall be provided for each wheelchair space required by Sections 1109.2.2.1 through 1109.2.2.3." .

ibc:sem-ibc2021-1109.2.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In multilevel assembly seating areas, wheelchair spaces shall be provided on the main floor level and on one of each two additional floor or mezzanine levels." .

ibc:sem-ibc2021-1109.2.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Wheelchair spaces shall be provided in each luxury box, club box and suite within assembly facilities." .

ibc:sem-ibc2021-1109.2.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "In multilevel assembly seating areas utilized for worship services where the second floor or mezzanine level contains 25 percent or less of the total seating capacity, wheelchair spaces shall be permitted to all be located on the main level." .

ibc:sem-ibc2021-1109.2.4-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "In multilevel assembly seating areas where the second floor or mezzanine level provides 25 percent or less of the total seating capacity and 300 or fewer seats, all wheelchair spaces shall be permitted to be located on the main level." .

ibc:sem-ibc2021-1109.2.4-atomic-5 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Wheelchair spaces in team or player seating serving areas of sport activity are not required to be dispersed." .

ibc:sem-ibc2021-1109.2.4-condition-1 a ibco:Condition ;
    ibco:text "where the second floor or mezzanine level contains 25 percent or less of the total seating capacity, wheelchair spaces shall be permitted to all be located on the main level." .

ibc:sem-ibc2021-1109.2.4-condition-2 a ibco:Condition ;
    ibco:text "where the second floor or mezzanine level provides 25 percent or less of the total seating capacity and 300 or fewer seats, all wheelchair spaces shall be permitted to be located on the main level." .

ibc:sem-ibc2021-1109.2.4-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 25.0 .

ibc:sem-ibc2021-1109.2.4-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 25.0 .

ibc:sem-ibc2021-1109.2.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 5 percent, but not less than one, of the total number of aisle seats provided shall be designated aisle seats and shall be the aisle seats located closest to accessible routes." .

ibc:sem-ibc2021-1109.2.5-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1109.2.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Lawn seating areas and exterior overflow seating areas, where fixed seats are not provided, shall connect to an accessible route." .

ibc:sem-ibc2021-1109.2.6-condition-1 a ibco:Condition ;
    ibco:text "where fixed seats are not provided, shall connect to an accessible route." .

ibc:sem-ibc2021-1109.2.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Each building, room or space used for assembly purposes where audible communications are integral to the use of the space shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7-condition-1 a ibco:Condition ;
    ibco:text "where audible communications are integral to the use of the space shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The number and type of receivers shall be provided for assistive listening systems in accordance with Table 1109.2.7.1." .

ibc:sem-ibc2021-1109.2.7.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where a building contains more than one room or space used for assembly purposes, the total number of required receivers shall be permitted to be calculated based on the total number of seats in the building, provided that all receivers are usable with all systems and if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management." .

ibc:sem-ibc2021-1109.2.7.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Where all seats in a building, room or space used for assembly purposes are served by an induction loop assistive listening system, the minimum number of receivers required by Table 1109.2.7.1 to be hearing-aid compatible shall not be required." .

ibc:sem-ibc2021-1109.2.7.1-condition-1 a ibco:Condition ;
    ibco:text "Where a building contains more than one room or space used for assembly purposes, the total number of required receivers shall be permitted to be calculated based on the total number of seats in the building, provided that all receivers are usable with all systems and if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management." .

ibc:sem-ibc2021-1109.2.7.1-condition-2 a ibco:Condition ;
    ibco:text "Where all seats in a building, room or space used for assembly purposes are served by an induction loop assistive listening system, the minimum number of receivers required by Table 1109." .

ibc:sem-ibc2021-1109.2.7.1-condition-3 a ibco:Condition ;
    ibco:text "if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management." .

ibc:sem-ibc2021-1109.2.7.1-condition-4 a ibco:Condition ;
    ibco:text "provided that all receivers are usable with all systems and if the rooms or spaces used for assembly purposes required to provide assistive listening are under one management." .

ibc:sem-ibc2021-1109.2.7.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where ticket windows are provided in stadiums and arenas, at least one window at each location shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7.2-condition-1 a ibco:Condition ;
    ibco:text "Where ticket windows are provided in stadiums and arenas, at least one window at each location shall have an assistive listening system." .

ibc:sem-ibc2021-1109.2.7.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where stadiums, arenas and grandstands have 15,000 fixed seats or more and provide audible public announcements, they shall also provide prerecorded or real-time captions of those audible public announcements." .

ibc:sem-ibc2021-1109.2.7.3-condition-1 a ibco:Condition ;
    ibco:text "Where stadiums, arenas and grandstands have 15,000 fixed seats or more and provide audible public announcements, they shall also provide prerecorded or real-time captions of those audible public announcements." .

ibc:sem-ibc2021-1109.2.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "An accessible route shall directly connect the performance area to the assembly seating area where a circulation path directly connects a performance area to an assembly seating area." .

ibc:sem-ibc2021-1109.2.8-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "An accessible route shall be provided from performance areas to ancillary areas or facilities used by performers." .

ibc:sem-ibc2021-1109.2.8-condition-1 a ibco:Condition ;
    ibco:text "where a circulation path directly connects a performance area to an assembly seating area." .

ibc:sem-ibc2021-1109.2.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In dining and drinking areas, all interior and exterior floor areas shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1109.2.9-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible route between accessible levels and stories above or below is not required where permitted by Section 1104.4, Exception 1." .

ibc:sem-ibc2021-1109.2.9-atomic-3 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "RECEIVERS FOR ASSISTIVE LISTENING SYSTEMS" .

ibc:sem-ibc2021-1109.2.9-condition-1 a ibco:Condition ;
    ibco:text "where permitted by Section 1104." .

ibc:sem-ibc2021-1109.2.9.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where dining surfaces for the consumption of food or drink are provided, at least 5 percent, but not less than one, of the dining surfaces for the seating and standing spaces shall be accessible and be distributed throughout the facility and located on a level accessed by an accessible route." .

ibc:sem-ibc2021-1109.2.9.1-condition-1 a ibco:Condition ;
    ibco:text "Where dining surfaces for the consumption of food or drink are provided, at least 5 percent, but not less than one, of the dining surfaces for the seating and standing spaces shall be accessible and be distributed throughout the facility and located on a level accessed by an accessible route." .

ibc:sem-ibc2021-1109.2.9.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1109.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Self-service storage facilities shall provide accessible individual self-storage spaces in accordance with Table 1109.3." .

ibc:sem-ibc2021-1109.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible individual self-service storage spaces shall be dispersed throughout the various classes of spaces provided." .

ibc:sem-ibc2021-1109.3.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Where more classes of spaces are provided than the number of required accessible spaces, the number of accessible spaces shall not be required to exceed that required by Table 1109.3." .

ibc:sem-ibc2021-1109.3.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "Accessible spaces are permitted to be dispersed in a single building of a multiple-building facility." .

ibc:sem-ibc2021-1109.3.1-condition-1 a ibco:Condition ;
    ibco:text "Where more classes of spaces are provided than the number of required accessible spaces, the number of accessible spaces shall not be required to exceed that required by Table 1109." .

ibc:sem-ibc2021-1109.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Judicial facilities shall comply with Sections 1109.4.1 and 1109.4.2." .

ibc:sem-ibc2021-1109.4.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Each courtroom shall be accessible and comply with Sections 1109.4.1.1 through 1109.4.1.5." .

ibc:sem-ibc2021-1109.4.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A wheelchair space shall be provided within the jury box." .

ibc:sem-ibc2021-1109.4.1.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Wheelchair spaces shall be provided in accordance with Table 1109.2.2.1." .

ibc:sem-ibc2021-1109.4.1.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Designated aisle seats shall be provided in accordance with Section 1109.2.5." .

ibc:sem-ibc2021-1109.4.1.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "must" ;
    ibco:statementType "obligation" ;
    ibco:text "An assistive listening system must be provided." .

ibc:sem-ibc2021-1109.4.1.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Receivers shall be provided for the assistive listening system in accordance with Section 1109.2.7.1." .

ibc:sem-ibc2021-1109.4.1.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The judge’s bench, clerk’s station, bailiff’s station, deputy clerk’s station and court reporter’s station shall be located on an accessible route." .

ibc:sem-ibc2021-1109.4.1.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "The vertical access to elevated employee work stations within a courtroom is not required at the time of initial construction, provided a ramp, lift or elevator can be installed without requiring reconfiguration or extension of the courtroom or extension of the electrical system." .

ibc:sem-ibc2021-1109.4.1.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The litigant’s and counsel stations, including the lectern, shall be accessible." .

ibc:sem-ibc2021-1109.4.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Central holding cells and courtfloor holding cells shall comply with Sections 1109.4.2.1 and 1109.4.2.2." .

ibc:sem-ibc2021-1109.4.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where separate central holding cells are provided for adult males, juvenile males, adult females or juvenile females, one of each type shall be accessible." .

ibc:sem-ibc2021-1109.4.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where central holding cells are provided and are not separated by age or sex, at least one accessible cell shall be provided." .

ibc:sem-ibc2021-1109.4.2.1-condition-1 a ibco:Condition ;
    ibco:text "Where separate central holding cells are provided for adult males, juvenile males, adult females or juvenile females, one of each type shall be accessible." .

ibc:sem-ibc2021-1109.4.2.1-condition-2 a ibco:Condition ;
    ibco:text "Where central holding cells are provided and are not separated by age or sex, at least one accessible cell shall be provided." .

ibc:sem-ibc2021-1109.4.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where separate court-floor holding cells are provided for adult males, juvenile males, adult females or juvenile females, each courtroom shall be served by one accessible cell of each type." .

ibc:sem-ibc2021-1109.4.2.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where court-floor holding cells are provided and are not separated by age or sex, courtrooms shall be served by at least one accessible cell." .

ibc:sem-ibc2021-1109.4.2.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible cells shall be permitted to serve more than one courtroom." .

ibc:sem-ibc2021-1109.4.2.2-condition-1 a ibco:Condition ;
    ibco:text "Where separate court-floor holding cells are provided for adult males, juvenile males, adult females or juvenile females, each courtroom shall be served by one accessible cell of each type." .

ibc:sem-ibc2021-1109.4.2.2-condition-2 a ibco:Condition ;
    ibco:text "Where court-floor holding cells are provided and are not separated by age or sex, courtrooms shall be served by at least one accessible cell." .

ibc:sem-ibc2021-1110.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible building features and facilities shall be provided in accordance with Sections 1110.2 through 1110.16." .

ibc:sem-ibc2021-1110.10-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where fixed or built-in storage elements such as cabinets, coat hooks, shelves, medicine cabinets, lockers, closets and drawers are provided in required accessible spaces, at least 5 percent, but not less than one of each type shall be accessible." .

ibc:sem-ibc2021-1110.10-condition-1 a ibco:Condition ;
    ibco:text "Where fixed or built-in storage elements such as cabinets, coat hooks, shelves, medicine cabinets, lockers, closets and drawers are provided in required accessible spaces, at least 5 percent, but not less than one of each type shall be accessible." .

ibc:sem-ibc2021-1110.10-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.10.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible facilities and spaces shall be provided with the same storage elements as provided in the similar nonaccessible facilities and spaces." .

ibc:sem-ibc2021-1110.10.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Self-service shelves and display units shall be located on an accessible route." .

ibc:sem-ibc2021-1110.10.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Such shelving and display units shall not be required to comply with reach-range provisions." .

ibc:sem-ibc2021-1110.11-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Passenger transit platform edges bordering a drop-off and not protected by platform screens or guards shall have a detectable warning." .

ibc:sem-ibc2021-1110.12-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where seating or standing space at fixed or built-in tables, counters or work surfaces is provided in accessible spaces, at least 5 percent of the seating and standing spaces, but not less than one, shall be accessible." .

ibc:sem-ibc2021-1110.12-condition-1 a ibco:Condition ;
    ibco:text "Where seating or standing space at fixed or built-in tables, counters or work surfaces is provided in accessible spaces, at least 5 percent of the seating and standing spaces, but not less than one, shall be accessible." .

ibc:sem-ibc2021-1110.12-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.12.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible fixed or built-in seating at tables, counters or work surfaces shall be distributed throughout the space or facility containing such elements and located on a level accessed by an accessible route." .

ibc:sem-ibc2021-1110.12.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Visiting areas in judicial facilities and Group I-3 shall comply with Sections 1110.12.2.1 and 1110.12.2.2." .

ibc:sem-ibc2021-1110.12.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 5 percent, but not less than one of the cubicles, shall be accessible on both the visitor and detainee sides." .

ibc:sem-ibc2021-1110.12.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where counters are provided, at least one shall be accessible on both the visitor and detainee sides." .

ibc:sem-ibc2021-1110.12.2.1-condition-1 a ibco:Condition ;
    ibco:text "Where counters are provided, at least one shall be accessible on both the visitor and detainee sides." .

ibc:sem-ibc2021-1110.12.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.12.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where solid partitions or security glazing separate visitors from detainees, at least one of each type of cubicle or counter partition shall be accessible." .

ibc:sem-ibc2021-1110.12.2.2-condition-1 a ibco:Condition ;
    ibco:text "Where solid partitions or security glazing separate visitors from detainees, at least one of each type of cubicle or counter partition shall be accessible." .

ibc:sem-ibc2021-1110.13-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Service facilities shall provide for accessible features in accordance with Sections 1110.14 through 1110.13.4. *" .

ibc:sem-ibc2021-1110.13.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where check-out aisles are provided, accessible check-out aisles shall be provided in accordance with Table 1110.13.1." .

ibc:sem-ibc2021-1110.13.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where check-out aisles serve different functions, accessible check-out aisles shall be provided in accordance with Table 1110.13.1 for each function." .

ibc:sem-ibc2021-1110.13.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where check-out aisles are dispersed throughout the building or facility, accessible check-out aisles shall also be dispersed." .

ibc:sem-ibc2021-1110.13.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Traffic control devices, security devices and turnstiles located in accessible check-out aisles or lanes shall be accessible." .

ibc:sem-ibc2021-1110.13.1-condition-1 a ibco:Condition ;
    ibco:text "Where check-out aisles are provided, accessible check-out aisles shall be provided in accordance with Table 1110." .

ibc:sem-ibc2021-1110.13.1-condition-2 a ibco:Condition ;
    ibco:text "Where check-out aisles serve different functions, accessible check-out aisles shall be provided in accordance with Table 1110." .

ibc:sem-ibc2021-1110.13.1-condition-3 a ibco:Condition ;
    ibco:text "Where check-out aisles are dispersed throughout the building or facility, accessible check-out aisles shall also be dispersed." .

ibc:sem-ibc2021-1110.13.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where counters or windows are provided for sale or distribution of goods or services, at least one of each type of counter and window provided shall be accessible." .

ibc:sem-ibc2021-1110.13.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where such counters or windows are dispersed throughout the building or facility, accessible counters or windows shall also be dispersed." .

ibc:sem-ibc2021-1110.13.2-condition-1 a ibco:Condition ;
    ibco:text "Where counters or windows are provided for sale or distribution of goods or services, at least one of each type of counter and window provided shall be accessible." .

ibc:sem-ibc2021-1110.13.2-condition-2 a ibco:Condition ;
    ibco:text "Where such counters or windows are dispersed throughout the building or facility, accessible counters or windows shall also be dispersed." .

ibc:sem-ibc2021-1110.13.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Food service lines shall be accessible." .

ibc:sem-ibc2021-1110.13.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where self-service shelves are provided, at least 50 percent, but not less than one, of each type provided shall be accessible." .

ibc:sem-ibc2021-1110.13.3-condition-1 a ibco:Condition ;
    ibco:text "Where self-service shelves are provided, at least 50 percent, but not less than one, of each type provided shall be accessible." .

ibc:sem-ibc2021-1110.13.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.13.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Queue and waiting lines servicing accessible counters or check-out aisles ** shall be accessible." .

ibc:sem-ibc2021-1110.14-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where dressing rooms, fitting rooms or locker rooms are provided, at least 5 percent, but not less than one, of each type of use in each cluster provided shall be accessible." .

ibc:sem-ibc2021-1110.14-condition-1 a ibco:Condition ;
    ibco:text "Where dressing rooms, fitting rooms or locker rooms are provided, at least 5 percent, but not less than one, of each type of use in each cluster provided shall be accessible." .

ibc:sem-ibc2021-1110.14-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.15-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Controls, operating mechanisms and hardware intended for operation by the occupant, including switches that control lighting and ventilation and electrical convenience outlets, in accessible spaces, along accessible routes or as parts of accessible elements shall be accessible." .

ibc:sem-ibc2021-1110.15-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Operable parts that are intended for use only by service or maintenance personnel shall not be required to be accessible.  2." .

ibc:sem-ibc2021-1110.15-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Access doors or gates in barrier walls and fences protecting pools, spas and hot tubs shall be permitted to comply with Section 1010.2.3." .

ibc:sem-ibc2021-1110.15-atomic-4 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Operable parts exempted in accordance with ICC A117.1 are not required to be accessible. *" .

ibc:sem-ibc2021-1110.16-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least two percent of the total, but not fewer than one, of each gaming machine type and gaming table type shall be accessible." .

ibc:sem-ibc2021-1110.16-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where multiple gaming areas occur, accessible gaming machines and gaming tables shall be distributed throughout." .

ibc:sem-ibc2021-1110.16-condition-1 a ibco:Condition ;
    ibco:text "Where multiple gaming areas occur, accessible gaming machines and gaming tables shall be distributed throughout." .

ibc:sem-ibc2021-1110.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Each toilet room and bathing room shall be accessible." .

ibc:sem-ibc2021-1110.2-atomic-10 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "The sleeping units served by bariatrics toilet or bathing rooms shall not count toward the required number of Accessible sleeping units." .

ibc:sem-ibc2021-1110.2-atomic-11 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "Where permitted in Section 1108, in toilet rooms or bathrooms serving Accessible units, water closets designed for assisted toileting shall comply with Section 1110.2.2." .

ibc:sem-ibc2021-1110.2-atomic-12 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "Where permitted in Section 1108, in bathrooms serving Accessible units, showers designed for assisted bathing shall comply with Section 1110.2.3." .

ibc:sem-ibc2021-1110.2-atomic-13 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where toilet facilities are primarily for children’s use, required accessible water closets, toilet compartments and lavatories shall be permitted to comply with children’s provision of ICC A117.1." .

ibc:sem-ibc2021-1110.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Where a floor level is not required to be connected by an accessible route, the only toilet rooms or bathing rooms provided within the facility shall not be located on the inaccessible floor." .

ibc:sem-ibc2021-1110.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Except as provided for in Sections 1110.2.4 and 1110.2.5, at least one of each type of fixture, element, control or dispenser in each accessible toilet room and bathing room shall be accessible." .

ibc:sem-ibc2021-1110.2-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Toilet rooms or bathing rooms accessed only through a private office, not for common or public use and intended for use by a single occupant, shall be permitted to comply with the specific exceptions in ICC A117.1." .

ibc:sem-ibc2021-1110.2-atomic-5 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "This section is not applicable to toilet and bathing rooms that serve dwelling units or sleeping units that are not required to be accessible by Section 1108." .

ibc:sem-ibc2021-1110.2-atomic-6 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where multiple single-user toilet rooms or bathing rooms are clustered at a single location, at least 50 percent but not less than one room for each use at each cluster shall be accessible." .

ibc:sem-ibc2021-1110.2-atomic-7 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where no more than one urinal is provided in a toilet room or bathing room, the urinal is not required to be accessible." .

ibc:sem-ibc2021-1110.2-atomic-8 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Toilet rooms or bathing rooms that are part of critical care or intensive care patient sleeping rooms serving Accessible units are not required to be accessible." .

ibc:sem-ibc2021-1110.2-atomic-9 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Toilet rooms or bathing rooms designed for bariatrics patients are not required to comply with the toilet room and bathing room requirement in ICC A117.1." .

ibc:sem-ibc2021-1110.2-condition-1 a ibco:Condition ;
    ibco:text "Where a floor level is not required to be connected by an accessible route, the only toilet rooms or bathing rooms provided within the facility shall not be located on the inaccessible floor." .

ibc:sem-ibc2021-1110.2-condition-2 a ibco:Condition ;
    ibco:text "Where multiple single-user toilet rooms or bathing rooms are clustered at a single location, at least 50 percent but not less than one room for each use at each cluster shall be accessible." .

ibc:sem-ibc2021-1110.2-condition-3 a ibco:Condition ;
    ibco:text "Where no more than one urinal is provided in a toilet room or bathing room, the urinal is not required to be accessible." .

ibc:sem-ibc2021-1110.2-condition-4 a ibco:Condition ;
    ibco:text "Where permitted in Section 1108, in toilet rooms or bathrooms serving Accessible units, water closets designed for assisted toileting shall comply with Section 1110." .

ibc:sem-ibc2021-1110.2-condition-5 a ibco:Condition ;
    ibco:text "Where permitted in Section 1108, in bathrooms serving Accessible units, showers designed for assisted bathing shall comply with Section 1110." .

ibc:sem-ibc2021-1110.2-condition-6 a ibco:Condition ;
    ibco:text "Where toilet facilities are primarily for children’s use, required accessible water closets, toilet compartments and lavatories shall be permitted to comply with children’s provision of ICC A117." .

ibc:sem-ibc2021-1110.2-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In assembly and mercantile occupancies, an accessible family or assisted-use toilet room shall be provided where an aggregate of six or more male and female water closets is required." .

ibc:sem-ibc2021-1110.2.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In buildings of mixed occupancy, only those water closets required for the assembly or mercantile occupancy shall be used to determine the family or assisted-use toilet room requirement." .

ibc:sem-ibc2021-1110.2.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In recreational facilities where separate-sex bathing rooms are provided, an accessible family or assisted-use bathing room shall be provided." .

ibc:sem-ibc2021-1110.2.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Fixtures located within family or assisted-use toilet and bathing rooms shall be included in determining the number of fixtures provided in an occupancy." .

ibc:sem-ibc2021-1110.2.1-condition-1 a ibco:Condition ;
    ibco:text "where an aggregate of six or more male and female water closets is required." .

ibc:sem-ibc2021-1110.2.1-condition-2 a ibco:Condition ;
    ibco:text "where separate-sex bathing rooms are provided, an accessible family or assisted-use bathing room shall be provided." .

ibc:sem-ibc2021-1110.2.1.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisted-use toilet and bathing rooms shall comply with Sections 1110.2.1.2 through 1110.2.1.6." .

ibc:sem-ibc2021-1110.2.1.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisted-use toilet rooms shall include only one water closet and only one lavatory." .

ibc:sem-ibc2021-1110.2.1.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A family or assisted-use bathing room in accordance with Section 1110.2.1.3 shall be considered to be a family or assisted-use toilet room." .

ibc:sem-ibc2021-1110.2.1.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisted-use bathing rooms shall include only one shower or bathtub fixture." .

ibc:sem-ibc2021-1110.2.1.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisteduse bathing rooms shall also include one water closet and one lavatory." .

ibc:sem-ibc2021-1110.2.1.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where storage facilities are provided for separate-sex bathing rooms, accessible storage facilities shall be provided for family or assisted-use bathing rooms." .

ibc:sem-ibc2021-1110.2.1.3-condition-1 a ibco:Condition ;
    ibco:text "Where storage facilities are provided for separate-sex bathing rooms, accessible storage facilities shall be provided for family or assisted-use bathing rooms." .

ibc:sem-ibc2021-1110.2.1.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisted-use toilet and bathing rooms shall be located on an accessible route." .

ibc:sem-ibc2021-1110.2.1.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Family or assisted-use toilet rooms shall be located not more than one story above or below separate-sex toilet rooms." .

ibc:sem-ibc2021-1110.2.1.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "The accessible route from any separate-sex toilet room to a family or assisted-use toilet room shall not exceed 500 feet (152 m)." .

ibc:sem-ibc2021-1110.2.1.4-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 500.0 .

ibc:sem-ibc2021-1110.2.1.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "In passenger transportation facilities and airports, the accessible route from separate-sex toilet rooms to a family or assisteduse toilet room shall not pass through security checkpoints. " .

ibc:sem-ibc2021-1110.2.1.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Doors to family or assisted-use toilet and bathing rooms shall be securable from within the room and be provided with an “occupied” indicator." .

ibc:sem-ibc2021-1110.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Water closets designed for assisted toileting shall comply with Sections 1110.2.2.1 through 1110.2.2.6." .

ibc:sem-ibc2021-1110.2.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The centerline of the water closet shall be not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from one side of the required clearance." .

ibc:sem-ibc2021-1110.2.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 24.0 .

ibc:sem-ibc2021-1110.2.2.1-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 26.0 .

ibc:sem-ibc2021-1110.2.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Clearance around the water closet shall comply with Sections 1110.2.2.2.1 through 1110.2.2.2.3." .

ibc:sem-ibc2021-1110.2.2.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Clearance around a water closet shall be not less than 66 inches (1675 mm) in width, measured perpendicularly from the side of the clearance that is not less than 24 inches (610 mm) and not greater than 26 inches (660 mm) from the water closet centerline." .

ibc:sem-ibc2021-1110.2.2.2.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 66.0 .

ibc:sem-ibc2021-1110.2.2.2.1-measurement-2 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 24.0 .

ibc:sem-ibc2021-1110.2.2.2.1-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 26.0 .

ibc:sem-ibc2021-1110.2.2.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Clearance around the water closet shall be not less than 78 inches (1980 mm) in depth, measured perpendicularly from the rear wall" .

ibc:sem-ibc2021-1110.2.2.2.2-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 78.0 .

ibc:sem-ibc2021-1110.2.2.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The required clearance around the water closet shall permit overlaps per ICC A117.1, Section 604.3.3" .

ibc:sem-ibc2021-1110.2.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The height of the water closet seats shall comply with ICC A117.1, Section 604.4." .

ibc:sem-ibc2021-1110.2.2.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Swing-up grab bars shall comply with ICC A117.1, Sections 609.2 and 609.8." .

ibc:sem-ibc2021-1110.2.2.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Swing-up grab bars shall be provided on both sides of the water closet and shall comply with all of the following: 1." .

ibc:sem-ibc2021-1110.2.2.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The centerline of the grab bar shall be not less than 14 inches (356 mm) and not greater than 16 inches (405 mm) from the centerline of the water closet." .

ibc:sem-ibc2021-1110.2.2.4-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 14.0 .

ibc:sem-ibc2021-1110.2.2.4-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 16.0 .

ibc:sem-ibc2021-1110.2.2.4-measurement-3 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 36.0 .

ibc:sem-ibc2021-1110.2.2.4-measurement-4 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.2.2.4-measurement-5 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 34.0 .

ibc:sem-ibc2021-1110.2.2.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Flush controls shall comply with ICC A117.1, Section 604.6." .

ibc:sem-ibc2021-1110.2.2.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Dispensers Toilet paper dispensers shall be mounted on at least one of the swing-up grab bars and the outlet of the dispenser shall be located not less than 24 inches (610 mm) and not greater than 36 inches (915 mm) from the rear wall." .

ibc:sem-ibc2021-1110.2.2.6-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 24.0 .

ibc:sem-ibc2021-1110.2.2.6-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 36.0 .

ibc:sem-ibc2021-1110.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Standard roll-in-type shower compartments designed for assisted bathing shall comply with Sections 1110.2.3.1 through 1110.2.3.9." .

ibc:sem-ibc2021-1110.2.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Standard roll-in-type shower compartments shall have a clear inside dimension of not less than 60 inches (1525 mm) in width and 30 inches (760 mm) in depth, measured at the center point of opposing sides." .

ibc:sem-ibc2021-1110.2.3.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "An entry not less than 60 inches (1525 mm) in width shall be provided." .

ibc:sem-ibc2021-1110.2.3.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 60.0 .

ibc:sem-ibc2021-1110.2.3.1-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.2.3.1-measurement-3 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 60.0 .

ibc:sem-ibc2021-1110.2.3.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "A clearance of not less than 60 inches (1525 mm) in length adjacent to the 60-inch (1525 mm) width of the open face of the shower compartment, and not less than 30 inches (760 mm) in depth, shall be provided." .

ibc:sem-ibc2021-1110.2.3.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "A lavatory complying with ICC A117.1, Section 606 shall be permitted at one end of the clearance." .

ibc:sem-ibc2021-1110.2.3.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where the shower compartment exceeds minimum sizes, the clear floor space shall be placed adjacent to the grab bars and not less than 30 inches (762 mm) from the back wall." .

ibc:sem-ibc2021-1110.2.3.2-condition-1 a ibco:Condition ;
    ibco:text "Where the shower compartment exceeds minimum sizes, the clear floor space shall be placed adjacent to the grab bars and not less than 30 inches (762 mm) from the back wall." .

ibc:sem-ibc2021-1110.2.3.2-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 60.0 .

ibc:sem-ibc2021-1110.2.3.2-measurement-2 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.2.3.2-measurement-3 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.2.3.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Grab bars shall comply with ICC A117.1, Section 609 and shall be provided in accordance with Sections 1110.2.3.3.1 and 1110.2.3.3.2." .

ibc:sem-ibc2021-1110.2.3.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In standard roll-in-type shower compartments, grab bars shall be provided on three walls." .

ibc:sem-ibc2021-1110.2.3.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where multiple grab bars are used, required horizontal grab bars shall be installed at the same height above the floor." .

ibc:sem-ibc2021-1110.2.3.3-condition-1 a ibco:Condition ;
    ibco:text "Where multiple grab bars are used, required horizontal grab bars shall be installed at the same height above the floor." .

ibc:sem-ibc2021-1110.2.3.3.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The back-wall grab bar shall extend the length of the back wall and extend within 6 inches (150 mm) maximum from the two adjacent sidewalls." .

ibc:sem-ibc2021-1110.2.3.3.1-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 6.0 .

ibc:sem-ibc2021-1110.2.3.3.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The sidewall grab bars shall extend the length of the wall and extend within 6 inches (150 mm) of the adjacent back wall." .

ibc:sem-ibc2021-1110.2.3.3.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "The sidewall grab bar shall not be required to exceed 30 inches (760 mm) in length." .

ibc:sem-ibc2021-1110.2.3.3.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "The side grab bar shall be located with one end within 6 inches (152 mm) of the back wall with a grab bar complying with Section 1110.2.3.3.1." .

ibc:sem-ibc2021-1110.2.3.3.2-atomic-4 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where the sidewalls are located 72 inches (1830 mm) or greater apart, a grab bar is not required on one of the sidewalls." .

ibc:sem-ibc2021-1110.2.3.3.2-condition-1 a ibco:Condition ;
    ibco:text "Where the sidewalls are located 72 inches (1830 mm) or greater apart, a grab bar is not required on one of the sidewalls." .

ibc:sem-ibc2021-1110.2.3.3.2-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 6.0 .

ibc:sem-ibc2021-1110.2.3.3.2-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.2.3.3.2-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 6.0 .

ibc:sem-ibc2021-1110.2.3.3.2-measurement-4 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 72.0 .

ibc:sem-ibc2021-1110.2.3.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Wall-mounted folding seats shall not be installed." .

ibc:sem-ibc2021-1110.2.3.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In standard roll-in-type showers, the controls and hand shower shall be located not less than 38 inches (965 mm) and not greater than 48 inches (1220 mm) above the shower floor." .

ibc:sem-ibc2021-1110.2.3.5-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Controls shall be located to facilitate caregiver access." .

ibc:sem-ibc2021-1110.2.3.5-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "IN" ;
    ibco:value 38.0 .

ibc:sem-ibc2021-1110.2.3.5-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 48.0 .

ibc:sem-ibc2021-1110.2.3.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Hand showers shall comply with ICC A117.1, Section 608.5." .

ibc:sem-ibc2021-1110.2.3.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Thresholds shall comply with ICC A117.1, Section 608.6." .

ibc:sem-ibc2021-1110.2.3.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Shower compartment enclosures for shower compartments shall comply with ICC A117.1, Section 608.7." .

ibc:sem-ibc2021-1110.2.3.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Water temperature shall comply with ICC A117.1, Section 608.8." .

ibc:sem-ibc2021-1110.2.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where water closet compartments are provided in a toilet room or bathing room, at least 5 percent of the total number of compartments shall be wheelchair accessible." .

ibc:sem-ibc2021-1110.2.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the combined total water closet compartments and urinals provided in a toilet room or bathing room is six or more, at least 5 percent of the total number of compartments shall be ambulatory accessible, provided in addition to the wheelchair-accessible compartment." .

ibc:sem-ibc2021-1110.2.4-condition-1 a ibco:Condition ;
    ibco:text "Where water closet compartments are provided in a toilet room or bathing room, at least 5 percent of the total number of compartments shall be wheelchair accessible." .

ibc:sem-ibc2021-1110.2.4-condition-2 a ibco:Condition ;
    ibco:text "Where the combined total water closet compartments and urinals provided in a toilet room or bathing room is six or more, at least 5 percent of the total number of compartments shall be ambulatory accessible, provided in addition to the wheelchair-accessible compartment." .

ibc:sem-ibc2021-1110.2.4-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.2.4-measurement-2 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.2.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where lavatories are provided, at least 5 percent, but not less than one, shall be accessible." .

ibc:sem-ibc2021-1110.2.5-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where an accessible lavatory is located within the accessible water closet compartment at least one additional accessible lavatory shall be provided in the multicompartment toilet room outside the water closet compartment." .

ibc:sem-ibc2021-1110.2.5-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the total lavatories provided in a toilet room or bathing facility is six or more, at least one lavatory with enhanced reach ranges shall be provided." .

ibc:sem-ibc2021-1110.2.5-condition-1 a ibco:Condition ;
    ibco:text "Where lavatories are provided, at least 5 percent, but not less than one, shall be accessible." .

ibc:sem-ibc2021-1110.2.5-condition-2 a ibco:Condition ;
    ibco:text "Where an accessible lavatory is located within the accessible water closet compartment at least one additional accessible lavatory shall be provided in the multicompartment toilet room outside the water closet compartment." .

ibc:sem-ibc2021-1110.2.5-condition-3 a ibco:Condition ;
    ibco:text "Where the total lavatories provided in a toilet room or bathing facility is six or more, at least one lavatory with enhanced reach ranges shall be provided." .

ibc:sem-ibc2021-1110.2.5-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where sinks are provided, at least 5 percent but not less than one provided in accessible spaces shall be accessible." .

ibc:sem-ibc2021-1110.3-condition-1 a ibco:Condition ;
    ibco:text "Where sinks are provided, at least 5 percent but not less than one provided in accessible spaces shall be accessible." .

ibc:sem-ibc2021-1110.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1110.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where kitchens and kitchenettes are provided in accessible spaces or rooms, they shall be accessible." .

ibc:sem-ibc2021-1110.4-condition-1 a ibco:Condition ;
    ibco:text "Where kitchens and kitchenettes are provided in accessible spaces or rooms, they shall be accessible." .

ibc:sem-ibc2021-1110.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where drinking fountains are provided on an exterior site, on a floor or within a secured area, the drinking fountains shall be provided in accordance with Sections 1110.5.1 and 1110.5.2." .

ibc:sem-ibc2021-1110.5-condition-1 a ibco:Condition ;
    ibco:text "Where drinking fountains are provided on an exterior site, on a floor or within a secured area, the drinking fountains shall be provided in accordance with Sections 1110." .

ibc:sem-ibc2021-1110.5.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Not fewer than two drinking fountains shall be provided." .

ibc:sem-ibc2021-1110.5.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "One drinking fountain shall comply with the requirements for people who use a wheelchair and one drinking fountain shall comply with the requirements for standing persons." .

ibc:sem-ibc2021-1110.5.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "A single drinking fountain with two separate spouts that complies with the requirements for people who use a wheelchair and standing persons shall be permitted to be substituted for two separate drinking fountains." .

ibc:sem-ibc2021-1110.5.1-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:sem-ibc2021-1110.5.1-condition-1 a ibco:Condition ;
    ibco:text "Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117." .

ibc:sem-ibc2021-1110.5.1-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.5.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where more than the minimum number of drinking fountains specified in Section 1110.5.1 is provided, 50 percent of the total number of drinking fountains provided shall comply with the requirements for persons who use a wheelchair and 50 percent of the total number of drinking fountains provided shall comply with the requirements for standing persons." .

ibc:sem-ibc2021-1110.5.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where 50 percent of the drinking fountains yields a fraction, 50 percent shall be permitted to be rounded up or down, provided that the total number of drinking fountains complying with this section equals 100 percent of the drinking fountains." .

ibc:sem-ibc2021-1110.5.2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117.1 and drinking fountains for standing children shall be permitted to provide the spout at 30 inches (762 mm) minimum above the floor." .

ibc:sem-ibc2021-1110.5.2-condition-1 a ibco:Condition ;
    ibco:text "Where more than the minimum number of drinking fountains specified in Section 1110." .

ibc:sem-ibc2021-1110.5.2-condition-2 a ibco:Condition ;
    ibco:text "Where 50 percent of the drinking fountains yields a fraction, 50 percent shall be permitted to be rounded up or down, provided that the total number of drinking fountains complying with this section equals 100 percent of the drinking fountains." .

ibc:sem-ibc2021-1110.5.2-condition-3 a ibco:Condition ;
    ibco:text "Where drinking fountains are primarily for children’s use, drinking fountains for people using wheelchairs shall be permitted to comply with the children’s provisions in ICC A117." .

ibc:sem-ibc2021-1110.5.2-condition-4 a ibco:Condition ;
    ibco:text "provided that the total number of drinking fountains complying with this section equals 100 percent of the drinking fountains." .

ibc:sem-ibc2021-1110.5.2-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.5.2-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.5.2-measurement-3 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.5.2-measurement-4 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1110.5.2-measurement-5 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 100.0 .

ibc:sem-ibc2021-1110.5.2-measurement-6 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 30.0 .

ibc:sem-ibc2021-1110.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where bottle-filling stations are provided, they shall be accessible." .

ibc:sem-ibc2021-1110.6-condition-1 a ibco:Condition ;
    ibco:text "Where bottle-filling stations are provided, they shall be accessible." .

ibc:sem-ibc2021-1110.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where provided, saunas and steam rooms shall be accessible." .

ibc:sem-ibc2021-1110.7-condition-1 a ibco:Condition ;
    ibco:text "Where provided, saunas and steam rooms shall be accessible." .

ibc:sem-ibc2021-1110.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Passenger elevators on an accessible route shall be accessible and comply with Chapter 30." .

ibc:sem-ibc2021-1110.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "permission" ;
    ibco:text "Platform (wheelchair) lifts are permitted to be a part of a required accessible route in new construction where indicated in Items 1 through 10." .

ibc:sem-ibc2021-1110.9-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Platform (wheelchair) lifts shall be installed in accordance with ASME A18.1." .

ibc:sem-ibc2021-1110.9-condition-1 a ibco:Condition ;
    ibco:text "where indicated in Items 1 through 10." .

ibc:sem-ibc2021-1111.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Recreational facilities shall be provided with accessible features in accordance with Sections 1111.2 through 1111.4." .

ibc:sem-ibc2021-1111.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Recreational facilities that serve Group R-2, R-3 and Group R-4 occupancies shall comply with Sections 1111.2.1 through 1111.2.3, as applicable." .

ibc:sem-ibc2021-1111.2.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2 and R-4 occupancies where recreational facilities serve Accessible units, every recreational facility of each type serving Accessible units shall be accessible." .

ibc:sem-ibc2021-1111.2.1-condition-1 a ibco:Condition ;
    ibco:text "where recreational facilities serve Accessible units, every recreational facility of each type serving Accessible units shall be accessible." .

ibc:sem-ibc2021-1111.2.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2, R-3 and R-4 occupancies where recreational facilities serve a single building containing Type A units or Type B units, 25 percent, but not less than one, of each type of recreational facility shall be accessible." .

ibc:sem-ibc2021-1111.2.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Every recreational facility of each type on a site shall be considered to determine the total number of each type that is required to be accessible." .

ibc:sem-ibc2021-1111.2.2-condition-1 a ibco:Condition ;
    ibco:text "where recreational facilities serve a single building containing Type A units or Type B units, 25 percent, but not less than one, of each type of recreational facility shall be accessible." .

ibc:sem-ibc2021-1111.2.2-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 25.0 .

ibc:sem-ibc2021-1111.2.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group R-2, R-3 and R-4 occupancies on a single site where multiple buildings containing Type A units or Type B units are served by recreational facilities, 25 percent, but not less than one, of each type of recreational facility serving each building shall be accessible." .

ibc:sem-ibc2021-1111.2.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "obligation" ;
    ibco:text "The total number of each type of recreational facility that is required to be accessible shall be determined by considering every recreational facility of each type serving each building on the site." .

ibc:sem-ibc2021-1111.2.3-condition-1 a ibco:Condition ;
    ibco:text "where multiple buildings containing Type A units or Type B units are served by recreational facilities, 25 percent, but not less than one, of each type of recreational facility serving each building shall be accessible." .

ibc:sem-ibc2021-1111.2.3-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 25.0 .

ibc:sem-ibc2021-1111.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Recreational facilities not falling within the purview of Section 1111.2 shall be accessible." .

ibc:sem-ibc2021-1111.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Recreational facilities shall be accessible and shall be on an accessible route to the extent specified in this section." .

ibc:sem-ibc2021-1111.4.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Each area of sport activity shall be on an accessible route and shall not be required to be accessible except as provided for in Sections 1111.4.2 through 1111.4.15." .

ibc:sem-ibc2021-1111.4.10-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one of each type of exercise machine and equipment shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.11-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Fishing piers and platforms shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.12-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Miniature golf facilities shall comply with Sections 1111.4.12.1 through 1111.4.12.3." .

ibc:sem-ibc2021-1111.4.12.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least 50 percent of holes on miniature golf courses shall be accessible." .

ibc:sem-ibc2021-1111.4.12.1-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-1111.4.12.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Miniature golf courses shall be configured so that the accessible holes are consecutive." .

ibc:sem-ibc2021-1111.4.12.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Miniature golf courses shall provide an accessible route from the last accessible hole to the course entrance or exit without requiring travel through any other holes on the course." .

ibc:sem-ibc2021-1111.4.12.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Holes required to comply with Section 1111.4.12.1, including the start of play, shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.13-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Play areas containing play components designed and constructed for children shall be located on an accessible route." .

ibc:sem-ibc2021-1111.4.14-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Swimming pools, wading pools, cold baths, hot tubs and spas shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.14-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Catch pools or a designated section of a pool used as a terminus for a water slide flume shall not be required to provide an accessible means of entry, provided that a portion of the catch pool edge is on an accessible route." .

ibc:sem-ibc2021-1111.4.14-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where spas, cold baths or hot tubs are provided in a cluster, at least 5 percent, but not less than one of each type of spa, cold bath or hot tub in each cluster, shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.14-atomic-4 a ibco:AtomicRule ;
    ibco:modality "required" ;
    ibco:statementType "exception" ;
    ibco:text "Swimming pools, wading pools, spas, cold baths and hot tubs that are required to be accessible by Sections 1111.2.2 and 1111.2.3 are not required to provide accessible means of entry into the water." .

ibc:sem-ibc2021-1111.4.14-condition-1 a ibco:Condition ;
    ibco:text "Where spas, cold baths or hot tubs are provided in a cluster, at least 5 percent, but not less than one of each type of spa, cold bath or hot tub in each cluster, shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.14-condition-2 a ibco:Condition ;
    ibco:text "provided that a portion of the catch pool edge is on an accessible route." .

ibc:sem-ibc2021-1111.4.14-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1111.4.14.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Raised diving boards and diving platforms are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.14.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Water slides are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.15-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where shooting facilities with firing positions are designed and constructed at a site, at least 5 percent, but not less than one, of each type of firing position shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.15-condition-1 a ibco:Condition ;
    ibco:text "Where shooting facilities with firing positions are designed and constructed at a site, at least 5 percent, but not less than one, of each type of firing position shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.15-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1111.4.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At least one wheelchair space shall be provided in team or player seating areas serving areas of sport activity." .

ibc:sem-ibc2021-1111.4.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "An accessible route shall be provided to at least 5 percent, but not less than one, of each type of bowling lane." .

ibc:sem-ibc2021-1111.4.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1111.4.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In court sports, at least one accessible route shall directly connect both sides of the court." .

ibc:sem-ibc2021-1111.4.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Raised boxing or wrestling rings are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.6-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Raised structures used solely for refereeing, judging or scoring a sport are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.7-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exemption" ;
    ibco:text "Animal containment areas that are not within public use areas are not required to be accessible or to be on an accessible route." .

ibc:sem-ibc2021-1111.4.8-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Amusement rides that move persons through a fixed course within a defined area shall comply with Sections 1111.4.8.1 through 1111.4.8.3." .

ibc:sem-ibc2021-1111.4.8.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Load and unload areas serving amusement rides shall be accessible and be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where load and unload areas have more than one loading or unloading position, at least one loading and unloading position shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.1-condition-1 a ibco:Condition ;
    ibco:text "Where load and unload areas have more than one loading or unloading position, at least one loading and unloading position shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where amusement rides are in the load and unload position, the following shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.2-condition-1 a ibco:Condition ;
    ibco:text "Where amusement rides are in the load and unload position, the following shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.8.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Amusement rides shall provide at least one wheelchair space, amusement ride seat designed for transfer or transfer device." .

ibc:sem-ibc2021-1111.4.8.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Amusement rides that are controlled or operated by the rider are not required to comply with this section." .

ibc:sem-ibc2021-1111.4.8.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Amusement rides designed primarily for children, where children are assisted on and off the ride by an adult, are not required to comply with this section." .

ibc:sem-ibc2021-1111.4.8.3-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Amusement rides that do not provide seats that are built-in or mechanically fastened shall not be required to comply with this section." .

ibc:sem-ibc2021-1111.4.8.3-condition-1 a ibco:Condition ;
    ibco:text "where children are assisted on and off the ride by an adult, are not required to comply with this section." .

ibc:sem-ibc2021-1111.4.9-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Boat slips required to be accessible by Sections 1111.4.9.1 and 1111.4.9.2 and boarding piers at boat launch ramps required to be accessible by Section 1111.4.9.3 shall be on an accessible route." .

ibc:sem-ibc2021-1111.4.9.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible boat slips shall be provided in accordance with Table 1111.4.9.1." .

ibc:sem-ibc2021-1111.4.9.1-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "All units on the site shall be combined to determine the number of accessible boat slips required." .

ibc:sem-ibc2021-1111.4.9.1-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where the number of boat slips is not identified, each 40 feet (12 m) of boat slip edge provided along the perimeter of the pier shall be counted as one boat slip for the purpose of this section." .

ibc:sem-ibc2021-1111.4.9.1-condition-1 a ibco:Condition ;
    ibco:text "Where the number of boat slips is not identified, each 40 feet (12 m) of boat slip edge provided along the perimeter of the pier shall be counted as one boat slip for the purpose of this section." .

ibc:sem-ibc2021-1111.4.9.1-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT" ;
    ibco:value 40.0 .

ibc:sem-ibc2021-1111.4.9.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible boat slips shall be dispersed throughout the various types of boat slips provided." .

ibc:sem-ibc2021-1111.4.9.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "prohibition" ;
    ibco:text "Where the minimum number of accessible boat slips has been met, further dispersion shall not be required." .

ibc:sem-ibc2021-1111.4.9.2-condition-1 a ibco:Condition ;
    ibco:text "Where the minimum number of accessible boat slips has been met, further dispersion shall not be required." .

ibc:sem-ibc2021-1111.4.9.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where boarding piers are provided at boat launch ramps, at least 5 percent, but not less than one, of the boarding piers shall be accessible." .

ibc:sem-ibc2021-1111.4.9.3-condition-1 a ibco:Condition ;
    ibco:text "Where boarding piers are provided at boat launch ramps, at least 5 percent, but not less than one, of the boarding piers shall be accessible." .

ibc:sem-ibc2021-1111.4.9.3-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-1112.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Required accessible elements shall be identified by the International Symbol of Accessibility at the following locations." .

ibc:sem-ibc2021-1112.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Signs required in Section 403.4 of the International Plumbing Code identifying toilet rooms and bathing rooms shall be visual characters, raised characters and braille complying with ICC A117.1." .

ibc:sem-ibc2021-1112.2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where pictograms are provided as designations for toilet rooms and bathing rooms, the pictograms shall have visual characters, raised characters and braille complying with ICC A117.1." .

ibc:sem-ibc2021-1112.2-condition-1 a ibco:Condition ;
    ibco:text "Where pictograms are provided as designations for toilet rooms and bathing rooms, the pictograms shall have visual characters, raised characters and braille complying with ICC A117." .

ibc:sem-ibc2021-1112.3-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Directional signage indicating the route to the nearest like accessible element shall be provided at the following locations." .

ibc:sem-ibc2021-1112.3-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "These directional signs shall include the International Symbol of Accessibility and sign characters shall meet the visual character requirements in accordance with ICC A117.1." .

ibc:sem-ibc2021-1112.3-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "At exits and exit stairways serving a required accessible space, but not providing an approved accessible means of egress, signage shall be provided in accordance with Section 1009.10." .

ibc:sem-ibc2021-1112.3-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where drinking fountains for persons using wheelchairs and drinking fountains for standing persons are not located adjacent to each other, directional signage shall be provided indicating the location of the other drinking fountains." .

ibc:sem-ibc2021-1112.3-condition-1 a ibco:Condition ;
    ibco:text "where provided in accordance with Section 1110." .

ibc:sem-ibc2021-1112.3-condition-2 a ibco:Condition ;
    ibco:text "Where drinking fountains for persons using wheelchairs and drinking fountains for standing persons are not located adjacent to each other, directional signage shall be provided indicating the location of the other drinking fountains." .

ibc:sem-ibc2021-1112.4-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Signage indicating special accessibility provisions shall be provided as shown." .

ibc:sem-ibc2021-1112.4-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Each assembly area required to comply with Section 1109.2.7 shall provide a sign notifying patrons of the availability of assistive listening systems." .

ibc:sem-ibc2021-1112.4-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The sign shall comply with ICC A117.1 requirements for visual characters and include the International Symbol of Access for Hearing Loss." .

ibc:sem-ibc2021-1112.5-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where provided in the locations in Sections 1112.5.1 and 1112.5.2, variable message signs shall comply with the variable message sign requirements of ICC A117.1." .

ibc:sem-ibc2021-1112.5-condition-1 a ibco:Condition ;
    ibco:text "Where provided in the locations in Sections 1112." .

ibc:sem-ibc2021-1112.5.1-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where provided in transportation facilities, variable message signs conveying transportation-related information shall comply with Section 1112.5." .

ibc:sem-ibc2021-1112.5.1-condition-1 a ibco:Condition ;
    ibco:text "Where provided in transportation facilities, variable message signs conveying transportation-related information shall comply with Section 1112." .

ibc:sem-ibc2021-1112.5.2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Where provided in buildings that are designated as emergency shelters, variable message signs conveying emergency-related information shall comply with Section 1112.5." .

ibc:sem-ibc2021-1112.5.2-condition-1 a ibco:Condition ;
    ibco:text "Where provided in buildings that are designated as emergency shelters, variable message signs conveying emergency-related information shall comply with Section 1112." .

ibc:sem-ibc2021-2-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In Group I-1, Condition 2, at least 10 percent, but not less than one, of the dwelling units and sleeping units shall be Accessible units." .

ibc:sem-ibc2021-2-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "Accessible dwelling units and sleeping units shall be dispersed among the various classes of units." .

ibc:sem-ibc2021-2-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of the Accessible units." .

ibc:sem-ibc2021-2-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-intype showers comply with Section 1110.2.3, in not more than 50 percent of the Accessible units." .

ibc:sem-ibc2021-2-condition-1 a ibco:Condition ;
    ibco:text "where such water closets comply with Section 1110." .

ibc:sem-ibc2021-2-condition-2 a ibco:Condition ;
    ibco:text "where roll-intype showers comply with Section 1110." .

ibc:sem-ibc2021-2-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 10.0 .

ibc:sem-ibc2021-2-measurement-2 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-2-measurement-3 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 50.0 .

ibc:sem-ibc2021-4-0291-condition-1 a ibco:Condition ;
    ibco:text "where not all toilet or bathing rooms are accessible." .

ibc:sem-ibc2021-5-0292-condition-1 a ibco:Condition ;
    ibco:text "where not all entrances are accessible." .

ibc:sem-ibc2021-6-0293-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "The sign, where provided, shall be above the check-out aisle in the same location as the checkout aisle number or type of check-out identification. " .

ibc:sem-ibc2021-6-0293-condition-1 a ibco:Condition ;
    ibco:text "where not all aisles are accessible." .

ibc:sem-ibc2021-6-0293-condition-2 a ibco:Condition ;
    ibco:text "where provided, shall be above the check-out aisle in the same location as the checkout aisle number or type of check-out identification." .

ibc:sem-ibc2021-7-0294-condition-1 a ibco:Condition ;
    ibco:text "where not all such rooms are accessible." .

ibc:sem-ibc2021-a-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "obligation" ;
    ibco:text "In mixed-use facilities where the total sum of the building occupant load is greater than those listed, the most restrictive building occupant load shall apply." .

ibc:sem-ibc2021-a-condition-1 a ibco:Condition ;
    ibco:text "where the total sum of the building occupant load is greater than those listed, the most restrictive building occupant load shall apply." .

ibc:sem-ibc2021-n0027-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Other than in buildings or facilities containing or serving Type B units, an accessible route shall not be required between site arrival points and the building or facility entrance if the only means of access between them is a vehicular way not providing for pedestrian access." .

ibc:sem-ibc2021-n0027-condition-1 a ibco:Condition ;
    ibco:text "if the only means of access between them is a vehicular way not providing for pedestrian access." .

ibc:sem-ibc2021-n0027-condition-2 a ibco:Condition ;
    ibco:text "Other than in buildings or facilities containing or serving Type B units, an accessible route shall not be required between site arrival points and the building or facility entrance if the only means of access between them is a vehicular way not providing for pedestrian access." .

ibc:sem-ibc2021-n0035-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where security barriers incorporate elements that cannot comply with these requirements, such as certain metal detectors, fluoroscopes or other similar devices, the accessible route shall be permitted to be provided adjacent to security screening devices." .

ibc:sem-ibc2021-n0035-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "The accessible route shall permit persons with disabilities passing around security barriers to maintain visual contact with their personal items to the same extent provided others passing through the security barrier." .

ibc:sem-ibc2021-n0035-condition-1 a ibco:Condition ;
    ibco:text "Where security barriers incorporate elements that cannot comply with these requirements, such as certain metal detectors, fluoroscopes or other similar devices, the accessible route shall be permitted to be provided adjacent to security screening devices." .

ibc:sem-ibc2021-n0046-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible entrance is not required to self-service storage facilities that are not required to be accessible." .

ibc:sem-ibc2021-n0048-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "An accessible entrance is not required to dwelling units and sleeping units that are not required to be Accessible units, Type A units or Type B units." .

ibc:sem-ibc2021-n0052-atomic-1 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "This section does not apply to parking spaces used exclusively for buses, trucks, other delivery vehicles, law enforcement vehicles or vehicular impound and motor pools where lots accessed by the public are provided with an accessible passenger loading zone." .

ibc:sem-ibc2021-n0052-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "TABLE 1106.2 ACCESSIBLE PARKING SPACES" .

ibc:sem-ibc2021-n0052-condition-1 a ibco:Condition ;
    ibco:text "where lots accessed by the public are provided with an accessible passenger loading zone." .

ibc:sem-ibc2021-n0057-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "In Group U private garages that serve Group R-2 and R-3 occupancies, van-accessible spaces shall be permitted to have vehicular routes, entrances, parking spaces and access aisles with a minimum vertical clearance of 7 feet (2134 mm)." .

ibc:sem-ibc2021-n0057-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "FT" ;
    ibco:value 7.0 .

ibc:sem-ibc2021-n0068-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Electrical vehicle charging stations provided to serve Group R-2, R-3 and R-4 occupancies are not required to comply with this section." .

ibc:sem-ibc2021-n0083-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0087-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0090-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Entry doors to Accessible dwelling units or sleeping units shall not be required to provide the maneuvering clearance beyond the latch side of the door." .

ibc:sem-ibc2021-n0092-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0097-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Cells or rooms specially designed without protrusions and that are used solely for purposes of suicide prevention shall not be required to include grab bars." .

ibc:sem-ibc2021-n0103-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0106-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0110-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0114-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0116-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0120-atomic-1 a ibco:AtomicRule ;
    ibco:modality "may" ;
    ibco:statementType "exception" ;
    ibco:text "The number of Type B units is permitted to be reduced in accordance with Section 1108.7." .

ibc:sem-ibc2021-n0140-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Designated aisle seats are not required in team or player seating serving areas of sport activity." .

ibc:sem-ibc2021-n0143-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Other than in courtrooms, an assistive listening system is not required where there is no audio amplification system." .

ibc:sem-ibc2021-n0143-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "TABLE 1109.2.7.1" .

ibc:sem-ibc2021-n0143-condition-1 a ibco:Condition ;
    ibco:text "where there is no audio amplification system." .

ibc:sem-ibc2021-n0143-condition-2 a ibco:Condition ;
    ibco:text "Other than in courtrooms, an assistive listening system is not required where there is no audio amplification system." .

ibc:sem-ibc2021-n0156-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Adjacent companion seating is not required." .

ibc:sem-ibc2021-n0166-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Accessible units, Type A units and Type B units shall comply with Chapter 10 of ICC A117.1." .

ibc:sem-ibc2021-n0169-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where each separate-sex bathing room has only one shower or bathtub fixture, a family or assisted-use bathing room is not required." .

ibc:sem-ibc2021-n0169-condition-1 a ibco:Condition ;
    ibco:text "Where each separate-sex bathing room has only one shower or bathtub fixture, a family or assisted-use bathing room is not required." .

ibc:sem-ibc2021-n0172-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "The following additional fixtures shall be permitted in a family or assisted-use toilet room: 1." .

ibc:sem-ibc2021-n0172-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "A urinal." .

ibc:sem-ibc2021-n0172-atomic-3 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "A child-height water closet." .

ibc:sem-ibc2021-n0172-atomic-4 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "A child-height lavatory." .

ibc:sem-ibc2021-n0192-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "The back-wall grab bar shall not be required to exceed 48 inches (1220 mm) in length." .

ibc:sem-ibc2021-n0192-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "The rear grab bar shall be located with one end within 6 inches maximum of a sidewall with a grab bar complying with Section 1110.2.3.3.2." .

ibc:sem-ibc2021-n0192-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 48.0 .

ibc:sem-ibc2021-n0192-measurement-2 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "IN" ;
    ibco:value 6.0 .

ibc:sem-ibc2021-n0203-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Mop or service sinks are not required to be accessible." .

ibc:sem-ibc2021-n0209-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Bottle-filling stations over drinking fountains for standing persons are not required to be accessible, provided that bottle-filling stations are also located over the drinking fountains for persons using wheelchairs." .

ibc:sem-ibc2021-n0209-condition-1 a ibco:Condition ;
    ibco:text "provided that bottle-filling stations are also located over the drinking fountains for persons using wheelchairs." .

ibc:sem-ibc2021-n0211-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where saunas or steam rooms are clustered at a single location, at least 5 percent of the saunas and steam rooms, but not less than one, of each type in each cluster shall be accessible." .

ibc:sem-ibc2021-n0211-condition-1 a ibco:Condition ;
    ibco:text "Where saunas or steam rooms are clustered at a single location, at least 5 percent of the saunas and steam rooms, but not less than one, of each type in each cluster shall be accessible." .

ibc:sem-ibc2021-n0211-measurement-1 a ibco:Measurement ;
    ibco:operator "greater_than_or_equal" ;
    ibco:unitCode "PERCENT" ;
    ibco:value 5.0 .

ibc:sem-ibc2021-n0228-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Detectable warnings are not required at bus stops." .

ibc:sem-ibc2021-n0230-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Check-writing surfaces at check-out aisles not required to comply with Section 1110.13.1 are not required to be accessible." .

ibc:sem-ibc2021-n0234-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "This requirement shall not apply to the detainee side of cubicles or counters at noncontact visiting areas not serving Accessible unit holding cells." .

ibc:sem-ibc2021-n0238-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Where the public use area is under 5,000 square feet (465 m2) not more than one accessible check-out aisle shall be required." .

ibc:sem-ibc2021-n0238-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "TABLE 1110.13.1 ACCESSIBLE CHECK-OUT AISLES" .

ibc:sem-ibc2021-n0238-condition-1 a ibco:Condition ;
    ibco:text "Where the public use area is under 5,000 square feet (465 m2) not more than one accessible check-out aisle shall be required." .

ibc:sem-ibc2021-n0238-measurement-1 a ibco:Measurement ;
    ibco:operator "equal_or_context_dependent" ;
    ibco:unitCode "FT2" ;
    ibco:value 0.0 .

ibc:sem-ibc2021-n0255-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Wheelchair spaces shall not be required in team or player seating areas serving bowling lanes that are not required to be accessible in accordance with Section 1111.4.3." .

ibc:sem-ibc2021-n0262-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall_not" ;
    ibco:statementType "exception" ;
    ibco:text "Mobile or portable amusement rides shall not be required to be accessible." .

ibc:sem-ibc2021-n0268-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Boat slips not designed for embarking or disembarking are not required to be accessible or be on an accessible route." .

ibc:sem-ibc2021-n0268-atomic-2 a ibco:AtomicRule ;
    ibco:modality "unspecified" ;
    ibco:statementType "exception" ;
    ibco:text "TABLE 1111.4.9.1 BOAT SLIPS" .

ibc:sem-ibc2021-n0276-atomic-1 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "One break in the sequence of consecutive holes shall be permitted provided that the last hole on the miniature golf course is the last hole in the sequence." .

ibc:sem-ibc2021-n0276-condition-1 a ibco:Condition ;
    ibco:text "provided that the last hole on the miniature golf course is the last hole in the sequence." .

ibc:sem-ibc2021-n0283-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Shooting facilities with firing positions on free-standing platforms that are elevated more than 12 feet (3660 mm) above grade, provided that the aggregate area of the elevated firing positions is not more than 500 square feet (46 m2), are not required to be accessible." .

ibc:sem-ibc2021-n0283-condition-1 a ibco:Condition ;
    ibco:text "provided that the aggregate area of the elevated firing positions is not more than 500 square feet (46 m2), are not required to be accessible." .

