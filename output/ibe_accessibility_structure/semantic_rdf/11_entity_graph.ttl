    ibco:sourceNode ibc:ibc2021-1108.6.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.4 Group R-4. Accessible units and Type B units shall be provided in Group R-4 occupancies in accordance with Sections 1108.6.4.1 and 1108.6.4.2. Bedrooms in Group R-4 facilities shall be counted as sleeping units for the purpose of determining the number of units." .

ibc:sem-ibc2021-1108.6.4.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.4.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.4.1-atomic-1,
        ibc:sem-ibc2021-1108.6.4.1-atomic-2 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.4.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.4.1 Accessible units. In Group R-4, Condition 1, at least one of the sleeping units shall be an Accessible unit. In Group R-4, Condition 2, at least two of the sleeping units shall be an Accessible unit." .

ibc:sem-ibc2021-1108.6.4.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.4.2 ;
    ibco:appliesTo ibc:concept-sleepingunit,
