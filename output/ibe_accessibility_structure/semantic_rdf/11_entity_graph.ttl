    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5 Group I. Accessible units and Type B units shall be provided in Group I occupancies in accordance with Sections 1108.5.1 through 1108.5.5." .

ibc:sem-ibc2021-1108.5.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-5-1-1,
