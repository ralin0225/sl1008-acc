    ibco:sourceNode ibc:ibc2021-1108.5.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.1 Group I-1. Accessible units and Type B units shall be provided in Group I-1 occupancies in accordance with Sections 1108.5.1.1 and 1108.5.1.3." .

ibc:sem-ibc2021-1108.5.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.1.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.1.1-atomic-1,
        ibc:sem-ibc2021-1108.5.1.1-atomic-2,
        ibc:sem-ibc2021-1108.5.1.1-atomic-3,
        ibc:sem-ibc2021-1108.5.1.1-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.5.1.1-condition-1,
        ibc:sem-ibc2021-1108.5.1.1-condition-2 ;
