        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.4-atomic-1,
        ibc:sem-ibc2021-1108.5.4-atomic-2,
        ibc:sem-ibc2021-1108.5.4-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.5.4-condition-1,
        ibc:sem-ibc2021-1108.5.4-condition-2 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.5.4-measurement-1,
        ibc:sem-ibc2021-1108.5.4-measurement-2,
        ibc:sem-ibc2021-1108.5.4-measurement-3 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1110-2-2,
        ibc:ibc2021-1110-2-3 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.5.4 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.4 Group I-2 rehabilitation facilities. In hospitals and rehabilitation facilities of Group I-2 occupancies that specialize in treating conditions that affect mobility, or units within either that specialize in treating conditions that affect mobility, 100 percent of the dwelling units and sleeping units shall be Accessible units. Exceptions: 1. Water closets shall not be required to comply with ICC A117.1 where such water closets comply with Section 1110.2.2, in not more than 50 percent of Accessible units. 2. Roll-in-type showers shall not be required to comply with ICC A117.1 where roll-in-type showers comply with Section 1110.2.3, in not more than 50 percent of Accessible units." .

ibc:sem-ibc2021-1108.5.5 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.5 ;
    ibco:appliesTo ibc:concept-accessibleunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.5-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-5-5-1,
        ibc:ibc2021-1108-5-5-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.5.5 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.5 Group I-3. Accessible units shall be provided in Group I-3 occupancies in accordance with Sections 1108.5.5.1 through 1108.5.5.3." .

ibc:sem-ibc2021-1108.5.5.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.5.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.5.1-atomic-1 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.5.5.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "numerical" ;
    ibco:sourceNode ibc:ibc2021-1108.5.5.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.5.1 Group I-3 sleeping units. In Group I-3 occupancies, at least 3 percent of the total number of sleeping units in the facility, but not less than one unit in each classification level, shall be Accessible units." .

ibc:sem-ibc2021-1108.5.5.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.5.2 ;
    ibco:appliesTo ibc:concept-accessibleunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.5.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.5.5.2-condition-1 ;
    ibco:hasException ibc:ibc2021-n0097 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-5-5-1 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical",
        "numerical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.5.5.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.5.2 Special holding cells and special housing cells or rooms. In addition to the Accessible units required by Section 1108.5.5.1, where special holding cells or special housing cells or rooms are provided, at least one serving each purpose shall be an Accessible unit. Cells or rooms subject to this requirement include, but are not limited to, those used for purposes of orientation, protective custody, administrative or disciplinary detention or segregation, detoxification and medical isolation." .

ibc:sem-ibc2021-1108.5.5.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.5.5.3 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.5.5.3-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-5-5-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.5.5.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.5.5.3 Medical care facilities. Patient sleeping units or cells required to be Accessible units in medical care facilities shall be provided in addition to any medical isolation cells required to comply with Section 1108.5.5.2." .

ibc:sem-ibc2021-1108.6 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-1,
        ibc:ibc2021-1108-6-4 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6 Group R. Accessible units, Type A units and Type B units shall be provided in Group R occupancies in accordance with Sections 1108.6.1 through 1108.6.4." .

ibc:sem-ibc2021-1108.6.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.1-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-1-1,
        ibc:ibc2021-1108-6-1-2 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.1 Group R-1. Accessible units and Type B units shall be provided in Group R-1 occupancies in accordance with Sections 1108.6.1.1 and 1108.6.1.2." .

ibc:sem-ibc2021-1108.6.1.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.1.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility,
        ibc:concept-dwellingunit,
        ibc:concept-sleepingunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.1.1-atomic-1,
        ibc:sem-ibc2021-1108.6.1.1-atomic-2,
        ibc:sem-ibc2021-1108.6.1.1-atomic-3,
        ibc:sem-ibc2021-1108.6.1.1-atomic-4 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.1.1-condition-1,
        ibc:sem-ibc2021-1108.6.1.1-condition-2 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-1-1 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.1.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.1.1 Accessible units. Accessible dwelling units and sleeping units shall be provided in accordance with Table 1108.6.1.1. On a multiple-building site, where structures contain more than 50 dwelling units or sleeping units, the number of Accessible units shall be determined per structure. On a multiple-building site, where structures contain 50 or fewer dwelling units or sleeping units, all dwelling units and sleeping units on a site shall be considered to determine the total number of Accessible units. Accessible units shall be dispersed among the various classes of units." .

ibc:sem-ibc2021-1108.6.1.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.1.2 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.1.2-atomic-1 ;
    ibco:hasException ibc:ibc2021-n0103 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "categorical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.1.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.1.2 Type B units. In structures with four or more dwelling units or sleeping units intended to be occupied as a residence, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2-atomic-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-2-1,
        ibc:ibc2021-1108-6-2-3 ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2 Group R-2. Accessible units, Type A units and Type B units shall be provided in Group R-2 occupancies in accordance with Sections 1108.6.2.1 through 1108.6.2.3." .

ibc:sem-ibc2021-1108.6.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.1 ;
    ibco:appliesTo ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.1-atomic-1,
        ibc:sem-ibc2021-1108.6.2.1-atomic-2 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.2.1-condition-1 ;
    ibco:hasException ibc:ibc2021-n0106 ;
    ibco:modality "required" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.1 Live/work units. In live/work units constructed in accordance with Section 419, the nonresidential portion is required to be accessible. In a structure where there are four or more live/work units intended to be occupied as a residence, the residential portion of the live/work unit shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.2 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typeaunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.2-atomic-1,
        ibc:sem-ibc2021-1108.6.2.2-atomic-2,
        ibc:sem-ibc2021-1108.6.2.2-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.2.2-condition-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-1-1,
        ibc:ibc2021-1108-6-2-2-1,
        ibc:ibc2021-1108-6-2-2-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.2 Apartment houses, monasteries and convents. Type A units and Type B units shall be provided in apartment houses, monasteries and convents in accordance with Sections 1108.6.2.2.1 and 1108.6.2.2.2. Bedrooms in monasteries and convents shall be counted as units for the purpose of determining the number of units. Where the bedrooms are grouped in sleeping units, only one bedroom in each sleeping unit shall count toward the number of required Type A units. TABLE 1108.6.1.1 ACCESSIBLE DWELLING UNITS AND SLEEPING UNITS" .

ibc:sem-ibc2021-1108.6.2.2.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.2.1 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typeaunit ;
    ibco:confidence 0.81 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.2.1-atomic-1,
        ibc:sem-ibc2021-1108.6.2.2.1-atomic-2,
        ibc:sem-ibc2021-1108.6.2.2.1-atomic-3,
        ibc:sem-ibc2021-1108.6.2.2.1-atomic-4,
        ibc:sem-ibc2021-1108.6.2.2.1-atomic-5 ;
    ibco:hasMeasurement ibc:sem-ibc2021-1108.6.2.2.1-measurement-1 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-7 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "numerical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2.2.1 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.2.1 Type A units. In Group R-2 occupancies containing more than 20 dwelling units or sleeping units, at least 2 percent but not less than one of the units shall be a Type A unit. All Group R-2 units on a site shall be considered to determine the total number of units and the required number of Type A units. Type A units shall be dispersed among the various classes of units. Exceptions: 1. The number of Type A units is permitted to be reduced in accordance with Section 1108.7. 2. Existing structures on a site shall not contribute to the total number of units on a site." .

ibc:sem-ibc2021-1108.6.2.2.2 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.2.2 ;
    ibco:appliesTo ibc:concept-dwellingunit,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.93 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.2.2-atomic-1 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.2.2.2-condition-1 ;
    ibco:hasException ibc:ibc2021-n0110 ;
    ibco:modality "shall" ;
    ibco:reviewStatus "rule_validated" ;
    ibco:ruleType "logical" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2.2.2 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.2.2 Type B units. Where there are four or more dwelling units or sleeping units intended to be occupied as a residence in a single structure, every dwelling unit and sleeping unit intended to be occupied as a residence shall be a Type B unit." .

ibc:sem-ibc2021-1108.6.2.3 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.3 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-buildingorfacility,
        ibc:concept-sleepingunit,
        ibc:concept-typebunit ;
    ibco:confidence 0.73 ;
    ibco:hasAtomicRule ibc:sem-ibc2021-1108.6.2.3-atomic-1,
        ibc:sem-ibc2021-1108.6.2.3-atomic-2,
        ibc:sem-ibc2021-1108.6.2.3-atomic-3 ;
    ibco:hasCondition ibc:sem-ibc2021-1108.6.2.3-condition-1,
        ibc:sem-ibc2021-1108.6.2.3-condition-2,
        ibc:sem-ibc2021-1108.6.2.3-condition-3 ;
    ibco:modality "shall" ;
    ibco:references ibc:ibc2021-1108-6-2-1,
        ibc:ibc2021-1108-6-2-2,
        ibc:ibc2021-1108-6-2-3-1,
        ibc:ibc2021-1108-6-2-3-2 ;
    ibco:reviewStatus "unreviewed" ;
    ibco:ruleType "logical",
        "topological" ;
    ibco:sourceNode ibc:ibc2021-1108.6.2.3 ;
    ibco:statementType "obligation" ;
    ibco:text "1108.6.2.3 Group R-2 other than live/work units, apartment houses, monasteries and convents. In Group R-2 occupancies, other than live/work units, apartment houses, monasteries and convents falling within the scope of Sections 1108.6.2.1 and 1108.6.2.2, Accessible units and Type B units shall be provided in accordance with Sections 1108.6.2.3.1 and 1108.6.2.3.2. Bedrooms within congregate living facilities, dormitories, sororities, fraternities and boarding houses shall be counted as sleeping units for the purpose of determining the number of units. Where the bedrooms are grouped into dwelling or sleeping units, only one bedroom in each dwelling or sleeping unit shall be permitted to count toward the number of required Accessible units." .

ibc:sem-ibc2021-1108.6.2.3.1 a ibco:Requirement ;
    prov:wasDerivedFrom ibc:ibc2021-1108.6.2.3.1 ;
    ibco:appliesTo ibc:concept-accessibleunit,
        ibc:concept-dwellingunit,
