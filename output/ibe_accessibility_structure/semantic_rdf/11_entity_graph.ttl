    ibco:operator "greater_than" ;
    ibco:unitCode "FT" ;
    ibco:value 12.0 .

ibc:sem-ibc2021-n0283-measurement-2 a ibco:Measurement ;
    ibco:operator "less_than_or_equal" ;
    ibco:unitCode "FT2" ;
    ibco:value 500.0 .

ibc:sem-ibc2021-n0287-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where the total number of parking spaces provided is four or less, identification of accessible parking spaces is not required." .

ibc:sem-ibc2021-n0287-condition-1 a ibco:Condition ;
    ibco:text "Where the total number of parking spaces provided is four or less, identification of accessible parking spaces is not required." .

ibc:sem-ibc2021-n0289-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "In Group I-1, R-2, R-3 and R-4 facilities, where parking spaces are assigned to specific dwelling units or sleeping units, identification of accessible parking spaces is not required." .

ibc:sem-ibc2021-n0289-condition-1 a ibco:Condition ;
    ibco:text "where parking spaces are assigned to specific dwelling units or sleeping units, identification of accessible parking spaces is not required." .

ibc:sem-ibc2021-n0301-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where ticket offices or windows are provided, signs are not required at each assembly area provided that signs are displayed at each ticket office or window informing patrons of the availability of assistive listening systems." .

ibc:sem-ibc2021-n0301-atomic-2 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "At each door to an area of refuge providing direct access to a stairway, exterior area for assisted rescue, exit stairway, exit passageway or exit discharge, signage shall be provided in accordance with Section 1013.4." .

ibc:sem-ibc2021-n0301-atomic-3 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "At areas of refuge, signage shall be provided in accordance with Section 1009.11." .

ibc:sem-ibc2021-n0301-atomic-4 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "At exterior areas for assisted rescue, signage shall be provided in accordance with Section 1009.11." .

ibc:sem-ibc2021-n0301-atomic-5 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "At two-way communication systems, signage shall be provided in accordance with Section 1009.8.2." .

ibc:sem-ibc2021-n0301-atomic-6 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "In interior exit stairways and ramps, floor level signage shall be provided in accordance with Section 1023.9." .

ibc:sem-ibc2021-n0301-atomic-7 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "Signs identifying the type of access provided on amusement rides required to be accessible by Section 1111.4.8 shall be provided at entries to queues and waiting lines." .

ibc:sem-ibc2021-n0301-atomic-8 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "In addition, where accessible unload areas also serve as accessible load areas, signs indicating the location of the accessible load and unload areas shall be provided at entries to queues and waiting lines." .

ibc:sem-ibc2021-n0301-atomic-9 a ibco:AtomicRule ;
    ibco:modality "shall" ;
    ibco:statementType "exception" ;
    ibco:text "These directional sign characters shall meet the visual character requirements in accordance with ICC A117.1." .

ibc:sem-ibc2021-n0301-condition-1 a ibco:Condition ;
    ibco:text "Where ticket offices or windows are provided, signs are not required at each assembly area provided that signs are displayed at each ticket office or window informing patrons of the availability of assistive listening systems." .

ibc:sem-ibc2021-n0301-condition-2 a ibco:Condition ;
    ibco:text "where accessible unload areas also serve as accessible load areas, signs indicating the location of the accessible load and unload areas shall be provided at entries to queues and waiting lines." .

ibc:sem-ibc2021-n0301-condition-3 a ibco:Condition ;
    ibco:text "provided that signs are displayed at each ticket office or window informing patrons of the availability of assistive listening systems." .

ibc:sem-ibc2021-n0305-atomic-1 a ibco:AtomicRule ;
    ibco:modality "not_required" ;
    ibco:statementType "exception" ;
    ibco:text "Where equivalent information is provided in an audible manner, variable message signs are not required to comply with ICC A117.1." .

ibc:sem-ibc2021-n0305-condition-1 a ibco:Condition ;
    ibco:text "Where equivalent information is provided in an audible manner, variable message signs are not required to comply with ICC A117." .

