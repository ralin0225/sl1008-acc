            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0080 ;
        ibco:statementType "declarative" ;
        ibco:text "1.1. The hardware is mounted to the side of the door facing away from the adjacent wall where the door is in the open position." .

    ibc:sem-ibc2021-ch10-list_item-0081 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0081 ;
