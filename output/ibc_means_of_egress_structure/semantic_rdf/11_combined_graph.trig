        ibco:statementType "exception" ;
        ibco:text "Where approved, a delay of not more than 30 seconds is permitted on a delayed egress door." .

    ibc:sem-ibc2021-ch10-exception-0418-condition-1 a ibco:Condition ;
        ibco:text "Where approved, a delay of not more than 30 seconds is permitted on a delayed egress door." .

    ibc:sem-ibc2021-ch10-exception-0420-atomic-1 a ibco:AtomicRule ;
