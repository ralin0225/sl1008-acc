        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0564 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Spaces under stairways serving and contained within a single residential dwelling unit in Group R-2 or R-3 shall be permitted to be protected on the enclosed side with 1/2-inch (12.7 mm) gypsum board." .

    ibc:sem-ibc2021-ch10-exception-0567 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0567 ;
