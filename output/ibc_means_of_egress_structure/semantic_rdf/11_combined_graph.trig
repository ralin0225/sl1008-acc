    ibc:sem-ibc2021-ch10-exception-0957 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0957 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0957-atomic-1,
            ibc:sem-ibc2021-ch10-exception-0957-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-exception-0957-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-exception-0957-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-3104 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0957 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: A fire-resistance rating is not required at horizontal exits between a building area and an abovegrade pedestrian walkway constructed in accordance with Section 3104, provided that the distance between connected buildings is more than 20 feet (6096 mm). Horizontal exits constructed as fire barriers shall be continuous from exterior wall to exterior wall so as to divide completely the floor served by the horizontal exit." .

    ibc:sem-ibc2021-ch10-exception-0962 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0962 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-stairway ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0962-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-exception-0962-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0962 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: The adjoining compartment shall not be required to have a stairway or door leading directly outside, provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates." .

    ibc:sem-ibc2021-ch10-exception-0974 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0974 ;
