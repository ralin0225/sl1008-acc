    ibc:sem-ibc2021-ch10-exception-0099-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Where using refrigerants in quantities limited to the amounts based on the volume set forth in the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-exception-0099-condition-1 a ibco:Condition ;
        ibco:text "Where using refrigerants in quantities limited to the amounts based on the volume set forth in the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-exception-0113-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The path of egress travel to an exit shall be permitted to pass through more than one adjacent story in any of the following:" .

    ibc:sem-ibc2021-ch10-exception-0140-atomic-1 a ibco:AtomicRule ;
