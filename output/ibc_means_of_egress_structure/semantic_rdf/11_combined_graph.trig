    ibc:sem-ibc2021-ch10-exception-0424-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "Where approved, in Group I occupancies, the installation of a sign is not required where care recipients who because of clinical needs require restraint or containment as part of the function of the treatment area." .

    ibc:sem-ibc2021-ch10-exception-0424-condition-1 a ibco:Condition ;
        ibco:text "Where approved, in Group I occupancies, the installation of a sign is not required where care recipients who because of clinical needs require restraint or containment as part of the function of the treatment area." .

