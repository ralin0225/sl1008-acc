        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0461-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "A breakout force in excess of 180 pounds (801 N) is permitted if the breakout force is reduced to not more than 130 pounds (578 N) when not less than one of the following conditions is satisfied:" .

    ibc:sem-ibc2021-ch10-exception-0461-condition-1 a ibco:Condition ;
        ibco:text "if the breakout force is reduced to not more than 130 pounds (578 N) when not less than one of the following conditions is satisfied:" .

