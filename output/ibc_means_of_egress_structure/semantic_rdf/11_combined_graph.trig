        rdfs:label "The tolerance between adjacent risers on a stepped aisle that were designed to be equal height" .

    ibc:concept-those-portions-of-aisles-where-egress-is-possible-in-either-of-two-directions a ibco:DomainConcept ;
        rdfs:label "Those portions of aisles, where egress is possible in either of two directions" .

