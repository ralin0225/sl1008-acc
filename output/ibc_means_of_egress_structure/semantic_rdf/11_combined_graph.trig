            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.3.4 ;
        ibco:statementType "prohibition" ;
        ibco:text "1003.3.4 Clear width. Protruding objects shall not reduce the minimum clear width of accessible routes." .

    ibc:sem-ibc2021-1003.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.4 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.4-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1003.4 Slip-resistant surface. Circulation paths of the means of egress shall have a slip-resistant surface and be securely attached." .

    ibc:sem-ibc2021-1003.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.5 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.5-atomic-1,
            ibc:sem-ibc2021-1003.5-atomic-2,
            ibc:sem-ibc2021-1003.5-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1003.5-condition-1,
            ibc:sem-ibc2021-1003.5-condition-2,
            ibc:sem-ibc2021-1003.5-condition-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0031 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1003.5-measurement-1,
            ibc:sem-ibc2021-1003.5-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1003.5 Elevation change. Where changes in elevation of less than 12 inches (305 mm) exist in the means of egress, sloped surfaces shall be used. Where the slope is greater than one unit vertical in 20 units horizontal (5-percent slope), ramps complying with Section 1012 shall be used. Where the difference in elevation is 6 inches (152 mm) or less, the ramp shall be equipped with either handrails or floor finish materials that contrast with adjacent floor finish materials." .

    ibc:sem-ibc2021-1003.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.6 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.6-atomic-1,
            ibc:sem-ibc2021-1003.6-atomic-2,
            ibc:sem-ibc2021-1003.6-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1003.6-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.6 ;
        ibco:statementType "prohibition" ;
        ibco:text "1003.6 Means of egress continuity. The path of egress travel along a means of egress shall not be interrupted by a building element other than a means of egress component as specified in this chapter. Obstructions shall not be placed in the minimum width or required capacity of a means of egress component except projections permitted by this chapter. The minimum width or required capacity of a means of egress system shall not be diminished along the path of egress travel." .

    ibc:sem-ibc2021-1003.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.7 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.7-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0037 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1003.7 ;
        ibco:statementType "prohibition" ;
        ibco:text "1003.7 Elevators, escalators and moving walks. Elevators, escalators and moving walks shall not be used as a component of a required means of egress from any other part of the building." .

    ibc:sem-ibc2021-1004.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1004.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.1 Design occupant load. In determining means of egress requirements, the number of occupants for whom means of egress facilities are provided shall be determined in accordance with this section." .

    ibc:sem-ibc2021-1004.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.2 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.2-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1004.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.2 Cumulative occupant loads. Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section." .

    ibc:sem-ibc2021-1004.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.2.1 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.2.1-atomic-1,
            ibc:sem-ibc2021-1004.2.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.2.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1004.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.2.1 Intervening spaces or accessory areas. Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces. Design of egress path capacity shall be based on the cumulative portion of occupant loads of all rooms, areas or spaces to that point along the path of egress travel." .

    ibc:sem-ibc2021-1004.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.2.2 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.2.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1004.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.2.2 Adjacent levels for mezzanines. That portion of the occupant load of a mezzanine with required egress through a room, area or space on an adjacent level shall be added to the occupant load of that room, area or space." .

    ibc:sem-ibc2021-1004.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.2.3 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.2.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.2.3-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1005.6 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1004.2.3 ;
        ibco:statementType "prohibition" ;
        ibco:text "1004.2.3 Adjacent stories. Other than for the egress components designed for convergence in accordance with Section 1005.6, the occupant load from separate stories shall not be added." .

    ibc:sem-ibc2021-1004.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.3 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1004.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.3 Multiple function occupant load. Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently." .

    ibc:sem-ibc2021-1004.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.4 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.4-atomic-1,
            ibc:sem-ibc2021-1004.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.4-condition-1,
            ibc:sem-ibc2021-1004.4-condition-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1004.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.4 Multiple occupancies. Where a building contains two or more occupancies, the means of egress requirements shall apply to each portion of the building based on the occupancy of that space. Where two or more occupancies utilize portions of the same means of egress system, those egress components shall meet the more stringent requirements of all occupancies that are served." .

    ibc:sem-ibc2021-1004.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.5 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.5-atomic-1,
            ibc:sem-ibc2021-1004.5-atomic-2,
            ibc:sem-ibc2021-1004.5-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.5-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0047 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1004.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1004.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.5 Areas without fixed seating. The number of occupants shall be computed at the rate of one occupant per unit of area as prescribed in Table 1004.5. For areas without fixed seating, the occupant load shall be not less than that number determined by dividing the floor area under consideration by the occupant load factor assigned to the function of the space as set forth in Table 1004.5. Where an intended function is not listed in Table 1004.5, the building official shall establish a function based on a listed function that most nearly resembles the intended function." .

    ibc:sem-ibc2021-1004.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.5.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-occupantload ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.5.1-atomic-1,
            ibc:sem-ibc2021-1004.5.1-atomic-2,
            ibc:sem-ibc2021-1004.5.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.5.1-condition-1,
            ibc:sem-ibc2021-1004.5.1-condition-2,
            ibc:sem-ibc2021-1004.5.1-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1004.5.1-measurement-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1004.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1004.5.1 ;
        ibco:statementType "permission" ;
        ibco:text "1004.5.1 Increased occupant load. The occupant load permitted in any building, or portion thereof, is permitted to be increased from that number established for the occupancies in Table 1004.5, provided that all other requirements of the code are met based on such modified number and the occupant load does not exceed one occupant per 7 square feet (0.65 m2) of occupiable floor space. Where required by the building official, an approved aisle, seating or fixed equipment diagram substantiating any increase in occupant load shall be submitted. Where required by the building official, such diagram shall be posted." .

    ibc:sem-ibc2021-1004.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.6 ;
        ibco:appliesTo ibc:concept-occupantload,
            ibc:concept-wheelchairspace ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.6-atomic-1,
            ibc:sem-ibc2021-1004.6-atomic-2,
            ibc:sem-ibc2021-1004.6-atomic-3,
            ibc:sem-ibc2021-1004.6-atomic-4,
            ibc:sem-ibc2021-1004.6-atomic-5 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1004.6-measurement-1,
            ibc:sem-ibc2021-1004.6-measurement-2,
            ibc:sem-ibc2021-1004.6-measurement-3,
            ibc:sem-ibc2021-1004.6-measurement-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1004.5,
            ibc:ibc2021-1109.2.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1004.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.6 Fixed seating. For areas having fixed seats and aisles, the occupant load shall be determined by the number of fixed seats installed therein. The occupant load for areas in which fixed seating is not installed, such as waiting spaces, shall be determined in accordance with Section 1004.5 and added to the number of fixed seats. The occupant load of wheelchair spaces and the associated companion seat shall be based on one occupant for each wheelchair space and one occupant for the associated companion seat provided in accordance with Section 1109.2.3. For areas having fixed seating without dividing arms, the occupant load shall be not less than the number of seats based on one person for each 18 inches (457 mm) of seating length. The occupant load of seating booths shall be based on one person for each 24 inches (610 mm) of booth seat length measured at the backrest of the seating booth. TABLE 1004.5 MAXIMUM FLOOR AREA ALLOWANCES PER OCCUPANT For SI: 1 foot = 304.8 mm, 1 square foot = 0.0929 m2." .

    ibc:sem-ibc2021-1004.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.7 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.7-atomic-1,
            ibc:sem-ibc2021-1004.7-atomic-2,
            ibc:sem-ibc2021-1004.7-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.7-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0052 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1004.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.7 Outdoor areas. Yards, patios, occupied roofs, courts and similar outdoor areas accessible to and usable by the building occupants shall be provided with means of egress as required by this chapter. The occupant load of such outdoor areas shall be assigned by the building official in accordance with the anticipated use. Where outdoor areas are to be used by persons in addition to the occupants of the building, and the path of egress travel from the outdoor areas passes through the building, means of egress requirements for the building shall be based on the sum of the occupant loads of the building plus the outdoor areas." .

    ibc:sem-ibc2021-1004.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.8 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.8-atomic-1,
            ibc:sem-ibc2021-1004.8-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1004.8-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1004.8-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1004.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.8 Concentrated business use areas. The occupant load factor for concentrated business use shall be applied to telephone call centers, trading floors, electronic data processing centers and similar business use areas with a higher density of occupants than would normally be expected in a typical business occupancy environment. Where approved by the building official, the occupant load for concentrated business use areas shall be the actual occupant load, but not less than one occupant per 50 square feet (4.65 m2) of gross occupiable floor space." .

    ibc:sem-ibc2021-1004.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1004.9 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-occupantload,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1004.9-atomic-1,
            ibc:sem-ibc2021-1004.9-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1004.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1004.9 Posting of occupant load. Every room or space that is an assembly occupancy shall have the occupant load of the room or space posted in a conspicuous place, near the main exit or exit access doorway from the room or space, for the intended configurations. Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent." .

    ibc:sem-ibc2021-1005.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0059 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1005.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.1 General. All portions of the means of egress system shall be sized in accordance with this section." .

    ibc:sem-ibc2021-1005.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.2 Minimum width based on component. The minimum width, in inches (mm), of any means of egress components shall be not less than that specified for such component, elsewhere in this code." .

    ibc:sem-ibc2021-1005.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.3 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.3.1,
            ibc:ibc2021-1005.3.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.3 Required capacity based on occupant load. The required capacity, in inches (mm), of the means of egress for any room, area, space or story shall be not less than that determined in accordance with Sections 1005.3.1 and 1005.3.2." .

    ibc:sem-ibc2021-1005.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.3.1 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.3.1-atomic-1,
            ibc:sem-ibc2021-1005.3.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1005.3.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0063 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1005.3.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1005.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.3.1 Stairways. The capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.3 inch (7.6 mm) per occupant. Where stairways serve more than one story, only the occupant load of each story considered individually shall be used in calculating the required capacity of the stairways serving that story." .

    ibc:sem-ibc2021-1005.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.3.2 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.3.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1005.3.2-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0069 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1005.3.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.3.2 Other egress components. The capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant." .

    ibc:sem-ibc2021-1005.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.4 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.4-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1005.4 ;
        ibco:statementType "prohibition" ;
        ibco:text "1005.4 Continuity. The minimum width or required capacity of the means of egress required from any story of a building shall not be reduced along the path of egress travel until arrival at the public way." .

    ibc:sem-ibc2021-1005.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1005.5-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1005.5-measurement-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.5 Distribution of minimum width and required capacity. Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width." .

    ibc:sem-ibc2021-1005.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.6 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.6-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1005.6-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1005.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.6 Egress convergence. Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger." .

    ibc:sem-ibc2021-1005.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.7 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.7-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1005.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.7 Encroachment. Encroachments into the required means of egress width shall be in accordance with the provisions of this section." .

    ibc:sem-ibc2021-1005.7.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.7.1 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.7.1-atomic-1,
            ibc:sem-ibc2021-1005.7.1-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0078 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1005.7.1-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.7.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1005.7.1 Doors. Doors, when fully opened, shall not reduce the required width by more than 7 inches (178 mm). Doors in any position shall not reduce the required width by more than one-half." .

    ibc:sem-ibc2021-1005.7.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.7.2 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.7.2-atomic-1,
            ibc:sem-ibc2021-1005.7.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0084 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1005.7.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014.8 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1005.7.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.7.2 Other projections. Handrail projections shall be in accordance with the provisions of Section 1014.8. Other nonstructural projections such as trim and similar decorative features shall be permitted to project into the required width not more than 11/2 inches (38 mm) on each side." .

    ibc:sem-ibc2021-1005.7.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1005.7.3 ;
        ibco:appliesTo ibc:concept-protruding-objects ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1005.7.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1005.7.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1005.7.3 Protruding objects. Protruding objects shall comply with the applicable requirements of Section 1003.3." .

    ibc:sem-ibc2021-1006.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.2,
            ibc:ibc2021-1006.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.1 General. The number of exits or exit access doorways required within the means of egress system shall comply with the provisions of Section 1006.2 for spaces, including mezzanines, and Section 1006.3 for stories or occupied roofs." .

    ibc:sem-ibc2021-1006.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2 Egress from spaces. Rooms, areas or spaces, including mezzanines, within a story or basement shall be provided with the number of exits or access to exits in accordance with this section." .

    ibc:sem-ibc2021-1006.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.1-atomic-1,
            ibc:sem-ibc2021-1006.2.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0090 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1004.2,
            ibc:ibc2021-1006.2.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.1 Egress based on occupant load and common path of egress travel distance. Two exits or exit access doorways from any space shall be provided where the design occupant load or the common path of egress travel distance exceeds the values listed in Table 1006.2.1. The cumulative occupant load from adjacent rooms, areas or spaces shall be determined in accordance with Section 1004.2." .

    ibc:sem-ibc2021-1006.2.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.1.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.1.1-atomic-1,
            ibc:sem-ibc2021-1006.2.1.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.1.1 Three or more exits or exit access doorways. Three exits or exit access doorways shall be provided from any space with an occupant load of 501 to 1,000. Four exits or exit access doorways shall be provided from any space with an occupant load greater than 1,000." .

    ibc:sem-ibc2021-1006.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.2.2.1,
            ibc:ibc2021-1006.2.2.6 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.2 Egress based on use. The numbers, configuration and types of components of exits or access to exits shall be provided in the uses described in Sections 1006.2.2.1 through 1006.2.2.6." .

    ibc:sem-ibc2021-1006.2.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.1-atomic-1,
            ibc:sem-ibc2021-1006.2.2.1-atomic-2,
            ibc:sem-ibc2021-1006.2.2.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.1-condition-1,
            ibc:sem-ibc2021-1006.2.2.1-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1006.2.2.1-measurement-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.2.1 Boiler, incinerator and furnace rooms. Two exit access doorways are required in boiler, incinerator and furnace rooms where the area is over 500 square feet (46 m2) and any fuel-fired equipment exceeds 400,000 British thermal units (Btu) (422 000 KJ) input capacity. Where two exit access doorways are required, one is permitted to be a fixed ladder or an alternating tread device. Exit access doorways shall be separated by a horizontal distance equal to one-half the length of the maximum overall diagonal dimension of the room." .

    ibc:sem-ibc2021-1006.2.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.2-atomic-1,
            ibc:sem-ibc2021-1006.2.2.2-atomic-2,
            ibc:sem-ibc2021-1006.2.2.2-atomic-3,
            ibc:sem-ibc2021-1006.2.2.2-atomic-4,
            ibc:sem-ibc2021-1006.2.2.2-atomic-5,
            ibc:sem-ibc2021-1006.2.2.2-atomic-6,
            ibc:sem-ibc2021-1006.2.2.2-atomic-7 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.2-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1006.2.2.2-measurement-1,
            ibc:sem-ibc2021-1006.2.2.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.2.2 Refrigeration machinery rooms. Machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exits or exit access doorways. Where two exit access doorways are required, one such doorway is permitted to be served by a fixed ladder or an alternating tread device. Exit access doorways shall be separated by a horizontal distance equal to one-half the maximum horizontal dimension of the room. All portions of machinery rooms shall be within 150 feet (45 720 mm) of an exit or exit access doorway. An increase in exit access travel distance is permitted in accordance with Section 1017.1. Exit and exit access doorways shall swing in the direction of egress travel and shall be equipped with panic hardware, regardless of the occupant load served. Exit and exit access doorways shall be tight fitting and self-closing." .

    ibc:sem-ibc2021-1006.2.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.3-atomic-1,
            ibc:sem-ibc2021-1006.2.2.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0099 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1006.2.2.3-measurement-1,
            ibc:sem-ibc2021-1006.2.2.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.2.1,
            ibc:ibc2021-1017.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.2.3 Refrigerated rooms or spaces. Rooms or spaces having a floor area larger than 1,000 square feet (93 m2), containing a refrigerant evaporator and maintained at a temperature below 68°F (20°C), shall have access to not less than two exits or exit access doorways. Exit access travel distance shall be determined as specified in Section 1017.1, but all portions of a refrigerated room or space shall be within 150 feet (45 720 mm) of an exit or exit access doorway where such rooms are not protected by an approved automatic TABLE 1006.2.1 sprinkler system. Egress is allowed through adjoining refrigerated rooms or spaces." .

    ibc:sem-ibc2021-1006.2.2.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.4-atomic-1,
            ibc:sem-ibc2021-1006.2.2.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.9.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.2.2.4 Electrical rooms. T he location and number of exit or exit access doorways shall be provided for electrical rooms in accordance with Section 110.26 of NFPA 70 for electrical equipment rated 1,000 volts or less, and Section 110.33 of NFPA 70 for electrical equipment rated over 1,000 volts. Panic hardware shall be provided where required in accordance with Section 1010.2.9.2. " .

    ibc:sem-ibc2021-1006.2.2.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.5 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.5-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.5 ;
        ibco:statementType "prohibition" ;
        ibco:text "1006.2.2.5 Vehicular ramps. Vehicular ramps shall not be considered as an exit access ramp unless pedestrian facilities are provided." .

    ibc:sem-ibc2021-1006.2.2.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.2.2.6 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.2.2.6-atomic-1,
            ibc:sem-ibc2021-1006.2.2.6-atomic-2,
            ibc:sem-ibc2021-1006.2.2.6-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.2.2.6-condition-1,
            ibc:sem-ibc2021-1006.2.2.6-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1006.2.2.6-measurement-1,
            ibc:sem-ibc2021-1006.2.2.6-measurement-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1006.2.2.6 ;
        ibco:statementType "permission" ;
        ibco:text "1006.2.2.6 Groups R-3 and R-4. Where Group R-3 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with Section 903.3.1.3, the exit access travel distance for Group R-3 shall be not more than 125 feet (38 100 mm). Where Group R-4 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with SPACES WITH ONE EXIT OR EXIT ACCESS DOORWAY For SI: 1 foot = 304.8 mm. NP = Not Permitted." .

    ibc:sem-ibc2021-1006.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.3 Egress from stories or occupied roofs. The means of egress system serving any story or occupied roof shall be provided with the number of separate and distinct exits or access to exits based on the aggregate occupant load served in accordance with this section." .

    ibc:sem-ibc2021-1006.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.3.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.3.1 Occupant load. Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story." .

    ibc:sem-ibc2021-1006.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3.2 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0113 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.3.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1006.3.2 Path of egress travel. The path of egress travel to an exit shall not pass through more than one adjacent story." .

    ibc:sem-ibc2021-1006.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-occupantload,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3.3-atomic-1,
            ibc:sem-ibc2021-1006.3.3-atomic-2,
            ibc:sem-ibc2021-1006.3.3-atomic-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.3.3,
            ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1006.3.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.3.3 Egress based on occupant load. Each story and occupied roof shall have the minimum number of separate and distinct exits, or access to exits, as specified in Table 1006.3.3. A single exit or access to a single exit shall be permitted in accordance with Section 1006.3.4. The required number of exits, or exit access stairways or ramps providing access to exits, from any story or occupied roof shall be maintained until arrival at the exit discharge or a public way. TABLE 1006.3.3 MINIMUM NUMBER OF EXITS OR ACCESS TO EXITS PER STORY" .

    ibc:sem-ibc2021-1006.3.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3.4 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.3.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1006.3.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1006.3.4 Single exits. A single exit or access to a single exit shall be permitted from any story or occupied roof where one of the following conditions exists:" .

    ibc:sem-ibc2021-1006.3.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1006.3.4.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-occupantload,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.65 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1006.3.4.1-atomic-1,
            ibc:sem-ibc2021-1006.3.4.1-atomic-2,
            ibc:sem-ibc2021-1006.3.4.1-atomic-3,
            ibc:sem-ibc2021-1006.3.4.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1006.3.4.1-condition-1,
            ibc:sem-ibc2021-1006.3.4.1-condition-2,
            ibc:sem-ibc2021-1006.3.4.1-condition-3,
            ibc:sem-ibc2021-1006.3.4.1-condition-4 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1006.3.4.1-measurement-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1004.1,
            ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1006.3.4.1 ;
        ibco:statementType "permission" ;
        ibco:text "1006.3.4.1 Mixed occupancies. Where one exit, or exit access stairway or ramp providing access to exits at other stories, is permitted to serve individual stories, mixed occupancies shall be permitted to be served by single exits provided that each individual occupancy complies with the applicable requirements of Table 1006.3.4(1) or 1006.3.4(2) for that occupancy. Where applicable, cumulative occupant loads from adjacent occupancies shall be considered to be in accordance with the provisions of Section 1004.1. In each story of a mixed occupancy building, the maximum number of occupants served by a single exit shall be such that the sum of the ratios of the calculated number of occupants of the space divided by the allowable number of occupants indicated in Table 1006.3.4(2) for each occupancy does not exceed one. Where dwelling units are located on a story with other occupancies, the actual number of dwelling units divided by four plus the ratio from the other occupancy does not exceed one. TABLE 1006.3.4(1) STORIES WITH ONE EXIT OR ACCESS TO ONE EXIT FOR R-2 OCCUPANCIES For SI: 1 foot = 304.8 mm. NP = Not Permitted. NA = Not Applicable." .

    ibc:sem-ibc2021-1007.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1007.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1 General. Exits, exit access doorways, and exit access stairways and ramps serving spaces, including individual building stories, shall be separated in accordance with the provisions of this section." .

    ibc:sem-ibc2021-1007.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1.1-atomic-1,
            ibc:sem-ibc2021-1007.1.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1007.1.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0140 ;
        ibco:modality "required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1007.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1.1 Two exits or exit access doorways. Where two exits, exit access doorways, exit access stairways or ramps, or any combination thereof, are required from any portion of the exit access, they shall be placed a distance apart equal to not less than one-half of the length of the maximum overall diagonal dimension of the building or area to be served measured in a straight line between them. Interlocking or scissor stairways shall be counted as one exit stairway." .

    ibc:sem-ibc2021-1007.1.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1.1.1 ;
        ibco:appliesTo ibc:concept-the-separation-distance-required-in-section-1007-1-1 ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1.1.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1007.1.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1007.1.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1.1.1 Measurement point. The separation distance required in Section 1007.1.1 shall be measured in accordance with the following:" .

    ibc:sem-ibc2021-1007.1.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1.2-atomic-1,
            ibc:sem-ibc2021-1007.1.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1007.1.2-condition-1,
            ibc:sem-ibc2021-1007.1.2-condition-2 ;
        ibco:modality "required" ;
        ibco:references ibc:ibc2021-1007.1.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1007.1.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1.2 Three or more exits or exit access doorways. Where access to three or more exits is required, not less than two exit or exit access doorways shall be arranged in accordance with the provisions of Section 1007.1.1. Additional required exit or exit access doorways shall be arranged a reasonable distance apart so that if one becomes blocked, the others will be available." .

    ibc:sem-ibc2021-1007.1.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1007.1.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1007.1.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1.3 Remoteness of exit access stairways or ramps. Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps." .

    ibc:sem-ibc2021-1007.1.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1007.1.3.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1007.1.3.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1007.1.3.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1007.1.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1007.1.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1007.1.3.1 Three or more exit access stairways or ramps. Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007.1.3." .

    ibc:sem-ibc2021-1008.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.1-atomic-1,
            ibc:sem-ibc2021-1008.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1008.2,
            ibc:ibc2021-1008.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1008.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.1 Means of egress illumination. Illumination shall be provided in the means of egress in accordance with Section 1008.2. Under emergency power, means of egress illumination shall comply with Section 1008.3." .

    ibc:sem-ibc2021-1008.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0153 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1008.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.2 Illumination required. The means of egress serving a room or space shall be illuminated at all times that the room or space is occupied." .

    ibc:sem-ibc2021-1008.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.2.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.2.1-atomic-1,
            ibc:sem-ibc2021-1008.2.1-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0159 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1008.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.2.1 Illumination level under normal power. The means of egress illumination level shall be not less than 1 footcandle (11 lux) at the walking surface. Along exit access stairways, exit stairways and at their required landings, the illumination level shall not be less than 10 footcandles (108 lux) at the walking surface when the stairway is in use." .

    ibc:sem-ibc2021-1008.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.2.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.2.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1008.2.2-condition-1 ;
        ibco:modality "required" ;
        ibco:references ibc:ibc2021-1010.1.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1008.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.2.2 Group I-2. In Group I-2 occupancies where two or more exits are required, on the exterior landings required by Section 1010.1.5, means of egress illumination levels for the exit discharge shall be provided such that failure of a single lamp in a luminaire shall not reduce the illumination level on that landing to less than 1 footcandle (11 lux)." .

    ibc:sem-ibc2021-1008.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.2.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.2.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0164 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1008.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.2.3 Exit discharge. Illumination shall be provided along the path of travel for the exit discharge from each exit to the public way." .

    ibc:sem-ibc2021-1008.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1008.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3 Emergency power for illumination. The power supply for means of egress illumination shall normally be provided by the premises’ electrical supply." .

    ibc:sem-ibc2021-1008.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3.1 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1008.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3.1 General. In the event of power supply failure in rooms and spaces that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1008.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3.2 Buildings. In the event of power supply failure in buildings that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3.3 ;
        ibco:appliesTo ibc:concept-in-the-event-of-power-supply-failure-an-emergency-electrical-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1008.3.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3.3 Rooms and spaces. In the event of power supply failure, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3.4 ;
        ibco:appliesTo ibc:concept-the-emergency-power-system ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3.4-atomic-1,
            ibc:sem-ibc2021-1008.3.4-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-2702 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1008.3.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3.4 Duration. The emergency power system shall provide power for a duration of not less than 90 minutes and shall consist of storage batteries, unit equipment or an on-site generator. The installation of the emergency power system shall be in accordance with Section 2702." .

    ibc:sem-ibc2021-1008.3.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1008.3.5 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1008.3.5-atomic-1,
            ibc:sem-ibc2021-1008.3.5-atomic-2,
            ibc:sem-ibc2021-1008.3.5-atomic-3,
            ibc:sem-ibc2021-1008.3.5-atomic-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1008.3.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1008.3.5 Illumination level under emergency power. Emergency lighting facilities shall be arranged to provide initial illumination that is not less than an average of 1 footcandle (11 lux) and a minimum at any point of 0.1 footcandle (1 lux) measured along the path of egress at floor level. Illumination levels shall be permitted to decline to 0.6 footcandle (6 lux) average and a minimum at any point of 0.06 footcandle (0.6 lux) at the end of the emergency lighting time duration. A maximum-to-minimum illumination uniformity ratio of 40 to 1 shall not be exceeded. In Group I-2 occupancies, failure of a single lamp in a luminaire shall not reduce the illumination level to less than 0.2 footcandle (2.2 lux)." .

    ibc:sem-ibc2021-1009.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.1-atomic-1,
            ibc:sem-ibc2021-1009.1-atomic-2,
            ibc:sem-ibc2021-1009.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0188 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.2,
            ibc:ibc2021-1006.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1009.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.1 Accessible means of egress required. Accessible means of egress shall comply with this section. Accessible spaces shall be provided with not less than one accessible means of egress. Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress." .

    ibc:sem-ibc2021-1009.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.10 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.10-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1009.10 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.10 Directional signage. Directional signage indicating the location of all other means of egress and which of those are accessible means of egress shall be provided at the following:" .

    ibc:sem-ibc2021-1009.11 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.11 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.11-atomic-1,
            ibc:sem-ibc2021-1009.11-atomic-2,
            ibc:sem-ibc2021-1009.11-atomic-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.11 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.11 Instructions. In areas of refuge and exterior areas for assisted rescue, instructions on the use of the area under emergency conditions shall be posted. Signage shall comply with the ICC A117.1 requirements for visual characters. The instructions shall include all of the following:" .

    ibc:sem-ibc2021-1009.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.2 Continuity and components. Each required accessible means of egress shall be continuous to a public way and shall consist of one or more of the following components:" .

    ibc:sem-ibc2021-1009.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.2.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.2.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.2.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0203 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1009.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.2.1 Elevators required. In buildings where a required accessible floor or occupied roof is four or more stories above or below a level of exit discharge, not less than one required accessible means of egress shall be an elevator complying with Section 1009.4." .

    ibc:sem-ibc2021-1009.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.3 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.3.1,
            ibc:ibc2021-1009.3.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.3 Stairways. In order to be considered part of an accessible means of egress, a stairway between stories shall comply with Sections 1009.3.1 through 1009.3.3." .

    ibc:sem-ibc2021-1009.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.3.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.3.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0208 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.3.1 ;
        ibco:statementType "permission" ;
        ibco:text "1009.3.1 Exit access stairways. Exit access stairways that connect levels in the same story are not permitted as part of an accessible means of egress." .

    ibc:sem-ibc2021-1009.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.3.2 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.3.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0210 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1009.3.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.3.2 Stairway width. Stairways shall have a clear width of 48 inches (1219 mm) minimum between handrails." .

    ibc:sem-ibc2021-1009.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.3.3 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.3.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0214 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.6 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.3.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.3.3 Area of refuge. Stairways shall either incorporate an area of refuge within an enlarged floor-level landing or shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:sem-ibc2021-1009.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.4 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.4-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.4.1,
            ibc:ibc2021-1009.4.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.4 Elevators. In order to be considered part of an accessible means of egress, an elevator shall comply with Sections 1009.4.1 and 1009.4.2." .

    ibc:sem-ibc2021-1009.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.4.1 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.4.1-atomic-1,
            ibc:sem-ibc2021-1009.4.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1009.4.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.4.1 Standby power. The elevator shall meet the emergency operation and signaling device requirements of Section 2.27 of ASME A17.1/CSA B44. Standby power shall be provided in accordance with Chapter 27 and Section 3003." .

    ibc:sem-ibc2021-1009.4.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.4.2 ;
        ibco:appliesTo ibc:concept-the-elevator ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.4.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0224 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.6 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.4.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.4.2 Area of refuge. The elevator shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:sem-ibc2021-1009.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.5 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.5-atomic-1,
            ibc:sem-ibc2021-1009.5-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.5-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1110.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.5 Platform lifts. Platform lifts shall be permitted to serve as part of an accessible means of egress where allowed as part of a required accessible route in Section 1110.9 except for Item 10. Standby power for the platform lift shall be provided in accordance with Chapter 27." .

    ibc:sem-ibc2021-1009.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.6 Areas of refuge. Every required area of refuge shall be accessible from the space it serves by an accessible means of egress." .

    ibc:sem-ibc2021-1009.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6.1-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1017.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1009.6.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1009.6.1 Travel distance. The maximum travel distance from any accessible space to an area of refuge shall not exceed the exit access travel distance permitted for the occupancy in accordance with Section 1017.1." .

    ibc:sem-ibc2021-1009.6.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0234 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.3,
            ibc:ibc2021-1009.4,
            ibc:ibc2021-1023 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.6.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.6.2 Stairway or elevator access. Every required area of refuge shall have direct access to a stairway complying with Sections 1009.3 and 1023 or an elevator complying with Section 1009.4." .

    ibc:sem-ibc2021-1009.6.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6.3 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-occupantload,
            ibc:concept-wheelchairspace ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6.3-atomic-1,
            ibc:sem-ibc2021-1009.6.3-atomic-2,
            ibc:sem-ibc2021-1009.6.3-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1009.6.3-measurement-1,
            ibc:sem-ibc2021-1009.6.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1009.6.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.6.3 Size. Each area of refuge shall be sized to accommodate one wheelchair space of 30 inches by 52 inches (762 mm by 1320 mm) for each 200 occupants or portion thereof, based on the occupant load of the area of refuge and areas served by the area of refuge. Such wheelchair spaces shall not reduce the means of egress minimum width or required capacity. Access to any of the required wheelchair spaces in an area of refuge shall not be obstructed by more than one adjoining wheelchair space." .

    ibc:sem-ibc2021-1009.6.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6.4 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6.4-atomic-1,
            ibc:sem-ibc2021-1009.6.4-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0237 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1026 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.6.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.6.4 Separation. Each area of refuge shall be separated from the remainder of the story by a smoke barrier complying with Section 709 or a horizontal exit complying with Section 1026. Each area of refuge shall be designed to minimize the intrusion of smoke." .

    ibc:sem-ibc2021-1009.6.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.6.5 ;
        ibco:appliesTo ibc:concept-areas-of-refuge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.6.5-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.8.1,
            ibc:ibc2021-1009.8.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1009.6.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.6.5 Two-way communication. Areas of refuge shall be provided with a two-way communication system complying with Sections 1009.8.1 and 1009.8.2." .

    ibc:sem-ibc2021-1009.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.7 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.7-atomic-1,
            ibc:sem-ibc2021-1009.7-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.7-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.7.1,
            ibc:ibc2021-1009.7.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.7 Exterior areas for assisted rescue. Exterior areas for assisted rescue shall be accessed by an accessible route from the area served. Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009.7.1 through 1009.7.4." .

    ibc:sem-ibc2021-1009.7.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.7.1 ;
        ibco:appliesTo ibc:concept-wheelchairspace ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.7.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.6.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1009.7.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.7.1 Size. Each exterior area for assisted rescue shall be sized to accommodate wheelchair spaces in accordance with Section 1009.6.3." .

    ibc:sem-ibc2021-1009.7.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.7.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.7.2-atomic-1,
            ibc:sem-ibc2021-1009.7.2-atomic-2,
            ibc:sem-ibc2021-1009.7.2-atomic-3,
            ibc:sem-ibc2021-1009.7.2-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0244 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1009.7.2-measurement-1,
            ibc:sem-ibc2021-1009.7.2-measurement-2,
            ibc:sem-ibc2021-1009.7.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.7.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.7.2 Separation. Exterior walls separating the exterior area of assisted rescue from the interior of the building shall have a minimum fire-resistance rating of 1 hour, rated for exposure to fire from the inside. The fireresistance-rated exterior wall construction shall extend horizontally not less than 10 feet (3048 mm) beyond the landing on either side of the landing or equivalent fireresistance-rated construction is permitted to extend out perpendicular to the exterior wall not less than 4 feet (1219 mm) on the side of the landing. The fire-resistancerated construction shall extend vertically from the ground to a point not less than 10 feet (3048 mm) above the floor level of the area for assisted rescue or to the roof line, whichever is lower. Openings within such fire-resistancerated exterior walls shall be protected in accordance with Section 716." .

    ibc:sem-ibc2021-1009.7.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.7.3 ;
        ibco:appliesTo ibc:concept-the-exterior-area-for-assisted-rescue ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.7.3-atomic-1,
            ibc:sem-ibc2021-1009.7.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.7.3-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1009.7.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1009.7.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.7.3 Openness. The exterior area for assisted rescue shall be open to the outside air. The sides other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-1009.7.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.7.4 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.7.4-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0247 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1009.7.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.7.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.7.4 Stairways. Stairways that are part of the means of egress for the exterior area for assisted rescue shall provide a minimum clear width of 48 inches (1219 mm) between handrails." .

    ibc:sem-ibc2021-1009.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.8 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.8-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0249 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.8.1,
            ibc:ibc2021-1009.8.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.8 Two-way communication. A two-way communication system complying with Sections 1009.8.1 and 1009.8.2 shall be provided at the landing serving each elevator or bank of elevators on each accessible floor that is one or more stories above or below the level of exit discharge." .

    ibc:sem-ibc2021-1009.8.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.8.1 ;
        ibco:appliesTo ibc:concept-two-way-communication-systems ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.8.1-atomic-1,
            ibc:sem-ibc2021-1009.8.1-atomic-2,
            ibc:sem-ibc2021-1009.8.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1009.8.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.8.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.8.1 System requirements. Two-way communication systems shall provide communication between each required location and the fire command center or a central control point location approved by the fire department. Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1. The two-way communication system shall include both audible and visible signals." .

    ibc:sem-ibc2021-1009.8.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.8.2 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.8.2-atomic-1,
            ibc:sem-ibc2021-1009.8.2-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1009.8.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.8.2 Directions. Directions for the use of the twoway communication system, instructions for summoning assistance via the two-way communication system and written identification of the location shall be posted adjacent to the two-way communication system. Signage shall comply with the ICC A117.1 requirements for visual characters." .

    ibc:sem-ibc2021-1009.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1009.9 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1009.9-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1009.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1009.9 Signage. Signage indicating special accessibility provisions shall be provided as shown:" .

    ibc:sem-ibc2021-1010.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1-atomic-1,
            ibc:sem-ibc2021-1010.1-atomic-2,
            ibc:sem-ibc2021-1010.1-atomic-3,
            ibc:sem-ibc2021-1010.1-atomic-4,
            ibc:sem-ibc2021-1010.1-atomic-5,
            ibc:sem-ibc2021-1010.1-atomic-6,
            ibc:sem-ibc2021-1010.1-atomic-7,
            ibc:sem-ibc2021-1010.1-atomic-8 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1.1,
            ibc:ibc2021-1010.3.4,
            ibc:ibc2021-1010.4,
            ibc:ibc2021-1010.4.1,
            ibc:ibc2021-1010.5,
            ibc:ibc2021-1010.5.4,
            ibc:ibc2021-1022.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1 General. Doors in the means of egress shall comply with the requirements of Sections 1010.1.1 through 1010.3.4. Exterior exit doors shall also comply with the requirements of Section 1022.2. Gates in the means of egress shall comply with the requirements of Sections 1010.4 and 1010.4.1. Turnstiles in the means of egress shall comply with the requirements of Sections 1010.5 through 1010.5.4. Doors, gates and turnstiles provided for egress purposes in numbers greater than required by this code shall comply with the requirements of this section. Doors in the means of egress shall be readily distinguishable from the adjacent construction and finishes such that the doors are easily recognizable as doors. Mirrors or similar reflecting materials shall not be used on means of egress doors. Means of egress doors shall not be concealed by curtains, drapes, decorations or similar materials." .

    ibc:sem-ibc2021-1010.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.1-atomic-1,
            ibc:sem-ibc2021-1010.1.1-atomic-2,
            ibc:sem-ibc2021-1010.1.1-atomic-3,
            ibc:sem-ibc2021-1010.1.1-atomic-4,
            ibc:sem-ibc2021-1010.1.1-atomic-5 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.1.1-condition-1,
            ibc:sem-ibc2021-1010.1.1-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0272 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.1.1-measurement-1,
            ibc:sem-ibc2021-1010.1.1-measurement-2,
            ibc:sem-ibc2021-1010.1.1-measurement-3,
            ibc:sem-ibc2021-1010.1.1-measurement-4,
            ibc:sem-ibc2021-1010.1.1-measurement-5 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.1 Size of doors. The required capacity of each door opening shall be sufficient for the occupant load thereof and shall provide a minimum clear opening width of 32 inches (813 mm). The clear opening width of doorways with swinging doors shall be measured between the face of the door and the stop, with the door open 90 degrees (1.57 rad). Where this section requires a minimum clear opening width of 32 inches (813 mm) and a door opening includes two door leaves without a mullion, one leaf shall provide a minimum clear opening width of 32 inches (813 mm). In Group I-2, doors serving as means of egress doors where used for the movement of beds shall provide a minimum clear opening width of 411/2 inches (1054 mm). The minimum clear opening height of doors shall be not less than 80 inches (2032 mm)." .

    ibc:sem-ibc2021-1010.1.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.1.1 ;
        ibco:appliesTo ibc:concept-there ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.1.1-atomic-1,
            ibc:sem-ibc2021-1010.1.1.1-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0285 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.1.1.1-measurement-1,
            ibc:sem-ibc2021-1010.1.1.1-measurement-2,
            ibc:sem-ibc2021-1010.1.1.1-measurement-3,
            ibc:sem-ibc2021-1010.1.1.1-measurement-4 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1.1.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1010.1.1.1 Projections into clear opening. There shall not be projections into the required clear opening width lower than 34 inches (864 mm) above the floor or ground. Projections into the clear opening width between 34 inches (864 mm) and 80 inches (2032 mm) above the floor or ground shall not exceed 4 inches (102 mm)." .

    ibc:sem-ibc2021-1010.1.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0287 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.2 Egress door types. Egress doors shall be of the side-hinged swinging door, pivoted door, or balanced door types." .

    ibc:sem-ibc2021-1010.1.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.2.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.2.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.1.2.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.2.1 Direction of swing. Side-hinged swinging doors, pivoted doors and balanced doors shall swing in the direction of egress travel where serving a room or area containing an occupant load of 50 or more persons or a Group H occupancy. " .

    ibc:sem-ibc2021-1010.1.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.3 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.3 Forces to unlatch and open doors. The forces to unlatch doors shall comply with the following:" .

    ibc:sem-ibc2021-1010.1.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.3.1 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.3.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.3.1 Location of applied forces. Forces shall be applied to the latch side of the door." .

    ibc:sem-ibc2021-1010.1.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.3.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.3.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.1.3.2-condition-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.3.2 Manual horizontal sliding doors. Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed." .

    ibc:sem-ibc2021-1010.1.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.4 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.4-atomic-1,
            ibc:sem-ibc2021-1010.1.4-atomic-2,
            ibc:sem-ibc2021-1010.1.4-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0306 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.4 Floor elevation. There shall be a floor or landing on each side of a door. Such floor or landing shall be at the same elevation on each side of the door. Landings shall be level except for exterior landings, which are permitted to have a slope not to exceed 0.25 unit vertical in 12 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1010.1.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.5 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.5-atomic-1,
            ibc:sem-ibc2021-1010.1.5-atomic-2,
            ibc:sem-ibc2021-1010.1.5-atomic-3,
            ibc:sem-ibc2021-1010.1.5-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.1.5-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0314 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.1.5-measurement-1,
            ibc:sem-ibc2021-1010.1.5-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.1.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.5 Landings at doors. Landings shall have a width not less than the width of the stairway or the door, whichever is greater. Doors in the fully open position shall not reduce a required dimension by more than 7 inches (178 mm). Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width. Landings shall have a length measured in the direction of travel of not less than 44 inches (1118 mm)." .

    ibc:sem-ibc2021-1010.1.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.6 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.6-atomic-1,
            ibc:sem-ibc2021-1010.1.6-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0316 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.1.6-measurement-1,
            ibc:sem-ibc2021-1010.1.6-measurement-2,
            ibc:sem-ibc2021-1010.1.6-measurement-3 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1.6 ;
        ibco:statementType "prohibition" ;
        ibco:text "1010.1.6 Thresholds. Thresholds at doorways shall not exceed 3/4 inch (19.1 mm) in height above the finished floor or landing for sliding doors serving dwelling units or 1/2 inch (12.7 mm) above the finished floor or landing for other doors. Raised thresholds and floor level changes greater than 1/4 inch (6.4 mm) at doorways shall be beveled with a slope not greater than one unit vertical in two units horizontal (50-percent slope)." .

    ibc:sem-ibc2021-1010.1.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.1.7 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.1.7-atomic-1,
            ibc:sem-ibc2021-1010.1.7-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0323 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.1.7-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.1.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.1.7 Door arrangement. Space between two doors in a series shall be 48 inches (1219 mm) minimum plus the width of a door swinging into the space. Doors in a series shall swing either in the same direction or away from the space between the doors." .

    ibc:sem-ibc2021-1010.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2 ;
        ibco:statementType "permission" ;
        ibco:text "1010.2 Door operations. Except as specifically permitted by this section, egress doors shall be readily openable from the egress side without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.1 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0329 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.1 Unlatching. The unlatching of any door or leaf for egress shall require not more than one motion in a single linear or rotational direction to release all latching and all locking devices." .

    ibc:sem-ibc2021-1010.2.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.10 ;
        ibco:appliesTo ibc:concept-where-electrical-systems-that-monitor-or-record-egress-activity-are-incorporated-the-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.10-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.10-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.11,
            ibc:ibc2021-1010.2.12,
            ibc:ibc2021-1010.2.13,
            ibc:ibc2021-1010.2.14,
            ibc:ibc2021-1010.2.15 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.10 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.10 Monitored or recorded egress. Where electrical systems that monitor or record egress activity are incorporated, the locking system shall comply with Section 1010.2.11, 1010.2.12, 1010.2.13, 1010.2.14 or 1010.2.15 or shall be readily openable from the egress side without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.11 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.11 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.11-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.11-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.11 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.11 Door hardware release of electrically locked egress doors. Door hardware release of electric locking systems shall be permitted on doors in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-1010.2.12 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.12 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.12-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.12-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.2.12 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.12 Sensor release of electrically locked egress doors. Sensor release of electric locking systems shall be permitted on doors located in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following criteria:" .

    ibc:sem-ibc2021-1010.2.13 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.13 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.13-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.2.13 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.13 Delayed egress. Delayed egress locking systems shall be permitted to be installed on doors serving the following occupancies in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke or heat detection system installed in accordance with Section 907." .

    ibc:sem-ibc2021-1010.2.13.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.13.1 ;
        ibco:appliesTo ibc:concept-the-delayed-egress-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.13.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0418,
            ibc:ibc2021-ch10-exception-0420,
            ibc:ibc2021-ch10-exception-0424 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.13.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.13.1 Delayed egress locking system. The delayed egress locking system shall be installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-1010.2.14 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.14 ;
        ibco:confidence 0.81 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0440 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.14 ;
        ibco:statementType "declarative" ;
        ibco:text "1010.2.14 Controlled egress doors in Groups I-1 and I-" .

    ibc:sem-ibc2021-1010.2.15 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.15 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.15-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.15-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.2.15 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.15 Locking arrangements in buildings within correctional facilities. In buildings within correctional and detention facilities, doors in means of egress serving rooms or spaces occupied by persons whose movements are controlled for security reasons shall be permitted to be locked where equipped with egress control devices that shall unlock manually and by not less than one of the following means:" .

    ibc:sem-ibc2021-1010.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.2-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1010.2.2 Hardware. Door handles, pulls, latches, locks and other operating devices on doors required to be accessible by Chapter 11 shall not require tight grasping, tight pinching or twisting of the wrist to operate." .

    ibc:sem-ibc2021-1010.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.3 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.3-atomic-1,
            ibc:sem-ibc2021-1010.2.3-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0336 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.2.3-measurement-1,
            ibc:sem-ibc2021-1010.2.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.3 Hardware height. Door handles, pulls, latches, locks and other operating devices shall be installed 34 inches (864 mm) minimum and 48 inches (1219 mm) maximum above the finished floor. Locks used only for security purposes and not used for normal operation are permitted at any height." .

    ibc:sem-ibc2021-1010.2.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.4 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.4 Locks and latches. Locks and latches shall be permitted to prevent operation of doors where any of the following exist:" .

    ibc:sem-ibc2021-1010.2.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.5 ;
        ibco:appliesTo ibc:concept-manually-operated-flush-bolts-or-surface-bolts-are-not ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.5-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0358 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.5 ;
        ibco:statementType "permission" ;
        ibco:text "1010.2.5 Bolt locks. Manually operated flush bolts or surface bolts are not permitted." .

    ibc:sem-ibc2021-1010.2.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.6 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.6-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.6 Closet doors. Closet doors that latch in the closed position shall be openable from inside the closet." .

    ibc:sem-ibc2021-1010.2.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.7 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.7-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0366 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.7 Stairway doors. Interior stairway means of egress doors shall be openable from both sides without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.8 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.8-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.8 Locking arrangements in educational occupancies. In Group E occupancies, Group B educational occupancies and Group I-4 occupancies, egress doors from classrooms, offices and other occupied rooms with locking arrangements designed to keep intruders from entering the room shall comply with all of the following conditions:" .

    ibc:sem-ibc2021-1010.2.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.9 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.9-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.9-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0378 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.2.9 ;
        ibco:statementType "prohibition" ;
        ibco:text "1010.2.9 Panic and fire exit hardware. Swinging doors serving a Group H occupancy and swinging doors serving rooms or spaces with an occupant load of 50 or more in a Group A or E occupancy shall not be provided with a latch or lock other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.9.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.9.1-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.2.9.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.9.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.9.1 Refrigeration machinery room. Refrigeration machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exit or exit access doorways that swing in the direction of egress travel and shall be equipped with panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.9.2 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.9.2-atomic-1,
            ibc:sem-ibc2021-1010.2.9.2-atomic-2,
            ibc:sem-ibc2021-1010.2.9.2-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.9.2-condition-1,
            ibc:sem-ibc2021-1010.2.9.2-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.2.9.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.2.9.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.9.2 Rooms with electrical equipment. Exit or exit access doors serving transformer vaults, rooms designated for batteries or energy storage systems, or modular data centers shall be equipped with panic hardware or fire exit hardware. Rooms containing electrical equipment rated 800 amperes or more that contain overcurrent devices, switching devices or control devices and where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware. The doors shall swing in the direction of egress travel." .

    ibc:sem-ibc2021-1010.2.9.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.9.3 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.9.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.9.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.9.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.9.3 Installation. Where panic or fire exit hardware is installed, it shall comply with the following:" .

    ibc:sem-ibc2021-1010.2.9.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.2.9.4 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.2.9.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.2.9.4-condition-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.2.9.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.2.9.4 Balanced doors. If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side." .

    ibc:sem-ibc2021-1010.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.3.1,
            ibc:ibc2021-1010.3.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.3 Special doors. Special doors and security grilles shall comply with the requirements of Sections 1010.3.1 through 1010.3.4." .

    ibc:sem-ibc2021-1010.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.1 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.3.1 Revolving doors. Revolving doors shall comply with the following:" .

    ibc:sem-ibc2021-1010.3.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.1.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.1.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.3.1.1 Egress component. A revolving door used as a component of a means of egress shall comply with Section 1010.3.1 and the following three conditions:" .

    ibc:sem-ibc2021-1010.3.1.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.1.2 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.1.2-atomic-1,
            ibc:sem-ibc2021-1010.3.1.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.3.1.2-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0461 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.1.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.3.1.2 Other than egress component. A revolving door used as other than a component of a means of egress shall comply with Section 1010.3.1. The breakout force of a revolving door not used as a component of a means of egress shall not be more than 180 pounds (801 N)." .

    ibc:sem-ibc2021-1010.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.2 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.2-atomic-1,
            ibc:sem-ibc2021-1010.3.2-atomic-2,
            ibc:sem-ibc2021-1010.3.2-atomic-3,
            ibc:sem-ibc2021-1010.3.2-atomic-4,
            ibc:sem-ibc2021-1010.3.2-atomic-5,
            ibc:sem-ibc2021-1010.3.2-atomic-6 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.3.2-condition-1,
            ibc:sem-ibc2021-1010.3.2-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0467 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.3.2 Power-operated doors. Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress. The forces required to open these doors manually shall not exceed those specified in Section 1010.1.3, except that the force to set the door in motion shall not exceed 50 pounds (220 N). The door shall be capable of opening from any position to the full width of the opening in which such door is installed when a force is applied to the door on the side from which egress is made. Power-operated swinging doors, power-operated sliding doors and power-operated folding doors shall comply with BHMA A156.10. Power-assisted swinging doors and low-energy power-operated swinging doors shall comply with BHMA A156.19. Low-energy poweroperated sliding doors and low-energy power-operated folding doors shall comply with BHMA A156.38." .

    ibc:sem-ibc2021-1010.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.3 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.3.3-condition-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1010.1.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.3 ;
        ibco:statementType "permission" ;
        ibco:text "1010.3.3 Special purpose horizontal sliding, accordion or folding doors. In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010.1.2 shall comply with all of the following criteria:" .

    ibc:sem-ibc2021-1010.3.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.3.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.3.4-atomic-1,
            ibc:sem-ibc2021-1010.3.4-atomic-2,
            ibc:sem-ibc2021-1010.3.4-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.3.4-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.3.4 ;
        ibco:statementType "permission" ;
        ibco:text "1010.3.4 Security grilles. In Groups B, F, M and S, horizontal sliding or vertical security grilles are permitted at the main exit and shall be openable from the inside without the use of a key or special knowledge or effort during periods that the space is occupied. The grilles shall remain secured in the full-open position during the period of occupancy by the general public. Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles." .

    ibc:sem-ibc2021-1010.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.4 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.4-atomic-1,
            ibc:sem-ibc2021-1010.4-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0482 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.4 Gates. Gates serving the means of egress system shall comply with the requirements of this section. Gates used as a component in a means of egress shall conform to the applicable requirements for doors." .

    ibc:sem-ibc2021-1010.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.4.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.4.1-atomic-1,
            ibc:sem-ibc2021-1010.4.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.4.1-condition-1,
            ibc:sem-ibc2021-1010.4.1-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.4.1-measurement-1,
            ibc:sem-ibc2021-1010.4.1-measurement-2 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1028.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.4.1 ;
        ibco:statementType "exemption" ;
        ibco:text "1010.4.1 Stadiums. Panic hardware is not required on gates surrounding stadiums where such gates are under constant immediate supervision while the public is present, and where safe dispersal areas based on 3 square feet (0.28 m2) per occupant are located between the fence and enclosed space. Such required safe dispersal areas shall not be located less than 50 feet (15 240 mm) from the enclosed space. See Section 1028.5 for means of egress from safe dispersal areas." .

    ibc:sem-ibc2021-1010.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.5-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1010.5.1,
            ibc:ibc2021-1010.5.2,
            ibc:ibc2021-1010.5.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.5 ;
        ibco:statementType "prohibition" ;
        ibco:text "1010.5 Turnstiles and similar devices. Turnstiles or similar devices that restrict travel to one direction shall not be placed so as to obstruct any required means of egress, except where permitted in accordance with Sections 1010.5.1, 1010.5.2 and 1010.5.3." .

    ibc:sem-ibc2021-1010.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5.1 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.5.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.5.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.5.1 Capacity. Each turnstile or similar device shall be credited with a capacity based on not more than a 50person occupant load where all of the following provisions are met:" .

    ibc:sem-ibc2021-1010.5.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5.1.1 ;
        ibco:appliesTo ibc:concept-accessibleroute ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5.1.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.5.1.1-condition-1,
            ibc:sem-ibc2021-1010.5.1.1-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.5.1.1-measurement-1,
            ibc:sem-ibc2021-1010.5.1.1-measurement-2,
            ibc:sem-ibc2021-1010.5.1.1-measurement-3,
            ibc:sem-ibc2021-1010.5.1.1-measurement-4,
            ibc:sem-ibc2021-1010.5.1.1-measurement-5 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.5.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.5.1.1 Clear width. Where located as part of an accessible route, turnstiles shall have not less than 36 inches (914 mm) clear width at and below a height of 34 inches (864 mm), not less than 32 inches (813 mm) clear width between 34 inches (864 mm) and 80 inches (2032 mm) and shall consist of a mechanism other than a revolving device." .

    ibc:sem-ibc2021-1010.5.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.5.2-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0502 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1010.5.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.5.2 Security access turnstiles. Security access turnstiles that inhibit travel in the direction of egress utilizing a physical barrier shall be permitted to be considered as a component of the means of egress, provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-1010.5.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5.3 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5.3-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.5.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.5.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1010.5.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.5.3 High turnstile. Turnstiles more than 39 inches (991 mm) high shall meet the requirements for revolving doors or the requirements of Section 1010.5.2 for security access turnstiles." .

    ibc:sem-ibc2021-1010.5.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1010.5.4 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1010.5.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1010.5.4-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0506 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1010.5.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1010.5.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1010.5.4 Additional door. Where serving an occupant load greater than 300, each turnstile that is not portable shall have a side-hinged swinging door that conforms to Section 1010.1 within 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-1011.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.1-atomic-1,
            ibc:sem-ibc2021-1011.1-atomic-2,
            ibc:sem-ibc2021-1011.1-atomic-3,
            ibc:sem-ibc2021-1011.1-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0509 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.13,
            ibc:ibc2021-1011.14,
            ibc:ibc2021-1011.15,
            ibc:ibc2021-1011.16,
            ibc:ibc2021-1011.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.1 General. Stairways serving occupied portions of a building shall comply with the requirements of Sections 1011.2 through 1011.13. Alternating tread devices shall comply with Section 1011.14. Ship’s ladders shall comply with Section 1011.15. Ladders shall comply with Section 1011.16." .

    ibc:sem-ibc2021-1011.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.10 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.10-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.10-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.10 ;
        ibco:statementType "permission" ;
        ibco:text "1011.10 Spiral stairways. Spiral stairways are permitted to be used as a component in the means of egress only within dwelling units or from a space not more than 250 square feet (23 m2) in area and serving not more than five occupants, or from technical production areas in accordance with Section" .

    ibc:sem-ibc2021-1011.11 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.11 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.11-atomic-1,
            ibc:sem-ibc2021-1011.11-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.11-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0573 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014,
            ibc:ibc2021-2407 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.11 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.11 Handrails. Flights of stairways shall have handrails on each side and shall comply with Section 1014. Where glass is used to provide the handrail, the handrail shall comply with Section 2407." .

    ibc:sem-ibc2021-1011.12 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.12 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.12-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.12-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0584 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.12 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.12 Stairway to roof. In buildings four or more stories above grade plane, one stairway shall extend to the roof surface unless the roof has a slope steeper than four units vertical in 12 units horizontal (33-percent slope)." .

    ibc:sem-ibc2021-1011.12.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.12.1 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.12.1-atomic-1 ;
        ibco:modality "must" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.12.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.12.1 Stairway to elevator equipment. Roofs and penthouses containing elevator equipment that must be accessed for maintenance are required to be accessed by a stairway." .

    ibc:sem-ibc2021-1011.12.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.12.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.12.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.12.2-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0587 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1511.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.12.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.12.2 Roof access. Where a stairway is provided to a roof, access to the roof shall be provided through a penthouse complying with Section 1511.2." .

    ibc:sem-ibc2021-1011.13 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.13 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.13-atomic-1,
            ibc:sem-ibc2021-1011.13-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.13-condition-1,
            ibc:sem-ibc2021-1011.13-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.13-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.13 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.13 Guards. Guards shall be provided along stairways and landings where required by Section 1015 and shall be constructed in accordance with Section 1015. Where the roof hatch opening providing the required access is located within 10 feet (3049 mm) of the roof edge, such roof access or roof edge shall be protected by guards installed in accordance with Section 1015." .

    ibc:sem-ibc2021-1011.14 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.14 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-guard,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.14-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.14-measurement-1,
            ibc:sem-ibc2021-1011.14-measurement-2,
            ibc:sem-ibc2021-1011.14-measurement-3 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.14 ;
        ibco:statementType "prohibition" ;
        ibco:text "1011.14 Alternating tread devices. Alternating tread devices are limited to an element of a means of egress in buildings of Groups F, H and S from a mezzanine not more than 250 square feet (23 m2) in area and that serves not more than five occupants; in buildings of Group I-3 from a guard tower, observation station or control room not more than 250 square feet (23 m2) in area and for access to unoccupied roofs. Alternating tread devices used as a means of egress shall not have a rise greater than 20 feet (6096 mm) between floor levels or landings." .

    ibc:sem-ibc2021-1011.14.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.14.1 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.14.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.14.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.14.1 Handrails of alternating tread devices. Handrails shall be provided on both sides of alternating tread devices and shall comply with Section 1014." .

    ibc:sem-ibc2021-1011.14.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.14.2 ;
        ibco:appliesTo ibc:concept-alternating-tread-devices ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.14.2-atomic-1,
            ibc:sem-ibc2021-1011.14.2-atomic-2,
            ibc:sem-ibc2021-1011.14.2-atomic-3,
            ibc:sem-ibc2021-1011.14.2-atomic-4,
            ibc:sem-ibc2021-1011.14.2-atomic-5 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0592 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.14.2-measurement-1,
            ibc:sem-ibc2021-1011.14.2-measurement-2,
            ibc:sem-ibc2021-1011.14.2-measurement-3,
            ibc:sem-ibc2021-1011.14.2-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.14.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.14.2 Treads of alternating tread devices. Alternating tread devices shall have a minimum tread depth of 5 inches (127 mm), a minimum projected tread depth of 81/2 inches (216 mm), a minimum tread width of 7 inches (178 mm) and a maximum riser height of 91/2 inches (241 mm). The tread depth shall be measured horizontally between the vertical planes of the foremost projections of adjacent treads. The riser height shall be measured vertically between the leading edges of adjacent treads. The riser height and tread depth provided shall result in an angle of ascent from the horizontal of between 50 and 70 degrees (0.87 and 1.22 rad). The initial tread of the device shall begin at the same elevation as the platform, landing or floor surface." .

    ibc:sem-ibc2021-1011.15 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.15 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-handrail,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.15-atomic-1,
            ibc:sem-ibc2021-1011.15-atomic-2,
            ibc:sem-ibc2021-1011.15-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.15-measurement-1,
            ibc:sem-ibc2021-1011.15-measurement-2 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1607.17 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.15 ;
        ibco:statementType "permission" ;
        ibco:text "1011.15 Ship’s ladders. Ship’s ladders are permitted to be used in Group I-3 as a component of a means of egress to and from control rooms or elevated facility observation stations not more than 250 square feet (23 m2) with not more than three occupants and for access to unoccupied roofs. The minimum clear width at and below the handrails shall be 20 inches (508 mm). Ship’s ladders shall be designed for the live loads indicated in Section 1607.17." .

    ibc:sem-ibc2021-1011.15.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.15.1 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.15.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.15.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.15.1 Handrails of ship’s ladders. Handrails shall be provided on both sides of ship’s ladders." .

    ibc:sem-ibc2021-1011.15.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.15.2 ;
        ibco:appliesTo ibc:concept-ship-s-ladders ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.15.2-atomic-1,
            ibc:sem-ibc2021-1011.15.2-atomic-2,
            ibc:sem-ibc2021-1011.15.2-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.15.2-measurement-1,
            ibc:sem-ibc2021-1011.15.2-measurement-2,
            ibc:sem-ibc2021-1011.15.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.15.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.15.2 Treads of ship’s ladders. Ship’s ladders shall have a minimum tread depth of 5 inches (127 mm). The tread shall be projected such that the total of the tread depth plus the nosing projection is not less than 81/2 inches (216 mm). The maximum riser height shall be 91/2 inches (241 mm)." .

    ibc:sem-ibc2021-1011.16 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.16 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.16-atomic-1,
            ibc:sem-ibc2021-1011.16-atomic-2,
            ibc:sem-ibc2021-1011.16-atomic-3 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1607.17 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.16 ;
        ibco:statementType "prohibition" ;
        ibco:text "1011.16 Ladders. Permanent ladders shall not serve as a part of the means of egress from occupied spaces within a building. Permanent ladders shall be constructed in accordance with Section 306.5 of the International Mechanical Code and designed for the live loads indicated in Section 1607.17. Permanent ladders shall be permitted to provide access to the following areas:" .

    ibc:sem-ibc2021-1011.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.2 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0511 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1,
            ibc:ibc2021-1009.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.2 Width and capacity. The required capacity of stairways shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm). See Section 1009.3 for accessible means of egress stairways." .

    ibc:sem-ibc2021-1011.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.3 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.3-atomic-1,
            ibc:sem-ibc2021-1011.3-atomic-2,
            ibc:sem-ibc2021-1011.3-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0516 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.3 Headroom. Stairways shall have a headroom clearance of not less than 80 inches (2032 mm) measured vertically from a line connecting the edge of the nosings. Such headroom shall be continuous above the stairway to the point where the line intersects the landing below, one tread depth beyond the bottom riser. The minimum clearance shall be maintained the full width of the stairway and landing." .

    ibc:sem-ibc2021-1011.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.4 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.4-atomic-1,
            ibc:sem-ibc2021-1011.4-atomic-2,
            ibc:sem-ibc2021-1011.4-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.4-condition-1,
            ibc:sem-ibc2021-1011.4-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.4 Walkline. The walkline across winder treads shall be concentric to the direction of travel through the turn and located 12 inches (305 mm) from the side where the winders are narrower. The 12-inch (305 mm) dimension shall be measured from the widest point of the clear stair width at the walking surface of the winder. Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used." .

    ibc:sem-ibc2021-1011.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.5.1,
            ibc:ibc2021-1011.5.5.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5 Stair treads and risers. Stair treads and risers shall comply with Sections 1011.5.1 through 1011.5.5.3." .

    ibc:sem-ibc2021-1011.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.1 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.5.1 ;
        ibco:statementType "declarative" ;
        ibco:text "1011.5.1 Dimension reference surfaces. For the purpose of this section, all dimensions are exclusive of carpets, rugs or runners." .

    ibc:sem-ibc2021-1011.5.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.2-atomic-1,
            ibc:sem-ibc2021-1011.5.2-atomic-2,
            ibc:sem-ibc2021-1011.5.2-atomic-3,
            ibc:sem-ibc2021-1011.5.2-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0523 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.5.2-measurement-1,
            ibc:sem-ibc2021-1011.5.2-measurement-2,
            ibc:sem-ibc2021-1011.5.2-measurement-3,
            ibc:sem-ibc2021-1011.5.2-measurement-4,
            ibc:sem-ibc2021-1011.5.2-measurement-5 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.5.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5.2 Riser height and tread depth. Stair riser heights shall be 7 inches (178 mm) maximum and 4 inches (102 mm) minimum. The riser height shall be measured vertically between the nosings of adjacent treads or between the stairway landing and the adjacent tread. Rectangular tread depths shall be 11 inches (279 mm) minimum measured horizontally between the vertical planes of the foremost projection of adjacent treads and at a right angle to the tread’s nosing. Winder treads shall have a minimum tread depth of 11 inches (279 mm) between the vertical planes of the foremost projection of adjacent treads at the intersections with the walkline and a minimum tread depth of 10 inches (254 mm) within the clear width of the stair." .

    ibc:sem-ibc2021-1011.5.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.3 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0530 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.5.3 ;
        ibco:statementType "permission" ;
        ibco:text "1011.5.3 Winder treads. Winder treads are not permitted in means of egress stairways except within a dwelling unit." .

    ibc:sem-ibc2021-1011.5.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.4 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.4-atomic-1,
            ibc:sem-ibc2021-1011.5.4-atomic-2,
            ibc:sem-ibc2021-1011.5.4-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0534 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.5.4-measurement-1,
            ibc:sem-ibc2021-1011.5.4-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.5.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5.4 Dimensional uniformity. Stair treads and risers shall be of uniform size and shape. The tolerance between the largest and smallest riser height or between the largest and smallest tread depth shall not exceed 3/8 inch (9.5 mm) in any flight of stairs. The greatest winder tread depth at the walkline within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm)." .

    ibc:sem-ibc2021-1011.5.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.4.1 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.4.1-atomic-1,
            ibc:sem-ibc2021-1011.5.4.1-atomic-2,
            ibc:sem-ibc2021-1011.5.4.1-atomic-3,
            ibc:sem-ibc2021-1011.5.4.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.5.4.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.5.4.1-measurement-1,
            ibc:sem-ibc2021-1011.5.4.1-measurement-2,
            ibc:sem-ibc2021-1011.5.4.1-measurement-3 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.5.4.1 ;
        ibco:statementType "permission" ;
        ibco:text "1011.5.4.1 Nonuniform height risers. Where the bottom or top riser adjoins a sloping public way, walkway or driveway having an established grade and serving as a landing, the bottom or top riser is permitted to be reduced along the slope to less than 4 inches (102 mm) in height, with the variation in height of the bottom or top riser not to exceed one unit vertical in 12 units horizontal (8-percent slope) of stair width. The nosings or leading edges of treads at such nonuniform height risers shall have a distinctive marking stripe, different from any other nosing marking provided on the stair flight. The distinctive marking stripe shall be visible in descent of the stair and shall have a slipresistant surface. Marking stripes shall have a width of not less than 1 inch (25 mm) but not more than 2 inches (51 mm)." .

    ibc:sem-ibc2021-1011.5.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.5 ;
        ibco:appliesTo ibc:concept-nosings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.5-atomic-1,
            ibc:sem-ibc2021-1011.5.5-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.5.5-measurement-1,
            ibc:sem-ibc2021-1011.5.5-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.5.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5.5 Nosing and riser profile. Nosings shall have a curvature or bevel of not less than 1/16 inch (1.6 mm) but not more than 9/16 inch (14.3 mm) from the foremost projection of the tread. Risers shall be solid and vertical or sloped under the tread above from the underside of the nosing above at an angle not more than 30 degrees (0.52 rad) from the vertical." .

    ibc:sem-ibc2021-1011.5.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.5.1 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.5.5.1 ;
        ibco:statementType "declarative" ;
        ibco:text "1011.5.5.1 Nosing projection size. The leading edge" .

    ibc:sem-ibc2021-1011.5.5.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.5.2 ;
        ibco:appliesTo ibc:concept-nosing-projections-of-the-leading-edges ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.5.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.5.5.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5.5.2 Nosing projection uniformity. Nosing projections of the leading edges shall be of uniform size, including the projections of the nosing’s leading edge of the floor at the top of a flight." .

    ibc:sem-ibc2021-1011.5.5.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.5.5.3 ;
        ibco:appliesTo ibc:concept-risers ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.5.5.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0544 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.5.5.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.5.5.3 Solid risers. Risers shall be solid." .

    ibc:sem-ibc2021-1011.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.6 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.6-atomic-1,
            ibc:sem-ibc2021-1011.6-atomic-2,
            ibc:sem-ibc2021-1011.6-atomic-3,
            ibc:sem-ibc2021-1011.6-atomic-4,
            ibc:sem-ibc2021-1011.6-atomic-5,
            ibc:sem-ibc2021-1011.6-atomic-6 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.6-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0549 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.6-measurement-1,
            ibc:sem-ibc2021-1011.6-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.6.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.6 Stairway landings. There shall be a floor or landing at the top and bottom of each stairway. The width of landings, measured perpendicularly to the direction of travel, shall be not less than the width of stairways served. Every landing shall have a minimum depth, measured parallel to the direction of travel, equal to the width of the stairway or 48 inches (1219 mm), whichever is less. Doors opening onto a landing shall not reduce the landing to less than one-half the required width. When fully open, the door shall not project more than 7 inches (178 mm) into the required width of a landing. Where wheelchair spaces are required on the stairway landing in accordance with Section 1009.6.3, the wheelchair space shall not be located in the required width of the landing and doors shall not swing over the wheelchair spaces." .

    ibc:sem-ibc2021-1011.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.7 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.7-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0554 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.7 Stairway construction. Stairways shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:sem-ibc2021-1011.7.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.7.1 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.7.1-atomic-1,
            ibc:sem-ibc2021-1011.7.1-atomic-2,
            ibc:sem-ibc2021-1011.7.1-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0559 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.7.1-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.7.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1011.7.1 Stairway walking surface. The walking surface of treads and landings of a stairway shall not be sloped steeper than one unit vertical in 48 units horizontal (2percent slope) in any direction. Stairway treads and landings shall have a solid surface. Finish floor surfaces shall be securely attached." .

    ibc:sem-ibc2021-1011.7.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.7.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.7.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1011.7.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.7.2 Outdoor conditions. Outdoor stairways and outdoor approaches to stairways shall be designed so that water will not accumulate on walking surfaces." .

    ibc:sem-ibc2021-1011.7.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.7.3 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.7.3-atomic-1,
            ibc:sem-ibc2021-1011.7.3-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0564 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.7.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.7.3 Enclosures under interior stairways. The walls and soffits within enclosed usable spaces under enclosed and unenclosed stairways shall be protected by 1-hour fire-resistance-rated construction or the fire-resistance rating of the stairway enclosure, whichever is greater. Access to the enclosed space shall not be directly from within the stairway enclosure." .

    ibc:sem-ibc2021-1011.7.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.7.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.7.4-atomic-1,
            ibc:sem-ibc2021-1011.7.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1011.7.4-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1011.7.4 ;
        ibco:statementType "prohibition" ;
        ibco:text "1011.7.4 Enclosures under exterior stairways. There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1hour fire-resistance-rated construction. The open space under exterior stairways shall not be used for any purpose." .

    ibc:sem-ibc2021-1011.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.8 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.8-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0567 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1011.8-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1011.8 ;
        ibco:statementType "prohibition" ;
        ibco:text "1011.8 Vertical rise. A flight of stairs shall not have a vertical rise greater than 12 feet (3658 mm) between floor levels or landings." .

    ibc:sem-ibc2021-1011.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1011.9 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1011.9-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0569 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1011.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1011.9 Curved stairways. Curved stairways with winder treads shall have treads and risers in accordance with Section 1011.5 and the smallest radius shall be not less than twice the minimum width or required capacity of the stairway." .

    ibc:sem-ibc2021-1012.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.1 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0605 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.1 Scope. The provisions of this section shall apply to ramps used as a component of a means of egress." .

    ibc:sem-ibc2021-1012.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.10 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.10-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0632 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012.10.1,
            ibc:ibc2021-1012.10.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1012.10 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.10 Edge protection. Edge protection complying with Section 1012.10.1 or 1012.10.2 shall be provided on each side of ramp runs and at each side of ramp landings." .

    ibc:sem-ibc2021-1012.10.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.10.1 ;
        ibco:appliesTo ibc:concept-a-curb-rail-wall-or-barrier ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.10.1-atomic-1,
            ibc:sem-ibc2021-1012.10.1-atomic-2,
            ibc:sem-ibc2021-1012.10.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1012.10.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.10.1-measurement-1,
            ibc:sem-ibc2021-1012.10.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1012.10.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.10.1 Curb, rail, wall or barrier. A curb, rail, wall or barrier shall be provided to serve as edge protection. A curb shall be not less than 4 inches (102 mm) in height. Barriers shall be constructed so that the barrier prevents the passage of a 4-inch-diameter (102 mm) sphere, where any portion of the sphere is within 4 inches (102 mm) of the floor or ground surface." .

    ibc:sem-ibc2021-1012.10.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.10.2 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.10.2-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.10.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.10.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.10.2 Extended floor or ground surface. The floor or ground surface of the ramp run or landing shall extend 12 inches (305 mm) minimum beyond the inside face of a handrail complying with Section 1014." .

    ibc:sem-ibc2021-1012.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.2 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.2-atomic-1,
            ibc:sem-ibc2021-1012.2-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.2 Slope. Ramps used as part of a means of egress shall have a running slope not steeper than 1 unit vertical in 12 units horizontal (8.3-percent slope). The slope of other pedestrian ramps shall not be steeper than 1 unit vertical in 8 units horizontal (12.5-percent slope)." .

    ibc:sem-ibc2021-1012.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.3 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.3-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.3 ;
        ibco:statementType "prohibition" ;
        ibco:text "1012.3 Cross slope. The slope measured perpendicular to the direction of travel of a ramp shall not be steeper than one unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1012.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.4 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.4-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.4 Vertical rise. The rise for any ramp run shall be 30 inches (762 mm) maximum." .

    ibc:sem-ibc2021-1012.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.5 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.5-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012.5.1,
            ibc:ibc2021-1012.5.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.5 Minimum dimensions. The minimum dimensions of means of egress ramps shall comply with Sections 1012.5.1 through 1012.5.3." .

    ibc:sem-ibc2021-1012.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.5.1 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-handrail,
            ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.5.1-atomic-1,
            ibc:sem-ibc2021-1012.5.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1012.5.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.5.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1020.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1012.5.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.5.1 Width and capacity. The minimum width and required capacity of a means of egress ramp shall be not less than that required for corridors by Section 1020.3. The clear width of a ramp between handrails, if provided, or other permissible projections shall be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-1012.5.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.5.2 ;
        ibco:appliesTo ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.5.2-atomic-1,
            ibc:sem-ibc2021-1012.5.2-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.5.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.5.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.5.2 Headroom. The minimum headroom in all parts of the means of egress ramp shall be not less than 80 inches (2032 mm) above the finished floor of the ramp run and any intermediate landings. The minimum clearance shall be maintained for the full width of the ramp and landing." .

    ibc:sem-ibc2021-1012.5.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.5.3 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.5.3-atomic-1,
            ibc:sem-ibc2021-1012.5.3-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.5.3-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.5.3 ;
        ibco:statementType "prohibition" ;
        ibco:text "1012.5.3 Restrictions. Means of egress ramps shall not reduce in width in the direction of egress travel. Projections into the required ramp and landing width are prohibited. Doors opening onto a landing shall not reduce the clear width to less than 42 inches (1067 mm)." .

    ibc:sem-ibc2021-1012.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6-atomic-1,
            ibc:sem-ibc2021-1012.6-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012.6.1,
            ibc:ibc2021-1012.6.5 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1012.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.6 Landings. Ramps shall have landings at the bottom and top of each ramp, points of turning, entrance, exits and at doors. Landings shall comply with Sections 1012.6.1 through 1012.6.5." .

    ibc:sem-ibc2021-1012.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6.1 ;
        ibco:appliesTo ibc:concept-landings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6.1-atomic-1,
            ibc:sem-ibc2021-1012.6.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.6.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.6.1 Slope. Landings shall have a slope not steeper than one unit vertical in 48 units horizontal (2-percent slope) in any direction. Changes in level are not permitted." .

    ibc:sem-ibc2021-1012.6.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6.2 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.6.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.6.2 Width. The landing width shall be not less than the width of the widest ramp run adjoining the landing." .

    ibc:sem-ibc2021-1012.6.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6.3 ;
        ibco:appliesTo ibc:concept-the-landing-length ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0620 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.6.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.6.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.6.3 Length. The landing length shall be 60 inches (1525 mm) minimum." .

    ibc:sem-ibc2021-1012.6.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6.4 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1012.6.4-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0624 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.6.4-measurement-1,
            ibc:sem-ibc2021-1012.6.4-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1012.6.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.6.4 Change in direction. Where changes in direction of travel occur at landings provided between ramp runs, the landing shall be 60 inches by 60 inches (1524 mm by 1524 mm) minimum." .

    ibc:sem-ibc2021-1012.6.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.6.5 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.6.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1012.6.5-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1012.6.5 ;
        ibco:statementType "permission" ;
        ibco:text "1012.6.5 Doorways. Where doorways are located adjacent to a ramp landing, maneuvering clearances required by ICC A117.1 are permitted to overlap the required landing area." .

    ibc:sem-ibc2021-1012.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.7 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-handrail,
            ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.7-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1012.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.7 Ramp construction. Ramps shall be built of materials consistent with the types permitted for the type of construction of the building, except that wood handrails shall be permitted for all types of construction." .

    ibc:sem-ibc2021-1012.7.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.7.1 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.7.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.7.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.7.1 Ramp surface. The surface of ramps shall be of slip-resistant materials that are securely attached." .

    ibc:sem-ibc2021-1012.7.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.7.2 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.7.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1012.7.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.7.2 Outdoor conditions. Outdoor ramps and outdoor approaches to ramps shall be designed so that water will not accumulate on walking surfaces." .

    ibc:sem-ibc2021-1012.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.8 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.8-atomic-1,
            ibc:sem-ibc2021-1012.8-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1012.8-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1012.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.8 Handrails. Ramps with a rise greater than 6 inches (152 mm) shall have handrails on both sides. Handrails shall comply with Section 1014." .

    ibc:sem-ibc2021-1012.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1012.9 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1012.9-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1012.9-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1012.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1012.9 Guards. Guards shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:sem-ibc2021-1013.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.1-atomic-1,
            ibc:sem-ibc2021-1013.1-atomic-2,
            ibc:sem-ibc2021-1013.1-atomic-3,
            ibc:sem-ibc2021-1013.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1013.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0640 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1013.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1013.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.1 Where required. Exits and exit access doors shall be marked by an approved exit sign readily visible from any direction of egress travel. The path of egress travel to exits and within exits shall be marked by readily visible exit signs to clearly indicate the direction of egress travel in cases where the exit or the path of egress travel is not immediately visible to the occupants. Intervening means of egress doors within exits shall be marked by exit signs. Exit sign placement shall be such that any point in an exit access corridor or exit passageway is within 100 feet (30 480 mm) or the listed viewing distance of the sign, whichever is less, from the nearest visible exit sign." .

    ibc:sem-ibc2021-1013.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.2 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.2-atomic-1,
            ibc:sem-ibc2021-1013.2-atomic-2,
            ibc:sem-ibc2021-1013.2-atomic-3,
            ibc:sem-ibc2021-1013.2-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1013.2-condition-1,
            ibc:sem-ibc2021-1013.2-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1013.2-measurement-1,
            ibc:sem-ibc2021-1013.2-measurement-2,
            ibc:sem-ibc2021-1013.2-measurement-3 ;
        ibco:modality "required" ;
        ibco:references ibc:ibc2021-1013.1,
            ibc:ibc2021-1013.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1013.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.2 Low-level exit signs in Group R-1. Where exit signs are required in Group R-1 occupancies by Section 1013.1, additional low-level exit signs shall be provided in all areas serving guest rooms in Group R-1 occupancies and shall comply with Section 1013.5. The bottom of the sign shall be not less than 10 inches (254 mm) nor more than 18 inches (455 mm) above the floor level. The sign shall be flush mounted to the door or wall. Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side." .

    ibc:sem-ibc2021-1013.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0648 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1013.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.3 Illumination. Exit signs shall be internally or externally illuminated." .

    ibc:sem-ibc2021-1013.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1013.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1013.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.4 Raised character and braille exit signs. Where exit signs are provided at an area of refuge with direct access to a stairway, an exterior area for assisted rescue, an exit stairway or ramp, an exit passageway, a horizontal exit and the exit discharge, a sign stating \"EXIT\" in visual characters, raised characters and braille and complying with ICC A117.1 shall be provided." .

    ibc:sem-ibc2021-1013.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.5-atomic-1,
            ibc:sem-ibc2021-1013.5-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1013.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.5 Internally illuminated exit signs. Electrically powered, self-luminous and photoluminescent exit signs shall be listed and labeled in accordance with UL 924 and shall be installed in accordance with the manufacturer’s instructions and Chapter 27. Exit signs shall be illuminated at all times." .

    ibc:sem-ibc2021-1013.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.6 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.6-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1013.6.1,
            ibc:ibc2021-1013.6.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1013.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.6 Externally illuminated exit signs. Externally illuminated exit signs shall comply with Sections 1013.6.1 through 1013.6.3." .

    ibc:sem-ibc2021-1013.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.6.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.6.1-atomic-1,
            ibc:sem-ibc2021-1013.6.1-atomic-2,
            ibc:sem-ibc2021-1013.6.1-atomic-3,
            ibc:sem-ibc2021-1013.6.1-atomic-4,
            ibc:sem-ibc2021-1013.6.1-atomic-5 ;
        ibco:hasCondition ibc:sem-ibc2021-1013.6.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1013.6.1-measurement-1,
            ibc:sem-ibc2021-1013.6.1-measurement-2,
            ibc:sem-ibc2021-1013.6.1-measurement-3,
            ibc:sem-ibc2021-1013.6.1-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1013.6.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.6.1 Graphics. Every exit sign and directional exit sign shall have plainly legible letters not less than 6 inches (152 mm) high with the principal strokes of the letters not less than 3/4 inch (19.1 mm) wide. The word “EXIT” shall have letters having a width not less than 2 inches (51 mm) wide, except the letter “I,” and the minimum spacing between letters shall be not less than 3/8 inch (9.5 mm). Signs larger than the minimum established in this section shall have letter widths, strokes and spacing in proportion to their height. The word “EXIT” shall be in high contrast with the background and shall be clearly discernible when the means of exit sign illumination is or is not energized. If a chevron directional indicator is provided as part of the exit sign, the construction shall be such that the direction of the chevron directional indicator cannot be readily changed." .

    ibc:sem-ibc2021-1013.6.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.6.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.6.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1013.6.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.6.2 Exit sign illumination. The face of an exit sign illuminated from an external source shall have an intensity of not less than 5 footcandles (54 lux)." .

    ibc:sem-ibc2021-1013.6.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1013.6.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1013.6.3-atomic-1,
            ibc:sem-ibc2021-1013.6.3-atomic-2,
            ibc:sem-ibc2021-1013.6.3-atomic-3,
            ibc:sem-ibc2021-1013.6.3-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0655 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1013.6.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1013.6.3 Power source. Exit signs shall be illuminated at all times. To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator. The installation of the emergency power system shall be in accordance with Chapter 27. Group I-2, Condition 2 exit sign illumination shall not be provided by unit equipment batteries only." .

    ibc:sem-ibc2021-1014.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.1 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.1-atomic-1,
            ibc:sem-ibc2021-1014.1-atomic-2,
            ibc:sem-ibc2021-1014.1-atomic-3,
            ibc:sem-ibc2021-1014.1-atomic-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.11,
            ibc:ibc2021-1012.8,
            ibc:ibc2021-1014.2,
            ibc:ibc2021-1014.8,
            ibc:ibc2021-1014.9,
            ibc:ibc2021-1030.16,
            ibc:ibc2021-1607.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.1 Where required. Handrails serving flights of stairways, ramps, stepped aisles and ramped aisles shall be adequate in strength and attachment in accordance with Section 1607.9. Handrails required for flights of stairways by Section 1011.11 shall comply with Sections 1014.2 through 1014.9. Handrails required for ramps by Section 1012.8 shall comply with Sections 1014.2 through 1014.8. Handrails for stepped aisles and ramped aisles required by Section 1030.16 shall comply with Sections 1014.2 through 1014.8." .

    ibc:sem-ibc2021-1014.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.2 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.2-atomic-1,
            ibc:sem-ibc2021-1014.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0659 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.2-measurement-1,
            ibc:sem-ibc2021-1014.2-measurement-2,
            ibc:sem-ibc2021-1014.2-measurement-3,
            ibc:sem-ibc2021-1014.2-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1014.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.2 Height. Handrail height, measured above stair tread nosings, or finish surface of ramp slope, shall be uniform, not less than 34 inches (864 mm) and not more than 38 inches (965 mm). Handrail height of alternating tread devices and ships ladders, measured above tread nosings, shall be uniform, not less than 30 inches (762 mm) and not more than 34 inches (864 mm)." .

    ibc:sem-ibc2021-1014.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.3 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0664 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1014.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.3 Handrail graspability. Required handrails shall comply with Section 1014.3.1 or shall provide equivalent graspability." .

    ibc:sem-ibc2021-1014.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.3.1 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.3.1-atomic-1,
            ibc:sem-ibc2021-1014.3.1-atomic-2,
            ibc:sem-ibc2021-1014.3.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1014.3.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.3.1-measurement-1,
            ibc:sem-ibc2021-1014.3.1-measurement-2,
            ibc:sem-ibc2021-1014.3.1-measurement-3,
            ibc:sem-ibc2021-1014.3.1-measurement-4,
            ibc:sem-ibc2021-1014.3.1-measurement-5,
            ibc:sem-ibc2021-1014.3.1-measurement-6,
            ibc:sem-ibc2021-1014.3.1-measurement-7 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1014.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.3.1 Type I. Handrails with a circular cross section shall have an outside diameter of not less than 11/4 inches (32 mm) and not greater than 2 inches (51 mm). Where the handrail is not circular, it shall have a perimeter dimension of not less than 4 inches (102 mm) and not greater than 61/4 inches (160 mm) with a maximum crosssectional dimension of 21/4 inches (57 mm) and minimum cross-sectional dimension of 1 inch (25 mm). Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:sem-ibc2021-1014.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.3.2 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.3.2-atomic-1,
            ibc:sem-ibc2021-1014.3.2-atomic-2,
            ibc:sem-ibc2021-1014.3.2-atomic-3,
            ibc:sem-ibc2021-1014.3.2-atomic-4,
            ibc:sem-ibc2021-1014.3.2-atomic-5 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.3.2-measurement-1,
            ibc:sem-ibc2021-1014.3.2-measurement-2,
            ibc:sem-ibc2021-1014.3.2-measurement-3,
            ibc:sem-ibc2021-1014.3.2-measurement-4,
            ibc:sem-ibc2021-1014.3.2-measurement-5,
            ibc:sem-ibc2021-1014.3.2-measurement-6,
            ibc:sem-ibc2021-1014.3.2-measurement-7,
            ibc:sem-ibc2021-1014.3.2-measurement-8,
            ibc:sem-ibc2021-1014.3.2-measurement-9 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.3.2 Type II. Handrails with a perimeter greater than 61/4 inches (160 mm) shall provide a graspable finger recess area on both sides of the profile. The finger recess shall begin within a distance of 3/4 inch (19 mm) measured vertically from the tallest portion of the profile and achieve a depth of not less than 5/16 inch (8 mm) within 7/8 inch (22 mm) below the widest portion of the profile. This required depth shall continue for not less than 3/8 inch (10 mm) to a level that is not less than 13/4 inches (45 mm) below the tallest portion of the profile. The width of the handrail above the recess shall be not less than 11/4 inches (32 mm) to not greater than 23/4 inches (70 mm). Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:sem-ibc2021-1014.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.4 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.4-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0668 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1014.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.4 Continuity. Handrail gripping surfaces shall be continuous, without interruption by newel posts or other obstructions." .

    ibc:sem-ibc2021-1014.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.5 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.5-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.5 ;
        ibco:statementType "prohibition" ;
        ibco:text "1014.5 Fittings. Handrails shall not rotate within their fittings." .

    ibc:sem-ibc2021-1014.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.6 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.6-atomic-1,
            ibc:sem-ibc2021-1014.6-atomic-2,
            ibc:sem-ibc2021-1014.6-atomic-3,
            ibc:sem-ibc2021-1014.6-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1014.6-condition-1,
            ibc:sem-ibc2021-1014.6-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0676 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.6-measurement-1,
            ibc:sem-ibc2021-1014.6-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.6 Handrail extensions. Handrails shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent flight of stairs or ramp run. Where handrails are not continuous between flights, the handrails shall extend horizontally not less than 12 inches (305 mm) beyond the top riser and continue to slope for the depth of one tread beyond the bottom riser. At ramps where handrails are not continuous between runs, the handrails shall extend horizontally above the landing 12 inches (305 mm) minimum beyond the top and bottom of ramp runs. The extensions of handrails shall be in the same direction of the flights of stairs at stairways and the ramp runs at ramps." .

    ibc:sem-ibc2021-1014.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.7 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.7-atomic-1,
            ibc:sem-ibc2021-1014.7-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.7-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.7 Clearance. Clear space between a handrail and a wall or other surface shall be not less than 11/2 inches (38 mm). A handrail and a wall or other surface adjacent to the handrail shall be free of any sharp or abrasive elements." .

    ibc:sem-ibc2021-1014.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.8 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-handrail,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.8-atomic-1,
            ibc:sem-ibc2021-1014.8-atomic-2,
            ibc:sem-ibc2021-1014.8-atomic-3,
            ibc:sem-ibc2021-1014.8-atomic-4,
            ibc:sem-ibc2021-1014.8-atomic-5 ;
        ibco:hasCondition ibc:sem-ibc2021-1014.8-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.8-measurement-1,
            ibc:sem-ibc2021-1014.8-measurement-2,
            ibc:sem-ibc2021-1014.8-measurement-3,
            ibc:sem-ibc2021-1014.8-measurement-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.8 Projections. On ramps and on ramped aisles that are part of an accessible route, the clear width between handrails shall be 36 inches (914 mm) minimum. Projections into the required width of aisles, stairways and ramps at each side shall not exceed 41/2 inches (114 mm) at or below the handrail height. Projections into the required width shall not be limited above the minimum headroom height required in Section 1011.3. Projections due to intermediate handrails shall not constitute a reduction in the egress width. Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)." .

    ibc:sem-ibc2021-1014.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1014.9 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1014.9-atomic-1,
            ibc:sem-ibc2021-1014.9-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1014.9-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1014.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1014.9 Intermediate handrails. Stairways shall have intermediate handrails located in such a manner that all portions of the stairway minimum width or required capacity are within 30 inches (762 mm) of a handrail. On monumental stairs, handrails shall be located along the most direct path of egress travel." .

    ibc:sem-ibc2021-1015.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.1 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.1-atomic-1,
            ibc:sem-ibc2021-1015.1-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015.2,
            ibc:ibc2021-1015.7,
            ibc:ibc2021-1015.8 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.1 General. Guards shall comply with the provisions of Sections 1015.2 through 1015.7. Operable windows with sills located more than 72 inches (1829 mm) above finished grade or other surface below shall comply with Section 1015.8." .

    ibc:sem-ibc2021-1015.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.2 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.2-atomic-1,
            ibc:sem-ibc2021-1015.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0686 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.2-measurement-1,
            ibc:sem-ibc2021-1015.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1607.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.2 Where required. Guards shall be located along open-sided walking surfaces, including mezzanines, equipment platforms, aisles, stairs, ramps and landings that are located more than 30 inches (762 mm) measured vertically to the floor or grade below at any point within 36 inches (914 mm) horizontally to the edge of the open side. Guards shall be adequate in strength and attachment in accordance with Section 1607.9." .

    ibc:sem-ibc2021-1015.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.2.1 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.2.1-atomic-1,
            ibc:sem-ibc2021-1015.2.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1015.2.1-condition-1,
            ibc:sem-ibc2021-1015.2.1-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1607.9,
            ibc:ibc2021-2407 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.2.1 Glazing. Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407. Where the glazing provided does not meet the strength and attachment requirements of Section 1607.9, complying guards shall be located along glazed sides of open-sided walking surfaces." .

    ibc:sem-ibc2021-1015.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.3 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0700 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1015.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.3 Height. Required guards shall be not less than 42 inches (1067 mm) high, measured vertically as follows:" .

    ibc:sem-ibc2021-1015.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.4 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.4-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0708 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.4-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1015.4 ;
        ibco:statementType "prohibition" ;
        ibco:text "1015.4 Opening limitations. Required guards shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter from the walking surface to the required guard height." .

    ibc:sem-ibc2021-1015.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.5 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1015.5-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.5-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.5 Screen porches. Porches and decks that are enclosed with insect screening shall be provided with guards where the walking surface is located more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1015.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.6 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.6-atomic-1,
            ibc:sem-ibc2021-1015.6-atomic-2,
            ibc:sem-ibc2021-1015.6-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1015.6-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0717 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.6-measurement-1,
            ibc:sem-ibc2021-1015.6-measurement-2,
            ibc:sem-ibc2021-1015.6-measurement-3,
            ibc:sem-ibc2021-1015.6-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.6 Mechanical equipment, systems and devices. Guards shall be provided where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of such components. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-1015.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.7 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.7-atomic-1,
            ibc:sem-ibc2021-1015.7-atomic-2,
            ibc:sem-ibc2021-1015.7-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1015.7-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0719 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.7-measurement-1,
            ibc:sem-ibc2021-1015.7-measurement-2,
            ibc:sem-ibc2021-1015.7-measurement-3,
            ibc:sem-ibc2021-1015.7-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.7 Roof access. Guards shall be provided where the roof hatch opening is located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of the hatch parallel to the roof edge. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-1015.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.8 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-dwellingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.8-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1015.8-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1015.8-measurement-1,
            ibc:sem-ibc2021-1015.8-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1015.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.8 Window openings. Windows in Group R-2 and R-3 buildings including dwelling units, where the bottom of the clear opening of an operable window is located less than 36 inches (914 mm) above the finished floor and more than 72 inches (1829 mm) above the finished grade or other surface below on the exterior of the building, shall comply with one of the following:" .

    ibc:sem-ibc2021-1015.8.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1015.8.1 ;
        ibco:appliesTo ibc:concept-window-opening-control-devices ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1015.8.1-atomic-1,
            ibc:sem-ibc2021-1015.8.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1031.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1015.8.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1015.8.1 Window opening control devices. Window opening control devices shall comply with ASTM F2090. The window opening control device, after operation to release the control device allowing the window to fully open, shall not reduce the minimum net clear opening area of the window unit to less than the area required by Section 1031.3.1." .

    ibc:sem-ibc2021-1016.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1016.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1016.1-atomic-1,
            ibc:sem-ibc2021-1016.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003,
            ibc:ibc2021-1015,
            ibc:ibc2021-1016,
            ibc:ibc2021-1021 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1016.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1016.1 General. The exit access shall comply with the applicable provisions of Sections 1003 through 1015. Exit access arrangement shall comply with Sections 1016 through 1021." .

    ibc:sem-ibc2021-1016.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1016.2 ;
        ibco:appliesTo ibc:concept-egress-through-intervening-spaces ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1016.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0731,
            ibc:ibc2021-ch10-exception-0735 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1016.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1016.2 Egress through intervening spaces. Egress through intervening spaces shall comply with this section." .

    ibc:sem-ibc2021-1016.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1016.2.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-dwellingunit,
            ibc:concept-exit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1016.2.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1016.2.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0743 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1016.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1016.2.1 Multiple tenants. Where more than one tenant occupies any one floor of a building or structure, each tenant space, dwelling unit and sleeping unit shall be provided with access to the required exits without passing through adjacent tenant spaces, dwelling units and sleeping units." .

    ibc:sem-ibc2021-1017.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1017.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.1 General. Travel distance within the exit access portion of the means of egress system shall be in accordance with this section." .

    ibc:sem-ibc2021-1017.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.2-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1017.2-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1017.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1017.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1017.2 Limitations. Exit access travel distance shall not exceed the values given in Table 1017.2. TABLE 1017.2 EXIT ACCESS TRAVEL DISTANCEa For SI: 1 foot = 304.8 mm." .

    ibc:sem-ibc2021-1017.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.2.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.2.1-atomic-1,
            ibc:sem-ibc2021-1017.2.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.2.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1017.2.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017.2,
            ibc:ibc2021-1021 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1017.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.2.1 Exterior egress balcony increase. Exit access travel distances specified in Table 1017.2 shall be increased up to an additional 100 feet (30 480 mm) provided that the last portion of the exit access leading to the exit occurs on an exterior egress balcony constructed in accordance with Section 1021. The length of such balcony shall be not less than the amount of the increase taken." .

    ibc:sem-ibc2021-1017.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.2.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.2.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.2.2-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1017.2.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1017.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.2.2 Groups F-1 and S-1 increase. The maximum exit access travel distance shall be 400 feet (122 m) in Group F-1 or S-1 occupancies where all of the following conditions are met:" .

    ibc:sem-ibc2021-1017.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3-atomic-1,
            ibc:sem-ibc2021-1017.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0759 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1017.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.3 Measurement. Exit access travel distance shall be measured from the most remote point of each room, area or space along the natural and unobstructed path of horizontal and vertical egress travel to the entrance to an exit. Where more than one exit is required, exit access travel distance shall be measured to the nearest exit." .

    ibc:sem-ibc2021-1017.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3.1-atomic-1,
            ibc:sem-ibc2021-1017.3.1-atomic-2,
            ibc:sem-ibc2021-1017.3.1-atomic-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1017.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.3.1 Exit access stairways and ramps. Travel distance on exit access stairways or ramps shall be included in the exit access travel distance measurement. The measurement along stairways shall be made on a plane parallel and tangent to the stair tread nosings in the center of the stair and landings. The measurement along ramps shall be made on the walking surface in the center of the ramp and landings." .

    ibc:sem-ibc2021-1017.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3.2 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017.3.2.1,
            ibc:ibc2021-1017.3.2.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1017.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.3.2 Atriums. Exit acess travel distance for areas open to an atrium shall comply with the requirements of Sections 1017.3.2.1 through 1017.3.2.3." .

    ibc:sem-ibc2021-1017.3.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3.2.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3.2.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.3.2.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1017.3.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.3.2.1 Egress not through the atrium. Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017.2." .

    ibc:sem-ibc2021-1017.3.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3.2.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3.2.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.3.2.2-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1017.3.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1017.3.2.2 Exit access travel distance at the level of exit discharge. Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017.2." .

    ibc:sem-ibc2021-1017.3.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1017.3.2.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1017.3.2.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1017.3.2.3-condition-1,
            ibc:sem-ibc2021-1017.3.2.3-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1017.3.2.3-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1017.3.2.3 ;
        ibco:statementType "permission" ;
        ibco:text "1017.3.2.3 Exit access travel distance at other than the level of exit discharge. Where the path of egress travel is not at the level of exit discharge from the atrium, that portion of the total permitted exit access travel distance that occurs within the atrium shall be not greater than 200 feet (60 960 mm)." .

    ibc:sem-ibc2021-1018.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1018.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1018.1-atomic-1,
            ibc:sem-ibc2021-1018.1-atomic-2,
            ibc:sem-ibc2021-1018.1-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0769 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1018.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1018.1 General. Aisles and aisle accessways serving as a portion of the exit access in the means of egress system shall comply with the requirements of this section. Aisles or aisle accessways shall be provided from all occupied portions of the exit access that contain seats, tables, furnishings, displays and similar fixtures or equipment. The minimum width or required capacity of aisles shall be unobstructed." .

    ibc:sem-ibc2021-1018.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1018.2 ;
        ibco:appliesTo ibc:concept-aisles-and-aisle-accessways-serving-a-room-or-space-used-for-assembly-purposes ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1018.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1018.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1018.2 Aisles in assembly spaces. Aisles and aisle accessways serving a room or space used for assembly purposes shall comply with Section 1030." .

    ibc:sem-ibc2021-1018.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1018.3 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1018.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0772 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1,
            ibc:ibc2021-1020.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1018.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1018.3 Aisles in Groups B and M. In Group B and M occupancies, the minimum clear aisle width shall be determined by Section 1005.1 for the occupant load served, but shall be not less than that required for corridors by Section 1020.3." .

    ibc:sem-ibc2021-1018.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1018.4 ;
        ibco:appliesTo ibc:concept-an-aisle-accessway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1018.4-atomic-1,
            ibc:sem-ibc2021-1018.4-atomic-2,
            ibc:sem-ibc2021-1018.4-atomic-3,
            ibc:sem-ibc2021-1018.4-atomic-4,
            ibc:sem-ibc2021-1018.4-atomic-5 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0774 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1018.4-measurement-1,
            ibc:sem-ibc2021-1018.4-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1018.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1018.4 Aisle accessways in Group M. An aisle accessway shall be provided on not less than one side of each element within the merchandise pad. The minimum clear width for an aisle accessway not required to be accessible shall be 30 inches (762 mm). The required clear width of the aisle accessway shall be measured perpendicular to the elements and merchandise within the merchandise pad. The 30-inch (762 mm) minimum clear width shall be maintained to provide a path to an adjacent aisle or aisle accessway. The common path of egress travel shall not exceed 30 feet (9144 mm) from any point in the merchandise pad." .

    ibc:sem-ibc2021-1018.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1018.5 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1018.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1018.5-condition-1,
            ibc:sem-ibc2021-1018.5-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0776 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1,
            ibc:ibc2021-1020.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1018.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1018.5 Aisles in other than assembly spaces and Groups B and M. In other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005.1 for the occupant load served, but the width shall be not less than that required for corridors by Section 1020.3." .

    ibc:sem-ibc2021-1019.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1019.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1019.1-atomic-1,
            ibc:sem-ibc2021-1019.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1019.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1019.1 General. Exit access stairways and ramps serving as an exit access component in a means of egress system shall comply with the requirements of this section. The number of stories connected by exit access stairways and ramps shall include basements, but not mezzanines." .

    ibc:sem-ibc2021-1019.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1019.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1019.2-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1019.2 ;
        ibco:statementType "exemption" ;
        ibco:text "1019.2 All occupancies. Exit access stairways and ramps that serve floor levels within a single story are not required to be enclosed." .

    ibc:sem-ibc2021-1019.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1019.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1019.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1019.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0781 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1019.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1019.3 Occupancies other than Groups I-2 and I-3. In other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:sem-ibc2021-1019.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1019.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1019.4-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0792 ;
        ibco:modality "required" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1019.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1019.4 Group I-2 and I-3 occupancies. In Group I-2 and I- 3 occupancies, floor openings between stories containing exit access stairways or ramps are required to be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:sem-ibc2021-1020.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.1 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1020.2,
            ibc:ibc2021-1020.7 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1020.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.1 General. Corridors serving as an exit access component in a means of egress system shall comply with the requirements of Sections 1020.2 through 1020.7." .

    ibc:sem-ibc2021-1020.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.2 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.2-atomic-1,
            ibc:sem-ibc2021-1020.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0796 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1020.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1020.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.2 Construction. Corridors shall be fire-resistance rated in accordance with Table 1020.2. The corridor walls required to be fire-resistance rated shall comply with Section 708 for fire partitions." .

    ibc:sem-ibc2021-1020.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.2.1 ;
        ibco:appliesTo ibc:concept-elevator-hoistway-openings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.2.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-3006.2.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1020.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.2.1 Hoistway opening protection. Elevator hoistway openings shall be protected in accordance with Section 3006.2.1." .

    ibc:sem-ibc2021-1020.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.3 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0809 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1,
            ibc:ibc2021-1020.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1020.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.3 Width and capacity. The required capacity of corridors shall be determined as specified in Section 1005.1, but the minimum width shall be not less than that specified in Table 1020.3." .

    ibc:sem-ibc2021-1020.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.4 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.4-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0811 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1020.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.4 Obstruction. The minimum width or required capacity of corridors shall be unobstructed." .

    ibc:sem-ibc2021-1020.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.5 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1020.5-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0813 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1020.5-measurement-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1020.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.5 Dead ends. Where more than one exit or exit access doorway is required, the exit access shall be arranged such that dead-end corridors do not exceed 20 feet (6096 mm) in length." .

    ibc:sem-ibc2021-1020.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.6 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.6-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0819 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1020.6 ;
        ibco:statementType "prohibition" ;
        ibco:text "1020.6 Air movement in corridors. Corridors shall not serve as supply, return, exhaust, relief or ventilation air ducts." .

    ibc:sem-ibc2021-1020.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.6.1 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.6.1-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1020.6.1 ;
        ibco:statementType "permission" ;
        ibco:text "1020.6.1 Corridor ceiling. Use of the space between the corridor ceiling and the floor or roof structure above as a return air plenum is permitted for one or more of the following conditions:" .

    ibc:sem-ibc2021-1020.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1020.7 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1020.7-atomic-1,
            ibc:sem-ibc2021-1020.7-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1020.7-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0831 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1020.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1020.7 Corridor continuity. Fire-resistance-rated corridors shall be continuous from the point of entry to an exit, and shall not be interrupted by intervening rooms. Where the path of egress travel within a fire-resistance-rated corridor to the exit includes travel along unenclosed exit access stairways or ramps, the fire-resistance rating shall be continuous for the length of the stairway or ramp and for the length of the connecting corridor on the adjacent floor leading to the exit." .

    ibc:sem-ibc2021-1021.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1021.1 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1021.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1021.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1021.1 General. Balconies used for egress purposes shall conform to the same requirements as corridors for minimum width, required capacity, headroom, dead ends and projections." .

    ibc:sem-ibc2021-1021.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1021.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1021.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0837 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1021.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1021.2 Wall separation. Exterior egress balconies shall be separated from the interior of the building by walls and opening protectives as required for corridors." .

    ibc:sem-ibc2021-1021.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1021.3 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1021.3-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1021.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1021.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1021.3 Openness. The long side of an egress balcony shall be not less than 50 percent open, and the open area above the guards shall be so distributed as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-1021.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1021.4 ;
        ibco:appliesTo ibc:concept-exterior-egress-balconies ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1021.4-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1021.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1021.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1021.4 Location. Exterior egress balconies shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the egress balcony to the following:" .

    ibc:sem-ibc2021-1022.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1022.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1022.1-atomic-1,
            ibc:sem-ibc2021-1022.1-atomic-2,
            ibc:sem-ibc2021-1022.1-atomic-3,
            ibc:sem-ibc2021-1022.1-atomic-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003,
            ibc:ibc2021-1015,
            ibc:ibc2021-1022,
            ibc:ibc2021-1027 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1022.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1022.1 General. Exits shall comply with Sections 1022 through 1027 and the applicable requirements of Sections 1003 through 1015. An exit shall not be used for any purpose that interferes with its function as a means of egress. Once a given level of exit protection is achieved, such level of protection shall not be reduced until arrival at the exit discharge. Exits shall be continuous from the point of entry into the exit to the exit discharge." .

    ibc:sem-ibc2021-1022.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1022.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1022.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1022.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1022.2 Exterior exit doors. Buildings or structures used for human occupancy shall have not less than one exterior door that meets the requirements of Section 1010.1.1." .

    ibc:sem-ibc2021-1022.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1022.2.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1022.2.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1022.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1022.2.1 Detailed requirements. Exterior exit doors shall comply with the applicable requirements of Section 1010.1." .

    ibc:sem-ibc2021-1022.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1022.2.2 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1022.2.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1022.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1022.2.2 Arrangement. Exterior exit doors shall lead directly to the exit discharge or the public way." .

    ibc:sem-ibc2021-1023.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.1-atomic-1,
            ibc:sem-ibc2021-1023.1-atomic-2,
            ibc:sem-ibc2021-1023.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1024,
            ibc:ibc2021-1028.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.1 General. Interior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section. Interior exit stairways and ramps shall be enclosed and lead directly to the exterior of the building or shall be extended to the exterior of the building with an exit passageway conforming to the requirements of Section 1024, except as permitted in Section 1028.2. An interior exit stairway or ramp shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1023.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.10 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.10-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.10-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.9.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.10 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.10 Elevator lobby identification signs. At landings in interior exit stairways where two or more doors lead to the floor level, any door with direct access to an enclosed elevator lobby shall be identified by signage located on the door or directly adjacent to the door stating “Elevator Lobby.” Signage shall be in accordance with Section 1023.9.1, Items 4, 5 and 6." .

    ibc:sem-ibc2021-1023.11 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.11 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.11-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.11-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.11 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.11 Tactile floor-level signs. Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117.1 shall be located at each floor-level landing adjacent to the door leading from the interior exit stairway and ramp into the corridor." .

    ibc:sem-ibc2021-1023.12 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.12 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.12-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.12-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1023.12 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.12 Smokeproof enclosures. Where required by Section 403.5.4, 405.7.2 or 412.2.2.1, interior exit stairways and ramps shall be smokeproof enclosures in accordance with Section 909.20." .

    ibc:sem-ibc2021-1023.12.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.12.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.12.1-atomic-1,
            ibc:sem-ibc2021-1023.12.1-atomic-2,
            ibc:sem-ibc2021-1023.12.1-atomic-3,
            ibc:sem-ibc2021-1023.12.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.12.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0892 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.3,
            ibc:ibc2021-1023.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1023.12.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.12.1 Termination and extension. A smokeproof enclosure shall terminate at an exit discharge or a public way. The smokeproof enclosure shall be permitted to be extended by an exit passageway in accordance with Section 1023.3. The exit passageway shall be without openings other than the fire door assembly required by Section 1023.3.1 and those necessary for egress from the exit passageway. The exit passageway shall be separated from the remainder of the building by 2-hour fire barriers constructed in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1023.12.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.12.2 ;
        ibco:appliesTo ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.12.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0897 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.12.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.12.2 Enclosure access. Access to the stairway or ramp within a smokeproof enclosure shall be by way of a vestibule or an open exterior balcony." .

    ibc:sem-ibc2021-1023.13 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.13 ;
        ibco:appliesTo ibc:concept-standpipes-and-standpipe-hose-connections ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.13-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.13-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.13 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.13 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1023.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.2-atomic-1,
            ibc:sem-ibc2021-1023.2-atomic-2,
            ibc:sem-ibc2021-1023.2-atomic-3,
            ibc:sem-ibc2021-1023.2-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.2-condition-1,
            ibc:sem-ibc2021-1023.2-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0851 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.2 Construction. Enclosures for interior exit stairways and ramps shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both. Interior exit stairway and ramp enclosures shall have a fire-resistance rating of not less than 2 hours where connecting four stories or more and not less than 1 hour where connecting less than four stories. The number of stories connected by the interior exit stairways or ramps shall include any basements, but not any mezzanines. Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours." .

    ibc:sem-ibc2021-1023.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0857 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1023.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.3 Termination. Interior exit stairways and ramps shall terminate at an exit discharge or a public way." .

    ibc:sem-ibc2021-1023.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.3.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.3.1-atomic-1,
            ibc:sem-ibc2021-1023.3.1-atomic-2,
            ibc:sem-ibc2021-1023.3.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.3.1-condition-1,
            ibc:sem-ibc2021-1023.3.1-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0859 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1023.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.3.1 Extension. Where interior exit stairways and ramps are extended to an exit discharge or a public way by an exit passageway, the interior exit stairway and ramp shall be separated from the exit passageway by a fire barrier constructed in accordance with Section 707 or a horizontal assembly constructed in accordance with Section 711, or both. The fire-resistance rating shall be not less than that required for the interior exit stairway and ramp. A fire door assembly complying with Section 716 shall be installed in the fire barrier to provide a means of egress from the interior exit stairway and ramp to the exit passageway. Openings in the fire barrier other than the fire door assembly are prohibited. Penetrations of the fire barrier are prohibited." .

    ibc:sem-ibc2021-1023.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.4-atomic-1,
            ibc:sem-ibc2021-1023.4-atomic-2,
            ibc:sem-ibc2021-1023.4-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1023.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.4 Openings. Interior exit stairway and ramp opening protectives shall be in accordance with the requirements of Section 716. Openings in interior exit stairways and ramps other than unprotected exterior openings shall be limited to those required for exit access to the enclosure from normally occupied spaces and for egress from the enclosure. Elevators shall not open into interior exit stairways and ramps." .

    ibc:sem-ibc2021-1023.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.5 ;
        ibco:confidence 0.81 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0872 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1023.5 ;
        ibco:statementType "declarative" ;
        ibco:text "1023.5 Penetrations. Penetrations into or through interior exit stairways and ramps are prohibited except for the following:" .

    ibc:sem-ibc2021-1023.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.6 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.6-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1023.5 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1023.6 ;
        ibco:statementType "permission" ;
        ibco:text "1023.6 Ventilation. Equipment and ductwork for interior exit stairway and ramp ventilation as permitted by Section 1023.5 shall comply with one of the following items:" .

    ibc:sem-ibc2021-1023.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.7 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.7-atomic-1,
            ibc:sem-ibc2021-1023.7-atomic-2,
            ibc:sem-ibc2021-1023.7-atomic-3,
            ibc:sem-ibc2021-1023.7-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.7-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1023.7-measurement-1,
            ibc:sem-ibc2021-1023.7-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.7 Interior exit stairway and ramp exterior walls. Exterior walls of the interior exit stairway or ramp shall comply with the requirements of Section 705 for exterior walls. Where nonrated walls or unprotected openings enclose the exterior of the stairway or ramps and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour. Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour. This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the topmost landing of the stairway or ramp, or to the roof line, whichever is lower." .

    ibc:sem-ibc2021-1023.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.8 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.8-atomic-1,
            ibc:sem-ibc2021-1023.8-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1023.8-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1013 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1023.8 ;
        ibco:statementType "prohibition" ;
        ibco:text "1023.8 Barrier at level of exit discharge. An interior exit stairway and ramp shall not continue below its level of exit discharge unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below. Directional exit signs shall be provided as specified in Section 1013." .

    ibc:sem-ibc2021-1023.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.9 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.9-atomic-1,
            ibc:sem-ibc2021-1023.9-atomic-2,
            ibc:sem-ibc2021-1023.9-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1023.9-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1023.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.9 Stairway identification signs. A sign shall be provided at each floor landing in an interior exit stairway and ramp connecting more than three stories designating the floor level, the terminus of the top and bottom of the interior exit stairway and ramp and the identification of the stairway or ramp. The signage shall state the story of and direction to the exit discharge, and the availability of roof access from the interior exit stairway and ramp for the fire department. The bottom of the sign shall be located not less than 5 feet (1524 mm) above the floor landing in a position that is readily visible when the doors are in the open and closed positions." .

    ibc:sem-ibc2021-1023.9.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1023.9.1 ;
        ibco:appliesTo ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1023.9.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1023.9.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1023.9.1 Signage requirements. Stairway identification signs shall comply with all of the following requirements:" .

    ibc:sem-ibc2021-1024.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.1-atomic-1,
            ibc:sem-ibc2021-1024.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1024.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1024.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.1 General. Exit passageways serving as an exit component in a means of egress system shall comply with the requirements of this section. An exit passageway shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1024.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.2-atomic-1,
            ibc:sem-ibc2021-1024.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0904 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1024.2-measurement-1,
            ibc:sem-ibc2021-1024.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1024.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.2 Width and capacity. The required capacity of exit passageways shall be determined as specified in Section 1005.1 but the minimum width shall be not less than 44 inches (1118 mm), except that exit passageways serving an occupant load of less than 50 shall be not less than 36 inches (914 mm) in width. The minimum width or required capacity of exit passageways shall be unobstructed." .

    ibc:sem-ibc2021-1024.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.3-atomic-1,
            ibc:sem-ibc2021-1024.3-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1024.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.3 Construction. Exit passageway enclosures shall have walls, floors and ceilings of not less than a 1-hour fireresistance rating, and not less than that required for any connecting interior exit stairway or ramp. Exit passageways shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1024.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.4-atomic-1,
            ibc:sem-ibc2021-1024.4-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1024.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.4 Termination. Exit passageways on the level of exit discharge shall terminate at an exit discharge. Exit passageways on other levels shall terminate at an exit." .

    ibc:sem-ibc2021-1024.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.5-atomic-1,
            ibc:sem-ibc2021-1024.5-atomic-2,
            ibc:sem-ibc2021-1024.5-atomic-3,
            ibc:sem-ibc2021-1024.5-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1024.5-condition-1,
            ibc:sem-ibc2021-1024.5-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1024.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.5 Openings. Exit passageway opening protectives shall be in accordance with the requirements of Section 716. Except as permitted in Section 402.8.7, openings in exit passageways other than unprotected exterior openings shall be limited to those necessary for exit access to the exit passageway from normally occupied spaces and for egress from the exit passageway. Where an interior exit stairway or ramp is extended to an exit discharge or a public way by an exit passageway, the exit passageway shall comply with Section 1023.3.1. Elevators shall not open into an exit passageway." .

    ibc:sem-ibc2021-1024.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.6 ;
        ibco:confidence 0.81 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0915 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1024.6 ;
        ibco:statementType "declarative" ;
        ibco:text "1024.6 Penetrations. Penetrations into or through an exit passageway are prohibited except for the following:" .

    ibc:sem-ibc2021-1024.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.7 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.7-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1024.6 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1024.7 ;
        ibco:statementType "permission" ;
        ibco:text "1024.7 Ventilation. Equipment and ductwork for exit passageway ventilation as permitted by Section 1024.6 shall comply with one of the following:" .

    ibc:sem-ibc2021-1024.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.8 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.8-atomic-1,
            ibc:sem-ibc2021-1024.8-atomic-2,
            ibc:sem-ibc2021-1024.8-atomic-3,
            ibc:sem-ibc2021-1024.8-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1024.8-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1024.8-measurement-1,
            ibc:sem-ibc2021-1024.8-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1024.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.8 Exit passageway exterior walls. Exterior walls of the exit passageway shall comply with Section 705. Where nonrated walls or unprotected openings enclose the exterior of the exit passageway and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour. Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour. This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the floor of the exit passageway, or to the roof line, whichever is lower." .

    ibc:sem-ibc2021-1024.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1024.9 ;
        ibco:appliesTo ibc:concept-standpipes-and-standpipe-hose-connections ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1024.9-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1024.9-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1024.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1024.9 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1025.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0925 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.1 General. Approved luminous egress path markings delineating the exit path shall be provided in high-rise buildings of Group A, B, E, I-1, M or R-1 occupancies in accordance with this section." .

    ibc:sem-ibc2021-1025.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1025.2.1,
            ibc:ibc2021-1025.2.6.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2 Markings within exit components. Egress path markings shall be provided in interior exit stairways, interior exit ramps and exit passageways, in accordance with Sections 1025.2.1 through 1025.2.6.3." .

    ibc:sem-ibc2021-1025.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.1 ;
        ibco:appliesTo ibc:concept-a-solid-and-continuous-stripe ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.1-atomic-1,
            ibc:sem-ibc2021-1025.2.1-atomic-2,
            ibc:sem-ibc2021-1025.2.1-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0928 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.1-measurement-1,
            ibc:sem-ibc2021-1025.2.1-measurement-2,
            ibc:sem-ibc2021-1025.2.1-measurement-3,
            ibc:sem-ibc2021-1025.2.1-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1025.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.1 Steps. A solid and continuous stripe shall be applied to the horizontal leading edge of each step and shall extend for the full length of the step. Outlining stripes shall have a minimum horizontal width of 1 inch (25 mm) and a maximum width of 2 inches (51 mm). The leading edge of the stripe shall be placed not more than 1/2 inch (12.7 mm) from the leading edge of the step and the stripe shall not overlap the leading edge of the step by not more than 1/2 inch (12.7 mm) down the vertical face of the step." .

    ibc:sem-ibc2021-1025.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.2 ;
        ibco:appliesTo ibc:concept-the-leading-edge-of-landings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1025.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.2 Landings. The leading edge of landings shall be marked with a stripe consistent with the dimensional requirements for steps." .

    ibc:sem-ibc2021-1025.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.3 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.3-atomic-1,
            ibc:sem-ibc2021-1025.2.3-atomic-2,
            ibc:sem-ibc2021-1025.2.3-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.2.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0931 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.3-measurement-1,
            ibc:sem-ibc2021-1025.2.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1025.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.3 Handrails. Handrails and handrail extensions shall be marked with a solid and continuous stripe having a minimum width of 1 inch (25 mm). The stripe shall be placed on the top surface of the handrail for the entire length of the handrail, including extensions and newel post caps. Where handrails or handrail extensions bend or turn corners, the stripe shall not have a gap of more than 4 inches (102 mm)." .

    ibc:sem-ibc2021-1025.2.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.4-atomic-1,
            ibc:sem-ibc2021-1025.2.4-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0933 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.4-measurement-1,
            ibc:sem-ibc2021-1025.2.4-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.4 Perimeter demarcation lines. Stair landings and other floor areas within interior exit stairways, interior exit ramps and exit passageways, with the exception of the sides of steps, shall be provided with solid and continuous demarcation lines on the floor or on the walls or a combination of both. The stripes shall be 1 to 2 inches (25 mm to 51 mm) wide with interruptions not exceeding 4 inches (102 mm)." .

    ibc:sem-ibc2021-1025.2.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.4.1 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.4.1-atomic-1,
            ibc:sem-ibc2021-1025.2.4.1-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0935 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.4.1-measurement-1,
            ibc:sem-ibc2021-1025.2.4.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.4.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.4.1 Floor-mounted demarcation lines. Perimeter demarcation lines shall be placed within 4 inches (102 mm) of the wall and shall extend to within 2 inches (51 mm) of the markings on the leading edge of landings. The demarcation lines shall continue across the floor in front of all doors." .

    ibc:sem-ibc2021-1025.2.4.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.4.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.4.2-atomic-1,
            ibc:sem-ibc2021-1025.2.4.2-atomic-2,
            ibc:sem-ibc2021-1025.2.4.2-atomic-3,
            ibc:sem-ibc2021-1025.2.4.2-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.2.4.2-condition-1,
            ibc:sem-ibc2021-1025.2.4.2-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0937 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.4.2-measurement-1,
            ibc:sem-ibc2021-1025.2.4.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.4.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.4.2 Wall-mounted demarcation lines. Perimeter demarcation lines shall be placed on the wall with the bottom edge of the stripe not more than 4 inches (102 mm) above the finished floor. At the top or bottom of the stairs, demarcation lines shall drop vertically to the floor within 2 inches (51 mm) of the step or landing edge. Demarcation lines on walls shall transition vertically to the floor and then extend across the floor where a line on the floor is the only practical method of outlining the path. Where the wall line is broken by a door, demarcation lines on walls shall continue across the face of the door or transition to the floor and extend across the floor in front of such door." .

    ibc:sem-ibc2021-1025.2.4.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.4.3 ;
        ibco:appliesTo ibc:concept-where-a-wall-mounted-demarcation-line-transitions-to-a-floor-mounted-demarcation-line-or-vice-versa-the-wall-mounted-demarcation-line ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.4.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.2.4.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1025.2.4.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.4.3 Transition. Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking." .

    ibc:sem-ibc2021-1025.2.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.5 ;
        ibco:appliesTo ibc:concept-obstacles-at-or-below-6-feet-6-inches-1981-mm-in-height-and-projecting-more-than-4-inches-102-mm-into-the-egress-path ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.5-atomic-1,
            ibc:sem-ibc2021-1025.2.5-atomic-2,
            ibc:sem-ibc2021-1025.2.5-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0940 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.5-measurement-1,
            ibc:sem-ibc2021-1025.2.5-measurement-2,
            ibc:sem-ibc2021-1025.2.5-measurement-3,
            ibc:sem-ibc2021-1025.2.5-measurement-4,
            ibc:sem-ibc2021-1025.2.5-measurement-5 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.5 Obstacles. Obstacles at or below 6 feet 6 inches (1981 mm) in height and projecting more than 4 inches (102 mm) into the egress path shall be outlined with markings not less than 1 inch (25 mm) in width comprised of a pattern of alternating equal bands, of luminous material and black, with the alternating bands not more than 2 inches (51 mm) thick and angled at 45 degrees (0.79 rad). Obstacles shall include, but are not limited to, standpipes, hose cabinets, wall projections and restricted height areas. However, such markings shall not conceal any required information or indicators including but not limited to instructions to occupants for the use of standpipes." .

    ibc:sem-ibc2021-1025.2.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.6 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.6-atomic-1 ;
        ibco:modality "must" ;
        ibco:references ibc:ibc2021-1025.2.6.1,
            ibc:ibc2021-1025.2.6.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.6 Doors within the exit path. Doors through which occupants must pass in order to complete the exit path shall be provided with markings complying with Sections 1025.2.6.1 through 1025.2.6.3." .

    ibc:sem-ibc2021-1025.2.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.6.1 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.6.1-atomic-1,
            ibc:sem-ibc2021-1025.2.6.1-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.6.1-measurement-1,
            ibc:sem-ibc2021-1025.2.6.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1025.2.6.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.6.1 Emergency exit symbol. The doors shall be identified by a low-location luminous emergency exit symbol complying with NFPA 170. The exit symbol shall be not less than 4 inches (102 mm) in height and shall be mounted on the door, centered horizontally, with the top of the symbol not higher than 18 inches (457 mm) above the finished floor." .

    ibc:sem-ibc2021-1025.2.6.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.6.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.6.2-atomic-1,
            ibc:sem-ibc2021-1025.2.6.2-atomic-2,
            ibc:sem-ibc2021-1025.2.6.2-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.2.6.2-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1025.2.6.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.6.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.6.2 Door hardware markings. Door hardware shall be marked with not less than 16 square inches (10323 mm2) of luminous material. This marking shall be located behind, immediately adjacent to, or on the door handle or escutcheon. Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad." .

    ibc:sem-ibc2021-1025.2.6.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.2.6.3 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.2.6.3-atomic-1,
            ibc:sem-ibc2021-1025.2.6.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.2.6.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.2.6.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.2.6.3 Door frame markings. The top and sides of the door frame shall be marked with a solid and continuous 1-inch- to 2-inch-wide (25 mm to 51 mm) stripe. Where the door molding does not provide sufficient flat surface on which to locate the stripe, the stripe shall be permitted to be located on the wall surrounding the frame." .

    ibc:sem-ibc2021-1025.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.3 ;
        ibco:appliesTo ibc:concept-placement-and-dimensions-of-markings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1025.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.3 Uniformity. Placement and dimensions of markings shall be consistent and uniform throughout the same enclosure." .

    ibc:sem-ibc2021-1025.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.4 ;
        ibco:appliesTo ibc:concept-luminous-egress-path-markings ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.4-atomic-1,
            ibc:sem-ibc2021-1025.4-atomic-2,
            ibc:sem-ibc2021-1025.4-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.4 Self-luminous and photoluminescent. Luminous egress path markings shall be permitted to be made of any material, including paint, provided that an electrical charge is not required to maintain the required luminance. Such materials shall include, but not be limited to, self-luminous materials and photoluminescent materials. Materials shall comply with either of the following standards:" .

    ibc:sem-ibc2021-1025.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1025.5 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1025.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1025.5-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1025.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1025.5 Illumination. Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy." .

    ibc:sem-ibc2021-1026.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.1-atomic-1,
            ibc:sem-ibc2021-1026.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1026.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0952 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1026.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.1 General. Horizontal exits serving as an exit in a means of egress system shall comply with the requirements of this section. A horizontal exit shall not serve as the only exit from a portion of a building, and where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits." .

    ibc:sem-ibc2021-1026.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.2-atomic-1,
            ibc:sem-ibc2021-1026.2-atomic-2,
            ibc:sem-ibc2021-1026.2-atomic-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0957 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1026.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.2 Separation. The separation between buildings or refuge areas connected by a horizontal exit shall be provided by a fire wall complying with Section 706; or by a fire barrier complying with Section 707 or a horizontal assembly complying with Section 711, or both. The minimum fireresistance rating of the separation shall be 2 hours. Opening protectives in horizontal exits shall also comply with Section" .

    ibc:sem-ibc2021-1026.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.3 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.3-atomic-1,
            ibc:sem-ibc2021-1026.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1026.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1026.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.3 Opening protectives. Fire doors in horizontal exits shall be self-closing or automatic-closing when activated by a smoke detector in accordance with Section 716.2.6.6. Doors, where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716.2.6.6." .

    ibc:sem-ibc2021-1026.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.4 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-occupantload ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.4-atomic-1,
            ibc:sem-ibc2021-1026.4-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy" ;
        ibco:sourceNode ibc:ibc2021-1026.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.4 Refuge area. The refuge area of a horizontal exit shall be a space occupied by the same tenant or a public area and each such refuge area shall be adequate to accommodate the original occupant load of the refuge area plus the occupant load anticipated from the adjoining compartment. The anticipated occupant load from the adjoining compartment shall be based on the capacity of the horizontal exit doors entering the refuge area or the total occupant load of the adjoining compartment, whichever is less." .

    ibc:sem-ibc2021-1026.4.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.4.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.4.1-atomic-1,
            ibc:sem-ibc2021-1026.4.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1026.4.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1026.4.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1026.4.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.4.1 Capacity. The capacity of the refuge area shall be computed based on a net floor area allowance of 3 square feet (0.2787 m2) for each occupant to be accommodated therein. Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407.5.3, 408.6.2, 420.6.1 and 422.3.2 as applicable." .

    ibc:sem-ibc2021-1026.4.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.4.2 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-occupantload,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.4.2-atomic-1,
            ibc:sem-ibc2021-1026.4.2-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0962 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1026.4.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.4.2 Number of exits. The refuge area into which a horizontal exit leads shall be provided with exits adequate to meet the occupant requirements of this chapter, but not including the added occupant load imposed by persons entering the refuge area through horizontal exits from other areas. Not less than one refuge area exit shall lead directly to the exterior or to an interior exit stairway or ramp." .

    ibc:sem-ibc2021-1026.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1026.5 ;
        ibco:appliesTo ibc:concept-standpipes-and-standpipe-hose-connections ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1026.5-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1026.5-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1026.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1026.5 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1027.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1027.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1027.1 General. Exterior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1027.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.2-atomic-1,
            ibc:sem-ibc2021-1027.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1027.2-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1027.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1027.2 Use in a means of egress. Exterior exit stairways shall not be used as an element of a required means of egress for Group I-2 occupancies. For occupancies in other than Group I-2, exterior exit stairways and ramps shall be permitted as an element of a required means of egress for buildings not exceeding six stories above grade plane or that are not high-rise buildings." .

    ibc:sem-ibc2021-1027.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-guard,
            ibc:concept-handrail,
            ibc:concept-meansofegress,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.3-atomic-1,
            ibc:sem-ibc2021-1027.3-atomic-2,
            ibc:sem-ibc2021-1027.3-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1027.3-measurement-1,
            ibc:sem-ibc2021-1027.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1027.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1027.3 Open side. Exterior exit stairways and ramps serving as an element of a required means of egress shall be open on not less than one side, except for required structural columns, beams, handrails and guards. An open side shall have not less than 35 square feet (3.3 m2) of aggregate open area adjacent to each floor level and the level of each intermediate landing. The required open area shall be located not less than 42 inches (1067 mm) above the adjacent floor or landing level." .

    ibc:sem-ibc2021-1027.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.4 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.4-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1027.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1027.4 Side yards. The open areas adjoining exterior exit stairways or ramps shall be either yards, courts or public ways; the remaining sides are permitted to be enclosed by the exterior walls of the building." .

    ibc:sem-ibc2021-1027.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.5-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0974 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1027.5-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1027.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1027.5 Location. Exterior exit stairways and ramps shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the stairway or ramps, including landings, to:" .

    ibc:sem-ibc2021-1027.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1027.6 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1027.6-atomic-1,
            ibc:sem-ibc2021-1027.6-atomic-2,
            ibc:sem-ibc2021-1027.6-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1027.6-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0976 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.2,
            ibc:ibc2021-1023.7 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1027.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1027.6 Exterior exit stairway and ramp protection. Exterior exit stairways and ramps shall be separated from the interior of the building as required in Section 1023.2. Openings shall be limited to those necessary for egress from normally occupied spaces. Where a vertical plane projecting from the edge of an exterior exit stairway or ramp and landings is exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the exterior wall shall be rated in accordance with Section 1023.7." .

    ibc:sem-ibc2021-1028.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1028.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1028.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003,
            ibc:ibc2021-1015,
            ibc:ibc2021-1028,
            ibc:ibc2021-1029 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1028.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1028.1 General. The exit discharge shall comply with Sections 1028 and 1029 and the applicable requirements of Sections 1003 through 1015." .

    ibc:sem-ibc2021-1028.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1028.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1028.2-atomic-1,
            ibc:sem-ibc2021-1028.2-atomic-2,
            ibc:sem-ibc2021-1028.2-atomic-3,
            ibc:sem-ibc2021-1028.2-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0989,
            ibc:ibc2021-ch10-exception-0999 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1028.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1028.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1028.2 Exit discharge. Exits shall discharge directly to the exterior of the building. The exit discharge shall be at grade or shall provide a direct path of egress travel to grade. The exit discharge shall not reenter a building. The combined use of Exceptions 1 and 2 shall not exceed 50 percent of the number and minimum width or required capacity of the required exits." .

    ibc:sem-ibc2021-1028.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1028.3 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1028.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1028.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1028.3 Exit discharge width or capacity. The minimum width or required capacity of the exit discharge shall be not less than the minimum width or required capacity of the exits being served." .

    ibc:sem-ibc2021-1028.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1028.4 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1028.4-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy" ;
        ibco:sourceNode ibc:ibc2021-1028.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1028.4 Exit discharge components. Exit discharge components shall be sufficiently open to the exterior so as to minimize the accumulation of smoke and toxic gases. *" .

    ibc:sem-ibc2021-1028.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1028.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1028.5-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1005 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1028.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1028.5 Access to a public way. The exit discharge shall provide a direct and unobstructed access to a public way." .

    ibc:sem-ibc2021-1029.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1029.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1029.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1029.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1029.1 General. Egress courts serving as an exit discharge component in the means of egress system shall comply with the requirements in this section." .

    ibc:sem-ibc2021-1029.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1029.2 ;
        ibco:appliesTo ibc:concept-the-required-capacity-of-egress-courts ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1029.2-atomic-1,
            ibc:sem-ibc2021-1029.2-atomic-2,
            ibc:sem-ibc2021-1029.2-atomic-3,
            ibc:sem-ibc2021-1029.2-atomic-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1013 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1029.2-measurement-1,
            ibc:sem-ibc2021-1029.2-measurement-2,
            ibc:sem-ibc2021-1029.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1029.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1029.2 Width or capacity. The required capacity of egress courts shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm), except as specified herein. Egress courts serving Group R-3 and U occupancies shall be not less than 36 inches (914 mm) in width. The required capacity and width of egress courts shall be unobstructed to a height of 7 feet (2134 mm). The width of the egress court shall be not less than the required capacity." .

    ibc:sem-ibc2021-1029.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1029.3 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1029.3-atomic-1,
            ibc:sem-ibc2021-1029.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1029.3-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1015 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1029.3-measurement-1,
            ibc:sem-ibc2021-1029.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1029.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1029.3 Construction and openings. Where an egress court serving a building or portion thereof is less than 10 feet (3048 mm) in width, the egress court walls shall have not less than 1-hour fire-resistance-rated construction for a distance of 10 feet (3048 mm) above the floor of the egress court. Openings within such walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour." .

    ibc:sem-ibc2021-1030.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.1 ;
        ibco:appliesTo ibc:concept-a-room-or-space-used-for-assembly-purposes-that-contains-seats-tables-displays-equipment-or-other-material ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.1 General. A room or space used for assembly purposes that contains seats, tables, displays, equipment or other material shall comply with this section." .

    ibc:sem-ibc2021-1030.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.1.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.1.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.1.1 Bleachers. Bleachers, grandstands and folding and telescopic seating, that are not building elements, shall comply with ICC 300." .

    ibc:sem-ibc2021-1030.1.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.1.1.1 ;
        ibco:appliesTo ibc:concept-spaces-under-grandstands-and-bleachers-spaces-under-grandstands-or-bleachers ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.1.1.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1022 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.1.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.1.1.1 Spaces under grandstands and bleachers. Spaces under grandstands or bleachers shall be separated by fire barriers complying with Section 707 and horizontal assemblies complying with Section 711 with not less than 1-hour fire-resistance-rated construction." .

    ibc:sem-ibc2021-1030.10 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.10.1,
            ibc:ibc2021-1030.10.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.10 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10 Transitions. Transitions between stairways and stepped aisles shall comply with either Section 1030.10.1 or 1030.10.2." .

    ibc:sem-ibc2021-1030.10.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.10.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10.1 Transitions to stairways that maintain stepped aisle riser and tread dimensions. Stepped aisles, transitions and stairways that maintain the stepped aisle riser and tread dimensions shall comply with Section 1030.14 as one exit access component." .

    ibc:sem-ibc2021-1030.10.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.10.2.1,
            ibc:ibc2021-1030.10.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.10.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10.2 Transitions to stairways that do not maintain stepped aisle riser and tread dimensions. Transitions between stairways and stepped aisles having different riser and tread dimensions shall comply with Sections 1030.10.2.1 through 1030.10.3." .

    ibc:sem-ibc2021-1030.10.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10.2.1 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10.2.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.10.2.1-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1030.10.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10.2.1 Stairways and stepped aisles in a straight run. Where stairways and stepped aisles are in a straight run, transitions shall have one of the following:" .

    ibc:sem-ibc2021-1030.10.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10.2.2 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10.2.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.10.2.2-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.10.2.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.10.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10.2.2 Stairways that change direction from stepped aisles. Transitions where the stairway changes direction from the stepped aisle shall have a minimum depth of 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater, between the stepped aisle and stairway." .

    ibc:sem-ibc2021-1030.10.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.10.3 ;
        ibco:appliesTo ibc:concept-a-distinctive-marking-stripe ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.10.3-atomic-1,
            ibc:sem-ibc2021-1030.10.3-atomic-2,
            ibc:sem-ibc2021-1030.10.3-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.10.3-measurement-1,
            ibc:sem-ibc2021-1030.10.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.10.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.10.3 Transition marking. A distinctive marking stripe shall be provided at each nosing or leading edge adjacent to the transition. Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide. The edge marking stripe shall be distinctively different from the stepped aisle contrasting marking stripe." .

    ibc:sem-ibc2021-1030.11 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.11 ;
        ibco:appliesTo ibc:concept-stepped-aisles-that-change-direction-at-vomitories ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.11-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.11.1,
            ibc:ibc2021-1030.11.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.11 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.11 Stepped aisles at vomitories. Stepped aisles that change direction at vomitories shall comply with Section 1030.11.1 Transitions between a stepped aisle above a vomitory and a stepped aisle to the side of a vomitory shall comply with Section 1030.11.2." .

    ibc:sem-ibc2021-1030.11.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.11.1 ;
        ibco:appliesTo ibc:concept-stepped-aisles-that-change-direction-at-vomitories-stepped-aisle-treads-where-the-stepped-aisle-changes-direction-at-a-vomitory ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.11.1-atomic-1,
            ibc:sem-ibc2021-1030.11.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.11.1-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.11.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14.2.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.11.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.11.1 Stepped aisles that change direction at vomitories. Stepped aisle treads where the stepped aisle changes direction at a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater. The height of a stepped aisle tread above a transition at a vomitory shall comply with Section 1030.14.2.2." .

    ibc:sem-ibc2021-1030.11.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.11.2 ;
        ibco:appliesTo ibc:concept-stepped-aisle-transitions-at-the-top-of-vomitories-transitions-between-the-stepped-aisle-above-a-vomitory-and-stepped-aisles-to-the-side-of-a-vomitory ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.11.2-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.11.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.11.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.11.2 Stepped aisle transitions at the top of vomitories. Transitions between the stepped aisle above a vomitory and stepped aisles to the side of a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater." .

    ibc:sem-ibc2021-1030.12 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.12 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.12-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1108 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.12 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.12 Construction. Aisles, stepped aisles and ramped aisles shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:sem-ibc2021-1030.12.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.12.1 ;
        ibco:appliesTo ibc:concept-the-surface-of-aisles-stepped-aisles-and-ramped-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.12.1-atomic-1,
            ibc:sem-ibc2021-1030.12.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.7.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.12.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.12.1 Walking surface. The surface of aisles, stepped aisles and ramped aisles shall be of slip-resistant materials that are securely attached. The surface for stepped aisles shall comply with Section 1011.7.1." .

    ibc:sem-ibc2021-1030.12.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.12.2 ;
        ibco:appliesTo ibc:concept-outdoor-aisles-stepped-aisles-and-ramped-aisles-and-outdoor-approaches-to-aisles-stepped-aisles-and-ramped-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.12.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.12.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.12.2 Outdoor conditions. Outdoor aisles, stepped aisles and ramped aisles and outdoor approaches to aisles, stepped aisles and ramped aisles shall be designed so that water will not accumulate on the walking surface." .

    ibc:sem-ibc2021-1030.13 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13 ;
        ibco:appliesTo ibc:concept-aisle-accessways-for-seating-at-tables ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13-atomic-1,
            ibc:sem-ibc2021-1030.13-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.13.1,
            ibc:ibc2021-1030.13.2 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.13 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13 Aisle accessways. Aisle accessways for seating at tables shall comply with Section 1030.13.1. Aisle accessways for seating in rows shall comply with Section 1030.13.2." .

    ibc:sem-ibc2021-1030.13.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.1 ;
        ibco:appliesTo ibc:concept-where-seating-is-located-at-a-table-or-counter-and-is-adjacent-to-an-aisle-or-aisle-accessway-the-measurement-of-required-clear-width-of-the-aisle-or-aisle-accessway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.1-atomic-1,
            ibc:sem-ibc2021-1030.13.1-atomic-2,
            ibc:sem-ibc2021-1030.13.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.13.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1113 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13.1 Seating at tables. Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway shall be made to a line 19 inches (483 mm) away from and parallel to the edge of the table or counter. The 19-inch (483 mm) distance shall be measured perpendicular to the side of the table or counter. In the case of other side boundaries for aisles or aisle accessways, the clear width shall be measured to walls, edges of seating and tread edges." .

    ibc:sem-ibc2021-1030.13.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.1.1 ;
        ibco:appliesTo ibc:concept-aisle-accessway-capacity-and-width-for-seating-at-tables-aisle-accessways-serving-arrangements-of-seating-at-tables-or-counters ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.1.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1115 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.1.1-measurement-1,
            ibc:sem-ibc2021-1030.13.1.1-measurement-2,
            ibc:sem-ibc2021-1030.13.1.1-measurement-3,
            ibc:sem-ibc2021-1030.13.1.1-measurement-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.1.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13.1.1 Aisle accessway capacity and width for seating at tables. Aisle accessways serving arrangements of seating at tables or counters shall comply with the capacity requirements of Section 1005.1 but shall not have less than 12 inches (305 mm) of width plus 1/2 inch (12.7 mm) of width for each additional 1 foot (305 mm), or fraction thereof, beyond 12 feet (3658 mm) of aisle accessway length measured from the center of the seat farthest from an aisle." .

    ibc:sem-ibc2021-1030.13.1.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.1.2 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.1.2-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.13.1.2-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.1.2-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.1.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.13.1.2 Seating at table aisle accessway length. The length of travel along the aisle accessway shall not exceed 30 feet (9144 mm) from any seat to the point where a person has a choice of two or more paths of egress travel to separate exits." .

    ibc:sem-ibc2021-1030.13.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.2 ;
        ibco:appliesTo ibc:concept-clear-width-of-aisle-accessways-serving-seating-in-rows-where-seating-rows-have-14-or-fewer-seats-the-minimum-clear-aisle-accessway-width ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.2-atomic-1,
            ibc:sem-ibc2021-1030.13.2-atomic-2,
            ibc:sem-ibc2021-1030.13.2-atomic-3,
            ibc:sem-ibc2021-1030.13.2-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.13.2-condition-1,
            ibc:sem-ibc2021-1030.13.2-condition-2,
            ibc:sem-ibc2021-1030.13.2-condition-3 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1118 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13.2 Clear width of aisle accessways serving seating in rows. Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind. Where chairs have automatic or self-rising seats, the measurement shall be made with seats in the raised position. Where any chair in the row does not have an automatic or self-rising seat, the measurements shall be made with the seat in the down position. For seats with folding tablet arms, row spacing shall be determined with the tablet arm in the used position." .

    ibc:sem-ibc2021-1030.13.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.2.1 ;
        ibco:appliesTo ibc:concept-for-rows-of-seating-served-by-aisles-or-doorways-at-both-ends-there ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.2.1-atomic-1,
            ibc:sem-ibc2021-1030.13.2.1-atomic-2,
            ibc:sem-ibc2021-1030.13.2.1-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.13.2.1-condition-1,
            ibc:sem-ibc2021-1030.13.2.1-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1120 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.2.1-measurement-1,
            ibc:sem-ibc2021-1030.13.2.1-measurement-2,
            ibc:sem-ibc2021-1030.13.2.1-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13.2.1 Dual access. For rows of seating served by aisles or doorways at both ends, there shall be not more than 100 seats per row. The minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.3 inch (7.6 mm) for every additional seat beyond 14 seats where seats have backrests or beyond 21 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:sem-ibc2021-1030.13.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.13.2.2 ;
        ibco:appliesTo ibc:concept-for-rows-of-seating-served-by-an-aisle-or-doorway-at-only-one-end-of-the-row-the-minimum-clear-width-of-12-inches-305-mm-between-rows ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.13.2.2-atomic-1,
            ibc:sem-ibc2021-1030.13.2.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.13.2.2-condition-1,
            ibc:sem-ibc2021-1030.13.2.2-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1122 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.13.2.2-measurement-1,
            ibc:sem-ibc2021-1030.13.2.2-measurement-2,
            ibc:sem-ibc2021-1030.13.2.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.13.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.13.2.2 Single access. For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.6 inch (15.2 mm) for every additional seat beyond seven seats where seats have backrests or beyond 10 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:sem-ibc2021-1030.14 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14 ;
        ibco:appliesTo ibc:concept-ramped-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14-atomic-1,
            ibc:sem-ibc2021-1030.14-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14.1,
            ibc:ibc2021-1030.14.1.3,
            ibc:ibc2021-1030.14.2,
            ibc:ibc2021-1030.14.2.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14 Assembly aisle walking surfaces. Ramped aisles shall comply with Sections 1030.14.1 through 1030.14.1.3. Stepped aisles shall comply with Sections 1030.14.2 through 1030.14.2.4." .

    ibc:sem-ibc2021-1030.14.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.1 ;
        ibco:appliesTo ibc:concept-accessibleroute ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.1-atomic-1,
            ibc:sem-ibc2021-1030.14.1-atomic-2,
            ibc:sem-ibc2021-1030.14.1-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.14.1-measurement-1,
            ibc:sem-ibc2021-1030.14.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009,
            ibc:ibc2021-1030.13.2.1,
            ibc:ibc2021-1109.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.14.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.1 Ramped aisles. Aisles that are sloped more than 1 unit vertical in 20 units horizontal (5-percent slope) shall be considered to be a ramped aisle. Ramped aisles that serve as part of an accessible route in accordance with Sections 1009 and 1109.2 shall have a maximum slope of 1 unit vertical in 12 units horizontal (8-percent slope). The slope of other ramped aisles shall not exceed 1 unit vertical in 8 units horizontal (12.5percent slope). TABLE 1030.13.2.1 SMOKE-PROTECTED OR OPEN-AIR ASSEMBLY AISLE ACCESSWAYS For SI: 1 inch = 25.4 mm." .

    ibc:sem-ibc2021-1030.14.1.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.1.1 ;
        ibco:appliesTo ibc:concept-the-slope-measured-perpendicular-to-the-direction-of-travel-of-a-ramped-aisle ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.1.1-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.1.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.14.1.1 Cross slope. The slope measured perpendicular to the direction of travel of a ramped aisle shall not be steeper than 1 unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1030.14.1.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.1.2 ;
        ibco:appliesTo ibc:concept-ramped-aisles ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.1.2-atomic-1,
            ibc:sem-ibc2021-1030.14.1.2-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012.6,
            ibc:ibc2021-1012.6.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.1.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.1.2 Landings. Ramped aisles shall have landings in accordance with Sections 1012.6 through 1012.6.5. Landings for ramped aisles shall be permitted to overlap required aisles or cross aisles." .

    ibc:sem-ibc2021-1030.14.1.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.1.3 ;
        ibco:appliesTo ibc:concept-ramped-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.1.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1128 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1012.10,
            ibc:ibc2021-1012.10.1 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.1.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.1.3 Edge protection. Ramped aisles shall have edge protection in accordance with Sections 1012.10 and 1012.10.1." .

    ibc:sem-ibc2021-1030.14.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.2 ;
        ibco:appliesTo ibc:concept-aisles-with-a-slope-exceeding-one-unit-vertical-in-eight-units-horizontal-12-5-percent-slope ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14.2.1,
            ibc:ibc2021-1030.14.2.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.2 Stepped aisles. Aisles with a slope exceeding one unit vertical in eight units horizontal (12.5-percent slope) shall consist of a series of risers and treads that extends across the full width of aisles and complies with Sections 1030.14.2.1 through 1030.14.2.4." .

    ibc:sem-ibc2021-1030.14.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.2.1 ;
        ibco:appliesTo ibc:concept-tread-depths ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.2.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1131,
            ibc:ibc2021-ch10-exception-1132 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.14.2.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.2.1 Treads. Tread depths shall be not less than 11 inches (279 mm) and shall have dimensional uniformity." .

    ibc:sem-ibc2021-1030.14.2.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.2.2.1 ;
        ibco:appliesTo ibc:concept-the-tolerance-between-adjacent-risers-on-a-stepped-aisle-that-were-designed-to-be-equal-height ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.2.2.1-atomic-1,
            ibc:sem-ibc2021-1030.14.2.2.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.14.2.2.1-condition-1,
            ibc:sem-ibc2021-1030.14.2.2.1-condition-2,
            ibc:sem-ibc2021-1030.14.2.2.1-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.14.2.2.1-measurement-1,
            ibc:sem-ibc2021-1030.14.2.2.1-measurement-2,
            ibc:sem-ibc2021-1030.14.2.2.1-measurement-3,
            ibc:sem-ibc2021-1030.14.2.2.1-measurement-4,
            ibc:sem-ibc2021-1030.14.2.2.1-measurement-5 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1030.14.2.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.14.2.2.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.14.2.2.1 Construction tolerances. The tolerance between adjacent risers on a stepped aisle that were designed to be equal height shall not exceed 3/16 inch (4.8 mm). Where the stepped aisle is designed in accordance with Exception 1 of Section 1030.14.2.2, the stepped aisle shall be constructed so that each riser of unequal height, determined in the direction of descent, is not more than 3/8 inch (9.5 mm) in height different from adjacent risers where stepped aisle treads are less than 22 inches (560 mm) in depth and 3/4 inch (19.1 mm) in height different from adjacent risers where stepped aisle treads are 22 inches (560 mm) or greater in depth." .

    ibc:sem-ibc2021-1030.14.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.2.3 ;
        ibco:appliesTo ibc:concept-a-contrasting-marking-stripe ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.2.3-atomic-1,
            ibc:sem-ibc2021-1030.14.2.3-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1137 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.14.2.3-measurement-1,
            ibc:sem-ibc2021-1030.14.2.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.2.3 Tread contrasting marking stripe. A contrasting marking stripe shall be provided on each tread at the nosing or leading edge such that the location of each tread is readily apparent when viewed in descent. Such stripe shall be not less than 1 inch (25 mm) and not more than 2 inches (51 mm) wide." .

    ibc:sem-ibc2021-1030.14.2.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.14.2.4 ;
        ibco:appliesTo ibc:concept-nosing-and-riser-profile ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.14.2.4-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.5.5,
            ibc:ibc2021-1011.5.5.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.14.2.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.14.2.4 Nosing and profile. Nosing and riser profile shall comply with Sections 1011.5.5 through 1011.5.5.3." .

    ibc:sem-ibc2021-1030.15 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.15 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.15-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1140 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.15 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.15 Seat stability. In a building, room or space used for assembly purposes, the seats shall be securely fastened to the floor." .

    ibc:sem-ibc2021-1030.16 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.16 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.16-atomic-1,
            ibc:sem-ibc2021-1030.16-atomic-2,
            ibc:sem-ibc2021-1030.16-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.16-condition-1,
            ibc:sem-ibc2021-1030.16-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1148 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.16-measurement-1,
            ibc:sem-ibc2021-1030.16-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1014 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.16 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.16 Handrails. Ramped aisles having a slope exceeding one unit vertical in 15 units horizontal (6.7-percent slope) and stepped aisles shall be provided with handrails in compliance with Section 1014 located either at one or both sides of the aisle or within the aisle width. Where stepped aisles have seating on one side and the aisle width is 74 inches (1880 mm) or greater, two handrails are required. Where two handrails are required, one of the handrails shall be within 30 inches (762 mm) horizontally of the stepped aisle." .

    ibc:sem-ibc2021-1030.16.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.16.1 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.16.1-atomic-1,
            ibc:sem-ibc2021-1030.16.1-atomic-2,
            ibc:sem-ibc2021-1030.16.1-atomic-3,
            ibc:sem-ibc2021-1030.16.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.16.1-condition-1,
            ibc:sem-ibc2021-1030.16.1-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.16.1-measurement-1,
            ibc:sem-ibc2021-1030.16.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.16.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.16.1 Discontinuous mid-aisle handrails. Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous. Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous. Gaps or breaks shall be provided at intervals not exceeding five rows to facilitate access to seating and to permit crossing from one side of the aisle to the other. These gaps or breaks shall have a clear width of not less than 22 inches (559 mm) and not greater than 36 inches (914 mm), measured horizontally, and the midaisle handrail shall have rounded terminations or bends." .

    ibc:sem-ibc2021-1030.16.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.16.2 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.16.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.16.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.16.2 Handrail termination. Handrails located on the side of stepped aisles shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent stepped aisle flight." .

    ibc:sem-ibc2021-1030.16.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.16.3 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.16.3-atomic-1,
            ibc:sem-ibc2021-1030.16.3-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1155 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.16.3-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.16.3 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.16.3 Mid-aisle termination. Mid-aisle handrails shall not extend beyond the lowest riser and shall terminate within 18 inches (381 mm), measured horizontally, from the lowest riser. Handrail extensions are not required." .

    ibc:sem-ibc2021-1030.16.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.16.4 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.16.4-atomic-1,
            ibc:sem-ibc2021-1030.16.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.16.4-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.16.4-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1607.9.1.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.16.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.16.4 Rails. Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail. The rail shall be adequate in strength and attachment in accordance with Section 1607.9.1.2." .

    ibc:sem-ibc2021-1030.17 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.17 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-guard ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.17-atomic-1,
            ibc:sem-ibc2021-1030.17-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.17-condition-1,
            ibc:sem-ibc2021-1030.17-condition-2,
            ibc:sem-ibc2021-1030.17-condition-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015,
            ibc:ibc2021-1030.17.1,
            ibc:ibc2021-1030.17.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.17 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.17 Assembly guards. Guards adjacent to seating in a building, room or space used for assembly purposes shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015 except where provided in accordance with Sections 1030.17.1 through 1030.17.4. At bleachers, grandstands and folding and telescopic seating, guards must be provided where required by ICC 300 and Section 1030.17.1." .

    ibc:sem-ibc2021-1030.17.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.17.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-guard ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.17.1-atomic-1,
            ibc:sem-ibc2021-1030.17.1-atomic-2,
            ibc:sem-ibc2021-1030.17.1-atomic-3,
            ibc:sem-ibc2021-1030.17.1-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.17.1-condition-1,
            ibc:sem-ibc2021-1030.17.1-condition-2,
            ibc:sem-ibc2021-1030.17.1-condition-3,
            ibc:sem-ibc2021-1030.17.1-condition-4 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1159 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.17.1-measurement-1,
            ibc:sem-ibc2021-1030.17.1-measurement-2,
            ibc:sem-ibc2021-1030.17.1-measurement-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.17.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.17.1 Perimeter guards. Perimeter guards shall be provided where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below. Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard. Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface. Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015.3." .

    ibc:sem-ibc2021-1030.17.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.17.2 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.17.2-atomic-1,
            ibc:sem-ibc2021-1030.17.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.17.2-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1163 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.17.2-measurement-1,
            ibc:sem-ibc2021-1030.17.2-measurement-2,
            ibc:sem-ibc2021-1030.17.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.17.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.17.2 Cross aisles. Cross aisles located more than 30 inches (762 mm) above the floor or grade below shall have guards in accordance with Section 1015. Where an elevation change of 30 inches (762 mm) or less occurs between a cross aisle and the adjacent floor or grade below, guards not less than 26 inches (660 mm) above the aisle floor shall be provided." .

    ibc:sem-ibc2021-1030.17.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.17.3 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.17.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.17.3-condition-1,
            ibc:sem-ibc2021-1030.17.3-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.17.3-measurement-1,
            ibc:sem-ibc2021-1030.17.3-measurement-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015,
            ibc:ibc2021-1030.17.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.17.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.17.3 Sightline-constrained guard heights. Unless subject to the requirements of Section 1030.17.4, a fascia or railing system in accordance with the guard requirements of Section 1015 and having a minimum height of 26 inches (660 mm) shall be provided where the floor or footboard elevation is more than 30 inches (762 mm) above the floor or grade below and the fascia or railing would otherwise interfere with the sightlines of immediately adjacent seating." .

    ibc:sem-ibc2021-1030.17.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.17.4 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.17.4-atomic-1,
            ibc:sem-ibc2021-1030.17.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.17.4-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.17.4-measurement-1,
            ibc:sem-ibc2021-1030.17.4-measurement-2,
            ibc:sem-ibc2021-1030.17.4-measurement-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1015 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.17.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.17.4 Guards at the end of aisles. A fascia or railing system complying with the guard requirements of Section 1015 shall be provided for the full width of the aisle where the foot of the aisle is more than 30 inches (762 mm) above the floor or grade below. The fascia or railing shall be not less than 36 inches (914 mm) high and shall provide not less than 42 inches (1067 mm) measured diagonally between the top of the rail and the nosing of the nearest tread." .

    ibc:sem-ibc2021-1030.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.57 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.2-atomic-1,
            ibc:sem-ibc2021-1030.2-atomic-2,
            ibc:sem-ibc2021-1030.2-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.2-condition-1,
            ibc:sem-ibc2021-1030.2-condition-2,
            ibc:sem-ibc2021-1030.2-condition-3,
            ibc:sem-ibc2021-1030.2-condition-4 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.2-measurement-1,
            ibc:sem-ibc2021-1030.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.2 Assembly main exit. A building, room or space used for assembly purposes that has an occupant load of greater than 300 and is provided with a main exit, that main exit shall be of sufficient capacity to accommodate not less than one-half of the occupant load, but such capacity shall be not less than the total required capacity of all means of egress leading to the exit. Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way. In a building, room or space used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:sem-ibc2021-1030.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.3 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.3-atomic-1,
            ibc:sem-ibc2021-1030.3-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.3-condition-1,
            ibc:sem-ibc2021-1030.3-condition-2,
            ibc:sem-ibc2021-1030.3-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1007.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.3 Assembly other exits. In addition to having access to a main exit, each level in a building used for assembly purposes having an occupant load greater than 300 and provided with a main exit, shall be provided with additional means of egress that shall provide an egress capacity for not less than one-half of the total occupant load served by that level and shall comply with Section 1007.1. In a building used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:sem-ibc2021-1030.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.4 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.4-atomic-1,
            ibc:sem-ibc2021-1030.4-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.4-condition-1,
            ibc:sem-ibc2021-1030.4-condition-2,
            ibc:sem-ibc2021-1030.4-condition-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.4 Foyers and lobbies. In Group A-1 occupancies, where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress. Such foyer, if not directly connected to a public street by all the main entrances or exits, shall have a straight and unobstructed corridor or path of travel to every such main entrance or exit." .

    ibc:sem-ibc2021-1030.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.5 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.5-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.5 Interior balcony and gallery means of egress. For balconies, galleries or press boxes having a seating capacity of 50 or more located in a building, room or space used for assembly purposes, not less than two means of egress shall be provided, with one from each side of every balcony, gallery or press box." .

    ibc:sem-ibc2021-1030.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6 ;
        ibco:appliesTo ibc:concept-the-required-capacity-of-aisles ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.6-condition-1,
            ibc:sem-ibc2021-1030.6-condition-2,
            ibc:sem-ibc2021-1030.6-condition-3 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.6.1,
            ibc:ibc2021-1030.6.2,
            ibc:ibc2021-1030.6.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6 Capacity of aisle for assembly. The required capacity of aisles shall be not less than that determined in accordance with Section 1030.6.1 where smoke-protected assembly seating is not provided, Section 1030.6.2 where smoke-protected assembly seating is provided and Section 1030.6.3 where open-air assembly seating is provided." .

    ibc:sem-ibc2021-1030.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.1 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.6.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.1 Without smoke protection. The required capacity in inches (mm) of the aisles for assembly seating without smoke protection shall be not less than the occupant load served by the egress element in accordance with all of the following, as applicable:" .

    ibc:sem-ibc2021-1030.6.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.2-atomic-1,
            ibc:sem-ibc2021-1030.6.2-atomic-2,
            ibc:sem-ibc2021-1030.6.2-atomic-3,
            ibc:sem-ibc2021-1030.6.2-atomic-4 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.6.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.6.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.2 Smoke-protected assembly seating. The required capacity in inches (mm) of the aisle for smokeprotected assembly seating shall be not less than the occupant load served by the egress element multiplied by the appropriate factor in Table 1030.6.2. The total number of seats specified shall be those within the space exposed to the same smoke-protected environment. Interpolation is permitted between the specific values shown. A life TABLE 1030.6.2 safety evaluation, complying with NFPA 101, shall be done for a facility utilizing the reduced width requirements of Table 1030.6.2 for smoke-protected assembly seating. " .

    ibc:sem-ibc2021-1030.6.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.2.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.2.1-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.6.2.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.6.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.2.1 Smoke control. Aisles and aisle accessways serving a smoke-protected assembly seating area shall be provided with a smoke control system complying with Section 909 or natural ventilation designed to maintain the smoke level not less than 6 feet (1829 mm) above the floor of the means of egress." .

    ibc:sem-ibc2021-1030.6.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.2.2 ;
        ibco:appliesTo ibc:concept-a-smoke-protected-assembly-seating-area-with-a-roof ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.2.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1039 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.6.2.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.6.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.2.2 Roof height. A smoke-protected assembly seating area with a roof shall have the lowest portion of the roof deck not less than 15 feet (4572 mm) above the highest aisle or aisle accessway." .

    ibc:sem-ibc2021-1030.6.2.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.2.3 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.2.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1041 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.6.2.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.2.3 Automatic sprinklers. Enclosed areas with walls and ceilings in buildings or structures containing smoke-protected assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-1030.6.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.3 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.6.3-condition-1,
            ibc:sem-ibc2021-1030.6.3-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1045 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.6.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.3 Open-air assembly seating. In open-air assembly seating, the required capacity in inches (mm) of aisles shall be not less than the total occupant load served by the egress element multiplied by 0.08 (2.0 mm) where egress is by stepped aisle and multiplied by 0.06 (1.52 mm) where egress is by level aisles and ramped aisles." .

    ibc:sem-ibc2021-1030.6.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.6.3.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.6.3.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1047 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.6.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.6.3.1 Automatic sprinklers. Enclosed areas with walls and ceilings in buildings or structures containing open-air assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-1030.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.7 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.7-atomic-1,
            ibc:sem-ibc2021-1030.7-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.7-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1052 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1017 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1030.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.7 Travel distance. The exit access travel distance shall comply with Section 1017. Where aisles are provided for seating, the distance shall be measured along the aisles and aisle accessways without travel over or on the seats." .

    ibc:sem-ibc2021-1030.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.8 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.8-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.8-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1063 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.8-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.8 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.8 Common path of egress travel. The common path of egress travel shall not exceed 30 feet (9144 mm) from any seat to a point where an occupant has a choice of two paths of egress travel to two exits." .

    ibc:sem-ibc2021-1030.8.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.8.1 ;
        ibco:appliesTo ibc:concept-where-one-of-the-two-paths-of-travel-is-across-the-aisle-through-a-row-of-seats-to-another-aisle-there ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.8.1-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.8.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1067 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1030.8.1-measurement-1,
            ibc:sem-ibc2021-1030.8.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.8.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.8.1 Path through adjacent row. Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there shall be not more than 24 seats between the two aisles, and the minimum clear width between rows for the row between the two aisles shall be 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row between aisles." .

    ibc:sem-ibc2021-1030.9 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1030.9 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9 Assembly aisles are required. Every occupied portion of any building, room or space used for assembly purposes that contains seats, tables, displays, similar fixtures or equipment shall be provided with aisles leading to exits or exit access doorways in accordance with this section." .

    ibc:sem-ibc2021-1030.9.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.1 ;
        ibco:appliesTo ibc:concept-the-minimum-clear-width-for-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1071,
            ibc:ibc2021-ch10-exception-1073,
            ibc:ibc2021-ch10-exception-1076,
            ibc:ibc2021-ch10-exception-1080 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.9.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.1 Minimum aisle width. The minimum clear width for aisles shall comply with one of the following:" .

    ibc:sem-ibc2021-1030.9.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.2-atomic-1,
            ibc:sem-ibc2021-1030.9.2-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy" ;
        ibco:sourceNode ibc:ibc2021-1030.9.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.2 Aisle catchment area. The aisle shall provide sufficient capacity for the number of persons accommodated by the catchment area served by the aisle. The catchment area served by an aisle is that portion of the total space served by that section of the aisle. In establishing catchment areas, the assumption shall be made that there is a balanced use of all means of egress, with the number of persons in proportion to egress capacity." .

    ibc:sem-ibc2021-1030.9.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.3 ;
        ibco:appliesTo ibc:concept-where-aisles-converge-to-form-a-single-path-of-egress-travel-the-required-capacity-of-that-path ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.3-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.9.3-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.9.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.3 Converging aisles. Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles." .

    ibc:sem-ibc2021-1030.9.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.4 ;
        ibco:appliesTo ibc:concept-those-portions-of-aisles-where-egress-is-possible-in-either-of-two-directions ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1030.9.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.9.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.4 Uniform width and capacity. Those portions of aisles, where egress is possible in either of two directions, shall be uniform in minimum width or required capacity." .

    ibc:sem-ibc2021-1030.9.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.5 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.5-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1085 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.9.7 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1030.9.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.5 Dead-end aisles. Each end of an aisle shall be continuous to a cross aisle, foyer, doorway, vomitory, concourse or stairway in accordance with Section 1030.9.7 having access to an exit." .

    ibc:sem-ibc2021-1030.9.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.6 ;
        ibco:appliesTo ibc:concept-the-clear-width-for-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.6-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1091 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1030.9.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.6 Aisle measurement. The clear width for aisles shall be measured to walls, edges of seating and tread edges except for permitted projections." .

    ibc:sem-ibc2021-1030.9.6.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.6.1 ;
        ibco:appliesTo ibc:concept-there ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.6.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1093 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1030.9.6.1 ;
        ibco:statementType "prohibition" ;
        ibco:text "1030.9.6.1 Assembly aisle obstructions. There shall not be obstructions in the minimum width or required capacity of aisles." .

    ibc:sem-ibc2021-1030.9.7 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.7 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.7-atomic-1,
            ibc:sem-ibc2021-1030.9.7-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.10,
            ibc:ibc2021-1030.14 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.9.7 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.7 Stairways connecting to stepped aisles. A stairway that connects a stepped aisle to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14. Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:sem-ibc2021-1030.9.8 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1030.9.8 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1030.9.8-atomic-1,
            ibc:sem-ibc2021-1030.9.8-atomic-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.10,
            ibc:ibc2021-1030.14 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1030.9.8 ;
        ibco:statementType "obligation" ;
        ibco:text "1030.9.8 Stairways connecting to vomitories. A stairway that connects a vomitory to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14. Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:sem-ibc2021-1031.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.1 ;
        ibco:appliesTo ibc:concept-emergency-escape-and-rescue-openings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1031.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.1 General. Emergency escape and rescue openings shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1031.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1171 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1031.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.2 Where required. In addition to the means of egress required by this chapter, emergency escape and rescue openings shall be provided in the following occupancies:" .

    ibc:sem-ibc2021-1031.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.2.1 ;
        ibco:appliesTo ibc:concept-operational-constraints-and-opening-control-devices-emergency-escape-and-rescue-openings ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.2.1-atomic-1,
            ibc:sem-ibc2021-1031.2.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1031.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.2.1 Operational constraints and opening control devices. Emergency escape and rescue openings shall be operational from inside the room without the use of keys or tools. Window-opening control devices complying with ASTM F2090 shall be permitted for use on windows serving as a required emergency escape and rescue opening." .

    ibc:sem-ibc2021-1031.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.3 ;
        ibco:appliesTo ibc:concept-emergency-escape-and-rescue-openings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1031.3.1,
            ibc:ibc2021-1031.3.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1031.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.3 Emergency escape and rescue openings. Emergency escape and rescue openings shall comply with Sections 1031.3.1 through 1031.3.3." .

    ibc:sem-ibc2021-1031.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.3.1 ;
        ibco:appliesTo ibc:concept-emergency-escape-and-rescue-openings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.3.1-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1182 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.3.1-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.3.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.3.1 Minimum size. Emergency escape and rescue openings shall have a minimum net clear opening of 5.7 square feet (0.53 m2)." .

    ibc:sem-ibc2021-1031.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.3.2 ;
        ibco:appliesTo ibc:concept-the-minimum-net-clear-opening-height-dimension ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.3.2-atomic-1,
            ibc:sem-ibc2021-1031.3.2-atomic-2,
            ibc:sem-ibc2021-1031.3.2-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.3.2-measurement-1,
            ibc:sem-ibc2021-1031.3.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.3.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.3.2 Minimum dimensions. The minimum net clear opening height dimension shall be 24 inches (610 mm). The minimum net clear opening width dimension shall be 20 inches (508 mm). The net clear opening dimensions shall be the result of normal operation of the opening." .

    ibc:sem-ibc2021-1031.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.3.3 ;
        ibco:appliesTo ibc:concept-emergency-escape-and-rescue-openings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.3.3-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.3.3-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.3.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.3.3 Maximum height from floor. Emergency escape and rescue openings shall have the bottom of the clear opening not greater than 44 inches (1118 mm) measured from the floor." .

    ibc:sem-ibc2021-1031.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.4 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.4-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-1031.4-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1031.4 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.4 Emergency escape and rescue doors. Where a door is provided as the required emergency escape and rescue opening, it shall be a swinging door or a sliding door." .

    ibc:sem-ibc2021-1031.5 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5 ;
        ibco:appliesTo ibc:concept-an-emergency-escape-and-rescue-opening-with-the-bottom-of-the-clear-opening-below-the-adjacent-grade ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1031.5.1,
            ibc:ibc2021-1031.5.3 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1031.5 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5 Area wells. An emergency escape and rescue opening with the bottom of the clear opening below the adjacent grade shall be provided with an area well in accordance with Sections 1031.5.1 through 1031.5.3." .

    ibc:sem-ibc2021-1031.5.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5.1 ;
        ibco:appliesTo ibc:concept-the-minimum-horizontal-area-of-the-area-well ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5.1-atomic-1,
            ibc:sem-ibc2021-1031.5.1-atomic-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1188 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.5.1-measurement-1,
            ibc:sem-ibc2021-1031.5.1-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.5.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5.1 Minimum size. The minimum horizontal area of the area well shall be 9 square feet (0.84 m2), with a horizontal projection and width of not less than 36 inches (914 mm). The area well shall allow the emergency escape and rescue opening to be fully opened." .

    ibc:sem-ibc2021-1031.5.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5.2 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5.2-atomic-1,
            ibc:sem-ibc2021-1031.5.2-atomic-2,
            ibc:sem-ibc2021-1031.5.2-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.5.2-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.5.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5.2 Ladders or steps. Area wells with a vertical depth of more than 44 inches (1118 mm) shall be equipped with an approved permanently affixed ladder or steps. The ladder or steps shall not be obstructed by the emergency escape and rescue opening when the window or door is in the open position. Ladders or steps required by this section shall not be required to comply with Section 1011." .

    ibc:sem-ibc2021-1031.5.2.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5.2.1 ;
        ibco:appliesTo ibc:concept-ladders-or-rungs ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5.2.1-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.5.2.1-measurement-1,
            ibc:sem-ibc2021-1031.5.2.1-measurement-2,
            ibc:sem-ibc2021-1031.5.2.1-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.5.2.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5.2.1 Ladders. Ladders or rungs shall have an inside width of at least 12 inches (305 mm), shall project at least 3 inches (76 mm) from the wall and shall be spaced not more than 18 inches (457 mm) on center (o.c.) vertically for the full height of the area well." .

    ibc:sem-ibc2021-1031.5.2.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5.2.2 ;
        ibco:appliesTo ibc:concept-steps ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5.2.2-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1031.5.2.2-measurement-1,
            ibc:sem-ibc2021-1031.5.2.2-measurement-2,
            ibc:sem-ibc2021-1031.5.2.2-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.5.2.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5.2.2 Steps. Steps shall have an inside width of not less than 12 inches (305 mm), shall have treads greater than 5 inches (127 mm) in depth and a riser height not greater than 18 inches (457 mm) for the full height of the area well." .

    ibc:sem-ibc2021-1031.5.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.5.3 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.5.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-1193 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1805 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1031.5.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.5.3 Drainage. Area wells shall be designed for proper drainage by connecting to the building’s foundation drainage system required by Section 1805." .

    ibc:sem-ibc2021-1031.6 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1031.6 ;
        ibco:appliesTo ibc:concept-where-bars-grilles-covers-screens-or-similar-devices-are-placed-over-emergency-escape-and-rescue-openings-or-area-wells-that-serve-such-openings-the-minimum-net-clear-opening-size ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1031.6-atomic-1,
            ibc:sem-ibc2021-1031.6-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1031.6-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1031.3,
            ibc:ibc2021-1031.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-1031.6 ;
        ibco:statementType "obligation" ;
        ibco:text "1031.6 Bars, grilles, covers and screens. Where bars, grilles, covers, screens or similar devices are placed over emergency escape and rescue openings or area wells that serve such openings, the minimum net clear opening size shall comply with Sections 1031.3 and 1031.5. Such devices shall be releasable or removable from the inside without the use of a key, tool or force greater than that which is required for normal operation of the emergency escape and rescue opening." .

    ibc:sem-ibc2021-ch10-exception-0012 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0012 ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0012-atomic-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0012 ;
        ibco:statementType "exception" ;
        ibco:text "Exceptions:" .

    ibc:sem-ibc2021-ch10-exception-0023 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0023 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0023-atomic-1,
            ibc:sem-ibc2021-ch10-exception-0023-atomic-2,
            ibc:sem-ibc2021-ch10-exception-0023-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-exception-0023-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-exception-0023-measurement-1,
            ibc:sem-ibc2021-ch10-exception-0023-measurement-2,
            ibc:sem-ibc2021-ch10-exception-0023-measurement-3 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0023 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Door closers and stops shall not reduce headroom to less than 78 inches (1981 mm). A barrier shall be provided where the vertical clearance above a circulation path is less than 80 inches (2032 mm) high above the finished floor. The leading edge of such a barrier shall be located 27 inches (686 mm) maximum above the finished floor." .

    ibc:sem-ibc2021-ch10-exception-0025 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0025 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0025-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0025 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: These requirements shall not apply to sloping portions of handrails between the top and bottom riser of stairs and above the ramp run." .

    ibc:sem-ibc2021-ch10-exception-0027 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0027 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0027-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-exception-0027-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0027 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Handrails are permitted to protrude 41/2 inches (114 mm) from the wall or guard." .

    ibc:sem-ibc2021-ch10-exception-0031 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0031 ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0031-atomic-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0031 ;
        ibco:statementType "exception" ;
        ibco:text "Exceptions:" .

    ibc:sem-ibc2021-ch10-exception-0037 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0037 ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0037-atomic-1 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1009.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0037 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Elevators used as an accessible means of egress in accordance with Section 1009.4." .

    ibc:sem-ibc2021-ch10-exception-0047 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0047 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-occupantload ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0047-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-exception-0047-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0047 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Where approved by the building official, the actual number of occupants for whom each occupied space, floor or building is designed, although less than those determined by calculation, shall be permitted to be used in the determination of the design occupant load." .

    ibc:sem-ibc2021-ch10-exception-0052 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0052 ;
