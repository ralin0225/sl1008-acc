        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1080-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Thirty inches (762 mm) where the aisle serves fewer than 15 seats and does not serve as part of an accessible route." .

    ibc:sem-ibc2021-ch10-exception-1080-condition-1 a ibco:Condition ;
        ibco:text "where the aisle serves fewer than 15 seats and does not serve as part of an accessible route." .

    ibc:sem-ibc2021-ch10-exception-1085-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1091-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The clear width of aisles adjacent to seating at tables shall be permitted to be measured in accordance with Section 1030.13.1." .

    ibc:sem-ibc2021-ch10-exception-1093-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "Handrails are permitted to project into the required width of stepped aisles and ramped aisles in accordance with Section 1014.8." .

    ibc:sem-ibc2021-ch10-exception-1108-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Wood handrails shall be permitted for all types of construction." .

    ibc:sem-ibc2021-ch10-exception-1113-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat." .

    ibc:sem-ibc2021-ch10-exception-1113-condition-1 a ibco:Condition ;
        ibco:text "Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat." .

    ibc:sem-ibc2021-ch10-exception-1115-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Portions of an aisle accessway having a length not exceeding 6 feet (1829 mm) and used by a total of not more than four persons." .

    ibc:sem-ibc2021-ch10-exception-1115-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-ch10-exception-1118-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "For seats with folding tablet arms, row spacing is permitted to be determined with the tablet arm in the stored position where the tablet arm when raised manually to vertical position in one motion automatically returns to the stored position by force of gravity." .

    ibc:sem-ibc2021-ch10-exception-1118-condition-1 a ibco:Condition ;
        ibco:text "where the tablet arm when raised manually to vertical position in one motion automatically returns to the stored position by force of gravity." .

    ibc:sem-ibc2021-ch10-exception-1120-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1." .

    ibc:sem-ibc2021-ch10-exception-1122-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1." .

    ibc:sem-ibc2021-ch10-exception-1128-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "In assembly spaces with fixed seating, edge protection is not required on the sides of ramped aisles where the ramped aisles provide access to the adjacent seating and aisle accessways." .

    ibc:sem-ibc2021-ch10-exception-1128-condition-1 a ibco:Condition ;
        ibco:text "where the ramped aisles provide access to the adjacent seating and aisle accessways." .

    ibc:sem-ibc2021-ch10-exception-1131-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "exception" ;
        ibco:text "The tolerance between adjacent treads shall not exceed 3/16 inch (4.8 mm). 1030.14.2.2 Risers." .

    ibc:sem-ibc2021-ch10-exception-1131-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Where the gradient of stepped aisles is to be the same as the gradient of adjoining seating areas, the riser height shall be not less than 4 inches (102 mm) nor more than 8 inches (203 mm) and shall be uniform within each flight." .

    ibc:sem-ibc2021-ch10-exception-1131-condition-1 a ibco:Condition ;
        ibco:text "Where the gradient of stepped aisles is to be the same as the gradient of adjoining seating areas, the riser height shall be not less than 4 inches (102 mm) nor more than 8 inches (203 mm) and shall be uniform within each flight." .

    ibc:sem-ibc2021-ch10-exception-1131-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-ch10-exception-1131-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-exception-1131-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-exception-1132-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1137-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "The contrasting marking stripe is permitted to be omitted where tread surfaces are such that the location of each tread is readily apparent when viewed in descent." .

    ibc:sem-ibc2021-ch10-exception-1137-condition-1 a ibco:Condition ;
        ibco:text "where tread surfaces are such that the location of each tread is readily apparent when viewed in descent." .

    ibc:sem-ibc2021-ch10-exception-1140-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1148-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1155-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Mid-aisle handrails shall be permitted to extend beyond the lowest riser where the handrail extensions do not obstruct the width of the cross aisle." .

    ibc:sem-ibc2021-ch10-exception-1155-condition-1 a ibco:Condition ;
        ibco:text "where the handrail extensions do not obstruct the width of the cross aisle." .

    ibc:sem-ibc2021-ch10-exception-1159-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1163-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "Where the backs of seats on the front of the cross aisle project 24 inches (610 mm) or more above the adjacent floor of the aisle, a guard need not be provided." .

    ibc:sem-ibc2021-ch10-exception-1163-condition-1 a ibco:Condition ;
        ibco:text "Where the backs of seats on the front of the cross aisle project 24 inches (610 mm) or more above the adjacent floor of the aisle, a guard need not be provided." .

    ibc:sem-ibc2021-ch10-exception-1163-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 24.0 .

    ibc:sem-ibc2021-ch10-exception-1171-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1182-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The minimum net clear opening for gradefloor emergency escape and rescue openings shall be 5 square feet (0.46 m2)." .

    ibc:sem-ibc2021-ch10-exception-1182-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-ch10-exception-1188-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The ladder or steps required by Section 1031.5.2 shall be permitted to encroach not more than 6 inches (152 mm) into the required dimensions of the area well." .

    ibc:sem-ibc2021-ch10-exception-1188-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-ch10-exception-1193-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "A drainage system for area wells is not required where the foundation is on well-drained soil or sand-gravel mixture soils in accordance with the United Soil Classification System, Group I Soils, in accordance with Section 1803.5.1." .

    ibc:sem-ibc2021-ch10-exception-1193-condition-1 a ibco:Condition ;
        ibco:text "where the foundation is on well-drained soil or sand-gravel mixture soils in accordance with the United Soil Classification System, Group I Soils, in accordance with Section 1803." .

    ibc:sem-ibc2021-ch10-list_item-0033-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "A stair with a single riser or with two risers and a tread is permitted at locations not required to be accessible by Chapter 11 where the risers and treads comply with Section 1011.5, the minimum depth of the tread is 13 inches (330 mm) and not less than one handrail complying with Section 1014 is provided within 30 inches (762 mm) of the centerline of the normal path of egress travel on the stair." .

    ibc:sem-ibc2021-ch10-list_item-0033-condition-1 a ibco:Condition ;
        ibco:text "where the risers and treads comply with Section 1011." .

    ibc:sem-ibc2021-ch10-list_item-0033-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 13.0 .

    ibc:sem-ibc2021-ch10-list_item-0033-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-0034-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "A step is permitted in aisles serving seating that has a difference in elevation less than 12 inches (305 mm) at locations not required to be accessible by Chapter 11, provided that the risers and treads comply with Section 1030.14 and the aisle is provided with a handrail complying with Section 1030.16." .

    ibc:sem-ibc2021-ch10-list_item-0034-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Throughout a story in a Group I-2 occupancy, any change in elevation in portions of the means of egress that serve nonambulatory persons shall be by means of a ramp or sloped walkway." .

    ibc:sem-ibc2021-ch10-list_item-0034-condition-1 a ibco:Condition ;
        ibco:text "provided that the risers and treads comply with Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0034-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-0064-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:sem-ibc2021-ch10-list_item-0064-condition-1 a ibco:Condition ;
        ibco:text "other than Group H and I-2 occupancies, the capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0." .

    ibc:sem-ibc2021-ch10-list_item-0064-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.2 .

    ibc:sem-ibc2021-ch10-list_item-0065-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section" .

    ibc:sem-ibc2021-ch10-list_item-0065-condition-1 a ibco:Condition ;
        ibco:text "where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section" .

    ibc:sem-ibc2021-ch10-list_item-0067-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0067-condition-1 a ibco:Condition ;
        ibco:text "where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0070-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.15 inch (3.8 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:sem-ibc2021-ch10-list_item-0070-condition-1 a ibco:Condition ;
        ibco:text "other than Group H and I-2 occupancies, the capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0." .

    ibc:sem-ibc2021-ch10-list_item-0070-condition-2 a ibco:Condition ;
        ibco:text "other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0." .

    ibc:sem-ibc2021-ch10-list_item-0070-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.15 .

    ibc:sem-ibc2021-ch10-list_item-0071-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909." .

    ibc:sem-ibc2021-ch10-list_item-0071-condition-1 a ibco:Condition ;
        ibco:text "where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909." .

    ibc:sem-ibc2021-ch10-list_item-0071-condition-2 a ibco:Condition ;
        ibco:text "other than stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909." .

    ibc:sem-ibc2021-ch10-list_item-0072-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0072-condition-1 a ibco:Condition ;
        ibco:text "where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0072-condition-2 a ibco:Condition ;
        ibco:text "other than stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0079-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Surface-mounted latch release hardware shall be exempt from inclusion in the 7-inch maximum (178 mm) encroachment where both of the following conditions exist:" .

    ibc:sem-ibc2021-ch10-list_item-0079-condition-1 a ibco:Condition ;
        ibco:text "where both of the following conditions exist:" .

    ibc:sem-ibc2021-ch10-list_item-0080-condition-1 a ibco:Condition ;
        ibco:text "where the door is in the open position." .

    ibc:sem-ibc2021-ch10-list_item-0081-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0081-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0082-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The restrictions on door swing shall not apply to doors within individual dwelling units and sleeping units of Group R-2 occupancies and dwelling units of Group R-3 occupancies." .

    ibc:sem-ibc2021-ch10-list_item-0091-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The number of exits from foyers, lobbies, vestibules or similar spaces need not be based on cumulative occupant loads for areas discharging through such spaces, but the capacity of the exits from such spaces shall be based on applicable cumulative occupant loads." .

    ibc:sem-ibc2021-ch10-list_item-0093-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Unoccupied mechanical rooms and penthouses are not required to comply with the common path of egress travel distance measurement." .

    ibc:sem-ibc2021-ch10-list_item-0103-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0103-condition-1 a ibco:Condition ;
        ibco:text "where automatic sprinkler systems are permitted in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0107-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The common path of egress travel distance shall only apply in a Group R-3 occupancy located in a mixed occupancy building." .

    ibc:sem-ibc2021-ch10-list_item-0108-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The length of common path of egress travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0108-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-ch10-list_item-0109-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Section 903.3.1.3, the exit access travel distance for Group R-4 shall be not more than 75 feet (22 860 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0109-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 75.0 .

    ibc:sem-ibc2021-ch10-list_item-0124-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Rooms, areas and spaces complying with Section 1006.2.1 with exits that discharge directly to the exterior at the level of exit discharge, are permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0125-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Parking garages where vehicles are mechanically parked shall be permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0125-condition-1 a ibco:Condition ;
        ibco:text "where vehicles are mechanically parked shall be permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0126-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Group R-3 and R-4 occupancies shall be permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0127-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Individual single-story or multistory dwelling units shall be permitted to have a single exit or access to a single exit from the dwelling unit provided that both of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0127-condition-1 a ibco:Condition ;
        ibco:text "provided that both of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0132-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "NP = Not Permitted." .

    ibc:sem-ibc2021-ch10-list_item-0132-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0134-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Group B, F and S occupancies in buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 shall have a maximum exit access travel distance of 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0134-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-ch10-list_item-0136-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The length of exit access travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0136-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-ch10-list_item-0141-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where interior exit stairways or ramps are interconnected by a 1-hour fire-resistance-rated corridor conforming to the requirements of Section 1020, the required exit separation shall be measured along the shortest direct line of travel within the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0141-condition-1 a ibco:Condition ;
        ibco:text "Where interior exit stairways or ramps are interconnected by a 1-hour fire-resistance-rated corridor conforming to the requirements of Section 1020, the required exit separation shall be measured along the shortest direct line of travel within the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0142-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2, the separation distance shall be not less than one-third of the length of the maximum overall diagonal dimension of the area served." .

    ibc:sem-ibc2021-ch10-list_item-0142-condition-1 a ibco:Condition ;
        ibco:text "Where a building is equipped throughout with an automatic sprinkler system in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0144-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The separation distance to exit or exit access doorways shall be measured to any point along the width of the doorway." .

    ibc:sem-ibc2021-ch10-list_item-0145-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The separation distance to exit access stairways shall be measured to the closest riser." .

    ibc:sem-ibc2021-ch10-list_item-0146-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The separation distance to exit access ramps shall be measured to the start of the ramp run." .

    ibc:sem-ibc2021-ch10-list_item-0160-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Externally illuminated walking surfaces shall be permitted to be illuminated to not less than 0.2 footcandle (2.15 lux)." .

    ibc:sem-ibc2021-ch10-list_item-0161-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Steps, landings and the sides of ramps shall be permitted to be marked with self-luminous materials in accordance with Sections 1025.2.1, 1025.2.2 and 1025.2.4 by systems listed in accordance with UL 1994." .

    ibc:sem-ibc2021-ch10-list_item-0166-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A dispersal area shall be illuminated to a level not less than 1 footcandle (11 lux) at the walking surface." .

    ibc:sem-ibc2021-ch10-list_item-0183-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 300.0 .

    ibc:sem-ibc2021-ch10-list_item-0189-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "One accessible means of egress is required from an accessible mezzanine level in accordance with Section 1009.3, 1009.4 or 1009.5." .

    ibc:sem-ibc2021-ch10-list_item-0190-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In assembly areas with ramped aisles or stepped aisles, one accessible means of egress is permitted where the common path of egress travel is accessible and meets the requirements in Section 1030.8." .

    ibc:sem-ibc2021-ch10-list_item-0190-condition-1 a ibco:Condition ;
        ibco:text "where the common path of egress travel is accessible and meets the requirements in Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0195-condition-1 a ibco:Condition ;
        ibco:text "other than the level of exit discharge." .

    ibc:sem-ibc2021-ch10-list_item-0204-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, the elevator shall not be required on floors provided with a horizontal exit and located at or above the levels of exit discharge." .

    ibc:sem-ibc2021-ch10-list_item-0205-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, the elevator shall not be required on floors provided with a ramp conforming to the provisions of Section 1012." .

    ibc:sem-ibc2021-ch10-list_item-0211-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The clear width of 48 inches (1219 mm) between handrails is not required in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0211-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0212-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The clear width of 48 inches (1219 mm) between handrails is not required for stairways accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:sem-ibc2021-ch10-list_item-0212-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0215-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at exit access stairways where two-way communication is provided at the elevator landing in accordance with Section 1009.8." .

    ibc:sem-ibc2021-ch10-list_item-0215-condition-1 a ibco:Condition ;
        ibco:text "where two-way communication is provided at the elevator landing in accordance with Section 1009." .

    ibc:sem-ibc2021-ch10-list_item-0216-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at stairways in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0217-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at stairways serving open parking garages." .

    ibc:sem-ibc2021-ch10-list_item-0218-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required for smokeprotected or open-air assembly seating areas complying with Sections 1030.6.2 and 1030.6.3." .

    ibc:sem-ibc2021-ch10-list_item-0219-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at stairways in Group R-2 occupancies." .

    ibc:sem-ibc2021-ch10-list_item-0220-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required for stairways accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:sem-ibc2021-ch10-list_item-0225-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at the elevator in open parking garages." .

    ibc:sem-ibc2021-ch10-list_item-0226-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required in buildings and facilities equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0227-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at elevators not required to be located in a shaft in accordance with Section 712." .

    ibc:sem-ibc2021-ch10-list_item-0228-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required at elevators serving smoke-protected or open-air assembly seating areas complying with Sections 1030.6.2 and 1030.6.3." .

    ibc:sem-ibc2021-ch10-list_item-0229-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Areas of refuge are not required for elevators accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:sem-ibc2021-ch10-list_item-0239-condition-1 a ibco:Condition ;
        ibco:text "where exit access is essentially open to the outside." .

    ibc:sem-ibc2021-ch10-list_item-0250-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required at the landing serving each elevator or bank of elevators where the two-way communication system is provided within areas of refuge in accordance with Section 1009.6.5." .

    ibc:sem-ibc2021-ch10-list_item-0250-condition-1 a ibco:Condition ;
        ibco:text "where the two-way communication system is provided within areas of refuge in accordance with Section 1009." .

    ibc:sem-ibc2021-ch10-list_item-0251-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required on floors provided with ramps conforming to the provisions of Section 1012." .

    ibc:sem-ibc2021-ch10-list_item-0252-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required at the landings serving only service elevators that are not designated as part of the accessible means of egress or serve as part of the required accessible route into a facility." .

    ibc:sem-ibc2021-ch10-list_item-0253-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required at the landings serving only freight elevators." .

    ibc:sem-ibc2021-ch10-list_item-0254-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required at the landing serving a private residence elevator." .

    ibc:sem-ibc2021-ch10-list_item-0255-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Two-way communication systems are not required in Group I-2 or I-3 facilities." .

    ibc:sem-ibc2021-ch10-list_item-0259-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each door providing access to an area of refuge from an adjacent floor area shall be identified by a sign stating, \"AREA OF REFUGE.\"" .

    ibc:sem-ibc2021-ch10-list_item-0260-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each door providing access to an exterior area for assisted rescue shall be identified by a sign stating, \"EXTERIOR AREA FOR ASSISTED RESCUE.\" Signage shall comply with the ICC A117.1 requirements for visual characters and include the International Symbol of Accessibility." .

    ibc:sem-ibc2021-ch10-list_item-0260-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where exit sign illumination is required by Section 1013.3, the signs shall be illuminated." .

    ibc:sem-ibc2021-ch10-list_item-0260-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Additionally, visual characters, raised character and braille signage complying with ICC A117.1 shall be located at each door to an area of refuge and exterior area for assisted rescue in accordance with Section 1013.4." .

    ibc:sem-ibc2021-ch10-list_item-0260-condition-1 a ibco:Condition ;
        ibco:text "Where exit sign illumination is required by Section 1013." .

    ibc:sem-ibc2021-ch10-list_item-0266-condition-1 a ibco:Condition ;
        ibco:text "unless they are assisting others." .

    ibc:sem-ibc2021-ch10-list_item-0268-condition-1 a ibco:Condition ;
        ibco:text "where provided." .

    ibc:sem-ibc2021-ch10-list_item-0273-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In Group R-2 and R-3 dwelling and sleeping units that are not required to be an Accessible unit, Type A unit or Type B unit, the minimum width shall not apply to door openings that are not part of the required means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0274-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In Group I-3, door openings to resident sleeping units that are not required to be an Accessible unit shall have a minimum clear opening width of 28 inches (711 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0274-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 28.0 .

    ibc:sem-ibc2021-ch10-list_item-0275-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Door openings to storage closets less than 10 square feet (0.93 m2) in area shall not be limited by the minimum clear opening width." .

    ibc:sem-ibc2021-ch10-list_item-0275-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT2" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0276-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The maximum width of door leaves in revolving doors that comply with Section 1010.3.1 shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-0277-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The maximum width of door leaves in poweroperated doors that comply with Section 1010.3.2 shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-0278-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Door openings within a dwelling unit or sleeping unit shall have a minimum clear opening height of 78 inches (1981 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0278-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 78.0 .

    ibc:sem-ibc2021-ch10-list_item-0279-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, exterior door openings other than the required exit door shall have a minimum clear opening height of 76 inches (1930 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0279-condition-1 a ibco:Condition ;
        ibco:text "other than the required exit door shall have a minimum clear opening height of 76 inches (1930 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0279-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 76.0 .

    ibc:sem-ibc2021-ch10-list_item-0280-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In Groups I-1, R-2, R-3 and R-4, in dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, the minimum clear opening widths shall not apply to interior egress doors." .

    ibc:sem-ibc2021-ch10-list_item-0281-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Door openings required to be accessible within Type B units intended for user passage shall have a minimum clear opening width of 31.75 inches (806 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0281-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 31.75 .

    ibc:sem-ibc2021-ch10-list_item-0282-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors to walk-in freezers and coolers less than 1,000 square feet (93 m2) in area shall have a maximum width of 60 inches (1524 mm) nominal." .

    ibc:sem-ibc2021-ch10-list_item-0282-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-ch10-list_item-0282-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 60.0 .

    ibc:sem-ibc2021-ch10-list_item-0283-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors serving nonaccessible single-user shower or sauna compartments, toilet stalls or dressing, fitting or changing rooms shall have a minimum clear opening width of 20 inches (508 mm). " .

    ibc:sem-ibc2021-ch10-list_item-0283-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-ch10-list_item-0292-condition-1 a ibco:Condition ;
        ibco:text "other than Group H occupancies, revolving doors complying with Section 1010." .

    ibc:sem-ibc2021-ch10-list_item-0293-condition-1 a ibco:Condition ;
        ibco:text "other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies complying with Section 1010." .

    ibc:sem-ibc2021-ch10-list_item-0296-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In other than Group H occupancies, manually operated horizontal sliding doors are permitted in a means of egress from spaces with an occupant load of 10 or less." .

    ibc:sem-ibc2021-ch10-list_item-0296-condition-1 a ibco:Condition ;
        ibco:text "other than Group H occupancies, manually operated horizontal sliding doors are permitted in a means of egress from spaces with an occupant load of 10 or less." .

    ibc:sem-ibc2021-ch10-list_item-0299-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)." .

    ibc:sem-ibc2021-ch10-list_item-0299-condition-1 a ibco:Condition ;
        ibco:text "Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)." .

    ibc:sem-ibc2021-ch10-list_item-0300-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm)." .

    ibc:sem-ibc2021-ch10-list_item-0300-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The force to open doors shall comply with the following:" .

    ibc:sem-ibc2021-ch10-list_item-0300-condition-1 a ibco:Condition ;
        ibco:text "Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm)." .

    ibc:sem-ibc2021-ch10-list_item-0300-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 28.0 .

    ibc:sem-ibc2021-ch10-list_item-0301-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "For interior swinging egress doors that are manually operated, other than doors required to be fire rated, the force for pushing or pulling open the door shall not exceed 5 pounds (22 N)." .

    ibc:sem-ibc2021-ch10-list_item-0301-condition-1 a ibco:Condition ;
        ibco:text "other than doors required to be fire rated, the force for pushing or pulling open the door shall not exceed 5 pounds (22 N)." .

    ibc:sem-ibc2021-ch10-list_item-0302-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For other swinging doors, sliding doors or folding doors, and doors required to be fire rated, the door shall require not more than a 30-pound (133 N) force to be set in motion and shall move to a fullopen position when subjected to not more than a 15-pound (67 N) force." .

    ibc:sem-ibc2021-ch10-list_item-0307-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "At doors serving individual dwelling units or sleeping units in Groups R-2 and R-3 : a door is permitted to open at the top step of an interior flight of stairs, provided that the door does not swing over the top step." .

    ibc:sem-ibc2021-ch10-list_item-0307-condition-1 a ibco:Condition ;
        ibco:text "provided that the door does not swing over the top step." .

    ibc:sem-ibc2021-ch10-list_item-0308-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "At exterior doors serving Groups F, H, R-2 and S and where such doors are not part of an accessible route, the landing at an exterior door shall not be more than 7 inches (178 mm) below the landing on the egress side of the door, provided that the door, other than an exterior storm or screen door, does not swing over the landing." .

    ibc:sem-ibc2021-ch10-list_item-0308-condition-1 a ibco:Condition ;
        ibco:text "where such doors are not part of an accessible route, the landing at an exterior door shall not be more than 7 inches (178 mm) below the landing on the egress side of the door, provided that the door, other than an exterior storm or screen door, does not swing over the landing." .

    ibc:sem-ibc2021-ch10-list_item-0308-condition-2 a ibco:Condition ;
        ibco:text "provided that the door, other than an exterior storm or screen door, does not swing over the landing." .

    ibc:sem-ibc2021-ch10-list_item-0308-condition-3 a ibco:Condition ;
        ibco:text "other than an exterior storm or screen door, does not swing over the landing." .

    ibc:sem-ibc2021-ch10-list_item-0308-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-ch10-list_item-0309-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "At exterior doors serving Group U and individual dwelling units and sleeping units in Groups R-2 and R-3, and where such units are not required to be Accessible units, Type A units or Type B units, the landing at an exterior doorway shall be not more than 73/4 inches (197 mm) below the landing on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0309-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such doors, including storm or screen doors, shall be permitted to swing over either landing." .

    ibc:sem-ibc2021-ch10-list_item-0309-condition-1 a ibco:Condition ;
        ibco:text "where such units are not required to be Accessible units, Type A units or Type B units, the landing at an exterior doorway shall be not more than 73/4 inches (197 mm) below the landing on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0309-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0310-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0311-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0312-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Doors serving equipment spaces not required to be accessible in accordance with Section 1103.2.9 and serving an occupant load of five or less shall be permitted to have a landing on one side to be not more than 7 inches (178 mm) above or below the landing on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0312-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-ch10-list_item-0317-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In occupancy Group R-2 or R-3, threshold heights for sliding and side-hinged exterior doors shall be permitted to be up to 73/4 inches (197 mm) in height if all of the following apply:" .

    ibc:sem-ibc2021-ch10-list_item-0317-condition-1 a ibco:Condition ;
        ibco:text "if all of the following apply:" .

    ibc:sem-ibc2021-ch10-list_item-0317-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0321-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In Type B units, where Exception 5 to Section 1010.1.4 permits a 4-inch (102 mm) elevation change at the door, the threshold height on the exterior side of the door shall not exceed 43/4 inches (120 mm) in height above the exterior deck, patio or balcony for sliding doors or 41/2 inches (114 mm) above the exterior deck, patio or balcony for other doors." .

    ibc:sem-ibc2021-ch10-list_item-0321-condition-1 a ibco:Condition ;
        ibco:text "where Exception 5 to Section 1010." .

    ibc:sem-ibc2021-ch10-list_item-0321-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0321-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0324-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum distance between horizontal sliding power-operated doors in a series shall be 48 inches (1219 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0324-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0325-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Storm and screen doors serving individual dwelling units in Groups R-2 and R-3 need not be spaced 48 inches (1219 mm) from the other door." .

    ibc:sem-ibc2021-ch10-list_item-0325-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0326-condition-1 a ibco:Condition ;
        ibco:text "other than within Type A dwelling units." .

    ibc:sem-ibc2021-ch10-list_item-0331-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where manually operated bolt locks are permitted by Section 1010.2.5." .

    ibc:sem-ibc2021-ch10-list_item-0331-condition-1 a ibco:Condition ;
        ibco:text "Where manually operated bolt locks are permitted by Section 1010." .

    ibc:sem-ibc2021-ch10-list_item-0332-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Doors with automatic flush bolts as permitted by Section 1010.2.4, Item 4." .

    ibc:sem-ibc2021-ch10-list_item-0333-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Doors from individual dwelling units and sleeping units of Group R occupancies as permitted by Section 1010.2.4, Item 5." .

    ibc:sem-ibc2021-ch10-list_item-0339-condition-1 a ibco:Condition ;
        ibco:text "where the clinical needs of persons receiving care require containment or where persons receiving care pose a security threat, provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times." .

    ibc:sem-ibc2021-ch10-list_item-0339-condition-2 a ibco:Condition ;
        ibco:text "where persons receiving care pose a security threat, provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times." .

    ibc:sem-ibc2021-ch10-list_item-0339-condition-3 a ibco:Condition ;
        ibco:text "provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times." .

    ibc:sem-ibc2021-ch10-list_item-0340-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In buildings in occupancy Group A having an occupant load of 300 or less, Groups B, F, M and S, and in places of religious worship, the main door or doors are permitted to be equipped with key-operated locking devices from the egress side provided:" .

    ibc:sem-ibc2021-ch10-list_item-0342-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The sign shall be in letters 1 inch (25 mm) high on a contrasting background." .

    ibc:sem-ibc2021-ch10-list_item-0342-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0344-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where egress doors are used in pairs, approved automatic flush bolts shall be permitted to be used, provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware." .

    ibc:sem-ibc2021-ch10-list_item-0344-condition-1 a ibco:Condition ;
        ibco:text "Where egress doors are used in pairs, approved automatic flush bolts shall be permitted to be used, provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware." .

    ibc:sem-ibc2021-ch10-list_item-0344-condition-2 a ibco:Condition ;
        ibco:text "provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware." .

    ibc:sem-ibc2021-ch10-list_item-0345-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Doors from individual dwelling or sleeping units of Group R occupancies having an occupant load of 10 or less are permitted to be equipped with a night latch, dead bolt or security chain, provided such devices are openable from the inside without the use of a key or tool." .

    ibc:sem-ibc2021-ch10-list_item-0347-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors serving roofs not intended to be occupied shall be permitted to be locked preventing entry to the building from the roof." .

    ibc:sem-ibc2021-ch10-list_item-0348-atomic-1 a ibco:AtomicRule ;
        ibco:modality "must" ;
        ibco:statementType "obligation" ;
        ibco:text "Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0348-condition-1 a ibco:Condition ;
        ibco:text "where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0348-condition-2 a ibco:Condition ;
        ibco:text "where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0348-condition-3 a ibco:Condition ;
        ibco:text "Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0349-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The maximum occupant load shall be posted where required by Section 1004.9." .

    ibc:sem-ibc2021-ch10-list_item-0349-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such signage shall be permanently affixed inside the building and shall be posted in a conspicuous space near all the exit access doorways." .

    ibc:sem-ibc2021-ch10-list_item-0349-condition-1 a ibco:Condition ;
        ibco:text "where required by Section 1004." .

    ibc:sem-ibc2021-ch10-list_item-0350-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A weatherproof telephone or two-way communication system installed in accordance with Sections 1009.8.1 and 1009.8.2 shall be located adjacent to not less than one required exit access door on the exterior side." .

    ibc:sem-ibc2021-ch10-list_item-0351-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The egress door locking device is readily distinguishable as locked and shall be a key-operated locking device." .

    ibc:sem-ibc2021-ch10-list_item-0352-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A clear window or glazed door opening, not less than 5 square feet (0.46 m2) in area, shall be provided at each exit access door to determine if there are occupants using the outdoor area." .

    ibc:sem-ibc2021-ch10-list_item-0352-condition-1 a ibco:Condition ;
        ibco:text "if there are occupants using the outdoor area." .

    ibc:sem-ibc2021-ch10-list_item-0352-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-ch10-list_item-0353-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A readily visible, durable sign shall be posted on the interior side on or adjacent to each locked required exit access door serving the exterior area stating, \"THIS DOOR TO REMAIN UNLOCKED WHEN THE OUTDOOR AREA IS OCCUPIED.\" The letters on the sign shall be not less than 1 inch (25.4 mm) high on a contrasting background." .

    ibc:sem-ibc2021-ch10-list_item-0353-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0354-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The occupant load of the occupied exterior area shall not exceed 300 occupants in accordance with Section 1004." .

    ibc:sem-ibc2021-ch10-list_item-0355-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Locking devices are permitted on doors to balconies, decks or other exterior spaces serving individual dwelling or sleeping units." .

    ibc:sem-ibc2021-ch10-list_item-0356-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Locking devices are permitted on doors to balconies, decks or other exterior spaces of 250 square feet (23.23 m2) or less serving a private office space." .

    ibc:sem-ibc2021-ch10-list_item-0356-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-ch10-list_item-0359-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "On doors not required for egress in individual dwelling units or sleeping units." .

    ibc:sem-ibc2021-ch10-list_item-0360-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where a pair of doors serves a storage or equipment room, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:sem-ibc2021-ch10-list_item-0360-condition-1 a ibco:Condition ;
        ibco:text "Where a pair of doors serves a storage or equipment room, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:sem-ibc2021-ch10-list_item-0361-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:sem-ibc2021-ch10-list_item-0361-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0361-condition-1 a ibco:Condition ;
        ibco:text "Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:sem-ibc2021-ch10-list_item-0362-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0362-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0362-condition-1 a ibco:Condition ;
        ibco:text "Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0362-condition-2 a ibco:Condition ;
        ibco:text "provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0363-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0363-condition-1 a ibco:Condition ;
        ibco:text "Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0363-condition-2 a ibco:Condition ;
        ibco:text "provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0367-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairway discharge doors shall be openable from the egress side and shall only be locked from the opposite side." .

    ibc:sem-ibc2021-ch10-list_item-0368-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "This section shall not apply to doors arranged in accordance with Section 403.5.3." .

    ibc:sem-ibc2021-ch10-list_item-0369-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Stairway exit doors are permitted to be locked from the side opposite the egress side, provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building." .

    ibc:sem-ibc2021-ch10-list_item-0369-condition-1 a ibco:Condition ;
        ibco:text "if present, or a signal by emergency personnel from a single location inside the main entrance to the building." .

    ibc:sem-ibc2021-ch10-list_item-0369-condition-2 a ibco:Condition ;
        ibco:text "provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building." .

    ibc:sem-ibc2021-ch10-list_item-0370-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group B, F, M and S occupancies where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:sem-ibc2021-ch10-list_item-0370-condition-1 a ibco:Condition ;
        ibco:text "where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006." .

    ibc:sem-ibc2021-ch10-list_item-0370-condition-2 a ibco:Condition ;
        ibco:text "where permitted in Section 1006." .

    ibc:sem-ibc2021-ch10-list_item-0371-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group R-2 occupancies where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:sem-ibc2021-ch10-list_item-0371-condition-1 a ibco:Condition ;
        ibco:text "where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006." .

    ibc:sem-ibc2021-ch10-list_item-0371-condition-2 a ibco:Condition ;
        ibco:text "where permitted in Section 1006." .

    ibc:sem-ibc2021-ch10-list_item-0373-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door shall be capable of being unlocked from outside the room with a key or other approved means." .

    ibc:sem-ibc2021-ch10-list_item-0374-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door shall be openable from within the room in accordance with Section 1010.2." .

    ibc:sem-ibc2021-ch10-list_item-0375-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Modifications shall not be made to listed panic hardware, fire door hardware or door closers." .

    ibc:sem-ibc2021-ch10-list_item-0376-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Modifications to fire door assemblies shall be in accordance with NFPA 80." .

    ibc:sem-ibc2021-ch10-list_item-0376-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Remote locking or unlocking of doors from an approved location shall be permitted in addition to the unlocking operation in Item 1." .

    ibc:sem-ibc2021-ch10-list_item-0379-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A main exit of a Group A occupancy shall be permitted to have locking devices in accordance with Section 1010.2.4, Item 3." .

    ibc:sem-ibc2021-ch10-list_item-0380-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors provided with panic hardware or fire exit hardware and serving a Group A or E occupancy shall be permitted to be electrically locked in accordance with Section 1010.2.11 or 1010.2.12." .

    ibc:sem-ibc2021-ch10-list_item-0381-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access doors serving occupied exterior areas shall be permitted to be locked in accordance with Section 1010.2.4, Item 8." .

    ibc:sem-ibc2021-ch10-list_item-0382-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Courtrooms shall be permitted to be locked in accordance with Section 1010.2.13, Item 3. " .

    ibc:sem-ibc2021-ch10-list_item-0386-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Panic hardware shall be listed in accordance with UL 305." .

    ibc:sem-ibc2021-ch10-list_item-0387-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Fire exit hardware shall be listed in accordance with UL 10C and UL 305." .

    ibc:sem-ibc2021-ch10-list_item-0388-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The actuating portion of the releasing device shall extend not less than one-half of the door leaf width." .

    ibc:sem-ibc2021-ch10-list_item-0389-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The maximum unlatching force shall not exceed 15 pounds (67 N)." .

    ibc:sem-ibc2021-ch10-list_item-0394-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door hardware is capable of being operated with one hand and shall comply with Section 1010.2.1." .

    ibc:sem-ibc2021-ch10-list_item-0397-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where panic or fire exit hardware is required by Section 1010.2.9, operation of the panic or fire exit hardware also releases the electric lock." .

    ibc:sem-ibc2021-ch10-list_item-0397-condition-1 a ibco:Condition ;
        ibco:text "Where panic or fire exit hardware is required by Section 1010." .

    ibc:sem-ibc2021-ch10-list_item-0398-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0400-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The sensor shall be installed on the egress side, arranged to detect an occupant approaching the doors, and shall cause the electric locking system to unlock." .

    ibc:sem-ibc2021-ch10-list_item-0401-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The electric locks shall be arranged to unlock by a signal from or loss of power to the sensor." .

    ibc:sem-ibc2021-ch10-list_item-0402-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Loss of power to the lock or locking system shall automatically unlock the electric locks." .

    ibc:sem-ibc2021-ch10-list_item-0403-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The doors shall be arranged to unlock from a manual unlocking device located 40 inches to 48 inches (1016 mm to 1219 mm) vertically above the floor and within 5 feet (1524 mm) of the secured doors." .

    ibc:sem-ibc2021-ch10-list_item-0403-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ready access shall be provided to the manual unlocking device and the device shall be clearly identified by a sign that reads “PUSH TO EXIT.” When operated, the manual unlocking device shall result in direct interruption of power to the electric lock—independent of other electronics—and the electric lock shall remain unlocked for not less than 30 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0403-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 40.0 .

    ibc:sem-ibc2021-ch10-list_item-0403-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0403-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-ch10-list_item-0404-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Activation of the building fire alarm system, where provided, shall automatically unlock the electric lock, and the electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:sem-ibc2021-ch10-list_item-0404-condition-1 a ibco:Condition ;
        ibco:text "where provided, shall automatically unlock the electric lock, and the electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:sem-ibc2021-ch10-list_item-0405-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Activation of the building automatic sprinkler system or fire detection system, where provided, shall automatically unlock the electric lock." .

    ibc:sem-ibc2021-ch10-list_item-0405-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:sem-ibc2021-ch10-list_item-0405-condition-1 a ibco:Condition ;
        ibco:text "where provided, shall automatically unlock the electric lock." .

    ibc:sem-ibc2021-ch10-list_item-0406-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency lighting shall be provided on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0407-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0411-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In courtrooms in Group A-3 and B occupancies, delayed egress locking systems shall be permitted to be installed on exit or exit access doors, other than the main exit or exit access door, in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0411-condition-1 a ibco:Condition ;
        ibco:text "other than the main exit or exit access door, in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0414-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The delay electronics of the delayed egress locking system shall deactivate upon actuation of the automatic sprinkler system or automatic fire detection system, allowing immediate free egress." .

    ibc:sem-ibc2021-ch10-list_item-0415-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The delay electronics of the delayed egress locking system shall deactivate upon loss of power controlling the lock or lock mechanism, allowing immediate free egress." .

    ibc:sem-ibc2021-ch10-list_item-0416-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The delayed egress locking system shall have the capability of being deactivated at the fire command center and other approved locations." .

    ibc:sem-ibc2021-ch10-list_item-0417-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "An attempt to egress shall initiate an irreversible process that shall allow such egress in not more than 15 seconds when a physical effort to exit is applied to the egress side door hardware for not more than 3 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0417-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Initiation of the irreversible process shall activate an audible signal in the vicinity of the door." .

    ibc:sem-ibc2021-ch10-list_item-0417-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Once the delay electronics have been deactivated, rearming the delay electronics shall be by manual means only." .

    ibc:sem-ibc2021-ch10-list_item-0419-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The egress path from any point shall not pass through more than one delayed egress locking system." .

    ibc:sem-ibc2021-ch10-list_item-0421-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-1, Condition 2, Group I-2 or I-3 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided that the combined delay does not exceed 30 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0421-condition-1 a ibco:Condition ;
        ibco:text "provided that the combined delay does not exceed 30 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0422-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-1, Condition 1 or Group I-4 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided the combined delay does not exceed 30 seconds and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0423-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A sign shall be provided on the door and shall be located above and within 12 inches (305 mm) of the door exit hardware:" .

    ibc:sem-ibc2021-ch10-list_item-0423-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-0425-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For doors that swing in the direction of egress, the sign shall read, \"PUSH UNTIL ALARM SOUNDS." .

    ibc:sem-ibc2021-ch10-list_item-0426-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For doors that swing in the opposite direction of egress, the sign shall read, \"PULL UNTIL ALARM SOUNDS." .

    ibc:sem-ibc2021-ch10-list_item-0427-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The sign shall comply with the visual character requirements in ICC A117.1." .

    ibc:sem-ibc2021-ch10-list_item-0428-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency lighting shall be provided on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0429-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The delayed egress locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0431-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Electric locking systems, including electro-mechanical locking systems and electromagnetic locking systems, shall be permitted to be locked in the means of egress in Group I-1 or I-2 occupancies where the clinical needs of persons receiving care require their containment." .

    ibc:sem-ibc2021-ch10-list_item-0431-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Controlled egress doors shall be permitted in such occupancies where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke detection system installed in accordance with Section 907, provided that the doors are installed and operate in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0431-condition-1 a ibco:Condition ;
        ibco:text "where the clinical needs of persons receiving care require their containment." .

    ibc:sem-ibc2021-ch10-list_item-0431-condition-2 a ibco:Condition ;
        ibco:text "where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0431-condition-3 a ibco:Condition ;
        ibco:text "provided that the doors are installed and operate in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0432-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door locks shall unlock on actuation of the automatic sprinkler system or automatic smoke detection system." .

    ibc:sem-ibc2021-ch10-list_item-0433-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door locks shall unlock on loss of power controlling the lock or lock mechanism." .

    ibc:sem-ibc2021-ch10-list_item-0434-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door locking system shall be installed to have the capability of being unlocked by a switch located at the fire command center, a nursing station or other approved location." .

    ibc:sem-ibc2021-ch10-list_item-0434-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The switch shall directly break power to the lock." .

    ibc:sem-ibc2021-ch10-list_item-0435-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A building occupant shall not be required to pass through more than one door equipped with a controlled egress locking system before entering an exit." .

    ibc:sem-ibc2021-ch10-list_item-0436-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The procedures for unlocking the doors shall be described and approved as part of the emergency planning and preparedness required by Chapter 4 of the International Fire Code." .

    ibc:sem-ibc2021-ch10-list_item-0437-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "All clinical staff shall have the keys, codes or other means necessary to operate the locking systems." .

    ibc:sem-ibc2021-ch10-list_item-0438-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency lighting shall be provided at the door." .

    ibc:sem-ibc2021-ch10-list_item-0439-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0441-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Items 1 through 4 shall not apply to doors to areas occupied by persons who, because of clinical needs, require restraint or containment as part of the function of a psychiatric or cognitive treatment area." .

    ibc:sem-ibc2021-ch10-list_item-0442-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Items 1 through 4 shall not apply to doors to areas where a listed egress control system is utilized to reduce the risk of child abduction from nursery and obstetric areas of a Group I-2 hospital." .

    ibc:sem-ibc2021-ch10-list_item-0442-condition-1 a ibco:Condition ;
        ibco:text "where a listed egress control system is utilized to reduce the risk of child abduction from nursery and obstetric areas of a Group I-2 hospital." .

    ibc:sem-ibc2021-ch10-list_item-0449-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Revolving doors shall comply with BHMA A156.27 and shall be installed in accordance with the manufacturer’s instructions." .

    ibc:sem-ibc2021-ch10-list_item-0450-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each revolving door shall be capable of breakout in accordance with BHMA A156.27 and shall provide an aggregate width of not less than 36 inches (914 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0450-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-ch10-list_item-0451-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A revolving door shall not be located within 10 feet (3048 mm) of the foot or top of stairways or escalators." .

    ibc:sem-ibc2021-ch10-list_item-0451-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A dispersal area shall be provided between the stairways or escalators and the revolving doors." .

    ibc:sem-ibc2021-ch10-list_item-0451-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0452-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The revolutions per minute (rpm) for a revolving door shall not exceed the maximum rpm as specified in BHMA A156.27." .

    ibc:sem-ibc2021-ch10-list_item-0452-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Manual revolving doors shall comply with Table 1010.3.1(1)." .

    ibc:sem-ibc2021-ch10-list_item-0452-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Automatic or power-operated revolving doors shall comply with Table 1010.3.1(2)." .

    ibc:sem-ibc2021-ch10-list_item-0453-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "An emergency stop switch shall be provided near each entry point of power or automatic operated revolving doors within 48 inches (1219 mm) of the door and between 34 inches (864 mm) and 48 inches (1219 mm) above the floor." .

    ibc:sem-ibc2021-ch10-list_item-0453-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The activation area of the emergency stop switch button shall be not less than 1 inch (25 mm) in diameter and shall be red." .

    ibc:sem-ibc2021-ch10-list_item-0453-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0453-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0453-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0453-measurement-4 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0454-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each revolving door shall have a side-hinged swinging door that complies with Section 1010.1 in the same wall and within 10 feet (3048 mm) of the revolving door." .

    ibc:sem-ibc2021-ch10-list_item-0454-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0455-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Revolving doors shall not be part of an accessible route required by Section 1009 and Chapter 11." .

    ibc:sem-ibc2021-ch10-list_item-0455-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0455-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0455-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0455-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0457-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Revolving doors shall not be given credit for more than 50 percent of the minimum width or required capacity." .

    ibc:sem-ibc2021-ch10-list_item-0457-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0458-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each revolving door shall be credited with a capacity based on not more than a 50-person occupant load." .

    ibc:sem-ibc2021-ch10-list_item-0459-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each revolving door shall provide for egress in accordance with BHMA A156.27 with a breakout force of not more than 130 pounds (578 N)." .

    ibc:sem-ibc2021-ch10-list_item-0463-condition-1 a ibco:Condition ;
        ibco:text "where such system is provided." .

    ibc:sem-ibc2021-ch10-list_item-0464-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 75.0 .

    ibc:sem-ibc2021-ch10-list_item-0470-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For a biparting door in the emergency breakout mode, a door leaf located within a multiple-leaf opening shall be exempt from the minimum 32-inch (813 mm) single-leaf requirement of Section 1010.1.1, provided that a minimum 32inch (813 mm) clear opening is provided when the two biparting leaves meeting in the center are broken out." .

    ibc:sem-ibc2021-ch10-list_item-0470-condition-1 a ibco:Condition ;
        ibco:text "provided that a minimum 32inch (813 mm) clear opening is provided when the two biparting leaves meeting in the center are broken out." .

    ibc:sem-ibc2021-ch10-list_item-0470-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-ch10-list_item-0472-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The doors shall be power operated and shall be capable of being operated manually in the event of power failure." .

    ibc:sem-ibc2021-ch10-list_item-0473-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The doors shall be openable by a simple method without special knowledge or effort from the egress side or sides." .

    ibc:sem-ibc2021-ch10-list_item-0474-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The force required to operate the door shall not exceed 30 pounds (133 N) to set the door in motion and 15 pounds (67 N) to close the door or open it to the minimum required width." .

    ibc:sem-ibc2021-ch10-list_item-0475-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door shall be openable with a force not to exceed 15 pounds (67 N) when a force of 250 pounds (1100 N) is applied perpendicular to the door adjacent to the operating device." .

    ibc:sem-ibc2021-ch10-list_item-0476-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door assembly shall comply with the applicable fire protection rating and, where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716.2.6.6, shall be installed in accordance with NFPA 80 and shall comply with Section 716." .

    ibc:sem-ibc2021-ch10-list_item-0476-condition-1 a ibco:Condition ;
        ibco:text "where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716." .

    ibc:sem-ibc2021-ch10-list_item-0477-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door assembly shall have an integrated standby power supply." .

    ibc:sem-ibc2021-ch10-list_item-0478-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door assembly power supply shall be electrically supervised." .

    ibc:sem-ibc2021-ch10-list_item-0479-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door shall open to the minimum required width within 10 seconds after activation of the operating device." .

    ibc:sem-ibc2021-ch10-list_item-0486-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each device shall turn free in the direction of egress travel when primary power is lost and on the manual release by an employee in the area." .

    ibc:sem-ibc2021-ch10-list_item-0487-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0488-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 39.0 .

    ibc:sem-ibc2021-ch10-list_item-0488-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0489-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 39.0 .

    ibc:sem-ibc2021-ch10-list_item-0489-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-ch10-list_item-0489-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 39.0 .

    ibc:sem-ibc2021-ch10-list_item-0493-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-ch10-list_item-0494-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Any security access turnstile lane configuration providing a clear passage width of less than 32 inches (810 mm) shall be credited with a maximum egress capacity of 50 persons." .

    ibc:sem-ibc2021-ch10-list_item-0494-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-ch10-list_item-0495-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Any security access turnstile lane configuration providing a clear passage width of 32 inches (810 mm) or more shall be credited with a maximum egress capacity as calculated in accordance with Section 1005." .

    ibc:sem-ibc2021-ch10-list_item-0495-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-ch10-list_item-0496-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each secured physical barrier shall automatically retract or swing to an unobstructed open position in the direction of egress, under each of the following conditions:" .

    ibc:sem-ibc2021-ch10-list_item-0498-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The manual release device shall be positioned at one of the following locations:" .

    ibc:sem-ibc2021-ch10-list_item-0500-condition-1 a ibco:Condition ;
        ibco:text "where it can be actuated by an employee assigned to the area at all times that the building is occupied." .

    ibc:sem-ibc2021-ch10-list_item-0501-condition-1 a ibco:Condition ;
        ibco:text "if provided, after which the physical barrier remains in the open position until the fire alarm system is manually reset." .

    ibc:sem-ibc2021-ch10-list_item-0512-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways serving an occupant load of less than 50 shall have a width of not less than 36 inches (914 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0512-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-ch10-list_item-0514-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an incline platform lift or stairway chairlift is installed on stairways serving occupancies in Group R-3, or within dwelling units in occupancies in Group R-2, a clear passage width not less than 20 inches (508 mm) shall be provided." .

    ibc:sem-ibc2021-ch10-list_item-0514-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the seat and platform can be folded when not in use, the distance shall be measured from the folded position." .

    ibc:sem-ibc2021-ch10-list_item-0514-condition-1 a ibco:Condition ;
        ibco:text "Where an incline platform lift or stairway chairlift is installed on stairways serving occupancies in Group R-3, or within dwelling units in occupancies in Group R-2, a clear passage width not less than 20 inches (508 mm) shall be provided." .

    ibc:sem-ibc2021-ch10-list_item-0514-condition-2 a ibco:Condition ;
        ibco:text "Where the seat and platform can be folded when not in use, the distance shall be measured from the folded position." .

    ibc:sem-ibc2021-ch10-list_item-0514-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-ch10-list_item-0517-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Spiral stairways complying with Section 1011.10 are permitted a 78-inch (1981 mm) headroom clearance." .

    ibc:sem-ibc2021-ch10-list_item-0518-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R-3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; where the nosings of treads at the side of a flight extend under the edge of a floor opening through which the stair passes, the floor opening shall be allowed to project horizontally into the required headroom not more than 43/4 inches (121 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0518-condition-1 a ibco:Condition ;
        ibco:text "where the nosings of treads at the side of a flight extend under the edge of a floor opening through which the stair passes, the floor opening shall be allowed to project horizontally into the required headroom not more than 43/4 inches (121 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0518-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0525-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to use the riser/tread dimension in Section 1030.14.2." .

    ibc:sem-ibc2021-ch10-list_item-0526-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R- 3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; the maximum riser height shall be 73/4 inches (197 mm); the minimum tread depth shall be 10 inches (254 mm); the minimum winder tread depth at the walkline shall be 10 inches (254 mm); and the minimum winder tread depth shall be 6 inches (152 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0526-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A nosing projection not less than 3/4 inch (19.1 mm) but not more than 11/4 inches (32 mm) shall be provided on stairways with solid risers where the tread depth is less than 11 inches (279 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0526-condition-1 a ibco:Condition ;
        ibco:text "where the tread depth is less than 11 inches (279 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-5 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-6 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0526-measurement-7 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-ch10-list_item-0528-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-3 facilities, stairways providing access to guard towers, observation stations and control rooms, not more than 250 square feet (23 m2) in area, shall be permitted to have a maximum riser height of 8 inches (203 mm) and a minimum tread depth of 9 inches (229 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0528-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-ch10-list_item-0528-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-list_item-0528-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 9.0 .

    ibc:sem-ibc2021-ch10-list_item-0535-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to comply with the dimensional nonuniformity in Section 1030.14.2." .

    ibc:sem-ibc2021-ch10-list_item-0541-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "of treads shall project not more than 11/4 inches (32 mm) beyond the tread below." .

    ibc:sem-ibc2021-ch10-list_item-0541-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0545-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Solid risers are not required for stairways that are not required to comply with Section 1009.3, provided that the opening between treads does not permit the passage of a sphere with a diameter of 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0545-condition-1 a ibco:Condition ;
        ibco:text "provided that the opening between treads does not permit the passage of a sphere with a diameter of 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0545-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0546-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Solid risers are not required for occupancies in Group I-3 or in Group F, H and S occupancies other than areas accessible to the public." .

    ibc:sem-ibc2021-ch10-list_item-0546-condition-1 a ibco:Condition ;
        ibco:text "other than areas accessible to the public." .

    ibc:sem-ibc2021-ch10-list_item-0547-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Solid risers are not required for spiral stairways constructed in accordance with Section 1011.10." .

    ibc:sem-ibc2021-ch10-list_item-0550-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0550-condition-1 a ibco:Condition ;
        ibco:text "Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0551-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where curved stairways of constant radius have intermediate landings, the landing depth shall be measured horizontally between the intersection of the walkline of the lower flight at the landing nosing and the intersection of the walkline of the upper flight at the nosing of the lowest tread of the upper flight." .

    ibc:sem-ibc2021-ch10-list_item-0551-condition-1 a ibco:Condition ;
        ibco:text "Where curved stairways of constant radius have intermediate landings, the landing depth shall be measured horizontally between the intersection of the walkline of the lower flight at the landing nosing and the intersection of the walkline of the upper flight at the nosing of the lowest tread of the upper flight." .

    ibc:sem-ibc2021-ch10-list_item-0552-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where a landing turns 90 degrees (1.57 rad) or more, the minimum landing depth in accordance with this section shall not be required where the landing provided is not less than that described by an arc with a radius equal to the width of the flight served." .

    ibc:sem-ibc2021-ch10-list_item-0552-condition-1 a ibco:Condition ;
        ibco:text "Where a landing turns 90 degrees (1." .

    ibc:sem-ibc2021-ch10-list_item-0552-condition-2 a ibco:Condition ;
        ibco:text "where the landing provided is not less than that described by an arc with a radius equal to the width of the flight served." .

    ibc:sem-ibc2021-ch10-list_item-0555-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Wood handrails shall be permitted in all types of construction." .

    ibc:sem-ibc2021-ch10-list_item-0560-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings in stair walking surfaces shall be a size that does not permit the passage of 1/2inch-diameter (12.7 mm) sphere." .

    ibc:sem-ibc2021-ch10-list_item-0560-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Elongated openings shall be placed so that the long dimension is perpendicular to the direction of travel." .

    ibc:sem-ibc2021-ch10-list_item-0560-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0561-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In Group F, H and S occupancies, other than areas of parking structures accessible to the public, openings in treads and landings shall not be prohibited provided that a sphere with a diameter of 11/8 inches (29 mm) cannot pass through the opening." .

    ibc:sem-ibc2021-ch10-list_item-0561-condition-1 a ibco:Condition ;
        ibco:text "provided that a sphere with a diameter of 11/8 inches (29 mm) cannot pass through the opening." .

    ibc:sem-ibc2021-ch10-list_item-0561-condition-2 a ibco:Condition ;
        ibco:text "other than areas of parking structures accessible to the public, openings in treads and landings shall not be prohibited provided that a sphere with a diameter of 11/8 inches (29 mm) cannot pass through the opening." .

    ibc:sem-ibc2021-ch10-list_item-0561-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-list_item-0571-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A spiral stairway shall have a 63/4-inch (171 mm) minimum clear tread depth at a point 12 inches (305 mm) from the narrow edge." .

    ibc:sem-ibc2021-ch10-list_item-0571-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The risers shall be sufficient to provide a headroom of 78 inches (1981 mm) minimum, but riser height shall not be more than 91/2 inches (241 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0571-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum stairway clear width at and below the handrail shall be 26 inches (660 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0571-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-0571-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 78.0 .

    ibc:sem-ibc2021-ch10-list_item-0571-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0571-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 26.0 .

    ibc:sem-ibc2021-ch10-list_item-0574-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Flights of stairways within dwelling units and flights of spiral stairways are permitted to have a handrail on one side only." .

    ibc:sem-ibc2021-ch10-list_item-0575-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Decks, patios and walkways that have a single change in elevation where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails." .

    ibc:sem-ibc2021-ch10-list_item-0575-condition-1 a ibco:Condition ;
        ibco:text "where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails." .

    ibc:sem-ibc2021-ch10-list_item-0578-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where a platform lift is in a stationary position and the floor of the platform lift serves as the upper landing of a stairway, handrails shall not be required on the stairway, provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0578-condition-1 a ibco:Condition ;
        ibco:text "Where a platform lift is in a stationary position and the floor of the platform lift serves as the upper landing of a stairway, handrails shall not be required on the stairway, provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0578-condition-2 a ibco:Condition ;
        ibco:text "provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0581-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0581-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-ch10-list_item-0582-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.5 .

    ibc:sem-ibc2021-ch10-list_item-0601-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Nonoccupied roofs that are not required to have stairway access in accordance with Section 1011.12.1." .

    ibc:sem-ibc2021-ch10-list_item-0602-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where permitted to access equipment and appliances in accordance with Section 306.5 of the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-list_item-0602-condition-1 a ibco:Condition ;
        ibco:text "Where permitted to access equipment and appliances in accordance with Section 306." .

    ibc:sem-ibc2021-ch10-list_item-0606-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles within assembly rooms or spaces shall comply with the provisions in Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0607-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Curb ramps shall comply with ICC A117.1." .

    ibc:sem-ibc2021-ch10-list_item-0608-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Vehicle ramps in parking garages for pedestrian exit access shall not be required to comply with Sections 1012.3 through 1012.10 where they are not an accessible route serving accessible parking spaces, other required accessible elements or part of an accessible means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0608-condition-1 a ibco:Condition ;
        ibco:text "where they are not an accessible route serving accessible parking spaces, other required accessible elements or part of an accessible means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0621-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In Group R-2 and R-3 individual dwelling and sleeping units that are not required to be Accessible units, Type A units or Type B units in accordance with Section 1108, landings are permitted to be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-ch10-list_item-0621-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-ch10-list_item-0622-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where the ramp is not a part of an accessible route, the length of the landing shall not be required to be more than 48 inches (1219 mm) in the direction of travel." .

    ibc:sem-ibc2021-ch10-list_item-0622-condition-1 a ibco:Condition ;
        ibco:text "Where the ramp is not a part of an accessible route, the length of the landing shall not be required to be more than 48 inches (1219 mm) in the direction of travel." .

    ibc:sem-ibc2021-ch10-list_item-0622-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-ch10-list_item-0633-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Edge protection is not required on ramps that are not required to have handrails, provided they have flared sides that comply with the ICC A117.1 curb ramp provisions." .

    ibc:sem-ibc2021-ch10-list_item-0634-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Edge protection is not required on the sides of ramp landings serving an adjoining ramp run or stairway." .

    ibc:sem-ibc2021-ch10-list_item-0635-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Edge protection is not required on the sides of ramp landings having a vertical dropoff of not more than 1/2 inch (12.7 mm) within 10 inches (254 mm) horizontally of the required landing area." .

    ibc:sem-ibc2021-ch10-list_item-0635-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0635-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0641-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Exit signs are not required in rooms or areas that require only one exit or exit access." .

    ibc:sem-ibc2021-ch10-list_item-0642-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Main exterior exit doors or gates that are obviously and clearly identifiable as exits need not have exit signs where approved by the building official." .

    ibc:sem-ibc2021-ch10-list_item-0642-condition-1 a ibco:Condition ;
        ibco:text "where approved by the building official." .

    ibc:sem-ibc2021-ch10-list_item-0643-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Exit signs are not required in occupancies in Group U and individual sleeping units or dwelling units in Group R-1, R-2 or R-3." .

    ibc:sem-ibc2021-ch10-list_item-0644-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Exit signs are not required in dayrooms, sleeping rooms or dormitories in occupancies in Group I-3." .

    ibc:sem-ibc2021-ch10-list_item-0645-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In occupancies in Groups A-4 and A-5, exit signs are not required on the seating side of vomitories or openings into seating areas where exit signs are provided in the concourse that are readily apparent from the vomitories." .

    ibc:sem-ibc2021-ch10-list_item-0645-condition-1 a ibco:Condition ;
        ibco:text "where exit signs are provided in the concourse that are readily apparent from the vomitories." .

    ibc:sem-ibc2021-ch10-list_item-0660-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where handrail fittings or bendings are used to provide continuous transition between flights, the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0660-condition-1 a ibco:Condition ;
        ibco:text "Where handrail fittings or bendings are used to provide continuous transition between flights, the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0661-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are associated with a Group R-3 occupancy or associated with individual dwelling units in Group R-2 occupancies; where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0661-condition-1 a ibco:Condition ;
        ibco:text "where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0661-condition-2 a ibco:Condition ;
        ibco:text "where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0662-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Handrails on top of a guard where permitted along stepped aisles and ramped aisles in accordance with Section 1030.16." .

    ibc:sem-ibc2021-ch10-list_item-0662-condition-1 a ibco:Condition ;
        ibco:text "where permitted along stepped aisles and ramped aisles in accordance with Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0669-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Handrails within dwelling units are permitted to be interrupted by a newel post at a turn or landing." .

    ibc:sem-ibc2021-ch10-list_item-0671-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Handrail brackets or balusters attached to the bottom surface of the handrail that do not project horizontally beyond the sides of the handrail within 11/2 inches (38 mm) of the bottom of the handrail shall not be considered obstructions." .

    ibc:sem-ibc2021-ch10-list_item-0671-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For each 1/2 inch (12.7 mm) of additional handrail perimeter dimension above 4 inches (102 mm), the vertical clearance dimension of 11/2 inches (38 mm) shall be permitted to be reduced by 1/8 inch (3.2 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0671-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0671-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0671-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0671-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0671-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-list_item-0672-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards." .

    ibc:sem-ibc2021-ch10-list_item-0672-condition-1 a ibco:Condition ;
        ibco:text "Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards." .

    ibc:sem-ibc2021-ch10-list_item-0672-condition-2 a ibco:Condition ;
        ibco:text "where they are integral to crash rails or bumper guards." .

    ibc:sem-ibc2021-ch10-list_item-0673-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Handrails serving stepped aisles or ramped aisles are permitted to be discontinuous in accordance with Section 1030.16.1." .

    ibc:sem-ibc2021-ch10-list_item-0677-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrails within a dwelling unit that is not required to be accessible need extend only from the top riser to the bottom riser." .

    ibc:sem-ibc2021-ch10-list_item-0678-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Handrails serving aisles in rooms or spaces used for assembly purposes are permitted to comply with the handrail extensions in accordance with Section 1030.16." .

    ibc:sem-ibc2021-ch10-list_item-0679-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Handrails for alternating tread devices and ships ladders are permitted to terminate at a location vertically above the top and bottom risers." .

    ibc:sem-ibc2021-ch10-list_item-0679-atomic-2 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrails for alternating tread devices are not required to be continuous between flights or to extend beyond the top or bottom risers." .

    ibc:sem-ibc2021-ch10-list_item-0701-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For occupancies in Group R-3 not more than three stories above grade in height and within individual dwelling units in occupancies in Group R-2 not more than three stories above grade in height with separate means of egress, required guards shall be not less than 36 inches (914 mm) in height measured vertically above the adjacent walking surfaces." .

    ibc:sem-ibc2021-ch10-list_item-0701-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-ch10-list_item-0702-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, guards on the open sides of stairs shall have a height not less than 34 inches (864 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0702-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0703-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, where the top of the guard serves as a handrail on the open sides of stairs, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0703-condition-1 a ibco:Condition ;
        ibco:text "where the top of the guard serves as a handrail on the open sides of stairs, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0703-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0703-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 38.0 .

    ibc:sem-ibc2021-ch10-list_item-0704-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The guard height in assembly seating areas shall comply with Section 1030.17 as applicable." .

    ibc:sem-ibc2021-ch10-list_item-0705-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Along alternating tread devices and ships ladders, guards where the top rail serves as a handrail shall have height not less than 30 inches (762 mm) and not more than 34 inches (864 mm), measured vertically from the leading edge of the device tread nosing." .

    ibc:sem-ibc2021-ch10-list_item-0705-condition-1 a ibco:Condition ;
        ibco:text "where the top rail serves as a handrail shall have height not less than 30 inches (762 mm) and not more than 34 inches (864 mm), measured vertically from the leading edge of the device tread nosing." .

    ibc:sem-ibc2021-ch10-list_item-0705-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-0705-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0706-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group F occupancies where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0706-condition-1 a ibco:Condition ;
        ibco:text "where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0706-condition-2 a ibco:Condition ;
        ibco:text "where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0706-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-ch10-list_item-0706-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 38.0 .

    ibc:sem-ibc2021-ch10-list_item-0709-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "From a height of 36 inches (914 mm) to 42 inches (1067 mm), guards shall not have openings that allow passage of a sphere 43/8 inches (111 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0709-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-ch10-list_item-0709-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-ch10-list_item-0709-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-list_item-0710-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The triangular openings at the open sides of a stair, formed by the riser, tread and bottom rail shall not allow passage of a sphere 6 inches (152 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0710-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-ch10-list_item-0711-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "At elevated walking surfaces for access to and use of electrical, mechanical or plumbing systems or equipment, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0711-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 21.0 .

    ibc:sem-ibc2021-ch10-list_item-0712-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In areas that are not open to the public within occupancies in Group I-3, F, H or S, and for alternating tread devices and ships ladders, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0712-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 21.0 .

    ibc:sem-ibc2021-ch10-list_item-0713-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In assembly seating areas, guards required at the end of aisles in accordance with Section 1030.17.4 shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter up to a height of 26 inches (660 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0713-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "From a height of 26 inches (660 mm) to 42 inches (1067 mm) above the adjacent walking surfaces, guards shall not have openings that allow passage of a sphere 8 inches (203 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0713-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-0713-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 26.0 .

    ibc:sem-ibc2021-ch10-list_item-0713-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 26.0 .

    ibc:sem-ibc2021-ch10-list_item-0713-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-ch10-list_item-0713-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-ch10-list_item-0714-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Within individual dwelling units and sleeping units in Group R-2 and R-3 occupancies, guards on the open sides of stairs shall not have openings that allow passage of a sphere 43/8 (111 mm) inches in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0721-condition-1 a ibco:Condition ;
        ibco:text "where the top of the sill of the opening is located more than 75 feet (22 860 mm) above the finished grade or other surface below and that are provided with window fall prevention devices that comply with ASTM F2006." .

    ibc:sem-ibc2021-ch10-list_item-0721-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "FT" ;
        ibco:value 75.0 .

    ibc:sem-ibc2021-ch10-list_item-0722-condition-1 a ibco:Condition ;
        ibco:text "where the openings will not allow a 4-inch-diameter (102 mm) sphere to pass through the opening when the window is in its largest opened position." .

    ibc:sem-ibc2021-ch10-list_item-0723-condition-1 a ibco:Condition ;
        ibco:text "where the openings are provided with window fall prevention devices that comply with ASTM F2090." .

    ibc:sem-ibc2021-ch10-list_item-0729-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Exit access through an enclosed elevator lobby is permitted." .

    ibc:sem-ibc2021-ch10-list_item-0729-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where access to two or more exits or exit access doorways is required in Section 1006.2.1, access to not less than one of the required exits shall be provided without travel through the enclosed elevator lobbies required by Section 3006." .

    ibc:sem-ibc2021-ch10-list_item-0729-atomic-3 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Where the path of exit access travel passes through an enclosed elevator lobby, the level of protection required for the enclosed elevator lobby is not required to be extended to the exit unless direct access to an exit is required by other sections of this code." .

    ibc:sem-ibc2021-ch10-list_item-0729-condition-1 a ibco:Condition ;
        ibco:text "Where access to two or more exits or exit access doorways is required in Section 1006." .

    ibc:sem-ibc2021-ch10-list_item-0729-condition-2 a ibco:Condition ;
        ibco:text "Where the path of exit access travel passes through an enclosed elevator lobby, the level of protection required for the enclosed elevator lobby is not required to be extended to the exit unless direct access to an exit is required by other sections of this code." .

    ibc:sem-ibc2021-ch10-list_item-0729-condition-3 a ibco:Condition ;
        ibco:text "unless direct access to an exit is required by other sections of this code." .

    ibc:sem-ibc2021-ch10-list_item-0730-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Egress from a room or space shall not pass through adjoining or intervening rooms or areas, except where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit." .

    ibc:sem-ibc2021-ch10-list_item-0730-condition-1 a ibco:Condition ;
        ibco:text "where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit." .

    ibc:sem-ibc2021-ch10-list_item-0732-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "An exit access shall not pass through a room that can be locked to prevent egress." .

    ibc:sem-ibc2021-ch10-list_item-0733-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Means of egress from dwelling units or sleeping areas shall not lead through other sleeping areas, toilet rooms or bathrooms." .

    ibc:sem-ibc2021-ch10-list_item-0734-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Egress shall not pass through kitchens, storage rooms, closets or spaces used for similar purposes." .

    ibc:sem-ibc2021-ch10-list_item-0737-condition-1 a ibco:Condition ;
        ibco:text "where all of the following are met:" .

    ibc:sem-ibc2021-ch10-list_item-0739-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0748-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0748-condition-1 a ibco:Condition ;
        ibco:text "where automatic sprinkler systems are permitted in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0751-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:sem-ibc2021-ch10-list_item-0751-condition-1 a ibco:Condition ;
        ibco:text "where automatic sprinkler systems are permitted in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0755-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 24.0 .

    ibc:sem-ibc2021-ch10-list_item-0760-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In open parking garages, exit access travel distance is permitted to be measured to the closest riser of an exit access stairway or the closest slope of an exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-0761-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In smoke protected seating and open air assembly seating, exit access travel distance shall be measured in accordance with Section 1030.7." .

    ibc:sem-ibc2021-ch10-list_item-0782-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Such interconnected stories shall not be open to other stories." .

    ibc:sem-ibc2021-ch10-list_item-0784-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility are not required to be enclosed." .

    ibc:sem-ibc2021-ch10-list_item-0785-condition-1 a ibco:Condition ;
        ibco:text "where the area of the vertical opening between stories does not exceed twice the horizontal projected area of the stairway or ramp and the opening is protected by a draft curtain and closely spaced sprinklers in accordance with NFPA 13." .

    ibc:sem-ibc2021-ch10-list_item-0785-condition-2 a ibco:Condition ;
        ibco:text "other than Group B and M occupancies, this provision is limited to openings that do not connect more than four stories." .

    ibc:sem-ibc2021-ch10-list_item-0797-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "A fire-resistance rating is not required for corridors in an occupancy in Group E where each room that is used for instruction has not less than one door opening directly to the exterior and rooms for assembly purposes have not less than one-half of the required means of egress doors opening directly to the exterior." .

    ibc:sem-ibc2021-ch10-list_item-0797-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior doors specified in this exception are required to be at ground level." .

    ibc:sem-ibc2021-ch10-list_item-0797-condition-1 a ibco:Condition ;
        ibco:text "where each room that is used for instruction has not less than one door opening directly to the exterior and rooms for assembly purposes have not less than one-half of the required means of egress doors opening directly to the exterior." .

    ibc:sem-ibc2021-ch10-list_item-0798-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "A fire-resistance rating is not required for corridors contained within a dwelling unit or sleeping unit in an occupancy in Groups I-1 and R." .

    ibc:sem-ibc2021-ch10-list_item-0799-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "A fire-resistance rating is not required for corridors in open parking garages." .

    ibc:sem-ibc2021-ch10-list_item-0800-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "A fire-resistance rating is not required for corridors in an occupancy in Group B that is a space requiring only a single means of egress complying with Section 1006.2." .

    ibc:sem-ibc2021-ch10-list_item-0801-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Corridors adjacent to the exterior walls of buildings shall be permitted to have unprotected openings on unrated exterior walls where unrated walls are permitted by Table 705.5 and unprotected openings are permitted by Table 705.8." .

    ibc:sem-ibc2021-ch10-list_item-0801-condition-1 a ibco:Condition ;
        ibco:text "where unrated walls are permitted by Table 705." .

    ibc:sem-ibc2021-ch10-list_item-0805-condition-1 a ibco:Condition ;
        ibco:text "where allowed." .

    ibc:sem-ibc2021-ch10-list_item-0806-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:sem-ibc2021-ch10-list_item-0806-condition-1 a ibco:Condition ;
        ibco:text "where automatic sprinkler systems are permitted in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0814-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In Group I-3, Condition 2, 3 or 4, occupancies, the dead end in a corridor shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0814-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0815-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In occupancies in Groups B, E, F, I-1, M, R-1, R- 2, S and U, where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, the length of the dead-end corridors shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0815-condition-1 a ibco:Condition ;
        ibco:text "where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-0815-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0816-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A dead-end corridor shall not be limited in length where the length of the dead-end corridor is less than 2.5 times the least width of the dead-end corridor." .

    ibc:sem-ibc2021-ch10-list_item-0816-condition-1 a ibco:Condition ;
        ibco:text "where the length of the dead-end corridor is less than 2." .

    ibc:sem-ibc2021-ch10-list_item-0817-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In Group I-2, Condition 2 occupancies, the length of dead-end corridors that do not serve patient rooms or patient treatment spaces shall not exceed 30 feet (9144 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0817-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-0820-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Use of a corridor as a source of makeup air for exhaust systems in rooms that open directly onto such corridors, including toilet rooms, bathrooms, dressing rooms, smoking lounges and janitor closets, shall be permitted, provided that each such corridor is directly supplied with outdoor air at a rate greater than the rate of makeup air taken from the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0820-condition-1 a ibco:Condition ;
        ibco:text "provided that each such corridor is directly supplied with outdoor air at a rate greater than the rate of makeup air taken from the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0821-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where located within a dwelling unit, the use of corridors for conveying return air shall not be prohibited." .

    ibc:sem-ibc2021-ch10-list_item-0821-condition-1 a ibco:Condition ;
        ibco:text "Where located within a dwelling unit, the use of corridors for conveying return air shall not be prohibited." .

    ibc:sem-ibc2021-ch10-list_item-0822-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where located within tenant spaces of 1,000 square feet (93 m2) or less in area, utilization of corridors for conveying return air is permitted." .

    ibc:sem-ibc2021-ch10-list_item-0822-condition-1 a ibco:Condition ;
        ibco:text "Where located within tenant spaces of 1,000 square feet (93 m2) or less in area, utilization of corridors for conveying return air is permitted." .

    ibc:sem-ibc2021-ch10-list_item-0822-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-ch10-list_item-0825-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The corridor is not required to be of fire-resistance-rated construction." .

    ibc:sem-ibc2021-ch10-list_item-0828-condition-1 a ibco:Condition ;
        ibco:text "where the building is equipped throughout with an automatic sprinkler system." .

    ibc:sem-ibc2021-ch10-list_item-0832-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Foyers, lobbies or reception rooms constructed as required for corridors shall not be construed as intervening rooms." .

    ibc:sem-ibc2021-ch10-list_item-0833-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Enclosed elevator lobbies as permitted by Item 1 of Section 1016.2 shall not be construed as intervening rooms." .

    ibc:sem-ibc2021-ch10-list_item-0842-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:sem-ibc2021-ch10-list_item-0842-condition-1 a ibco:Condition ;
        ibco:text "unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance." .

    ibc:sem-ibc2021-ch10-list_item-0860-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Penetrations of the fire barrier in accordance with Section 1023.5 shall be permitted." .

    ibc:sem-ibc2021-ch10-list_item-0861-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where there are no openings into the exit passageway extension." .

    ibc:sem-ibc2021-ch10-list_item-0861-condition-1 a ibco:Condition ;
        ibco:text "where there are no openings into the exit passageway extension." .

    ibc:sem-ibc2021-ch10-list_item-0862-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where the interior exit stairway and the exit passageway extension are pressurized in accordance with Section 909.20.5." .

    ibc:sem-ibc2021-ch10-list_item-0862-condition-1 a ibco:Condition ;
        ibco:text "where the interior exit stairway and the exit passageway extension are pressurized in accordance with Section 909." .

    ibc:sem-ibc2021-ch10-list_item-0871-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such penetrations shall be protected in accordance with Section 714." .

    ibc:sem-ibc2021-ch10-list_item-0871-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "There shall not be penetrations or communication openings, whether protected or not, between adjacent interior exit stairways and ramps." .

    ibc:sem-ibc2021-ch10-list_item-0875-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such equipment and ductwork shall be located exterior to the building and shall be directly connected to the interior exit stairway and ramp by ductwork enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0876-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0876-condition-1 a ibco:Condition ;
        ibco:text "Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0877-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where located within the building, such equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0877-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures." .

    ibc:sem-ibc2021-ch10-list_item-0877-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The interior exit stairway and ramp ventilation systems shall be independent of other building ventilation systems." .

    ibc:sem-ibc2021-ch10-list_item-0877-condition-1 a ibco:Condition ;
        ibco:text "Where located within the building, such equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0882-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The signs shall be a minimum size of 18 inches (457 mm) by 12 inches (305 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0882-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-ch10-list_item-0882-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-0883-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The letters designating the identification of the interior exit stairway and ramp shall be not less than 11/2 inches (38 mm) in height." .

    ibc:sem-ibc2021-ch10-list_item-0883-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-0884-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The number designating the floor level shall be not less than 5 inches (127 mm) in height and located in the center of the sign." .

    ibc:sem-ibc2021-ch10-list_item-0884-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-ch10-list_item-0885-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Other lettering and numbers shall be not less than 1 inch (25 mm) in height." .

    ibc:sem-ibc2021-ch10-list_item-0885-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-0886-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Characters and their background shall have a nonglare finish." .

    ibc:sem-ibc2021-ch10-list_item-0886-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Characters shall contrast with their background, with either light characters on a dark background or dark characters on a light background." .

    ibc:sem-ibc2021-ch10-list_item-0887-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where signs required by Section 1023.9 are installed in the interior exit stairways and ramps of buildings subject to Section 1025, the signs shall be made of the same materials as required by Section 1025.4." .

    ibc:sem-ibc2021-ch10-list_item-0887-condition-1 a ibco:Condition ;
        ibco:text "Where signs required by Section 1023." .

    ibc:sem-ibc2021-ch10-list_item-0893-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Openings in the exit passageway serving a smokeproof enclosure are permitted where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors." .

    ibc:sem-ibc2021-ch10-list_item-0893-condition-1 a ibco:Condition ;
        ibco:text "where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors." .

    ibc:sem-ibc2021-ch10-list_item-0894-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The fire barrier separating the smokeproof enclosure from the exit passageway is not required, provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0894-condition-1 a ibco:Condition ;
        ibco:text "provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0895-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A smokeproof enclosure shall be permitted to egress through areas on the level of exit discharge or vestibules as permitted by Section 1028." .

    ibc:sem-ibc2021-ch10-list_item-0914-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such penetrations shall be protected in accordance with Section 714." .

    ibc:sem-ibc2021-ch10-list_item-0914-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "There shall not be penetrations or communicating openings, whether protected or not, between adjacent exit passageways." .

    ibc:sem-ibc2021-ch10-list_item-0917-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The equipment and ductwork shall be located exterior to the building and shall be directly connected to the exit passageway by ductwork enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0918-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0918-condition-1 a ibco:Condition ;
        ibco:text "Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0919-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where located within the building, the equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0919-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures." .

    ibc:sem-ibc2021-ch10-list_item-0919-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageway ventilation systems shall be independent of other building ventilation systems." .

    ibc:sem-ibc2021-ch10-list_item-0919-condition-1 a ibco:Condition ;
        ibco:text "Where located within the building, the equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0948-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "ASTM E2072, except that the charging source shall be 1 footcandle (11 lux) of fluorescent illumination for 60 minutes, and the minimum luminance shall be 30 milicandelas per square meter at 10 minutes and 5 milicandelas per square meter after 90 minutes." .

    ibc:sem-ibc2021-ch10-list_item-0953-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Horizontal exits are permitted to comprise twothirds of the required exits from any building or floor area for occupancies in Group I-2." .

    ibc:sem-ibc2021-ch10-list_item-0954-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Horizontal exits are permitted to comprise 100 percent of the exits required for occupancies in Group I-3." .

    ibc:sem-ibc2021-ch10-list_item-0954-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Not less than 6 square feet (0.6 m2) of accessible space per occupant shall be provided on each side of the horizontal exit for the total number of people in adjoining compartments." .

    ibc:sem-ibc2021-ch10-list_item-0954-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-ch10-list_item-0954-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-ch10-list_item-0956-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Duct and air transfer openings in a fire wall or fire barrier that serves as a horizontal exit shall also comply with Section 717." .

    ibc:sem-ibc2021-ch10-list_item-0956-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The horizontal exit separation shall extend vertically through all levels of the building unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings." .

    ibc:sem-ibc2021-ch10-list_item-0956-condition-1 a ibco:Condition ;
        ibco:text "unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings." .

    ibc:sem-ibc2021-ch10-list_item-0973-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:sem-ibc2021-ch10-list_item-0973-condition-1 a ibco:Condition ;
        ibco:text "unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance." .

    ibc:sem-ibc2021-ch10-list_item-0977-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Separation from the interior of the building is not required for occupancies, other than those in Group R-1 or R-2, in buildings that are not more than two stories above grade plane where a level of exit discharge serving such occupancies is the first story above grade plane." .

    ibc:sem-ibc2021-ch10-list_item-0977-condition-1 a ibco:Condition ;
        ibco:text "where a level of exit discharge serving such occupancies is the first story above grade plane." .

    ibc:sem-ibc2021-ch10-list_item-0977-condition-2 a ibco:Condition ;
        ibco:text "other than those in Group R-1 or R-2, in buildings that are not more than two stories above grade plane where a level of exit discharge serving such occupancies is the first story above grade plane." .

    ibc:sem-ibc2021-ch10-list_item-0978-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Separation from the interior of the building is not required where the exterior exit stairway or ramp is served by an exterior exit ramp or balcony that connects two remote exterior exit stairways or other approved exits with a perimeter that is not less than 50 percent open." .

    ibc:sem-ibc2021-ch10-list_item-0978-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "To be considered open, the opening shall be not less than 50 percent of the height of the enclosing wall, with the top of the openings not less than 7 feet (2134 mm) above the top of the balcony." .

    ibc:sem-ibc2021-ch10-list_item-0978-condition-1 a ibco:Condition ;
        ibco:text "where the exterior exit stairway or ramp is served by an exterior exit ramp or balcony that connects two remote exterior exit stairways or other approved exits with a perimeter that is not less than 50 percent open." .

    ibc:sem-ibc2021-ch10-list_item-0978-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0978-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0978-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-ch10-list_item-0979-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Separation from the open-ended corridor of the building is not required for exterior exit stairways or ramps, provided that Items 3.1 through 3.5 are met:" .

    ibc:sem-ibc2021-ch10-list_item-0979-condition-1 a ibco:Condition ;
        ibco:text "provided that Items 3." .

    ibc:sem-ibc2021-ch10-list_item-0980-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The building, including open-ended corridors, and stairways and ramps, shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0984-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "At any location in an open-ended corridor where a change of direction exceeding 45 degrees (0.79 rad) occurs, a clear opening of not less than 35 square feet (3.3 m2) or an exterior stairway or ramp shall be provided." .

    ibc:sem-ibc2021-ch10-list_item-0984-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where clear openings are provided, they shall be located so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-ch10-list_item-0984-condition-1 a ibco:Condition ;
        ibco:text "where a change of direction exceeding 45 degrees (0." .

    ibc:sem-ibc2021-ch10-list_item-0984-condition-2 a ibco:Condition ;
        ibco:text "Where clear openings are provided, they shall be located so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-ch10-list_item-0984-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 35.0 .

    ibc:sem-ibc2021-ch10-list_item-0985-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "In Group R-3 occupancies not more than four stories in height, exterior exit stairways and ramps serving individual dwelling units are not required to be separated from the interior of the building where the exterior exit stairway or ramp discharges directly to grade." .

    ibc:sem-ibc2021-ch10-list_item-0985-condition-1 a ibco:Condition ;
        ibco:text "where the exterior exit stairway or ramp discharges directly to grade." .

    ibc:sem-ibc2021-ch10-list_item-0990-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Not more than 50 percent of the number and minimum width or required capacity of interior exit stairways and ramps is permitted to egress through areas, including atriums, on the level of discharge provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0990-condition-1 a ibco:Condition ;
        ibco:text "provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0990-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0991-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Discharge of interior exit stairways and ramps shall be provided with a free and unobstructed path of travel to an exterior exit door and such exit is readily visible and identifiable from the point of termination of the enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0993-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Portions of the level of exit discharge with access to the egress path shall be either equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, or separated from the egress path in accordance with the requirements for the enclosure of interior exit stairways or ramps." .

    ibc:sem-ibc2021-ch10-list_item-0994-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a required interior exit stairway or ramp and an exit access stairway or ramp serve the same floor level and terminate at the same level of exit discharge, the termination of the exit access stairway or ramp and the exit discharge door of the interior exit stairway or ramp shall be separated by a distance of not less than 30 feet (9144 mm) or not less than one-fourth the length of the maximum overall diagonal dimension of the building, whichever is less." .

    ibc:sem-ibc2021-ch10-list_item-0994-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The distance shall be measured in a straight line between the exit discharge door from the interior exit stairway or ramp and the last tread of the exit access stairway or termination of slope of the exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-0994-condition-1 a ibco:Condition ;
        ibco:text "Where a required interior exit stairway or ramp and an exit access stairway or ramp serve the same floor level and terminate at the same level of exit discharge, the termination of the exit access stairway or ramp and the exit discharge door of the interior exit stairway or ramp shall be separated by a distance of not less than 30 feet (9144 mm) or not less than one-fourth the length of the maximum overall diagonal dimension of the building, whichever is less." .

    ibc:sem-ibc2021-ch10-list_item-0994-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-0995-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Not more than 50 percent of the number and minimum width or required capacity of the interior exit stairways and ramps is permitted to egress through a vestibule provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0995-condition-1 a ibco:Condition ;
        ibco:text "provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0995-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-0997-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-ch10-list_item-0997-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-1001-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Horizontal exits complying with Section 1026 shall not be required to discharge directly to the exterior of the building." .

    ibc:sem-ibc2021-ch10-list_item-1006-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The area shall be of a size to accommodate not less than 5 square feet (0.46 m2) for each person." .

    ibc:sem-ibc2021-ch10-list_item-1006-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-ch10-list_item-1007-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The area shall be located on the same lot not less than 50 feet (15 240 mm) away from the building requiring egress." .

    ibc:sem-ibc2021-ch10-list_item-1007-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-1008-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The area shall be permanently maintained and identified as a safe dispersal area." .

    ibc:sem-ibc2021-ch10-list_item-1009-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The area shall be provided with a safe and unobstructed path of travel from the building. **" .

    ibc:sem-ibc2021-ch10-list_item-1023-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT2" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-ch10-list_item-1025-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-ch10-list_item-1032-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings." .

    ibc:sem-ibc2021-ch10-list_item-1032-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.3 .

    ibc:sem-ibc2021-ch10-list_item-1032-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-ch10-list_item-1032-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-ch10-list_item-1033-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Not less than 0.005 inch (0.127 mm) of additional aisle capacity for each occupant shall be provided for each 0.10 inch (2.5 mm) of riser height above 7 inches (178 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1033-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.005 .

    ibc:sem-ibc2021-ch10-list_item-1033-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.1 .

    ibc:sem-ibc2021-ch10-list_item-1033-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-ch10-list_item-1034-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where egress requires stepped aisle descent, not less than 0.075 inch (1.9 mm) of additional aisle capacity for each occupant shall be provided on those portions of aisle capacity that do not have a handrail within a horizontal distance of 30 inches (762 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1034-condition-1 a ibco:Condition ;
        ibco:text "Where egress requires stepped aisle descent, not less than 0." .

    ibc:sem-ibc2021-ch10-list_item-1034-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.075 .

    ibc:sem-ibc2021-ch10-list_item-1034-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-1035-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles, where slopes are steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.22 inch (5.6 mm) of clear aisle capacity for each occupant served." .

    ibc:sem-ibc2021-ch10-list_item-1035-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Level or ramped aisles, where slopes are not steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.20 inch (5.1 mm) of clear aisle capacity for each occupant served." .

    ibc:sem-ibc2021-ch10-list_item-1035-condition-1 a ibco:Condition ;
        ibco:text "where slopes are steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0." .

    ibc:sem-ibc2021-ch10-list_item-1035-condition-2 a ibco:Condition ;
        ibco:text "where slopes are not steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0." .

    ibc:sem-ibc2021-ch10-list_item-1035-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.22 .

    ibc:sem-ibc2021-ch10-list_item-1035-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.2 .

    ibc:sem-ibc2021-ch10-list_item-1042-condition-1 a ibco:Condition ;
        ibco:text "provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:sem-ibc2021-ch10-list_item-1042-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-1043-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-ch10-list_item-1048-condition-1 a ibco:Condition ;
        ibco:text "provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:sem-ibc2021-ch10-list_item-1048-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-1049-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-ch10-list_item-1050-condition-1 a ibco:Condition ;
        ibco:text "where seating and the means of egress in the seating area are essentially open to the outside." .

    ibc:sem-ibc2021-ch10-list_item-1053-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In facilities with smoke-protected assembly seating, the total exit access travel distance shall be not greater than 400 feet (122 m)." .

    ibc:sem-ibc2021-ch10-list_item-1053-atomic-2 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "That portion of the total permitted exit access travel distance from each seat to the nearest entrance to a vomitory or concourse shall not exceed 200 feet (60 960 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1053-atomic-3 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "The portion of the total permitted exit access travel distance from the entrance to the vomitory or concourse to one of the following shall not exceed 200 feet (60 960 mm):" .

    ibc:sem-ibc2021-ch10-list_item-1053-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 400.0 .

    ibc:sem-ibc2021-ch10-list_item-1053-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 200.0 .

    ibc:sem-ibc2021-ch10-list_item-1053-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 200.0 .

    ibc:sem-ibc2021-ch10-list_item-1057-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In facilities with open-air assembly seating of Type III, IV or V construction, the total exit access travel distance to one of the following shall not exceed 400 feet (122 m):" .

    ibc:sem-ibc2021-ch10-list_item-1057-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 400.0 .

    ibc:sem-ibc2021-ch10-list_item-1061-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In facilities with open-air assembly seating of Type I or II construction, the total exit access travel distance shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-1064-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "For areas serving less than 50 occupants, the common path of egress travel shall not exceed 75 feet (22 860 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1064-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 75.0 .

    ibc:sem-ibc2021-ch10-list_item-1065-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "For smoke-protected or open-air assembly seating, the common path of egress travel shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1065-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-ch10-list_item-1074-condition-1 a ibco:Condition ;
        ibco:text "where the stepped aisle is subdivided by a mid-aisle handrail." .

    ibc:sem-ibc2021-ch10-list_item-1077-condition-1 a ibco:Condition ;
        ibco:text "where the aisle serves less than 50 seats." .

    ibc:sem-ibc2021-ch10-list_item-1078-condition-1 a ibco:Condition ;
        ibco:text "where the aisle serves less than 15 seats and does not serve as part of an accessible route." .

    ibc:sem-ibc2021-ch10-list_item-1086-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Dead-end aisles shall be not greater than 20 feet (6096 mm) in length." .

    ibc:sem-ibc2021-ch10-list_item-1086-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-ch10-list_item-1087-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Dead-end aisles longer than 16 rows are permitted where seats beyond the 16th row dead-end aisle are not more than 24 seats from another aisle, measured along a row of seats having a minimum clear width of 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1087-condition-1 a ibco:Condition ;
        ibco:text "where seats beyond the 16th row dead-end aisle are not more than 24 seats from another aisle, measured along a row of seats having a minimum clear width of 12 inches (305 mm) plus 0." .

    ibc:sem-ibc2021-ch10-list_item-1087-condition-2 a ibco:Condition ;
        ibco:text "where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1087-condition-3 a ibco:Condition ;
        ibco:text "where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1087-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-1087-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.6 .

    ibc:sem-ibc2021-ch10-list_item-1088-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "For smoke-protected or open-air assembly seating, the dead-end aisle length of vertical aisles shall not exceed a distance of 21 rows." .

    ibc:sem-ibc2021-ch10-list_item-1089-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "For smoke-protected or open-air assembly seating, a longer dead-end aisle is permitted where seats beyond the 21-row dead-end aisle are not more than 40 seats from another aisle, measured along a row of seats having an aisle accessway with a minimum clear width of 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1089-condition-1 a ibco:Condition ;
        ibco:text "where seats beyond the 21-row dead-end aisle are not more than 40 seats from another aisle, measured along a row of seats having an aisle accessway with a minimum clear width of 12 inches (305 mm) plus 0." .

    ibc:sem-ibc2021-ch10-list_item-1089-condition-2 a ibco:Condition ;
        ibco:text "where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1089-condition-3 a ibco:Condition ;
        ibco:text "where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1089-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-list_item-1089-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.3 .

    ibc:sem-ibc2021-ch10-list_item-1100-condition-1 a ibco:Condition ;
        ibco:text "where the treads on the descending side of the transition have greater depth." .

    ibc:sem-ibc2021-ch10-list_item-1100-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-ch10-list_item-1101-condition-1 a ibco:Condition ;
        ibco:text "where the treads on the descending side of the transition have lesser depth." .

    ibc:sem-ibc2021-ch10-list_item-1101-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-ch10-list_item-1133-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Riser height nonuniformity shall be limited to the extent necessitated by changes in the gradient of the adjoining seating area to maintain adequate sightlines." .

    ibc:sem-ibc2021-ch10-list_item-1133-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where nonuniformities exceed 3/16 inch (4.8 mm) between adjacent risers, the exact location of such nonuniformities shall be indicated with a distinctive marking stripe on each tread at the nosing or leading edge adjacent to the nonuniform risers." .

    ibc:sem-ibc2021-ch10-list_item-1133-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide." .

    ibc:sem-ibc2021-ch10-list_item-1133-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The edge marking stripe shall be distinctively different from the contrasting marking stripe." .

    ibc:sem-ibc2021-ch10-list_item-1133-condition-1 a ibco:Condition ;
        ibco:text "Where nonuniformities exceed 3/16 inch (4." .

    ibc:sem-ibc2021-ch10-list_item-1133-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-ch10-list_item-1133-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-list_item-1133-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-list_item-1134-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Riser heights not exceeding 9 inches (229 mm) shall be permitted where they are necessitated by the slope of the adjacent seating areas to maintain sightlines." .

    ibc:sem-ibc2021-ch10-list_item-1134-condition-1 a ibco:Condition ;
        ibco:text "where they are necessitated by the slope of the adjacent seating areas to maintain sightlines." .

    ibc:sem-ibc2021-ch10-list_item-1134-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 9.0 .

    ibc:sem-ibc2021-ch10-list_item-1141-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with 200 or fewer seats, the seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1142-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In a building, room or space used for assembly purposes or portions thereof with seating at tables and without ramped or tiered floors for seating, the seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1143-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with greater than 200 seats, the seats shall be fastened together in groups of not less than three or the seats shall be securely fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1144-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In a building, room or space used for assembly purposes where flexibility of the seating arrangement is an integral part of the design and function of the space and seating is on tiered levels, not more than 200 seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1144-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Plans showing seating, tiers and aisles shall be submitted for approval." .

    ibc:sem-ibc2021-ch10-list_item-1144-condition-1 a ibco:Condition ;
        ibco:text "where flexibility of the seating arrangement is an integral part of the design and function of the space and seating is on tiered levels, not more than 200 seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1145-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Groups of seats within a building, room or space used for assembly purposes separated from other seating by railings, guards, partial height walls or similar barriers with level floors and having not more than 14 seats per group shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1146-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Seats intended for musicians or other performers and separated by railings, guards, partial height walls or similar barriers shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1149-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrails are not required for ramped aisles with seating on both sides." .

    ibc:sem-ibc2021-ch10-list_item-1150-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrails are not required where, at the side of the aisle, there is a guard with a top surface that complies with the graspability requirements of handrails in accordance with Section 1014.3." .

    ibc:sem-ibc2021-ch10-list_item-1150-condition-1 a ibco:Condition ;
        ibco:text "where, at the side of the aisle, there is a guard with a top surface that complies with the graspability requirements of handrails in accordance with Section 1014." .

    ibc:sem-ibc2021-ch10-list_item-1151-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrail extensions are not required at the top and bottom of stepped aisles and ramped aisles to permit crossovers within the aisles." .

    ibc:sem-ibc2021-ch10-list_item-1160-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards that impact sightlines shall be permitted to comply with Section 1030.17.3." .

    ibc:sem-ibc2021-ch10-list_item-1161-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Bleachers, grandstands and folding and telescopic seating shall not be required to have perimeter guards where the seating is located adjacent to a wall and the space between the wall and the seating is less than 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1161-condition-1 a ibco:Condition ;
        ibco:text "where the seating is located adjacent to a wall and the space between the wall and the seating is less than 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1161-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-ch10-list_item-1169-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Group R-2 occupancies located in stories with only one exit or access to only one exit as permitted by Tables 1006.3.4(1) and 1006.3.4(2)." .

    ibc:sem-ibc2021-ch10-list_item-1170-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Basements and sleeping rooms below the fourth story above grade plane shall have not fewer than one emergency escape and rescue opening in accordance with this section." .

    ibc:sem-ibc2021-ch10-list_item-1170-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where basements contain one or more sleeping rooms, an emergency escape and rescue opening shall be required in each sleeping room, but shall not be required in adjoining areas of the basement." .

    ibc:sem-ibc2021-ch10-list_item-1170-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such openings shall open directly into a public way or to a yard or court that opens to a public way." .

    ibc:sem-ibc2021-ch10-list_item-1170-condition-1 a ibco:Condition ;
        ibco:text "Where basements contain one or more sleeping rooms, an emergency escape and rescue opening shall be required in each sleeping room, but shall not be required in adjoining areas of the basement." .

    ibc:sem-ibc2021-ch10-list_item-1172-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Basements with a ceiling height of less than 80 inches (2032 mm) shall not be required to have emergency escape and rescue openings." .

    ibc:sem-ibc2021-ch10-list_item-1172-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-ch10-list_item-1173-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Emergency escape and rescue openings are not required from basements or sleeping rooms that have an exit door or exit access door that opens directly into a public way or to a yard, court or exterior egress balcony that opens to a public way." .

    ibc:sem-ibc2021-ch10-list_item-1174-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Basements without habitable spaces and having not more than 200 square feet (18.6 m2) in floor area shall not be required to have emergency escape and rescue openings." .

    ibc:sem-ibc2021-ch10-list_item-1174-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 200.0 .

    ibc:sem-ibc2021-ch10-list_item-1175-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Storm shelters are not required to comply with this section where the shelter is constructed in accordance with ICC 500." .

    ibc:sem-ibc2021-ch10-list_item-1175-condition-1 a ibco:Condition ;
        ibco:text "where the shelter is constructed in accordance with ICC 500." .

    ibc:sem-ibc2021-ch10-list_item-1176-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Within individual dwelling and sleeping units in Groups R-2 and R-3, where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1, 903.3.1.2 or 903.3.1.3, sleeping rooms in basements shall not be required to have emergency escape and rescue openings provided that the basement has one of the following:" .

    ibc:sem-ibc2021-ch10-list_item-1176-condition-1 a ibco:Condition ;
        ibco:text "where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-list_item-1176-condition-2 a ibco:Condition ;
        ibco:text "provided that the basement has one of the following:" .

    ibc:concept-exception-for-smoke-protected-or-open-air-assembly-seating-the-row-length-limits-for-a-12-inch-wide-305-mm-aisle-accessway-beyond-which-the-aisle-accessway-minimum-clear-width a ibco:DomainConcept ;
        rdfs:label "Exception: For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width" .

    ibc:concept-exception-nonpublic-aisles-serving-less-than-50-people-and a ibco:DomainConcept ;
        rdfs:label "Exception: Nonpublic aisles serving less than 50 people and" .

    ibc:concept-the-area a ibco:DomainConcept ;
        rdfs:label "The area" .

    ibc:concept-the-delay-electronics-of-the-delayed-egress-locking-system a ibco:DomainConcept ;
        rdfs:label "The delay electronics of the delayed egress locking system" .

    ibc:concept-the-delayed-egress-locking-system a ibco:DomainConcept ;
        rdfs:label "The delayed egress locking system" .

    ibc:concept-there a ibco:DomainConcept ;
        rdfs:label "There" .

    ibc:concept-toiletroom a ibco:ToiletRoom ;
        rdfs:label "ToiletRoom" .

    ibc:concept-ramped-aisles a ibco:DomainConcept ;
        rdfs:label "Ramped aisles" .

    ibc:concept-standpipes-and-standpipe-hose-connections a ibco:DomainConcept ;
        rdfs:label "Standpipes and standpipe hose connections" .

    ibc:concept-wheelchairspace a ibco:WheelchairSpace ;
        rdfs:label "WheelchairSpace" .

    ibc:concept-emergency-escape-and-rescue-openings a ibco:DomainConcept ;
        rdfs:label "Emergency escape and rescue openings" .

    ibc:concept-exception-the-minimum-width-of-1-inch-25-mm a ibco:DomainConcept ;
