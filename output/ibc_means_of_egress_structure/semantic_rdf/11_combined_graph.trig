    ibc:sem-ibc2021-ch10-exception-0099 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0099 ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0099-atomic-1 ;
