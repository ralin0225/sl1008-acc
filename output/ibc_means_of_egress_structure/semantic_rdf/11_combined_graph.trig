        ibco:sourceNode ibc:ibc2021-ch10-exception-1182 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: The minimum net clear opening for gradefloor emergency escape and rescue openings shall be 5 square feet (0.46 m2)." .

    ibc:sem-ibc2021-ch10-exception-1188 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-1188 ;
