    ibc:ibc2021-ch10-list_item-0348 a ibco:ListItem ;
        ibco:bbox "[351.121, 478.805, 565.315, 544.77]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0349,
            ibc:ibc2021-ch10-list_item-0350,
            ibc:ibc2021-ch10-list_item-0351,
            ibc:ibc2021-ch10-list_item-0355,
            ibc:ibc2021-ch10-list_item-0356 ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0349 ;
        ibco:sourcePage 318 ;
        ibco:text "8. Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:" .

    ibc:ibc2021-ch10-list_item-0979 a ibco:ListItem ;
        ibco:bbox "[346.2, 534.819, 565.233, 578.832]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0980,
            ibc:ibc2021-ch10-list_item-0981,
            ibc:ibc2021-ch10-list_item-0982,
            ibc:ibc2021-ch10-list_item-0983,
            ibc:ibc2021-ch10-list_item-0984 ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0976 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0980 ;
        ibco:sourcePage 344 ;
        ibco:text "3. Separation from the open-ended corridor of the building is not required for exterior exit stairways or ramps, provided that Items 3.1 through 3.5 are met:" .

    ibc:ibc2021-1006.2.2 a ibco:Provision ;
        ibco:bbox "[334.203, 518.153, 565.268, 562.166]" ;
        ibco:hasChild ibc:ibc2021-1006.2.2.1,
            ibc:ibc2021-1006.2.2.2,
            ibc:ibc2021-1006.2.2.3,
            ibc:ibc2021-1006.2.2.4,
            ibc:ibc2021-1006.2.2.5,
            ibc:ibc2021-1006.2.2.6 ;
        ibco:heading "Egress based on use" ;
        ibco:label "1006.2.2" ;
        ibco:partOf ibc:ibc2021-1006.2 ;
        ibco:precedes ibc:ibc2021-1006.2.2.1 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.2.2 Egress based on use. The numbers, configuration and types of components of exits or access to exits shall be provided in the uses described in Sections 1006.2.2.1 through 1006.2.2.6." .

    ibc:ibc2021-1006.3.4 a ibco:Provision ;
        ibco:bbox "[334.199, 165.725, 565.277, 198.822]" ;
        ibco:hasChild ibc:ibc2021-1006.3.4.1,
            ibc:ibc2021-ch10-list_item-0123,
            ibc:ibc2021-ch10-list_item-0124,
            ibc:ibc2021-ch10-list_item-0125,
            ibc:ibc2021-ch10-list_item-0126,
            ibc:ibc2021-ch10-list_item-0127 ;
        ibco:heading "Single exits" ;
        ibco:label "1006.3.4" ;
        ibco:partOf ibc:ibc2021-1006.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0123 ;
        ibco:sourcePage 310 ;
        ibco:text "1006.3.4 Single exits. A single exit or access to a single exit shall be permitted from any story or occupied roof where one of the following conditions exists:" .

    ibc:ibc2021-1006.3.4.1 a ibco:Provision ;
        ibco:bbox "[150.716, 78.509, 446.232, 87.347]",
            "[263.639, 69.511, 333.361, 78.35]",
            "[346.199, 499.743, 565.398, 708.81]",
            "[46.195, 142.7, 133.107, 168.385]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0131,
            ibc:ibc2021-ch10-list_item-0132,
            ibc:ibc2021-ch10-list_item-0133,
            ibc:ibc2021-ch10-list_item-0134,
            ibc:ibc2021-ch10-list_item-0135,
            ibc:ibc2021-ch10-list_item-0136 ;
        ibco:heading "Mixed occupancies" ;
        ibco:label "1006.3.4.1" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0131 ;
        ibco:sourcePage 310,
            311 ;
        ibco:text "1006.3.4.1 Mixed occupancies. Where one exit, or exit access stairway or ramp providing access to exits at other stories, is permitted to serve individual stories, mixed occupancies shall be permitted to be served by single exits provided that each individual occupancy complies with the applicable requirements of Table 1006.3.4(1) or 1006.3.4(2) for that occupancy. Where applicable, cumulative occupant loads from adjacent occupancies shall be considered to be in accordance with the provisions of Section 1004.1. In each story of a mixed occupancy building, the maximum number of occupants served by a single exit shall be such that the sum of the ratios of the calculated number of occupants of the space divided by the allowable number of occupants indicated in Table 1006.3.4(2) for each occupancy does not exceed one. Where dwelling units are located on a story with other occupancies, the actual number of dwelling units divided by four plus the ratio from the other occupancy does not exceed one. TABLE 1006.3.4(1) STORIES WITH ONE EXIT OR ACCESS TO ONE EXIT FOR R-2 OCCUPANCIES For SI: 1 foot = 304.8 mm. NP = Not Permitted. NA = Not Applicable." .

    ibc:ibc2021-1010.1.3 a ibco:Provision ;
        ibco:bbox "[334.198, 638.652, 565.219, 660.714]" ;
        ibco:hasChild ibc:ibc2021-1010.1.3.1,
            ibc:ibc2021-1010.1.3.2,
            ibc:ibc2021-ch10-list_item-0299,
            ibc:ibc2021-ch10-list_item-0300,
            ibc:ibc2021-ch10-list_item-0301,
            ibc:ibc2021-ch10-list_item-0302 ;
        ibco:heading "Forces to unlatch and open doors" ;
        ibco:label "1010.1.3" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0299 ;
        ibco:sourcePage 316 ;
        ibco:text "1010.1.3 Forces to unlatch and open doors. The forces to unlatch doors shall comply with the following:" .

    ibc:ibc2021-1010.2.11 a ibco:Provision ;
        ibco:bbox "[334.197, 106.69, 565.275, 161.619]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0393,
            ibc:ibc2021-ch10-list_item-0394,
            ibc:ibc2021-ch10-list_item-0395,
            ibc:ibc2021-ch10-list_item-0396,
            ibc:ibc2021-ch10-list_item-0397,
            ibc:ibc2021-ch10-list_item-0398 ;
        ibco:label "1010.2.11" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0393 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.11 Door hardware release of electrically locked egress doors. Door hardware release of electric locking systems shall be permitted on doors in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following:" .

    ibc:ibc2021-1010.5.2 a ibco:Provision ;
        ibco:bbox "[334.196, 209.723, 565.247, 264.772]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0502,
            ibc:ibc2021-ch10-list_item-0492,
            ibc:ibc2021-ch10-list_item-0493,
            ibc:ibc2021-ch10-list_item-0494,
            ibc:ibc2021-ch10-list_item-0495,
            ibc:ibc2021-ch10-list_item-0496 ;
        ibco:heading "Security access turnstiles" ;
        ibco:label "1010.5.2" ;
        ibco:partOf ibc:ibc2021-1010.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0492 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.5.2 Security access turnstiles. Security access turnstiles that inhibit travel in the direction of egress utilizing a physical barrier shall be permitted to be considered as a component of the means of egress, provided that all of the following criteria are met:" .

    ibc:ibc2021-1011.16 a ibco:Provision ;
        ibco:bbox "[322.197, 507.845, 565.305, 584.845]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0597,
            ibc:ibc2021-ch10-list_item-0598,
            ibc:ibc2021-ch10-list_item-0599,
            ibc:ibc2021-ch10-list_item-0600,
            ibc:ibc2021-ch10-list_item-0601,
            ibc:ibc2021-ch10-list_item-0602 ;
        ibco:heading "Ladders" ;
        ibco:label "1011.16" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0597 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.16 Ladders. Permanent ladders shall not serve as a part of the means of egress from occupied spaces within a building. Permanent ladders shall be constructed in accordance with Section 306.5 of the International Mechanical Code and designed for the live loads indicated in Section 1607.17. Permanent ladders shall be permitted to provide access to the following areas:" .

    ibc:ibc2021-1013 a ibco:Section ;
        ibco:bbox "[147.962, 409.621, 217.436, 431.772]" ;
        ibco:hasChild ibc:ibc2021-1013.1,
            ibc:ibc2021-1013.2,
            ibc:ibc2021-1013.3,
            ibc:ibc2021-1013.4,
            ibc:ibc2021-1013.5,
            ibc:ibc2021-1013.6 ;
        ibco:heading "EXIT SIGNS" ;
        ibco:label "1013" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1013.1 ;
        ibco:sourcePage 330 ;
        ibco:text "SECTION 1013 EXIT SIGNS" .

    ibc:ibc2021-1023.9.1 a ibco:Provision ;
        ibco:bbox "[334.181, 69.64, 565.291, 91.701]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0882,
            ibc:ibc2021-ch10-list_item-0883,
            ibc:ibc2021-ch10-list_item-0884,
            ibc:ibc2021-ch10-list_item-0885,
            ibc:ibc2021-ch10-list_item-0886,
            ibc:ibc2021-ch10-list_item-0887 ;
