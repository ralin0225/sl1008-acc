        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0974 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Exterior exit stairways and ramps serving individual dwelling units of Group R-3 shall have a minimum fire separation distance of 5 feet (1525 mm)." .

    ibc:sem-ibc2021-ch10-exception-0976 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0976 ;
