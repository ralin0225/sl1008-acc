    ibc:sem-ibc2021-ch10-exception-0564 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0564 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-stairway ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0564-atomic-1 ;
