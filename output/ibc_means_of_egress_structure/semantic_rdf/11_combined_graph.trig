    ibc:ibc2021-ch10-exception-0989 a ibco:Exception ;
        ibco:bbox "[58.768, 438.77, 108.766, 449.796]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0990,
            ibc:ibc2021-ch10-list_item-0995 ;
        ibco:partOf ibc:ibc2021-1028.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0990 ;
        ibco:sourcePage 345 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0999 a ibco:Exception ;
        ibco:bbox "[391.801, 539.646, 550.762, 561.708]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1000,
            ibc:ibc2021-ch10-list_item-1001 ;
        ibco:partOf ibc:ibc2021-1028.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1000 ;
        ibco:sourcePage 345 ;
        ibco:text "Exception: The maximum transmitted temperature rise is not required." .

    ibc:ibc2021-ch10-exception-1015 a ibco:Exception ;
        ibco:bbox "[73.196, 545.764, 123.194, 556.79]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1016,
            ibc:ibc2021-ch10-list_item-1017 ;
        ibco:partOf ibc:ibc2021-1029.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1016 ;
        ibco:sourcePage 346 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1041 a ibco:Exception ;
        ibco:bbox "[343.804, 353.731, 393.802, 364.757]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1042,
            ibc:ibc2021-ch10-list_item-1043 ;
        ibco:partOf ibc:ibc2021-1030.6.2.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1042 ;
        ibco:sourcePage 347 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1063 a ibco:Exception ;
        ibco:bbox "[73.212, 677.697, 123.21, 688.723]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1064,
            ibc:ibc2021-ch10-list_item-1065 ;
        ibco:partOf ibc:ibc2021-1030.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1064 ;
        ibco:sourcePage 348 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1073 a ibco:Exception ;
        ibco:bbox "[370.178, 420.793, 565.152, 464.806]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1074,
            ibc:ibc2021-ch10-list_item-1075 ;
        ibco:partOf ibc:ibc2021-1030.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1074 ;
        ibco:sourcePage 348 ;
        ibco:text "Exception: Twenty-three inches (584 mm) between a stepped aisle handrail and seating where a stepped aisle does not serve more than five rows on one side." .

    ibc:ibc2021-ch10-exception-1159 a ibco:Exception ;
        ibco:bbox "[346.195, 651.695, 396.073, 662.72]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1160,
            ibc:ibc2021-ch10-list_item-1161 ;
        ibco:partOf ibc:ibc2021-1030.17.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1160 ;
        ibco:sourcePage 352 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-list_item-0079 a ibco:ListItem ;
        ibco:bbox "[97.181, 405.755, 304.251, 449.769]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0080,
            ibc:ibc2021-ch10-list_item-0081 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0078 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0080 ;
        ibco:sourcePage 308 ;
        ibco:text "1. Surface-mounted latch release hardware shall be exempt from inclusion in the 7-inch maximum (178 mm) encroachment where both of the following conditions exist:" .

    ibc:ibc2021-ch10-list_item-0127 a ibco:ListItem ;
        ibco:bbox "[346.221, 346.778, 565.391, 390.791]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0128,
            ibc:ibc2021-ch10-list_item-0129 ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0128 ;
        ibco:sourcePage 310 ;
        ibco:text "5. Individual single-story or multistory dwelling units shall be permitted to have a single exit or access to a single exit from the dwelling unit provided that both of the following criteria are met:" .

    ibc:ibc2021-ch10-list_item-0324 a ibco:ListItem ;
        ibco:bbox "[343.801, 699.823, 550.834, 732.8]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0325,
            ibc:ibc2021-ch10-list_item-0326 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0323 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0325 ;
        ibco:sourcePage 317 ;
        ibco:text "1. The minimum distance between horizontal sliding power-operated doors in a series shall be 48 inches (1219 mm)." .

    ibc:ibc2021-ch10-list_item-0498 a ibco:ListItem ;
        ibco:bbox "[372.592, 528.742, 565.26, 616.658]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0499,
            ibc:ibc2021-ch10-list_item-0500 ;
        ibco:label "5.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0496 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0499 ;
        ibco:sourcePage 324 ;
        ibco:text "5.2. Upon actuation of a clearly identified manual release device with ready access that results in direct interruption of power to each secured physical barrier, after which such barriers remain in the open position for not less than 30 seconds. The manual release device shall be positioned at one of the following locations:" .

    ibc:ibc2021-ch10-list_item-1176 a ibco:ListItem ;
        ibco:bbox "[331.797, 287.756, 550.955, 375.792]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1177,
            ibc:ibc2021-ch10-list_item-1178 ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1171 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1177 ;
        ibco:sourcePage 353 ;
        ibco:text "5. Within individual dwelling and sleeping units in Groups R-2 and R-3, where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1, 903.3.1.2 or 903.3.1.3, sleeping rooms in basements shall not be required to have emergency escape and rescue openings provided that the basement has one of the following:" .

    ibc:ibc2021-1004.2 a ibco:Provision ;
        ibco:bbox "[307.799, 491.752, 550.87, 535.765]" ;
        ibco:hasChild ibc:ibc2021-1004.2.1,
            ibc:ibc2021-1004.2.2,
            ibc:ibc2021-1004.2.3 ;
        ibco:heading "Cumulative occupant loads" ;
        ibco:label "1004.2" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1004.2.1 ;
        ibco:sourcePage 305 ;
        ibco:text "1004.2 Cumulative occupant loads. Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section." .

    ibc:ibc2021-1005.7 a ibco:Provision ;
        ibco:bbox "[61.176, 305.697, 304.238, 338.794]" ;
        ibco:hasChild ibc:ibc2021-1005.7.1,
            ibc:ibc2021-1005.7.2,
            ibc:ibc2021-1005.7.3 ;
        ibco:heading "Encroachment" ;
        ibco:label "1005.7" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.7.1 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.7 Encroachment. Encroachments into the required means of egress width shall be in accordance with the provisions of this section." .

    ibc:ibc2021-1006 a ibco:Section ;
        ibco:bbox "[379.551, 69.559, 507.986, 102.746]" ;
        ibco:hasChild ibc:ibc2021-1006.1,
            ibc:ibc2021-1006.2,
            ibc:ibc2021-1006.3 ;
        ibco:heading "NUMBER OF EXITS AND" ;
        ibco:label "1006" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1006.1 ;
        ibco:sourcePage 308 ;
        ibco:text "SECTION 1006 NUMBER OF EXITS AND EXIT ACCESS DOORWAYS" .

    ibc:ibc2021-1007.1 a ibco:Provision ;
        ibco:bbox "[46.798, 458.756, 289.863, 502.77]" ;
        ibco:hasChild ibc:ibc2021-1007.1.1,
            ibc:ibc2021-1007.1.2,
            ibc:ibc2021-1007.1.3 ;
        ibco:heading "General" ;
        ibco:label "1007.1" ;
        ibco:partOf ibc:ibc2021-1007 ;
        ibco:precedes ibc:ibc2021-1007.1.1 ;
        ibco:sourcePage 311 ;
        ibco:text "1007.1 General. Exits, exit access doorways, and exit access stairways and ramps serving spaces, including individual building stories, shall be separated in accordance with the provisions of this section." .

    ibc:ibc2021-1007.1.1.1 a ibco:Provision ;
        ibco:bbox "[331.773, 458.677, 550.823, 491.774]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0144,
            ibc:ibc2021-ch10-list_item-0145,
            ibc:ibc2021-ch10-list_item-0146 ;
        ibco:heading "Measurement point" ;
        ibco:label "1007.1.1.1" ;
        ibco:partOf ibc:ibc2021-1007.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0144 ;
        ibco:sourcePage 311 ;
        ibco:text "1007.1.1.1 Measurement point. The separation distance required in Section 1007.1.1 shall be measured in accordance with the following:" .

    ibc:ibc2021-1008 a ibco:Section ;
        ibco:bbox "[96.842, 145.65, 268.356, 167.681]" ;
        ibco:hasChild ibc:ibc2021-1008.1,
            ibc:ibc2021-1008.2,
            ibc:ibc2021-1008.3 ;
        ibco:heading "MEANS OF EGRESS ILLUMINATION" ;
        ibco:label "1008" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1008.1 ;
        ibco:sourcePage 312 ;
        ibco:text "SECTION 1008 MEANS OF EGRESS ILLUMINATION" .

    ibc:ibc2021-1008.3.1 a ibco:Provision ;
        ibco:bbox "[334.207, 253.8, 565.263, 297.813]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0169,
            ibc:ibc2021-ch10-list_item-0170,
            ibc:ibc2021-ch10-list_item-0171 ;
        ibco:heading "General" ;
        ibco:label "1008.3.1" ;
        ibco:partOf ibc:ibc2021-1008.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0169 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.3.1 General. In the event of power supply failure in rooms and spaces that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:ibc2021-1009.10 a ibco:Provision ;
        ibco:bbox "[307.797, 260.761, 550.808, 304.774]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0262,
            ibc:ibc2021-ch10-list_item-0263,
            ibc:ibc2021-ch10-list_item-0264 ;
        ibco:heading "Directional signage" ;
        ibco:label "1009.10" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0262 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.10 Directional signage. Directional signage indicating the location of all other means of egress and which of those are accessible means of egress shall be provided at the following:" .

    ibc:ibc2021-1009.11 a ibco:Provision ;
        ibco:bbox "[307.777, 362.751, 550.855, 417.8]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0266,
            ibc:ibc2021-ch10-list_item-0267,
            ibc:ibc2021-ch10-list_item-0268 ;
        ibco:heading "Instructions" ;
        ibco:label "1009.11" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0266 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.11 Instructions. In areas of refuge and exterior areas for assisted rescue, instructions on the use of the area under emergency conditions shall be posted. Signage shall comply with the ICC A117.1 requirements for visual characters. The instructions shall include all of the following:" .

    ibc:ibc2021-1009.3 a ibco:Provision ;
        ibco:bbox "[307.805, 249.806, 550.875, 282.784]" ;
        ibco:hasChild ibc:ibc2021-1009.3.1,
            ibc:ibc2021-1009.3.2,
            ibc:ibc2021-1009.3.3 ;
        ibco:heading "Stairways" ;
        ibco:label "1009.3" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-1009.3.1 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.3 Stairways. In order to be considered part of an accessible means of egress, a stairway between stories shall comply with Sections 1009.3.1 through 1009.3.3." .

    ibc:ibc2021-1009.8 a ibco:Provision ;
        ibco:bbox "[46.787, 213.687, 289.845, 268.736]" ;
        ibco:hasChild ibc:ibc2021-1009.8.1,
            ibc:ibc2021-1009.8.2,
            ibc:ibc2021-ch10-exception-0249 ;
        ibco:heading "Two-way communication" ;
        ibco:label "1009.8" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0249 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.8 Two-way communication. A two-way communication system complying with Sections 1009.8.1 and 1009.8.2 shall be provided at the landing serving each elevator or bank of elevators on each accessible floor that is one or more stories above or below the level of exit discharge." .

    ibc:ibc2021-1010.2.15 a ibco:Provision ;
        ibco:bbox "[334.201, 69.565, 565.236, 91.627]",
            "[73.199, 660.711, 304.263, 726.677]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0444,
            ibc:ibc2021-ch10-list_item-0445,
            ibc:ibc2021-ch10-list_item-0446 ;
        ibco:label "1010.2.15" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0444 ;
        ibco:sourcePage 322 ;
        ibco:text "1010.2.15 Locking arrangements in buildings within correctional facilities. In buildings within correctional and detention facilities, doors in means of egress serving rooms or spaces occupied by persons whose movements are controlled for security reasons shall be permitted to be locked where equipped with egress control devices that shall unlock manually and by not less than one of the following means:" .

    ibc:ibc2021-1010.3.1.1 a ibco:Provision ;
        ibco:bbox "[70.799, 312.845, 289.752, 345.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0457,
            ibc:ibc2021-ch10-list_item-0458,
            ibc:ibc2021-ch10-list_item-0459 ;
        ibco:heading "Egress component" ;
        ibco:label "1010.3.1.1" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0457 ;
        ibco:sourcePage 323 ;
        ibco:text "1010.3.1.1 Egress component. A revolving door used as a component of a means of egress shall comply with Section 1010.3.1 and the following three conditions:" .

    ibc:ibc2021-1011.12 a ibco:Provision ;
        ibco:bbox "[61.197, 239.742, 304.265, 283.755]" ;
        ibco:hasChild ibc:ibc2021-1011.12.1,
            ibc:ibc2021-1011.12.2,
            ibc:ibc2021-ch10-exception-0584 ;
        ibco:heading "Stairway to roof" ;
        ibco:label "1011.12" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0584 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.12 Stairway to roof. In buildings four or more stories above grade plane, one stairway shall extend to the roof surface unless the roof has a slope steeper than four units vertical in 12 units horizontal (33-percent slope)." .

    ibc:ibc2021-1011.5.5 a ibco:Provision ;
        ibco:bbox "[334.18, 117.651, 565.281, 194.734]" ;
        ibco:hasChild ibc:ibc2021-1011.5.5.1,
            ibc:ibc2021-1011.5.5.2,
            ibc:ibc2021-1011.5.5.3 ;
        ibco:heading "Nosing and riser profile" ;
        ibco:label "1011.5.5" ;
        ibco:partOf ibc:ibc2021-1011.5 ;
        ibco:precedes ibc:ibc2021-1011.5.5.1 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.5 Nosing and riser profile. Nosings shall have a curvature or bevel of not less than 1/16 inch (1.6 mm) but not more than 9/16 inch (14.3 mm) from the foremost projection of the tread. Risers shall be solid and vertical or sloped under the tread above from the underside of the nosing above at an angle not more than 30 degrees (0.52 rad) from the vertical." .

    ibc:ibc2021-1012.10 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.198, 102.822]" ;
        ibco:hasChild ibc:ibc2021-1012.10.1,
            ibc:ibc2021-1012.10.2,
            ibc:ibc2021-ch10-exception-0632 ;
        ibco:heading "Edge protection" ;
        ibco:label "1012.10" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0632 ;
        ibco:sourcePage 330 ;
        ibco:text "1012.10 Edge protection. Edge protection complying with Section 1012.10.1 or 1012.10.2 shall be provided on each side of ramp runs and at each side of ramp landings." .

    ibc:ibc2021-1012.5 a ibco:Provision ;
        ibco:bbox "[46.797, 457.737, 289.891, 490.714]" ;
        ibco:hasChild ibc:ibc2021-1012.5.1,
            ibc:ibc2021-1012.5.2,
            ibc:ibc2021-1012.5.3 ;
        ibco:heading "Minimum dimensions" ;
        ibco:label "1012.5" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.5.1 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.5 Minimum dimensions. The minimum dimensions of means of egress ramps shall comply with Sections 1012.5.1 through 1012.5.3." .

    ibc:ibc2021-1013.6 a ibco:Provision ;
        ibco:bbox "[322.21, 471.802, 565.228, 504.78]" ;
        ibco:hasChild ibc:ibc2021-1013.6.1,
            ibc:ibc2021-1013.6.2,
            ibc:ibc2021-1013.6.3 ;
        ibco:heading "Externally illuminated exit signs" ;
        ibco:label "1013.6" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-1013.6.1 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.6 Externally illuminated exit signs. Externally illuminated exit signs shall comply with Sections 1013.6.1 through 1013.6.3." .

    ibc:ibc2021-1014.3 a ibco:Provision ;
        ibco:bbox "[307.781, 69.711, 550.831, 102.808]" ;
        ibco:hasChild ibc:ibc2021-1014.3.1,
            ibc:ibc2021-1014.3.2,
            ibc:ibc2021-ch10-exception-0664 ;
        ibco:heading "Handrail graspability" ;
        ibco:label "1014.3" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0664 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.3 Handrail graspability. Required handrails shall comply with Section 1014.3.1 or shall provide equivalent graspability." .

    ibc:ibc2021-1017 a ibco:Section ;
        ibco:bbox "[362.04, 617.539, 525.272, 639.69]" ;
        ibco:hasChild ibc:ibc2021-1017.1,
            ibc:ibc2021-1017.2,
            ibc:ibc2021-1017.3 ;
        ibco:heading "EXIT ACCESS TRAVEL DISTANCE" ;
        ibco:label "1017" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1017.1 ;
        ibco:sourcePage 334 ;
        ibco:text "SECTION 1017 EXIT ACCESS TRAVEL DISTANCE" .

    ibc:ibc2021-1017.2.2 a ibco:Provision ;
        ibco:bbox "[319.791, 69.69, 550.864, 113.703]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0754,
            ibc:ibc2021-ch10-list_item-0755,
            ibc:ibc2021-ch10-list_item-0756 ;
        ibco:heading "Groups F-1 and S-1 increase" ;
        ibco:label "1017.2.2" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0754 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.2.2 Groups F-1 and S-1 increase. The maximum exit access travel distance shall be 400 feet (122 m) in Group F-1 or S-1 occupancies where all of the following conditions are met:" .

    ibc:ibc2021-1017.3 a ibco:Provision ;
        ibco:bbox "[307.789, 215.704, 550.862, 281.788]" ;
        ibco:hasChild ibc:ibc2021-1017.3.1,
            ibc:ibc2021-1017.3.2,
            ibc:ibc2021-ch10-exception-0759 ;
        ibco:heading "Measurement" ;
        ibco:label "1017.3" ;
        ibco:partOf ibc:ibc2021-1017 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0759 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3 Measurement. Exit access travel distance shall be measured from the most remote point of each room, area or space along the natural and unobstructed path of horizontal and vertical egress travel to the entrance to an exit. Where more than one exit is required, exit access travel distance shall be measured to the nearest exit." .

    ibc:ibc2021-1017.3.2 a ibco:Provision ;
        ibco:bbox "[319.771, 476.636, 550.83, 509.733]" ;
        ibco:hasChild ibc:ibc2021-1017.3.2.1,
            ibc:ibc2021-1017.3.2.2,
            ibc:ibc2021-1017.3.2.3 ;
        ibco:heading "Atriums" ;
        ibco:label "1017.3.2" ;
        ibco:partOf ibc:ibc2021-1017.3 ;
        ibco:precedes ibc:ibc2021-1017.3.2.1 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3.2 Atriums. Exit acess travel distance for areas open to an atrium shall comply with the requirements of Sections 1017.3.2.1 through 1017.3.2.3." .

    ibc:ibc2021-1021.4 a ibco:Provision ;
        ibco:bbox "[322.197, 330.827, 565.189, 374.841]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0840,
            ibc:ibc2021-ch10-list_item-0841,
            ibc:ibc2021-ch10-list_item-0842 ;
        ibco:heading "Location" ;
        ibco:label "1021.4" ;
        ibco:partOf ibc:ibc2021-1021 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0840 ;
        ibco:sourcePage 338 ;
        ibco:text "1021.4 Location. Exterior egress balconies shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the egress balcony to the following:" .

    ibc:ibc2021-1023.6 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.304, 102.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0875,
            ibc:ibc2021-ch10-list_item-0876,
            ibc:ibc2021-ch10-list_item-0877 ;
        ibco:heading "Ventilation" ;
        ibco:label "1023.6" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0875 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.6 Ventilation. Equipment and ductwork for interior exit stairway and ramp ventilation as permitted by Section 1023.5 shall comply with one of the following items:" .

    ibc:ibc2021-1024.7 a ibco:Provision ;
        ibco:bbox "[307.809, 387.823, 550.95, 420.8]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0917,
            ibc:ibc2021-ch10-list_item-0918,
            ibc:ibc2021-ch10-list_item-0919 ;
        ibco:heading "Ventilation" ;
        ibco:label "1024.7" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0917 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.7 Ventilation. Equipment and ductwork for exit passageway ventilation as permitted by Section 1024.6 shall comply with one of the following:" .

    ibc:ibc2021-1025.2.6 a ibco:Provision ;
        ibco:bbox "[58.809, 132.712, 289.831, 176.725]" ;
        ibco:hasChild ibc:ibc2021-1025.2.6.1,
            ibc:ibc2021-1025.2.6.2,
            ibc:ibc2021-1025.2.6.3 ;
        ibco:heading "Doors within the exit path" ;
        ibco:label "1025.2.6" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-1025.2.6.1 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.2.6 Doors within the exit path. Doors through which occupants must pass in order to complete the exit path shall be provided with markings complying with Sections 1025.2.6.1 through 1025.2.6.3." .

    ibc:ibc2021-1029 a ibco:Section ;
        ibco:bbox "[139.324, 261.701, 226.01, 283.733]" ;
        ibco:hasChild ibc:ibc2021-1029.1,
            ibc:ibc2021-1029.2,
            ibc:ibc2021-1029.3 ;
        ibco:heading "EGRESS COURTS" ;
        ibco:label "1029" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1029.1 ;
        ibco:sourcePage 346 ;
        ibco:text "SECTION 1029 EGRESS COURTS" .

    ibc:ibc2021-1030.10 a ibco:Provision ;
        ibco:bbox "[307.811, 187.761, 550.747, 220.738]" ;
        ibco:hasChild ibc:ibc2021-1030.10.1,
            ibc:ibc2021-1030.10.2,
            ibc:ibc2021-1030.10.3 ;
        ibco:heading "Transitions" ;
        ibco:label "1030.10" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.10.1 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10 Transitions. Transitions between stairways and stepped aisles shall comply with either Section 1030.10.1 or 1030.10.2." .

    ibc:ibc2021-1030.12 a ibco:Provision ;
        ibco:bbox "[61.207, 154.783, 304.275, 187.761]" ;
        ibco:hasChild ibc:ibc2021-1030.12.1,
            ibc:ibc2021-1030.12.2,
            ibc:ibc2021-ch10-exception-1108 ;
        ibco:heading "Construction" ;
        ibco:label "1030.12" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1108 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.12 Construction. Aisles, stepped aisles and ramped aisles shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:ibc2021-1030.13.1 a ibco:Provision ;
        ibco:bbox "[73.179, 361.732, 304.238, 471.72]" ;
        ibco:hasChild ibc:ibc2021-1030.13.1.1,
            ibc:ibc2021-1030.13.1.2,
            ibc:ibc2021-ch10-exception-1113 ;
        ibco:heading "Seating at tables" ;
        ibco:label "1030.13.1" ;
        ibco:partOf ibc:ibc2021-1030.13 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1113 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.1 Seating at tables. Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway shall be made to a line 19 inches (483 mm) away from and parallel to the edge of the table or counter. The 19-inch (483 mm) distance shall be measured perpendicular to the side of the table or counter. In the case of other side boundaries for aisles or aisle accessways, the clear width shall be measured to walls, edges of seating and tread edges." .

    ibc:ibc2021-1030.13.2 a ibco:Provision ;
        ibco:bbox "[334.173, 69.685, 565.295, 190.709]",
            "[73.182, 711.807, 304.263, 733.748]" ;
        ibco:hasChild ibc:ibc2021-1030.13.2.1,
            ibc:ibc2021-1030.13.2.2,
            ibc:ibc2021-ch10-exception-1118 ;
        ibco:label "1030.13.2" ;
        ibco:partOf ibc:ibc2021-1030.13 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1118 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.2 Clear width of aisle accessways serving seating in rows. Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind. Where chairs have automatic or self-rising seats, the measurement shall be made with seats in the raised position. Where any chair in the row does not have an automatic or self-rising seat, the measurements shall be made with the seat in the down position. For seats with folding tablet arms, row spacing shall be determined with the tablet arm in the used position." .

    ibc:ibc2021-1030.14.1 a ibco:Provision ;
        ibco:bbox "[164.158, 78.513, 433.011, 87.352]",
            "[262.92, 69.516, 334.031, 78.354]",
            "[334.134, 625.593, 565.238, 724.782]",
            "[46.197, 250.702, 130.025, 259.469]" ;
        ibco:hasChild ibc:ibc2021-1030.14.1.1,
            ibc:ibc2021-1030.14.1.2,
            ibc:ibc2021-1030.14.1.3 ;
        ibco:heading "Ramped aisles" ;
        ibco:label "1030.14.1" ;
        ibco:partOf ibc:ibc2021-1030.14 ;
        ibco:precedes ibc:ibc2021-1030.14.1.1 ;
        ibco:sourcePage 350,
            351 ;
        ibco:text "1030.14.1 Ramped aisles. Aisles that are sloped more than 1 unit vertical in 20 units horizontal (5-percent slope) shall be considered to be a ramped aisle. Ramped aisles that serve as part of an accessible route in accordance with Sections 1009 and 1109.2 shall have a maximum slope of 1 unit vertical in 12 units horizontal (8-percent slope). The slope of other ramped aisles shall not exceed 1 unit vertical in 8 units horizontal (12.5percent slope). TABLE 1030.13.2.1 SMOKE-PROTECTED OR OPEN-AIR ASSEMBLY AISLE ACCESSWAYS For SI: 1 inch = 25.4 mm." .

    ibc:ibc2021-1030.6 a ibco:Provision ;
        ibco:bbox "[46.789, 69.725, 289.867, 135.809]" ;
        ibco:hasChild ibc:ibc2021-1030.6.1,
            ibc:ibc2021-1030.6.2,
            ibc:ibc2021-1030.6.3 ;
        ibco:heading "Capacity of aisle for assembly" ;
        ibco:label "1030.6" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.6.1 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6 Capacity of aisle for assembly. The required capacity of aisles shall be not less than that determined in accordance with Section 1030.6.1 where smoke-protected assembly seating is not provided, Section 1030.6.2 where smoke-protected assembly seating is provided and Section 1030.6.3 where open-air assembly seating is provided." .

    ibc:ibc2021-1030.6.2 a ibco:Provision ;
        ibco:bbox "[319.783, 69.585, 572.399, 123.467]",
            "[58.781, 486.73, 329.361, 601.55]" ;
        ibco:hasChild ibc:ibc2021-1030.6.2.1,
            ibc:ibc2021-1030.6.2.2,
            ibc:ibc2021-1030.6.2.3 ;
        ibco:heading "Smoke-protected assembly seating" ;
        ibco:label "1030.6.2" ;
        ibco:partOf ibc:ibc2021-1030.6 ;
        ibco:precedes ibc:ibc2021-1030.6.2.1 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.2 Smoke-protected assembly seating. The required capacity in inches (mm) of the aisle for smokeprotected assembly seating shall be not less than the occupant load served by the egress element multiplied by the appropriate factor in Table 1030.6.2. The total number of seats specified shall be those within the space exposed to the same smoke-protected environment. Interpolation is permitted between the specific values shown. A life TABLE 1030.6.2 safety evaluation, complying with NFPA 101, shall be done for a facility utilizing the reduced width requirements of Table 1030.6.2 for smoke-protected assembly seating. " .

    ibc:ibc2021-1031.3 a ibco:Provision ;
        ibco:bbox "[307.793, 499.744, 550.751, 532.722]" ;
        ibco:hasChild ibc:ibc2021-1031.3.1,
            ibc:ibc2021-1031.3.2,
            ibc:ibc2021-1031.3.3 ;
        ibco:heading "Emergency escape and rescue openings" ;
        ibco:label "1031.3" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:precedes ibc:ibc2021-1031.3.1 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.3 Emergency escape and rescue openings. Emergency escape and rescue openings shall comply with Sections 1031.3.1 through 1031.3.3." .

    ibc:ibc2021-1031.5 a ibco:Provision ;
        ibco:bbox "[61.197, 154.783, 304.332, 198.797]" ;
        ibco:hasChild ibc:ibc2021-1031.5.1,
            ibc:ibc2021-1031.5.2,
            ibc:ibc2021-1031.5.3 ;
        ibco:heading "Area wells" ;
        ibco:label "1031.5" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:precedes ibc:ibc2021-1031.5.1 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5 Area wells. An emergency escape and rescue opening with the bottom of the clear opening below the adjacent grade shall be provided with an area well in accordance with Sections 1031.5.1 through 1031.5.3." .

    ibc:ibc2021-ch10-exception-0031 a ibco:Exception ;
        ibco:bbox "[58.787, 604.762, 108.786, 615.788]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0032,
            ibc:ibc2021-ch10-list_item-0033,
            ibc:ibc2021-ch10-list_item-0034 ;
        ibco:partOf ibc:ibc2021-1003.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0032 ;
        ibco:sourcePage 305 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0063 a ibco:Exception ;
        ibco:bbox "[331.771, 95.665, 381.65, 106.691]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0064,
