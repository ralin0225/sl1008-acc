        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0336-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Access doors or gates in barrier walls and fences protecting pools, spas and hot tubs shall be permitted to have operable parts of the latch release on self-latching devices at 54 inches (1370 mm) maximum above the finished floor or ground, provided that the self-latching devices are not also self-locking devices operated by means of a key, electronic opener or integral combination lock." .

    ibc:sem-ibc2021-ch10-exception-0336-condition-1 a ibco:Condition ;
        ibco:text "provided that the self-latching devices are not also self-locking devices operated by means of a key, electronic opener or integral combination lock." .

