        ibco:text "Exceptions:" .

    ibc:sem-ibc2021-ch10-exception-0059 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0059 ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0059-atomic-1 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1030 ;
