        ibco:sourceNode ibc:ibc2021-ch10-exception-0099 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Where using refrigerants in quantities limited to the amounts based on the volume set forth in the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-exception-0113 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0113 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0113-atomic-1 ;
