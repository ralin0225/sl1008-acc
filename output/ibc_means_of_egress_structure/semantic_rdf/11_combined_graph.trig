        ibco:label "1023.9.1" ;
        ibco:partOf ibc:ibc2021-1023.9 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0882 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.9.1 Signage requirements. Stairway identification signs shall comply with all of the following requirements:" .

    ibc:ibc2021-1025.2 a ibco:Provision ;
        ibco:bbox "[61.204, 359.715, 304.171, 403.728]" ;
        ibco:hasChild ibc:ibc2021-1025.2.1,
            ibc:ibc2021-1025.2.2,
            ibc:ibc2021-1025.2.3,
            ibc:ibc2021-1025.2.4,
            ibc:ibc2021-1025.2.5,
            ibc:ibc2021-1025.2.6 ;
        ibco:heading "Markings within exit components" ;
        ibco:label "1025.2" ;
        ibco:partOf ibc:ibc2021-1025 ;
        ibco:precedes ibc:ibc2021-1025.2.1 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2 Markings within exit components. Egress path markings shall be provided in interior exit stairways, interior exit ramps and exit passageways, in accordance with Sections 1025.2.1 through 1025.2.6.3." .

    ibc:ibc2021-1027 a ibco:Section ;
        ibco:bbox "[81.591, 388.583, 283.679, 410.734]" ;
        ibco:hasChild ibc:ibc2021-1027.1,
