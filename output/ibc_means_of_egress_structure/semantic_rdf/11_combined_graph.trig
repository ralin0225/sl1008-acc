        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0208-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "Exit access stairways providing means of egress from mezzanines are permitted as part of an accessible means of egress." .

    ibc:sem-ibc2021-ch10-exception-0210-atomic-1 a ibco:AtomicRule ;
