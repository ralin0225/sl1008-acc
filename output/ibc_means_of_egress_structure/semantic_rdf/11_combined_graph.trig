        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "The maximum transmitted temperature rise is not required." .

    ibc:sem-ibc2021-ch10-exception-1005-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Where access to a public way cannot be provided, a safe dispersal area shall be provided where all of the following are met:" .

