            ibc:ibc2021-ch10-list_item-0415,
            ibc:ibc2021-ch10-list_item-0416,
            ibc:ibc2021-ch10-list_item-0417 ;
        ibco:heading "Delayed egress locking system" ;
        ibco:label "1010.2.13.1" ;
        ibco:partOf ibc:ibc2021-1010.2.13 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0414 ;
        ibco:sourcePage 321 ;
        ibco:text "1010.2.13.1 Delayed egress locking system. The delayed egress locking system shall be installed and operated in accordance with all of the following:" .

    ibc:ibc2021-1017.2 a ibco:Provision ;
        ibco:bbox "[46.799, 69.725, 289.962, 309.99]" ;
        ibco:hasChild ibc:ibc2021-1017.2.1,
