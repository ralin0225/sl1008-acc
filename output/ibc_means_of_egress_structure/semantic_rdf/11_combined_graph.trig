    ibc:sem-ibc2021-ch10-exception-1045-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The required capacity in inches (mm) of aisles shall be permitted to comply with Section 1030.6.2 for the number of seats in the open-air assembly seating where Section 1030.6.2 permits less capacity." .

    ibc:sem-ibc2021-ch10-exception-1045-atomic-2 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "CAPACITY FOR AISLES FOR SMOKE-PROTECTED ASSEMBLY For SI: 1 inch = 25.4 mm." .

    ibc:sem-ibc2021-ch10-exception-1045-condition-1 a ibco:Condition ;
