            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0072-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0072-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0072-condition-2 ;
        ibco:modality "shall" ;
