        ibco:sourceNode ibc:ibc2021-ch10-exception-0567 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Spiral stairways used as a means of egress from technical production areas." .

    ibc:sem-ibc2021-ch10-exception-0569 a ibco:Requirement ;
