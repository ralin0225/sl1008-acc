        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0081-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0081-measurement-2 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0081 ;
        ibco:statementType "declarative" ;
        ibco:text "1.2. The hardware is mounted not less than 34 inches (865 mm) nor more than 48 inches (1219 mm) above the finished floor." .

    ibc:sem-ibc2021-ch10-list_item-0082 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0082 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0082-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0082 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. The restrictions on door swing shall not apply to doors within individual dwelling units and sleeping units of Group R-2 occupancies and dwelling units of Group R-3 occupancies." .

    ibc:sem-ibc2021-ch10-list_item-0091 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0091 ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0091-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0091 ;
        ibco:statementType "exemption" ;
        ibco:text "1. The number of exits from foyers, lobbies, vestibules or similar spaces need not be based on cumulative occupant loads for areas discharging through such spaces, but the capacity of the exits from such spaces shall be based on applicable cumulative occupant loads." .

    ibc:sem-ibc2021-ch10-list_item-0092 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0092 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0092 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Care suites in Group I-2 occupancies complying with Section 407.4." .

    ibc:sem-ibc2021-ch10-list_item-0093 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0093 ;
        ibco:appliesTo ibc:concept-unoccupied-mechanical-rooms-and-penthouses ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0093-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0093 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Unoccupied mechanical rooms and penthouses are not required to comply with the common path of egress travel distance measurement." .

    ibc:sem-ibc2021-ch10-list_item-0103 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0103 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0103-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0103-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0103 ;
        ibco:statementType "permission" ;
        ibco:text "a. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2. See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0104 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0104 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0104 ;
        ibco:statementType "declarative" ;
        ibco:text "b. Group H occupancies equipped throughout with an automatic sprinkler system in accordance with Section 903.2.5." .

    ibc:sem-ibc2021-ch10-list_item-0105 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0105 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1030.8 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0105 ;
        ibco:statementType "declarative" ;
        ibco:text "c. For a room or space used for assembly purposes having fixed seating, see Section 1030.8." .

    ibc:sem-ibc2021-ch10-list_item-0106 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0106 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0106 ;
        ibco:statementType "declarative" ;
        ibco:text "d. For the travel distance limitations in Group I-2, see Section 407.4." .

    ibc:sem-ibc2021-ch10-list_item-0107 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0107 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0107-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0107 ;
        ibco:statementType "obligation" ;
        ibco:text "e. The common path of egress travel distance shall only apply in a Group R-3 occupancy located in a mixed occupancy building." .

    ibc:sem-ibc2021-ch10-list_item-0108 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0108 ;
        ibco:appliesTo ibc:concept-the-length-of-common-path-of-egress-travel-distance-in-a-group-s-2-open-parking-garage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0108-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0108-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0108 ;
        ibco:statementType "obligation" ;
        ibco:text "f. The length of common path of egress travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0109 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0109 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0109-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0109-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.2.2.6 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0109 ;
        ibco:statementType "obligation" ;
        ibco:text "g. For the travel distance limitations in Groups R-3 and R-4 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3, see Section 1006.2.2.6. Section 903.3.1.3, the exit access travel distance for Group R-4 shall be not more than 75 feet (22 860 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0114 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0114 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0114 ;
        ibco:statementType "declarative" ;
        ibco:text "1. In Group R-1, R-2 or R-3 occupancies, exit access stairways and ramps connecting four stories or less serving and contained within an individual dwelling unit, sleeping unit or live/work unit." .

    ibc:sem-ibc2021-ch10-list_item-0115 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0115 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0115 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility." .

    ibc:sem-ibc2021-ch10-list_item-0116 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0116 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0116 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Exit access stairways and ramps within an atrium complying with Section 404." .

    ibc:sem-ibc2021-ch10-list_item-0117 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0117 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0117 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Exit access stairways and ramps in open parking garages that serve only the parking garage." .

    ibc:sem-ibc2021-ch10-list_item-0118 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0118 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1030.7 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0118 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Exit access stairways and ramps serving openair assembly seating complying with the exit access travel distance requirements of Section 1030.7." .

    ibc:sem-ibc2021-ch10-list_item-0119 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0119 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0119 ;
        ibco:statementType "declarative" ;
        ibco:text "6. Exit access stairways and ramps between the balcony, gallery or press box and the main assembly floor in occupancies such as theaters, places of religious worship, auditoriums and sports facilities." .

    ibc:sem-ibc2021-ch10-list_item-0120 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0120 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0120 ;
        ibco:statementType "declarative" ;
        ibco:text "7. Exterior exit access stairways and ramps between occupied roofs." .

    ibc:sem-ibc2021-ch10-list_item-0123 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0123 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0123 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The occupant load, number of dwelling units and exit access travel distance do not exceed the values in Table 1006.3.4(1) or 1006.3.4(2)." .

    ibc:sem-ibc2021-ch10-list_item-0124 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0124 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0124-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1006.2.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0124 ;
        ibco:statementType "permission" ;
        ibco:text "2. Rooms, areas and spaces complying with Section 1006.2.1 with exits that discharge directly to the exterior at the level of exit discharge, are permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0125 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0125 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0125-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0125-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0125 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Parking garages where vehicles are mechanically parked shall be permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0126 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0126 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0126-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0126 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Group R-3 and R-4 occupancies shall be permitted to have one exit or access to a single exit." .

    ibc:sem-ibc2021-ch10-list_item-0127 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0127 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0127-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0127-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0127 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Individual single-story or multistory dwelling units shall be permitted to have a single exit or access to a single exit from the dwelling unit provided that both of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0128 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0128 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1006.2.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0128 ;
        ibco:statementType "declarative" ;
        ibco:text "5.1. The dwelling unit complies with Section 1006.2.1 as a space with one means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0129 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0129 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0129 ;
        ibco:statementType "declarative" ;
        ibco:text "5.2. Either the exit from the dwelling unit discharges directly to the exterior at the level of exit discharge, or the exit access outside the dwelling unit’s entrance door provides access to not less than two approved independent exits." .

    ibc:sem-ibc2021-ch10-list_item-0131 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0131 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1031 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0131 ;
        ibco:statementType "declarative" ;
        ibco:text "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031." .

    ibc:sem-ibc2021-ch10-list_item-0132 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0132 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-exit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0132-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0132-measurement-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0132 ;
        ibco:statementType "permission" ;
        ibco:text "b. This table is used for R-2 occupancies consisting of dwelling units. For R-2 occupancies consisting of sleeping units, use Table 1006.3.4(2). TABLE 1006.3.4(2) STORIES WITH ONE EXIT OR ACCESS TO ONE EXIT FOR OTHER OCCUPANCIES For SI: 1 foot = 304.8 mm. NP = Not Permitted. NA = Not Applicable." .

    ibc:sem-ibc2021-ch10-list_item-0133 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0133 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1031 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0133 ;
        ibco:statementType "declarative" ;
        ibco:text "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031." .

    ibc:sem-ibc2021-ch10-list_item-0134 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0134 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0134-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0134-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0134 ;
        ibco:statementType "obligation" ;
        ibco:text "b. Group B, F and S occupancies in buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 shall have a maximum exit access travel distance of 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0135 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0135 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0135 ;
        ibco:statementType "declarative" ;
        ibco:text "c. This table is used for R-2 occupancies consisting of sleeping units. For R-2 occupancies consisting of dwelling units, use Table 1006.3.4(1)." .

    ibc:sem-ibc2021-ch10-list_item-0136 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0136 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0136-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0136-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0136 ;
        ibco:statementType "obligation" ;
        ibco:text "d. The length of exit access travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:sem-ibc2021-ch10-list_item-0141 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0141 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0141-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0141-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1020 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0141 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Where interior exit stairways or ramps are interconnected by a 1-hour fire-resistance-rated corridor conforming to the requirements of Section 1020, the required exit separation shall be measured along the shortest direct line of travel within the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0142 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0142 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0142-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0142-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0142 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Where a building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2, the separation distance shall be not less than one-third of the length of the maximum overall diagonal dimension of the area served." .

    ibc:sem-ibc2021-ch10-list_item-0144 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0144 ;
        ibco:appliesTo ibc:concept-exit,
