        ibco:sourceNode ibc:ibc2021-ch10-exception-1155 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Mid-aisle handrails shall be permitted to extend beyond the lowest riser where the handrail extensions do not obstruct the width of the cross aisle." .

    ibc:sem-ibc2021-ch10-exception-1159 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-1159 ;
