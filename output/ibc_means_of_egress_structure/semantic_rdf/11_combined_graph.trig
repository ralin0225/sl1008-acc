        ibco:sourcePage 310 ;
        ibco:text "Exception: The path of egress travel to an exit shall be permitted to pass through more than one adjacent story in any of the following:" .

    ibc:ibc2021-1010.2.12 a ibco:Provision ;
        ibco:bbox "[334.197, 360.69, 565.284, 415.782]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0400,
