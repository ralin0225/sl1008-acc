        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0205 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, the elevator shall not be required on floors provided with a ramp conforming to the provisions of Section 1012." .

    ibc:sem-ibc2021-ch10-list_item-0211 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0211 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
