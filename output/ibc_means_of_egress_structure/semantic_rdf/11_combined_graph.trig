            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0113 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: The path of egress travel to an exit shall be permitted to pass through more than one adjacent story in any of the following:" .

    ibc:sem-ibc2021-ch10-exception-0140 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0140 ;
