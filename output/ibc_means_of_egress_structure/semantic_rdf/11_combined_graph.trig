            ibc:ibc2021-ch10-list_item-0747,
            ibc:ibc2021-ch10-list_item-0748,
            ibc:ibc2021-ch10-list_item-0749,
            ibc:ibc2021-ch10-list_item-0750,
            ibc:ibc2021-ch10-list_item-0751 ;
        ibco:heading "Limitations" ;
        ibco:label "1017.2" ;
        ibco:partOf ibc:ibc2021-1017 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0747 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.2 Limitations. Exit access travel distance shall not exceed the values given in Table 1017.2. TABLE 1017.2 EXIT ACCESS TRAVEL DISTANCEa For SI: 1 foot = 304.8 mm." .

