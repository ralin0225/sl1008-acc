        ibco:statementType "declarative" ;
        ibco:text "3. Open-air assembly seating facilities where seating and the means of egress in the seating area are essentially open to the outside." .

    ibc:sem-ibc2021-ch10-list_item-1053 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1053 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1053-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-1053-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-1053-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1053-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1053-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-1053-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1053 ;
        ibco:statementType "obligation" ;
        ibco:text "1. In facilities with smoke-protected assembly seating, the total exit access travel distance shall be not greater than 400 feet (122 m). That portion of the total permitted exit access travel distance from each seat to the nearest entrance to a vomitory or concourse shall not exceed 200 feet (60 960 mm). The portion of the total permitted exit access travel distance from the entrance to the vomitory or concourse to one of the following shall not exceed 200 feet (60 960 mm):" .

    ibc:sem-ibc2021-ch10-list_item-1054 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1054 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1054 ;
        ibco:statementType "declarative" ;
        ibco:text "1.1. The closest riser of an exit access stairway." .

    ibc:sem-ibc2021-ch10-list_item-1055 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1055 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1055 ;
        ibco:statementType "declarative" ;
        ibco:text "1.2. The closest slope of an exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-1056 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1056 ;
        ibco:confidence 0.81 ;
