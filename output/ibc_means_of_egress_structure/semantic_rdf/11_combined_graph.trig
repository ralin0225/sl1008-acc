    ibc:sem-ibc2021-ch10-exception-1045-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-ch10-exception-1047-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
