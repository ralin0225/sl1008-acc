        ibco:statementType "obligation" ;
        ibco:text "1. Surface-mounted latch release hardware shall be exempt from inclusion in the 7-inch maximum (178 mm) encroachment where both of the following conditions exist:" .

    ibc:sem-ibc2021-ch10-list_item-0080 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0080 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0080-condition-1 ;
