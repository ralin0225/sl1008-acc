        ibco:precedes ibc:ibc2021-ch10-list_item-0865 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.5 Penetrations. Penetrations into or through interior exit stairways and ramps are prohibited except for the following:" .

    ibc:ibc2021-1030.9 a ibco:Provision ;
        ibco:bbox "[322.191, 257.748, 565.234, 312.797]" ;
        ibco:hasChild ibc:ibc2021-1030.9.1,
            ibc:ibc2021-1030.9.2,
            ibc:ibc2021-1030.9.3,
            ibc:ibc2021-1030.9.4,
            ibc:ibc2021-1030.9.5,
            ibc:ibc2021-1030.9.6,
            ibc:ibc2021-1030.9.7,
            ibc:ibc2021-1030.9.8 ;
        ibco:heading "Assembly aisles are required" ;
        ibco:label "1030.9" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.9.1 ;
        ibco:sourcePage 348 ;
        ibco:text "1030.9 Assembly aisles are required. Every occupied portion of any building, room or space used for assembly purposes that contains seats, tables, displays, similar fixtures or equipment shall be provided with aisles leading to exits or exit access doorways in accordance with this section." .

    ibc:ibc2021-ch10-exception-0012 a ibco:Exception ;
        ibco:bbox "[334.221, 395.672, 384.218, 406.698]" ;
