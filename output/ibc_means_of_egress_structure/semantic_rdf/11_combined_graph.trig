    ibc:sem-ibc2021-ch10-list_item-0033 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0033 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0033-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0033-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0033-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0033-measurement-2 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1011.5,
            ibc:ibc2021-1014 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0033 ;
        ibco:statementType "permission" ;
        ibco:text "2. A stair with a single riser or with two risers and a tread is permitted at locations not required to be accessible by Chapter 11 where the risers and treads comply with Section 1011.5, the minimum depth of the tread is 13 inches (330 mm) and not less than one handrail complying with Section 1014 is provided within 30 inches (762 mm) of the centerline of the normal path of egress travel on the stair." .

    ibc:sem-ibc2021-ch10-list_item-0034 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0034 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-meansofegress,
            ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0034-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0034-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0034-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0034-measurement-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1030.14,
            ibc:ibc2021-1030.16 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0034 ;
        ibco:statementType "permission" ;
        ibco:text "3. A step is permitted in aisles serving seating that has a difference in elevation less than 12 inches (305 mm) at locations not required to be accessible by Chapter 11, provided that the risers and treads comply with Section 1030.14 and the aisle is provided with a handrail complying with Section 1030.16. Throughout a story in a Group I-2 occupancy, any change in elevation in portions of the means of egress that serve nonambulatory persons shall be by means of a ramp or sloped walkway." .

    ibc:sem-ibc2021-ch10-list_item-0050 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0050 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0050 ;
        ibco:statementType "declarative" ;
        ibco:text "a. Floor area in square feet per occupant." .

    ibc:sem-ibc2021-ch10-list_item-0053 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0053 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0053 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Outdoor areas used exclusively for service of the building need only have one means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0054 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0054 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0054 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Both outdoor areas associated with Group R-3 and individual dwelling units of Group R-2." .

    ibc:sem-ibc2021-ch10-list_item-0064 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0064 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0064-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0064-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0064-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0064 ;
        ibco:statementType "obligation" ;
        ibco:text "1. For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:sem-ibc2021-ch10-list_item-0065 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0065 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0065-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0065-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.6.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0065 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section" .

    ibc:sem-ibc2021-ch10-list_item-0066 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0066 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0066 ;
        ibco:statementType "declarative" ;
        ibco:text "909." .

    ibc:sem-ibc2021-ch10-list_item-0067 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0067 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0067-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0067-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.6.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0067 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:sem-ibc2021-ch10-list_item-0070 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0070 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress,
            ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0070-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0070-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0070-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0070-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0070 ;
        ibco:statementType "obligation" ;
        ibco:text "1. For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.15 inch (3.8 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:sem-ibc2021-ch10-list_item-0071 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0071 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0071-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0071-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0071-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.6.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0071 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909." .

