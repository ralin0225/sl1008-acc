    ibc:ibc2021-ch10-exception-0632 a ibco:Exception ;
        ibco:bbox "[73.191, 106.796, 123.189, 117.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0633,
            ibc:ibc2021-ch10-list_item-0634,
            ibc:ibc2021-ch10-list_item-0635 ;
        ibco:partOf ibc:ibc2021-1012.10 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0633 ;
        ibco:sourcePage 330 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0659 a ibco:Exception ;
        ibco:bbox "[58.759, 517.676, 108.757, 528.702]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0660,
            ibc:ibc2021-ch10-list_item-0661,
            ibc:ibc2021-ch10-list_item-0662 ;
        ibco:partOf ibc:ibc2021-1014.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0660 ;
        ibco:sourcePage 331 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0676 a ibco:Exception ;
        ibco:bbox "[73.179, 294.901, 123.177, 305.926]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0677,
            ibc:ibc2021-ch10-list_item-0678,
            ibc:ibc2021-ch10-list_item-0679 ;
        ibco:partOf ibc:ibc2021-1014.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0677 ;
        ibco:sourcePage 332 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0731 a ibco:Exception ;
        ibco:bbox "[109.195, 570.723, 304.189, 625.652]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0732,
            ibc:ibc2021-ch10-list_item-0733,
            ibc:ibc2021-ch10-list_item-0734 ;
        ibco:partOf ibc:ibc2021-1016.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0732 ;
        ibco:sourcePage 334 ;
        ibco:text "Exception: Means of egress are not prohibited through adjoining or intervening rooms or spaces in a Group H, S or F occupancy where the adjoining or intervening rooms or spaces are the same or a lesser hazard occupancy group." .

    ibc:ibc2021-ch10-exception-0851 a ibco:Exception ;
        ibco:bbox "[58.819, 345.756, 108.817, 356.782]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0852,
            ibc:ibc2021-ch10-list_item-0853,
            ibc:ibc2021-ch10-list_item-0854 ;
        ibco:partOf ibc:ibc2021-1023.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0852 ;
        ibco:sourcePage 339 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0859 a ibco:Exception ;
        ibco:bbox "[331.806, 117.659, 381.684, 128.685]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0860,
            ibc:ibc2021-ch10-list_item-0861,
            ibc:ibc2021-ch10-list_item-0862 ;
        ibco:partOf ibc:ibc2021-1023.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0860 ;
        ibco:sourcePage 339 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0892 a ibco:Exception ;
        ibco:bbox "[346.195, 680.625, 396.073, 691.651]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0893,
            ibc:ibc2021-ch10-list_item-0894,
            ibc:ibc2021-ch10-list_item-0895 ;
        ibco:partOf ibc:ibc2021-1023.12.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0893 ;
        ibco:sourcePage 340 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1022 a ibco:Exception ;
        ibco:bbox "[358.191, 139.765, 408.189, 150.791]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1023,
            ibc:ibc2021-ch10-list_item-1024,
            ibc:ibc2021-ch10-list_item-1025 ;
        ibco:partOf ibc:ibc2021-1030.1.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1023 ;
        ibco:sourcePage 346 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1047 a ibco:Exception ;
        ibco:bbox "[97.201, 128.748, 147.199, 139.773]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1048,
            ibc:ibc2021-ch10-list_item-1049,
            ibc:ibc2021-ch10-list_item-1050 ;
        ibco:partOf ibc:ibc2021-1030.6.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1048 ;
        ibco:sourcePage 348 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1052 a ibco:Exception ;
        ibco:bbox "[73.192, 311.747, 123.19, 322.773]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1053,
            ibc:ibc2021-ch10-list_item-1057,
            ibc:ibc2021-ch10-list_item-1061 ;
        ibco:partOf ibc:ibc2021-1030.7 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1053 ;
        ibco:sourcePage 348 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1076 a ibco:Exception ;
        ibco:bbox "[370.188, 541.727, 420.185, 552.753]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1077,
            ibc:ibc2021-ch10-list_item-1078,
            ibc:ibc2021-ch10-list_item-1079 ;
        ibco:partOf ibc:ibc2021-1030.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1077 ;
        ibco:sourcePage 348 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1148 a ibco:Exception ;
        ibco:bbox "[73.191, 617.624, 123.189, 628.65]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1149,
            ibc:ibc2021-ch10-list_item-1150,
            ibc:ibc2021-ch10-list_item-1151 ;
        ibco:partOf ibc:ibc2021-1030.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1149 ;
        ibco:sourcePage 352 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-list_item-0317 a ibco:ListItem ;
        ibco:bbox "[343.804, 397.796, 550.828, 452.862]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0318,
            ibc:ibc2021-ch10-list_item-0319,
            ibc:ibc2021-ch10-list_item-0320 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0316 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0318 ;
        ibco:sourcePage 317 ;
        ibco:text "1. In occupancy Group R-2 or R-3, threshold heights for sliding and side-hinged exterior doors shall be permitted to be up to 73/4 inches (197 mm) in height if all of the following apply:" .

    ibc:ibc2021-ch10-list_item-0340 a ibco:ListItem ;
        ibco:bbox "[351.139, 69.575, 565.282, 135.66]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0341,
            ibc:ibc2021-ch10-list_item-0342,
            ibc:ibc2021-ch10-list_item-0343 ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0341 ;
        ibco:sourcePage 318 ;
        ibco:text "3. In buildings in occupancy Group A having an occupant load of 300 or less, Groups B, F, M and S, and in places of religious worship, the main door or doors are permitted to be equipped with key-operated locking devices from the egress side provided:" .

    ibc:ibc2021-ch10-list_item-0351 a ibco:ListItem ;
        ibco:bbox "[372.584, 685.753, 565.169, 718.731]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0352,
            ibc:ibc2021-ch10-list_item-0353,
            ibc:ibc2021-ch10-list_item-0354 ;
        ibco:label "8.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0348 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0352 ;
        ibco:sourcePage 318 ;
        ibco:text "8.3. The egress door locking device is readily distinguishable as locked and shall be a key-operated locking device." .

    ibc:ibc2021-ch10-list_item-0496 a ibco:ListItem ;
        ibco:bbox "[346.198, 445.715, 565.248, 489.728]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0497,
            ibc:ibc2021-ch10-list_item-0498,
            ibc:ibc2021-ch10-list_item-0501 ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0497 ;
        ibco:sourcePage 324 ;
        ibco:text "5. Each secured physical barrier shall automatically retract or swing to an unobstructed open position in the direction of egress, under each of the following conditions:" .

    ibc:ibc2021-ch10-list_item-0995 a ibco:ListItem ;
        ibco:bbox "[331.792, 328.733, 550.955, 383.782]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0996,
            ibc:ibc2021-ch10-list_item-0997,
            ibc:ibc2021-ch10-list_item-0998 ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0989 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0996 ;
        ibco:sourcePage 345 ;
        ibco:text "2. Not more than 50 percent of the number and minimum width or required capacity of the interior exit stairways and ramps is permitted to egress through a vestibule provided that all of the following conditions are met:" .

    ibc:ibc2021-ch10-list_item-1053 a ibco:ListItem ;
        ibco:bbox "[85.194, 326.747, 304.307, 436.735]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1054,
            ibc:ibc2021-ch10-list_item-1055,
            ibc:ibc2021-ch10-list_item-1056 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1052 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1054 ;
        ibco:sourcePage 348 ;
        ibco:text "1. In facilities with smoke-protected assembly seating, the total exit access travel distance shall be not greater than 400 feet (122 m). That portion of the total permitted exit access travel distance from each seat to the nearest entrance to a vomitory or concourse shall not exceed 200 feet (60 960 mm). The portion of the total permitted exit access travel distance from the entrance to the vomitory or concourse to one of the following shall not exceed 200 feet (60 960 mm):" .

    ibc:ibc2021-ch10-list_item-1057 a ibco:ListItem ;
        ibco:bbox "[85.194, 492.8, 304.276, 536.813]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1058,
            ibc:ibc2021-ch10-list_item-1059,
            ibc:ibc2021-ch10-list_item-1060 ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1052 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1058 ;
        ibco:sourcePage 348 ;
        ibco:text "2. In facilities with open-air assembly seating of Type III, IV or V construction, the total exit access travel distance to one of the following shall not exceed 400 feet (122 m):" .

    ibc:ibc2021-1003.3 a ibco:Provision ;
        ibco:bbox "[322.219, 622.7, 565.261, 655.678]" ;
        ibco:hasChild ibc:ibc2021-1003.3.1,
            ibc:ibc2021-1003.3.2,
            ibc:ibc2021-1003.3.3,
            ibc:ibc2021-1003.3.4 ;
        ibco:heading "Protruding objects" ;
        ibco:label "1003.3" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-1003.3.1 ;
        ibco:sourcePage 304 ;
        ibco:text "1003.3 Protruding objects. Protruding objects on circulation paths shall comply with the requirements of Sections 1003.3.1 through 1003.3.4." .

    ibc:ibc2021-1006.3 a ibco:Provision ;
        ibco:bbox "[61.195, 95.76, 304.276, 150.809]" ;
        ibco:hasChild ibc:ibc2021-1006.3.1,
            ibc:ibc2021-1006.3.2,
            ibc:ibc2021-1006.3.3,
            ibc:ibc2021-1006.3.4 ;
        ibco:heading "Egress from stories or occupied roofs" ;
        ibco:label "1006.3" ;
        ibco:partOf ibc:ibc2021-1006 ;
        ibco:precedes ibc:ibc2021-1006.3.1 ;
        ibco:sourcePage 310 ;
        ibco:text "1006.3 Egress from stories or occupied roofs. The means of egress system serving any story or occupied roof shall be provided with the number of separate and distinct exits or access to exits based on the aggregate occupant load served in accordance with this section." .

    ibc:ibc2021-1008.2 a ibco:Provision ;
        ibco:bbox "[61.205, 219.693, 304.269, 252.79]" ;
        ibco:hasChild ibc:ibc2021-1008.2.1,
            ibc:ibc2021-1008.2.2,
            ibc:ibc2021-1008.2.3,
            ibc:ibc2021-ch10-exception-0153 ;
        ibco:heading "Illumination required" ;
        ibco:label "1008.2" ;
        ibco:partOf ibc:ibc2021-1008 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0153 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.2 Illumination required. The means of egress serving a room or space shall be illuminated at all times that the room or space is occupied." .

    ibc:ibc2021-1009.7 a ibco:Provision ;
        ibco:bbox "[322.209, 339.021, 565.318, 431.739]" ;
        ibco:hasChild ibc:ibc2021-1009.7.1,
            ibc:ibc2021-1009.7.2,
            ibc:ibc2021-1009.7.3,
            ibc:ibc2021-1009.7.4 ;
        ibco:heading "Exterior areas for assisted rescue" ;
        ibco:label "1009.7" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-1009.7.1 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.7 Exterior areas for assisted rescue. Exterior areas for assisted rescue shall be accessed by an accessible route from the area served. Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009.7.1 through 1009.7.4." .

    ibc:ibc2021-1010.2.13 a ibco:Provision ;
        ibco:bbox "[58.789, 156.715, 289.794, 233.716]" ;
        ibco:hasChild ibc:ibc2021-1010.2.13.1,
            ibc:ibc2021-ch10-list_item-0409,
            ibc:ibc2021-ch10-list_item-0410,
            ibc:ibc2021-ch10-list_item-0411 ;
        ibco:heading "Delayed egress" ;
        ibco:label "1010.2.13" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0409 ;
        ibco:sourcePage 321 ;
        ibco:text "1010.2.13 Delayed egress. Delayed egress locking systems shall be permitted to be installed on doors serving the following occupancies in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke or heat detection system installed in accordance with Section 907." .

    ibc:ibc2021-1010.2.8 a ibco:Provision ;
        ibco:bbox "[319.796, 464.579, 550.948, 541.789]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0373,
            ibc:ibc2021-ch10-list_item-0374,
            ibc:ibc2021-ch10-list_item-0375,
            ibc:ibc2021-ch10-list_item-0376 ;
        ibco:label "1010.2.8" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0373 ;
        ibco:sourcePage 319 ;
        ibco:text "1010.2.8 Locking arrangements in educational occupancies. In Group E occupancies, Group B educational occupancies and Group I-4 occupancies, egress doors from classrooms, offices and other occupied rooms with locking arrangements designed to keep intruders from entering the room shall comply with all of the following conditions:" .

    ibc:ibc2021-1010.2.9.3 a ibco:Provision ;
        ibco:bbox "[85.197, 494.702, 304.147, 516.763]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0386,
            ibc:ibc2021-ch10-list_item-0387,
            ibc:ibc2021-ch10-list_item-0388,
            ibc:ibc2021-ch10-list_item-0389 ;
        ibco:heading "Installation" ;
        ibco:label "1010.2.9.3" ;
        ibco:partOf ibc:ibc2021-1010.2.9 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0386 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.9.3 Installation. Where panic or fire exit hardware is installed, it shall comply with the following:" .

    ibc:ibc2021-1010.3 a ibco:Provision ;
        ibco:bbox "[322.199, 149.604, 565.295, 182.742]" ;
        ibco:hasChild ibc:ibc2021-1010.3.1,
            ibc:ibc2021-1010.3.2,
            ibc:ibc2021-1010.3.3,
            ibc:ibc2021-1010.3.4 ;
        ibco:heading "Special doors" ;
        ibco:label "1010.3" ;
        ibco:partOf ibc:ibc2021-1010 ;
        ibco:precedes ibc:ibc2021-1010.3.1 ;
        ibco:sourcePage 322 ;
        ibco:text "1010.3 Special doors. Special doors and security grilles shall comply with the requirements of Sections 1010.3.1 through 1010.3.4." .

    ibc:ibc2021-1010.3.3 a ibco:Provision ;
        ibco:bbox "[319.798, 487.792, 550.858, 553.757]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0472,
            ibc:ibc2021-ch10-list_item-0473,
            ibc:ibc2021-ch10-list_item-0474,
            ibc:ibc2021-ch10-list_item-0475 ;
        ibco:label "1010.3.3" ;
        ibco:partOf ibc:ibc2021-1010.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0472 ;
        ibco:sourcePage 323 ;
        ibco:text "1010.3.3 Special purpose horizontal sliding, accordion or folding doors. In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010.1.2 shall comply with all of the following criteria:" .

    ibc:ibc2021-1010.5 a ibco:Provision ;
        ibco:bbox "[61.205, 527.646, 304.304, 582.695]" ;
        ibco:hasChild ibc:ibc2021-1010.5.1,
            ibc:ibc2021-1010.5.2,
            ibc:ibc2021-1010.5.3,
            ibc:ibc2021-1010.5.4 ;
        ibco:heading "Turnstiles and similar devices" ;
        ibco:label "1010.5" ;
        ibco:partOf ibc:ibc2021-1010 ;
        ibco:precedes ibc:ibc2021-1010.5.1 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.5 Turnstiles and similar devices. Turnstiles or similar devices that restrict travel to one direction shall not be placed so as to obstruct any required means of egress, except where permitted in accordance with Sections 1010.5.1, 1010.5.2 and 1010.5.3." .

    ibc:ibc2021-1015.3 a ibco:Provision ;
        ibco:bbox "[322.207, 608.738, 565.131, 630.799]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0700,
            ibc:ibc2021-ch10-list_item-0697,
            ibc:ibc2021-ch10-list_item-0698,
            ibc:ibc2021-ch10-list_item-0699 ;
        ibco:heading "Height" ;
        ibco:label "1015.3" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0697 ;
        ibco:sourcePage 332 ;
        ibco:text "1015.3 Height. Required guards shall be not less than 42 inches (1067 mm) high, measured vertically as follows:" .

    ibc:ibc2021-1019 a ibco:Section ;
        ibco:bbox "[86.391, 610.658, 279.146, 632.809]" ;
        ibco:hasChild ibc:ibc2021-1019.1,
            ibc:ibc2021-1019.2,
            ibc:ibc2021-1019.3,
            ibc:ibc2021-1019.4 ;
        ibco:heading "EXIT ACCESS STAIRWAYS AND RAMPS" ;
        ibco:label "1019" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1019.1 ;
        ibco:sourcePage 336 ;
        ibco:text "SECTION 1019 EXIT ACCESS STAIRWAYS AND RAMPS" .

    ibc:ibc2021-1021 a ibco:Section ;
        ibco:bbox "[392.015, 123.482, 495.263, 145.633]" ;
        ibco:hasChild ibc:ibc2021-1021.1,
            ibc:ibc2021-1021.2,
            ibc:ibc2021-1021.3,
            ibc:ibc2021-1021.4 ;
        ibco:heading "EGRESS BALCONIES" ;
        ibco:label "1021" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1021.1 ;
        ibco:sourcePage 338 ;
        ibco:text "SECTION 1021 EGRESS BALCONIES" .

    ibc:ibc2021-1025.2.4 a ibco:Provision ;
        ibco:bbox "[334.207, 69.666, 565.374, 157.703]" ;
        ibco:hasChild ibc:ibc2021-1025.2.4.1,
            ibc:ibc2021-1025.2.4.2,
            ibc:ibc2021-1025.2.4.3,
            ibc:ibc2021-ch10-exception-0933 ;
        ibco:heading "Perimeter demarcation lines" ;
        ibco:label "1025.2.4" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0933 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.4 Perimeter demarcation lines. Stair landings and other floor areas within interior exit stairways, interior exit ramps and exit passageways, with the exception of the sides of steps, shall be provided with solid and continuous demarcation lines on the floor or on the walls or a combination of both. The stripes shall be 1 to 2 inches (25 mm to 51 mm) wide with interruptions not exceeding 4 inches (102 mm)." .

    ibc:ibc2021-1027.5 a ibco:Provision ;
        ibco:bbox "[322.201, 69.691, 565.256, 91.753]",
            "[61.199, 683.735, 304.207, 705.797]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0974,
            ibc:ibc2021-ch10-list_item-0971,
            ibc:ibc2021-ch10-list_item-0972,
            ibc:ibc2021-ch10-list_item-0973 ;
        ibco:heading "Location" ;
        ibco:label "1027.5" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0971 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.5 Location. Exterior exit stairways and ramps shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the stairway or ramps, including landings, to:" .

    ibc:ibc2021-1030.14.2 a ibco:Provision ;
        ibco:bbox "[58.787, 448.758, 289.817, 503.807]" ;
        ibco:hasChild ibc:ibc2021-1030.14.2.1,
            ibc:ibc2021-1030.14.2.2.1,
            ibc:ibc2021-1030.14.2.3,
            ibc:ibc2021-1030.14.2.4 ;
        ibco:heading "Stepped aisles" ;
        ibco:label "1030.14.2" ;
        ibco:partOf ibc:ibc2021-1030.14 ;
        ibco:precedes ibc:ibc2021-1030.14.2.1 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.2 Stepped aisles. Aisles with a slope exceeding one unit vertical in eight units horizontal (12.5-percent slope) shall consist of a series of risers and treads that extends across the full width of aisles and complies with Sections 1030.14.2.1 through 1030.14.2.4." .

    ibc:ibc2021-1030.17 a ibco:Provision ;
        ibco:bbox "[322.201, 434.676, 565.295, 522.713]" ;
        ibco:hasChild ibc:ibc2021-1030.17.1,
            ibc:ibc2021-1030.17.2,
            ibc:ibc2021-1030.17.3,
            ibc:ibc2021-1030.17.4 ;
        ibco:heading "Assembly guards" ;
        ibco:label "1030.17" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.17.1 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.17 Assembly guards. Guards adjacent to seating in a building, room or space used for assembly purposes shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015 except where provided in accordance with Sections 1030.17.1 through 1030.17.4. At bleachers, grandstands and folding and telescopic seating, guards must be provided where required by ICC 300 and Section 1030.17.1." .

    ibc:ibc2021-1030.6.1 a ibco:Provision ;
        ibco:bbox "[58.791, 139.783, 289.881, 194.713]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1032,
            ibc:ibc2021-ch10-list_item-1033,
            ibc:ibc2021-ch10-list_item-1034,
            ibc:ibc2021-ch10-list_item-1035 ;
        ibco:heading "Without smoke protection" ;
        ibco:label "1030.6.1" ;
        ibco:partOf ibc:ibc2021-1030.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1032 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.1 Without smoke protection. The required capacity in inches (mm) of the aisles for assembly seating without smoke protection shall be not less than the occupant load served by the egress element in accordance with all of the following, as applicable:" .

    ibc:ibc2021-1031.2 a ibco:Provision ;
        ibco:bbox "[46.836, 525.724, 289.885, 558.701]" ;
        ibco:hasChild ibc:ibc2021-1031.2.1,
            ibc:ibc2021-ch10-exception-1171,
            ibc:ibc2021-ch10-list_item-1169,
            ibc:ibc2021-ch10-list_item-1170 ;
        ibco:heading "Where required" ;
        ibco:label "1031.2" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1169 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.2 Where required. In addition to the means of egress required by this chapter, emergency escape and rescue openings shall be provided in the following occupancies:" .

    ibc:ibc2021-ch10-exception-0153 a ibco:Exception ;
        ibco:bbox "[73.207, 256.764, 123.205, 267.789]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0154,
            ibc:ibc2021-ch10-list_item-0155,
            ibc:ibc2021-ch10-list_item-0156,
            ibc:ibc2021-ch10-list_item-0157 ;
        ibco:partOf ibc:ibc2021-1008.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0154 ;
        ibco:sourcePage 312 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0329 a ibco:Exception ;
        ibco:bbox "[85.207, 249.802, 135.086, 260.827]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0330,
            ibc:ibc2021-ch10-list_item-0331,
            ibc:ibc2021-ch10-list_item-0332,
            ibc:ibc2021-ch10-list_item-0333 ;
        ibco:partOf ibc:ibc2021-1010.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0330 ;
        ibco:sourcePage 318 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0378 a ibco:Exception ;
        ibco:bbox "[85.211, 106.796, 135.09, 117.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0379,
            ibc:ibc2021-ch10-list_item-0380,
            ibc:ibc2021-ch10-list_item-0381,
            ibc:ibc2021-ch10-list_item-0382 ;
        ibco:partOf ibc:ibc2021-1010.2.9 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0379 ;
        ibco:sourcePage 320 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0461 a ibco:Exception ;
        ibco:bbox "[82.811, 539.714, 289.857, 594.763]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0462,
            ibc:ibc2021-ch10-list_item-0463,
            ibc:ibc2021-ch10-list_item-0464,
            ibc:ibc2021-ch10-list_item-0465 ;
        ibco:partOf ibc:ibc2021-1010.3.1.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0462 ;
        ibco:sourcePage 323 ;
        ibco:text "Exception: A breakout force in excess of 180 pounds (801 N) is permitted if the breakout force is reduced to not more than 130 pounds (578 N) when not less than one of the following conditions is satisfied:" .

    ibc:ibc2021-ch10-exception-0813 a ibco:Exception ;
        ibco:bbox "[319.801, 515.743, 369.798, 526.769]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0814,
            ibc:ibc2021-ch10-list_item-0815,
            ibc:ibc2021-ch10-list_item-0816,
            ibc:ibc2021-ch10-list_item-0817 ;
        ibco:partOf ibc:ibc2021-1020.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0814 ;
        ibco:sourcePage 337 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0819 a ibco:Exception ;
        ibco:bbox "[73.201, 106.796, 123.199, 117.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0820,
            ibc:ibc2021-ch10-list_item-0821,
            ibc:ibc2021-ch10-list_item-0822,
            ibc:ibc2021-ch10-list_item-0823 ;
        ibco:partOf ibc:ibc2021-1020.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0820 ;
        ibco:sourcePage 338 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0976 a ibco:Exception ;
        ibco:bbox "[334.193, 337.715, 384.19, 348.741]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0977,
            ibc:ibc2021-ch10-list_item-0978,
            ibc:ibc2021-ch10-list_item-0979,
            ibc:ibc2021-ch10-list_item-0985 ;
        ibco:partOf ibc:ibc2021-1027.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0977 ;
        ibco:sourcePage 344 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-1005 a ibco:Exception ;
        ibco:bbox "[73.181, 95.76, 304.163, 128.738]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1006,
            ibc:ibc2021-ch10-list_item-1007,
            ibc:ibc2021-ch10-list_item-1008,
            ibc:ibc2021-ch10-list_item-1009 ;
        ibco:partOf ibc:ibc2021-1028.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1006 ;
        ibco:sourcePage 346 ;
        ibco:text "Exception: Where access to a public way cannot be provided, a safe dispersal area shall be provided where all of the following are met:" .

    ibc:ibc2021-ch10-exception-1085 a ibco:Exception ;
        ibco:bbox "[70.811, 261.794, 120.69, 272.819]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1086,
            ibc:ibc2021-ch10-list_item-1087,
            ibc:ibc2021-ch10-list_item-1088,
            ibc:ibc2021-ch10-list_item-1089 ;
        ibco:partOf ibc:ibc2021-1030.9.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1086 ;
        ibco:sourcePage 349 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-list_item-0475 a ibco:ListItem ;
        ibco:bbox "[331.8, 676.753, 550.83, 720.766]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0476,
            ibc:ibc2021-ch10-list_item-0477,
            ibc:ibc2021-ch10-list_item-0478,
            ibc:ibc2021-ch10-list_item-0479 ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0476 ;
        ibco:sourcePage 323 ;
        ibco:text "4. The door shall be openable with a force not to exceed 15 pounds (67 N) when a force of 250 pounds (1100 N) is applied perpendicular to the door adjacent to the operating device." .

    ibc:ibc2021-ch10-list_item-0578 a ibco:ListItem ;
        ibco:bbox "[102.959, 69.725, 304.194, 91.786]",
            "[331.803, 667.756, 550.774, 700.734]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0579,
            ibc:ibc2021-ch10-list_item-0580,
            ibc:ibc2021-ch10-list_item-0581,
            ibc:ibc2021-ch10-list_item-0582 ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0573 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0579 ;
        ibco:sourcePage 327,
            328 ;
        ibco:text "5. Where a platform lift is in a stationary position and the floor of the platform lift serves as the upper landing of a stairway, handrails shall not be required on the stairway, provided that all of the following criteria are met:" .

    ibc:ibc2021-ch10-list_item-0737 a ibco:ListItem ;
        ibco:bbox "[381.949, 158.598, 565.158, 202.611]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0738,
            ibc:ibc2021-ch10-list_item-0739,
            ibc:ibc2021-ch10-list_item-0740,
            ibc:ibc2021-ch10-list_item-0741 ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0735 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0738 ;
        ibco:sourcePage 334 ;
        ibco:text "2. Means of egress are not prohibited through stockrooms in Group M occupancies where all of the following are met:" .

    ibc:ibc2021-ch10-list_item-0990 a ibco:ListItem ;
        ibco:bbox "[70.769, 453.77, 289.803, 519.735]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0991,
            ibc:ibc2021-ch10-list_item-0992,
            ibc:ibc2021-ch10-list_item-0993,
            ibc:ibc2021-ch10-list_item-0994 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0989 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0991 ;
        ibco:sourcePage 345 ;
        ibco:text "1. Not more than 50 percent of the number and minimum width or required capacity of interior exit stairways and ramps is permitted to egress through areas, including atriums, on the level of discharge provided that all of the following conditions are met:" .

    ibc:ibc2021-1008.3 a ibco:Provision ;
        ibco:bbox "[322.187, 216.565, 565.209, 249.826]" ;
        ibco:hasChild ibc:ibc2021-1008.3.1,
            ibc:ibc2021-1008.3.2,
            ibc:ibc2021-1008.3.3,
            ibc:ibc2021-1008.3.4,
            ibc:ibc2021-1008.3.5 ;
        ibco:heading "Emergency power for illumination" ;
        ibco:label "1008.3" ;
        ibco:partOf ibc:ibc2021-1008 ;
        ibco:precedes ibc:ibc2021-1008.3.1 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.3 Emergency power for illumination. The power supply for means of egress illumination shall normally be provided by the premises’ electrical supply." .

    ibc:ibc2021-1008.3.2 a ibco:Provision ;
        ibco:bbox "[334.207, 344.755, 565.206, 388.768]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0173,
            ibc:ibc2021-ch10-list_item-0174,
            ibc:ibc2021-ch10-list_item-0175,
            ibc:ibc2021-ch10-list_item-0176,
            ibc:ibc2021-ch10-list_item-0177 ;
        ibco:heading "Buildings" ;
        ibco:label "1008.3.2" ;
        ibco:partOf ibc:ibc2021-1008.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0173 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.3.2 Buildings. In the event of power supply failure in buildings that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:ibc2021-1008.3.3 a ibco:Provision ;
        ibco:bbox "[334.197, 507.82, 565.239, 540.798]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0179,
            ibc:ibc2021-ch10-list_item-0180,
            ibc:ibc2021-ch10-list_item-0181,
            ibc:ibc2021-ch10-list_item-0182,
            ibc:ibc2021-ch10-list_item-0183 ;
        ibco:heading "Rooms and spaces" ;
        ibco:label "1008.3.3" ;
        ibco:partOf ibc:ibc2021-1008.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0179 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.3.3 Rooms and spaces. In the event of power supply failure, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:ibc2021-1009.6 a ibco:Provision ;
        ibco:bbox "[61.176, 544.717, 304.187, 577.695]" ;
        ibco:hasChild ibc:ibc2021-1009.6.1,
            ibc:ibc2021-1009.6.2,
            ibc:ibc2021-1009.6.3,
            ibc:ibc2021-1009.6.4,
            ibc:ibc2021-1009.6.5 ;
        ibco:heading "Areas of refuge" ;
        ibco:label "1009.6" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-1009.6.1 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6 Areas of refuge. Every required area of refuge shall be accessible from the space it serves by an accessible means of egress." .

    ibc:ibc2021-1010 a ibco:Section ;
        ibco:bbox "[345.944, 525.667, 512.544, 547.698]" ;
        ibco:hasChild ibc:ibc2021-1010.1,
            ibc:ibc2021-1010.2,
            ibc:ibc2021-1010.3,
            ibc:ibc2021-1010.4,
            ibc:ibc2021-1010.5 ;
        ibco:heading "DOORS, GATES AND TURNSTILES" ;
        ibco:label "1010" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1010.1 ;
        ibco:sourcePage 315 ;
        ibco:text "SECTION 1010 DOORS, GATES AND TURNSTILES" .

    ibc:ibc2021-1010.2.9 a ibco:Provision ;
        ibco:bbox "[319.799, 694.782, 550.892, 727.76]",
            "[73.199, 69.725, 304.223, 102.822]" ;
        ibco:hasChild ibc:ibc2021-1010.2.9.1,
            ibc:ibc2021-1010.2.9.2,
            ibc:ibc2021-1010.2.9.3,
            ibc:ibc2021-1010.2.9.4,
            ibc:ibc2021-ch10-exception-0378 ;
        ibco:heading "Panic and fire exit hardware" ;
        ibco:label "1010.2.9" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0378 ;
        ibco:sourcePage 319,
            320 ;
        ibco:text "1010.2.9 Panic and fire exit hardware. Swinging doors serving a Group H occupancy and swinging doors serving rooms or spaces with an occupant load of 50 or more in a Group A or E occupancy shall not be provided with a latch or lock other than panic hardware or fire exit hardware." .

    ibc:ibc2021-1010.5.1 a ibco:Provision ;
        ibco:bbox "[73.197, 586.669, 304.27, 630.682]" ;
        ibco:hasChild ibc:ibc2021-1010.5.1.1,
            ibc:ibc2021-ch10-list_item-0486,
            ibc:ibc2021-ch10-list_item-0487,
            ibc:ibc2021-ch10-list_item-0488,
            ibc:ibc2021-ch10-list_item-0489 ;
        ibco:heading "Capacity" ;
        ibco:label "1010.5.1" ;
        ibco:partOf ibc:ibc2021-1010.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0486 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.5.1 Capacity. Each turnstile or similar device shall be credited with a capacity based on not more than a 50person occupant load where all of the following provisions are met:" .

    ibc:ibc2021-1011.5 a ibco:Provision ;
        ibco:bbox "[307.775, 368.248, 550.826, 390.31]" ;
        ibco:hasChild ibc:ibc2021-1011.5.1,
            ibc:ibc2021-1011.5.2,
            ibc:ibc2021-1011.5.3,
            ibc:ibc2021-1011.5.4,
            ibc:ibc2021-1011.5.5 ;
        ibco:heading "Stair treads and risers" ;
        ibco:label "1011.5" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-1011.5.1 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.5 Stair treads and risers. Stair treads and risers shall comply with Sections 1011.5.1 through 1011.5.5.3." .

    ibc:ibc2021-1011.7 a ibco:Provision ;
        ibco:bbox "[46.776, 219.683, 289.79, 252.78]" ;
        ibco:hasChild ibc:ibc2021-1011.7.1,
            ibc:ibc2021-1011.7.2,
            ibc:ibc2021-1011.7.3,
            ibc:ibc2021-1011.7.4,
            ibc:ibc2021-ch10-exception-0554 ;
        ibco:heading "Stairway construction" ;
        ibco:label "1011.7" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0554 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.7 Stairway construction. Stairways shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:ibc2021-1012.6 a ibco:Provision ;
        ibco:bbox "[307.783, 69.712, 550.906, 113.726]" ;
        ibco:hasChild ibc:ibc2021-1012.6.1,
            ibc:ibc2021-1012.6.2,
            ibc:ibc2021-1012.6.3,
            ibc:ibc2021-1012.6.4,
            ibc:ibc2021-1012.6.5 ;
        ibco:heading "Landings" ;
        ibco:label "1012.6" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.6.1 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6 Landings. Ramps shall have landings at the bottom and top of each ramp, points of turning, entrance, exits and at doors. Landings shall comply with Sections 1012.6.1 through 1012.6.5." .

    ibc:ibc2021-1015.8 a ibco:Provision ;
        ibco:bbox "[307.772, 583.703, 550.871, 660.704]" ;
        ibco:hasChild ibc:ibc2021-1015.8.1,
            ibc:ibc2021-ch10-list_item-0721,
            ibc:ibc2021-ch10-list_item-0722,
            ibc:ibc2021-ch10-list_item-0723,
            ibc:ibc2021-ch10-list_item-0724 ;
        ibco:heading "Window openings" ;
        ibco:label "1015.8" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0721 ;
        ibco:sourcePage 333 ;
        ibco:text "1015.8 Window openings. Windows in Group R-2 and R-3 buildings including dwelling units, where the bottom of the clear opening of an operable window is located less than 36 inches (914 mm) above the finished floor and more than 72 inches (1829 mm) above the finished grade or other surface below on the exterior of the building, shall comply with one of the following:" .

    ibc:ibc2021-1016.2 a ibco:Provision ;
        ibco:bbox "[61.207, 350.706, 304.153, 372.768]" ;
        ibco:hasChild ibc:ibc2021-1016.2.1,
            ibc:ibc2021-ch10-exception-0731,
            ibc:ibc2021-ch10-exception-0735,
            ibc:ibc2021-ch10-list_item-0729,
            ibc:ibc2021-ch10-list_item-0730 ;
        ibco:heading "Egress through intervening spaces" ;
        ibco:label "1016.2" ;
        ibco:partOf ibc:ibc2021-1016 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0729 ;
        ibco:sourcePage 334 ;
        ibco:text "1016.2 Egress through intervening spaces. Egress through intervening spaces shall comply with this section." .

    ibc:ibc2021-1018 a ibco:Section ;
        ibco:bbox "[147.959, 69.585, 217.433, 91.736]" ;
        ibco:hasChild ibc:ibc2021-1018.1,
            ibc:ibc2021-1018.2,
            ibc:ibc2021-1018.3,
            ibc:ibc2021-1018.4,
            ibc:ibc2021-1018.5 ;
        ibco:heading "AISLES" ;
        ibco:label "1018" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1018.1 ;
        ibco:sourcePage 336 ;
        ibco:text "SECTION 1018 AISLES" .

    ibc:ibc2021-1020.6.1 a ibco:Provision ;
        ibco:bbox "[73.195, 321.836, 304.301, 365.849]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0825,
            ibc:ibc2021-ch10-list_item-0826,
            ibc:ibc2021-ch10-list_item-0827,
            ibc:ibc2021-ch10-list_item-0828,
            ibc:ibc2021-ch10-list_item-0829 ;
        ibco:heading "Corridor ceiling" ;
        ibco:label "1020.6.1" ;
        ibco:partOf ibc:ibc2021-1020.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0825 ;
        ibco:sourcePage 338 ;
        ibco:text "1020.6.1 Corridor ceiling. Use of the space between the corridor ceiling and the floor or roof structure above as a return air plenum is permitted for one or more of the following conditions:" .

    ibc:ibc2021-1025 a ibco:Section ;
        ibco:bbox "[90.248, 237.685, 275.057, 259.717]" ;
        ibco:hasChild ibc:ibc2021-1025.1,
            ibc:ibc2021-1025.2,
            ibc:ibc2021-1025.3,
            ibc:ibc2021-1025.4,
            ibc:ibc2021-1025.5 ;
        ibco:heading "LUMINOUS EGRESS PATH MARKINGS" ;
