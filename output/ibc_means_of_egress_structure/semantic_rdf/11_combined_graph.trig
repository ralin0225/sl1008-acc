    ibc:concept-upon-actuation-of-a-clearly-identified-manual-release-device-with-ready-access-that-results-in-direct-interruption-of-power-to-each-secured-physical-barrier-after-which-such-barriers-remain-in-the-open-position-for-not-less-than-30-seconds-the-manual-release-device a ibco:DomainConcept ;
        rdfs:label "Upon actuation of a clearly identified manual release device with ready access that results in direct interruption of power to each secured physical barrier, after which such barriers remain in the open position for not less than 30 seconds. The manual release device" .

    ibc:concept-where a ibco:DomainConcept ;
        rdfs:label "Where" .

    ibc:concept-where-a-landing-turns-90-degrees-1-57-rad-or-more-the-minimum-landing-depth-in-accordance-with-this-section a ibco:DomainConcept ;
        rdfs:label "Where a landing turns 90 degrees (1.57 rad) or more, the minimum landing depth in accordance with this section" .

    ibc:concept-where-a-wall-mounted-demarcation-line-transitions-to-a-floor-mounted-demarcation-line-or-vice-versa-the-wall-mounted-demarcation-line a ibco:DomainConcept ;
        rdfs:label "Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line" .

    ibc:concept-where-aisles-converge-to-form-a-single-path-of-egress-travel-the-required-capacity-of-that-path a ibco:DomainConcept ;
        rdfs:label "Where aisles converge to form a single path of egress travel, the required capacity of that path" .

    ibc:concept-where-bars-grilles-covers-screens-or-similar-devices-are-placed-over-emergency-escape-and-rescue-openings-or-area-wells-that-serve-such-openings-the-minimum-net-clear-opening-size a ibco:DomainConcept ;
        rdfs:label "Where bars, grilles, covers, screens or similar devices are placed over emergency escape and rescue openings or area wells that serve such openings, the minimum net clear opening size" .

    ibc:concept-where-electrical-systems-that-monitor-or-record-egress-activity-are-incorporated-the-locking-system a ibco:DomainConcept ;
        rdfs:label "Where electrical systems that monitor or record egress activity are incorporated, the locking system" .

    ibc:concept-where-manually-operated-bolt-locks-are a ibco:DomainConcept ;
        rdfs:label "Where manually operated bolt locks are" .

    ibc:concept-where-one-of-the-two-paths-of-travel-is-across-the-aisle-through-a-row-of-seats-to-another-aisle-there a ibco:DomainConcept ;
        rdfs:label "Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there" .

    ibc:concept-where-seating-is-located-at-a-table-or-counter-and-is-adjacent-to-an-aisle-or-aisle-accessway-the-measurement-of-required-clear-width-of-the-aisle-or-aisle-accessway a ibco:DomainConcept ;
        rdfs:label "Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway" .

    ibc:concept-window-opening-control-devices a ibco:DomainConcept ;
        rdfs:label "Window opening control devices" .

    ibc:sem-ibc2021-1001.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Buildings or portions thereof shall be provided with a means of egress system as required by this chapter." .

    ibc:sem-ibc2021-1001.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The provisions of this chapter shall control the design, construction and arrangement of means of egress components required to provide an approved means of egress from structures and portions thereof." .

    ibc:sem-ibc2021-1001.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "It shall be unlawful to alter a building or structure in a manner that will reduce the number of exits or the minimum width or required capacity of the means of egress to less than required by this code." .

    ibc:sem-ibc2021-1002.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Means of egress shall be maintained in accordance with the International Fire Code." .

    ibc:sem-ibc2021-1002.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Fire safety and evacuation plans shall be provided for all occupancies and buildings where required by the International Fire Code." .

    ibc:sem-ibc2021-1002.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such fire safety and evacuation plans shall comply with the applicable provisions of Sections 401.2 and 404 of the International Fire Code." .

    ibc:sem-ibc2021-1002.2-condition-1 a ibco:Condition ;
        ibco:text "where required by the International Fire Code." .

    ibc:sem-ibc2021-1003.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The general requirements specified in Sections 1003 through 1015 shall apply to all three elements of the means of egress system, in addition to those specific requirements for the exit access, the exit and the exit discharge detailed elsewhere in this chapter." .

    ibc:sem-ibc2021-1003.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The means of egress shall have a ceiling height of not less than 7 feet 6 inches (2286 mm) above the finished floor." .

    ibc:sem-ibc2021-1003.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1003.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1003.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Protruding objects on circulation paths shall comply with the requirements of Sections 1003.3.1 through 1003.3.4." .

    ibc:sem-ibc2021-1003.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Protruding objects are permitted to extend below the minimum ceiling height required by Section 1003.2 where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways." .

    ibc:sem-ibc2021-1003.3.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Not more than 50 percent of the ceiling area of a means of egress shall be reduced in height by protruding objects." .

    ibc:sem-ibc2021-1003.3.1-condition-1 a ibco:Condition ;
        ibco:text "where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways." .

    ibc:sem-ibc2021-1003.3.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1003.3.1-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1003.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A free-standing object mounted on a post or pylon shall not overhang that post or pylon more than 4 inches (102 mm) where the lowest point of the leading edge is more than 27 inches (686 mm) and less than 80 inches (2032 mm) above the finished floor." .

    ibc:sem-ibc2021-1003.3.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a sign or other obstruction is mounted between posts or pylons and the clear distance between the posts or pylons is greater than 12 inches (305 mm), the lowest edge of such sign or obstruction shall be 27 inches (686 mm) maximum or 80 inches (2032 mm) minimum above the finished floor or ground." .

    ibc:sem-ibc2021-1003.3.2-condition-1 a ibco:Condition ;
        ibco:text "where the lowest point of the leading edge is more than 27 inches (686 mm) and less than 80 inches (2032 mm) above the finished floor." .

    ibc:sem-ibc2021-1003.3.2-condition-2 a ibco:Condition ;
        ibco:text "Where a sign or other obstruction is mounted between posts or pylons and the clear distance between the posts or pylons is greater than 12 inches (305 mm), the lowest edge of such sign or obstruction shall be 27 inches (686 mm) maximum or 80 inches (2032 mm) minimum above the finished floor or ground." .

    ibc:sem-ibc2021-1003.3.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1003.3.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 27.0 .

    ibc:sem-ibc2021-1003.3.2-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1003.3.2-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1003.3.2-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 27.0 .

    ibc:sem-ibc2021-1003.3.2-measurement-6 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1003.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Objects with leading edges more than 27 inches (685 mm) and not more than 80 inches (2030 mm) above the finished floor shall not project horizontally more than 4 inches (102 mm) into the circulation path." .

    ibc:sem-ibc2021-1003.3.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 27.0 .

    ibc:sem-ibc2021-1003.3.3-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1003.3.3-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1003.3.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Protruding objects shall not reduce the minimum clear width of accessible routes." .

    ibc:sem-ibc2021-1003.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Circulation paths of the means of egress shall have a slip-resistant surface and be securely attached." .

    ibc:sem-ibc2021-1003.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where changes in elevation of less than 12 inches (305 mm) exist in the means of egress, sloped surfaces shall be used." .

    ibc:sem-ibc2021-1003.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the slope is greater than one unit vertical in 20 units horizontal (5-percent slope), ramps complying with Section 1012 shall be used." .

    ibc:sem-ibc2021-1003.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the difference in elevation is 6 inches (152 mm) or less, the ramp shall be equipped with either handrails or floor finish materials that contrast with adjacent floor finish materials." .

    ibc:sem-ibc2021-1003.5-condition-1 a ibco:Condition ;
        ibco:text "Where changes in elevation of less than 12 inches (305 mm) exist in the means of egress, sloped surfaces shall be used." .

    ibc:sem-ibc2021-1003.5-condition-2 a ibco:Condition ;
        ibco:text "Where the slope is greater than one unit vertical in 20 units horizontal (5-percent slope), ramps complying with Section 1012 shall be used." .

    ibc:sem-ibc2021-1003.5-condition-3 a ibco:Condition ;
        ibco:text "Where the difference in elevation is 6 inches (152 mm) or less, the ramp shall be equipped with either handrails or floor finish materials that contrast with adjacent floor finish materials." .

    ibc:sem-ibc2021-1003.5-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1003.5-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1003.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The path of egress travel along a means of egress shall not be interrupted by a building element other than a means of egress component as specified in this chapter." .

    ibc:sem-ibc2021-1003.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Obstructions shall not be placed in the minimum width or required capacity of a means of egress component except projections permitted by this chapter." .

    ibc:sem-ibc2021-1003.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The minimum width or required capacity of a means of egress system shall not be diminished along the path of egress travel." .

    ibc:sem-ibc2021-1003.6-condition-1 a ibco:Condition ;
        ibco:text "other than a means of egress component as specified in this chapter." .

    ibc:sem-ibc2021-1003.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Elevators, escalators and moving walks shall not be used as a component of a required means of egress from any other part of the building." .

    ibc:sem-ibc2021-1004.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In determining means of egress requirements, the number of occupants for whom means of egress facilities are provided shall be determined in accordance with this section." .

    ibc:sem-ibc2021-1004.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section." .

    ibc:sem-ibc2021-1004.2-condition-1 a ibco:Condition ;
        ibco:text "Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section." .

    ibc:sem-ibc2021-1004.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces." .

    ibc:sem-ibc2021-1004.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Design of egress path capacity shall be based on the cumulative portion of occupant loads of all rooms, areas or spaces to that point along the path of egress travel." .

    ibc:sem-ibc2021-1004.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces." .

    ibc:sem-ibc2021-1004.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "That portion of the occupant load of a mezzanine with required egress through a room, area or space on an adjacent level shall be added to the occupant load of that room, area or space." .

    ibc:sem-ibc2021-1004.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Other than for the egress components designed for convergence in accordance with Section 1005.6, the occupant load from separate stories shall not be added." .

    ibc:sem-ibc2021-1004.2.3-condition-1 a ibco:Condition ;
        ibco:text "Other than for the egress components designed for convergence in accordance with Section 1005." .

    ibc:sem-ibc2021-1004.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently." .

    ibc:sem-ibc2021-1004.3-condition-1 a ibco:Condition ;
        ibco:text "Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently." .

    ibc:sem-ibc2021-1004.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a building contains two or more occupancies, the means of egress requirements shall apply to each portion of the building based on the occupancy of that space." .

    ibc:sem-ibc2021-1004.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two or more occupancies utilize portions of the same means of egress system, those egress components shall meet the more stringent requirements of all occupancies that are served." .

    ibc:sem-ibc2021-1004.4-condition-1 a ibco:Condition ;
        ibco:text "Where a building contains two or more occupancies, the means of egress requirements shall apply to each portion of the building based on the occupancy of that space." .

    ibc:sem-ibc2021-1004.4-condition-2 a ibco:Condition ;
        ibco:text "Where two or more occupancies utilize portions of the same means of egress system, those egress components shall meet the more stringent requirements of all occupancies that are served." .

    ibc:sem-ibc2021-1004.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The number of occupants shall be computed at the rate of one occupant per unit of area as prescribed in Table 1004.5." .

    ibc:sem-ibc2021-1004.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For areas without fixed seating, the occupant load shall be not less than that number determined by dividing the floor area under consideration by the occupant load factor assigned to the function of the space as set forth in Table 1004.5." .

    ibc:sem-ibc2021-1004.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an intended function is not listed in Table 1004.5, the building official shall establish a function based on a listed function that most nearly resembles the intended function." .

    ibc:sem-ibc2021-1004.5-condition-1 a ibco:Condition ;
        ibco:text "Where an intended function is not listed in Table 1004." .

    ibc:sem-ibc2021-1004.5.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "The occupant load permitted in any building, or portion thereof, is permitted to be increased from that number established for the occupancies in Table 1004.5, provided that all other requirements of the code are met based on such modified number and the occupant load does not exceed one occupant per 7 square feet (0.65 m2) of occupiable floor space." .

    ibc:sem-ibc2021-1004.5.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where required by the building official, an approved aisle, seating or fixed equipment diagram substantiating any increase in occupant load shall be submitted." .

    ibc:sem-ibc2021-1004.5.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where required by the building official, such diagram shall be posted." .

    ibc:sem-ibc2021-1004.5.1-condition-1 a ibco:Condition ;
        ibco:text "Where required by the building official, an approved aisle, seating or fixed equipment diagram substantiating any increase in occupant load shall be submitted." .

    ibc:sem-ibc2021-1004.5.1-condition-2 a ibco:Condition ;
        ibco:text "Where required by the building official, such diagram shall be posted." .

    ibc:sem-ibc2021-1004.5.1-condition-3 a ibco:Condition ;
        ibco:text "provided that all other requirements of the code are met based on such modified number and the occupant load does not exceed one occupant per 7 square feet (0." .

    ibc:sem-ibc2021-1004.5.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1004.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For areas having fixed seats and aisles, the occupant load shall be determined by the number of fixed seats installed therein." .

    ibc:sem-ibc2021-1004.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The occupant load for areas in which fixed seating is not installed, such as waiting spaces, shall be determined in accordance with Section 1004.5 and added to the number of fixed seats." .

    ibc:sem-ibc2021-1004.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The occupant load of wheelchair spaces and the associated companion seat shall be based on one occupant for each wheelchair space and one occupant for the associated companion seat provided in accordance with Section 1109.2.3." .

    ibc:sem-ibc2021-1004.6-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For areas having fixed seating without dividing arms, the occupant load shall be not less than the number of seats based on one person for each 18 inches (457 mm) of seating length." .

    ibc:sem-ibc2021-1004.6-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The occupant load of seating booths shall be based on one person for each 24 inches (610 mm) of booth seat length measured at the backrest of the seating booth." .

    ibc:sem-ibc2021-1004.6-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1004.6-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 24.0 .

    ibc:sem-ibc2021-1004.6-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1004.6-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1004.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Yards, patios, occupied roofs, courts and similar outdoor areas accessible to and usable by the building occupants shall be provided with means of egress as required by this chapter." .

    ibc:sem-ibc2021-1004.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The occupant load of such outdoor areas shall be assigned by the building official in accordance with the anticipated use." .

    ibc:sem-ibc2021-1004.7-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where outdoor areas are to be used by persons in addition to the occupants of the building, and the path of egress travel from the outdoor areas passes through the building, means of egress requirements for the building shall be based on the sum of the occupant loads of the building plus the outdoor areas." .

    ibc:sem-ibc2021-1004.7-condition-1 a ibco:Condition ;
        ibco:text "Where outdoor areas are to be used by persons in addition to the occupants of the building, and the path of egress travel from the outdoor areas passes through the building, means of egress requirements for the building shall be based on the sum of the occupant loads of the building plus the outdoor areas." .

    ibc:sem-ibc2021-1004.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The occupant load factor for concentrated business use shall be applied to telephone call centers, trading floors, electronic data processing centers and similar business use areas with a higher density of occupants than would normally be expected in a typical business occupancy environment." .

    ibc:sem-ibc2021-1004.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where approved by the building official, the occupant load for concentrated business use areas shall be the actual occupant load, but not less than one occupant per 50 square feet (4.65 m2) of gross occupiable floor space." .

    ibc:sem-ibc2021-1004.8-condition-1 a ibco:Condition ;
        ibco:text "Where approved by the building official, the occupant load for concentrated business use areas shall be the actual occupant load, but not less than one occupant per 50 square feet (4." .

    ibc:sem-ibc2021-1004.8-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1004.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every room or space that is an assembly occupancy shall have the occupant load of the room or space posted in a conspicuous place, near the main exit or exit access doorway from the room or space, for the intended configurations." .

    ibc:sem-ibc2021-1004.9-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent." .

    ibc:sem-ibc2021-1005.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "All portions of the means of egress system shall be sized in accordance with this section." .

    ibc:sem-ibc2021-1005.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width, in inches (mm), of any means of egress components shall be not less than that specified for such component, elsewhere in this code." .

    ibc:sem-ibc2021-1005.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity, in inches (mm), of the means of egress for any room, area, space or story shall be not less than that determined in accordance with Sections 1005.3.1 and 1005.3.2." .

    ibc:sem-ibc2021-1005.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.3 inch (7.6 mm) per occupant." .

    ibc:sem-ibc2021-1005.3.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where stairways serve more than one story, only the occupant load of each story considered individually shall be used in calculating the required capacity of the stairways serving that story." .

    ibc:sem-ibc2021-1005.3.1-condition-1 a ibco:Condition ;
        ibco:text "Where stairways serve more than one story, only the occupant load of each story considered individually shall be used in calculating the required capacity of the stairways serving that story." .

    ibc:sem-ibc2021-1005.3.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.3 .

    ibc:sem-ibc2021-1005.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant." .

    ibc:sem-ibc2021-1005.3.2-condition-1 a ibco:Condition ;
        ibco:text "other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0." .

    ibc:sem-ibc2021-1005.3.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.2 .

    ibc:sem-ibc2021-1005.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The minimum width or required capacity of the means of egress required from any story of a building shall not be reduced along the path of egress travel until arrival at the public way." .

    ibc:sem-ibc2021-1005.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width." .

    ibc:sem-ibc2021-1005.5-condition-1 a ibco:Condition ;
        ibco:text "Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width." .

    ibc:sem-ibc2021-1005.5-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1005.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger." .

    ibc:sem-ibc2021-1005.6-condition-1 a ibco:Condition ;
        ibco:text "Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger." .

    ibc:sem-ibc2021-1005.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Encroachments into the required means of egress width shall be in accordance with the provisions of this section." .

    ibc:sem-ibc2021-1005.7.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Doors, when fully opened, shall not reduce the required width by more than 7 inches (178 mm)." .

    ibc:sem-ibc2021-1005.7.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Doors in any position shall not reduce the required width by more than one-half." .

    ibc:sem-ibc2021-1005.7.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1005.7.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrail projections shall be in accordance with the provisions of Section 1014.8." .

    ibc:sem-ibc2021-1005.7.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Other nonstructural projections such as trim and similar decorative features shall be permitted to project into the required width not more than 11/2 inches (38 mm) on each side." .

    ibc:sem-ibc2021-1005.7.2-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1005.7.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Protruding objects shall comply with the applicable requirements of Section 1003.3." .

    ibc:sem-ibc2021-1006.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The number of exits or exit access doorways required within the means of egress system shall comply with the provisions of Section 1006.2 for spaces, including mezzanines, and Section 1006.3 for stories or occupied roofs." .

    ibc:sem-ibc2021-1006.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Rooms, areas or spaces, including mezzanines, within a story or basement shall be provided with the number of exits or access to exits in accordance with this section." .

    ibc:sem-ibc2021-1006.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Two exits or exit access doorways from any space shall be provided where the design occupant load or the common path of egress travel distance exceeds the values listed in Table 1006.2.1." .

    ibc:sem-ibc2021-1006.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The cumulative occupant load from adjacent rooms, areas or spaces shall be determined in accordance with Section 1004.2." .

    ibc:sem-ibc2021-1006.2.1-condition-1 a ibco:Condition ;
        ibco:text "where the design occupant load or the common path of egress travel distance exceeds the values listed in Table 1006." .

    ibc:sem-ibc2021-1006.2.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Three exits or exit access doorways shall be provided from any space with an occupant load of 501 to 1,000." .

    ibc:sem-ibc2021-1006.2.1.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Four exits or exit access doorways shall be provided from any space with an occupant load greater than 1,000." .

    ibc:sem-ibc2021-1006.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The numbers, configuration and types of components of exits or access to exits shall be provided in the uses described in Sections 1006.2.2.1 through 1006.2.2.6." .

    ibc:sem-ibc2021-1006.2.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Two exit access doorways are required in boiler, incinerator and furnace rooms where the area is over 500 square feet (46 m2) and any fuel-fired equipment exceeds 400,000 British thermal units (Btu) (422 000 KJ) input capacity." .

    ibc:sem-ibc2021-1006.2.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two exit access doorways are required, one is permitted to be a fixed ladder or an alternating tread device." .

    ibc:sem-ibc2021-1006.2.2.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access doorways shall be separated by a horizontal distance equal to one-half the length of the maximum overall diagonal dimension of the room." .

    ibc:sem-ibc2021-1006.2.2.1-condition-1 a ibco:Condition ;
        ibco:text "where the area is over 500 square feet (46 m2) and any fuel-fired equipment exceeds 400,000 British thermal units (Btu) (422 000 KJ) input capacity." .

    ibc:sem-ibc2021-1006.2.2.1-condition-2 a ibco:Condition ;
        ibco:text "Where two exit access doorways are required, one is permitted to be a fixed ladder or an alternating tread device." .

    ibc:sem-ibc2021-1006.2.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 500.0 .

    ibc:sem-ibc2021-1006.2.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exits or exit access doorways." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two exit access doorways are required, one such doorway is permitted to be served by a fixed ladder or an alternating tread device." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access doorways shall be separated by a horizontal distance equal to one-half the maximum horizontal dimension of the room." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "All portions of machinery rooms shall be within 150 feet (45 720 mm) of an exit or exit access doorway." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-5 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "An increase in exit access travel distance is permitted in accordance with Section 1017.1." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-6 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit and exit access doorways shall swing in the direction of egress travel and shall be equipped with panic hardware, regardless of the occupant load served." .

    ibc:sem-ibc2021-1006.2.2.2-atomic-7 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit and exit access doorways shall be tight fitting and self-closing." .

    ibc:sem-ibc2021-1006.2.2.2-condition-1 a ibco:Condition ;
        ibco:text "Where two exit access doorways are required, one such doorway is permitted to be served by a fixed ladder or an alternating tread device." .

    ibc:sem-ibc2021-1006.2.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-1006.2.2.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 150.0 .

    ibc:sem-ibc2021-1006.2.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Rooms or spaces having a floor area larger than 1,000 square feet (93 m2), containing a refrigerant evaporator and maintained at a temperature below 68°F (20°C), shall have access to not less than two exits or exit access doorways." .

    ibc:sem-ibc2021-1006.2.2.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access travel distance shall be determined as specified in Section 1017.1, but all portions of a refrigerated room or space shall be within 150 feet (45 720 mm) of an exit or exit access doorway where such rooms are not protected by an approved automatic TABLE 1006.2.1 sprinkler system." .

    ibc:sem-ibc2021-1006.2.2.3-condition-1 a ibco:Condition ;
        ibco:text "where such rooms are not protected by an approved automatic TABLE 1006." .

    ibc:sem-ibc2021-1006.2.2.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-1006.2.2.3-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 150.0 .

    ibc:sem-ibc2021-1006.2.2.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "T he location and number of exit or exit access doorways shall be provided for electrical rooms in accordance with Section 110.26 of NFPA 70 for electrical equipment rated 1,000 volts or less, and Section 110.33 of NFPA 70 for electrical equipment rated over 1,000 volts." .

    ibc:sem-ibc2021-1006.2.2.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Panic hardware shall be provided where required in accordance with Section 1010.2.9.2. " .

    ibc:sem-ibc2021-1006.2.2.4-condition-1 a ibco:Condition ;
        ibco:text "where required in accordance with Section 1010." .

    ibc:sem-ibc2021-1006.2.2.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Vehicular ramps shall not be considered as an exit access ramp unless pedestrian facilities are provided." .

    ibc:sem-ibc2021-1006.2.2.5-condition-1 a ibco:Condition ;
        ibco:text "unless pedestrian facilities are provided." .

    ibc:sem-ibc2021-1006.2.2.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where Group R-3 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with Section 903.3.1.3, the exit access travel distance for Group R-3 shall be not more than 125 feet (38 100 mm)." .

    ibc:sem-ibc2021-1006.2.2.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where Group R-4 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with SPACES WITH ONE EXIT OR EXIT ACCESS DOORWAY For SI: 1 foot = 304.8 mm." .

    ibc:sem-ibc2021-1006.2.2.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "NP = Not Permitted." .

    ibc:sem-ibc2021-1006.2.2.6-condition-1 a ibco:Condition ;
        ibco:text "Where Group R-3 occupancies are permitted by Section 903." .

    ibc:sem-ibc2021-1006.2.2.6-condition-2 a ibco:Condition ;
        ibco:text "Where Group R-4 occupancies are permitted by Section 903." .

    ibc:sem-ibc2021-1006.2.2.6-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 125.0 .

    ibc:sem-ibc2021-1006.2.2.6-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1006.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The means of egress system serving any story or occupied roof shall be provided with the number of separate and distinct exits or access to exits based on the aggregate occupant load served in accordance with this section." .

    ibc:sem-ibc2021-1006.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story." .

    ibc:sem-ibc2021-1006.3.1-condition-1 a ibco:Condition ;
        ibco:text "Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story." .

    ibc:sem-ibc2021-1006.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The path of egress travel to an exit shall not pass through more than one adjacent story." .

    ibc:sem-ibc2021-1006.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each story and occupied roof shall have the minimum number of separate and distinct exits, or access to exits, as specified in Table 1006.3.3." .

    ibc:sem-ibc2021-1006.3.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A single exit or access to a single exit shall be permitted in accordance with Section 1006.3.4." .

    ibc:sem-ibc2021-1006.3.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required number of exits, or exit access stairways or ramps providing access to exits, from any story or occupied roof shall be maintained until arrival at the exit discharge or a public way." .

    ibc:sem-ibc2021-1006.3.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A single exit or access to a single exit shall be permitted from any story or occupied roof where one of the following conditions exists:" .

    ibc:sem-ibc2021-1006.3.4-condition-1 a ibco:Condition ;
        ibco:text "where one of the following conditions exists:" .

    ibc:sem-ibc2021-1006.3.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where one exit, or exit access stairway or ramp providing access to exits at other stories, is permitted to serve individual stories, mixed occupancies shall be permitted to be served by single exits provided that each individual occupancy complies with the applicable requirements of Table 1006.3.4(1) or 1006.3.4(2) for that occupancy." .

    ibc:sem-ibc2021-1006.3.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where applicable, cumulative occupant loads from adjacent occupancies shall be considered to be in accordance with the provisions of Section 1004.1." .

    ibc:sem-ibc2021-1006.3.4.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In each story of a mixed occupancy building, the maximum number of occupants served by a single exit shall be such that the sum of the ratios of the calculated number of occupants of the space divided by the allowable number of occupants indicated in Table 1006.3.4(2) for each occupancy does not exceed one." .

    ibc:sem-ibc2021-1006.3.4.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "NP = Not Permitted." .

    ibc:sem-ibc2021-1006.3.4.1-condition-1 a ibco:Condition ;
        ibco:text "Where one exit, or exit access stairway or ramp providing access to exits at other stories, is permitted to serve individual stories, mixed occupancies shall be permitted to be served by single exits provided that each individual occupancy complies with the applicable requirements of Table 1006." .

    ibc:sem-ibc2021-1006.3.4.1-condition-2 a ibco:Condition ;
        ibco:text "Where applicable, cumulative occupant loads from adjacent occupancies shall be considered to be in accordance with the provisions of Section 1004." .

    ibc:sem-ibc2021-1006.3.4.1-condition-3 a ibco:Condition ;
        ibco:text "Where dwelling units are located on a story with other occupancies, the actual number of dwelling units divided by four plus the ratio from the other occupancy does not exceed one." .

    ibc:sem-ibc2021-1006.3.4.1-condition-4 a ibco:Condition ;
        ibco:text "provided that each individual occupancy complies with the applicable requirements of Table 1006." .

    ibc:sem-ibc2021-1006.3.4.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1007.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exits, exit access doorways, and exit access stairways and ramps serving spaces, including individual building stories, shall be separated in accordance with the provisions of this section." .

    ibc:sem-ibc2021-1007.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two exits, exit access doorways, exit access stairways or ramps, or any combination thereof, are required from any portion of the exit access, they shall be placed a distance apart equal to not less than one-half of the length of the maximum overall diagonal dimension of the building or area to be served measured in a straight line between them." .

    ibc:sem-ibc2021-1007.1.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interlocking or scissor stairways shall be counted as one exit stairway." .

    ibc:sem-ibc2021-1007.1.1-condition-1 a ibco:Condition ;
        ibco:text "Where two exits, exit access doorways, exit access stairways or ramps, or any combination thereof, are required from any portion of the exit access, they shall be placed a distance apart equal to not less than one-half of the length of the maximum overall diagonal dimension of the building or area to be served measured in a straight line between them." .

    ibc:sem-ibc2021-1007.1.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The separation distance required in Section 1007.1.1 shall be measured in accordance with the following:" .

    ibc:sem-ibc2021-1007.1.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where access to three or more exits is required, not less than two exit or exit access doorways shall be arranged in accordance with the provisions of Section 1007.1.1." .

    ibc:sem-ibc2021-1007.1.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Additional required exit or exit access doorways shall be arranged a reasonable distance apart so that if one becomes blocked, the others will be available." .

    ibc:sem-ibc2021-1007.1.2-condition-1 a ibco:Condition ;
        ibco:text "Where access to three or more exits is required, not less than two exit or exit access doorways shall be arranged in accordance with the provisions of Section 1007." .

    ibc:sem-ibc2021-1007.1.2-condition-2 a ibco:Condition ;
        ibco:text "if one becomes blocked, the others will be available." .

    ibc:sem-ibc2021-1007.1.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps." .

    ibc:sem-ibc2021-1007.1.3-condition-1 a ibco:Condition ;
        ibco:text "Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps." .

    ibc:sem-ibc2021-1007.1.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007.1.3." .

    ibc:sem-ibc2021-1007.1.3.1-condition-1 a ibco:Condition ;
        ibco:text "Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007." .

    ibc:sem-ibc2021-1008.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Illumination shall be provided in the means of egress in accordance with Section 1008.2." .

    ibc:sem-ibc2021-1008.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Under emergency power, means of egress illumination shall comply with Section 1008.3." .

    ibc:sem-ibc2021-1008.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The means of egress serving a room or space shall be illuminated at all times that the room or space is occupied." .

    ibc:sem-ibc2021-1008.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The means of egress illumination level shall be not less than 1 footcandle (11 lux) at the walking surface." .

    ibc:sem-ibc2021-1008.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Along exit access stairways, exit stairways and at their required landings, the illumination level shall not be less than 10 footcandles (108 lux) at the walking surface when the stairway is in use." .

    ibc:sem-ibc2021-1008.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-2 occupancies where two or more exits are required, on the exterior landings required by Section 1010.1.5, means of egress illumination levels for the exit discharge shall be provided such that failure of a single lamp in a luminaire shall not reduce the illumination level on that landing to less than 1 footcandle (11 lux)." .

    ibc:sem-ibc2021-1008.2.2-condition-1 a ibco:Condition ;
        ibco:text "where two or more exits are required, on the exterior landings required by Section 1010." .

    ibc:sem-ibc2021-1008.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Illumination shall be provided along the path of travel for the exit discharge from each exit to the public way." .

    ibc:sem-ibc2021-1008.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The power supply for means of egress illumination shall normally be provided by the premises’ electrical supply." .

    ibc:sem-ibc2021-1008.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In the event of power supply failure in rooms and spaces that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In the event of power supply failure in buildings that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In the event of power supply failure, an emergency electrical system shall automatically illuminate all of the following areas:" .

    ibc:sem-ibc2021-1008.3.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The emergency power system shall provide power for a duration of not less than 90 minutes and shall consist of storage batteries, unit equipment or an on-site generator." .

    ibc:sem-ibc2021-1008.3.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The installation of the emergency power system shall be in accordance with Section 2702." .

    ibc:sem-ibc2021-1008.3.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency lighting facilities shall be arranged to provide initial illumination that is not less than an average of 1 footcandle (11 lux) and a minimum at any point of 0.1 footcandle (1 lux) measured along the path of egress at floor level." .

    ibc:sem-ibc2021-1008.3.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Illumination levels shall be permitted to decline to 0.6 footcandle (6 lux) average and a minimum at any point of 0.06 footcandle (0.6 lux) at the end of the emergency lighting time duration." .

    ibc:sem-ibc2021-1008.3.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A maximum-to-minimum illumination uniformity ratio of 40 to 1 shall not be exceeded." .

    ibc:sem-ibc2021-1008.3.5-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "In Group I-2 occupancies, failure of a single lamp in a luminaire shall not reduce the illumination level to less than 0.2 footcandle (2.2 lux)." .

    ibc:sem-ibc2021-1009.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Accessible means of egress shall comply with this section." .

    ibc:sem-ibc2021-1009.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Accessible spaces shall be provided with not less than one accessible means of egress." .

    ibc:sem-ibc2021-1009.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress." .

    ibc:sem-ibc2021-1009.1-condition-1 a ibco:Condition ;
        ibco:text "Where more than one means of egress is required by Section 1006." .

    ibc:sem-ibc2021-1009.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Directional signage indicating the location of all other means of egress and which of those are accessible means of egress shall be provided at the following:" .

    ibc:sem-ibc2021-1009.11-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In areas of refuge and exterior areas for assisted rescue, instructions on the use of the area under emergency conditions shall be posted." .

    ibc:sem-ibc2021-1009.11-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Signage shall comply with the ICC A117.1 requirements for visual characters." .

    ibc:sem-ibc2021-1009.11-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The instructions shall include all of the following:" .

    ibc:sem-ibc2021-1009.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each required accessible means of egress shall be continuous to a public way and shall consist of one or more of the following components:" .

    ibc:sem-ibc2021-1009.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In buildings where a required accessible floor or occupied roof is four or more stories above or below a level of exit discharge, not less than one required accessible means of egress shall be an elevator complying with Section 1009.4." .

    ibc:sem-ibc2021-1009.2.1-condition-1 a ibco:Condition ;
        ibco:text "where a required accessible floor or occupied roof is four or more stories above or below a level of exit discharge, not less than one required accessible means of egress shall be an elevator complying with Section 1009." .

    ibc:sem-ibc2021-1009.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In order to be considered part of an accessible means of egress, a stairway between stories shall comply with Sections 1009.3.1 through 1009.3.3." .

    ibc:sem-ibc2021-1009.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Exit access stairways that connect levels in the same story are not permitted as part of an accessible means of egress." .

    ibc:sem-ibc2021-1009.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways shall have a clear width of 48 inches (1219 mm) minimum between handrails." .

    ibc:sem-ibc2021-1009.3.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-1009.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways shall either incorporate an area of refuge within an enlarged floor-level landing or shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:sem-ibc2021-1009.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In order to be considered part of an accessible means of egress, an elevator shall comply with Sections 1009.4.1 and 1009.4.2." .

    ibc:sem-ibc2021-1009.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The elevator shall meet the emergency operation and signaling device requirements of Section 2.27 of ASME A17.1/CSA B44." .

    ibc:sem-ibc2021-1009.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Standby power shall be provided in accordance with Chapter 27 and Section 3003." .

    ibc:sem-ibc2021-1009.4.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The elevator shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:sem-ibc2021-1009.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Platform lifts shall be permitted to serve as part of an accessible means of egress where allowed as part of a required accessible route in Section 1110.9 except for Item 10." .

    ibc:sem-ibc2021-1009.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Standby power for the platform lift shall be provided in accordance with Chapter 27." .

    ibc:sem-ibc2021-1009.5-condition-1 a ibco:Condition ;
        ibco:text "where allowed as part of a required accessible route in Section 1110." .

    ibc:sem-ibc2021-1009.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every required area of refuge shall be accessible from the space it serves by an accessible means of egress." .

    ibc:sem-ibc2021-1009.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The maximum travel distance from any accessible space to an area of refuge shall not exceed the exit access travel distance permitted for the occupancy in accordance with Section 1017.1." .

    ibc:sem-ibc2021-1009.6.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every required area of refuge shall have direct access to a stairway complying with Sections 1009.3 and 1023 or an elevator complying with Section 1009.4." .

    ibc:sem-ibc2021-1009.6.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each area of refuge shall be sized to accommodate one wheelchair space of 30 inches by 52 inches (762 mm by 1320 mm) for each 200 occupants or portion thereof, based on the occupant load of the area of refuge and areas served by the area of refuge." .

    ibc:sem-ibc2021-1009.6.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Such wheelchair spaces shall not reduce the means of egress minimum width or required capacity." .

    ibc:sem-ibc2021-1009.6.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Access to any of the required wheelchair spaces in an area of refuge shall not be obstructed by more than one adjoining wheelchair space." .

    ibc:sem-ibc2021-1009.6.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1009.6.3-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 52.0 .

    ibc:sem-ibc2021-1009.6.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each area of refuge shall be separated from the remainder of the story by a smoke barrier complying with Section 709 or a horizontal exit complying with Section 1026." .

    ibc:sem-ibc2021-1009.6.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each area of refuge shall be designed to minimize the intrusion of smoke." .

    ibc:sem-ibc2021-1009.6.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Areas of refuge shall be provided with a two-way communication system complying with Sections 1009.8.1 and 1009.8.2." .

    ibc:sem-ibc2021-1009.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior areas for assisted rescue shall be accessed by an accessible route from the area served." .

    ibc:sem-ibc2021-1009.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009.7.1 through 1009.7.4." .

    ibc:sem-ibc2021-1009.7-condition-1 a ibco:Condition ;
        ibco:text "Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009." .

    ibc:sem-ibc2021-1009.7.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each exterior area for assisted rescue shall be sized to accommodate wheelchair spaces in accordance with Section 1009.6.3." .

    ibc:sem-ibc2021-1009.7.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior walls separating the exterior area of assisted rescue from the interior of the building shall have a minimum fire-resistance rating of 1 hour, rated for exposure to fire from the inside." .

    ibc:sem-ibc2021-1009.7.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The fireresistance-rated exterior wall construction shall extend horizontally not less than 10 feet (3048 mm) beyond the landing on either side of the landing or equivalent fireresistance-rated construction is permitted to extend out perpendicular to the exterior wall not less than 4 feet (1219 mm) on the side of the landing." .

    ibc:sem-ibc2021-1009.7.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The fire-resistancerated construction shall extend vertically from the ground to a point not less than 10 feet (3048 mm) above the floor level of the area for assisted rescue or to the roof line, whichever is lower." .

    ibc:sem-ibc2021-1009.7.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings within such fire-resistancerated exterior walls shall be protected in accordance with Section 716." .

    ibc:sem-ibc2021-1009.7.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1009.7.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1009.7.2-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1009.7.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exterior area for assisted rescue shall be open to the outside air." .

    ibc:sem-ibc2021-1009.7.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The sides other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-1009.7.3-condition-1 a ibco:Condition ;
        ibco:text "other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-1009.7.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1009.7.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways that are part of the means of egress for the exterior area for assisted rescue shall provide a minimum clear width of 48 inches (1219 mm) between handrails." .

    ibc:sem-ibc2021-1009.7.4-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-1009.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A two-way communication system complying with Sections 1009.8.1 and 1009.8.2 shall be provided at the landing serving each elevator or bank of elevators on each accessible floor that is one or more stories above or below the level of exit discharge." .

    ibc:sem-ibc2021-1009.8.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Two-way communication systems shall provide communication between each required location and the fire command center or a central control point location approved by the fire department." .

    ibc:sem-ibc2021-1009.8.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1." .

    ibc:sem-ibc2021-1009.8.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The two-way communication system shall include both audible and visible signals." .

    ibc:sem-ibc2021-1009.8.1-condition-1 a ibco:Condition ;
        ibco:text "Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1." .

    ibc:sem-ibc2021-1009.8.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Directions for the use of the twoway communication system, instructions for summoning assistance via the two-way communication system and written identification of the location shall be posted adjacent to the two-way communication system." .

    ibc:sem-ibc2021-1009.8.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Signage shall comply with the ICC A117.1 requirements for visual characters." .

    ibc:sem-ibc2021-1009.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Signage indicating special accessibility provisions shall be provided as shown:" .

    ibc:sem-ibc2021-1010.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors in the means of egress shall comply with the requirements of Sections 1010.1.1 through 1010.3.4." .

    ibc:sem-ibc2021-1010.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit doors shall also comply with the requirements of Section 1022.2." .

    ibc:sem-ibc2021-1010.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Gates in the means of egress shall comply with the requirements of Sections 1010.4 and 1010.4.1." .

    ibc:sem-ibc2021-1010.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Turnstiles in the means of egress shall comply with the requirements of Sections 1010.5 through 1010.5.4." .

    ibc:sem-ibc2021-1010.1-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors, gates and turnstiles provided for egress purposes in numbers greater than required by this code shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1010.1-atomic-6 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors in the means of egress shall be readily distinguishable from the adjacent construction and finishes such that the doors are easily recognizable as doors." .

    ibc:sem-ibc2021-1010.1-atomic-7 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Mirrors or similar reflecting materials shall not be used on means of egress doors." .

    ibc:sem-ibc2021-1010.1-atomic-8 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Means of egress doors shall not be concealed by curtains, drapes, decorations or similar materials." .

    ibc:sem-ibc2021-1010.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of each door opening shall be sufficient for the occupant load thereof and shall provide a minimum clear opening width of 32 inches (813 mm)." .

    ibc:sem-ibc2021-1010.1.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The clear opening width of doorways with swinging doors shall be measured between the face of the door and the stop, with the door open 90 degrees (1.57 rad)." .

    ibc:sem-ibc2021-1010.1.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where this section requires a minimum clear opening width of 32 inches (813 mm) and a door opening includes two door leaves without a mullion, one leaf shall provide a minimum clear opening width of 32 inches (813 mm)." .

    ibc:sem-ibc2021-1010.1.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-2, doors serving as means of egress doors where used for the movement of beds shall provide a minimum clear opening width of 411/2 inches (1054 mm)." .

    ibc:sem-ibc2021-1010.1.1-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clear opening height of doors shall be not less than 80 inches (2032 mm)." .

    ibc:sem-ibc2021-1010.1.1-condition-1 a ibco:Condition ;
        ibco:text "Where this section requires a minimum clear opening width of 32 inches (813 mm) and a door opening includes two door leaves without a mullion, one leaf shall provide a minimum clear opening width of 32 inches (813 mm)." .

    ibc:sem-ibc2021-1010.1.1-condition-2 a ibco:Condition ;
        ibco:text "where used for the movement of beds shall provide a minimum clear opening width of 411/2 inches (1054 mm)." .

    ibc:sem-ibc2021-1010.1.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-1010.1.1-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-1010.1.1-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-1010.1.1-measurement-4 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1010.1.1-measurement-5 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1010.1.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "There shall not be projections into the required clear opening width lower than 34 inches (864 mm) above the floor or ground." .

    ibc:sem-ibc2021-1010.1.1.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Projections into the clear opening width between 34 inches (864 mm) and 80 inches (2032 mm) above the floor or ground shall not exceed 4 inches (102 mm)." .

    ibc:sem-ibc2021-1010.1.1.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1010.1.1.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1010.1.1.1-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1010.1.1.1-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1010.1.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Egress doors shall be of the side-hinged swinging door, pivoted door, or balanced door types." .

    ibc:sem-ibc2021-1010.1.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Side-hinged swinging doors, pivoted doors and balanced doors shall swing in the direction of egress travel where serving a room or area containing an occupant load of 50 or more persons or a Group H occupancy. " .

    ibc:sem-ibc2021-1010.1.2.1-condition-1 a ibco:Condition ;
        ibco:text "where serving a room or area containing an occupant load of 50 or more persons or a Group H occupancy." .

    ibc:sem-ibc2021-1010.1.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The forces to unlatch doors shall comply with the following:" .

    ibc:sem-ibc2021-1010.1.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Forces shall be applied to the latch side of the door." .

    ibc:sem-ibc2021-1010.1.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed." .

    ibc:sem-ibc2021-1010.1.3.2-condition-1 a ibco:Condition ;
        ibco:text "Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed." .

    ibc:sem-ibc2021-1010.1.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "There shall be a floor or landing on each side of a door." .

    ibc:sem-ibc2021-1010.1.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such floor or landing shall be at the same elevation on each side of the door." .

    ibc:sem-ibc2021-1010.1.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings shall be level except for exterior landings, which are permitted to have a slope not to exceed 0.25 unit vertical in 12 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1010.1.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings shall have a width not less than the width of the stairway or the door, whichever is greater." .

    ibc:sem-ibc2021-1010.1.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Doors in the fully open position shall not reduce a required dimension by more than 7 inches (178 mm)." .

    ibc:sem-ibc2021-1010.1.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width." .

    ibc:sem-ibc2021-1010.1.5-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings shall have a length measured in the direction of travel of not less than 44 inches (1118 mm)." .

    ibc:sem-ibc2021-1010.1.5-condition-1 a ibco:Condition ;
        ibco:text "Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width." .

    ibc:sem-ibc2021-1010.1.5-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1010.1.5-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1010.1.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Thresholds at doorways shall not exceed 3/4 inch (19.1 mm) in height above the finished floor or landing for sliding doors serving dwelling units or 1/2 inch (12.7 mm) above the finished floor or landing for other doors." .

    ibc:sem-ibc2021-1010.1.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Raised thresholds and floor level changes greater than 1/4 inch (6.4 mm) at doorways shall be beveled with a slope not greater than one unit vertical in two units horizontal (50-percent slope)." .

    ibc:sem-ibc2021-1010.1.6-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1010.1.6-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1010.1.6-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1010.1.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Space between two doors in a series shall be 48 inches (1219 mm) minimum plus the width of a door swinging into the space." .

    ibc:sem-ibc2021-1010.1.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors in a series shall swing either in the same direction or away from the space between the doors." .

    ibc:sem-ibc2021-1010.1.7-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-1010.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Except as specifically permitted by this section, egress doors shall be readily openable from the egress side without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The unlatching of any door or leaf for egress shall require not more than one motion in a single linear or rotational direction to release all latching and all locking devices." .

    ibc:sem-ibc2021-1010.2.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where electrical systems that monitor or record egress activity are incorporated, the locking system shall comply with Section 1010.2.11, 1010.2.12, 1010.2.13, 1010.2.14 or 1010.2.15 or shall be readily openable from the egress side without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.10-condition-1 a ibco:Condition ;
        ibco:text "Where electrical systems that monitor or record egress activity are incorporated, the locking system shall comply with Section 1010." .

    ibc:sem-ibc2021-1010.2.11-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Door hardware release of electric locking systems shall be permitted on doors in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-1010.2.11-condition-1 a ibco:Condition ;
        ibco:text "where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-1010.2.12-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Sensor release of electric locking systems shall be permitted on doors located in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following criteria:" .

    ibc:sem-ibc2021-1010.2.12-condition-1 a ibco:Condition ;
        ibco:text "where installed and operated in accordance with all of the following criteria:" .

    ibc:sem-ibc2021-1010.2.13-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Delayed egress locking systems shall be permitted to be installed on doors serving the following occupancies in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke or heat detection system installed in accordance with Section 907." .

    ibc:sem-ibc2021-1010.2.13.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The delayed egress locking system shall be installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-1010.2.15-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In buildings within correctional and detention facilities, doors in means of egress serving rooms or spaces occupied by persons whose movements are controlled for security reasons shall be permitted to be locked where equipped with egress control devices that shall unlock manually and by not less than one of the following means:" .

    ibc:sem-ibc2021-1010.2.15-condition-1 a ibco:Condition ;
        ibco:text "where equipped with egress control devices that shall unlock manually and by not less than one of the following means:" .

    ibc:sem-ibc2021-1010.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Door handles, pulls, latches, locks and other operating devices on doors required to be accessible by Chapter 11 shall not require tight grasping, tight pinching or twisting of the wrist to operate." .

    ibc:sem-ibc2021-1010.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Door handles, pulls, latches, locks and other operating devices shall be installed 34 inches (864 mm) minimum and 48 inches (1219 mm) maximum above the finished floor." .

    ibc:sem-ibc2021-1010.2.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Locks used only for security purposes and not used for normal operation are permitted at any height." .

    ibc:sem-ibc2021-1010.2.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1010.2.3-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-1010.2.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Locks and latches shall be permitted to prevent operation of doors where any of the following exist:" .

    ibc:sem-ibc2021-1010.2.4-condition-1 a ibco:Condition ;
        ibco:text "where any of the following exist:" .

    ibc:sem-ibc2021-1010.2.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Manually operated flush bolts or surface bolts are not permitted." .

    ibc:sem-ibc2021-1010.2.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Closet doors that latch in the closed position shall be openable from inside the closet." .

    ibc:sem-ibc2021-1010.2.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior stairway means of egress doors shall be openable from both sides without the use of a key or special knowledge or effort." .

    ibc:sem-ibc2021-1010.2.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group E occupancies, Group B educational occupancies and Group I-4 occupancies, egress doors from classrooms, offices and other occupied rooms with locking arrangements designed to keep intruders from entering the room shall comply with all of the following conditions:" .

    ibc:sem-ibc2021-1010.2.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Swinging doors serving a Group H occupancy and swinging doors serving rooms or spaces with an occupant load of 50 or more in a Group A or E occupancy shall not be provided with a latch or lock other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9-condition-1 a ibco:Condition ;
        ibco:text "other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Refrigeration machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exit or exit access doorways that swing in the direction of egress travel and shall be equipped with panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 0.0 .

    ibc:sem-ibc2021-1010.2.9.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit or exit access doors serving transformer vaults, rooms designated for batteries or energy storage systems, or modular data centers shall be equipped with panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Rooms containing electrical equipment rated 800 amperes or more that contain overcurrent devices, switching devices or control devices and where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The doors shall swing in the direction of egress travel." .

    ibc:sem-ibc2021-1010.2.9.2-condition-1 a ibco:Condition ;
        ibco:text "where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.2-condition-2 a ibco:Condition ;
        ibco:text "other than panic hardware or fire exit hardware." .

    ibc:sem-ibc2021-1010.2.9.2-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT" ;
        ibco:value 25.0 .

    ibc:sem-ibc2021-1010.2.9.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where panic or fire exit hardware is installed, it shall comply with the following:" .

    ibc:sem-ibc2021-1010.2.9.3-condition-1 a ibco:Condition ;
        ibco:text "Where panic or fire exit hardware is installed, it shall comply with the following:" .

    ibc:sem-ibc2021-1010.2.9.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side." .

    ibc:sem-ibc2021-1010.2.9.4-condition-1 a ibco:Condition ;
        ibco:text "If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side." .

    ibc:sem-ibc2021-1010.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Special doors and security grilles shall comply with the requirements of Sections 1010.3.1 through 1010.3.4." .

    ibc:sem-ibc2021-1010.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Revolving doors shall comply with the following:" .

    ibc:sem-ibc2021-1010.3.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A revolving door used as a component of a means of egress shall comply with Section 1010.3.1 and the following three conditions:" .

    ibc:sem-ibc2021-1010.3.1.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A revolving door used as other than a component of a means of egress shall comply with Section 1010.3.1." .

    ibc:sem-ibc2021-1010.3.1.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The breakout force of a revolving door not used as a component of a means of egress shall not be more than 180 pounds (801 N)." .

    ibc:sem-ibc2021-1010.3.1.2-condition-1 a ibco:Condition ;
        ibco:text "other than a component of a means of egress shall comply with Section 1010." .

    ibc:sem-ibc2021-1010.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress." .

    ibc:sem-ibc2021-1010.3.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The forces required to open these doors manually shall not exceed those specified in Section 1010.1.3, except that the force to set the door in motion shall not exceed 50 pounds (220 N)." .

    ibc:sem-ibc2021-1010.3.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The door shall be capable of opening from any position to the full width of the opening in which such door is installed when a force is applied to the door on the side from which egress is made." .

    ibc:sem-ibc2021-1010.3.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Power-operated swinging doors, power-operated sliding doors and power-operated folding doors shall comply with BHMA A156.10." .

    ibc:sem-ibc2021-1010.3.2-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Power-assisted swinging doors and low-energy power-operated swinging doors shall comply with BHMA A156.19." .

    ibc:sem-ibc2021-1010.3.2-atomic-6 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Low-energy poweroperated sliding doors and low-energy power-operated folding doors shall comply with BHMA A156.38." .

    ibc:sem-ibc2021-1010.3.2-condition-1 a ibco:Condition ;
        ibco:text "Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress." .

    ibc:sem-ibc2021-1010.3.2-condition-2 a ibco:Condition ;
        ibco:text "where necessary to safeguard means of egress." .

    ibc:sem-ibc2021-1010.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010.1.2 shall comply with all of the following criteria:" .

    ibc:sem-ibc2021-1010.3.3-condition-1 a ibco:Condition ;
        ibco:text "other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010." .

    ibc:sem-ibc2021-1010.3.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "In Groups B, F, M and S, horizontal sliding or vertical security grilles are permitted at the main exit and shall be openable from the inside without the use of a key or special knowledge or effort during periods that the space is occupied." .

    ibc:sem-ibc2021-1010.3.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The grilles shall remain secured in the full-open position during the period of occupancy by the general public." .

    ibc:sem-ibc2021-1010.3.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles." .

    ibc:sem-ibc2021-1010.3.4-condition-1 a ibco:Condition ;
        ibco:text "Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles." .

    ibc:sem-ibc2021-1010.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Gates serving the means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1010.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Gates used as a component in a means of egress shall conform to the applicable requirements for doors." .

    ibc:sem-ibc2021-1010.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Panic hardware is not required on gates surrounding stadiums where such gates are under constant immediate supervision while the public is present, and where safe dispersal areas based on 3 square feet (0.28 m2) per occupant are located between the fence and enclosed space." .

    ibc:sem-ibc2021-1010.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Such required safe dispersal areas shall not be located less than 50 feet (15 240 mm) from the enclosed space." .

    ibc:sem-ibc2021-1010.4.1-condition-1 a ibco:Condition ;
        ibco:text "where such gates are under constant immediate supervision while the public is present, and where safe dispersal areas based on 3 square feet (0." .

    ibc:sem-ibc2021-1010.4.1-condition-2 a ibco:Condition ;
        ibco:text "where safe dispersal areas based on 3 square feet (0." .

    ibc:sem-ibc2021-1010.4.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 3.0 .

    ibc:sem-ibc2021-1010.4.1-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1010.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Turnstiles or similar devices that restrict travel to one direction shall not be placed so as to obstruct any required means of egress, except where permitted in accordance with Sections 1010.5.1, 1010.5.2 and 1010.5.3." .

    ibc:sem-ibc2021-1010.5-condition-1 a ibco:Condition ;
        ibco:text "where permitted in accordance with Sections 1010." .

    ibc:sem-ibc2021-1010.5.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each turnstile or similar device shall be credited with a capacity based on not more than a 50person occupant load where all of the following provisions are met:" .

    ibc:sem-ibc2021-1010.5.1-condition-1 a ibco:Condition ;
        ibco:text "where all of the following provisions are met:" .

    ibc:sem-ibc2021-1010.5.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where located as part of an accessible route, turnstiles shall have not less than 36 inches (914 mm) clear width at and below a height of 34 inches (864 mm), not less than 32 inches (813 mm) clear width between 34 inches (864 mm) and 80 inches (2032 mm) and shall consist of a mechanism other than a revolving device." .

    ibc:sem-ibc2021-1010.5.1.1-condition-1 a ibco:Condition ;
        ibco:text "Where located as part of an accessible route, turnstiles shall have not less than 36 inches (914 mm) clear width at and below a height of 34 inches (864 mm), not less than 32 inches (813 mm) clear width between 34 inches (864 mm) and 80 inches (2032 mm) and shall consist of a mechanism other than a revolving device." .

    ibc:sem-ibc2021-1010.5.1.1-condition-2 a ibco:Condition ;
        ibco:text "other than a revolving device." .

    ibc:sem-ibc2021-1010.5.1.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1010.5.1.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1010.5.1.1-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 32.0 .

    ibc:sem-ibc2021-1010.5.1.1-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1010.5.1.1-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1010.5.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Security access turnstiles that inhibit travel in the direction of egress utilizing a physical barrier shall be permitted to be considered as a component of the means of egress, provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-1010.5.2-condition-1 a ibco:Condition ;
        ibco:text "provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-1010.5.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Turnstiles more than 39 inches (991 mm) high shall meet the requirements for revolving doors or the requirements of Section 1010.5.2 for security access turnstiles." .

    ibc:sem-ibc2021-1010.5.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 39.0 .

    ibc:sem-ibc2021-1010.5.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where serving an occupant load greater than 300, each turnstile that is not portable shall have a side-hinged swinging door that conforms to Section 1010.1 within 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-1010.5.4-condition-1 a ibco:Condition ;
        ibco:text "Where serving an occupant load greater than 300, each turnstile that is not portable shall have a side-hinged swinging door that conforms to Section 1010." .

    ibc:sem-ibc2021-1010.5.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1011.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways serving occupied portions of a building shall comply with the requirements of Sections 1011.2 through 1011.13." .

    ibc:sem-ibc2021-1011.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Alternating tread devices shall comply with Section 1011.14." .

    ibc:sem-ibc2021-1011.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ship’s ladders shall comply with Section 1011.15." .

    ibc:sem-ibc2021-1011.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ladders shall comply with Section 1011.16." .

    ibc:sem-ibc2021-1011.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Spiral stairways are permitted to be used as a component in the means of egress only within dwelling units or from a space not more than 250 square feet (23 m2) in area and serving not more than five occupants, or from technical production areas in accordance with Section" .

    ibc:sem-ibc2021-1011.10-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-1011.11-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Flights of stairways shall have handrails on each side and shall comply with Section 1014." .

    ibc:sem-ibc2021-1011.11-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where glass is used to provide the handrail, the handrail shall comply with Section 2407." .

    ibc:sem-ibc2021-1011.11-condition-1 a ibco:Condition ;
        ibco:text "Where glass is used to provide the handrail, the handrail shall comply with Section 2407." .

    ibc:sem-ibc2021-1011.12-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In buildings four or more stories above grade plane, one stairway shall extend to the roof surface unless the roof has a slope steeper than four units vertical in 12 units horizontal (33-percent slope)." .

    ibc:sem-ibc2021-1011.12-condition-1 a ibco:Condition ;
        ibco:text "unless the roof has a slope steeper than four units vertical in 12 units horizontal (33-percent slope)." .

    ibc:sem-ibc2021-1011.12.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "must" ;
        ibco:statementType "obligation" ;
        ibco:text "Roofs and penthouses containing elevator equipment that must be accessed for maintenance are required to be accessed by a stairway." .

    ibc:sem-ibc2021-1011.12.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a stairway is provided to a roof, access to the roof shall be provided through a penthouse complying with Section 1511.2." .

    ibc:sem-ibc2021-1011.12.2-condition-1 a ibco:Condition ;
        ibco:text "Where a stairway is provided to a roof, access to the roof shall be provided through a penthouse complying with Section 1511." .

    ibc:sem-ibc2021-1011.13-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be provided along stairways and landings where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:sem-ibc2021-1011.13-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the roof hatch opening providing the required access is located within 10 feet (3049 mm) of the roof edge, such roof access or roof edge shall be protected by guards installed in accordance with Section 1015." .

    ibc:sem-ibc2021-1011.13-condition-1 a ibco:Condition ;
        ibco:text "where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:sem-ibc2021-1011.13-condition-2 a ibco:Condition ;
        ibco:text "Where the roof hatch opening providing the required access is located within 10 feet (3049 mm) of the roof edge, such roof access or roof edge shall be protected by guards installed in accordance with Section 1015." .

    ibc:sem-ibc2021-1011.13-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1011.14-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Alternating tread devices used as a means of egress shall not have a rise greater than 20 feet (6096 mm) between floor levels or landings." .

    ibc:sem-ibc2021-1011.14-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-1011.14-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-1011.14-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-1011.14.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails shall be provided on both sides of alternating tread devices and shall comply with Section 1014." .

    ibc:sem-ibc2021-1011.14.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Alternating tread devices shall have a minimum tread depth of 5 inches (127 mm), a minimum projected tread depth of 81/2 inches (216 mm), a minimum tread width of 7 inches (178 mm) and a maximum riser height of 91/2 inches (241 mm)." .

    ibc:sem-ibc2021-1011.14.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The tread depth shall be measured horizontally between the vertical planes of the foremost projections of adjacent treads." .

    ibc:sem-ibc2021-1011.14.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The riser height shall be measured vertically between the leading edges of adjacent treads." .

    ibc:sem-ibc2021-1011.14.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The riser height and tread depth provided shall result in an angle of ascent from the horizontal of between 50 and 70 degrees (0.87 and 1.22 rad)." .

    ibc:sem-ibc2021-1011.14.2-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The initial tread of the device shall begin at the same elevation as the platform, landing or floor surface." .

    ibc:sem-ibc2021-1011.14.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-1011.14.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.14.2-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1011.14.2-measurement-4 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.15-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Ship’s ladders are permitted to be used in Group I-3 as a component of a means of egress to and from control rooms or elevated facility observation stations not more than 250 square feet (23 m2) with not more than three occupants and for access to unoccupied roofs." .

    ibc:sem-ibc2021-1011.15-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clear width at and below the handrails shall be 20 inches (508 mm)." .

    ibc:sem-ibc2021-1011.15-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ship’s ladders shall be designed for the live loads indicated in Section 1607.17." .

    ibc:sem-ibc2021-1011.15-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 250.0 .

    ibc:sem-ibc2021-1011.15-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-1011.15.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails shall be provided on both sides of ship’s ladders." .

    ibc:sem-ibc2021-1011.15.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ship’s ladders shall have a minimum tread depth of 5 inches (127 mm)." .

    ibc:sem-ibc2021-1011.15.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The tread shall be projected such that the total of the tread depth plus the nosing projection is not less than 81/2 inches (216 mm)." .

    ibc:sem-ibc2021-1011.15.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The maximum riser height shall be 91/2 inches (241 mm)." .

    ibc:sem-ibc2021-1011.15.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-1011.15.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.15.2-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.16-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Permanent ladders shall not serve as a part of the means of egress from occupied spaces within a building." .

    ibc:sem-ibc2021-1011.16-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Permanent ladders shall be constructed in accordance with Section 306.5 of the International Mechanical Code and designed for the live loads indicated in Section 1607.17." .

    ibc:sem-ibc2021-1011.16-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Permanent ladders shall be permitted to provide access to the following areas:" .

    ibc:sem-ibc2021-1011.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of stairways shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm)." .

    ibc:sem-ibc2021-1011.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1011.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways shall have a headroom clearance of not less than 80 inches (2032 mm) measured vertically from a line connecting the edge of the nosings." .

    ibc:sem-ibc2021-1011.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such headroom shall be continuous above the stairway to the point where the line intersects the landing below, one tread depth beyond the bottom riser." .

    ibc:sem-ibc2021-1011.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clearance shall be maintained the full width of the stairway and landing." .

    ibc:sem-ibc2021-1011.3-condition-1 a ibco:Condition ;
        ibco:text "where the line intersects the landing below, one tread depth beyond the bottom riser." .

    ibc:sem-ibc2021-1011.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1011.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The walkline across winder treads shall be concentric to the direction of travel through the turn and located 12 inches (305 mm) from the side where the winders are narrower." .

    ibc:sem-ibc2021-1011.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The 12-inch (305 mm) dimension shall be measured from the widest point of the clear stair width at the walking surface of the winder." .

    ibc:sem-ibc2021-1011.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used." .

    ibc:sem-ibc2021-1011.4-condition-1 a ibco:Condition ;
        ibco:text "where the winders are narrower." .

    ibc:sem-ibc2021-1011.4-condition-2 a ibco:Condition ;
        ibco:text "Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used." .

    ibc:sem-ibc2021-1011.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1011.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stair treads and risers shall comply with Sections 1011.5.1 through 1011.5.5.3." .

    ibc:sem-ibc2021-1011.5.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stair riser heights shall be 7 inches (178 mm) maximum and 4 inches (102 mm) minimum." .

    ibc:sem-ibc2021-1011.5.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The riser height shall be measured vertically between the nosings of adjacent treads or between the stairway landing and the adjacent tread." .

    ibc:sem-ibc2021-1011.5.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Rectangular tread depths shall be 11 inches (279 mm) minimum measured horizontally between the vertical planes of the foremost projection of adjacent treads and at a right angle to the tread’s nosing." .

    ibc:sem-ibc2021-1011.5.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Winder treads shall have a minimum tread depth of 11 inches (279 mm) between the vertical planes of the foremost projection of adjacent treads at the intersections with the walkline and a minimum tread depth of 10 inches (254 mm) within the clear width of the stair." .

    ibc:sem-ibc2021-1011.5.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1011.5.2-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1011.5.2-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1011.5.2-measurement-4 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1011.5.2-measurement-5 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1011.5.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Winder treads are not permitted in means of egress stairways except within a dwelling unit." .

    ibc:sem-ibc2021-1011.5.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stair treads and risers shall be of uniform size and shape." .

    ibc:sem-ibc2021-1011.5.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The tolerance between the largest and smallest riser height or between the largest and smallest tread depth shall not exceed 3/8 inch (9.5 mm) in any flight of stairs." .

    ibc:sem-ibc2021-1011.5.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The greatest winder tread depth at the walkline within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm)." .

    ibc:sem-ibc2021-1011.5.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1011.5.4-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1011.5.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where the bottom or top riser adjoins a sloping public way, walkway or driveway having an established grade and serving as a landing, the bottom or top riser is permitted to be reduced along the slope to less than 4 inches (102 mm) in height, with the variation in height of the bottom or top riser not to exceed one unit vertical in 12 units horizontal (8-percent slope) of stair width." .

    ibc:sem-ibc2021-1011.5.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The nosings or leading edges of treads at such nonuniform height risers shall have a distinctive marking stripe, different from any other nosing marking provided on the stair flight." .

    ibc:sem-ibc2021-1011.5.4.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The distinctive marking stripe shall be visible in descent of the stair and shall have a slipresistant surface." .

    ibc:sem-ibc2021-1011.5.4.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Marking stripes shall have a width of not less than 1 inch (25 mm) but not more than 2 inches (51 mm)." .

    ibc:sem-ibc2021-1011.5.4.1-condition-1 a ibco:Condition ;
        ibco:text "Where the bottom or top riser adjoins a sloping public way, walkway or driveway having an established grade and serving as a landing, the bottom or top riser is permitted to be reduced along the slope to less than 4 inches (102 mm) in height, with the variation in height of the bottom or top riser not to exceed one unit vertical in 12 units horizontal (8-percent slope) of stair width." .

    ibc:sem-ibc2021-1011.5.4.1-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1011.5.4.1-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1011.5.4.1-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.5.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Nosings shall have a curvature or bevel of not less than 1/16 inch (1.6 mm) but not more than 9/16 inch (14.3 mm) from the foremost projection of the tread." .

    ibc:sem-ibc2021-1011.5.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Risers shall be solid and vertical or sloped under the tread above from the underside of the nosing above at an angle not more than 30 degrees (0.52 rad) from the vertical." .

    ibc:sem-ibc2021-1011.5.5-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-1011.5.5-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-1011.5.5.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Nosing projections of the leading edges shall be of uniform size, including the projections of the nosing’s leading edge of the floor at the top of a flight." .

    ibc:sem-ibc2021-1011.5.5.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Risers shall be solid." .

    ibc:sem-ibc2021-1011.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "There shall be a floor or landing at the top and bottom of each stairway." .

    ibc:sem-ibc2021-1011.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The width of landings, measured perpendicularly to the direction of travel, shall be not less than the width of stairways served." .

    ibc:sem-ibc2021-1011.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every landing shall have a minimum depth, measured parallel to the direction of travel, equal to the width of the stairway or 48 inches (1219 mm), whichever is less." .

    ibc:sem-ibc2021-1011.6-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Doors opening onto a landing shall not reduce the landing to less than one-half the required width." .

    ibc:sem-ibc2021-1011.6-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "When fully open, the door shall not project more than 7 inches (178 mm) into the required width of a landing." .

    ibc:sem-ibc2021-1011.6-atomic-6 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where wheelchair spaces are required on the stairway landing in accordance with Section 1009.6.3, the wheelchair space shall not be located in the required width of the landing and doors shall not swing over the wheelchair spaces." .

    ibc:sem-ibc2021-1011.6-condition-1 a ibco:Condition ;
        ibco:text "Where wheelchair spaces are required on the stairway landing in accordance with Section 1009." .

    ibc:sem-ibc2021-1011.6-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

    ibc:sem-ibc2021-1011.6-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1011.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:sem-ibc2021-1011.7.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The walking surface of treads and landings of a stairway shall not be sloped steeper than one unit vertical in 48 units horizontal (2percent slope) in any direction." .

    ibc:sem-ibc2021-1011.7.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairway treads and landings shall have a solid surface." .

    ibc:sem-ibc2021-1011.7.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Finish floor surfaces shall be securely attached." .

    ibc:sem-ibc2021-1011.7.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1011.7.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Outdoor stairways and outdoor approaches to stairways shall be designed so that water will not accumulate on walking surfaces." .

    ibc:sem-ibc2021-1011.7.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The walls and soffits within enclosed usable spaces under enclosed and unenclosed stairways shall be protected by 1-hour fire-resistance-rated construction or the fire-resistance rating of the stairway enclosure, whichever is greater." .

    ibc:sem-ibc2021-1011.7.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Access to the enclosed space shall not be directly from within the stairway enclosure." .

    ibc:sem-ibc2021-1011.7.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1hour fire-resistance-rated construction." .

    ibc:sem-ibc2021-1011.7.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The open space under exterior stairways shall not be used for any purpose." .

    ibc:sem-ibc2021-1011.7.4-condition-1 a ibco:Condition ;
        ibco:text "unless the space is completely enclosed in 1hour fire-resistance-rated construction." .

    ibc:sem-ibc2021-1011.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A flight of stairs shall not have a vertical rise greater than 12 feet (3658 mm) between floor levels or landings." .

    ibc:sem-ibc2021-1011.8-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1011.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Curved stairways with winder treads shall have treads and risers in accordance with Section 1011.5 and the smallest radius shall be not less than twice the minimum width or required capacity of the stairway." .

    ibc:sem-ibc2021-1012.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The provisions of this section shall apply to ramps used as a component of a means of egress." .

    ibc:sem-ibc2021-1012.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Edge protection complying with Section 1012.10.1 or 1012.10.2 shall be provided on each side of ramp runs and at each side of ramp landings." .

    ibc:sem-ibc2021-1012.10.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A curb, rail, wall or barrier shall be provided to serve as edge protection." .

    ibc:sem-ibc2021-1012.10.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A curb shall be not less than 4 inches (102 mm) in height." .

    ibc:sem-ibc2021-1012.10.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Barriers shall be constructed so that the barrier prevents the passage of a 4-inch-diameter (102 mm) sphere, where any portion of the sphere is within 4 inches (102 mm) of the floor or ground surface." .

    ibc:sem-ibc2021-1012.10.1-condition-1 a ibco:Condition ;
        ibco:text "where any portion of the sphere is within 4 inches (102 mm) of the floor or ground surface." .

    ibc:sem-ibc2021-1012.10.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1012.10.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1012.10.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The floor or ground surface of the ramp run or landing shall extend 12 inches (305 mm) minimum beyond the inside face of a handrail complying with Section 1014." .

    ibc:sem-ibc2021-1012.10.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1012.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramps used as part of a means of egress shall have a running slope not steeper than 1 unit vertical in 12 units horizontal (8.3-percent slope)." .

    ibc:sem-ibc2021-1012.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The slope of other pedestrian ramps shall not be steeper than 1 unit vertical in 8 units horizontal (12.5-percent slope)." .

    ibc:sem-ibc2021-1012.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The slope measured perpendicular to the direction of travel of a ramp shall not be steeper than one unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1012.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The rise for any ramp run shall be 30 inches (762 mm) maximum." .

    ibc:sem-ibc2021-1012.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1012.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum dimensions of means of egress ramps shall comply with Sections 1012.5.1 through 1012.5.3." .

    ibc:sem-ibc2021-1012.5.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width and required capacity of a means of egress ramp shall be not less than that required for corridors by Section 1020.3." .

    ibc:sem-ibc2021-1012.5.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The clear width of a ramp between handrails, if provided, or other permissible projections shall be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-1012.5.1-condition-1 a ibco:Condition ;
        ibco:text "if provided, or other permissible projections shall be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-1012.5.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1012.5.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum headroom in all parts of the means of egress ramp shall be not less than 80 inches (2032 mm) above the finished floor of the ramp run and any intermediate landings." .

    ibc:sem-ibc2021-1012.5.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clearance shall be maintained for the full width of the ramp and landing." .

    ibc:sem-ibc2021-1012.5.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-1012.5.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Means of egress ramps shall not reduce in width in the direction of egress travel." .

    ibc:sem-ibc2021-1012.5.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Doors opening onto a landing shall not reduce the clear width to less than 42 inches (1067 mm)." .

    ibc:sem-ibc2021-1012.5.3-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1012.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramps shall have landings at the bottom and top of each ramp, points of turning, entrance, exits and at doors." .

    ibc:sem-ibc2021-1012.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings shall comply with Sections 1012.6.1 through 1012.6.5." .

    ibc:sem-ibc2021-1012.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings shall have a slope not steeper than one unit vertical in 48 units horizontal (2-percent slope) in any direction." .

    ibc:sem-ibc2021-1012.6.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Changes in level are not permitted." .

    ibc:sem-ibc2021-1012.6.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The landing width shall be not less than the width of the widest ramp run adjoining the landing." .

    ibc:sem-ibc2021-1012.6.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The landing length shall be 60 inches (1525 mm) minimum." .

    ibc:sem-ibc2021-1012.6.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 60.0 .

    ibc:sem-ibc2021-1012.6.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where changes in direction of travel occur at landings provided between ramp runs, the landing shall be 60 inches by 60 inches (1524 mm by 1524 mm) minimum." .

    ibc:sem-ibc2021-1012.6.4-condition-1 a ibco:Condition ;
        ibco:text "Where changes in direction of travel occur at landings provided between ramp runs, the landing shall be 60 inches by 60 inches (1524 mm by 1524 mm) minimum." .

    ibc:sem-ibc2021-1012.6.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 60.0 .

    ibc:sem-ibc2021-1012.6.4-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 60.0 .

    ibc:sem-ibc2021-1012.6.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where doorways are located adjacent to a ramp landing, maneuvering clearances required by ICC A117.1 are permitted to overlap the required landing area." .

    ibc:sem-ibc2021-1012.6.5-condition-1 a ibco:Condition ;
        ibco:text "Where doorways are located adjacent to a ramp landing, maneuvering clearances required by ICC A117." .

    ibc:sem-ibc2021-1012.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramps shall be built of materials consistent with the types permitted for the type of construction of the building, except that wood handrails shall be permitted for all types of construction." .

    ibc:sem-ibc2021-1012.7.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The surface of ramps shall be of slip-resistant materials that are securely attached." .

    ibc:sem-ibc2021-1012.7.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Outdoor ramps and outdoor approaches to ramps shall be designed so that water will not accumulate on walking surfaces." .

    ibc:sem-ibc2021-1012.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramps with a rise greater than 6 inches (152 mm) shall have handrails on both sides." .

    ibc:sem-ibc2021-1012.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails shall comply with Section 1014." .

    ibc:sem-ibc2021-1012.8-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1012.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:sem-ibc2021-1012.9-condition-1 a ibco:Condition ;
        ibco:text "where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:sem-ibc2021-1013.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exits and exit access doors shall be marked by an approved exit sign readily visible from any direction of egress travel." .

    ibc:sem-ibc2021-1013.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The path of egress travel to exits and within exits shall be marked by readily visible exit signs to clearly indicate the direction of egress travel in cases where the exit or the path of egress travel is not immediately visible to the occupants." .

    ibc:sem-ibc2021-1013.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Intervening means of egress doors within exits shall be marked by exit signs." .

    ibc:sem-ibc2021-1013.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit sign placement shall be such that any point in an exit access corridor or exit passageway is within 100 feet (30 480 mm) or the listed viewing distance of the sign, whichever is less, from the nearest visible exit sign." .

    ibc:sem-ibc2021-1013.1-condition-1 a ibco:Condition ;
        ibco:text "where the exit or the path of egress travel is not immediately visible to the occupants." .

    ibc:sem-ibc2021-1013.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-1013.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where exit signs are required in Group R-1 occupancies by Section 1013.1, additional low-level exit signs shall be provided in all areas serving guest rooms in Group R-1 occupancies and shall comply with Section 1013.5." .

    ibc:sem-ibc2021-1013.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The bottom of the sign shall be not less than 10 inches (254 mm) nor more than 18 inches (455 mm) above the floor level." .

    ibc:sem-ibc2021-1013.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The sign shall be flush mounted to the door or wall." .

    ibc:sem-ibc2021-1013.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side." .

    ibc:sem-ibc2021-1013.2-condition-1 a ibco:Condition ;
        ibco:text "Where exit signs are required in Group R-1 occupancies by Section 1013." .

    ibc:sem-ibc2021-1013.2-condition-2 a ibco:Condition ;
        ibco:text "Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side." .

    ibc:sem-ibc2021-1013.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1013.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1013.2-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1013.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit signs shall be internally or externally illuminated." .

    ibc:sem-ibc2021-1013.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where exit signs are provided at an area of refuge with direct access to a stairway, an exterior area for assisted rescue, an exit stairway or ramp, an exit passageway, a horizontal exit and the exit discharge, a sign stating \"EXIT\" in visual characters, raised characters and braille and complying with ICC A117.1 shall be provided." .

    ibc:sem-ibc2021-1013.4-condition-1 a ibco:Condition ;
        ibco:text "Where exit signs are provided at an area of refuge with direct access to a stairway, an exterior area for assisted rescue, an exit stairway or ramp, an exit passageway, a horizontal exit and the exit discharge, a sign stating \"EXIT\" in visual characters, raised characters and braille and complying with ICC A117." .

    ibc:sem-ibc2021-1013.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Electrically powered, self-luminous and photoluminescent exit signs shall be listed and labeled in accordance with UL 924 and shall be installed in accordance with the manufacturer’s instructions and Chapter 27." .

    ibc:sem-ibc2021-1013.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit signs shall be illuminated at all times." .

    ibc:sem-ibc2021-1013.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Externally illuminated exit signs shall comply with Sections 1013.6.1 through 1013.6.3." .

    ibc:sem-ibc2021-1013.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every exit sign and directional exit sign shall have plainly legible letters not less than 6 inches (152 mm) high with the principal strokes of the letters not less than 3/4 inch (19.1 mm) wide." .

    ibc:sem-ibc2021-1013.6.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The word “EXIT” shall have letters having a width not less than 2 inches (51 mm) wide, except the letter “I,” and the minimum spacing between letters shall be not less than 3/8 inch (9.5 mm)." .

    ibc:sem-ibc2021-1013.6.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Signs larger than the minimum established in this section shall have letter widths, strokes and spacing in proportion to their height." .

    ibc:sem-ibc2021-1013.6.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The word “EXIT” shall be in high contrast with the background and shall be clearly discernible when the means of exit sign illumination is or is not energized." .

    ibc:sem-ibc2021-1013.6.1-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "If a chevron directional indicator is provided as part of the exit sign, the construction shall be such that the direction of the chevron directional indicator cannot be readily changed." .

    ibc:sem-ibc2021-1013.6.1-condition-1 a ibco:Condition ;
        ibco:text "If a chevron directional indicator is provided as part of the exit sign, the construction shall be such that the direction of the chevron directional indicator cannot be readily changed." .

    ibc:sem-ibc2021-1013.6.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1013.6.1-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1013.6.1-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1013.6.1-measurement-4 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1013.6.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The face of an exit sign illuminated from an external source shall have an intensity of not less than 5 footcandles (54 lux)." .

    ibc:sem-ibc2021-1013.6.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit signs shall be illuminated at all times." .

    ibc:sem-ibc2021-1013.6.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator." .

    ibc:sem-ibc2021-1013.6.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The installation of the emergency power system shall be in accordance with Chapter 27." .

    ibc:sem-ibc2021-1013.6.3-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Group I-2, Condition 2 exit sign illumination shall not be provided by unit equipment batteries only." .

    ibc:sem-ibc2021-1014.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails serving flights of stairways, ramps, stepped aisles and ramped aisles shall be adequate in strength and attachment in accordance with Section 1607.9." .

    ibc:sem-ibc2021-1014.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails required for flights of stairways by Section 1011.11 shall comply with Sections 1014.2 through 1014.9." .

    ibc:sem-ibc2021-1014.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails required for ramps by Section 1012.8 shall comply with Sections 1014.2 through 1014.8." .

    ibc:sem-ibc2021-1014.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails for stepped aisles and ramped aisles required by Section 1030.16 shall comply with Sections 1014.2 through 1014.8." .

    ibc:sem-ibc2021-1014.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrail height, measured above stair tread nosings, or finish surface of ramp slope, shall be uniform, not less than 34 inches (864 mm) and not more than 38 inches (965 mm)." .

    ibc:sem-ibc2021-1014.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrail height of alternating tread devices and ships ladders, measured above tread nosings, shall be uniform, not less than 30 inches (762 mm) and not more than 34 inches (864 mm)." .

    ibc:sem-ibc2021-1014.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1014.2-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 38.0 .

    ibc:sem-ibc2021-1014.2-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1014.2-measurement-4 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 34.0 .

    ibc:sem-ibc2021-1014.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Required handrails shall comply with Section 1014.3.1 or shall provide equivalent graspability." .

    ibc:sem-ibc2021-1014.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails with a circular cross section shall have an outside diameter of not less than 11/4 inches (32 mm) and not greater than 2 inches (51 mm)." .

    ibc:sem-ibc2021-1014.3.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the handrail is not circular, it shall have a perimeter dimension of not less than 4 inches (102 mm) and not greater than 61/4 inches (160 mm) with a maximum crosssectional dimension of 21/4 inches (57 mm) and minimum cross-sectional dimension of 1 inch (25 mm)." .

    ibc:sem-ibc2021-1014.3.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:sem-ibc2021-1014.3.1-condition-1 a ibco:Condition ;
        ibco:text "Where the handrail is not circular, it shall have a perimeter dimension of not less than 4 inches (102 mm) and not greater than 61/4 inches (160 mm) with a maximum crosssectional dimension of 21/4 inches (57 mm) and minimum cross-sectional dimension of 1 inch (25 mm)." .

    ibc:sem-ibc2021-1014.3.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-6 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1014.3.1-measurement-7 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.01 .

    ibc:sem-ibc2021-1014.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails with a perimeter greater than 61/4 inches (160 mm) shall provide a graspable finger recess area on both sides of the profile." .

    ibc:sem-ibc2021-1014.3.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The finger recess shall begin within a distance of 3/4 inch (19 mm) measured vertically from the tallest portion of the profile and achieve a depth of not less than 5/16 inch (8 mm) within 7/8 inch (22 mm) below the widest portion of the profile." .

    ibc:sem-ibc2021-1014.3.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "This required depth shall continue for not less than 3/8 inch (10 mm) to a level that is not less than 13/4 inches (45 mm) below the tallest portion of the profile." .

    ibc:sem-ibc2021-1014.3.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The width of the handrail above the recess shall be not less than 11/4 inches (32 mm) to not greater than 23/4 inches (70 mm)." .

    ibc:sem-ibc2021-1014.3.2-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:sem-ibc2021-1014.3.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-5 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-6 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-7 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-8 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1014.3.2-measurement-9 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 0.01 .

    ibc:sem-ibc2021-1014.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrail gripping surfaces shall be continuous, without interruption by newel posts or other obstructions." .

    ibc:sem-ibc2021-1014.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Handrails shall not rotate within their fittings." .

    ibc:sem-ibc2021-1014.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent flight of stairs or ramp run." .

    ibc:sem-ibc2021-1014.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where handrails are not continuous between flights, the handrails shall extend horizontally not less than 12 inches (305 mm) beyond the top riser and continue to slope for the depth of one tread beyond the bottom riser." .

    ibc:sem-ibc2021-1014.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "At ramps where handrails are not continuous between runs, the handrails shall extend horizontally above the landing 12 inches (305 mm) minimum beyond the top and bottom of ramp runs." .

    ibc:sem-ibc2021-1014.6-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The extensions of handrails shall be in the same direction of the flights of stairs at stairways and the ramp runs at ramps." .

    ibc:sem-ibc2021-1014.6-condition-1 a ibco:Condition ;
        ibco:text "Where handrails are not continuous between flights, the handrails shall extend horizontally not less than 12 inches (305 mm) beyond the top riser and continue to slope for the depth of one tread beyond the bottom riser." .

    ibc:sem-ibc2021-1014.6-condition-2 a ibco:Condition ;
        ibco:text "where handrails are not continuous between runs, the handrails shall extend horizontally above the landing 12 inches (305 mm) minimum beyond the top and bottom of ramp runs." .

    ibc:sem-ibc2021-1014.6-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1014.6-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1014.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Clear space between a handrail and a wall or other surface shall be not less than 11/2 inches (38 mm)." .

    ibc:sem-ibc2021-1014.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A handrail and a wall or other surface adjacent to the handrail shall be free of any sharp or abrasive elements." .

    ibc:sem-ibc2021-1014.7-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1014.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "On ramps and on ramped aisles that are part of an accessible route, the clear width between handrails shall be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-1014.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Projections into the required width of aisles, stairways and ramps at each side shall not exceed 41/2 inches (114 mm) at or below the handrail height." .

    ibc:sem-ibc2021-1014.8-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Projections into the required width shall not be limited above the minimum headroom height required in Section 1011.3." .

    ibc:sem-ibc2021-1014.8-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Projections due to intermediate handrails shall not constitute a reduction in the egress width." .

    ibc:sem-ibc2021-1014.8-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)." .

    ibc:sem-ibc2021-1014.8-condition-1 a ibco:Condition ;
        ibco:text "Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)." .

    ibc:sem-ibc2021-1014.8-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1014.8-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1014.8-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1014.8-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1014.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairways shall have intermediate handrails located in such a manner that all portions of the stairway minimum width or required capacity are within 30 inches (762 mm) of a handrail." .

    ibc:sem-ibc2021-1014.9-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "On monumental stairs, handrails shall be located along the most direct path of egress travel." .

    ibc:sem-ibc2021-1014.9-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall comply with the provisions of Sections 1015.2 through 1015.7." .

    ibc:sem-ibc2021-1015.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Operable windows with sills located more than 72 inches (1829 mm) above finished grade or other surface below shall comply with Section 1015.8." .

    ibc:sem-ibc2021-1015.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 72.0 .

    ibc:sem-ibc2021-1015.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be located along open-sided walking surfaces, including mezzanines, equipment platforms, aisles, stairs, ramps and landings that are located more than 30 inches (762 mm) measured vertically to the floor or grade below at any point within 36 inches (914 mm) horizontally to the edge of the open side." .

    ibc:sem-ibc2021-1015.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be adequate in strength and attachment in accordance with Section 1607.9." .

    ibc:sem-ibc2021-1015.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1015.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407." .

    ibc:sem-ibc2021-1015.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the glazing provided does not meet the strength and attachment requirements of Section 1607.9, complying guards shall be located along glazed sides of open-sided walking surfaces." .

    ibc:sem-ibc2021-1015.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407." .

    ibc:sem-ibc2021-1015.2.1-condition-2 a ibco:Condition ;
        ibco:text "Where the glazing provided does not meet the strength and attachment requirements of Section 1607." .

    ibc:sem-ibc2021-1015.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Required guards shall be not less than 42 inches (1067 mm) high, measured vertically as follows:" .

    ibc:sem-ibc2021-1015.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1015.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Required guards shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter from the walking surface to the required guard height." .

    ibc:sem-ibc2021-1015.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1015.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Porches and decks that are enclosed with insect screening shall be provided with guards where the walking surface is located more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1015.5-condition-1 a ibco:Condition ;
        ibco:text "where the walking surface is located more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1015.5-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be provided where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below." .

    ibc:sem-ibc2021-1015.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The guard shall extend not less than 30 inches (762 mm) beyond each end of such components." .

    ibc:sem-ibc2021-1015.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-1015.6-condition-1 a ibco:Condition ;
        ibco:text "where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below." .

    ibc:sem-ibc2021-1015.6-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1015.6-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.6-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.6-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 21.0 .

    ibc:sem-ibc2021-1015.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards shall be provided where the roof hatch opening is located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below." .

    ibc:sem-ibc2021-1015.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The guard shall extend not less than 30 inches (762 mm) beyond each end of the hatch parallel to the roof edge." .

    ibc:sem-ibc2021-1015.7-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-1015.7-condition-1 a ibco:Condition ;
        ibco:text "where the roof hatch opening is located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below." .

    ibc:sem-ibc2021-1015.7-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1015.7-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.7-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1015.7-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 21.0 .

    ibc:sem-ibc2021-1015.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Windows in Group R-2 and R-3 buildings including dwelling units, where the bottom of the clear opening of an operable window is located less than 36 inches (914 mm) above the finished floor and more than 72 inches (1829 mm) above the finished grade or other surface below on the exterior of the building, shall comply with one of the following:" .

    ibc:sem-ibc2021-1015.8-condition-1 a ibco:Condition ;
        ibco:text "where the bottom of the clear opening of an operable window is located less than 36 inches (914 mm) above the finished floor and more than 72 inches (1829 mm) above the finished grade or other surface below on the exterior of the building, shall comply with one of the following:" .

    ibc:sem-ibc2021-1015.8-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1015.8-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 72.0 .

    ibc:sem-ibc2021-1015.8.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Window opening control devices shall comply with ASTM F2090." .

    ibc:sem-ibc2021-1015.8.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The window opening control device, after operation to release the control device allowing the window to fully open, shall not reduce the minimum net clear opening area of the window unit to less than the area required by Section 1031.3.1." .

    ibc:sem-ibc2021-1016.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit access shall comply with the applicable provisions of Sections 1003 through 1015." .

    ibc:sem-ibc2021-1016.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access arrangement shall comply with Sections 1016 through 1021." .

    ibc:sem-ibc2021-1016.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Egress through intervening spaces shall comply with this section." .

    ibc:sem-ibc2021-1016.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than one tenant occupies any one floor of a building or structure, each tenant space, dwelling unit and sleeping unit shall be provided with access to the required exits without passing through adjacent tenant spaces, dwelling units and sleeping units." .

    ibc:sem-ibc2021-1016.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where more than one tenant occupies any one floor of a building or structure, each tenant space, dwelling unit and sleeping unit shall be provided with access to the required exits without passing through adjacent tenant spaces, dwelling units and sleeping units." .

    ibc:sem-ibc2021-1017.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Travel distance within the exit access portion of the means of egress system shall be in accordance with this section." .

    ibc:sem-ibc2021-1017.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Exit access travel distance shall not exceed the values given in Table 1017.2." .

    ibc:sem-ibc2021-1017.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1017.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access travel distances specified in Table 1017.2 shall be increased up to an additional 100 feet (30 480 mm) provided that the last portion of the exit access leading to the exit occurs on an exterior egress balcony constructed in accordance with Section 1021." .

    ibc:sem-ibc2021-1017.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The length of such balcony shall be not less than the amount of the increase taken." .

    ibc:sem-ibc2021-1017.2.1-condition-1 a ibco:Condition ;
        ibco:text "provided that the last portion of the exit access leading to the exit occurs on an exterior egress balcony constructed in accordance with Section 1021." .

    ibc:sem-ibc2021-1017.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-1017.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The maximum exit access travel distance shall be 400 feet (122 m) in Group F-1 or S-1 occupancies where all of the following conditions are met:" .

    ibc:sem-ibc2021-1017.2.2-condition-1 a ibco:Condition ;
        ibco:text "where all of the following conditions are met:" .

    ibc:sem-ibc2021-1017.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 400.0 .

    ibc:sem-ibc2021-1017.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access travel distance shall be measured from the most remote point of each room, area or space along the natural and unobstructed path of horizontal and vertical egress travel to the entrance to an exit." .

    ibc:sem-ibc2021-1017.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than one exit is required, exit access travel distance shall be measured to the nearest exit." .

    ibc:sem-ibc2021-1017.3-condition-1 a ibco:Condition ;
        ibco:text "Where more than one exit is required, exit access travel distance shall be measured to the nearest exit." .

    ibc:sem-ibc2021-1017.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Travel distance on exit access stairways or ramps shall be included in the exit access travel distance measurement." .

    ibc:sem-ibc2021-1017.3.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The measurement along stairways shall be made on a plane parallel and tangent to the stair tread nosings in the center of the stair and landings." .

    ibc:sem-ibc2021-1017.3.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The measurement along ramps shall be made on the walking surface in the center of the ramp and landings." .

    ibc:sem-ibc2021-1017.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit acess travel distance for areas open to an atrium shall comply with the requirements of Sections 1017.3.2.1 through 1017.3.2.3." .

    ibc:sem-ibc2021-1017.3.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017.2." .

    ibc:sem-ibc2021-1017.3.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017." .

    ibc:sem-ibc2021-1017.3.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017.2." .

    ibc:sem-ibc2021-1017.3.2.2-condition-1 a ibco:Condition ;
        ibco:text "Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017." .

    ibc:sem-ibc2021-1017.3.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Where the path of egress travel is not at the level of exit discharge from the atrium, that portion of the total permitted exit access travel distance that occurs within the atrium shall be not greater than 200 feet (60 960 mm)." .

    ibc:sem-ibc2021-1017.3.2.3-condition-1 a ibco:Condition ;
        ibco:text "Where the path of egress travel is not at the level of exit discharge from the atrium, that portion of the total permitted exit access travel distance that occurs within the atrium shall be not greater than 200 feet (60 960 mm)." .

    ibc:sem-ibc2021-1017.3.2.3-condition-2 a ibco:Condition ;
        ibco:text "other than the level of exit discharge." .

    ibc:sem-ibc2021-1017.3.2.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 200.0 .

    ibc:sem-ibc2021-1018.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles and aisle accessways serving as a portion of the exit access in the means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1018.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles or aisle accessways shall be provided from all occupied portions of the exit access that contain seats, tables, furnishings, displays and similar fixtures or equipment." .

    ibc:sem-ibc2021-1018.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width or required capacity of aisles shall be unobstructed." .

    ibc:sem-ibc2021-1018.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles and aisle accessways serving a room or space used for assembly purposes shall comply with Section 1030." .

    ibc:sem-ibc2021-1018.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group B and M occupancies, the minimum clear aisle width shall be determined by Section 1005.1 for the occupant load served, but shall be not less than that required for corridors by Section 1020.3." .

    ibc:sem-ibc2021-1018.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "An aisle accessway shall be provided on not less than one side of each element within the merchandise pad." .

    ibc:sem-ibc2021-1018.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The minimum clear width for an aisle accessway not required to be accessible shall be 30 inches (762 mm)." .

    ibc:sem-ibc2021-1018.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required clear width of the aisle accessway shall be measured perpendicular to the elements and merchandise within the merchandise pad." .

    ibc:sem-ibc2021-1018.4-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The 30-inch (762 mm) minimum clear width shall be maintained to provide a path to an adjacent aisle or aisle accessway." .

    ibc:sem-ibc2021-1018.4-atomic-5 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The common path of egress travel shall not exceed 30 feet (9144 mm) from any point in the merchandise pad." .

    ibc:sem-ibc2021-1018.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1018.4-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1018.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005.1 for the occupant load served, but the width shall be not less than that required for corridors by Section 1020.3." .

    ibc:sem-ibc2021-1018.5-condition-1 a ibco:Condition ;
        ibco:text "other than assembly spaces and Groups B and M." .

    ibc:sem-ibc2021-1018.5-condition-2 a ibco:Condition ;
        ibco:text "other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005." .

    ibc:sem-ibc2021-1019.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit access stairways and ramps serving as an exit access component in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1019.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The number of stories connected by exit access stairways and ramps shall include basements, but not mezzanines." .

    ibc:sem-ibc2021-1019.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Exit access stairways and ramps that serve floor levels within a single story are not required to be enclosed." .

    ibc:sem-ibc2021-1019.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:sem-ibc2021-1019.3-condition-1 a ibco:Condition ;
        ibco:text "other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:sem-ibc2021-1019.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group I-2 and I- 3 occupancies, floor openings between stories containing exit access stairways or ramps are required to be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:sem-ibc2021-1020.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Corridors serving as an exit access component in a means of egress system shall comply with the requirements of Sections 1020.2 through 1020.7." .

    ibc:sem-ibc2021-1020.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Corridors shall be fire-resistance rated in accordance with Table 1020.2." .

    ibc:sem-ibc2021-1020.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The corridor walls required to be fire-resistance rated shall comply with Section 708 for fire partitions." .

    ibc:sem-ibc2021-1020.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Elevator hoistway openings shall be protected in accordance with Section 3006.2.1." .

    ibc:sem-ibc2021-1020.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of corridors shall be determined as specified in Section 1005.1, but the minimum width shall be not less than that specified in Table 1020.3." .

    ibc:sem-ibc2021-1020.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width or required capacity of corridors shall be unobstructed." .

    ibc:sem-ibc2021-1020.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where more than one exit or exit access doorway is required, the exit access shall be arranged such that dead-end corridors do not exceed 20 feet (6096 mm) in length." .

    ibc:sem-ibc2021-1020.5-condition-1 a ibco:Condition ;
        ibco:text "Where more than one exit or exit access doorway is required, the exit access shall be arranged such that dead-end corridors do not exceed 20 feet (6096 mm) in length." .

    ibc:sem-ibc2021-1020.5-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-1020.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Corridors shall not serve as supply, return, exhaust, relief or ventilation air ducts." .

    ibc:sem-ibc2021-1020.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Use of the space between the corridor ceiling and the floor or roof structure above as a return air plenum is permitted for one or more of the following conditions:" .

    ibc:sem-ibc2021-1020.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Fire-resistance-rated corridors shall be continuous from the point of entry to an exit, and shall not be interrupted by intervening rooms." .

    ibc:sem-ibc2021-1020.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the path of egress travel within a fire-resistance-rated corridor to the exit includes travel along unenclosed exit access stairways or ramps, the fire-resistance rating shall be continuous for the length of the stairway or ramp and for the length of the connecting corridor on the adjacent floor leading to the exit." .

    ibc:sem-ibc2021-1020.7-condition-1 a ibco:Condition ;
        ibco:text "Where the path of egress travel within a fire-resistance-rated corridor to the exit includes travel along unenclosed exit access stairways or ramps, the fire-resistance rating shall be continuous for the length of the stairway or ramp and for the length of the connecting corridor on the adjacent floor leading to the exit." .

    ibc:sem-ibc2021-1021.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Balconies used for egress purposes shall conform to the same requirements as corridors for minimum width, required capacity, headroom, dead ends and projections." .

    ibc:sem-ibc2021-1021.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior egress balconies shall be separated from the interior of the building by walls and opening protectives as required for corridors." .

    ibc:sem-ibc2021-1021.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The long side of an egress balcony shall be not less than 50 percent open, and the open area above the guards shall be so distributed as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-1021.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1021.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior egress balconies shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the egress balcony to the following:" .

    ibc:sem-ibc2021-1021.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1022.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exits shall comply with Sections 1022 through 1027 and the applicable requirements of Sections 1003 through 1015." .

    ibc:sem-ibc2021-1022.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "An exit shall not be used for any purpose that interferes with its function as a means of egress." .

    ibc:sem-ibc2021-1022.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Once a given level of exit protection is achieved, such level of protection shall not be reduced until arrival at the exit discharge." .

    ibc:sem-ibc2021-1022.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exits shall be continuous from the point of entry into the exit to the exit discharge." .

    ibc:sem-ibc2021-1022.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Buildings or structures used for human occupancy shall have not less than one exterior door that meets the requirements of Section 1010.1.1." .

    ibc:sem-ibc2021-1022.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit doors shall comply with the applicable requirements of Section 1010.1." .

    ibc:sem-ibc2021-1022.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit doors shall lead directly to the exit discharge or the public way." .

    ibc:sem-ibc2021-1023.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1023.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior exit stairways and ramps shall be enclosed and lead directly to the exterior of the building or shall be extended to the exterior of the building with an exit passageway conforming to the requirements of Section 1024, except as permitted in Section 1028.2." .

    ibc:sem-ibc2021-1023.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "An interior exit stairway or ramp shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1023.1-condition-1 a ibco:Condition ;
        ibco:text "other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1023.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "At landings in interior exit stairways where two or more doors lead to the floor level, any door with direct access to an enclosed elevator lobby shall be identified by signage located on the door or directly adjacent to the door stating “Elevator Lobby.” Signage shall be in accordance with Section 1023.9.1, Items 4, 5 and 6." .

    ibc:sem-ibc2021-1023.10-condition-1 a ibco:Condition ;
        ibco:text "where two or more doors lead to the floor level, any door with direct access to an enclosed elevator lobby shall be identified by signage located on the door or directly adjacent to the door stating “Elevator Lobby." .

    ibc:sem-ibc2021-1023.11-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117.1 shall be located at each floor-level landing adjacent to the door leading from the interior exit stairway and ramp into the corridor." .

    ibc:sem-ibc2021-1023.11-condition-1 a ibco:Condition ;
        ibco:text "Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117." .

    ibc:sem-ibc2021-1023.12-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where required by Section 403.5.4, 405.7.2 or 412.2.2.1, interior exit stairways and ramps shall be smokeproof enclosures in accordance with Section 909.20." .

    ibc:sem-ibc2021-1023.12-condition-1 a ibco:Condition ;
        ibco:text "Where required by Section 403." .

    ibc:sem-ibc2021-1023.12.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A smokeproof enclosure shall terminate at an exit discharge or a public way." .

    ibc:sem-ibc2021-1023.12.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The smokeproof enclosure shall be permitted to be extended by an exit passageway in accordance with Section 1023.3." .

    ibc:sem-ibc2021-1023.12.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit passageway shall be without openings other than the fire door assembly required by Section 1023.3.1 and those necessary for egress from the exit passageway." .

    ibc:sem-ibc2021-1023.12.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit passageway shall be separated from the remainder of the building by 2-hour fire barriers constructed in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1023.12.1-condition-1 a ibco:Condition ;
        ibco:text "other than the fire door assembly required by Section 1023." .

    ibc:sem-ibc2021-1023.12.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Access to the stairway or ramp within a smokeproof enclosure shall be by way of a vestibule or an open exterior balcony." .

    ibc:sem-ibc2021-1023.13-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1023.13-condition-1 a ibco:Condition ;
        ibco:text "where required by Sections 905." .

    ibc:sem-ibc2021-1023.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Enclosures for interior exit stairways and ramps shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1023.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior exit stairway and ramp enclosures shall have a fire-resistance rating of not less than 2 hours where connecting four stories or more and not less than 1 hour where connecting less than four stories." .

    ibc:sem-ibc2021-1023.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The number of stories connected by the interior exit stairways or ramps shall include any basements, but not any mezzanines." .

    ibc:sem-ibc2021-1023.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours." .

    ibc:sem-ibc2021-1023.2-condition-1 a ibco:Condition ;
        ibco:text "where connecting four stories or more and not less than 1 hour where connecting less than four stories." .

    ibc:sem-ibc2021-1023.2-condition-2 a ibco:Condition ;
        ibco:text "where connecting less than four stories." .

    ibc:sem-ibc2021-1023.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior exit stairways and ramps shall terminate at an exit discharge or a public way." .

    ibc:sem-ibc2021-1023.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where interior exit stairways and ramps are extended to an exit discharge or a public way by an exit passageway, the interior exit stairway and ramp shall be separated from the exit passageway by a fire barrier constructed in accordance with Section 707 or a horizontal assembly constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1023.3.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The fire-resistance rating shall be not less than that required for the interior exit stairway and ramp." .

    ibc:sem-ibc2021-1023.3.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A fire door assembly complying with Section 716 shall be installed in the fire barrier to provide a means of egress from the interior exit stairway and ramp to the exit passageway." .

    ibc:sem-ibc2021-1023.3.1-condition-1 a ibco:Condition ;
        ibco:text "Where interior exit stairways and ramps are extended to an exit discharge or a public way by an exit passageway, the interior exit stairway and ramp shall be separated from the exit passageway by a fire barrier constructed in accordance with Section 707 or a horizontal assembly constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1023.3.1-condition-2 a ibco:Condition ;
        ibco:text "other than the fire door assembly are prohibited." .

    ibc:sem-ibc2021-1023.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Interior exit stairway and ramp opening protectives shall be in accordance with the requirements of Section 716." .

    ibc:sem-ibc2021-1023.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings in interior exit stairways and ramps other than unprotected exterior openings shall be limited to those required for exit access to the enclosure from normally occupied spaces and for egress from the enclosure." .

    ibc:sem-ibc2021-1023.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Elevators shall not open into interior exit stairways and ramps." .

    ibc:sem-ibc2021-1023.4-condition-1 a ibco:Condition ;
        ibco:text "other than unprotected exterior openings shall be limited to those required for exit access to the enclosure from normally occupied spaces and for egress from the enclosure." .

    ibc:sem-ibc2021-1023.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Equipment and ductwork for interior exit stairway and ramp ventilation as permitted by Section 1023.5 shall comply with one of the following items:" .

    ibc:sem-ibc2021-1023.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior walls of the interior exit stairway or ramp shall comply with the requirements of Section 705 for exterior walls." .

    ibc:sem-ibc2021-1023.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where nonrated walls or unprotected openings enclose the exterior of the stairway or ramps and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour." .

    ibc:sem-ibc2021-1023.7-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour." .

    ibc:sem-ibc2021-1023.7-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the topmost landing of the stairway or ramp, or to the roof line, whichever is lower." .

    ibc:sem-ibc2021-1023.7-condition-1 a ibco:Condition ;
        ibco:text "Where nonrated walls or unprotected openings enclose the exterior of the stairway or ramps and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3." .

    ibc:sem-ibc2021-1023.7-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1023.7-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1023.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "An interior exit stairway and ramp shall not continue below its level of exit discharge unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below." .

    ibc:sem-ibc2021-1023.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Directional exit signs shall be provided as specified in Section 1013." .

    ibc:sem-ibc2021-1023.8-condition-1 a ibco:Condition ;
        ibco:text "unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below." .

    ibc:sem-ibc2021-1023.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A sign shall be provided at each floor landing in an interior exit stairway and ramp connecting more than three stories designating the floor level, the terminus of the top and bottom of the interior exit stairway and ramp and the identification of the stairway or ramp." .

    ibc:sem-ibc2021-1023.9-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The signage shall state the story of and direction to the exit discharge, and the availability of roof access from the interior exit stairway and ramp for the fire department." .

    ibc:sem-ibc2021-1023.9-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The bottom of the sign shall be located not less than 5 feet (1524 mm) above the floor landing in a position that is readily visible when the doors are in the open and closed positions." .

    ibc:sem-ibc2021-1023.9-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-1023.9.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stairway identification signs shall comply with all of the following requirements:" .

    ibc:sem-ibc2021-1024.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageways serving as an exit component in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1024.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "An exit passageway shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1024.1-condition-1 a ibco:Condition ;
        ibco:text "other than as a means of egress and a circulation path." .

    ibc:sem-ibc2021-1024.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of exit passageways shall be determined as specified in Section 1005.1 but the minimum width shall be not less than 44 inches (1118 mm), except that exit passageways serving an occupant load of less than 50 shall be not less than 36 inches (914 mm) in width." .

    ibc:sem-ibc2021-1024.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width or required capacity of exit passageways shall be unobstructed." .

    ibc:sem-ibc2021-1024.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1024.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1024.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageway enclosures shall have walls, floors and ceilings of not less than a 1-hour fireresistance rating, and not less than that required for any connecting interior exit stairway or ramp." .

    ibc:sem-ibc2021-1024.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageways shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:sem-ibc2021-1024.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageways on the level of exit discharge shall terminate at an exit discharge." .

    ibc:sem-ibc2021-1024.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageways on other levels shall terminate at an exit." .

    ibc:sem-ibc2021-1024.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit passageway opening protectives shall be in accordance with the requirements of Section 716." .

    ibc:sem-ibc2021-1024.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Except as permitted in Section 402.8.7, openings in exit passageways other than unprotected exterior openings shall be limited to those necessary for exit access to the exit passageway from normally occupied spaces and for egress from the exit passageway." .

    ibc:sem-ibc2021-1024.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an interior exit stairway or ramp is extended to an exit discharge or a public way by an exit passageway, the exit passageway shall comply with Section 1023.3.1." .

    ibc:sem-ibc2021-1024.5-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Elevators shall not open into an exit passageway." .

    ibc:sem-ibc2021-1024.5-condition-1 a ibco:Condition ;
        ibco:text "Where an interior exit stairway or ramp is extended to an exit discharge or a public way by an exit passageway, the exit passageway shall comply with Section 1023." .

    ibc:sem-ibc2021-1024.5-condition-2 a ibco:Condition ;
        ibco:text "other than unprotected exterior openings shall be limited to those necessary for exit access to the exit passageway from normally occupied spaces and for egress from the exit passageway." .

    ibc:sem-ibc2021-1024.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Equipment and ductwork for exit passageway ventilation as permitted by Section 1024.6 shall comply with one of the following:" .

    ibc:sem-ibc2021-1024.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior walls of the exit passageway shall comply with Section 705." .

    ibc:sem-ibc2021-1024.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where nonrated walls or unprotected openings enclose the exterior of the exit passageway and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour." .

    ibc:sem-ibc2021-1024.8-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour." .

    ibc:sem-ibc2021-1024.8-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the floor of the exit passageway, or to the roof line, whichever is lower." .

    ibc:sem-ibc2021-1024.8-condition-1 a ibco:Condition ;
        ibco:text "Where nonrated walls or unprotected openings enclose the exterior of the exit passageway and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3." .

    ibc:sem-ibc2021-1024.8-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1024.8-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1024.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1024.9-condition-1 a ibco:Condition ;
        ibco:text "where required by Sections 905." .

    ibc:sem-ibc2021-1025.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Approved luminous egress path markings delineating the exit path shall be provided in high-rise buildings of Group A, B, E, I-1, M or R-1 occupancies in accordance with this section." .

    ibc:sem-ibc2021-1025.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Egress path markings shall be provided in interior exit stairways, interior exit ramps and exit passageways, in accordance with Sections 1025.2.1 through 1025.2.6.3." .

    ibc:sem-ibc2021-1025.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A solid and continuous stripe shall be applied to the horizontal leading edge of each step and shall extend for the full length of the step." .

    ibc:sem-ibc2021-1025.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Outlining stripes shall have a minimum horizontal width of 1 inch (25 mm) and a maximum width of 2 inches (51 mm)." .

    ibc:sem-ibc2021-1025.2.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The leading edge of the stripe shall be placed not more than 1/2 inch (12.7 mm) from the leading edge of the step and the stripe shall not overlap the leading edge of the step by not more than 1/2 inch (12.7 mm) down the vertical face of the step." .

    ibc:sem-ibc2021-1025.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1025.2.1-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.1-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.1-measurement-4 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The leading edge of landings shall be marked with a stripe consistent with the dimensional requirements for steps." .

    ibc:sem-ibc2021-1025.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails and handrail extensions shall be marked with a solid and continuous stripe having a minimum width of 1 inch (25 mm)." .

    ibc:sem-ibc2021-1025.2.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The stripe shall be placed on the top surface of the handrail for the entire length of the handrail, including extensions and newel post caps." .

    ibc:sem-ibc2021-1025.2.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Where handrails or handrail extensions bend or turn corners, the stripe shall not have a gap of more than 4 inches (102 mm)." .

    ibc:sem-ibc2021-1025.2.3-condition-1 a ibco:Condition ;
        ibco:text "Where handrails or handrail extensions bend or turn corners, the stripe shall not have a gap of more than 4 inches (102 mm)." .

    ibc:sem-ibc2021-1025.2.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1025.2.3-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stair landings and other floor areas within interior exit stairways, interior exit ramps and exit passageways, with the exception of the sides of steps, shall be provided with solid and continuous demarcation lines on the floor or on the walls or a combination of both." .

    ibc:sem-ibc2021-1025.2.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The stripes shall be 1 to 2 inches (25 mm to 51 mm) wide with interruptions not exceeding 4 inches (102 mm)." .

    ibc:sem-ibc2021-1025.2.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.4-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Perimeter demarcation lines shall be placed within 4 inches (102 mm) of the wall and shall extend to within 2 inches (51 mm) of the markings on the leading edge of landings." .

    ibc:sem-ibc2021-1025.2.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The demarcation lines shall continue across the floor in front of all doors." .

    ibc:sem-ibc2021-1025.2.4.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.4.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.4.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Perimeter demarcation lines shall be placed on the wall with the bottom edge of the stripe not more than 4 inches (102 mm) above the finished floor." .

    ibc:sem-ibc2021-1025.2.4.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "At the top or bottom of the stairs, demarcation lines shall drop vertically to the floor within 2 inches (51 mm) of the step or landing edge." .

    ibc:sem-ibc2021-1025.2.4.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Demarcation lines on walls shall transition vertically to the floor and then extend across the floor where a line on the floor is the only practical method of outlining the path." .

    ibc:sem-ibc2021-1025.2.4.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the wall line is broken by a door, demarcation lines on walls shall continue across the face of the door or transition to the floor and extend across the floor in front of such door." .

    ibc:sem-ibc2021-1025.2.4.2-condition-1 a ibco:Condition ;
        ibco:text "where a line on the floor is the only practical method of outlining the path." .

    ibc:sem-ibc2021-1025.2.4.2-condition-2 a ibco:Condition ;
        ibco:text "Where the wall line is broken by a door, demarcation lines on walls shall continue across the face of the door or transition to the floor and extend across the floor in front of such door." .

    ibc:sem-ibc2021-1025.2.4.2-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.4.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.4.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking." .

    ibc:sem-ibc2021-1025.2.4.3-condition-1 a ibco:Condition ;
        ibco:text "Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking." .

    ibc:sem-ibc2021-1025.2.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Obstacles at or below 6 feet 6 inches (1981 mm) in height and projecting more than 4 inches (102 mm) into the egress path shall be outlined with markings not less than 1 inch (25 mm) in width comprised of a pattern of alternating equal bands, of luminous material and black, with the alternating bands not more than 2 inches (51 mm) thick and angled at 45 degrees (0.79 rad)." .

    ibc:sem-ibc2021-1025.2.5-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Obstacles shall include, but are not limited to, standpipes, hose cabinets, wall projections and restricted height areas." .

    ibc:sem-ibc2021-1025.2.5-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "However, such markings shall not conceal any required information or indicators including but not limited to instructions to occupants for the use of standpipes." .

    ibc:sem-ibc2021-1025.2.5-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1025.2.5-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1025.2.5-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.5-measurement-4 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1025.2.5-measurement-5 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1025.2.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "must" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors through which occupants must pass in order to complete the exit path shall be provided with markings complying with Sections 1025.2.6.1 through 1025.2.6.3." .

    ibc:sem-ibc2021-1025.2.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The doors shall be identified by a low-location luminous emergency exit symbol complying with NFPA 170." .

    ibc:sem-ibc2021-1025.2.6.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit symbol shall be not less than 4 inches (102 mm) in height and shall be mounted on the door, centered horizontally, with the top of the symbol not higher than 18 inches (457 mm) above the finished floor." .

    ibc:sem-ibc2021-1025.2.6.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1025.2.6.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1025.2.6.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Door hardware shall be marked with not less than 16 square inches (10323 mm2) of luminous material." .

    ibc:sem-ibc2021-1025.2.6.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "This marking shall be located behind, immediately adjacent to, or on the door handle or escutcheon." .

    ibc:sem-ibc2021-1025.2.6.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad." .

    ibc:sem-ibc2021-1025.2.6.2-condition-1 a ibco:Condition ;
        ibco:text "Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad." .

    ibc:sem-ibc2021-1025.2.6.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1025.2.6.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The top and sides of the door frame shall be marked with a solid and continuous 1-inch- to 2-inch-wide (25 mm to 51 mm) stripe." .

    ibc:sem-ibc2021-1025.2.6.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the door molding does not provide sufficient flat surface on which to locate the stripe, the stripe shall be permitted to be located on the wall surrounding the frame." .

    ibc:sem-ibc2021-1025.2.6.3-condition-1 a ibco:Condition ;
        ibco:text "Where the door molding does not provide sufficient flat surface on which to locate the stripe, the stripe shall be permitted to be located on the wall surrounding the frame." .

    ibc:sem-ibc2021-1025.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Placement and dimensions of markings shall be consistent and uniform throughout the same enclosure." .

    ibc:sem-ibc2021-1025.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Luminous egress path markings shall be permitted to be made of any material, including paint, provided that an electrical charge is not required to maintain the required luminance." .

    ibc:sem-ibc2021-1025.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such materials shall include, but not be limited to, self-luminous materials and photoluminescent materials." .

    ibc:sem-ibc2021-1025.4-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Materials shall comply with either of the following standards:" .

    ibc:sem-ibc2021-1025.4-condition-1 a ibco:Condition ;
        ibco:text "provided that an electrical charge is not required to maintain the required luminance." .

    ibc:sem-ibc2021-1025.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy." .

    ibc:sem-ibc2021-1025.5-condition-1 a ibco:Condition ;
        ibco:text "Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy." .

    ibc:sem-ibc2021-1026.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Horizontal exits serving as an exit in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1026.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "A horizontal exit shall not serve as the only exit from a portion of a building, and where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits." .

    ibc:sem-ibc2021-1026.1-condition-1 a ibco:Condition ;
        ibco:text "where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits." .

    ibc:sem-ibc2021-1026.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The separation between buildings or refuge areas connected by a horizontal exit shall be provided by a fire wall complying with Section 706; or by a fire barrier complying with Section 707 or a horizontal assembly complying with Section 711, or both." .

    ibc:sem-ibc2021-1026.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum fireresistance rating of the separation shall be 2 hours." .

    ibc:sem-ibc2021-1026.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Opening protectives in horizontal exits shall also comply with Section" .

    ibc:sem-ibc2021-1026.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Fire doors in horizontal exits shall be self-closing or automatic-closing when activated by a smoke detector in accordance with Section 716.2.6.6." .

    ibc:sem-ibc2021-1026.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Doors, where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716.2.6.6." .

    ibc:sem-ibc2021-1026.3-condition-1 a ibco:Condition ;
        ibco:text "where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716." .

    ibc:sem-ibc2021-1026.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The refuge area of a horizontal exit shall be a space occupied by the same tenant or a public area and each such refuge area shall be adequate to accommodate the original occupant load of the refuge area plus the occupant load anticipated from the adjoining compartment." .

    ibc:sem-ibc2021-1026.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The anticipated occupant load from the adjoining compartment shall be based on the capacity of the horizontal exit doors entering the refuge area or the total occupant load of the adjoining compartment, whichever is less." .

    ibc:sem-ibc2021-1026.4.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The capacity of the refuge area shall be computed based on a net floor area allowance of 3 square feet (0.2787 m2) for each occupant to be accommodated therein." .

    ibc:sem-ibc2021-1026.4.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407.5.3, 408.6.2, 420.6.1 and 422.3.2 as applicable." .

    ibc:sem-ibc2021-1026.4.1-condition-1 a ibco:Condition ;
        ibco:text "Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407." .

    ibc:sem-ibc2021-1026.4.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 3.0 .

    ibc:sem-ibc2021-1026.4.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The refuge area into which a horizontal exit leads shall be provided with exits adequate to meet the occupant requirements of this chapter, but not including the added occupant load imposed by persons entering the refuge area through horizontal exits from other areas." .

    ibc:sem-ibc2021-1026.4.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Not less than one refuge area exit shall lead directly to the exterior or to an interior exit stairway or ramp." .

    ibc:sem-ibc2021-1026.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:sem-ibc2021-1026.5-condition-1 a ibco:Condition ;
        ibco:text "where required by Sections 905." .

    ibc:sem-ibc2021-1027.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1027.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Exterior exit stairways shall not be used as an element of a required means of egress for Group I-2 occupancies." .

    ibc:sem-ibc2021-1027.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For occupancies in other than Group I-2, exterior exit stairways and ramps shall be permitted as an element of a required means of egress for buildings not exceeding six stories above grade plane or that are not high-rise buildings." .

    ibc:sem-ibc2021-1027.2-condition-1 a ibco:Condition ;
        ibco:text "other than Group I-2, exterior exit stairways and ramps shall be permitted as an element of a required means of egress for buildings not exceeding six stories above grade plane or that are not high-rise buildings." .

    ibc:sem-ibc2021-1027.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit stairways and ramps serving as an element of a required means of egress shall be open on not less than one side, except for required structural columns, beams, handrails and guards." .

    ibc:sem-ibc2021-1027.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "An open side shall have not less than 35 square feet (3.3 m2) of aggregate open area adjacent to each floor level and the level of each intermediate landing." .

    ibc:sem-ibc2021-1027.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required open area shall be located not less than 42 inches (1067 mm) above the adjacent floor or landing level." .

    ibc:sem-ibc2021-1027.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 35.0 .

    ibc:sem-ibc2021-1027.3-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1027.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The open areas adjoining exterior exit stairways or ramps shall be either yards, courts or public ways; the remaining sides are permitted to be enclosed by the exterior walls of the building." .

    ibc:sem-ibc2021-1027.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit stairways and ramps shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the stairway or ramps, including landings, to:" .

    ibc:sem-ibc2021-1027.5-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1027.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exterior exit stairways and ramps shall be separated from the interior of the building as required in Section 1023.2." .

    ibc:sem-ibc2021-1027.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings shall be limited to those necessary for egress from normally occupied spaces." .

    ibc:sem-ibc2021-1027.6-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a vertical plane projecting from the edge of an exterior exit stairway or ramp and landings is exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the exterior wall shall be rated in accordance with Section 1023.7." .

    ibc:sem-ibc2021-1027.6-condition-1 a ibco:Condition ;
        ibco:text "Where a vertical plane projecting from the edge of an exterior exit stairway or ramp and landings is exposed by other parts of the building at an angle of less than 180 degrees (3." .

    ibc:sem-ibc2021-1028.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit discharge shall comply with Sections 1028 and 1029 and the applicable requirements of Sections 1003 through 1015." .

    ibc:sem-ibc2021-1028.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exits shall discharge directly to the exterior of the building." .

    ibc:sem-ibc2021-1028.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit discharge shall be at grade or shall provide a direct path of egress travel to grade." .

    ibc:sem-ibc2021-1028.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The exit discharge shall not reenter a building." .

    ibc:sem-ibc2021-1028.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The combined use of Exceptions 1 and 2 shall not exceed 50 percent of the number and minimum width or required capacity of the required exits." .

    ibc:sem-ibc2021-1028.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 50.0 .

    ibc:sem-ibc2021-1028.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum width or required capacity of the exit discharge shall be not less than the minimum width or required capacity of the exits being served." .

    ibc:sem-ibc2021-1028.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Exit discharge components shall be sufficiently open to the exterior so as to minimize the accumulation of smoke and toxic gases. *" .

    ibc:sem-ibc2021-1028.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit discharge shall provide a direct and unobstructed access to a public way." .

    ibc:sem-ibc2021-1029.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Egress courts serving as an exit discharge component in the means of egress system shall comply with the requirements in this section." .

    ibc:sem-ibc2021-1029.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of egress courts shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm), except as specified herein." .

    ibc:sem-ibc2021-1029.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Egress courts serving Group R-3 and U occupancies shall be not less than 36 inches (914 mm) in width." .

    ibc:sem-ibc2021-1029.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity and width of egress courts shall be unobstructed to a height of 7 feet (2134 mm)." .

    ibc:sem-ibc2021-1029.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The width of the egress court shall be not less than the required capacity." .

    ibc:sem-ibc2021-1029.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1029.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1029.2-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 7.0 .

    ibc:sem-ibc2021-1029.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an egress court serving a building or portion thereof is less than 10 feet (3048 mm) in width, the egress court walls shall have not less than 1-hour fire-resistance-rated construction for a distance of 10 feet (3048 mm) above the floor of the egress court." .

    ibc:sem-ibc2021-1029.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Openings within such walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour." .

    ibc:sem-ibc2021-1029.3-condition-1 a ibco:Condition ;
        ibco:text "Where an egress court serving a building or portion thereof is less than 10 feet (3048 mm) in width, the egress court walls shall have not less than 1-hour fire-resistance-rated construction for a distance of 10 feet (3048 mm) above the floor of the egress court." .

    ibc:sem-ibc2021-1029.3-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1029.3-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1030.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A room or space used for assembly purposes that contains seats, tables, displays, equipment or other material shall comply with this section." .

    ibc:sem-ibc2021-1030.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Bleachers, grandstands and folding and telescopic seating, that are not building elements, shall comply with ICC 300." .

    ibc:sem-ibc2021-1030.1.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Spaces under grandstands or bleachers shall be separated by fire barriers complying with Section 707 and horizontal assemblies complying with Section 711 with not less than 1-hour fire-resistance-rated construction." .

    ibc:sem-ibc2021-1030.10-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions between stairways and stepped aisles shall comply with either Section 1030.10.1 or 1030.10.2." .

    ibc:sem-ibc2021-1030.10.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stepped aisles, transitions and stairways that maintain the stepped aisle riser and tread dimensions shall comply with Section 1030.14 as one exit access component." .

    ibc:sem-ibc2021-1030.10.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions between stairways and stepped aisles having different riser and tread dimensions shall comply with Sections 1030.10.2.1 through 1030.10.3." .

    ibc:sem-ibc2021-1030.10.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where stairways and stepped aisles are in a straight run, transitions shall have one of the following:" .

    ibc:sem-ibc2021-1030.10.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where stairways and stepped aisles are in a straight run, transitions shall have one of the following:" .

    ibc:sem-ibc2021-1030.10.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions where the stairway changes direction from the stepped aisle shall have a minimum depth of 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater, between the stepped aisle and stairway." .

    ibc:sem-ibc2021-1030.10.2.2-condition-1 a ibco:Condition ;
        ibco:text "where the stairway changes direction from the stepped aisle shall have a minimum depth of 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater, between the stepped aisle and stairway." .

    ibc:sem-ibc2021-1030.10.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1030.10.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A distinctive marking stripe shall be provided at each nosing or leading edge adjacent to the transition." .

    ibc:sem-ibc2021-1030.10.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide." .

    ibc:sem-ibc2021-1030.10.3-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The edge marking stripe shall be distinctively different from the stepped aisle contrasting marking stripe." .

    ibc:sem-ibc2021-1030.10.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1030.10.3-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1030.11-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stepped aisles that change direction at vomitories shall comply with Section 1030.11.1 Transitions between a stepped aisle above a vomitory and a stepped aisle to the side of a vomitory shall comply with Section 1030.11.2." .

    ibc:sem-ibc2021-1030.11.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stepped aisle treads where the stepped aisle changes direction at a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater." .

    ibc:sem-ibc2021-1030.11.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The height of a stepped aisle tread above a transition at a vomitory shall comply with Section 1030.14.2.2." .

    ibc:sem-ibc2021-1030.11.1-condition-1 a ibco:Condition ;
        ibco:text "where the stepped aisle changes direction at a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater." .

    ibc:sem-ibc2021-1030.11.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1030.11.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions between the stepped aisle above a vomitory and stepped aisles to the side of a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater." .

    ibc:sem-ibc2021-1030.11.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1030.12-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles, stepped aisles and ramped aisles shall be built of materials consistent with the types permitted for the type of construction of the building." .

    ibc:sem-ibc2021-1030.12.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The surface of aisles, stepped aisles and ramped aisles shall be of slip-resistant materials that are securely attached." .

    ibc:sem-ibc2021-1030.12.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The surface for stepped aisles shall comply with Section 1011.7.1." .

    ibc:sem-ibc2021-1030.12.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Outdoor aisles, stepped aisles and ramped aisles and outdoor approaches to aisles, stepped aisles and ramped aisles shall be designed so that water will not accumulate on the walking surface." .

    ibc:sem-ibc2021-1030.13-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisle accessways for seating at tables shall comply with Section 1030.13.1." .

    ibc:sem-ibc2021-1030.13-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisle accessways for seating in rows shall comply with Section 1030.13.2." .

    ibc:sem-ibc2021-1030.13.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway shall be made to a line 19 inches (483 mm) away from and parallel to the edge of the table or counter." .

    ibc:sem-ibc2021-1030.13.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The 19-inch (483 mm) distance shall be measured perpendicular to the side of the table or counter." .

    ibc:sem-ibc2021-1030.13.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In the case of other side boundaries for aisles or aisle accessways, the clear width shall be measured to walls, edges of seating and tread edges." .

    ibc:sem-ibc2021-1030.13.1-condition-1 a ibco:Condition ;
        ibco:text "Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway shall be made to a line 19 inches (483 mm) away from and parallel to the edge of the table or counter." .

    ibc:sem-ibc2021-1030.13.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 19.0 .

    ibc:sem-ibc2021-1030.13.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisle accessways serving arrangements of seating at tables or counters shall comply with the capacity requirements of Section 1005.1 but shall not have less than 12 inches (305 mm) of width plus 1/2 inch (12.7 mm) of width for each additional 1 foot (305 mm), or fraction thereof, beyond 12 feet (3658 mm) of aisle accessway length measured from the center of the seat farthest from an aisle." .

    ibc:sem-ibc2021-1030.13.1.1-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.13.1.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1030.13.1.1-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1030.13.1.1-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.13.1.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The length of travel along the aisle accessway shall not exceed 30 feet (9144 mm) from any seat to the point where a person has a choice of two or more paths of egress travel to separate exits." .

    ibc:sem-ibc2021-1030.13.1.2-condition-1 a ibco:Condition ;
        ibco:text "where a person has a choice of two or more paths of egress travel to separate exits." .

    ibc:sem-ibc2021-1030.13.1.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.13.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind." .

    ibc:sem-ibc2021-1030.13.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where chairs have automatic or self-rising seats, the measurement shall be made with seats in the raised position." .

    ibc:sem-ibc2021-1030.13.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where any chair in the row does not have an automatic or self-rising seat, the measurements shall be made with the seat in the down position." .

    ibc:sem-ibc2021-1030.13.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For seats with folding tablet arms, row spacing shall be determined with the tablet arm in the used position." .

    ibc:sem-ibc2021-1030.13.2-condition-1 a ibco:Condition ;
        ibco:text "Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind." .

    ibc:sem-ibc2021-1030.13.2-condition-2 a ibco:Condition ;
        ibco:text "Where chairs have automatic or self-rising seats, the measurement shall be made with seats in the raised position." .

    ibc:sem-ibc2021-1030.13.2-condition-3 a ibco:Condition ;
        ibco:text "Where any chair in the row does not have an automatic or self-rising seat, the measurements shall be made with the seat in the down position." .

    ibc:sem-ibc2021-1030.13.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.13.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For rows of seating served by aisles or doorways at both ends, there shall be not more than 100 seats per row." .

    ibc:sem-ibc2021-1030.13.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.3 inch (7.6 mm) for every additional seat beyond 14 seats where seats have backrests or beyond 21 where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:sem-ibc2021-1030.13.2.1-condition-1 a ibco:Condition ;
        ibco:text "where seats have backrests or beyond 21 where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.1-condition-2 a ibco:Condition ;
        ibco:text "where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.13.2.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.3 .

    ibc:sem-ibc2021-1030.13.2.1-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-1030.13.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.6 inch (15.2 mm) for every additional seat beyond seven seats where seats have backrests or beyond 10 where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:sem-ibc2021-1030.13.2.2-condition-1 a ibco:Condition ;
        ibco:text "where seats have backrests or beyond 10 where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.2-condition-2 a ibco:Condition ;
        ibco:text "where seats are without backrests." .

    ibc:sem-ibc2021-1030.13.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.13.2.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.6 .

    ibc:sem-ibc2021-1030.13.2.2-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-1030.14-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles shall comply with Sections 1030.14.1 through 1030.14.1.3." .

    ibc:sem-ibc2021-1030.14-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Stepped aisles shall comply with Sections 1030.14.2 through 1030.14.2.4." .

    ibc:sem-ibc2021-1030.14.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles that are sloped more than 1 unit vertical in 20 units horizontal (5-percent slope) shall be considered to be a ramped aisle." .

    ibc:sem-ibc2021-1030.14.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles that serve as part of an accessible route in accordance with Sections 1009 and 1109.2 shall have a maximum slope of 1 unit vertical in 12 units horizontal (8-percent slope)." .

    ibc:sem-ibc2021-1030.14.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The slope of other ramped aisles shall not exceed 1 unit vertical in 8 units horizontal (12.5percent slope)." .

    ibc:sem-ibc2021-1030.14.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 12.5 .

    ibc:sem-ibc2021-1030.14.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1030.14.1.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The slope measured perpendicular to the direction of travel of a ramped aisle shall not be steeper than 1 unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:sem-ibc2021-1030.14.1.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles shall have landings in accordance with Sections 1012.6 through 1012.6.5." .

    ibc:sem-ibc2021-1030.14.1.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Landings for ramped aisles shall be permitted to overlap required aisles or cross aisles." .

    ibc:sem-ibc2021-1030.14.1.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles shall have edge protection in accordance with Sections 1012.10 and 1012.10.1." .

    ibc:sem-ibc2021-1030.14.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles with a slope exceeding one unit vertical in eight units horizontal (12.5-percent slope) shall consist of a series of risers and treads that extends across the full width of aisles and complies with Sections 1030.14.2.1 through 1030.14.2.4." .

    ibc:sem-ibc2021-1030.14.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Tread depths shall be not less than 11 inches (279 mm) and shall have dimensional uniformity." .

    ibc:sem-ibc2021-1030.14.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 11.0 .

    ibc:sem-ibc2021-1030.14.2.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The tolerance between adjacent risers on a stepped aisle that were designed to be equal height shall not exceed 3/16 inch (4.8 mm)." .

    ibc:sem-ibc2021-1030.14.2.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the stepped aisle is designed in accordance with Exception 1 of Section 1030.14.2.2, the stepped aisle shall be constructed so that each riser of unequal height, determined in the direction of descent, is not more than 3/8 inch (9.5 mm) in height different from adjacent risers where stepped aisle treads are less than 22 inches (560 mm) in depth and 3/4 inch (19.1 mm) in height different from adjacent risers where stepped aisle treads are 22 inches (560 mm) or greater in depth." .

    ibc:sem-ibc2021-1030.14.2.2.1-condition-1 a ibco:Condition ;
        ibco:text "Where the stepped aisle is designed in accordance with Exception 1 of Section 1030." .

    ibc:sem-ibc2021-1030.14.2.2.1-condition-2 a ibco:Condition ;
        ibco:text "where stepped aisle treads are less than 22 inches (560 mm) in depth and 3/4 inch (19." .

    ibc:sem-ibc2021-1030.14.2.2.1-condition-3 a ibco:Condition ;
        ibco:text "where stepped aisle treads are 22 inches (560 mm) or greater in depth." .

    ibc:sem-ibc2021-1030.14.2.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 16.0 .

    ibc:sem-ibc2021-1030.14.2.2.1-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 8.0 .

    ibc:sem-ibc2021-1030.14.2.2.1-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-1030.14.2.2.1-measurement-4 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 4.0 .

    ibc:sem-ibc2021-1030.14.2.2.1-measurement-5 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-1030.14.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A contrasting marking stripe shall be provided on each tread at the nosing or leading edge such that the location of each tread is readily apparent when viewed in descent." .

    ibc:sem-ibc2021-1030.14.2.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such stripe shall be not less than 1 inch (25 mm) and not more than 2 inches (51 mm) wide." .

    ibc:sem-ibc2021-1030.14.2.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 1.0 .

    ibc:sem-ibc2021-1030.14.2.3-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-1030.14.2.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Nosing and riser profile shall comply with Sections 1011.5.5 through 1011.5.5.3." .

    ibc:sem-ibc2021-1030.15-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In a building, room or space used for assembly purposes, the seats shall be securely fastened to the floor." .

    ibc:sem-ibc2021-1030.16-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ramped aisles having a slope exceeding one unit vertical in 15 units horizontal (6.7-percent slope) and stepped aisles shall be provided with handrails in compliance with Section 1014 located either at one or both sides of the aisle or within the aisle width." .

    ibc:sem-ibc2021-1030.16-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where stepped aisles have seating on one side and the aisle width is 74 inches (1880 mm) or greater, two handrails are required." .

    ibc:sem-ibc2021-1030.16-atomic-3 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where two handrails are required, one of the handrails shall be within 30 inches (762 mm) horizontally of the stepped aisle." .

    ibc:sem-ibc2021-1030.16-condition-1 a ibco:Condition ;
        ibco:text "Where stepped aisles have seating on one side and the aisle width is 74 inches (1880 mm) or greater, two handrails are required." .

    ibc:sem-ibc2021-1030.16-condition-2 a ibco:Condition ;
        ibco:text "Where two handrails are required, one of the handrails shall be within 30 inches (762 mm) horizontally of the stepped aisle." .

    ibc:sem-ibc2021-1030.16-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 74.0 .

    ibc:sem-ibc2021-1030.16-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.16.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous." .

    ibc:sem-ibc2021-1030.16.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "required" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous." .

    ibc:sem-ibc2021-1030.16.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Gaps or breaks shall be provided at intervals not exceeding five rows to facilitate access to seating and to permit crossing from one side of the aisle to the other." .

    ibc:sem-ibc2021-1030.16.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "These gaps or breaks shall have a clear width of not less than 22 inches (559 mm) and not greater than 36 inches (914 mm), measured horizontally, and the midaisle handrail shall have rounded terminations or bends." .

    ibc:sem-ibc2021-1030.16.1-condition-1 a ibco:Condition ;
        ibco:text "Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous." .

    ibc:sem-ibc2021-1030.16.1-condition-2 a ibco:Condition ;
        ibco:text "Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous." .

    ibc:sem-ibc2021-1030.16.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 22.0 .

    ibc:sem-ibc2021-1030.16.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1030.16.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Handrails located on the side of stepped aisles shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent stepped aisle flight." .

    ibc:sem-ibc2021-1030.16.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Mid-aisle handrails shall not extend beyond the lowest riser and shall terminate within 18 inches (381 mm), measured horizontally, from the lowest riser." .

    ibc:sem-ibc2021-1030.16.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exemption" ;
        ibco:text "Handrail extensions are not required." .

    ibc:sem-ibc2021-1030.16.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1030.16.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail." .

    ibc:sem-ibc2021-1030.16.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The rail shall be adequate in strength and attachment in accordance with Section 1607.9.1.2." .

    ibc:sem-ibc2021-1030.16.4-condition-1 a ibco:Condition ;
        ibco:text "Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail." .

    ibc:sem-ibc2021-1030.16.4-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.17-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Guards adjacent to seating in a building, room or space used for assembly purposes shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015 except where provided in accordance with Sections 1030.17.1 through 1030.17.4." .

    ibc:sem-ibc2021-1030.17-atomic-2 a ibco:AtomicRule ;
        ibco:modality "must" ;
        ibco:statementType "obligation" ;
        ibco:text "At bleachers, grandstands and folding and telescopic seating, guards must be provided where required by ICC 300 and Section 1030.17.1." .

    ibc:sem-ibc2021-1030.17-condition-1 a ibco:Condition ;
        ibco:text "where required by Section 1015 and shall be constructed in accordance with Section 1015 except where provided in accordance with Sections 1030." .

    ibc:sem-ibc2021-1030.17-condition-2 a ibco:Condition ;
        ibco:text "where provided in accordance with Sections 1030." .

    ibc:sem-ibc2021-1030.17-condition-3 a ibco:Condition ;
        ibco:text "where required by ICC 300 and Section 1030." .

    ibc:sem-ibc2021-1030.17.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Perimeter guards shall be provided where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1030.17.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard." .

    ibc:sem-ibc2021-1030.17.1-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface." .

    ibc:sem-ibc2021-1030.17.1-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015.3." .

    ibc:sem-ibc2021-1030.17.1-condition-1 a ibco:Condition ;
        ibco:text "where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1030.17.1-condition-2 a ibco:Condition ;
        ibco:text "Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard." .

    ibc:sem-ibc2021-1030.17.1-condition-3 a ibco:Condition ;
        ibco:text "Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface." .

    ibc:sem-ibc2021-1030.17.1-condition-4 a ibco:Condition ;
        ibco:text "Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015." .

    ibc:sem-ibc2021-1030.17.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.17.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1030.17.1-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1030.17.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Cross aisles located more than 30 inches (762 mm) above the floor or grade below shall have guards in accordance with Section 1015." .

    ibc:sem-ibc2021-1030.17.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where an elevation change of 30 inches (762 mm) or less occurs between a cross aisle and the adjacent floor or grade below, guards not less than 26 inches (660 mm) above the aisle floor shall be provided." .

    ibc:sem-ibc2021-1030.17.2-condition-1 a ibco:Condition ;
        ibco:text "Where an elevation change of 30 inches (762 mm) or less occurs between a cross aisle and the adjacent floor or grade below, guards not less than 26 inches (660 mm) above the aisle floor shall be provided." .

    ibc:sem-ibc2021-1030.17.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.17.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.17.2-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 26.0 .

    ibc:sem-ibc2021-1030.17.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Unless subject to the requirements of Section 1030.17.4, a fascia or railing system in accordance with the guard requirements of Section 1015 and having a minimum height of 26 inches (660 mm) shall be provided where the floor or footboard elevation is more than 30 inches (762 mm) above the floor or grade below and the fascia or railing would otherwise interfere with the sightlines of immediately adjacent seating." .

    ibc:sem-ibc2021-1030.17.3-condition-1 a ibco:Condition ;
        ibco:text "where the floor or footboard elevation is more than 30 inches (762 mm) above the floor or grade below and the fascia or railing would otherwise interfere with the sightlines of immediately adjacent seating." .

    ibc:sem-ibc2021-1030.17.3-condition-2 a ibco:Condition ;
        ibco:text "Unless subject to the requirements of Section 1030." .

    ibc:sem-ibc2021-1030.17.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 26.0 .

    ibc:sem-ibc2021-1030.17.3-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.17.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A fascia or railing system complying with the guard requirements of Section 1015 shall be provided for the full width of the aisle where the foot of the aisle is more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1030.17.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The fascia or railing shall be not less than 36 inches (914 mm) high and shall provide not less than 42 inches (1067 mm) measured diagonally between the top of the rail and the nosing of the nearest tread." .

    ibc:sem-ibc2021-1030.17.4-condition-1 a ibco:Condition ;
        ibco:text "where the foot of the aisle is more than 30 inches (762 mm) above the floor or grade below." .

    ibc:sem-ibc2021-1030.17.4-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.17.4-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1030.17.4-measurement-3 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 42.0 .

    ibc:sem-ibc2021-1030.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A building, room or space used for assembly purposes that has an occupant load of greater than 300 and is provided with a main exit, that main exit shall be of sufficient capacity to accommodate not less than one-half of the occupant load, but such capacity shall be not less than the total required capacity of all means of egress leading to the exit." .

    ibc:sem-ibc2021-1030.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way." .

    ibc:sem-ibc2021-1030.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In a building, room or space used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:sem-ibc2021-1030.2-condition-1 a ibco:Condition ;
        ibco:text "Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way." .

    ibc:sem-ibc2021-1030.2-condition-2 a ibco:Condition ;
        ibco:text "where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:sem-ibc2021-1030.2-condition-3 a ibco:Condition ;
        ibco:text "where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:sem-ibc2021-1030.2-condition-4 a ibco:Condition ;
        ibco:text "provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:sem-ibc2021-1030.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 10.0 .

    ibc:sem-ibc2021-1030.2-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-1030.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In addition to having access to a main exit, each level in a building used for assembly purposes having an occupant load greater than 300 and provided with a main exit, shall be provided with additional means of egress that shall provide an egress capacity for not less than one-half of the total occupant load served by that level and shall comply with Section 1007.1." .

    ibc:sem-ibc2021-1030.3-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In a building used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:sem-ibc2021-1030.3-condition-1 a ibco:Condition ;
        ibco:text "where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:sem-ibc2021-1030.3-condition-2 a ibco:Condition ;
        ibco:text "where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:sem-ibc2021-1030.3-condition-3 a ibco:Condition ;
        ibco:text "provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:sem-ibc2021-1030.3-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "PERCENT" ;
        ibco:value 100.0 .

    ibc:sem-ibc2021-1030.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In Group A-1 occupancies, where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress." .

    ibc:sem-ibc2021-1030.4-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such foyer, if not directly connected to a public street by all the main entrances or exits, shall have a straight and unobstructed corridor or path of travel to every such main entrance or exit." .

    ibc:sem-ibc2021-1030.4-condition-1 a ibco:Condition ;
        ibco:text "where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress." .

    ibc:sem-ibc2021-1030.4-condition-2 a ibco:Condition ;
        ibco:text "if not directly connected to a public street by all the main entrances or exits, shall have a straight and unobstructed corridor or path of travel to every such main entrance or exit." .

    ibc:sem-ibc2021-1030.4-condition-3 a ibco:Condition ;
        ibco:text "provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress." .

    ibc:sem-ibc2021-1030.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "For balconies, galleries or press boxes having a seating capacity of 50 or more located in a building, room or space used for assembly purposes, not less than two means of egress shall be provided, with one from each side of every balcony, gallery or press box." .

    ibc:sem-ibc2021-1030.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity of aisles shall be not less than that determined in accordance with Section 1030.6.1 where smoke-protected assembly seating is not provided, Section 1030.6.2 where smoke-protected assembly seating is provided and Section 1030.6.3 where open-air assembly seating is provided." .

    ibc:sem-ibc2021-1030.6-condition-1 a ibco:Condition ;
        ibco:text "where smoke-protected assembly seating is not provided, Section 1030." .

    ibc:sem-ibc2021-1030.6-condition-2 a ibco:Condition ;
        ibco:text "where smoke-protected assembly seating is provided and Section 1030." .

    ibc:sem-ibc2021-1030.6-condition-3 a ibco:Condition ;
        ibco:text "where open-air assembly seating is provided." .

    ibc:sem-ibc2021-1030.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity in inches (mm) of the aisles for assembly seating without smoke protection shall be not less than the occupant load served by the egress element in accordance with all of the following, as applicable:" .

    ibc:sem-ibc2021-1030.6.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The required capacity in inches (mm) of the aisle for smokeprotected assembly seating shall be not less than the occupant load served by the egress element multiplied by the appropriate factor in Table 1030.6.2." .

    ibc:sem-ibc2021-1030.6.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The total number of seats specified shall be those within the space exposed to the same smoke-protected environment." .

    ibc:sem-ibc2021-1030.6.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "permission" ;
        ibco:text "Interpolation is permitted between the specific values shown." .

    ibc:sem-ibc2021-1030.6.2-atomic-4 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A life TABLE 1030.6.2 safety evaluation, complying with NFPA 101, shall be done for a facility utilizing the reduced width requirements of Table 1030.6.2 for smoke-protected assembly seating. " .

    ibc:sem-ibc2021-1030.6.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Aisles and aisle accessways serving a smoke-protected assembly seating area shall be provided with a smoke control system complying with Section 909 or natural ventilation designed to maintain the smoke level not less than 6 feet (1829 mm) above the floor of the means of egress." .

    ibc:sem-ibc2021-1030.6.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 6.0 .

    ibc:sem-ibc2021-1030.6.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A smoke-protected assembly seating area with a roof shall have the lowest portion of the roof deck not less than 15 feet (4572 mm) above the highest aisle or aisle accessway." .

    ibc:sem-ibc2021-1030.6.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT" ;
        ibco:value 15.0 .

    ibc:sem-ibc2021-1030.6.2.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Enclosed areas with walls and ceilings in buildings or structures containing smoke-protected assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-1030.6.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In open-air assembly seating, the required capacity in inches (mm) of aisles shall be not less than the total occupant load served by the egress element multiplied by 0.08 (2.0 mm) where egress is by stepped aisle and multiplied by 0.06 (1.52 mm) where egress is by level aisles and ramped aisles." .

    ibc:sem-ibc2021-1030.6.3-condition-1 a ibco:Condition ;
        ibco:text "where egress is by stepped aisle and multiplied by 0." .

    ibc:sem-ibc2021-1030.6.3-condition-2 a ibco:Condition ;
        ibco:text "where egress is by level aisles and ramped aisles." .

    ibc:sem-ibc2021-1030.6.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Enclosed areas with walls and ceilings in buildings or structures containing open-air assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-1030.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The exit access travel distance shall comply with Section 1017." .

    ibc:sem-ibc2021-1030.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where aisles are provided for seating, the distance shall be measured along the aisles and aisle accessways without travel over or on the seats." .

    ibc:sem-ibc2021-1030.7-condition-1 a ibco:Condition ;
        ibco:text "Where aisles are provided for seating, the distance shall be measured along the aisles and aisle accessways without travel over or on the seats." .

    ibc:sem-ibc2021-1030.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The common path of egress travel shall not exceed 30 feet (9144 mm) from any seat to a point where an occupant has a choice of two paths of egress travel to two exits." .

    ibc:sem-ibc2021-1030.8-condition-1 a ibco:Condition ;
        ibco:text "where an occupant has a choice of two paths of egress travel to two exits." .

    ibc:sem-ibc2021-1030.8-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 30.0 .

    ibc:sem-ibc2021-1030.8.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there shall be not more than 24 seats between the two aisles, and the minimum clear width between rows for the row between the two aisles shall be 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row between aisles." .

    ibc:sem-ibc2021-1030.8.1-condition-1 a ibco:Condition ;
        ibco:text "Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there shall be not more than 24 seats between the two aisles, and the minimum clear width between rows for the row between the two aisles shall be 12 inches (305 mm) plus 0." .

    ibc:sem-ibc2021-1030.8.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1030.8.1-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 0.6 .

    ibc:sem-ibc2021-1030.9-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Every occupied portion of any building, room or space used for assembly purposes that contains seats, tables, displays, similar fixtures or equipment shall be provided with aisles leading to exits or exit access doorways in accordance with this section." .

    ibc:sem-ibc2021-1030.9.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum clear width for aisles shall comply with one of the following:" .

    ibc:sem-ibc2021-1030.9.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The aisle shall provide sufficient capacity for the number of persons accommodated by the catchment area served by the aisle." .

    ibc:sem-ibc2021-1030.9.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In establishing catchment areas, the assumption shall be made that there is a balanced use of all means of egress, with the number of persons in proportion to egress capacity." .

    ibc:sem-ibc2021-1030.9.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles." .

    ibc:sem-ibc2021-1030.9.3-condition-1 a ibco:Condition ;
        ibco:text "Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles." .

    ibc:sem-ibc2021-1030.9.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Those portions of aisles, where egress is possible in either of two directions, shall be uniform in minimum width or required capacity." .

    ibc:sem-ibc2021-1030.9.4-condition-1 a ibco:Condition ;
        ibco:text "where egress is possible in either of two directions, shall be uniform in minimum width or required capacity." .

    ibc:sem-ibc2021-1030.9.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Each end of an aisle shall be continuous to a cross aisle, foyer, doorway, vomitory, concourse or stairway in accordance with Section 1030.9.7 having access to an exit." .

    ibc:sem-ibc2021-1030.9.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The clear width for aisles shall be measured to walls, edges of seating and tread edges except for permitted projections." .

    ibc:sem-ibc2021-1030.9.6.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "There shall not be obstructions in the minimum width or required capacity of aisles." .

    ibc:sem-ibc2021-1030.9.7-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A stairway that connects a stepped aisle to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14." .

    ibc:sem-ibc2021-1030.9.7-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:sem-ibc2021-1030.9.8-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "A stairway that connects a vomitory to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14." .

    ibc:sem-ibc2021-1030.9.8-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:sem-ibc2021-1031.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency escape and rescue openings shall comply with the requirements of this section." .

    ibc:sem-ibc2021-1031.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "In addition to the means of egress required by this chapter, emergency escape and rescue openings shall be provided in the following occupancies:" .

    ibc:sem-ibc2021-1031.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency escape and rescue openings shall be operational from inside the room without the use of keys or tools." .

    ibc:sem-ibc2021-1031.2.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Window-opening control devices complying with ASTM F2090 shall be permitted for use on windows serving as a required emergency escape and rescue opening." .

    ibc:sem-ibc2021-1031.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency escape and rescue openings shall comply with Sections 1031.3.1 through 1031.3.3." .

    ibc:sem-ibc2021-1031.3.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency escape and rescue openings shall have a minimum net clear opening of 5.7 square feet (0.53 m2)." .

    ibc:sem-ibc2021-1031.3.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "FT2" ;
        ibco:value 5.7 .

    ibc:sem-ibc2021-1031.3.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum net clear opening height dimension shall be 24 inches (610 mm)." .

    ibc:sem-ibc2021-1031.3.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum net clear opening width dimension shall be 20 inches (508 mm)." .

    ibc:sem-ibc2021-1031.3.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The net clear opening dimensions shall be the result of normal operation of the opening." .

    ibc:sem-ibc2021-1031.3.2-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 24.0 .

    ibc:sem-ibc2021-1031.3.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-1031.3.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Emergency escape and rescue openings shall have the bottom of the clear opening not greater than 44 inches (1118 mm) measured from the floor." .

    ibc:sem-ibc2021-1031.3.3-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1031.4-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where a door is provided as the required emergency escape and rescue opening, it shall be a swinging door or a sliding door." .

    ibc:sem-ibc2021-1031.4-condition-1 a ibco:Condition ;
        ibco:text "Where a door is provided as the required emergency escape and rescue opening, it shall be a swinging door or a sliding door." .

    ibc:sem-ibc2021-1031.5-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "An emergency escape and rescue opening with the bottom of the clear opening below the adjacent grade shall be provided with an area well in accordance with Sections 1031.5.1 through 1031.5.3." .

    ibc:sem-ibc2021-1031.5.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The minimum horizontal area of the area well shall be 9 square feet (0.84 m2), with a horizontal projection and width of not less than 36 inches (914 mm)." .

    ibc:sem-ibc2021-1031.5.1-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "The area well shall allow the emergency escape and rescue opening to be fully opened." .

    ibc:sem-ibc2021-1031.5.1-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT2" ;
        ibco:value 9.0 .

    ibc:sem-ibc2021-1031.5.1-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 36.0 .

    ibc:sem-ibc2021-1031.5.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Area wells with a vertical depth of more than 44 inches (1118 mm) shall be equipped with an approved permanently affixed ladder or steps." .

    ibc:sem-ibc2021-1031.5.2-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "The ladder or steps shall not be obstructed by the emergency escape and rescue opening when the window or door is in the open position." .

    ibc:sem-ibc2021-1031.5.2-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "prohibition" ;
        ibco:text "Ladders or steps required by this section shall not be required to comply with Section 1011." .

    ibc:sem-ibc2021-1031.5.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "IN" ;
        ibco:value 44.0 .

    ibc:sem-ibc2021-1031.5.2.1-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Ladders or rungs shall have an inside width of at least 12 inches (305 mm), shall project at least 3 inches (76 mm) from the wall and shall be spaced not more than 18 inches (457 mm) on center (o.c.) vertically for the full height of the area well." .

    ibc:sem-ibc2021-1031.5.2.1-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1031.5.2.1-measurement-2 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 3.0 .

    ibc:sem-ibc2021-1031.5.2.1-measurement-3 a ibco:Measurement ;
        ibco:operator "less_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1031.5.2.2-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Steps shall have an inside width of not less than 12 inches (305 mm), shall have treads greater than 5 inches (127 mm) in depth and a riser height not greater than 18 inches (457 mm) for the full height of the area well." .

    ibc:sem-ibc2021-1031.5.2.2-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-1031.5.2.2-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 5.0 .

    ibc:sem-ibc2021-1031.5.2.2-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 18.0 .

    ibc:sem-ibc2021-1031.5.3-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Area wells shall be designed for proper drainage by connecting to the building’s foundation drainage system required by Section 1805." .

    ibc:sem-ibc2021-1031.6-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Where bars, grilles, covers, screens or similar devices are placed over emergency escape and rescue openings or area wells that serve such openings, the minimum net clear opening size shall comply with Sections 1031.3 and 1031.5." .

    ibc:sem-ibc2021-1031.6-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "obligation" ;
        ibco:text "Such devices shall be releasable or removable from the inside without the use of a key, tool or force greater than that which is required for normal operation of the emergency escape and rescue opening." .

    ibc:sem-ibc2021-1031.6-condition-1 a ibco:Condition ;
        ibco:text "Where bars, grilles, covers, screens or similar devices are placed over emergency escape and rescue openings or area wells that serve such openings, the minimum net clear opening size shall comply with Sections 1031." .

    ibc:sem-ibc2021-ch10-exception-0012-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0023-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "exception" ;
        ibco:text "Door closers and stops shall not reduce headroom to less than 78 inches (1981 mm)." .

    ibc:sem-ibc2021-ch10-exception-0023-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "A barrier shall be provided where the vertical clearance above a circulation path is less than 80 inches (2032 mm) high above the finished floor." .

    ibc:sem-ibc2021-ch10-exception-0023-atomic-3 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "The leading edge of such a barrier shall be located 27 inches (686 mm) maximum above the finished floor." .

    ibc:sem-ibc2021-ch10-exception-0023-condition-1 a ibco:Condition ;
        ibco:text "where the vertical clearance above a circulation path is less than 80 inches (2032 mm) high above the finished floor." .

    ibc:sem-ibc2021-ch10-exception-0023-measurement-1 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 78.0 .

    ibc:sem-ibc2021-ch10-exception-0023-measurement-2 a ibco:Measurement ;
        ibco:operator "less_than" ;
        ibco:unitCode "IN" ;
        ibco:value 80.0 .

    ibc:sem-ibc2021-ch10-exception-0023-measurement-3 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 27.0 .

    ibc:sem-ibc2021-ch10-exception-0025-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "exception" ;
        ibco:text "These requirements shall not apply to sloping portions of handrails between the top and bottom riser of stairs and above the ramp run." .

    ibc:sem-ibc2021-ch10-exception-0027-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "Handrails are permitted to protrude 41/2 inches (114 mm) from the wall or guard." .

    ibc:sem-ibc2021-ch10-exception-0027-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "IN" ;
        ibco:value 2.0 .

    ibc:sem-ibc2021-ch10-exception-0031-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0037-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Elevators used as an accessible means of egress in accordance with Section 1009.4." .

    ibc:sem-ibc2021-ch10-exception-0047-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Where approved by the building official, the actual number of occupants for whom each occupied space, floor or building is designed, although less than those determined by calculation, shall be permitted to be used in the determination of the design occupant load." .

    ibc:sem-ibc2021-ch10-exception-0047-condition-1 a ibco:Condition ;
        ibco:text "Where approved by the building official, the actual number of occupants for whom each occupied space, floor or building is designed, although less than those determined by calculation, shall be permitted to be used in the determination of the design occupant load." .

    ibc:sem-ibc2021-ch10-exception-0052-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0059-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Aisles and aisle accessways in rooms or spaces used for assembly purposes complying with Section 1030." .

    ibc:sem-ibc2021-ch10-exception-0063-atomic-1 a ibco:AtomicRule ;
