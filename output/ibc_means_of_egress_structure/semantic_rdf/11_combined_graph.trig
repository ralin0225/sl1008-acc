<https://example.org/ibc/2021/chapter10/entityGraph> {
    ibc:sem-ibc2021-1001.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1001.1 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1001.1-atomic-1,
            ibc:sem-ibc2021-1001.1-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1001.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1001.1 General. Buildings or portions thereof shall be provided with a means of egress system as required by this chapter. The provisions of this chapter shall control the design, construction and arrangement of means of egress components required to provide an approved means of egress from structures and portions thereof." .

    ibc:sem-ibc2021-1001.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1001.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1001.2-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1001.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1001.2 Minimum requirements. It shall be unlawful to alter a building or structure in a manner that will reduce the number of exits or the minimum width or required capacity of the means of egress to less than required by this code." .

    ibc:sem-ibc2021-1002.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1002.1 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1002.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-1002.1 ;
        ibco:statementType "obligation" ;
        ibco:text "[F] 1002.1 Maintenance. Means of egress shall be maintained in accordance with the International Fire Code." .

    ibc:sem-ibc2021-1002.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1002.2 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1002.2-atomic-1,
            ibc:sem-ibc2021-1002.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1002.2-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1002.2 ;
        ibco:statementType "obligation" ;
        ibco:text "[F] 1002.2 Fire safety and evacuation plans. Fire safety and evacuation plans shall be provided for all occupancies and buildings where required by the International Fire Code. Such fire safety and evacuation plans shall comply with the applicable provisions of Sections 401.2 and 404 of the International Fire Code." .

    ibc:sem-ibc2021-1003.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.1 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.1-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003,
            ibc:ibc2021-1015 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-1003.1 ;
        ibco:statementType "obligation" ;
        ibco:text "1003.1 Applicability. The general requirements specified in Sections 1003 through 1015 shall apply to all three elements of the means of egress system, in addition to those specific requirements for the exit access, the exit and the exit discharge detailed elsewhere in this chapter." .

    ibc:sem-ibc2021-1003.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.2 ;
        ibco:appliesTo ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.2-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0012 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1003.2-measurement-1,
            ibc:sem-ibc2021-1003.2-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-1003.2 ;
        ibco:statementType "obligation" ;
        ibco:text "1003.2 Ceiling height. The means of egress shall have a ceiling height of not less than 7 feet 6 inches (2286 mm) above the finished floor." .

    ibc:sem-ibc2021-1003.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.3 ;
        ibco:appliesTo ibc:concept-protruding-objects-on-circulation-paths ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.3-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1003.3.1,
            ibc:ibc2021-1003.3.4 ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.3 ;
        ibco:statementType "obligation" ;
        ibco:text "1003.3 Protruding objects. Protruding objects on circulation paths shall comply with the requirements of Sections 1003.3.1 through 1003.3.4." .

    ibc:sem-ibc2021-1003.3.1 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.3.1 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.3.1-atomic-1,
            ibc:sem-ibc2021-1003.3.1-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1003.3.1-condition-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0023 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1003.3.1-measurement-1,
            ibc:sem-ibc2021-1003.3.1-measurement-2 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1003.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.3.1 ;
        ibco:statementType "permission" ;
        ibco:text "1003.3.1 Headroom. Protruding objects are permitted to extend below the minimum ceiling height required by Section 1003.2 where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways. Not more than 50 percent of the ceiling area of a means of egress shall be reduced in height by protruding objects." .

    ibc:sem-ibc2021-1003.3.2 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.3.2 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.3.2-atomic-1,
            ibc:sem-ibc2021-1003.3.2-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-1003.3.2-condition-1,
            ibc:sem-ibc2021-1003.3.2-condition-2 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0025 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1003.3.2-measurement-1,
            ibc:sem-ibc2021-1003.3.2-measurement-2,
            ibc:sem-ibc2021-1003.3.2-measurement-3,
            ibc:sem-ibc2021-1003.3.2-measurement-4,
            ibc:sem-ibc2021-1003.3.2-measurement-5,
            ibc:sem-ibc2021-1003.3.2-measurement-6 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.3.2 ;
        ibco:statementType "prohibition" ;
        ibco:text "1003.3.2 Post-mounted objects. A free-standing object mounted on a post or pylon shall not overhang that post or pylon more than 4 inches (102 mm) where the lowest point of the leading edge is more than 27 inches (686 mm) and less than 80 inches (2032 mm) above the finished floor. Where a sign or other obstruction is mounted between posts or pylons and the clear distance between the posts or pylons is greater than 12 inches (305 mm), the lowest edge of such sign or obstruction shall be 27 inches (686 mm) maximum or 80 inches (2032 mm) minimum above the finished floor or ground." .

    ibc:sem-ibc2021-1003.3.3 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.3.3 ;
        ibco:appliesTo ibc:concept-objects-with-leading-edges-more-than-27-inches-685-mm-and-not-more-than-80-inches-2030-mm-above-the-finished-floor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.3.3-atomic-1 ;
        ibco:hasException ibc:ibc2021-ch10-exception-0027 ;
        ibco:hasMeasurement ibc:sem-ibc2021-1003.3.3-measurement-1,
            ibc:sem-ibc2021-1003.3.3-measurement-2,
            ibc:sem-ibc2021-1003.3.3-measurement-3 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-1003.3.3 ;
        ibco:statementType "prohibition" ;
        ibco:text "1003.3.3 Horizontal projections. Objects with leading edges more than 27 inches (685 mm) and not more than 80 inches (2030 mm) above the finished floor shall not project horizontally more than 4 inches (102 mm) into the circulation path." .

    ibc:sem-ibc2021-1003.3.4 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-1003.3.4 ;
        ibco:appliesTo ibc:concept-accessibleroute ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-1003.3.4-atomic-1 ;
