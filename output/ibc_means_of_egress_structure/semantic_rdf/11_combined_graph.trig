            ibc:ibc2021-ch10-list_item-0402,
            ibc:ibc2021-ch10-list_item-0403,
            ibc:ibc2021-ch10-list_item-0404,
            ibc:ibc2021-ch10-list_item-0405,
            ibc:ibc2021-ch10-list_item-0406,
            ibc:ibc2021-ch10-list_item-0407 ;
        ibco:label "1010.2.12" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0400 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.12 Sensor release of electrically locked egress doors. Sensor release of electric locking systems shall be permitted on doors located in the means of egress in any occupancy except Group H where installed and operated in accordance with all of the following criteria:" .

    ibc:ibc2021-1010.2.4 a ibco:Provision ;
        ibco:bbox "[73.215, 575.653, 304.253, 608.75]" ;
