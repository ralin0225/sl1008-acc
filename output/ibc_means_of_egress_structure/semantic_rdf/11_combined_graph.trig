        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0957-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "A fire-resistance rating is not required at horizontal exits between a building area and an abovegrade pedestrian walkway constructed in accordance with Section 3104, provided that the distance between connected buildings is more than 20 feet (6096 mm)." .

    ibc:sem-ibc2021-ch10-exception-0957-atomic-2 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Horizontal exits constructed as fire barriers shall be continuous from exterior wall to exterior wall so as to divide completely the floor served by the horizontal exit." .

    ibc:sem-ibc2021-ch10-exception-0957-condition-1 a ibco:Condition ;
        ibco:text "provided that the distance between connected buildings is more than 20 feet (6096 mm)." .

    ibc:sem-ibc2021-ch10-exception-0957-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than" ;
        ibco:unitCode "FT" ;
        ibco:value 20.0 .

    ibc:sem-ibc2021-ch10-exception-0962-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall_not" ;
        ibco:statementType "exception" ;
        ibco:text "The adjoining compartment shall not be required to have a stairway or door leading directly outside, provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates." .

    ibc:sem-ibc2021-ch10-exception-0962-condition-1 a ibco:Condition ;
        ibco:text "provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates." .

    ibc:sem-ibc2021-ch10-exception-0974-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "Exterior exit stairways and ramps serving individual dwelling units of Group R-3 shall have a minimum fire separation distance of 5 feet (1525 mm)." .

    ibc:sem-ibc2021-ch10-exception-0974-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
        ibco:unitCode "FT" ;
        ibco:value 5.0 .

