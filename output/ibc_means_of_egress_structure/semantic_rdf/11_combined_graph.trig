    ibc:sem-ibc2021-ch10-exception-0084-atomic-1 a ibco:AtomicRule ;
        ibco:modality "may" ;
        ibco:statementType "exception" ;
        ibco:text "Projections are permitted in corridors within Group I-2, Condition 1 in accordance with Section 407.4.3." .

    ibc:sem-ibc2021-ch10-exception-0090-atomic-1 a ibco:AtomicRule ;
