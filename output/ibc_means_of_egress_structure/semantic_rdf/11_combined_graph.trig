        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-1067-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "For smoke-protected or open-air assembly seating there shall be not more than 40 seats between the two aisles and the minimum clear width shall be 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat." .

    ibc:sem-ibc2021-ch10-exception-1067-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 12.0 .

    ibc:sem-ibc2021-ch10-exception-1067-measurement-2 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
