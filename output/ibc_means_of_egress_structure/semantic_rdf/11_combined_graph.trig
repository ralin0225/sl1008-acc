    ibc:ibc2021-ch10-exception-0424 a ibco:Exception ;
        ibco:bbox "[379.797, 373.605, 550.881, 439.77]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0425,
            ibc:ibc2021-ch10-list_item-0426,
            ibc:ibc2021-ch10-list_item-0427,
            ibc:ibc2021-ch10-list_item-0428,
            ibc:ibc2021-ch10-list_item-0429 ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0425 ;
        ibco:sourcePage 321 ;
        ibco:text "Exception: Where approved, in Group I occupancies, the installation of a sign is not required where care recipients who because of clinical needs require restraint or containment as part of the function of the treatment area." .

