    ibc:sem-ibc2021-ch10-exception-1163 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-1163 ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-1163-atomic-1 ;
