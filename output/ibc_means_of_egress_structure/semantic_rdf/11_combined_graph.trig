    ibc:sem-ibc2021-ch10-exception-1039-atomic-1 a ibco:AtomicRule ;
        ibco:modality "shall" ;
        ibco:statementType "exception" ;
        ibco:text "A roof canopy in an outdoor stadium shall be permitted to be less than 15 feet (4572 mm) above the highest aisle or aisle accessway provided that there are no objects less than 80 inches (2032 mm) above the highest aisle or aisle accessway." .

    ibc:sem-ibc2021-ch10-exception-1039-condition-1 a ibco:Condition ;
        ibco:text "provided that there are no objects less than 80 inches (2032 mm) above the highest aisle or aisle accessway." .

