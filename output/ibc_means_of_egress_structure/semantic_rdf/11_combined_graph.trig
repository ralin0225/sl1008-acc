    ibc:sem-ibc2021-ch10-exception-0234-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "An interior area of refuge at the level of exit discharge that provides direct access to an exterior exit door." .

    ibc:sem-ibc2021-ch10-exception-0237-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0244-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "The fire-resistance rating and opening protectives are not required in the exterior wall where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-exception-0244-condition-1 a ibco:Condition ;
        ibco:text "where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903." .

    ibc:sem-ibc2021-ch10-exception-0247-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "The minimum clear width of 48 inches (1219 mm) between handrails is not required at stairways serving buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-exception-0247-measurement-1 a ibco:Measurement ;
        ibco:operator "greater_than_or_equal" ;
        ibco:unitCode "IN" ;
        ibco:value 48.0 .

