        ibco:statementType "exception" ;
        ibco:text "Exception: Tactile signs required by Section 1013.4 need not be provided with illumination." .

    ibc:sem-ibc2021-ch10-exception-0655 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0655 ;
        ibco:appliesTo ibc:concept-exit,
