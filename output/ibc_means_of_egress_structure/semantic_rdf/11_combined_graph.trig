        ibco:text "4. Two-way communication systems are not required at the landings serving only freight elevators." .

    ibc:sem-ibc2021-ch10-list_item-0254 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0254 ;
