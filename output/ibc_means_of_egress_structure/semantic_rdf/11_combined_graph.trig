        ibco:statementType "declarative" ;
        ibco:text "3. Within areas of refuge." .

    ibc:sem-ibc2021-ch10-list_item-0266 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0266 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0266-condition-1 ;
        ibco:modality "unspecified" ;
