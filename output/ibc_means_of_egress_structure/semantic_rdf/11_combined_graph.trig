        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-1188 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: The ladder or steps required by Section 1031.5.2 shall be permitted to encroach not more than 6 inches (152 mm) into the required dimensions of the area well." .

    ibc:sem-ibc2021-ch10-exception-1193 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-1193 ;
        ibco:appliesTo ibc:concept-exception-a-drainage-system-for-area-wells ;
