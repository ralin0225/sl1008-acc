        ibco:text "" .

    ibc:sem-ibc2021-ch10-exception-0314-atomic-1 a ibco:AtomicRule ;
        ibco:modality "not_required" ;
        ibco:statementType "exception" ;
        ibco:text "Landing length in the direction of travel in Groups R-3 and U and within individual units of Group R-2 need not exceed 36 inches (914 mm)." .

    ibc:sem-ibc2021-ch10-exception-0314-measurement-1 a ibco:Measurement ;
        ibco:operator "equal_or_context_dependent" ;
