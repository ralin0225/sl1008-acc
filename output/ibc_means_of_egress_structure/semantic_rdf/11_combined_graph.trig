    ibc:sem-ibc2021-ch10-exception-1071-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Thirty-six inches (914 mm) where the stepped aisles serve less than 50 seats." .

    ibc:sem-ibc2021-ch10-exception-1071-condition-1 a ibco:Condition ;
        ibco:text "where the stepped aisles serve less than 50 seats." .

    ibc:sem-ibc2021-ch10-exception-1073-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
        ibco:statementType "exception" ;
        ibco:text "Twenty-three inches (584 mm) between a stepped aisle handrail and seating where a stepped aisle does not serve more than five rows on one side." .

    ibc:sem-ibc2021-ch10-exception-1073-condition-1 a ibco:Condition ;
        ibco:text "where a stepped aisle does not serve more than five rows on one side." .

    ibc:sem-ibc2021-ch10-exception-1076-atomic-1 a ibco:AtomicRule ;
        ibco:modality "unspecified" ;
