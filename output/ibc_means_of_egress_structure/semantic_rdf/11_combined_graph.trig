        ibco:sourcePage 341 ;
        ibco:text "1024.6 Penetrations. Penetrations into or through an exit passageway are prohibited except for the following:" .

    ibc:ibc2021-ch10-exception-0113 a ibco:Exception ;
        ibco:bbox "[85.199, 261.794, 304.201, 294.771]" ;
