    ibc:sem-ibc2021-ch10-exception-0584 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0584 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.78 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0584-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-exception-0584-condition-1,
            ibc:sem-ibc2021-ch10-exception-0584-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1011.12.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0584 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Other than where required by Section 1011.12.1, in buildings without an occupied roof access to the roof from the top story shall be permitted to be by an alternating tread device, a ships ladder or a permanent ladder." .

    ibc:sem-ibc2021-ch10-exception-0587 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0587 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0587-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-exception-0587-measurement-1,
            ibc:sem-ibc2021-ch10-exception-0587-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "rule_validated" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0587 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: In buildings without an occupied roof, access to the roof shall be permitted to be a roof hatch or trap door not less than 16 square feet (1.5 m2) in area and having a minimum dimension of 2 feet (610 mm)." .

    ibc:sem-ibc2021-ch10-exception-0592 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-exception-0592 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-meansofegress ;
        ibco:confidence 0.9 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-exception-0592-atomic-1,
            ibc:sem-ibc2021-ch10-exception-0592-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-exception-0592-measurement-1,
            ibc:sem-ibc2021-ch10-exception-0592-measurement-2,
            ibc:sem-ibc2021-ch10-exception-0592-measurement-3,
            ibc:sem-ibc2021-ch10-exception-0592-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0592 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Alternating tread devices used as an element of a means of egress in buildings from a mezzanine area not more than 250 square feet (23 m2) in area that serves not more than five occupants shall have a minimum tread depth of 3 inches (76 mm) with a minimum projected tread depth of 101/2 inches (267 mm). The rise to the next alternating tread surface shall not exceed 8 inches (203 mm)." .

