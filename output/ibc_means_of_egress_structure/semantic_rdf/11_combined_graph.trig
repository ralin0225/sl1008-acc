    ibc:sem-ibc2021-ch10-list_item-0259 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0259 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-signage ;
