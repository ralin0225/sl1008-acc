            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0084 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: Projections are permitted in corridors within Group I-2, Condition 1 in accordance with Section 407.4.3." .

    ibc:sem-ibc2021-ch10-exception-0090 a ibco:Requirement ;
