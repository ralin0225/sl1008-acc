    ibc:ibc-2021-chapter-10-means-of-egress a ibco:Document ;
        rdfs:label "Means of Egress" .

    ibc:ibc2021-1001.1 a ibco:Provision ;
        ibco:bbox "[61.207, 358.8, 304.222, 424.765]" ;
        ibco:heading "General" ;
        ibco:label "1001.1" ;
        ibco:partOf ibc:ibc2021-1001 ;
        ibco:precedes ibc:ibc2021-1001.2 ;
        ibco:sourcePage 304 ;
        ibco:text "1001.1 General. Buildings or portions thereof shall be provided with a means of egress system as required by this chapter. The provisions of this chapter shall control the design, construction and arrangement of means of egress components required to provide an approved means of egress from structures and portions thereof." .

    ibc:ibc2021-1001.2 a ibco:Provision ;
        ibco:bbox "[61.207, 428.739, 304.351, 472.753]" ;
        ibco:heading "Minimum requirements" ;
        ibco:label "1001.2" ;
        ibco:partOf ibc:ibc2021-1001 ;
        ibco:precedes ibc:ibc2021-1002 ;
        ibco:sourcePage 304 ;
        ibco:text "1001.2 Minimum requirements. It shall be unlawful to alter a building or structure in a manner that will reduce the number of exits or the minimum width or required capacity of the means of egress to less than required by this code." .

    ibc:ibc2021-1002.1 a ibco:Provision ;
        ibco:bbox "[61.207, 519.804, 304.158, 541.745]" ;
        ibco:heading "Maintenance" ;
        ibco:label "1002.1" ;
        ibco:partOf ibc:ibc2021-1002 ;
        ibco:precedes ibc:ibc2021-1002.2 ;
        ibco:sourcePage 304 ;
        ibco:text "[F] 1002.1 Maintenance. Means of egress shall be maintained in accordance with the International Fire Code." .

    ibc:ibc2021-1002.2 a ibco:Provision ;
        ibco:bbox "[61.207, 545.719, 304.334, 611.804]" ;
        ibco:heading "Fire safety and evacuation plans" ;
        ibco:label "1002.2" ;
        ibco:partOf ibc:ibc2021-1002 ;
        ibco:precedes ibc:ibc2021-1003 ;
        ibco:sourcePage 304 ;
        ibco:text "[F] 1002.2 Fire safety and evacuation plans. Fire safety and evacuation plans shall be provided for all occupancies and buildings where required by the International Fire Code. Such fire safety and evacuation plans shall comply with the applicable provisions of Sections 401.2 and 404 of the International Fire Code." .

    ibc:ibc2021-1003.1 a ibco:Provision ;
        ibco:bbox "[322.209, 332.685, 565.224, 354.746]",
            "[61.207, 658.736, 304.3, 691.713]" ;
        ibco:heading "Applicability" ;
        ibco:label "1003.1" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-1003.2 ;
        ibco:sourcePage 304 ;
        ibco:text "1003.1 Applicability. The general requirements specified in Sections 1003 through 1015 shall apply to all three elements of the means of egress system, in addition to those specific requirements for the exit access, the exit and the exit discharge detailed elsewhere in this chapter." .

    ibc:ibc2021-1003.3.4 a ibco:Provision ;
        ibco:bbox "[58.797, 449.764, 289.788, 471.826]" ;
        ibco:heading "Clear width" ;
        ibco:label "1003.3.4" ;
        ibco:partOf ibc:ibc2021-1003.3 ;
        ibco:precedes ibc:ibc2021-1003.4 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.3.4 Clear width. Protruding objects shall not reduce the minimum clear width of accessible routes." .

    ibc:ibc2021-1003.4 a ibco:Provision ;
        ibco:bbox "[46.796, 475.8, 289.824, 508.777]" ;
        ibco:heading "Slip-resistant surface" ;
        ibco:label "1003.4" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-1003.5 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.4 Slip-resistant surface. Circulation paths of the means of egress shall have a slip-resistant surface and be securely attached." .

    ibc:ibc2021-1003.6 a ibco:Provision ;
        ibco:bbox "[307.787, 223.692, 550.92, 322.645]" ;
        ibco:heading "Means of egress continuity" ;
        ibco:label "1003.6" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-1003.7 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.6 Means of egress continuity. The path of egress travel along a means of egress shall not be interrupted by a building element other than a means of egress component as specified in this chapter. Obstructions shall not be placed in the minimum width or required capacity of a means of egress component except projections permitted by this chapter. The minimum width or required capacity of a means of egress system shall not be diminished along the path of egress travel." .

    ibc:ibc2021-1004.1 a ibco:Provision ;
        ibco:bbox "[307.777, 443.609, 550.804, 487.778]" ;
        ibco:heading "Design occupant load" ;
        ibco:label "1004.1" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1004.2 ;
        ibco:sourcePage 305 ;
        ibco:text "1004.1 Design occupant load. In determining means of egress requirements, the number of occupants for whom means of egress facilities are provided shall be determined in accordance with this section." .

    ibc:ibc2021-1004.2.1 a ibco:Provision ;
        ibco:bbox "[319.801, 539.739, 550.907, 627.776]" ;
        ibco:heading "Intervening spaces or accessory areas" ;
        ibco:label "1004.2.1" ;
        ibco:partOf ibc:ibc2021-1004.2 ;
        ibco:precedes ibc:ibc2021-1004.2.2 ;
        ibco:sourcePage 305 ;
        ibco:text "1004.2.1 Intervening spaces or accessory areas. Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces. Design of egress path capacity shall be based on the cumulative portion of occupant loads of all rooms, areas or spaces to that point along the path of egress travel." .

    ibc:ibc2021-1004.2.2 a ibco:Provision ;
        ibco:bbox "[319.811, 631.75, 550.904, 675.763]" ;
        ibco:heading "Adjacent levels for mezzanines" ;
        ibco:label "1004.2.2" ;
        ibco:partOf ibc:ibc2021-1004.2 ;
        ibco:precedes ibc:ibc2021-1004.2.3 ;
        ibco:sourcePage 305 ;
        ibco:text "1004.2.2 Adjacent levels for mezzanines. That portion of the occupant load of a mezzanine with required egress through a room, area or space on an adjacent level shall be added to the occupant load of that room, area or space." .

    ibc:ibc2021-1004.2.3 a ibco:Provision ;
        ibco:bbox "[319.821, 679.737, 550.904, 723.75]" ;
        ibco:heading "Adjacent stories" ;
        ibco:label "1004.2.3" ;
        ibco:partOf ibc:ibc2021-1004.2 ;
        ibco:precedes ibc:ibc2021-1004.3 ;
        ibco:sourcePage 305 ;
        ibco:text "1004.2.3 Adjacent stories. Other than for the egress components designed for convergence in accordance with Section 1005.6, the occupant load from separate stories shall not be added." .

    ibc:ibc2021-1004.3 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.169, 124.774]" ;
        ibco:heading "Multiple function occupant load" ;
        ibco:label "1004.3" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1004.4 ;
        ibco:sourcePage 306 ;
        ibco:text "1004.3 Multiple function occupant load. Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently." .

    ibc:ibc2021-1004.4 a ibco:Provision ;
        ibco:bbox "[61.199, 128.748, 304.266, 205.749]" ;
        ibco:heading "Multiple occupancies" ;
        ibco:label "1004.4" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1004.5 ;
        ibco:sourcePage 306 ;
        ibco:text "1004.4 Multiple occupancies. Where a building contains two or more occupancies, the means of egress requirements shall apply to each portion of the building based on the occupancy of that space. Where two or more occupancies utilize portions of the same means of egress system, those egress components shall meet the more stringent requirements of all occupancies that are served." .

    ibc:ibc2021-1004.5.1 a ibco:Provision ;
        ibco:bbox "[73.211, 382.708, 304.243, 514.648]" ;
        ibco:heading "Increased occupant load" ;
        ibco:label "1004.5.1" ;
        ibco:partOf ibc:ibc2021-1004.5 ;
        ibco:precedes ibc:ibc2021-1004.6 ;
        ibco:sourcePage 306 ;
        ibco:text "1004.5.1 Increased occupant load. The occupant load permitted in any building, or portion thereof, is permitted to be increased from that number established for the occupancies in Table 1004.5, provided that all other requirements of the code are met based on such modified number and the occupant load does not exceed one occupant per 7 square feet (0.65 m2) of occupiable floor space. Where required by the building official, an approved aisle, seating or fixed equipment diagram substantiating any increase in occupant load shall be submitted. Where required by the building official, such diagram shall be posted." .

    ibc:ibc2021-1004.8 a ibco:Provision ;
        ibco:bbox "[46.809, 260.718, 289.872, 370.79]" ;
        ibco:heading "Concentrated business use areas" ;
        ibco:label "1004.8" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1004.9 ;
        ibco:sourcePage 307 ;
        ibco:text "1004.8 Concentrated business use areas. The occupant load factor for concentrated business use shall be applied to telephone call centers, trading floors, electronic data processing centers and similar business use areas with a higher density of occupants than would normally be expected in a typical business occupancy environment. Where approved by the building official, the occupant load for concentrated business use areas shall be the actual occupant load, but not less than one occupant per 50 square feet (4.65 m2) of gross occupiable floor space." .

    ibc:ibc2021-1004.9 a ibco:Provision ;
        ibco:bbox "[46.776, 374.764, 289.944, 451.765]" ;
        ibco:heading "Posting of occupant load" ;
        ibco:label "1004.9" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-1005 ;
        ibco:sourcePage 307 ;
        ibco:text "1004.9 Posting of occupant load. Every room or space that is an assembly occupancy shall have the occupant load of the room or space posted in a conspicuous place, near the main exit or exit access doorway from the room or space, for the intended configurations. Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent." .

    ibc:ibc2021-1005.2 a ibco:Provision ;
        ibco:bbox "[46.766, 561.803, 289.724, 605.817]" ;
        ibco:heading "Minimum width based on component" ;
        ibco:label "1005.2" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.3 ;
        ibco:sourcePage 307 ;
        ibco:text "1005.2 Minimum width based on component. The minimum width, in inches (mm), of any means of egress components shall be not less than that specified for such component, elsewhere in this code." .

    ibc:ibc2021-1005.4 a ibco:Provision ;
        ibco:bbox "[61.186, 106.796, 304.176, 150.809]" ;
        ibco:heading "Continuity" ;
        ibco:label "1005.4" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.5 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.4 Continuity. The minimum width or required capacity of the means of egress required from any story of a building shall not be reduced along the path of egress travel until arrival at the public way." .

    ibc:ibc2021-1005.5 a ibco:Provision ;
        ibco:bbox "[61.186, 154.783, 304.198, 220.748]" ;
        ibco:label "1005.5" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.6 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.5 Distribution of minimum width and required capacity. Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width." .

    ibc:ibc2021-1005.6 a ibco:Provision ;
        ibco:bbox "[61.176, 224.722, 304.261, 301.723]" ;
        ibco:heading "Egress convergence" ;
        ibco:label "1005.6" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.7 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.6 Egress convergence. Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger." .

    ibc:ibc2021-1005.7.3 a ibco:Provision ;
        ibco:bbox "[73.192, 703.792, 304.216, 736.769]" ;
        ibco:heading "Protruding objects" ;
        ibco:label "1005.7.3" ;
        ibco:partOf ibc:ibc2021-1005.7 ;
        ibco:precedes ibc:ibc2021-1006 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.7.3 Protruding objects. Protruding objects shall comply with the applicable requirements of Section 1003.3." .

    ibc:ibc2021-1006.1 a ibco:Provision ;
        ibco:bbox "[322.182, 107.606, 565.267, 151.62]" ;
        ibco:heading "General" ;
        ibco:label "1006.1" ;
        ibco:partOf ibc:ibc2021-1006 ;
        ibco:precedes ibc:ibc2021-1006.2 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.1 General. The number of exits or exit access doorways required within the means of egress system shall comply with the provisions of Section 1006.2 for spaces, including mezzanines, and Section 1006.3 for stories or occupied roofs." .

    ibc:ibc2021-1006.2.1.1 a ibco:Provision ;
        ibco:bbox "[346.185, 447.222, 565.408, 513.342]" ;
        ibco:label "1006.2.1.1" ;
        ibco:partOf ibc:ibc2021-1006.2.1 ;
        ibco:precedes ibc:ibc2021-1006.2.2 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.2.1.1 Three or more exits or exit access doorways. Three exits or exit access doorways shall be provided from any space with an occupant load of 501 to 1,000. Four exits or exit access doorways shall be provided from any space with an occupant load greater than 1,000." .

    ibc:ibc2021-1006.2.2.1 a ibco:Provision ;
        ibco:bbox "[346.193, 566.977, 565.394, 687.922]" ;
        ibco:label "1006.2.2.1" ;
        ibco:partOf ibc:ibc2021-1006.2.2 ;
        ibco:precedes ibc:ibc2021-1006.2.2.2 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.2.2.1 Boiler, incinerator and furnace rooms. Two exit access doorways are required in boiler, incinerator and furnace rooms where the area is over 500 square feet (46 m2) and any fuel-fired equipment exceeds 400,000 British thermal units (Btu) (422 000 KJ) input capacity. Where two exit access doorways are required, one is permitted to be a fixed ladder or an alternating tread device. Exit access doorways shall be separated by a horizontal distance equal to one-half the length of the maximum overall diagonal dimension of the room." .

    ibc:ibc2021-1006.2.2.2 a ibco:Provision ;
        ibco:bbox "[346.193, 692.732, 565.272, 736.782]",
            "[70.779, 69.725, 289.956, 220.748]" ;
        ibco:heading "Refrigeration machinery rooms" ;
        ibco:label "1006.2.2.2" ;
        ibco:partOf ibc:ibc2021-1006.2.2 ;
        ibco:precedes ibc:ibc2021-1006.2.2.3 ;
        ibco:sourcePage 308,
            309 ;
        ibco:text "1006.2.2.2 Refrigeration machinery rooms. Machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exits or exit access doorways. Where two exit access doorways are required, one such doorway is permitted to be served by a fixed ladder or an alternating tread device. Exit access doorways shall be separated by a horizontal distance equal to one-half the maximum horizontal dimension of the room. All portions of machinery rooms shall be within 150 feet (45 720 mm) of an exit or exit access doorway. An increase in exit access travel distance is permitted in accordance with Section 1017.1. Exit and exit access doorways shall swing in the direction of egress travel and shall be equipped with panic hardware, regardless of the occupant load served. Exit and exit access doorways shall be tight fitting and self-closing." .

    ibc:ibc2021-1006.2.2.4 a ibco:Provision ;
        ibco:bbox "[331.779, 132.683, 572.399, 228.227]" ;
        ibco:heading "Electrical rooms" ;
        ibco:label "1006.2.2.4" ;
        ibco:partOf ibc:ibc2021-1006.2.2 ;
        ibco:precedes ibc:ibc2021-1006.2.2.5 ;
        ibco:sourcePage 309 ;
        ibco:text "1006.2.2.4 Electrical rooms. T he location and number of exit or exit access doorways shall be provided for electrical rooms in accordance with Section 110.26 of NFPA 70 for electrical equipment rated 1,000 volts or less, and Section 110.33 of NFPA 70 for electrical equipment rated over 1,000 volts. Panic hardware shall be provided where required in accordance with Section 1010.2.9.2. " .

    ibc:ibc2021-1006.2.2.5 a ibco:Provision ;
        ibco:bbox "[331.769, 224.694, 550.904, 257.791]" ;
        ibco:heading "Vehicular ramps" ;
        ibco:label "1006.2.2.5" ;
        ibco:partOf ibc:ibc2021-1006.2.2 ;
        ibco:precedes ibc:ibc2021-1006.2.2.6 ;
        ibco:sourcePage 309 ;
        ibco:text "1006.2.2.5 Vehicular ramps. Vehicular ramps shall not be considered as an exit access ramp unless pedestrian facilities are provided." .

    ibc:ibc2021-1006.3.1 a ibco:Provision ;
        ibco:bbox "[73.197, 154.783, 304.294, 220.748]" ;
        ibco:heading "Occupant load" ;
        ibco:label "1006.3.1" ;
        ibco:partOf ibc:ibc2021-1006.3 ;
        ibco:precedes ibc:ibc2021-1006.3.2 ;
        ibco:sourcePage 310 ;
        ibco:text "1006.3.1 Occupant load. Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story." .

    ibc:ibc2021-1006.3.3 a ibco:Provision ;
        ibco:bbox "[381.115, 70.112, 508.482, 96.944]",
            "[73.188, 573.84, 304.325, 672.792]" ;
        ibco:heading "Egress based on occupant load" ;
        ibco:label "1006.3.3" ;
        ibco:partOf ibc:ibc2021-1006.3 ;
        ibco:precedes ibc:ibc2021-1006.3.4 ;
        ibco:sourcePage 310 ;
        ibco:text "1006.3.3 Egress based on occupant load. Each story and occupied roof shall have the minimum number of separate and distinct exits, or access to exits, as specified in Table 1006.3.3. A single exit or access to a single exit shall be permitted in accordance with Section 1006.3.4. The required number of exits, or exit access stairways or ramps providing access to exits, from any story or occupied roof shall be maintained until arrival at the exit discharge or a public way. TABLE 1006.3.3 MINIMUM NUMBER OF EXITS OR ACCESS TO EXITS PER STORY" .

    ibc:ibc2021-1007.1.2 a ibco:Provision ;
        ibco:bbox "[319.781, 582.738, 550.944, 659.739]" ;
        ibco:label "1007.1.2" ;
        ibco:partOf ibc:ibc2021-1007.1 ;
        ibco:precedes ibc:ibc2021-1007.1.3 ;
        ibco:sourcePage 311 ;
        ibco:text "1007.1.2 Three or more exits or exit access doorways. Where access to three or more exits is required, not less than two exit or exit access doorways shall be arranged in accordance with the provisions of Section 1007.1.1. Additional required exit or exit access doorways shall be arranged a reasonable distance apart so that if one becomes blocked, the others will be available." .

    ibc:ibc2021-1007.1.3.1 a ibco:Provision ;
        ibco:bbox "[85.199, 69.725, 304.241, 124.774]" ;
        ibco:label "1007.1.3.1" ;
        ibco:partOf ibc:ibc2021-1007.1.3 ;
        ibco:precedes ibc:ibc2021-1008 ;
        ibco:sourcePage 312 ;
        ibco:text "1007.1.3.1 Three or more exit access stairways or ramps. Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007.1.3." .

    ibc:ibc2021-1008.1 a ibco:Provision ;
        ibco:bbox "[61.205, 171.705, 304.296, 215.719]" ;
        ibco:heading "Means of egress illumination" ;
        ibco:label "1008.1" ;
        ibco:partOf ibc:ibc2021-1008 ;
        ibco:precedes ibc:ibc2021-1008.2 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.1 Means of egress illumination. Illumination shall be provided in the means of egress in accordance with Section 1008.2. Under emergency power, means of egress illumination shall comply with Section 1008.3." .

    ibc:ibc2021-1008.2.2 a ibco:Provision ;
        ibco:bbox "[73.197, 596.659, 304.224, 673.659]" ;
        ibco:heading "Group I-2" ;
        ibco:label "1008.2.2" ;
        ibco:partOf ibc:ibc2021-1008.2 ;
        ibco:precedes ibc:ibc2021-1008.2.3 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.2.2 Group I-2. In Group I-2 occupancies where two or more exits are required, on the exterior landings required by Section 1010.1.5, means of egress illumination levels for the exit discharge shall be provided such that failure of a single lamp in a luminaire shall not reduce the illumination level on that landing to less than 1 footcandle (11 lux)." .

    ibc:ibc2021-1008.3.4 a ibco:Provision ;
        ibco:bbox "[334.201, 626.764, 565.255, 681.813]" ;
        ibco:heading "Duration" ;
        ibco:label "1008.3.4" ;
        ibco:partOf ibc:ibc2021-1008.3 ;
        ibco:precedes ibc:ibc2021-1008.3.5 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.3.4 Duration. The emergency power system shall provide power for a duration of not less than 90 minutes and shall consist of storage batteries, unit equipment or an on-site generator. The installation of the emergency power system shall be in accordance with Section 2702." .

    ibc:ibc2021-1008.3.5 a ibco:Provision ;
        ibco:bbox "[58.799, 69.725, 289.834, 212.701]" ;
        ibco:label "1008.3.5" ;
        ibco:partOf ibc:ibc2021-1008.3 ;
        ibco:precedes ibc:ibc2021-1009 ;
        ibco:sourcePage 313 ;
        ibco:text "1008.3.5 Illumination level under emergency power. Emergency lighting facilities shall be arranged to provide initial illumination that is not less than an average of 1 footcandle (11 lux) and a minimum at any point of 0.1 footcandle (1 lux) measured along the path of egress at floor level. Illumination levels shall be permitted to decline to 0.6 footcandle (6 lux) average and a minimum at any point of 0.06 footcandle (0.6 lux) at the end of the emergency lighting time duration. A maximum-to-minimum illumination uniformity ratio of 40 to 1 shall not be exceeded. In Group I-2 occupancies, failure of a single lamp in a luminaire shall not reduce the illumination level to less than 0.2 footcandle (2.2 lux)." .

    ibc:ibc2021-1009.4.1 a ibco:Provision ;
        ibco:bbox "[73.178, 193.787, 304.202, 248.836]" ;
        ibco:heading "Standby power" ;
        ibco:label "1009.4.1" ;
        ibco:partOf ibc:ibc2021-1009.4 ;
        ibco:precedes ibc:ibc2021-1009.4.2 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.4.1 Standby power. The elevator shall meet the emergency operation and signaling device requirements of Section 2.27 of ASME A17.1/CSA B44. Standby power shall be provided in accordance with Chapter 27 and Section 3003." .

    ibc:ibc2021-1009.5 a ibco:Provision ;
        ibco:bbox "[61.176, 485.694, 304.231, 540.743]" ;
        ibco:heading "Platform lifts" ;
        ibco:label "1009.5" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-1009.6 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.5 Platform lifts. Platform lifts shall be permitted to serve as part of an accessible means of egress where allowed as part of a required accessible route in Section 1110.9 except for Item 10. Standby power for the platform lift shall be provided in accordance with Chapter 27." .

    ibc:ibc2021-1009.6.1 a ibco:Provision ;
        ibco:bbox "[73.168, 581.669, 304.223, 625.682]" ;
        ibco:heading "Travel distance" ;
        ibco:label "1009.6.1" ;
        ibco:partOf ibc:ibc2021-1009.6 ;
        ibco:precedes ibc:ibc2021-1009.6.2 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6.1 Travel distance. The maximum travel distance from any accessible space to an area of refuge shall not exceed the exit access travel distance permitted for the occupancy in accordance with Section 1017.1." .

    ibc:ibc2021-1009.6.3 a ibco:Provision ;
        ibco:bbox "[334.191, 69.703, 565.327, 157.739]",
            "[73.199, 714.832, 304.142, 736.774]" ;
        ibco:heading "Size" ;
        ibco:label "1009.6.3" ;
        ibco:partOf ibc:ibc2021-1009.6 ;
        ibco:precedes ibc:ibc2021-1009.6.4 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6.3 Size. Each area of refuge shall be sized to accommodate one wheelchair space of 30 inches by 52 inches (762 mm by 1320 mm) for each 200 occupants or portion thereof, based on the occupant load of the area of refuge and areas served by the area of refuge. Such wheelchair spaces shall not reduce the means of egress minimum width or required capacity. Access to any of the required wheelchair spaces in an area of refuge shall not be obstructed by more than one adjoining wheelchair space." .

    ibc:ibc2021-1009.6.5 a ibco:Provision ;
        ibco:bbox "[334.211, 301.352, 565.327, 334.33]" ;
        ibco:heading "Two-way communication" ;
        ibco:label "1009.6.5" ;
        ibco:partOf ibc:ibc2021-1009.6 ;
        ibco:precedes ibc:ibc2021-1009.7 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6.5 Two-way communication. Areas of refuge shall be provided with a two-way communication system complying with Sections 1009.8.1 and 1009.8.2." .

    ibc:ibc2021-1009.7.1 a ibco:Provision ;
        ibco:bbox "[334.201, 436.43, 565.255, 469.527]" ;
        ibco:heading "Size" ;
        ibco:label "1009.7.1" ;
        ibco:partOf ibc:ibc2021-1009.7 ;
        ibco:precedes ibc:ibc2021-1009.7.2 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.7.1 Size. Each exterior area for assisted rescue shall be sized to accommodate wheelchair spaces in accordance with Section 1009.6.3." .

    ibc:ibc2021-1009.7.3 a ibco:Provision ;
        ibco:bbox "[334.179, 714.784, 565.186, 736.726]",
            "[58.799, 69.725, 289.819, 102.822]" ;
        ibco:heading "Openness" ;
        ibco:label "1009.7.3" ;
        ibco:partOf ibc:ibc2021-1009.7 ;
        ibco:precedes ibc:ibc2021-1009.7.4 ;
        ibco:sourcePage 314,
            315 ;
        ibco:text "1009.7.3 Openness. The exterior area for assisted rescue shall be open to the outside air. The sides other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases." .

    ibc:ibc2021-1009.8.1 a ibco:Provision ;
        ibco:bbox "[58.779, 537.745, 289.888, 647.734]" ;
        ibco:heading "System requirements" ;
        ibco:label "1009.8.1" ;
        ibco:partOf ibc:ibc2021-1009.8 ;
        ibco:precedes ibc:ibc2021-1009.8.2 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.8.1 System requirements. Two-way communication systems shall provide communication between each required location and the fire command center or a central control point location approved by the fire department. Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1. The two-way communication system shall include both audible and visible signals." .

    ibc:ibc2021-1009.8.2 a ibco:Provision ;
        ibco:bbox "[58.779, 651.708, 289.83, 728.708]" ;
        ibco:heading "Directions" ;
        ibco:label "1009.8.2" ;
        ibco:partOf ibc:ibc2021-1009.8 ;
        ibco:precedes ibc:ibc2021-1009.9 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.8.2 Directions. Directions for the use of the twoway communication system, instructions for summoning assistance via the two-way communication system and written identification of the location shall be posted adjacent to the two-way communication system. Signage shall comply with the ICC A117.1 requirements for visual characters." .

    ibc:ibc2021-1010.1.2.1 a ibco:Provision ;
        ibco:bbox "[346.2, 579.749, 586.799, 642.227]" ;
        ibco:heading "Direction of swing" ;
        ibco:label "1010.1.2.1" ;
        ibco:partOf ibc:ibc2021-1010.1.2 ;
        ibco:precedes ibc:ibc2021-1010.1.3 ;
        ibco:sourcePage 316 ;
        ibco:text "1010.1.2.1 Direction of swing. Side-hinged swinging doors, pivoted doors and balanced doors shall swing in the direction of egress travel where serving a room or area containing an occupant load of 50 or more persons or a Group H occupancy. " .

    ibc:ibc2021-1010.1.3.1 a ibco:Provision ;
        ibco:bbox "[70.799, 211.774, 289.793, 233.716]" ;
        ibco:heading "Location of applied forces" ;
        ibco:label "1010.1.3.1" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-1010.1.3.2 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.3.1 Location of applied forces. Forces shall be applied to the latch side of the door." .

    ibc:ibc2021-1010.1.3.2 a ibco:Provision ;
        ibco:bbox "[70.799, 237.81, 289.817, 292.739]" ;
        ibco:heading "Manual horizontal sliding doors" ;
        ibco:label "1010.1.3.2" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-1010.1.4 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.3.2 Manual horizontal sliding doors. Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed." .

    ibc:ibc2021-1010.2.10 a ibco:Provision ;
        ibco:bbox "[334.197, 69.619, 565.274, 102.716]",
            "[73.195, 691.711, 304.194, 735.724]" ;
        ibco:heading "Monitored or recorded egress" ;
        ibco:label "1010.2.10" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-1010.2.11 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.10 Monitored or recorded egress. Where electrical systems that monitor or record egress activity are incorporated, the locking system shall comply with Section 1010.2.11, 1010.2.12, 1010.2.13, 1010.2.14 or 1010.2.15 or shall be readily openable from the egress side without the use of a key or special knowledge or effort." .

    ibc:ibc2021-1010.2.2 a ibco:Provision ;
        ibco:bbox "[73.215, 365.716, 304.275, 409.729]" ;
        ibco:heading "Hardware" ;
        ibco:label "1010.2.2" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-1010.2.3 ;
        ibco:sourcePage 318 ;
        ibco:text "1010.2.2 Hardware. Door handles, pulls, latches, locks and other operating devices on doors required to be accessible by Chapter 11 shall not require tight grasping, tight pinching or twisting of the wrist to operate." .

    ibc:ibc2021-1010.2.6 a ibco:Provision ;
        ibco:bbox "[319.806, 95.661, 550.906, 117.722]" ;
        ibco:heading "Closet doors" ;
        ibco:label "1010.2.6" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-1010.2.7 ;
        ibco:sourcePage 319 ;
        ibco:text "1010.2.6 Closet doors. Closet doors that latch in the closed position shall be openable from inside the closet." .

    ibc:ibc2021-1010.2.9.1 a ibco:Provision ;
        ibco:bbox "[85.197, 277.769, 304.295, 343.778]" ;
        ibco:heading "Refrigeration machinery room" ;
        ibco:label "1010.2.9.1" ;
        ibco:partOf ibc:ibc2021-1010.2.9 ;
        ibco:precedes ibc:ibc2021-1010.2.9.2 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.9.1 Refrigeration machinery room. Refrigeration machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exit or exit access doorways that swing in the direction of egress travel and shall be equipped with panic hardware or fire exit hardware." .

    ibc:ibc2021-1010.2.9.2 a ibco:Provision ;
        ibco:bbox "[85.197, 347.752, 304.2, 490.728]" ;
        ibco:heading "Rooms with electrical equipment" ;
        ibco:label "1010.2.9.2" ;
        ibco:partOf ibc:ibc2021-1010.2.9 ;
        ibco:precedes ibc:ibc2021-1010.2.9.3 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.9.2 Rooms with electrical equipment. Exit or exit access doors serving transformer vaults, rooms designated for batteries or energy storage systems, or modular data centers shall be equipped with panic hardware or fire exit hardware. Rooms containing electrical equipment rated 800 amperes or more that contain overcurrent devices, switching devices or control devices and where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware. The doors shall swing in the direction of egress travel." .

    ibc:ibc2021-1010.2.9.4 a ibco:Provision ;
        ibco:bbox "[85.197, 632.688, 304.226, 687.737]" ;
        ibco:heading "Balanced doors" ;
        ibco:label "1010.2.9.4" ;
        ibco:partOf ibc:ibc2021-1010.2.9 ;
        ibco:precedes ibc:ibc2021-1010.2.10 ;
        ibco:sourcePage 320 ;
        ibco:text "1010.2.9.4 Balanced doors. If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side." .

    ibc:ibc2021-1010.3.4 a ibco:Provision ;
        ibco:bbox "[73.197, 225.698, 304.272, 335.806]" ;
        ibco:heading "Security grilles" ;
        ibco:label "1010.3.4" ;
        ibco:partOf ibc:ibc2021-1010.3 ;
        ibco:precedes ibc:ibc2021-1010.4 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.3.4 Security grilles. In Groups B, F, M and S, horizontal sliding or vertical security grilles are permitted at the main exit and shall be openable from the inside without the use of a key or special knowledge or effort during periods that the space is occupied. The grilles shall remain secured in the full-open position during the period of occupancy by the general public. Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles." .

    ibc:ibc2021-1010.4.1 a ibco:Provision ;
        ibco:bbox "[73.197, 424.719, 304.233, 523.672]" ;
        ibco:heading "Stadiums" ;
        ibco:label "1010.4.1" ;
        ibco:partOf ibc:ibc2021-1010.4 ;
        ibco:precedes ibc:ibc2021-1010.5 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.4.1 Stadiums. Panic hardware is not required on gates surrounding stadiums where such gates are under constant immediate supervision while the public is present, and where safe dispersal areas based on 3 square feet (0.28 m2) per occupant are located between the fence and enclosed space. Such required safe dispersal areas shall not be located less than 50 feet (15 240 mm) from the enclosed space. See Section 1028.5 for means of egress from safe dispersal areas." .

    ibc:ibc2021-1010.5.1.1 a ibco:Provision ;
        ibco:bbox "[346.198, 128.748, 565.206, 205.749]" ;
        ibco:heading "Clear width" ;
        ibco:label "1010.5.1.1" ;
        ibco:partOf ibc:ibc2021-1010.5.1 ;
        ibco:precedes ibc:ibc2021-1010.5.2 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.5.1.1 Clear width. Where located as part of an accessible route, turnstiles shall have not less than 36 inches (914 mm) clear width at and below a height of 34 inches (864 mm), not less than 32 inches (813 mm) clear width between 34 inches (864 mm) and 80 inches (2032 mm) and shall consist of a mechanism other than a revolving device." .

    ibc:ibc2021-1010.5.3 a ibco:Provision ;
        ibco:bbox "[58.8, 192.213, 289.795, 236.226]" ;
        ibco:heading "High turnstile" ;
        ibco:label "1010.5.3" ;
        ibco:partOf ibc:ibc2021-1010.5 ;
        ibco:precedes ibc:ibc2021-1010.5.4 ;
        ibco:sourcePage 325 ;
        ibco:text "1010.5.3 High turnstile. Turnstiles more than 39 inches (991 mm) high shall meet the requirements for revolving doors or the requirements of Section 1010.5.2 for security access turnstiles." .

    ibc:ibc2021-1011.12.1 a ibco:Provision ;
        ibco:bbox "[73.199, 346.752, 304.21, 390.765]" ;
        ibco:heading "Stairway to elevator equipment" ;
        ibco:label "1011.12.1" ;
        ibco:partOf ibc:ibc2021-1011.12 ;
        ibco:precedes ibc:ibc2021-1011.12.2 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.12.1 Stairway to elevator equipment. Roofs and penthouses containing elevator equipment that must be accessed for maintenance are required to be accessed by a stairway." .

    ibc:ibc2021-1011.13 a ibco:Provision ;
        ibco:bbox "[61.195, 490.796, 304.244, 567.797]" ;
        ibco:heading "Guards" ;
        ibco:label "1011.13" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-1011.14 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.13 Guards. Guards shall be provided along stairways and landings where required by Section 1015 and shall be constructed in accordance with Section 1015. Where the roof hatch opening providing the required access is located within 10 feet (3049 mm) of the roof edge, such roof access or roof edge shall be protected by guards installed in accordance with Section 1015." .

    ibc:ibc2021-1011.14.1 a ibco:Provision ;
        ibco:bbox "[73.206, 685.792, 304.198, 718.77]" ;
        ibco:label "1011.14.1" ;
        ibco:partOf ibc:ibc2021-1011.14 ;
        ibco:precedes ibc:ibc2021-1011.14.2 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.14.1 Handrails of alternating tread devices. Handrails shall be provided on both sides of alternating tread devices and shall comply with Section 1014." .

    ibc:ibc2021-1011.15.1 a ibco:Provision ;
        ibco:bbox "[334.188, 411.828, 565.201, 433.77]" ;
        ibco:heading "Handrails of ship’s ladders" ;
        ibco:label "1011.15.1" ;
        ibco:partOf ibc:ibc2021-1011.15 ;
        ibco:precedes ibc:ibc2021-1011.15.2 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.15.1 Handrails of ship’s ladders. Handrails shall be provided on both sides of ship’s ladders." .

    ibc:ibc2021-1011.15.2 a ibco:Provision ;
        ibco:bbox "[334.188, 437.744, 565.199, 503.87]" ;
        ibco:heading "Treads of ship’s ladders" ;
        ibco:label "1011.15.2" ;
        ibco:partOf ibc:ibc2021-1011.15 ;
        ibco:precedes ibc:ibc2021-1011.16 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.15.2 Treads of ship’s ladders. Ship’s ladders shall have a minimum tread depth of 5 inches (127 mm). The tread shall be projected such that the total of the tread depth plus the nosing projection is not less than 81/2 inches (216 mm). The maximum riser height shall be 91/2 inches (241 mm)." .

    ibc:ibc2021-1011.4 a ibco:Provision ;
        ibco:bbox "[307.775, 275.401, 550.833, 363.438]" ;
        ibco:heading "Walkline" ;
        ibco:label "1011.4" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-1011.5 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.4 Walkline. The walkline across winder treads shall be concentric to the direction of travel through the turn and located 12 inches (305 mm) from the side where the winders are narrower. The 12-inch (305 mm) dimension shall be measured from the widest point of the clear stair width at the walking surface of the winder. Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used." .

    ibc:ibc2021-1011.5.1 a ibco:Provision ;
        ibco:bbox "[319.777, 395.24, 550.741, 428.217]" ;
        ibco:heading "Dimension reference surfaces" ;
        ibco:label "1011.5.1" ;
        ibco:partOf ibc:ibc2021-1011.5 ;
        ibco:precedes ibc:ibc2021-1011.5.2 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.5.1 Dimension reference surfaces. For the purpose of this section, all dimensions are exclusive of carpets, rugs or runners." .

    ibc:ibc2021-1011.5.4.1 a ibco:Provision ;
        ibco:bbox "[346.182, 69.663, 565.123, 113.677]",
            "[85.19, 596.747, 304.225, 728.806]" ;
        ibco:heading "Nonuniform height risers" ;
        ibco:label "1011.5.4.1" ;
        ibco:partOf ibc:ibc2021-1011.5.4 ;
        ibco:precedes ibc:ibc2021-1011.5.5 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.4.1 Nonuniform height risers. Where the bottom or top riser adjoins a sloping public way, walkway or driveway having an established grade and serving as a landing, the bottom or top riser is permitted to be reduced along the slope to less than 4 inches (102 mm) in height, with the variation in height of the bottom or top riser not to exceed one unit vertical in 12 units horizontal (8-percent slope) of stair width. The nosings or leading edges of treads at such nonuniform height risers shall have a distinctive marking stripe, different from any other nosing marking provided on the stair flight. The distinctive marking stripe shall be visible in descent of the stair and shall have a slipresistant surface. Marking stripes shall have a width of not less than 1 inch (25 mm) but not more than 2 inches (51 mm)." .

    ibc:ibc2021-1011.5.5.2 a ibco:Provision ;
        ibco:bbox "[346.199, 235.804, 565.165, 279.818]" ;
        ibco:heading "Nosing projection uniformity" ;
        ibco:label "1011.5.5.2" ;
        ibco:partOf ibc:ibc2021-1011.5.5 ;
        ibco:precedes ibc:ibc2021-1011.5.5.3 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.5.2 Nosing projection uniformity. Nosing projections of the leading edges shall be of uniform size, including the projections of the nosing’s leading edge of the floor at the top of a flight." .

    ibc:ibc2021-1011.7.2 a ibco:Provision ;
        ibco:bbox "[58.802, 546.84, 289.807, 579.818]" ;
        ibco:heading "Outdoor conditions" ;
        ibco:label "1011.7.2" ;
        ibco:partOf ibc:ibc2021-1011.7 ;
        ibco:precedes ibc:ibc2021-1011.7.3 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.7.2 Outdoor conditions. Outdoor stairways and outdoor approaches to stairways shall be designed so that water will not accumulate on walking surfaces." .

    ibc:ibc2021-1011.7.4 a ibco:Provision ;
        ibco:bbox "[319.788, 69.717, 550.855, 135.802]" ;
        ibco:heading "Enclosures under exterior stairways" ;
        ibco:label "1011.7.4" ;
        ibco:partOf ibc:ibc2021-1011.7 ;
        ibco:precedes ibc:ibc2021-1011.8 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.7.4 Enclosures under exterior stairways. There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1hour fire-resistance-rated construction. The open space under exterior stairways shall not be used for any purpose." .

    ibc:ibc2021-1012.10.1 a ibco:Provision ;
        ibco:bbox "[73.202, 263.756, 304.222, 340.757]" ;
        ibco:heading "Curb, rail, wall or barrier" ;
        ibco:label "1012.10.1" ;
        ibco:partOf ibc:ibc2021-1012.10 ;
        ibco:precedes ibc:ibc2021-1012.10.2 ;
        ibco:sourcePage 330 ;
        ibco:text "1012.10.1 Curb, rail, wall or barrier. A curb, rail, wall or barrier shall be provided to serve as edge protection. A curb shall be not less than 4 inches (102 mm) in height. Barriers shall be constructed so that the barrier prevents the passage of a 4-inch-diameter (102 mm) sphere, where any portion of the sphere is within 4 inches (102 mm) of the floor or ground surface." .

    ibc:ibc2021-1012.10.2 a ibco:Provision ;
        ibco:bbox "[73.202, 344.731, 304.213, 388.744]" ;
        ibco:heading "Extended floor or ground surface" ;
        ibco:label "1012.10.2" ;
        ibco:partOf ibc:ibc2021-1012.10 ;
        ibco:precedes ibc:ibc2021-1013 ;
        ibco:sourcePage 330 ;
        ibco:text "1012.10.2 Extended floor or ground surface. The floor or ground surface of the ramp run or landing shall extend 12 inches (305 mm) minimum beyond the inside face of a handrail complying with Section 1014." .

    ibc:ibc2021-1012.2 a ibco:Provision ;
        ibco:bbox "[46.797, 335.727, 289.808, 390.776]" ;
        ibco:heading "Slope" ;
        ibco:label "1012.2" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.3 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.2 Slope. Ramps used as part of a means of egress shall have a running slope not steeper than 1 unit vertical in 12 units horizontal (8.3-percent slope). The slope of other pedestrian ramps shall not be steeper than 1 unit vertical in 8 units horizontal (12.5-percent slope)." .

    ibc:ibc2021-1012.3 a ibco:Provision ;
        ibco:bbox "[46.797, 394.75, 289.841, 427.727]" ;
        ibco:heading "Cross slope" ;
        ibco:label "1012.3" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.4 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.3 Cross slope. The slope measured perpendicular to the direction of travel of a ramp shall not be steeper than one unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:ibc2021-1012.4 a ibco:Provision ;
        ibco:bbox "[46.797, 431.701, 289.755, 453.763]" ;
        ibco:heading "Vertical rise" ;
        ibco:label "1012.4" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.5 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.4 Vertical rise. The rise for any ramp run shall be 30 inches (762 mm) maximum." .

    ibc:ibc2021-1012.5.1 a ibco:Provision ;
        ibco:bbox "[58.779, 494.688, 289.816, 560.773]" ;
        ibco:heading "Width and capacity" ;
        ibco:label "1012.5.1" ;
        ibco:partOf ibc:ibc2021-1012.5 ;
        ibco:precedes ibc:ibc2021-1012.5.2 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.5.1 Width and capacity. The minimum width and required capacity of a means of egress ramp shall be not less than that required for corridors by Section 1020.3. The clear width of a ramp between handrails, if provided, or other permissible projections shall be 36 inches (914 mm) minimum." .

    ibc:ibc2021-1012.5.2 a ibco:Provision ;
        ibco:bbox "[58.779, 564.747, 289.788, 630.712]" ;
        ibco:heading "Headroom" ;
        ibco:label "1012.5.2" ;
        ibco:partOf ibc:ibc2021-1012.5 ;
        ibco:precedes ibc:ibc2021-1012.5.3 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.5.2 Headroom. The minimum headroom in all parts of the means of egress ramp shall be not less than 80 inches (2032 mm) above the finished floor of the ramp run and any intermediate landings. The minimum clearance shall be maintained for the full width of the ramp and landing." .

    ibc:ibc2021-1012.5.3 a ibco:Provision ;
        ibco:bbox "[58.779, 634.686, 289.82, 689.862]" ;
        ibco:heading "Restrictions" ;
        ibco:label "1012.5.3" ;
        ibco:partOf ibc:ibc2021-1012.5 ;
        ibco:precedes ibc:ibc2021-1012.6 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.5.3 Restrictions. Means of egress ramps shall not reduce in width in the direction of egress travel. Projections into the required ramp and landing width are prohibited. Doors opening onto a landing shall not reduce the clear width to less than 42 inches (1067 mm)." .

    ibc:ibc2021-1012.6.1 a ibco:Provision ;
        ibco:bbox "[319.784, 117.7, 550.796, 161.713]" ;
        ibco:heading "Slope" ;
        ibco:label "1012.6.1" ;
        ibco:partOf ibc:ibc2021-1012.6 ;
        ibco:precedes ibc:ibc2021-1012.6.2 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6.1 Slope. Landings shall have a slope not steeper than one unit vertical in 48 units horizontal (2-percent slope) in any direction. Changes in level are not permitted." .

    ibc:ibc2021-1012.6.2 a ibco:Provision ;
        ibco:bbox "[319.784, 165.687, 550.744, 187.748]" ;
        ibco:heading "Width" ;
        ibco:label "1012.6.2" ;
        ibco:partOf ibc:ibc2021-1012.6 ;
        ibco:precedes ibc:ibc2021-1012.6.3 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6.2 Width. The landing width shall be not less than the width of the widest ramp run adjoining the landing." .

    ibc:ibc2021-1012.6.5 a ibco:Provision ;
        ibco:bbox "[319.775, 445.702, 550.789, 489.716]" ;
        ibco:heading "Doorways" ;
        ibco:label "1012.6.5" ;
        ibco:partOf ibc:ibc2021-1012.6 ;
        ibco:precedes ibc:ibc2021-1012.7 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6.5 Doorways. Where doorways are located adjacent to a ramp landing, maneuvering clearances required by ICC A117.1 are permitted to overlap the required landing area." .

    ibc:ibc2021-1012.7.1 a ibco:Provision ;
        ibco:bbox "[319.775, 541.677, 550.719, 563.738]" ;
        ibco:heading "Ramp surface" ;
        ibco:label "1012.7.1" ;
        ibco:partOf ibc:ibc2021-1012.7 ;
        ibco:precedes ibc:ibc2021-1012.7.2 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.7.1 Ramp surface. The surface of ramps shall be of slip-resistant materials that are securely attached." .

    ibc:ibc2021-1012.7.2 a ibco:Provision ;
        ibco:bbox "[319.775, 567.712, 550.911, 600.69]" ;
        ibco:heading "Outdoor conditions" ;
        ibco:label "1012.7.2" ;
        ibco:partOf ibc:ibc2021-1012.7 ;
        ibco:precedes ibc:ibc2021-1012.8 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.7.2 Outdoor conditions. Outdoor ramps and outdoor approaches to ramps shall be designed so that water will not accumulate on walking surfaces." .

    ibc:ibc2021-1012.8 a ibco:Provision ;
        ibco:bbox "[307.773, 604.664, 550.844, 637.787]" ;
        ibco:heading "Handrails" ;
        ibco:label "1012.8" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.9 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.8 Handrails. Ramps with a rise greater than 6 inches (152 mm) shall have handrails on both sides. Handrails shall comply with Section 1014." .

    ibc:ibc2021-1012.9 a ibco:Provision ;
        ibco:bbox "[307.802, 641.761, 550.823, 674.858]" ;
        ibco:heading "Guards" ;
        ibco:label "1012.9" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.10 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.9 Guards. Guards shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015." .

    ibc:ibc2021-1013.2 a ibco:Provision ;
        ibco:bbox "[322.172, 150.581, 565.232, 264.653]" ;
        ibco:heading "Low-level exit signs in Group R-1" ;
        ibco:label "1013.2" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-1013.3 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.2 Low-level exit signs in Group R-1. Where exit signs are required in Group R-1 occupancies by Section 1013.1, additional low-level exit signs shall be provided in all areas serving guest rooms in Group R-1 occupancies and shall comply with Section 1013.5. The bottom of the sign shall be not less than 10 inches (254 mm) nor more than 18 inches (455 mm) above the floor level. The sign shall be flush mounted to the door or wall. Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side." .

    ibc:ibc2021-1013.4 a ibco:Provision ;
        ibco:bbox "[322.172, 320.578, 565.227, 397.77]" ;
        ibco:heading "Raised character and braille exit signs" ;
        ibco:label "1013.4" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-1013.5 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.4 Raised character and braille exit signs. Where exit signs are provided at an area of refuge with direct access to a stairway, an exterior area for assisted rescue, an exit stairway or ramp, an exit passageway, a horizontal exit and the exit discharge, a sign stating \"EXIT\" in visual characters, raised characters and braille and complying with ICC A117.1 shall be provided." .

    ibc:ibc2021-1013.5 a ibco:Provision ;
        ibco:bbox "[322.21, 401.744, 565.254, 467.828]" ;
        ibco:heading "Internally illuminated exit signs" ;
        ibco:label "1013.5" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-1013.6 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.5 Internally illuminated exit signs. Electrically powered, self-luminous and photoluminescent exit signs shall be listed and labeled in accordance with UL 924 and shall be installed in accordance with the manufacturer’s instructions and Chapter 27. Exit signs shall be illuminated at all times." .

    ibc:ibc2021-1013.6.1 a ibco:Provision ;
        ibco:bbox "[334.194, 508.754, 565.381, 699.793]" ;
        ibco:heading "Graphics" ;
        ibco:label "1013.6.1" ;
        ibco:partOf ibc:ibc2021-1013.6 ;
        ibco:precedes ibc:ibc2021-1013.6.2 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.6.1 Graphics. Every exit sign and directional exit sign shall have plainly legible letters not less than 6 inches (152 mm) high with the principal strokes of the letters not less than 3/4 inch (19.1 mm) wide. The word “EXIT” shall have letters having a width not less than 2 inches (51 mm) wide, except the letter “I,” and the minimum spacing between letters shall be not less than 3/8 inch (9.5 mm). Signs larger than the minimum established in this section shall have letter widths, strokes and spacing in proportion to their height. The word “EXIT” shall be in high contrast with the background and shall be clearly discernible when the means of exit sign illumination is or is not energized. If a chevron directional indicator is provided as part of the exit sign, the construction shall be such that the direction of the chevron directional indicator cannot be readily changed." .

    ibc:ibc2021-1013.6.2 a ibco:Provision ;
        ibco:bbox "[58.799, 69.725, 289.828, 102.822]" ;
        ibco:heading "Exit sign illumination" ;
        ibco:label "1013.6.2" ;
        ibco:partOf ibc:ibc2021-1013.6 ;
        ibco:precedes ibc:ibc2021-1013.6.3 ;
        ibco:sourcePage 331 ;
        ibco:text "1013.6.2 Exit sign illumination. The face of an exit sign illuminated from an external source shall have an intensity of not less than 5 footcandles (54 lux)." .

    ibc:ibc2021-1014.1 a ibco:Provision ;
        ibco:bbox "[46.767, 322.739, 289.784, 432.727]" ;
        ibco:heading "Where required" ;
        ibco:label "1014.1" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-1014.2 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.1 Where required. Handrails serving flights of stairways, ramps, stepped aisles and ramped aisles shall be adequate in strength and attachment in accordance with Section 1607.9. Handrails required for flights of stairways by Section 1011.11 shall comply with Sections 1014.2 through 1014.9. Handrails required for ramps by Section 1012.8 shall comply with Sections 1014.2 through 1014.8. Handrails for stepped aisles and ramped aisles required by Section 1030.16 shall comply with Sections 1014.2 through 1014.8." .

    ibc:ibc2021-1014.3.1 a ibco:Provision ;
        ibco:bbox "[319.763, 191.721, 550.876, 290.862]" ;
        ibco:heading "Type I" ;
        ibco:label "1014.3.1" ;
        ibco:partOf ibc:ibc2021-1014.3 ;
        ibco:precedes ibc:ibc2021-1014.3.2 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.3.1 Type I. Handrails with a circular cross section shall have an outside diameter of not less than 11/4 inches (32 mm) and not greater than 2 inches (51 mm). Where the handrail is not circular, it shall have a perimeter dimension of not less than 4 inches (102 mm) and not greater than 61/4 inches (160 mm) with a maximum crosssectional dimension of 21/4 inches (57 mm) and minimum cross-sectional dimension of 1 inch (25 mm). Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:ibc2021-1014.3.2 a ibco:Provision ;
        ibco:bbox "[319.797, 296.758, 550.883, 450.826]" ;
        ibco:heading "Type II" ;
        ibco:label "1014.3.2" ;
        ibco:partOf ibc:ibc2021-1014.3 ;
        ibco:precedes ibc:ibc2021-1014.4 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.3.2 Type II. Handrails with a perimeter greater than 61/4 inches (160 mm) shall provide a graspable finger recess area on both sides of the profile. The finger recess shall begin within a distance of 3/4 inch (19 mm) measured vertically from the tallest portion of the profile and achieve a depth of not less than 5/16 inch (8 mm) within 7/8 inch (22 mm) below the widest portion of the profile. This required depth shall continue for not less than 3/8 inch (10 mm) to a level that is not less than 13/4 inches (45 mm) below the tallest portion of the profile. The width of the handrail above the recess shall be not less than 11/4 inches (32 mm) to not greater than 23/4 inches (70 mm). Edges shall have a minimum radius of 0.01 inch (0.25 mm)." .

    ibc:ibc2021-1014.5 a ibco:Provision ;
        ibco:bbox "[61.187, 132.353, 304.146, 154.415]" ;
        ibco:heading "Fittings" ;
        ibco:label "1014.5" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-1014.6 ;
        ibco:sourcePage 332 ;
        ibco:text "1014.5 Fittings. Handrails shall not rotate within their fittings." .

    ibc:ibc2021-1014.7 a ibco:Provision ;
        ibco:bbox "[61.177, 464.061, 304.181, 508.182]" ;
        ibco:heading "Clearance" ;
        ibco:label "1014.7" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-1014.8 ;
        ibco:sourcePage 332 ;
        ibco:text "1014.7 Clearance. Clear space between a handrail and a wall or other surface shall be not less than 11/2 inches (38 mm). A handrail and a wall or other surface adjacent to the handrail shall be free of any sharp or abrasive elements." .

    ibc:ibc2021-1014.8 a ibco:Provision ;
        ibco:bbox "[61.174, 512.515, 304.242, 688.504]" ;
        ibco:heading "Projections" ;
        ibco:label "1014.8" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-1014.9 ;
        ibco:sourcePage 332 ;
        ibco:text "1014.8 Projections. On ramps and on ramped aisles that are part of an accessible route, the clear width between handrails shall be 36 inches (914 mm) minimum. Projections into the required width of aisles, stairways and ramps at each side shall not exceed 41/2 inches (114 mm) at or below the handrail height. Projections into the required width shall not be limited above the minimum headroom height required in Section 1011.3. Projections due to intermediate handrails shall not constitute a reduction in the egress width. Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)." .

    ibc:ibc2021-1014.9 a ibco:Provision ;
        ibco:bbox "[322.166, 69.66, 565.12, 91.721]",
            "[61.174, 692.717, 304.228, 736.731]" ;
        ibco:heading "Intermediate handrails" ;
        ibco:label "1014.9" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-1015 ;
        ibco:sourcePage 332 ;
        ibco:text "1014.9 Intermediate handrails. Stairways shall have intermediate handrails located in such a manner that all portions of the stairway minimum width or required capacity are within 30 inches (762 mm) of a handrail. On monumental stairs, handrails shall be located along the most direct path of egress travel." .

    ibc:ibc2021-1015.1 a ibco:Provision ;
        ibco:bbox "[322.166, 138.653, 565.15, 193.702]" ;
        ibco:heading "General" ;
        ibco:label "1015.1" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-1015.2 ;
        ibco:sourcePage 332 ;
        ibco:text "1015.1 General. Guards shall comply with the provisions of Sections 1015.2 through 1015.7. Operable windows with sills located more than 72 inches (1829 mm) above finished grade or other surface below shall comply with Section 1015.8." .

    ibc:ibc2021-1015.2.1 a ibco:Provision ;
        ibco:bbox "[334.199, 538.799, 565.297, 604.764]" ;
        ibco:heading "Glazing" ;
        ibco:label "1015.2.1" ;
        ibco:partOf ibc:ibc2021-1015.2 ;
        ibco:precedes ibc:ibc2021-1015.3 ;
        ibco:sourcePage 332 ;
        ibco:text "1015.2.1 Glazing. Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407. Where the glazing provided does not meet the strength and attachment requirements of Section 1607.9, complying guards shall be located along glazed sides of open-sided walking surfaces." .

    ibc:ibc2021-1015.5 a ibco:Provision ;
        ibco:bbox "[307.792, 255.84, 550.891, 299.853]" ;
        ibco:heading "Screen porches" ;
        ibco:label "1015.5" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-1015.6 ;
        ibco:sourcePage 333 ;
        ibco:text "1015.5 Screen porches. Porches and decks that are enclosed with insect screening shall be provided with guards where the walking surface is located more than 30 inches (762 mm) above the floor or grade below." .

    ibc:ibc2021-1015.8.1 a ibco:Provision ;
        ibco:bbox "[73.199, 189.703, 304.212, 266.823]" ;
        ibco:heading "Window opening control devices" ;
        ibco:label "1015.8.1" ;
        ibco:partOf ibc:ibc2021-1015.8 ;
        ibco:precedes ibc:ibc2021-1016 ;
        ibco:sourcePage 334 ;
        ibco:text "1015.8.1 Window opening control devices. Window opening control devices shall comply with ASTM F2090. The window opening control device, after operation to release the control device allowing the window to fully open, shall not reduce the minimum net clear opening area of the window unit to less than the area required by Section 1031.3.1." .

    ibc:ibc2021-1016.1 a ibco:Provision ;
        ibco:bbox "[61.207, 313.755, 304.173, 346.732]" ;
        ibco:heading "General" ;
        ibco:label "1016.1" ;
        ibco:partOf ibc:ibc2021-1016 ;
        ibco:precedes ibc:ibc2021-1016.2 ;
        ibco:sourcePage 334 ;
        ibco:text "1016.1 General. The exit access shall comply with the applicable provisions of Sections 1003 through 1015. Exit access arrangement shall comply with Sections 1016 through 1021." .

    ibc:ibc2021-1017.1 a ibco:Provision ;
        ibco:bbox "[322.2, 643.714, 565.233, 676.692]" ;
        ibco:heading "General" ;
        ibco:label "1017.1" ;
        ibco:partOf ibc:ibc2021-1017 ;
        ibco:precedes ibc:ibc2021-1017.2 ;
        ibco:sourcePage 334 ;
        ibco:text "1017.1 General. Travel distance within the exit access portion of the means of egress system shall be in accordance with this section." .

    ibc:ibc2021-1017.2.1 a ibco:Provision ;
        ibco:bbox "[58.789, 628.805, 289.859, 716.841]" ;
        ibco:heading "Exterior egress balcony increase" ;
        ibco:label "1017.2.1" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-1017.2.2 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.2.1 Exterior egress balcony increase. Exit access travel distances specified in Table 1017.2 shall be increased up to an additional 100 feet (30 480 mm) provided that the last portion of the exit access leading to the exit occurs on an exterior egress balcony constructed in accordance with Section 1021. The length of such balcony shall be not less than the amount of the increase taken." .

    ibc:ibc2021-1017.3.1 a ibco:Provision ;
        ibco:bbox "[319.771, 384.745, 550.916, 472.662]" ;
        ibco:heading "Exit access stairways and ramps" ;
        ibco:label "1017.3.1" ;
        ibco:partOf ibc:ibc2021-1017.3 ;
        ibco:precedes ibc:ibc2021-1017.3.2 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3.1 Exit access stairways and ramps. Travel distance on exit access stairways or ramps shall be included in the exit access travel distance measurement. The measurement along stairways shall be made on a plane parallel and tangent to the stair tread nosings in the center of the stair and landings. The measurement along ramps shall be made on the walking surface in the center of the ramp and landings." .

    ibc:ibc2021-1017.3.2.1 a ibco:Provision ;
        ibco:bbox "[331.773, 513.707, 550.754, 557.72]" ;
        ibco:heading "Egress not through the atrium" ;
        ibco:label "1017.3.2.1" ;
        ibco:partOf ibc:ibc2021-1017.3.2 ;
        ibco:precedes ibc:ibc2021-1017.3.2.2 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3.2.1 Egress not through the atrium. Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017.2." .

    ibc:ibc2021-1017.3.2.2 a ibco:Provision ;
        ibco:bbox "[331.773, 561.694, 550.93, 616.782]" ;
        ibco:label "1017.3.2.2" ;
        ibco:partOf ibc:ibc2021-1017.3.2 ;
        ibco:precedes ibc:ibc2021-1017.3.2.3 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3.2.2 Exit access travel distance at the level of exit discharge. Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017.2." .

    ibc:ibc2021-1017.3.2.3 a ibco:Provision ;
        ibco:bbox "[331.796, 620.756, 550.827, 686.841]" ;
        ibco:label "1017.3.2.3" ;
        ibco:partOf ibc:ibc2021-1017.3.2 ;
        ibco:precedes ibc:ibc2021-1018 ;
        ibco:sourcePage 335 ;
        ibco:text "1017.3.2.3 Exit access travel distance at other than the level of exit discharge. Where the path of egress travel is not at the level of exit discharge from the atrium, that portion of the total permitted exit access travel distance that occurs within the atrium shall be not greater than 200 feet (60 960 mm)." .

    ibc:ibc2021-1018.2 a ibco:Provision ;
        ibco:bbox "[61.197, 202.771, 304.155, 235.748]" ;
        ibco:heading "Aisles in assembly spaces" ;
        ibco:label "1018.2" ;
        ibco:partOf ibc:ibc2021-1018 ;
        ibco:precedes ibc:ibc2021-1018.3 ;
        ibco:sourcePage 336 ;
        ibco:text "1018.2 Aisles in assembly spaces. Aisles and aisle accessways serving a room or space used for assembly purposes shall comply with Section 1030." .

    ibc:ibc2021-1019.1 a ibco:Provision ;
        ibco:bbox "[61.192, 636.833, 304.244, 691.763]" ;
        ibco:heading "General" ;
        ibco:label "1019.1" ;
        ibco:partOf ibc:ibc2021-1019 ;
        ibco:precedes ibc:ibc2021-1019.2 ;
        ibco:sourcePage 336 ;
        ibco:text "1019.1 General. Exit access stairways and ramps serving as an exit access component in a means of egress system shall comply with the requirements of this section. The number of stories connected by exit access stairways and ramps shall include basements, but not mezzanines." .

    ibc:ibc2021-1019.2 a ibco:Provision ;
        ibco:bbox "[322.224, 69.701, 565.262, 102.798]" ;
        ibco:heading "All occupancies" ;
        ibco:label "1019.2" ;
        ibco:partOf ibc:ibc2021-1019 ;
        ibco:precedes ibc:ibc2021-1019.3 ;
        ibco:sourcePage 336 ;
        ibco:text "1019.2 All occupancies. Exit access stairways and ramps that serve floor levels within a single story are not required to be enclosed." .

    ibc:ibc2021-1020.1 a ibco:Provision ;
        ibco:bbox "[46.798, 95.76, 289.782, 128.738]" ;
        ibco:heading "General" ;
        ibco:label "1020.1" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-1020.2 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.1 General. Corridors serving as an exit access component in a means of egress system shall comply with the requirements of Sections 1020.2 through 1020.7." .

    ibc:ibc2021-1020.2.1 a ibco:Provision ;
        ibco:bbox "[319.799, 69.725, 550.792, 102.822]" ;
        ibco:heading "Hoistway opening protection" ;
        ibco:label "1020.2.1" ;
        ibco:partOf ibc:ibc2021-1020.2 ;
        ibco:precedes ibc:ibc2021-1020.3 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.2.1 Hoistway opening protection. Elevator hoistway openings shall be protected in accordance with Section 3006.2.1." .

    ibc:ibc2021-1021.1 a ibco:Provision ;
        ibco:bbox "[322.175, 149.657, 565.192, 193.67]" ;
        ibco:heading "General" ;
        ibco:label "1021.1" ;
        ibco:partOf ibc:ibc2021-1021 ;
        ibco:precedes ibc:ibc2021-1021.2 ;
        ibco:sourcePage 338 ;
        ibco:text "1021.1 General. Balconies used for egress purposes shall conform to the same requirements as corridors for minimum width, required capacity, headroom, dead ends and projections." .

    ibc:ibc2021-1021.3 a ibco:Provision ;
        ibco:bbox "[322.197, 282.84, 565.209, 326.853]" ;
        ibco:heading "Openness" ;
        ibco:label "1021.3" ;
        ibco:partOf ibc:ibc2021-1021 ;
        ibco:precedes ibc:ibc2021-1021.4 ;
        ibco:sourcePage 338 ;
        ibco:text "1021.3 Openness. The long side of an egress balcony shall be not less than 50 percent open, and the open area above the guards shall be so distributed as to minimize the accumulation of smoke or toxic gases." .

    ibc:ibc2021-1022.1 a ibco:Provision ;
        ibco:bbox "[322.187, 523.763, 565.276, 611.799]" ;
        ibco:heading "General" ;
        ibco:label "1022.1" ;
        ibco:partOf ibc:ibc2021-1022 ;
        ibco:precedes ibc:ibc2021-1022.2 ;
        ibco:sourcePage 338 ;
        ibco:text "1022.1 General. Exits shall comply with Sections 1022 through 1027 and the applicable requirements of Sections 1003 through 1015. An exit shall not be used for any purpose that interferes with its function as a means of egress. Once a given level of exit protection is achieved, such level of protection shall not be reduced until arrival at the exit discharge. Exits shall be continuous from the point of entry into the exit to the exit discharge." .

    ibc:ibc2021-1022.2.1 a ibco:Provision ;
        ibco:bbox "[334.189, 652.725, 565.224, 685.702]" ;
        ibco:heading "Detailed requirements" ;
        ibco:label "1022.2.1" ;
        ibco:partOf ibc:ibc2021-1022.2 ;
        ibco:precedes ibc:ibc2021-1022.2.2 ;
        ibco:sourcePage 338 ;
        ibco:text "1022.2.1 Detailed requirements. Exterior exit doors shall comply with the applicable requirements of Section 1010.1." .

    ibc:ibc2021-1022.2.2 a ibco:Provision ;
        ibco:bbox "[334.189, 689.676, 565.132, 711.738]" ;
        ibco:heading "Arrangement" ;
        ibco:label "1022.2.2" ;
        ibco:partOf ibc:ibc2021-1022.2 ;
        ibco:precedes ibc:ibc2021-1023 ;
        ibco:sourcePage 338 ;
        ibco:text "1022.2.2 Arrangement. Exterior exit doors shall lead directly to the exit discharge or the public way." .

    ibc:ibc2021-1023.1 a ibco:Provision ;
        ibco:bbox "[46.798, 95.76, 289.979, 205.749]" ;
        ibco:heading "General" ;
        ibco:label "1023.1" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.2 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.1 General. Interior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section. Interior exit stairways and ramps shall be enclosed and lead directly to the exterior of the building or shall be extended to the exterior of the building with an exit passageway conforming to the requirements of Section 1024, except as permitted in Section 1028.2. An interior exit stairway or ramp shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:ibc2021-1023.10 a ibco:Provision ;
        ibco:bbox "[322.181, 334.774, 565.26, 411.775]" ;
        ibco:heading "Elevator lobby identification signs" ;
        ibco:label "1023.10" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.11 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.10 Elevator lobby identification signs. At landings in interior exit stairways where two or more doors lead to the floor level, any door with direct access to an enclosed elevator lobby shall be identified by signage located on the door or directly adjacent to the door stating “Elevator Lobby.” Signage shall be in accordance with Section 1023.9.1, Items 4, 5 and 6." .

    ibc:ibc2021-1023.11 a ibco:Provision ;
        ibco:bbox "[322.181, 415.749, 565.197, 492.749]" ;
        ibco:heading "Tactile floor-level signs" ;
        ibco:label "1023.11" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.12 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.11 Tactile floor-level signs. Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117.1 shall be located at each floor-level landing adjacent to the door leading from the interior exit stairway and ramp into the corridor." .

    ibc:ibc2021-1023.4 a ibco:Provision ;
        ibco:bbox "[307.789, 263.673, 550.852, 370.774]" ;
        ibco:heading "Openings" ;
        ibco:label "1023.4" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.5 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.4 Openings. Interior exit stairway and ramp opening protectives shall be in accordance with the requirements of Section 716. Openings in interior exit stairways and ramps other than unprotected exterior openings shall be limited to those required for exit access to the enclosure from normally occupied spaces and for egress from the enclosure. Elevators shall not open into interior exit stairways and ramps." .

    ibc:ibc2021-1023.7 a ibco:Provision ;
        ibco:bbox "[61.159, 355.736, 304.235, 520.778]" ;
        ibco:label "1023.7" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.8 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.7 Interior exit stairway and ramp exterior walls. Exterior walls of the interior exit stairway or ramp shall comply with the requirements of Section 705 for exterior walls. Where nonrated walls or unprotected openings enclose the exterior of the stairway or ramps and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour. Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour. This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the topmost landing of the stairway or ramp, or to the roof line, whichever is lower." .

    ibc:ibc2021-1023.8 a ibco:Provision ;
        ibco:bbox "[61.197, 524.752, 304.361, 590.837]" ;
        ibco:heading "Barrier at level of exit discharge" ;
        ibco:label "1023.8" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.9 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.8 Barrier at level of exit discharge. An interior exit stairway and ramp shall not continue below its level of exit discharge unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below. Directional exit signs shall be provided as specified in Section 1013." .

    ibc:ibc2021-1024.1 a ibco:Provision ;
        ibco:bbox "[46.816, 376.742, 289.892, 431.791]" ;
        ibco:heading "General" ;
        ibco:label "1024.1" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-1024.2 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.1 General. Exit passageways serving as an exit component in a means of egress system shall comply with the requirements of this section. An exit passageway shall not be used for any purpose other than as a means of egress and a circulation path." .

    ibc:ibc2021-1024.3 a ibco:Provision ;
        ibco:bbox "[46.806, 542.656, 289.882, 619.656]" ;
        ibco:heading "Construction" ;
        ibco:label "1024.3" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-1024.4 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.3 Construction. Exit passageway enclosures shall have walls, floors and ceilings of not less than a 1-hour fireresistance rating, and not less than that required for any connecting interior exit stairway or ramp. Exit passageways shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:ibc2021-1024.4 a ibco:Provision ;
        ibco:bbox "[46.806, 623.63, 289.828, 656.737]" ;
        ibco:heading "Termination" ;
        ibco:label "1024.4" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-1024.5 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.4 Termination. Exit passageways on the level of exit discharge shall terminate at an exit discharge. Exit passageways on other levels shall terminate at an exit." .

    ibc:ibc2021-1024.5 a ibco:Provision ;
        ibco:bbox "[307.791, 69.709, 551.005, 143.721]",
            "[46.799, 660.711, 289.871, 719.858]" ;
        ibco:heading "Openings" ;
        ibco:label "1024.5" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-1024.6 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.5 Openings. Exit passageway opening protectives shall be in accordance with the requirements of Section 716. Except as permitted in Section 402.8.7, openings in exit passageways other than unprotected exterior openings shall be limited to those necessary for exit access to the exit passageway from normally occupied spaces and for egress from the exit passageway. Where an interior exit stairway or ramp is extended to an exit discharge or a public way by an exit passageway, the exit passageway shall comply with Section 1023.3.1. Elevators shall not open into an exit passageway." .

    ibc:ibc2021-1024.8 a ibco:Provision ;
        ibco:bbox "[307.779, 673.715, 550.859, 717.728]",
            "[61.199, 69.725, 304.315, 179.738]" ;
        ibco:heading "Exit passageway exterior walls" ;
        ibco:label "1024.8" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-1024.9 ;
        ibco:sourcePage 341,
            342 ;
        ibco:text "1024.8 Exit passageway exterior walls. Exterior walls of the exit passageway shall comply with Section 705. Where nonrated walls or unprotected openings enclose the exterior of the exit passageway and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour. Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour. This construction shall extend vertically from the ground to a point 10 feet (3048 mm) above the floor of the exit passageway, or to the roof line, whichever is lower." .

    ibc:ibc2021-1025.2.2 a ibco:Provision ;
        ibco:bbox "[73.195, 558.832, 304.246, 591.809]" ;
        ibco:heading "Landings" ;
        ibco:label "1025.2.2" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-1025.2.3 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.2 Landings. The leading edge of landings shall be marked with a stripe consistent with the dimensional requirements for steps." .

    ibc:ibc2021-1025.2.4.3 a ibco:Provision ;
        ibco:bbox "[346.208, 511.611, 565.265, 577.577]" ;
        ibco:heading "Transition" ;
        ibco:label "1025.2.4.3" ;
        ibco:partOf ibc:ibc2021-1025.2.4 ;
        ibco:precedes ibc:ibc2021-1025.2.5 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.4.3 Transition. Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking." .

    ibc:ibc2021-1025.2.6.1 a ibco:Provision ;
        ibco:bbox "[70.811, 180.699, 289.848, 257.82]" ;
        ibco:heading "Emergency exit symbol" ;
        ibco:label "1025.2.6.1" ;
        ibco:partOf ibc:ibc2021-1025.2.6 ;
        ibco:precedes ibc:ibc2021-1025.2.6.2 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.2.6.1 Emergency exit symbol. The doors shall be identified by a low-location luminous emergency exit symbol complying with NFPA 170. The exit symbol shall be not less than 4 inches (102 mm) in height and shall be mounted on the door, centered horizontally, with the top of the symbol not higher than 18 inches (457 mm) above the finished floor." .

    ibc:ibc2021-1025.2.6.2 a ibco:Provision ;
        ibco:bbox "[70.796, 261.794, 289.841, 349.77]" ;
        ibco:heading "Door hardware markings" ;
        ibco:label "1025.2.6.2" ;
        ibco:partOf ibc:ibc2021-1025.2.6 ;
        ibco:precedes ibc:ibc2021-1025.2.6.3 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.2.6.2 Door hardware markings. Door hardware shall be marked with not less than 16 square inches (10323 mm2) of luminous material. This marking shall be located behind, immediately adjacent to, or on the door handle or escutcheon. Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad." .

    ibc:ibc2021-1025.2.6.3 a ibco:Provision ;
        ibco:bbox "[70.806, 353.744, 289.854, 430.745]" ;
        ibco:heading "Door frame markings" ;
        ibco:label "1025.2.6.3" ;
        ibco:partOf ibc:ibc2021-1025.2.6 ;
        ibco:precedes ibc:ibc2021-1025.3 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.2.6.3 Door frame markings. The top and sides of the door frame shall be marked with a solid and continuous 1-inch- to 2-inch-wide (25 mm to 51 mm) stripe. Where the door molding does not provide sufficient flat surface on which to locate the stripe, the stripe shall be permitted to be located on the wall surrounding the frame." .

    ibc:ibc2021-1025.3 a ibco:Provision ;
        ibco:bbox "[46.803, 434.719, 289.829, 467.816]" ;
        ibco:heading "Uniformity" ;
        ibco:label "1025.3" ;
        ibco:partOf ibc:ibc2021-1025 ;
        ibco:precedes ibc:ibc2021-1025.4 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.3 Uniformity. Placement and dimensions of markings shall be consistent and uniform throughout the same enclosure." .

    ibc:ibc2021-1025.5 a ibco:Provision ;
        ibco:bbox "[46.803, 625.712, 289.778, 680.76]" ;
        ibco:heading "Illumination" ;
        ibco:label "1025.5" ;
        ibco:partOf ibc:ibc2021-1025 ;
        ibco:precedes ibc:ibc2021-1026 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.5 Illumination. Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy." .

    ibc:ibc2021-1026.3 a ibco:Provision ;
        ibco:bbox "[307.799, 540.798, 550.864, 606.763]" ;
        ibco:heading "Opening protectives" ;
        ibco:label "1026.3" ;
        ibco:partOf ibc:ibc2021-1026 ;
        ibco:precedes ibc:ibc2021-1026.4 ;
        ibco:sourcePage 343 ;
        ibco:text "1026.3 Opening protectives. Fire doors in horizontal exits shall be self-closing or automatic-closing when activated by a smoke detector in accordance with Section 716.2.6.6. Doors, where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716.2.6.6." .

    ibc:ibc2021-1026.4.1 a ibco:Provision ;
        ibco:bbox "[73.194, 69.725, 304.337, 157.77]" ;
        ibco:heading "Capacity" ;
        ibco:label "1026.4.1" ;
        ibco:partOf ibc:ibc2021-1026.4 ;
        ibco:precedes ibc:ibc2021-1026.4.2 ;
        ibco:sourcePage 344 ;
        ibco:text "1026.4.1 Capacity. The capacity of the refuge area shall be computed based on a net floor area allowance of 3 square feet (0.2787 m2) for each occupant to be accommodated therein. Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407.5.3, 408.6.2, 420.6.1 and 422.3.2 as applicable." .

    ibc:ibc2021-1027.1 a ibco:Provision ;
        ibco:bbox "[61.193, 414.758, 304.324, 447.735]" ;
        ibco:heading "General" ;
        ibco:label "1027.1" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-1027.2 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.1 General. Exterior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section." .

    ibc:ibc2021-1027.2 a ibco:Provision ;
        ibco:bbox "[61.193, 451.709, 304.218, 528.71]" ;
        ibco:heading "Use in a means of egress" ;
        ibco:label "1027.2" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-1027.3 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.2 Use in a means of egress. Exterior exit stairways shall not be used as an element of a required means of egress for Group I-2 occupancies. For occupancies in other than Group I-2, exterior exit stairways and ramps shall be permitted as an element of a required means of egress for buildings not exceeding six stories above grade plane or that are not high-rise buildings." .

    ibc:ibc2021-1027.3 a ibco:Provision ;
        ibco:bbox "[61.199, 532.684, 304.306, 631.774]" ;
        ibco:heading "Open side" ;
        ibco:label "1027.3" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-1027.4 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.3 Open side. Exterior exit stairways and ramps serving as an element of a required means of egress shall be open on not less than one side, except for required structural columns, beams, handrails and guards. An open side shall have not less than 35 square feet (3.3 m2) of aggregate open area adjacent to each floor level and the level of each intermediate landing. The required open area shall be located not less than 42 inches (1067 mm) above the adjacent floor or landing level." .

    ibc:ibc2021-1027.4 a ibco:Provision ;
        ibco:bbox "[61.199, 635.748, 304.219, 679.761]" ;
        ibco:heading "Side yards" ;
        ibco:label "1027.4" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-1027.5 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.4 Side yards. The open areas adjoining exterior exit stairways or ramps shall be either yards, courts or public ways; the remaining sides are permitted to be enclosed by the exterior walls of the building." .

    ibc:ibc2021-1028.1 a ibco:Provision ;
        ibco:bbox "[46.786, 320.724, 289.847, 353.821]" ;
        ibco:heading "General" ;
        ibco:label "1028.1" ;
        ibco:partOf ibc:ibc2021-1028 ;
        ibco:precedes ibc:ibc2021-1028.2 ;
        ibco:sourcePage 345 ;
        ibco:text "1028.1 General. The exit discharge shall comply with Sections 1028 and 1029 and the applicable requirements of Sections 1003 through 1015." .

    ibc:ibc2021-1028.3 a ibco:Provision ;
        ibco:bbox "[307.788, 627.713, 550.836, 671.726]" ;
        ibco:heading "Exit discharge width or capacity" ;
        ibco:label "1028.3" ;
        ibco:partOf ibc:ibc2021-1028 ;
        ibco:precedes ibc:ibc2021-1028.4 ;
        ibco:sourcePage 345 ;
        ibco:text "1028.3 Exit discharge width or capacity. The minimum width or required capacity of the exit discharge shall be not less than the minimum width or required capacity of the exits being served." .

    ibc:ibc2021-1028.4 a ibco:Provision ;
        ibco:bbox "[307.798, 675.7, 570.815, 722.749]" ;
        ibco:heading "Exit discharge components" ;
        ibco:label "1028.4" ;
        ibco:partOf ibc:ibc2021-1028 ;
        ibco:precedes ibc:ibc2021-1028.5 ;
        ibco:sourcePage 345 ;
        ibco:text "1028.4 Exit discharge components. Exit discharge components shall be sufficiently open to the exterior so as to minimize the accumulation of smoke and toxic gases. *" .

    ibc:ibc2021-1029.1 a ibco:Provision ;
        ibco:bbox "[61.208, 287.756, 304.169, 320.853]" ;
        ibco:heading "General" ;
        ibco:label "1029.1" ;
        ibco:partOf ibc:ibc2021-1029 ;
        ibco:precedes ibc:ibc2021-1029.2 ;
        ibco:sourcePage 346 ;
        ibco:text "1029.1 General. Egress courts serving as an exit discharge component in the means of egress system shall comply with the requirements in this section." .

    ibc:ibc2021-1030.10.1 a ibco:Provision ;
        ibco:bbox "[319.812, 224.712, 550.831, 279.761]" ;
        ibco:label "1030.10.1" ;
        ibco:partOf ibc:ibc2021-1030.10 ;
        ibco:precedes ibc:ibc2021-1030.10.2 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10.1 Transitions to stairways that maintain stepped aisle riser and tread dimensions. Stepped aisles, transitions and stairways that maintain the stepped aisle riser and tread dimensions shall comply with Section 1030.14 as one exit access component." .

    ibc:ibc2021-1030.10.2.2 a ibco:Provision ;
        ibco:bbox "[331.804, 463.692, 550.849, 529.657]" ;
        ibco:label "1030.10.2.2" ;
        ibco:partOf ibc:ibc2021-1030.10.2 ;
        ibco:precedes ibc:ibc2021-1030.10.3 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10.2.2 Stairways that change direction from stepped aisles. Transitions where the stairway changes direction from the stepped aisle shall have a minimum depth of 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater, between the stepped aisle and stairway." .

    ibc:ibc2021-1030.10.3 a ibco:Provision ;
        ibco:bbox "[319.789, 533.631, 550.854, 610.787]" ;
        ibco:heading "Transition marking" ;
        ibco:label "1030.10.3" ;
        ibco:partOf ibc:ibc2021-1030.10 ;
        ibco:precedes ibc:ibc2021-1030.11 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10.3 Transition marking. A distinctive marking stripe shall be provided at each nosing or leading edge adjacent to the transition. Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide. The edge marking stripe shall be distinctively different from the stepped aisle contrasting marking stripe." .

    ibc:ibc2021-1030.11.1 a ibco:Provision ;
        ibco:bbox "[319.789, 673.784, 550.806, 728.833]",
            "[73.199, 69.725, 304.151, 91.786]" ;
        ibco:label "1030.11.1" ;
        ibco:partOf ibc:ibc2021-1030.11 ;
        ibco:precedes ibc:ibc2021-1030.11.2 ;
        ibco:sourcePage 349,
            350 ;
        ibco:text "1030.11.1 Stepped aisles that change direction at vomitories. Stepped aisle treads where the stepped aisle changes direction at a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater. The height of a stepped aisle tread above a transition at a vomitory shall comply with Section 1030.14.2.2." .

    ibc:ibc2021-1030.11.2 a ibco:Provision ;
        ibco:bbox "[73.199, 95.76, 304.196, 150.809]" ;
        ibco:label "1030.11.2" ;
        ibco:partOf ibc:ibc2021-1030.11 ;
        ibco:precedes ibc:ibc2021-1030.12 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.11.2 Stepped aisle transitions at the top of vomitories. Transitions between the stepped aisle above a vomitory and stepped aisles to the side of a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater." .

    ibc:ibc2021-1030.12.1 a ibco:Provision ;
        ibco:bbox "[73.189, 217.77, 304.181, 261.784]" ;
        ibco:heading "Walking surface" ;
        ibco:label "1030.12.1" ;
        ibco:partOf ibc:ibc2021-1030.12 ;
        ibco:precedes ibc:ibc2021-1030.12.2 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.12.1 Walking surface. The surface of aisles, stepped aisles and ramped aisles shall be of slip-resistant materials that are securely attached. The surface for stepped aisles shall comply with Section 1011.7.1." .

    ibc:ibc2021-1030.12.2 a ibco:Provision ;
        ibco:bbox "[73.169, 265.758, 304.129, 309.771]" ;
        ibco:heading "Outdoor conditions" ;
        ibco:label "1030.12.2" ;
        ibco:partOf ibc:ibc2021-1030.12 ;
        ibco:precedes ibc:ibc2021-1030.13 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.12.2 Outdoor conditions. Outdoor aisles, stepped aisles and ramped aisles and outdoor approaches to aisles, stepped aisles and ramped aisles shall be designed so that water will not accumulate on the walking surface." .

    ibc:ibc2021-1030.13.1.2 a ibco:Provision ;
        ibco:bbox "[85.193, 652.784, 304.242, 707.833]" ;
        ibco:label "1030.13.1.2" ;
        ibco:partOf ibc:ibc2021-1030.13.1 ;
        ibco:precedes ibc:ibc2021-1030.13.2 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.1.2 Seating at table aisle accessway length. The length of travel along the aisle accessway shall not exceed 30 feet (9144 mm) from any seat to the point where a person has a choice of two or more paths of egress travel to separate exits." .

    ibc:ibc2021-1030.14.1.1 a ibco:Provision ;
        ibco:bbox "[70.799, 267.845, 289.935, 311.858]" ;
        ibco:heading "Cross slope" ;
        ibco:label "1030.14.1.1" ;
        ibco:partOf ibc:ibc2021-1030.14.1 ;
        ibco:precedes ibc:ibc2021-1030.14.1.2 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.1.1 Cross slope. The slope measured perpendicular to the direction of travel of a ramped aisle shall not be steeper than 1 unit vertical in 48 units horizontal (2-percent slope)." .

    ibc:ibc2021-1030.14.1.2 a ibco:Provision ;
        ibco:bbox "[70.799, 315.832, 289.828, 359.845]" ;
        ibco:heading "Landings" ;
        ibco:label "1030.14.1.2" ;
        ibco:partOf ibc:ibc2021-1030.14.1 ;
        ibco:precedes ibc:ibc2021-1030.14.1.3 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.1.2 Landings. Ramped aisles shall have landings in accordance with Sections 1012.6 through 1012.6.5. Landings for ramped aisles shall be permitted to overlap required aisles or cross aisles." .

    ibc:ibc2021-1030.14.2.2.1 a ibco:Provision ;
        ibco:bbox "[343.795, 417.797, 550.927, 560.862]" ;
        ibco:heading "Construction tolerances" ;
        ibco:label "1030.14.2.2.1" ;
        ibco:partOf ibc:ibc2021-1030.14.2 ;
        ibco:precedes ibc:ibc2021-1030.14.2.3 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.2.2.1 Construction tolerances. The tolerance between adjacent risers on a stepped aisle that were designed to be equal height shall not exceed 3/16 inch (4.8 mm). Where the stepped aisle is designed in accordance with Exception 1 of Section 1030.14.2.2, the stepped aisle shall be constructed so that each riser of unequal height, determined in the direction of descent, is not more than 3/8 inch (9.5 mm) in height different from adjacent risers where stepped aisle treads are less than 22 inches (560 mm) in depth and 3/4 inch (19.1 mm) in height different from adjacent risers where stepped aisle treads are 22 inches (560 mm) or greater in depth." .

    ibc:ibc2021-1030.14.2.4 a ibco:Provision ;
        ibco:bbox "[331.808, 682.762, 550.774, 715.74]" ;
        ibco:heading "Nosing and profile" ;
        ibco:label "1030.14.2.4" ;
        ibco:partOf ibc:ibc2021-1030.14.2 ;
        ibco:precedes ibc:ibc2021-1030.15 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.2.4 Nosing and profile. Nosing and riser profile shall comply with Sections 1011.5.5 through 1011.5.5.3." .

    ibc:ibc2021-1030.16.1 a ibco:Provision ;
        ibco:bbox "[334.173, 106.647, 565.348, 227.717]" ;
        ibco:heading "Discontinuous mid-aisle handrails" ;
        ibco:label "1030.16.1" ;
        ibco:partOf ibc:ibc2021-1030.16 ;
        ibco:precedes ibc:ibc2021-1030.16.2 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.16.1 Discontinuous mid-aisle handrails. Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous. Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous. Gaps or breaks shall be provided at intervals not exceeding five rows to facilitate access to seating and to permit crossing from one side of the aisle to the other. These gaps or breaks shall have a clear width of not less than 22 inches (559 mm) and not greater than 36 inches (914 mm), measured horizontally, and the midaisle handrail shall have rounded terminations or bends." .

    ibc:ibc2021-1030.16.2 a ibco:Provision ;
        ibco:bbox "[334.203, 231.691, 565.268, 275.824]" ;
        ibco:heading "Handrail termination" ;
        ibco:label "1030.16.2" ;
        ibco:partOf ibc:ibc2021-1030.16 ;
        ibco:precedes ibc:ibc2021-1030.16.3 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.16.2 Handrail termination. Handrails located on the side of stepped aisles shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent stepped aisle flight." .

    ibc:ibc2021-1030.16.4 a ibco:Provision ;
        ibco:bbox "[334.213, 375.773, 565.185, 430.702]" ;
        ibco:heading "Rails" ;
        ibco:label "1030.16.4" ;
        ibco:partOf ibc:ibc2021-1030.16 ;
        ibco:precedes ibc:ibc2021-1030.17 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.16.4 Rails. Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail. The rail shall be adequate in strength and attachment in accordance with Section 1607.9.1.2." .

    ibc:ibc2021-1030.17.3 a ibco:Provision ;
        ibco:bbox "[58.818, 250.758, 289.862, 349.71]" ;
        ibco:heading "Sightline-constrained guard heights" ;
        ibco:label "1030.17.3" ;
        ibco:partOf ibc:ibc2021-1030.17 ;
        ibco:precedes ibc:ibc2021-1030.17.4 ;
        ibco:sourcePage 353 ;
        ibco:text "1030.17.3 Sightline-constrained guard heights. Unless subject to the requirements of Section 1030.17.4, a fascia or railing system in accordance with the guard requirements of Section 1015 and having a minimum height of 26 inches (660 mm) shall be provided where the floor or footboard elevation is more than 30 inches (762 mm) above the floor or grade below and the fascia or railing would otherwise interfere with the sightlines of immediately adjacent seating." .

    ibc:ibc2021-1030.17.4 a ibco:Provision ;
        ibco:bbox "[58.828, 353.685, 289.916, 452.757]" ;
        ibco:heading "Guards at the end of aisles" ;
        ibco:label "1030.17.4" ;
        ibco:partOf ibc:ibc2021-1030.17 ;
        ibco:precedes ibc:ibc2021-1031 ;
        ibco:sourcePage 353 ;
        ibco:text "1030.17.4 Guards at the end of aisles. A fascia or railing system complying with the guard requirements of Section 1015 shall be provided for the full width of the aisle where the foot of the aisle is more than 30 inches (762 mm) above the floor or grade below. The fascia or railing shall be not less than 36 inches (914 mm) high and shall provide not less than 42 inches (1067 mm) measured diagonally between the top of the rail and the nosing of the nearest tread." .

    ibc:ibc2021-1030.2 a ibco:Provision ;
        ibco:bbox "[322.198, 241.796, 565.275, 417.759]" ;
        ibco:heading "Assembly main exit" ;
        ibco:label "1030.2" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.3 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.2 Assembly main exit. A building, room or space used for assembly purposes that has an occupant load of greater than 300 and is provided with a main exit, that main exit shall be of sufficient capacity to accommodate not less than one-half of the occupant load, but such capacity shall be not less than the total required capacity of all means of egress leading to the exit. Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way. In a building, room or space used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity." .

    ibc:ibc2021-1030.3 a ibco:Provision ;
        ibco:bbox "[322.198, 421.733, 565.224, 553.673]" ;
        ibco:heading "Assembly other exits" ;
        ibco:label "1030.3" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.4 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.3 Assembly other exits. In addition to having access to a main exit, each level in a building used for assembly purposes having an occupant load greater than 300 and provided with a main exit, shall be provided with additional means of egress that shall provide an egress capacity for not less than one-half of the total occupant load served by that level and shall comply with Section 1007.1. In a building used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width." .

    ibc:ibc2021-1030.4 a ibco:Provision ;
        ibco:bbox "[322.198, 557.647, 565.309, 656.719]" ;
        ibco:heading "Foyers and lobbies" ;
        ibco:label "1030.4" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.5 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.4 Foyers and lobbies. In Group A-1 occupancies, where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress. Such foyer, if not directly connected to a public street by all the main entrances or exits, shall have a straight and unobstructed corridor or path of travel to every such main entrance or exit." .

    ibc:ibc2021-1030.5 a ibco:Provision ;
        ibco:bbox "[322.188, 660.693, 565.275, 726.659]" ;
        ibco:heading "Interior balcony and gallery means of egress" ;
        ibco:label "1030.5" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.6 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.5 Interior balcony and gallery means of egress. For balconies, galleries or press boxes having a seating capacity of 50 or more located in a building, room or space used for assembly purposes, not less than two means of egress shall be provided, with one from each side of every balcony, gallery or press box." .

    ibc:ibc2021-1030.6.2.1 a ibco:Provision ;
        ibco:bbox "[331.784, 117.573, 550.771, 183.657]" ;
        ibco:heading "Smoke control" ;
        ibco:label "1030.6.2.1" ;
        ibco:partOf ibc:ibc2021-1030.6.2 ;
        ibco:precedes ibc:ibc2021-1030.6.2.2 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.2.1 Smoke control. Aisles and aisle accessways serving a smoke-protected assembly seating area shall be provided with a smoke control system complying with Section 909 or natural ventilation designed to maintain the smoke level not less than 6 feet (1829 mm) above the floor of the means of egress." .

    ibc:ibc2021-1030.9.2 a ibco:Provision ;
        ibco:bbox "[334.182, 681.745, 565.186, 725.758]",
            "[58.799, 69.725, 289.921, 113.738]" ;
        ibco:heading "Aisle catchment area" ;
        ibco:label "1030.9.2" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-1030.9.3 ;
        ibco:sourcePage 348,
            349 ;
        ibco:text "1030.9.2 Aisle catchment area. The aisle shall provide sufficient capacity for the number of persons accommodated by the catchment area served by the aisle. The catchment area served by an aisle is that portion of the total space served by that section of the aisle. In establishing catchment areas, the assumption shall be made that there is a balanced use of all means of egress, with the number of persons in proportion to egress capacity." .

    ibc:ibc2021-1030.9.3 a ibco:Provision ;
        ibco:bbox "[58.809, 117.712, 289.771, 161.725]" ;
        ibco:heading "Converging aisles" ;
        ibco:label "1030.9.3" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-1030.9.4 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.3 Converging aisles. Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles." .

    ibc:ibc2021-1030.9.4 a ibco:Provision ;
        ibco:bbox "[58.809, 165.699, 289.814, 209.713]" ;
        ibco:heading "Uniform width and capacity" ;
        ibco:label "1030.9.4" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-1030.9.5 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.4 Uniform width and capacity. Those portions of aisles, where egress is possible in either of two directions, shall be uniform in minimum width or required capacity." .

    ibc:ibc2021-1030.9.7 a ibco:Provision ;
        ibco:bbox "[319.802, 69.715, 550.824, 113.728]",
            "[58.791, 701.756, 289.786, 723.818]" ;
        ibco:heading "Stairways connecting to stepped aisles" ;
        ibco:label "1030.9.7" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-1030.9.8 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.7 Stairways connecting to stepped aisles. A stairway that connects a stepped aisle to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14. Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:ibc2021-1030.9.8 a ibco:Provision ;
        ibco:bbox "[319.802, 117.702, 550.838, 183.786]" ;
        ibco:heading "Stairways connecting to vomitories" ;
        ibco:label "1030.9.8" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-1030.10 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.8 Stairways connecting to vomitories. A stairway that connects a vomitory to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14. Transitions between stairways and stepped aisles shall comply with Section 1030.10." .

    ibc:ibc2021-1031.1 a ibco:Provision ;
        ibco:bbox "[46.836, 499.688, 289.753, 521.75]" ;
        ibco:heading "General" ;
        ibco:label "1031.1" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:precedes ibc:ibc2021-1031.2 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.1 General. Emergency escape and rescue openings shall comply with the requirements of this section." .

    ibc:ibc2021-1031.2.1 a ibco:Provision ;
        ibco:bbox "[319.805, 418.77, 550.907, 495.77]" ;
        ibco:label "1031.2.1" ;
        ibco:partOf ibc:ibc2021-1031.2 ;
        ibco:precedes ibc:ibc2021-1031.3 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.2.1 Operational constraints and opening control devices. Emergency escape and rescue openings shall be operational from inside the room without the use of keys or tools. Window-opening control devices complying with ASTM F2090 shall be permitted for use on windows serving as a required emergency escape and rescue opening." .

    ibc:ibc2021-1031.3.2 a ibco:Provision ;
        ibco:bbox "[319.799, 610.804, 550.892, 665.853]" ;
        ibco:heading "Minimum dimensions" ;
        ibco:label "1031.3.2" ;
        ibco:partOf ibc:ibc2021-1031.3 ;
        ibco:precedes ibc:ibc2021-1031.3.3 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.3.2 Minimum dimensions. The minimum net clear opening height dimension shall be 24 inches (610 mm). The minimum net clear opening width dimension shall be 20 inches (508 mm). The net clear opening dimensions shall be the result of normal operation of the opening." .

    ibc:ibc2021-1031.3.3 a ibco:Provision ;
        ibco:bbox "[73.199, 69.725, 304.196, 113.738]" ;
        ibco:heading "Maximum height from floor" ;
        ibco:label "1031.3.3" ;
        ibco:partOf ibc:ibc2021-1031.3 ;
        ibco:precedes ibc:ibc2021-1031.4 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.3.3 Maximum height from floor. Emergency escape and rescue openings shall have the bottom of the clear opening not greater than 44 inches (1118 mm) measured from the floor." .

    ibc:ibc2021-1031.4 a ibco:Provision ;
        ibco:bbox "[61.197, 117.712, 304.173, 150.809]" ;
        ibco:heading "Emergency escape and rescue doors" ;
        ibco:label "1031.4" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:precedes ibc:ibc2021-1031.5 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.4 Emergency escape and rescue doors. Where a door is provided as the required emergency escape and rescue opening, it shall be a swinging door or a sliding door." .

    ibc:ibc2021-1031.5.2.1 a ibco:Provision ;
        ibco:bbox "[85.187, 401.71, 304.175, 456.759]" ;
        ibco:heading "Ladders" ;
        ibco:label "1031.5.2.1" ;
        ibco:partOf ibc:ibc2021-1031.5.2 ;
        ibco:precedes ibc:ibc2021-1031.5.2.2 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5.2.1 Ladders. Ladders or rungs shall have an inside width of at least 12 inches (305 mm), shall project at least 3 inches (76 mm) from the wall and shall be spaced not more than 18 inches (457 mm) on center (o.c.) vertically for the full height of the area well." .

    ibc:ibc2021-1031.5.2.2 a ibco:Provision ;
        ibco:bbox "[85.187, 460.733, 304.214, 515.782]" ;
        ibco:heading "Steps" ;
        ibco:label "1031.5.2.2" ;
        ibco:partOf ibc:ibc2021-1031.5.2 ;
        ibco:precedes ibc:ibc2021-1031.5.3 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5.2.2 Steps. Steps shall have an inside width of not less than 12 inches (305 mm), shall have treads greater than 5 inches (127 mm) in depth and a riser height not greater than 18 inches (457 mm) for the full height of the area well." .

    ibc:ibc2021-1031.6 a ibco:Provision ;
        ibco:bbox "[61.184, 615.73, 304.291, 714.683]" ;
        ibco:heading "Bars, grilles, covers and screens" ;
        ibco:label "1031.6" ;
        ibco:partOf ibc:ibc2021-1031 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.6 Bars, grilles, covers and screens. Where bars, grilles, covers, screens or similar devices are placed over emergency escape and rescue openings or area wells that serve such openings, the minimum net clear opening size shall comply with Sections 1031.3 and 1031.5. Such devices shall be releasable or removable from the inside without the use of a key, tool or force greater than that which is required for normal operation of the emergency escape and rescue opening." .

    ibc:ibc2021-ch10-exception-0023 a ibco:Exception ;
        ibco:bbox "[58.789, 117.712, 289.802, 198.797]" ;
        ibco:partOf ibc:ibc2021-1003.3.1 ;
        ibco:precedes ibc:ibc2021-1003.3.2 ;
        ibco:sourcePage 305 ;
        ibco:text "Exception: Door closers and stops shall not reduce headroom to less than 78 inches (1981 mm). A barrier shall be provided where the vertical clearance above a circulation path is less than 80 inches (2032 mm) high above the finished floor. The leading edge of such a barrier shall be located 27 inches (686 mm) maximum above the finished floor." .

    ibc:ibc2021-ch10-exception-0025 a ibco:Exception ;
        ibco:bbox "[70.791, 327.769, 289.85, 360.746]" ;
        ibco:partOf ibc:ibc2021-1003.3.2 ;
        ibco:precedes ibc:ibc2021-1003.3.3 ;
        ibco:sourcePage 305 ;
        ibco:text "Exception: These requirements shall not apply to sloping portions of handrails between the top and bottom riser of stairs and above the ramp run." .

    ibc:ibc2021-ch10-exception-0027 a ibco:Exception ;
        ibco:bbox "[70.791, 423.293, 289.799, 445.79]" ;
        ibco:partOf ibc:ibc2021-1003.3.3 ;
        ibco:precedes ibc:ibc2021-1003.3.4 ;
        ibco:sourcePage 305 ;
        ibco:text "Exception: Handrails are permitted to protrude 41/2 inches (114 mm) from the wall or guard." .

    ibc:ibc2021-ch10-exception-0037 a ibco:Exception ;
        ibco:bbox "[319.779, 374.606, 550.724, 396.668]" ;
        ibco:partOf ibc:ibc2021-1003.7 ;
        ibco:precedes ibc:ibc2021-1004 ;
        ibco:sourcePage 305 ;
        ibco:text "Exception: Elevators used as an accessible means of egress in accordance with Section 1009.4." .

    ibc:ibc2021-ch10-exception-0047 a ibco:Exception ;
        ibco:bbox "[73.211, 323.685, 304.253, 378.734]" ;
        ibco:partOf ibc:ibc2021-1004.5 ;
        ibco:precedes ibc:ibc2021-1004.5.1 ;
        ibco:sourcePage 306 ;
        ibco:text "Exception: Where approved by the building official, the actual number of occupants for whom each occupied space, floor or building is designed, although less than those determined by calculation, shall be permitted to be used in the determination of the design occupant load." .

    ibc:ibc2021-ch10-exception-0059 a ibco:Exception ;
        ibco:bbox "[58.768, 524.732, 289.717, 557.829]" ;
        ibco:partOf ibc:ibc2021-1005.1 ;
        ibco:precedes ibc:ibc2021-1005.2 ;
        ibco:sourcePage 307 ;
        ibco:text "Exception: Aisles and aisle accessways in rooms or spaces used for assembly purposes complying with Section 1030." .

    ibc:ibc2021-ch10-exception-0084 a ibco:Exception ;
        ibco:bbox "[85.193, 666.84, 304.147, 699.818]" ;
        ibco:partOf ibc:ibc2021-1005.7.2 ;
        ibco:precedes ibc:ibc2021-1005.7.3 ;
        ibco:sourcePage 308 ;
        ibco:text "Exception: Projections are permitted in corridors within Group I-2, Condition 1 in accordance with Section 407.4.3." .

    ibc:ibc2021-ch10-exception-0099 a ibco:Exception ;
        ibco:bbox "[343.781, 95.732, 550.872, 128.709]" ;
        ibco:partOf ibc:ibc2021-1006.2.2.3 ;
        ibco:precedes ibc:ibc2021-1006.2.2.4 ;
        ibco:sourcePage 309 ;
        ibco:text "Exception: Where using refrigerants in quantities limited to the amounts based on the volume set forth in the International Mechanical Code." .

    ibc:ibc2021-ch10-exception-0208 a ibco:Exception ;
        ibco:bbox "[331.789, 323.709, 550.809, 356.806]" ;
        ibco:partOf ibc:ibc2021-1009.3.1 ;
        ibco:precedes ibc:ibc2021-1009.3.2 ;
        ibco:sourcePage 313 ;
        ibco:text "Exception: Exit access stairways providing means of egress from mezzanines are permitted as part of an accessible means of egress." .

    ibc:ibc2021-ch10-exception-0234 a ibco:Exception ;
        ibco:bbox "[85.201, 677.761, 304.153, 710.858]" ;
        ibco:partOf ibc:ibc2021-1009.6.2 ;
        ibco:precedes ibc:ibc2021-1009.6.3 ;
        ibco:sourcePage 314 ;
        ibco:text "Exception: An interior area of refuge at the level of exit discharge that provides direct access to an exterior exit door." .

    ibc:ibc2021-ch10-exception-0244 a ibco:Exception ;
        ibco:bbox "[346.181, 655.044, 565.194, 710.093]" ;
        ibco:partOf ibc:ibc2021-1009.7.2 ;
        ibco:precedes ibc:ibc2021-1009.7.3 ;
        ibco:sourcePage 314 ;
        ibco:text "Exception: The fire-resistance rating and opening protectives are not required in the exterior wall where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-exception-0247 a ibco:Exception ;
        ibco:bbox "[70.791, 154.783, 289.791, 209.713]" ;
        ibco:partOf ibc:ibc2021-1009.7.4 ;
        ibco:precedes ibc:ibc2021-1009.8 ;
        ibco:sourcePage 315 ;
        ibco:text "Exception: The minimum clear width of 48 inches (1219 mm) between handrails is not required at stairways serving buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-exception-0285 a ibco:Exception ;
        ibco:bbox "[358.201, 209.715, 565.307, 253.728]" ;
        ibco:partOf ibc:ibc2021-1010.1.1.1 ;
        ibco:precedes ibc:ibc2021-1010.1.2 ;
        ibco:sourcePage 316 ;
        ibco:text "Exception: Door closers, overhead door stops, power door operators, and electromagnetic door locks shall be permitted to be 78 inches (1980 mm) minimum above the floor." .

    ibc:ibc2021-ch10-exception-0314 a ibco:Exception ;
        ibco:bbox "[331.794, 253.726, 550.791, 286.703]" ;
        ibco:partOf ibc:ibc2021-1010.1.5 ;
        ibco:precedes ibc:ibc2021-1010.1.6 ;
        ibco:sourcePage 317 ;
        ibco:text "Exception: Landing length in the direction of travel in Groups R-3 and U and within individual units of Group R-2 need not exceed 36 inches (914 mm)." .

    ibc:ibc2021-ch10-exception-0336 a ibco:Exception ;
        ibco:bbox "[85.217, 483.762, 304.26, 571.679]" ;
        ibco:partOf ibc:ibc2021-1010.2.3 ;
        ibco:precedes ibc:ibc2021-1010.2.4 ;
        ibco:sourcePage 318 ;
        ibco:text "Exception: Access doors or gates in barrier walls and fences protecting pools, spas and hot tubs shall be permitted to have operable parts of the latch release on self-latching devices at 54 inches (1370 mm) maximum above the finished floor or ground, provided that the self-latching devices are not also self-locking devices operated by means of a key, electronic opener or integral combination lock." .

    ibc:ibc2021-ch10-exception-0482 a ibco:Exception ;
        ibco:bbox "[73.197, 387.768, 304.202, 420.745]" ;
        ibco:partOf ibc:ibc2021-1010.4 ;
        ibco:precedes ibc:ibc2021-1010.4.1 ;
        ibco:sourcePage 324 ;
        ibco:text "Exception: Horizontal sliding or swinging gates exceeding the 4-foot (1219 mm) maximum leaf width limitation are permitted in fences and walls surrounding a stadium." .

    ibc:ibc2021-ch10-exception-0506 a ibco:Exception ;
        ibco:bbox "[70.802, 288.427, 289.829, 321.404]" ;
        ibco:partOf ibc:ibc2021-1010.5.4 ;
        ibco:precedes ibc:ibc2021-1011 ;
        ibco:sourcePage 325 ;
        ibco:text "Exception: A side-hinged swinging door is not required at security access turnstiles that comply with Section 1010.5.2." .

    ibc:ibc2021-ch10-exception-0509 a ibco:Exception ;
        ibco:bbox "[58.8, 438.872, 289.723, 460.814]" ;
        ibco:partOf ibc:ibc2021-1011.1 ;
        ibco:precedes ibc:ibc2021-1011.2 ;
        ibco:sourcePage 325 ;
        ibco:text "Exception: Within rooms or spaces used for assembly purposes, stepped aisles shall comply with Section 1030." .

    ibc:ibc2021-ch10-exception-0564 a ibco:Exception ;
        ibco:bbox "[70.794, 664.766, 289.923, 719.866]" ;
        ibco:partOf ibc:ibc2021-1011.7.3 ;
        ibco:precedes ibc:ibc2021-1011.7.4 ;
        ibco:sourcePage 327 ;
        ibco:text "Exception: Spaces under stairways serving and contained within a single residential dwelling unit in Group R-2 or R-3 shall be permitted to be protected on the enclosed side with 1/2-inch (12.7 mm) gypsum board." .

    ibc:ibc2021-ch10-exception-0567 a ibco:Exception ;
        ibco:bbox "[319.768, 176.727, 550.825, 198.789]" ;
        ibco:partOf ibc:ibc2021-1011.8 ;
        ibco:precedes ibc:ibc2021-1011.9 ;
        ibco:sourcePage 327 ;
        ibco:text "Exception: Spiral stairways used as a means of egress from technical production areas." .

    ibc:ibc2021-ch10-exception-0569 a ibco:Exception ;
        ibco:bbox "[319.768, 250.75, 550.895, 283.728]" ;
        ibco:partOf ibc:ibc2021-1011.9 ;
        ibco:precedes ibc:ibc2021-1011.10 ;
        ibco:sourcePage 327 ;
        ibco:text "Exception: The radius restriction shall not apply to curved stairways in Group R-3 and within individual dwelling units in Group R-2." .

    ibc:ibc2021-ch10-exception-0584 a ibco:Exception ;
        ibco:bbox "[73.199, 287.729, 304.321, 342.778]" ;
        ibco:partOf ibc:ibc2021-1011.12 ;
        ibco:precedes ibc:ibc2021-1011.12.1 ;
        ibco:sourcePage 328 ;
        ibco:text "Exception: Other than where required by Section 1011.12.1, in buildings without an occupied roof access to the roof from the top story shall be permitted to be by an alternating tread device, a ships ladder or a permanent ladder." .

    ibc:ibc2021-ch10-exception-0587 a ibco:Exception ;
        ibco:bbox "[85.19, 431.691, 304.201, 486.822]" ;
        ibco:partOf ibc:ibc2021-1011.12.2 ;
        ibco:precedes ibc:ibc2021-1011.13 ;
        ibco:sourcePage 328 ;
        ibco:text "Exception: In buildings without an occupied roof, access to the roof shall be permitted to be a roof hatch or trap door not less than 16 square feet (1.5 m2) in area and having a minimum dimension of 2 feet (610 mm)." .

    ibc:ibc2021-ch10-exception-0592 a ibco:Exception ;
        ibco:bbox "[346.195, 227.727, 565.311, 315.822]" ;
        ibco:partOf ibc:ibc2021-1011.14.2 ;
        ibco:precedes ibc:ibc2021-1011.15 ;
        ibco:sourcePage 328 ;
        ibco:text "Exception: Alternating tread devices used as an element of a means of egress in buildings from a mezzanine area not more than 250 square feet (23 m2) in area that serves not more than five occupants shall have a minimum tread depth of 3 inches (76 mm) with a minimum projected tread depth of 101/2 inches (267 mm). The rise to the next alternating tread surface shall not exceed 8 inches (203 mm)." .

    ibc:ibc2021-ch10-exception-0624 a ibco:Exception ;
        ibco:bbox "[331.786, 386.68, 550.891, 441.728]" ;
        ibco:partOf ibc:ibc2021-1012.6.4 ;
        ibco:precedes ibc:ibc2021-1012.6.5 ;
        ibco:sourcePage 329 ;
        ibco:text "Exception: In Group R-2 and R-3 individual dwelling or sleeping units that are not required to be Accessible units, Type A units or Type B units in accordance with Section 1108, landings are permitted to be 36 inches by 36 inches (914 mm by 914 mm) minimum." .

    ibc:ibc2021-ch10-exception-0648 a ibco:Exception ;
        ibco:bbox "[334.174, 294.662, 565.154, 316.604]" ;
        ibco:partOf ibc:ibc2021-1013.3 ;
        ibco:precedes ibc:ibc2021-1013.4 ;
        ibco:sourcePage 330 ;
        ibco:text "Exception: Tactile signs required by Section 1013.4 need not be provided with illumination." .

    ibc:ibc2021-ch10-exception-0655 a ibco:Exception ;
        ibco:bbox "[70.801, 209.723, 289.874, 275.807]" ;
        ibco:partOf ibc:ibc2021-1013.6.3 ;
        ibco:precedes ibc:ibc2021-1014 ;
        ibco:sourcePage 331 ;
        ibco:text "Exception: Approved exit sign illumination types that provide continuous illumination independent of external power sources for a duration of not less than 90 minutes, in case of primary power loss, are not required to be connected to an emergency electrical system." .

    ibc:ibc2021-ch10-exception-0664 a ibco:Exception ;
        ibco:bbox "[319.773, 108.705, 550.781, 185.706]" ;
        ibco:partOf ibc:ibc2021-1014.3 ;
        ibco:precedes ibc:ibc2021-1014.3.1 ;
        ibco:sourcePage 331 ;
        ibco:text "Exception: In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R-3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; handrails shall be Type I in accordance with Section 1014.3.1, Type II in accordance with Section 1014.3.2 or shall provide equivalent graspability." .

    ibc:ibc2021-ch10-exception-0717 a ibco:Exception ;
        ibco:bbox "[319.784, 406.754, 550.8, 439.732]" ;
        ibco:partOf ibc:ibc2021-1015.6 ;
        ibco:precedes ibc:ibc2021-1015.7 ;
        ibco:sourcePage 333 ;
        ibco:text "Exception: Guards are not required where personal fall arrest anchorage connector devices that comply with ANSI/ASSE Z 359.1 are installed." .

    ibc:ibc2021-ch10-exception-0719 a ibco:Exception ;
        ibco:bbox "[319.774, 546.752, 550.79, 579.729]" ;
        ibco:partOf ibc:ibc2021-1015.7 ;
        ibco:precedes ibc:ibc2021-1015.8 ;
        ibco:sourcePage 333 ;
        ibco:text "Exception: Guards are not required where personal fall arrest anchorage connector devices that comply with ANSI/ASSE Z 359.1 are installed." .

    ibc:ibc2021-ch10-exception-0743 a ibco:Exception ;
        ibco:bbox "[346.193, 464.723, 565.372, 596.783]" ;
        ibco:partOf ibc:ibc2021-1016.2.1 ;
        ibco:precedes ibc:ibc2021-1017 ;
        ibco:sourcePage 334 ;
        ibco:text "Exception: The means of egress from a smaller tenant space shall not be prohibited from passing through a larger adjoining tenant space where such rooms or spaces of the smaller tenant occupy less than 10 percent of the area of the larger tenant space through which they pass; are the same or similar occupancy group; a discernible path of egress travel to an exit is provided; and the means of egress into the adjoining space is not subject to locking from the egress side. A required means of egress serving the larger tenant space shall not pass through the smaller tenant space or spaces." .

    ibc:ibc2021-ch10-exception-0769 a ibco:Exception ;
        ibco:bbox "[73.199, 176.735, 304.132, 198.797]" ;
        ibco:partOf ibc:ibc2021-1018.1 ;
        ibco:precedes ibc:ibc2021-1018.2 ;
        ibco:sourcePage 336 ;
        ibco:text "Exception: Encroachments complying with Section 1005.7." .

    ibc:ibc2021-ch10-exception-0772 a ibco:Exception ;
        ibco:bbox "[73.179, 287.709, 304.199, 320.807]" ;
        ibco:partOf ibc:ibc2021-1018.3 ;
        ibco:precedes ibc:ibc2021-1018.4 ;
        ibco:sourcePage 336 ;
        ibco:text "Exception: Nonpublic aisles serving less than 50 people and not required to be accessible by Chapter 11 need not exceed 28 inches (711 mm) in width." .

    ibc:ibc2021-ch10-exception-0774 a ibco:Exception ;
        ibco:bbox "[73.169, 449.659, 304.165, 482.756]" ;
        ibco:partOf ibc:ibc2021-1018.4 ;
        ibco:precedes ibc:ibc2021-1018.5 ;
        ibco:sourcePage 336 ;
        ibco:text "Exception: For areas serving not more than 50 occupants, the common path of egress travel shall not exceed 75 feet (22 860 mm)." .

    ibc:ibc2021-ch10-exception-0776 a ibco:Exception ;
        ibco:bbox "[73.169, 556.669, 304.214, 589.782]" ;
        ibco:partOf ibc:ibc2021-1018.5 ;
        ibco:precedes ibc:ibc2021-1019 ;
        ibco:sourcePage 336 ;
        ibco:text "Exception: Nonpublic aisles serving less than 50 people and not required to be accessible by Chapter 11 need not exceed 28 inches (711 mm) in width." .

    ibc:ibc2021-ch10-exception-0792 a ibco:Exception ;
        ibco:bbox "[334.188, 674.726, 565.218, 707.823]" ;
        ibco:partOf ibc:ibc2021-1019.4 ;
        ibco:precedes ibc:ibc2021-1020 ;
        ibco:sourcePage 336 ;
        ibco:text "Exception: In Group I-3 occupancies, exit access stairways or ramps constructed in accordance with Section 408 are not required to be enclosed." .

    ibc:ibc2021-ch10-exception-0809 a ibco:Exception ;
        ibco:bbox "[307.797, 154.783, 550.84, 411.989]" ;
        ibco:partOf ibc:ibc2021-1020.3 ;
        ibco:precedes ibc:ibc2021-1020.4 ;
        ibco:sourcePage 337 ;
        ibco:text "Exception: In Group I-2 occupancies, corridors are not required to have a clear width of 96 inches (2438 mm) in areas where there will not be stretcher or bed movement for access to care or as part of the defend-in-place strategy. TABLE 1020.3 MINIMUM CORRIDOR WIDTH For SI: 1 inch = 25.4 mm." .

    ibc:ibc2021-ch10-exception-0811 a ibco:Exception ;
        ibco:bbox "[319.791, 441.84, 550.724, 463.782]" ;
        ibco:partOf ibc:ibc2021-1020.4 ;
        ibco:precedes ibc:ibc2021-1020.5 ;
        ibco:sourcePage 337 ;
        ibco:text "Exception: Encroachments complying with Section 1005.7." .

    ibc:ibc2021-ch10-exception-0837 a ibco:Exception ;
        ibco:bbox "[334.177, 234.716, 565.227, 278.868]" ;
        ibco:partOf ibc:ibc2021-1021.2 ;
        ibco:precedes ibc:ibc2021-1021.3 ;
        ibco:sourcePage 338 ;
        ibco:text "Exception: Separation is not required where the exterior egress balcony is served by not less than two stairways and a dead-end travel condition does not require travel past an unprotected opening to reach a stairway." .

    ibc:ibc2021-ch10-exception-0857 a ibco:Exception ;
        ibco:bbox "[58.802, 473.663, 289.935, 539.854]" ;
        ibco:partOf ibc:ibc2021-1023.3 ;
        ibco:precedes ibc:ibc2021-1023.3.1 ;
        ibco:sourcePage 339 ;
        ibco:text "Exception: A combination of interior exit stairways, interior exit ramps and exit passageways, constructed in accordance with Sections 1023.2, 1023.3.1 and 1024, respectively, and forming a continuous protected enclosure, shall be permitted to extend an interior exit stairway or ramp to the exit discharge or a public way." .

    ibc:ibc2021-ch10-exception-0904 a ibco:Exception ;
        ibco:bbox "[58.818, 516.74, 289.751, 538.682]" ;
        ibco:partOf ibc:ibc2021-1024.2 ;
        ibco:precedes ibc:ibc2021-1024.3 ;
        ibco:sourcePage 341 ;
        ibco:text "Exception: Encroachments complying with Section 1005.7." .

    ibc:ibc2021-ch10-exception-0915 a ibco:Exception ;
        ibco:bbox "[319.811, 350.752, 551.011, 383.849]" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-1024.7 ;
        ibco:sourcePage 341 ;
        ibco:text "Exception: Membrane penetrations shall be permitted on the outside of the exit passageway. Such penetrations shall be protected in accordance with Section 714.4.2." .

    ibc:ibc2021-ch10-exception-0925 a ibco:Exception ;
        ibco:bbox "[73.206, 311.728, 304.222, 355.741]" ;
        ibco:partOf ibc:ibc2021-1025.1 ;
        ibco:precedes ibc:ibc2021-1025.2 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: Luminous egress path markings shall not be required on the level of exit discharge in lobbies that serve as part of the exit path in accordance with Section 1028.2, Exception 1." .

    ibc:ibc2021-ch10-exception-0928 a ibco:Exception ;
        ibco:bbox "[85.197, 521.761, 304.188, 554.858]" ;
        ibco:partOf ibc:ibc2021-1025.2.1 ;
        ibco:precedes ibc:ibc2021-1025.2.2 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: The minimum width of 1 inch (25 mm) shall not apply to outlining stripes listed in accordance with UL 1994." .

    ibc:ibc2021-ch10-exception-0931 a ibco:Exception ;
        ibco:bbox "[85.217, 687.794, 304.208, 720.771]" ;
        ibco:partOf ibc:ibc2021-1025.2.3 ;
        ibco:precedes ibc:ibc2021-1025.2.4 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: The minimum width of 1 inch (25 mm) shall not apply to outlining stripes listed in accordance with UL 1994." .

    ibc:ibc2021-ch10-exception-0933 a ibco:Exception ;
        ibco:bbox "[346.208, 161.677, 565.2, 194.654]" ;
        ibco:partOf ibc:ibc2021-1025.2.4 ;
        ibco:precedes ibc:ibc2021-1025.2.4.1 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: The minimum width of 1 inch (25 mm) shall not apply to outlining stripes listed in accordance with UL 1994." .

    ibc:ibc2021-ch10-exception-0935 a ibco:Exception ;
        ibco:bbox "[358.21, 268.687, 565.238, 312.7]" ;
        ibco:partOf ibc:ibc2021-1025.2.4.1 ;
        ibco:precedes ibc:ibc2021-1025.2.4.2 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: Demarcation lines shall not extend in front of exit discharge doors that lead out of an exit and through which occupants must travel to complete the exit path." .

    ibc:ibc2021-ch10-exception-0937 a ibco:Exception ;
        ibco:bbox "[358.21, 463.624, 565.238, 507.637]" ;
        ibco:partOf ibc:ibc2021-1025.2.4.2 ;
        ibco:precedes ibc:ibc2021-1025.2.4.3 ;
        ibco:sourcePage 342 ;
        ibco:text "Exception: Demarcation lines shall not extend in front of exit discharge doors that lead out of an exit and through which occupants must travel to complete the exit path." .

    ibc:ibc2021-ch10-exception-0940 a ibco:Exception ;
        ibco:bbox "[70.801, 95.76, 289.778, 128.738]" ;
        ibco:partOf ibc:ibc2021-1025.2.5 ;
        ibco:precedes ibc:ibc2021-1025.2.6 ;
        ibco:sourcePage 343 ;
        ibco:text "Exception: The minimum width of 1 inch (25 mm) shall not apply to markings listed in accordance with UL 1994." .

    ibc:ibc2021-ch10-exception-0957 a ibco:Exception ;
        ibco:bbox "[307.809, 444.823, 550.813, 536.824]" ;
        ibco:partOf ibc:ibc2021-1026.2 ;
        ibco:precedes ibc:ibc2021-1026.3 ;
        ibco:sourcePage 343 ;
        ibco:text "Exception: A fire-resistance rating is not required at horizontal exits between a building area and an abovegrade pedestrian walkway constructed in accordance with Section 3104, provided that the distance between connected buildings is more than 20 feet (6096 mm). Horizontal exits constructed as fire barriers shall be continuous from exterior wall to exterior wall so as to divide completely the floor served by the horizontal exit." .

    ibc:ibc2021-ch10-exception-0962 a ibco:Exception ;
        ibco:bbox "[85.196, 253.754, 304.246, 330.755]" ;
        ibco:partOf ibc:ibc2021-1026.4.2 ;
        ibco:precedes ibc:ibc2021-1026.5 ;
        ibco:sourcePage 344 ;
        ibco:text "Exception: The adjoining compartment shall not be required to have a stairway or door leading directly outside, provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates." .

    ibc:ibc2021-ch10-exception-0974 a ibco:Exception ;
        ibco:bbox "[334.183, 197.717, 565.159, 230.695]" ;
        ibco:partOf ibc:ibc2021-1027.5 ;
        ibco:precedes ibc:ibc2021-1027.6 ;
        ibco:sourcePage 344 ;
        ibco:text "Exception: Exterior exit stairways and ramps serving individual dwelling units of Group R-3 shall have a minimum fire separation distance of 5 feet (1525 mm)." .

    ibc:ibc2021-ch10-exception-1013 a ibco:Exception ;
        ibco:bbox "[73.2, 427.754, 304.133, 449.816]" ;
        ibco:partOf ibc:ibc2021-1029.2 ;
        ibco:precedes ibc:ibc2021-1029.3 ;
        ibco:sourcePage 346 ;
        ibco:text "Exception: Encroachments complying with Section 1005.7." .

    ibc:ibc2021-ch10-exception-1039 a ibco:Exception ;
        ibco:bbox "[343.794, 235.619, 550.796, 290.854]" ;
        ibco:partOf ibc:ibc2021-1030.6.2.2 ;
        ibco:precedes ibc:ibc2021-1030.6.2.3 ;
        ibco:sourcePage 347 ;
        ibco:text "Exception: A roof canopy in an outdoor stadium shall be permitted to be less than 15 feet (4572 mm) above the highest aisle or aisle accessway provided that there are no objects less than 80 inches (2032 mm) above the highest aisle or aisle accessway." .

    ibc:ibc2021-ch10-exception-1045 a ibco:Exception ;
        ibco:bbox "[179.277, 601.708, 419.617, 610.547]",
            "[331.774, 522.823, 550.852, 577.753]",
            "[46.799, 727.818, 130.627, 736.586]" ;
        ibco:partOf ibc:ibc2021-1030.6.3 ;
        ibco:precedes ibc:ibc2021-1030.6.3.1 ;
        ibco:sourcePage 347 ;
        ibco:text "Exception: The required capacity in inches (mm) of aisles shall be permitted to comply with Section 1030.6.2 for the number of seats in the open-air assembly seating where Section 1030.6.2 permits less capacity. CAPACITY FOR AISLES FOR SMOKE-PROTECTED ASSEMBLY For SI: 1 inch = 25.4 mm." .

    ibc:ibc2021-ch10-exception-1067 a ibco:Exception ;
        ibco:bbox "[346.194, 198.612, 565.226, 253.774]" ;
        ibco:partOf ibc:ibc2021-1030.8.1 ;
        ibco:precedes ibc:ibc2021-1030.9 ;
        ibco:sourcePage 348 ;
        ibco:text "Exception: For smoke-protected or open-air assembly seating there shall be not more than 40 seats between the two aisles and the minimum clear width shall be 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat." .

    ibc:ibc2021-ch10-exception-1080 a ibco:Exception ;
        ibco:bbox "[370.188, 644.674, 565.24, 677.771]" ;
        ibco:partOf ibc:ibc2021-1030.9.1 ;
        ibco:precedes ibc:ibc2021-1030.9.2 ;
        ibco:sourcePage 348 ;
        ibco:text "Exception: Thirty inches (762 mm) where the aisle serves fewer than 15 seats and does not serve as part of an accessible route." .

    ibc:ibc2021-ch10-exception-1091 a ibco:Exception ;
        ibco:bbox "[70.841, 590.633, 289.815, 623.73]" ;
        ibco:partOf ibc:ibc2021-1030.9.6 ;
        ibco:precedes ibc:ibc2021-1030.9.6.1 ;
        ibco:sourcePage 349 ;
        ibco:text "Exception: The clear width of aisles adjacent to seating at tables shall be permitted to be measured in accordance with Section 1030.13.1." .

    ibc:ibc2021-ch10-exception-1093 a ibco:Exception ;
        ibco:bbox "[82.794, 664.656, 289.759, 697.782]" ;
        ibco:partOf ibc:ibc2021-1030.9.6.1 ;
        ibco:precedes ibc:ibc2021-1030.9.7 ;
        ibco:sourcePage 349 ;
        ibco:text "Exception: Handrails are permitted to project into the required width of stepped aisles and ramped aisles in accordance with Section 1014.8." .

    ibc:ibc2021-ch10-exception-1108 a ibco:Exception ;
        ibco:bbox "[73.199, 191.735, 304.263, 213.796]" ;
        ibco:partOf ibc:ibc2021-1030.12 ;
        ibco:precedes ibc:ibc2021-1030.12.1 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: Wood handrails shall be permitted for all types of construction." .

    ibc:ibc2021-ch10-exception-1113 a ibco:Exception ;
        ibco:bbox "[85.201, 475.694, 304.188, 508.672]" ;
        ibco:partOf ibc:ibc2021-1030.13.1 ;
        ibco:precedes ibc:ibc2021-1030.13.1.1 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat." .

    ibc:ibc2021-ch10-exception-1115 a ibco:Exception ;
        ibco:bbox "[97.195, 615.832, 304.275, 648.81]" ;
        ibco:partOf ibc:ibc2021-1030.13.1.1 ;
        ibco:precedes ibc:ibc2021-1030.13.1.2 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: Portions of an aisle accessway having a length not exceeding 6 feet (1829 mm) and used by a total of not more than four persons." .

    ibc:ibc2021-ch10-exception-1118 a ibco:Exception ;
        ibco:bbox "[346.175, 194.683, 565.23, 260.768]" ;
        ibco:partOf ibc:ibc2021-1030.13.2 ;
        ibco:precedes ibc:ibc2021-1030.13.2.1 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: For seats with folding tablet arms, row spacing is permitted to be determined with the tablet arm in the stored position where the tablet arm when raised manually to vertical position in one motion automatically returns to the stored position by force of gravity." .

    ibc:ibc2021-ch10-exception-1120 a ibco:Exception ;
        ibco:bbox "[358.157, 367.669, 565.153, 422.718]" ;
        ibco:partOf ibc:ibc2021-1030.13.2.1 ;
        ibco:precedes ibc:ibc2021-1030.13.2.2 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1." .

    ibc:ibc2021-ch10-exception-1122 a ibco:Exception ;
        ibco:bbox "[358.147, 518.583, 565.143, 573.632]" ;
        ibco:partOf ibc:ibc2021-1030.13.2.2 ;
        ibco:precedes ibc:ibc2021-1030.14 ;
        ibco:sourcePage 350 ;
        ibco:text "Exception: For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1." .

    ibc:ibc2021-ch10-exception-1128 a ibco:Exception ;
        ibco:bbox "[82.791, 400.771, 289.781, 444.784]" ;
        ibco:partOf ibc:ibc2021-1030.14.1.3 ;
        ibco:precedes ibc:ibc2021-1030.14.2 ;
        ibco:sourcePage 351 ;
        ibco:text "Exception: In assembly spaces with fixed seating, edge protection is not required on the sides of ramped aisles where the ramped aisles provide access to the adjacent seating and aisle accessways." .

    ibc:ibc2021-ch10-exception-1131 a ibco:Exception ;
        ibco:bbox "[70.803, 544.733, 289.846, 625.774]" ;
        ibco:partOf ibc:ibc2021-1030.14.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1132 ;
        ibco:sourcePage 351 ;
        ibco:text "Exception: The tolerance between adjacent treads shall not exceed 3/16 inch (4.8 mm). 1030.14.2.2 Risers. Where the gradient of stepped aisles is to be the same as the gradient of adjoining seating areas, the riser height shall be not less than 4 inches (102 mm) nor more than 8 inches (203 mm) and shall be uniform within each flight." .

    ibc:ibc2021-ch10-exception-1137 a ibco:Exception ;
        ibco:bbox "[343.81, 634.775, 550.866, 678.788]" ;
        ibco:partOf ibc:ibc2021-1030.14.2.3 ;
        ibco:precedes ibc:ibc2021-1030.14.2.4 ;
        ibco:sourcePage 351 ;
        ibco:text "Exception: The contrasting marking stripe is permitted to be omitted where tread surfaces are such that the location of each tread is readily apparent when viewed in descent." .

    ibc:ibc2021-ch10-exception-1155 a ibco:Exception ;
        ibco:bbox "[346.204, 338.702, 565.212, 371.799]" ;
        ibco:partOf ibc:ibc2021-1030.16.3 ;
        ibco:precedes ibc:ibc2021-1030.16.4 ;
        ibco:sourcePage 352 ;
        ibco:text "Exception: Mid-aisle handrails shall be permitted to extend beyond the lowest riser where the handrail extensions do not obstruct the width of the cross aisle." .

    ibc:ibc2021-ch10-exception-1163 a ibco:Exception ;
        ibco:bbox "[70.8, 202.771, 289.836, 246.784]" ;
        ibco:partOf ibc:ibc2021-1030.17.2 ;
        ibco:precedes ibc:ibc2021-1030.17.3 ;
        ibco:sourcePage 353 ;
        ibco:text "Exception: Where the backs of seats on the front of the cross aisle project 24 inches (610 mm) or more above the adjacent floor of the aisle, a guard need not be provided." .

    ibc:ibc2021-ch10-exception-1182 a ibco:Exception ;
        ibco:bbox "[331.803, 573.844, 550.754, 606.83]" ;
        ibco:partOf ibc:ibc2021-1031.3.1 ;
        ibco:precedes ibc:ibc2021-1031.3.2 ;
        ibco:sourcePage 353 ;
        ibco:text "Exception: The minimum net clear opening for gradefloor emergency escape and rescue openings shall be 5 square feet (0.46 m2)." .

    ibc:ibc2021-ch10-exception-1188 a ibco:Exception ;
        ibco:bbox "[85.187, 261.832, 304.193, 305.845]" ;
        ibco:partOf ibc:ibc2021-1031.5.1 ;
        ibco:precedes ibc:ibc2021-1031.5.2 ;
        ibco:sourcePage 354 ;
        ibco:text "Exception: The ladder or steps required by Section 1031.5.2 shall be permitted to encroach not more than 6 inches (152 mm) into the required dimensions of the area well." .

    ibc:ibc2021-ch10-exception-1193 a ibco:Exception ;
        ibco:bbox "[85.187, 556.707, 304.195, 611.756]" ;
        ibco:partOf ibc:ibc2021-1031.5.3 ;
        ibco:precedes ibc:ibc2021-1031.6 ;
        ibco:sourcePage 354 ;
        ibco:text "Exception: A drainage system for area wells is not required where the foundation is on well-drained soil or sand-gravel mixture soils in accordance with the United Soil Classification System, Group I Soils, in accordance with Section 1803.5.1." .

    ibc:ibc2021-ch10-list_item-0013 a ibco:ListItem ;
        ibco:bbox "[346.223, 410.672, 565.206, 432.733]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0014 ;
        ibco:sourcePage 304 ;
        ibco:text "1. Sloped ceilings in accordance with Section 1208.2." .

    ibc:ibc2021-ch10-list_item-0014 a ibco:ListItem ;
        ibco:bbox "[346.223, 435.751, 565.27, 468.729]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0015 ;
        ibco:sourcePage 304 ;
        ibco:text "2. Ceilings of dwelling units and sleeping units within residential occupancies in accordance with Section 1208.2." .

    ibc:ibc2021-ch10-list_item-0015 a ibco:ListItem ;
        ibco:bbox "[346.223, 471.747, 565.242, 493.688]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0016 ;
        ibco:sourcePage 304 ;
        ibco:text "3. Allowable projections in accordance with Section 1003.3." .

    ibc:ibc2021-ch10-list_item-0016 a ibco:ListItem ;
        ibco:bbox "[346.223, 496.706, 565.171, 518.768]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0017 ;
        ibco:sourcePage 304 ;
        ibco:text "4. Stair headroom in accordance with Section 1011.3." .

    ibc:ibc2021-ch10-list_item-0017 a ibco:ListItem ;
        ibco:bbox "[346.223, 521.666, 562.515, 532.692]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0018 ;
        ibco:sourcePage 304 ;
        ibco:text "5. Door height in accordance with Section 1010.1.1." .

    ibc:ibc2021-ch10-list_item-0018 a ibco:ListItem ;
        ibco:bbox "[346.223, 535.71, 565.201, 557.771]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0019 ;
        ibco:sourcePage 304 ;
        ibco:text "6. Ramp headroom in accordance with Section 1012.5.2." .

    ibc:ibc2021-ch10-list_item-0019 a ibco:ListItem ;
        ibco:bbox "[346.223, 560.669, 565.22, 593.766]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0020 ;
        ibco:sourcePage 304 ;
        ibco:text "7. The clear height of floor levels in vehicular and pedestrian traffic areas of public and private parking garages in accordance with Section 406.2.2." .

    ibc:ibc2021-ch10-list_item-0020 a ibco:ListItem ;
        ibco:bbox "[346.223, 596.665, 565.207, 618.726]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0012 ;
        ibco:precedes ibc:ibc2021-1003.3 ;
        ibco:sourcePage 304 ;
        ibco:text "8. Areas above and below mezzanine floors in accordance with Section 505.2." .

    ibc:ibc2021-ch10-list_item-0032 a ibco:ListItem ;
        ibco:bbox "[70.789, 619.762, 289.794, 641.823]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0031 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0033 ;
        ibco:sourcePage 305 ;
        ibco:text "1. Steps at exterior doors complying with Section 1010.1.4." .

    ibc:ibc2021-ch10-list_item-0033 a ibco:ListItem ;
        ibco:bbox "[349.55, 69.651, 550.691, 91.712]",
            "[70.789, 644.721, 289.822, 721.722]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0031 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0034 ;
        ibco:sourcePage 305 ;
        ibco:text "2. A stair with a single riser or with two risers and a tread is permitted at locations not required to be accessible by Chapter 11 where the risers and treads comply with Section 1011.5, the minimum depth of the tread is 13 inches (330 mm) and not less than one handrail complying with Section 1014 is provided within 30 inches (762 mm) of the centerline of the normal path of egress travel on the stair." .

    ibc:ibc2021-ch10-list_item-0034 a ibco:ListItem ;
        ibco:bbox "[307.787, 94.73, 550.886, 219.718]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0031 ;
        ibco:precedes ibc:ibc2021-1003.6 ;
        ibco:sourcePage 305 ;
        ibco:text "3. A step is permitted in aisles serving seating that has a difference in elevation less than 12 inches (305 mm) at locations not required to be accessible by Chapter 11, provided that the risers and treads comply with Section 1030.14 and the aisle is provided with a handrail complying with Section 1030.16. Throughout a story in a Group I-2 occupancy, any change in elevation in portions of the means of egress that serve nonambulatory persons shall be by means of a ramp or sloped walkway." .

    ibc:ibc2021-ch10-list_item-0050 a ibco:ListItem ;
        ibco:bbox "[322.799, 728.666, 454.496, 737.433]" ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-1004.6 ;
        ibco:precedes ibc:ibc2021-1004.7 ;
        ibco:sourcePage 306 ;
        ibco:text "a. Floor area in square feet per occupant." .

    ibc:ibc2021-ch10-list_item-0053 a ibco:ListItem ;
        ibco:bbox "[70.803, 209.723, 289.831, 231.784]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0052 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0054 ;
        ibco:sourcePage 307 ;
        ibco:text "1. Outdoor areas used exclusively for service of the building need only have one means of egress." .

    ibc:ibc2021-ch10-list_item-0054 a ibco:ListItem ;
        ibco:bbox "[70.813, 234.802, 289.782, 256.744]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0052 ;
        ibco:precedes ibc:ibc2021-1004.8 ;
        ibco:sourcePage 307 ;
        ibco:text "2. Both outdoor areas associated with Group R-3 and individual dwelling units of Group R-2." .

    ibc:ibc2021-ch10-list_item-0064 a ibco:ListItem ;
        ibco:bbox "[343.773, 110.665, 550.829, 231.689]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0063 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0065 ;
        ibco:sourcePage 307 ;
        ibco:text "1. For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:ibc2021-ch10-list_item-0066 a ibco:ListItem ;
        ibco:bbox "[361.794, 311.748, 379.284, 322.774]" ;
        ibco:label "909" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0065 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0067 ;
        ibco:sourcePage 307 ;
        ibco:text "909." .

    ibc:ibc2021-ch10-list_item-0067 a ibco:ListItem ;
        ibco:bbox "[343.796, 325.792, 550.858, 391.757]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0063 ;
        ibco:precedes ibc:ibc2021-1005.3.2 ;
        ibco:sourcePage 307 ;
        ibco:text "3. Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:ibc2021-ch10-list_item-0070 a ibco:ListItem ;
        ibco:bbox "[343.826, 469.754, 550.9, 590.778]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0069 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0071 ;
        ibco:sourcePage 307 ;
        ibco:text "1. For other than Group H and I-2 occupancies, the capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.15 inch (3.8 mm) per occupant in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2 and an emergency voice/alarm communication system in accordance with Section 907.5.2.2." .

    ibc:ibc2021-ch10-list_item-0071 a ibco:ListItem ;
        ibco:bbox "[343.826, 593.676, 550.901, 681.713]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0069 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0072 ;
        ibco:sourcePage 307 ;
        ibco:text "2. Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909." .

    ibc:ibc2021-ch10-list_item-0072 a ibco:ListItem ;
        ibco:bbox "[115.199, 69.725, 304.183, 102.822]",
            "[343.836, 684.73, 550.885, 728.744]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0069 ;
        ibco:precedes ibc:ibc2021-1005.4 ;
        ibco:sourcePage 307,
            308 ;
        ibco:text "3. Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors." .

    ibc:ibc2021-ch10-list_item-0080 a ibco:ListItem ;
        ibco:bbox "[125.976, 453.743, 304.192, 497.756]" ;
        ibco:label "1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0079 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0081 ;
        ibco:sourcePage 308 ;
        ibco:text "1.1. The hardware is mounted to the side of the door facing away from the adjacent wall where the door is in the open position." .

    ibc:ibc2021-ch10-list_item-0081 a ibco:ListItem ;
        ibco:bbox "[125.976, 501.73, 304.137, 545.743]" ;
        ibco:label "1.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0079 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0082 ;
        ibco:sourcePage 308 ;
        ibco:text "1.2. The hardware is mounted not less than 34 inches (865 mm) nor more than 48 inches (1219 mm) above the finished floor." .

    ibc:ibc2021-ch10-list_item-0082 a ibco:ListItem ;
        ibco:bbox "[97.172, 548.641, 304.226, 592.655]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0078 ;
        ibco:precedes ibc:ibc2021-1005.7.2 ;
        ibco:sourcePage 308 ;
        ibco:text "2. The restrictions on door swing shall not apply to doors within individual dwelling units and sleeping units of Group R-2 occupancies and dwelling units of Group R-3 occupancies." .

    ibc:ibc2021-ch10-list_item-0091 a ibco:ListItem ;
        ibco:bbox "[358.187, 313.818, 565.267, 379.783]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0090 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0092 ;
        ibco:sourcePage 308 ;
        ibco:text "1. The number of exits from foyers, lobbies, vestibules or similar spaces need not be based on cumulative occupant loads for areas discharging through such spaces, but the capacity of the exits from such spaces shall be based on applicable cumulative occupant loads." .

    ibc:ibc2021-ch10-list_item-0092 a ibco:ListItem ;
        ibco:bbox "[358.187, 383.518, 565.297, 405.58]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0090 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0093 ;
        ibco:sourcePage 308 ;
        ibco:text "2. Care suites in Group I-2 occupancies complying with Section 407.4." .

    ibc:ibc2021-ch10-list_item-0093 a ibco:ListItem ;
        ibco:bbox "[358.187, 409.434, 565.245, 442.412]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0090 ;
        ibco:precedes ibc:ibc2021-1006.2.1.1 ;
        ibco:sourcePage 308 ;
        ibco:text "3. Unoccupied mechanical rooms and penthouses are not required to comply with the common path of egress travel distance measurement." .

    ibc:ibc2021-ch10-list_item-0103 a ibco:ListItem ;
        ibco:bbox "[46.807, 652.824, 551.382, 661.591]",
            "[55.812, 661.821, 333.286, 670.588]" ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0104 ;
        ibco:sourcePage 309 ;
        ibco:text "a. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2. See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0104 a ibco:ListItem ;
        ibco:bbox "[46.815, 671.903, 423.796, 680.67]" ;
        ibco:label "b" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0105 ;
        ibco:sourcePage 309 ;
        ibco:text "b. Group H occupancies equipped throughout with an automatic sprinkler system in accordance with Section 903.2.5." .

    ibc:ibc2021-ch10-list_item-0105 a ibco:ListItem ;
        ibco:bbox "[46.815, 681.866, 342.928, 690.634]" ;
        ibco:label "c" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0106 ;
        ibco:sourcePage 309 ;
        ibco:text "c. For a room or space used for assembly purposes having fixed seating, see Section 1030.8." .

    ibc:ibc2021-ch10-list_item-0106 a ibco:ListItem ;
        ibco:bbox "[46.815, 691.949, 267.39, 700.716]" ;
        ibco:label "d" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0107 ;
        ibco:sourcePage 309 ;
        ibco:text "d. For the travel distance limitations in Group I-2, see Section 407.4." .

    ibc:ibc2021-ch10-list_item-0107 a ibco:ListItem ;
        ibco:bbox "[46.815, 701.912, 460.268, 710.679]" ;
        ibco:label "e" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0108 ;
        ibco:sourcePage 309 ;
        ibco:text "e. The common path of egress travel distance shall only apply in a Group R-3 occupancy located in a mixed occupancy building." .

    ibc:ibc2021-ch10-list_item-0108 a ibco:ListItem ;
        ibco:bbox "[46.815, 711.875, 443.22, 720.643]" ;
        ibco:label "f" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0109 ;
        ibco:sourcePage 309 ;
        ibco:text "f. The length of common path of egress travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:ibc2021-ch10-list_item-0109 a ibco:ListItem ;
        ibco:bbox "[46.815, 721.957, 551.334, 730.725]",
            "[55.812, 730.955, 117.796, 739.722]",
            "[85.199, 69.725, 304.291, 91.786]" ;
        ibco:label "g" ;
        ibco:partOf ibc:ibc2021-1006.2.2.6 ;
        ibco:precedes ibc:ibc2021-1006.3 ;
        ibco:sourcePage 309,
            310 ;
        ibco:text "g. For the travel distance limitations in Groups R-3 and R-4 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3, see Section 1006.2.2.6. Section 903.3.1.3, the exit access travel distance for Group R-4 shall be not more than 75 feet (22 860 mm)." .

    ibc:ibc2021-ch10-list_item-0114 a ibco:ListItem ;
        ibco:bbox "[97.201, 298.745, 304.316, 353.794]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0115 ;
        ibco:sourcePage 310 ;
        ibco:text "1. In Group R-1, R-2 or R-3 occupancies, exit access stairways and ramps connecting four stories or less serving and contained within an individual dwelling unit, sleeping unit or live/work unit." .

    ibc:ibc2021-ch10-list_item-0115 a ibco:ListItem ;
        ibco:bbox "[97.201, 356.692, 304.27, 389.789]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0116 ;
        ibco:sourcePage 310 ;
        ibco:text "2. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility." .

    ibc:ibc2021-ch10-list_item-0116 a ibco:ListItem ;
        ibco:bbox "[97.201, 392.688, 304.268, 414.749]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0117 ;
        ibco:sourcePage 310 ;
        ibco:text "3. Exit access stairways and ramps within an atrium complying with Section 404." .

    ibc:ibc2021-ch10-list_item-0117 a ibco:ListItem ;
        ibco:bbox "[97.211, 417.767, 304.287, 439.709]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0118 ;
        ibco:sourcePage 310 ;
        ibco:text "4. Exit access stairways and ramps in open parking garages that serve only the parking garage." .

    ibc:ibc2021-ch10-list_item-0118 a ibco:ListItem ;
        ibco:bbox "[97.221, 442.727, 304.298, 486.74]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0119 ;
        ibco:sourcePage 310 ;
        ibco:text "5. Exit access stairways and ramps serving openair assembly seating complying with the exit access travel distance requirements of Section 1030.7." .

    ibc:ibc2021-ch10-list_item-0119 a ibco:ListItem ;
        ibco:bbox "[97.221, 489.758, 304.276, 544.787]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0120 ;
        ibco:sourcePage 310 ;
        ibco:text "6. Exit access stairways and ramps between the balcony, gallery or press box and the main assembly floor in occupancies such as theaters, places of religious worship, auditoriums and sports facilities." .

    ibc:ibc2021-ch10-list_item-0120 a ibco:ListItem ;
        ibco:bbox "[97.201, 547.804, 304.232, 569.866]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0113 ;
        ibco:precedes ibc:ibc2021-1006.3.3 ;
        ibco:sourcePage 310 ;
        ibco:text "7. Exterior exit access stairways and ramps between occupied roofs." .

    ibc:ibc2021-ch10-list_item-0123 a ibco:ListItem ;
        ibco:bbox "[346.201, 202.796, 565.277, 235.773]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0124 ;
        ibco:sourcePage 310 ;
        ibco:text "1. The occupant load, number of dwelling units and exit access travel distance do not exceed the values in Table 1006.3.4(1) or 1006.3.4(2)." .

    ibc:ibc2021-ch10-list_item-0124 a ibco:ListItem ;
        ibco:bbox "[346.201, 238.791, 565.295, 282.805]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0125 ;
        ibco:sourcePage 310 ;
        ibco:text "2. Rooms, areas and spaces complying with Section 1006.2.1 with exits that discharge directly to the exterior at the level of exit discharge, are permitted to have one exit or access to a single exit." .

    ibc:ibc2021-ch10-list_item-0125 a ibco:ListItem ;
        ibco:bbox "[346.211, 285.822, 565.334, 318.8]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0126 ;
        ibco:sourcePage 310 ;
        ibco:text "3. Parking garages where vehicles are mechanically parked shall be permitted to have one exit or access to a single exit." .

    ibc:ibc2021-ch10-list_item-0126 a ibco:ListItem ;
        ibco:bbox "[346.211, 321.818, 565.297, 343.76]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1006.3.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0127 ;
        ibco:sourcePage 310 ;
        ibco:text "4. Group R-3 and R-4 occupancies shall be permitted to have one exit or access to a single exit." .

    ibc:ibc2021-ch10-list_item-0128 a ibco:ListItem ;
        ibco:bbox "[372.625, 393.809, 565.436, 426.786]" ;
        ibco:label "5.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0127 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0129 ;
        ibco:sourcePage 310 ;
        ibco:text "5.1. The dwelling unit complies with Section 1006.2.1 as a space with one means of egress." .

    ibc:ibc2021-ch10-list_item-0129 a ibco:ListItem ;
        ibco:bbox "[372.625, 429.804, 565.311, 495.769]" ;
        ibco:label "5.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0127 ;
        ibco:precedes ibc:ibc2021-1006.3.4.1 ;
        ibco:sourcePage 310 ;
        ibco:text "5.2. Either the exit from the dwelling unit discharges directly to the exterior at the level of exit discharge, or the exit access outside the dwelling unit’s entrance door provides access to not less than two approved independent exits." .

    ibc:ibc2021-ch10-list_item-0131 a ibco:ListItem ;
        ibco:bbox "[46.195, 167.656, 550.793, 176.424]",
            "[55.193, 175.695, 305.087, 184.462]" ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0132 ;
        ibco:sourcePage 311 ;
        ibco:text "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031." .

    ibc:ibc2021-ch10-list_item-0132 a ibco:ListItem ;
        ibco:bbox "[143.756, 217.113, 454.363, 225.952]",
            "[264.235, 208.116, 333.957, 216.954]",
            "[46.195, 183.615, 503.566, 192.382]",
            "[46.197, 337.228, 133.109, 363.031]" ;
        ibco:label "b" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0133 ;
        ibco:sourcePage 311 ;
        ibco:text "b. This table is used for R-2 occupancies consisting of dwelling units. For R-2 occupancies consisting of sleeping units, use Table 1006.3.4(2). TABLE 1006.3.4(2) STORIES WITH ONE EXIT OR ACCESS TO ONE EXIT FOR OTHER OCCUPANCIES For SI: 1 foot = 304.8 mm. NP = Not Permitted. NA = Not Applicable." .

    ibc:ibc2021-ch10-list_item-0133 a ibco:ListItem ;
        ibco:bbox "[46.197, 362.302, 551.999, 371.07]",
            "[55.202, 370.222, 305.096, 378.99]" ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0134 ;
        ibco:sourcePage 311 ;
        ibco:text "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031." .

    ibc:ibc2021-ch10-list_item-0134 a ibco:ListItem ;
        ibco:bbox "[46.205, 378.261, 552.008, 387.028]",
            "[55.202, 386.3, 195.049, 395.067]" ;
        ibco:label "b" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0135 ;
        ibco:sourcePage 311 ;
        ibco:text "b. Group B, F and S occupancies in buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 shall have a maximum exit access travel distance of 100 feet." .

    ibc:ibc2021-ch10-list_item-0135 a ibco:ListItem ;
        ibco:bbox "[46.205, 394.22, 503.576, 402.987]" ;
        ibco:label "c" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0136 ;
        ibco:sourcePage 311 ;
        ibco:text "c. This table is used for R-2 occupancies consisting of sleeping units. For R-2 occupancies consisting of dwelling units, use Table 1006.3.4(1)." .

    ibc:ibc2021-ch10-list_item-0136 a ibco:ListItem ;
        ibco:bbox "[46.205, 402.259, 402.692, 411.026]" ;
        ibco:label "d" ;
        ibco:partOf ibc:ibc2021-1006.3.4.1 ;
        ibco:precedes ibc:ibc2021-1007 ;
        ibco:sourcePage 311 ;
        ibco:text "d. The length of exit access travel distance in a Group S-2 open parking garage shall be not more than 100 feet." .

    ibc:ibc2021-ch10-list_item-0141 a ibco:ListItem ;
        ibco:bbox "[82.783, 624.789, 289.82, 690.755]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0142 ;
        ibco:sourcePage 311 ;
        ibco:text "1. Where interior exit stairways or ramps are interconnected by a 1-hour fire-resistance-rated corridor conforming to the requirements of Section 1020, the required exit separation shall be measured along the shortest direct line of travel within the corridor." .

    ibc:ibc2021-ch10-list_item-0142 a ibco:ListItem ;
        ibco:bbox "[361.773, 421.725, 550.803, 454.703]",
            "[82.773, 693.772, 289.76, 726.75]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0140 ;
        ibco:precedes ibc:ibc2021-1007.1.1.1 ;
        ibco:sourcePage 311 ;
        ibco:text "2. Where a building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2, the separation distance shall be not less than one-third of the length of the maximum overall diagonal dimension of the area served." .

    ibc:ibc2021-ch10-list_item-0144 a ibco:ListItem ;
        ibco:bbox "[343.775, 495.748, 550.821, 528.725]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1007.1.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0145 ;
        ibco:sourcePage 311 ;
        ibco:text "1. The separation distance to exit or exit access doorways shall be measured to any point along the width of the doorway." .

    ibc:ibc2021-ch10-list_item-0145 a ibco:ListItem ;
        ibco:bbox "[343.785, 531.743, 550.75, 553.685]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1007.1.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0146 ;
        ibco:sourcePage 311 ;
        ibco:text "2. The separation distance to exit access stairways shall be measured to the closest riser." .

    ibc:ibc2021-ch10-list_item-0146 a ibco:ListItem ;
        ibco:bbox "[343.785, 556.703, 550.807, 578.764]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1007.1.1.1 ;
        ibco:precedes ibc:ibc2021-1007.1.2 ;
        ibco:sourcePage 311 ;
        ibco:text "3. The separation distance to exit access ramps shall be measured to the start of the ramp run." .

    ibc:ibc2021-ch10-list_item-0154 a ibco:ListItem ;
        ibco:bbox "[85.209, 271.763, 204.592, 282.789]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0153 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0155 ;
        ibco:sourcePage 312 ;
        ibco:text "1. Occupancies in Group U." .

    ibc:ibc2021-ch10-list_item-0155 a ibco:ListItem ;
        ibco:bbox "[85.209, 285.807, 222.0, 296.833]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0153 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0156 ;
        ibco:sourcePage 312 ;
        ibco:text "2. Aisle accessways in Group A." .

    ibc:ibc2021-ch10-list_item-0156 a ibco:ListItem ;
        ibco:bbox "[85.199, 299.731, 304.163, 321.793]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0153 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0157 ;
        ibco:sourcePage 312 ;
        ibco:text "3. Dwelling units and sleeping units in Groups R-1, R-2 and R-3." .

    ibc:ibc2021-ch10-list_item-0157 a ibco:ListItem ;
        ibco:bbox "[85.199, 324.81, 257.978, 335.836]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0153 ;
        ibco:precedes ibc:ibc2021-1008.2.1 ;
        ibco:sourcePage 312 ;
        ibco:text "4. Sleeping units of Group I occupancies." .

    ibc:ibc2021-ch10-list_item-0160 a ibco:ListItem ;
        ibco:bbox "[97.201, 501.76, 304.263, 534.737]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0159 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0161 ;
        ibco:sourcePage 312 ;
        ibco:text "1. Externally illuminated walking surfaces shall be permitted to be illuminated to not less than 0.2 footcandle (2.15 lux)." .

    ibc:ibc2021-ch10-list_item-0161 a ibco:ListItem ;
        ibco:bbox "[97.201, 537.755, 304.182, 592.685]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0159 ;
        ibco:precedes ibc:ibc2021-1008.2.2 ;
        ibco:sourcePage 312 ;
        ibco:text "2. Steps, landings and the sides of ramps shall be permitted to be marked with self-luminous materials in accordance with Sections 1025.2.1, 1025.2.2 and 1025.2.4 by systems listed in accordance with UL 1994." .

    ibc:ibc2021-ch10-list_item-0165 a ibco:ListItem ;
        ibco:bbox "[358.193, 143.618, 565.168, 176.596]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0164 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0166 ;
        ibco:sourcePage 312 ;
        ibco:text "1. The path of exit discharge is illuminated from the exit to a safe dispersal area complying with Section 1028.5." .

    ibc:ibc2021-ch10-list_item-0166 a ibco:ListItem ;
        ibco:bbox "[358.193, 179.613, 565.239, 212.591]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0164 ;
        ibco:precedes ibc:ibc2021-1008.3 ;
        ibco:sourcePage 312 ;
        ibco:text "2. A dispersal area shall be illuminated to a level not less than 1 footcandle (11 lux) at the walking surface." .

    ibc:ibc2021-ch10-list_item-0169 a ibco:ListItem ;
        ibco:bbox "[346.209, 301.788, 390.342, 312.813]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1008.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0170 ;
        ibco:sourcePage 312 ;
        ibco:text "1. Aisles." .

    ibc:ibc2021-ch10-list_item-0170 a ibco:ListItem ;
        ibco:bbox "[346.209, 315.831, 406.417, 326.857]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1008.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0171 ;
        ibco:sourcePage 312 ;
        ibco:text "2. Corridors." .

    ibc:ibc2021-ch10-list_item-0171 a ibco:ListItem ;
        ibco:bbox "[346.209, 329.755, 496.416, 340.781]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1008.3.1 ;
        ibco:precedes ibc:ibc2021-1008.3.2 ;
        ibco:sourcePage 312 ;
        ibco:text "3. Exit access stairways and ramps." .

    ibc:ibc2021-ch10-list_item-0173 a ibco:ListItem ;
        ibco:bbox "[346.209, 392.742, 528.338, 403.768]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1008.3.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0174 ;
        ibco:sourcePage 312 ;
        ibco:text "1. Interior exit access stairways and ramps." .

    ibc:ibc2021-ch10-list_item-0174 a ibco:ListItem ;
        ibco:bbox "[346.209, 406.786, 550.778, 417.812]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1008.3.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0175 ;
        ibco:sourcePage 312 ;
        ibco:text "2. Interior and exterior exit stairways and ramps." .

    ibc:ibc2021-ch10-list_item-0175 a ibco:ListItem ;
        ibco:bbox "[346.209, 420.829, 437.254, 431.855]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1008.3.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0176 ;
        ibco:sourcePage 312 ;
        ibco:text "3. Exit passageways." .

    ibc:ibc2021-ch10-list_item-0176 a ibco:ListItem ;
        ibco:bbox "[346.199, 434.754, 565.166, 467.851]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1008.3.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0177 ;
        ibco:sourcePage 312 ;
        ibco:text "4. Vestibules and areas on the level of discharge used for exit discharge in accordance with Section 1028.2." .

    ibc:ibc2021-ch10-list_item-0177 a ibco:ListItem ;
        ibco:bbox "[346.199, 470.749, 565.21, 503.846]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1008.3.2 ;
        ibco:precedes ibc:ibc2021-1008.3.3 ;
        ibco:sourcePage 312 ;
        ibco:text "5. Exterior landings as required by Section 1010.1.5 for exit doorways that lead directly to the exit discharge." .

    ibc:ibc2021-ch10-list_item-0179 a ibco:ListItem ;
        ibco:bbox "[346.199, 544.772, 477.008, 555.797]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1008.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0180 ;
        ibco:sourcePage 312 ;
        ibco:text "1. Electrical equipment rooms." .

    ibc:ibc2021-ch10-list_item-0180 a ibco:ListItem ;
        ibco:bbox "[346.199, 558.815, 455.304, 569.841]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1008.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0181 ;
        ibco:sourcePage 312 ;
        ibco:text "2. Fire command centers." .

    ibc:ibc2021-ch10-list_item-0181 a ibco:ListItem ;
        ibco:bbox "[346.199, 572.739, 435.344, 583.765]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1008.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0182 ;
        ibco:sourcePage 312 ;
        ibco:text "3. Fire pump rooms." .

    ibc:ibc2021-ch10-list_item-0182 a ibco:ListItem ;
        ibco:bbox "[346.199, 586.783, 433.893, 597.809]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1008.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0183 ;
        ibco:sourcePage 312 ;
        ibco:text "4. Generator rooms." .

    ibc:ibc2021-ch10-list_item-0183 a ibco:ListItem ;
        ibco:bbox "[346.199, 600.826, 565.195, 622.79]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1008.3.3 ;
        ibco:precedes ibc:ibc2021-1008.3.4 ;
        ibco:sourcePage 312 ;
        ibco:text "5. Public restrooms with an area greater than 300 square feet (27.87 m2)." .

    ibc:ibc2021-ch10-list_item-0189 a ibco:ListItem ;
        ibco:bbox "[70.801, 355.726, 289.78, 388.704]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0188 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0190 ;
        ibco:sourcePage 313 ;
        ibco:text "1. One accessible means of egress is required from an accessible mezzanine level in accordance with Section 1009.3, 1009.4 or 1009.5." .

    ibc:ibc2021-ch10-list_item-0190 a ibco:ListItem ;
        ibco:bbox "[70.801, 391.722, 289.891, 446.771]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0188 ;
        ibco:precedes ibc:ibc2021-1009.2 ;
        ibco:sourcePage 313 ;
        ibco:text "2. In assembly areas with ramped aisles or stepped aisles, one accessible means of egress is permitted where the common path of egress travel is accessible and meets the requirements in Section 1030.8." .

    ibc:ibc2021-ch10-list_item-0192 a ibco:ListItem ;
        ibco:bbox "[63.829, 487.696, 269.512, 498.722]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0193 ;
        ibco:sourcePage 313 ;
        ibco:text "1. Accessible routes complying with Section 1104." .

    ibc:ibc2021-ch10-list_item-0193 a ibco:ListItem ;
        ibco:bbox "[63.829, 501.74, 289.834, 523.682]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0194 ;
        ibco:sourcePage 313 ;
        ibco:text "2. Interior exit stairways complying with Sections 1009.3 and 1023." .

    ibc:ibc2021-ch10-list_item-0194 a ibco:ListItem ;
        ibco:bbox "[63.829, 526.7, 289.716, 548.761]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0195 ;
        ibco:sourcePage 313 ;
        ibco:text "3. Exit access stairways complying with Sections 1009.3 and 1019.3 or 1019.4." .

    ibc:ibc2021-ch10-list_item-0195 a ibco:ListItem ;
        ibco:bbox "[63.829, 551.659, 289.82, 584.757]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0196 ;
        ibco:sourcePage 313 ;
        ibco:text "4. Exterior exit stairways complying with Sections 1009.3 and 1027 and serving levels other than the level of exit discharge." .

    ibc:ibc2021-ch10-list_item-0196 a ibco:ListItem ;
        ibco:bbox "[63.819, 587.655, 245.027, 598.681]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0197 ;
        ibco:sourcePage 313 ;
        ibco:text "5. Elevators complying with Section 1009.4." .

    ibc:ibc2021-ch10-list_item-0197 a ibco:ListItem ;
        ibco:bbox "[63.819, 601.698, 260.358, 612.724]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0198 ;
        ibco:sourcePage 313 ;
        ibco:text "6. Platform lifts complying with Section 1009.5." .

    ibc:ibc2021-ch10-list_item-0198 a ibco:ListItem ;
        ibco:bbox "[63.819, 615.742, 264.1, 626.768]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0199 ;
        ibco:sourcePage 313 ;
        ibco:text "7. Horizontal exits complying with Section 1026." .

    ibc:ibc2021-ch10-list_item-0199 a ibco:ListItem ;
        ibco:bbox "[63.819, 629.666, 227.027, 640.692]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0200 ;
        ibco:sourcePage 313 ;
        ibco:text "8. Ramps complying with Section 1012." .

    ibc:ibc2021-ch10-list_item-0200 a ibco:ListItem ;
        ibco:bbox "[63.819, 643.71, 268.904, 654.735]" ;
        ibco:label "9" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0201 ;
        ibco:sourcePage 313 ;
        ibco:text "9. Areas of refuge complying with Section 1009.6." .

    ibc:ibc2021-ch10-list_item-0201 a ibco:ListItem ;
        ibco:bbox "[58.779, 657.753, 289.794, 690.731]" ;
        ibco:label "10" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-1009.2.1 ;
        ibco:sourcePage 313 ;
        ibco:text "10. Exterior areas for assisted rescue complying with Section 1009.7 serving exits at the level of exit discharge." .

    ibc:ibc2021-ch10-list_item-0204 a ibco:ListItem ;
        ibco:bbox "[343.785, 110.661, 550.833, 176.73]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0203 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0205 ;
        ibco:sourcePage 313 ;
        ibco:text "1. In buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, the elevator shall not be required on floors provided with a horizontal exit and located at or above the levels of exit discharge." .

    ibc:ibc2021-ch10-list_item-0205 a ibco:ListItem ;
        ibco:bbox "[343.811, 179.747, 550.81, 245.832]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0203 ;
        ibco:precedes ibc:ibc2021-1009.3 ;
        ibco:sourcePage 313 ;
        ibco:text "2. In buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, the elevator shall not be required on floors provided with a ramp conforming to the provisions of Section 1012." .

    ibc:ibc2021-ch10-list_item-0211 a ibco:ListItem ;
        ibco:bbox "[343.791, 412.732, 550.811, 467.781]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0210 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0212 ;
        ibco:sourcePage 313 ;
        ibco:text "1. The clear width of 48 inches (1219 mm) between handrails is not required in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0212 a ibco:ListItem ;
        ibco:bbox "[343.791, 470.679, 550.811, 514.692]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0210 ;
        ibco:precedes ibc:ibc2021-1009.3.3 ;
        ibco:sourcePage 313 ;
        ibco:text "2. The clear width of 48 inches (1219 mm) between handrails is not required for stairways accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:ibc2021-ch10-list_item-0215 a ibco:ListItem ;
        ibco:bbox "[343.781, 581.653, 550.833, 625.667]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0216 ;
        ibco:sourcePage 313 ;
        ibco:text "1. Areas of refuge are not required at exit access stairways where two-way communication is provided at the elevator landing in accordance with Section 1009.8." .

    ibc:ibc2021-ch10-list_item-0216 a ibco:ListItem ;
        ibco:bbox "[343.781, 628.684, 550.833, 672.822]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0217 ;
        ibco:sourcePage 313 ;
        ibco:text "2. Areas of refuge are not required at stairways in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0217 a ibco:ListItem ;
        ibco:bbox "[343.796, 675.84, 550.826, 697.782]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0218 ;
        ibco:sourcePage 313 ;
        ibco:text "3. Areas of refuge are not required at stairways serving open parking garages." .

    ibc:ibc2021-ch10-list_item-0218 a ibco:ListItem ;
        ibco:bbox "[115.199, 69.725, 304.151, 91.786]",
            "[343.796, 700.8, 550.828, 722.861]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0219 ;
        ibco:sourcePage 313,
            314 ;
        ibco:text "4. Areas of refuge are not required for smokeprotected or open-air assembly seating areas complying with Sections 1030.6.2 and 1030.6.3." .

    ibc:ibc2021-ch10-list_item-0219 a ibco:ListItem ;
        ibco:bbox "[97.201, 94.804, 304.254, 116.746]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0220 ;
        ibco:sourcePage 314 ;
        ibco:text "5. Areas of refuge are not required at stairways in Group R-2 occupancies." .

    ibc:ibc2021-ch10-list_item-0220 a ibco:ListItem ;
        ibco:bbox "[97.191, 119.764, 304.162, 152.741]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0214 ;
        ibco:precedes ibc:ibc2021-1009.4 ;
        ibco:sourcePage 314 ;
        ibco:text "6. Areas of refuge are not required for stairways accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:ibc2021-ch10-list_item-0225 a ibco:ListItem ;
        ibco:bbox "[97.191, 293.725, 304.2, 315.787]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0224 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0226 ;
        ibco:sourcePage 314 ;
        ibco:text "1. Areas of refuge are not required at the elevator in open parking garages." .

    ibc:ibc2021-ch10-list_item-0226 a ibco:ListItem ;
        ibco:bbox "[97.181, 318.804, 304.17, 362.818]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0224 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0227 ;
        ibco:sourcePage 314 ;
        ibco:text "2. Areas of refuge are not required in buildings and facilities equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0227 a ibco:ListItem ;
        ibco:bbox "[97.181, 365.716, 304.198, 398.813]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0224 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0228 ;
        ibco:sourcePage 314 ;
        ibco:text "3. Areas of refuge are not required at elevators not required to be located in a shaft in accordance with Section 712." .

    ibc:ibc2021-ch10-list_item-0228 a ibco:ListItem ;
        ibco:bbox "[97.181, 401.711, 304.223, 445.725]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0224 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0229 ;
        ibco:sourcePage 314 ;
        ibco:text "4. Areas of refuge are not required at elevators serving smoke-protected or open-air assembly seating areas complying with Sections 1030.6.2 and 1030.6.3." .

    ibc:ibc2021-ch10-list_item-0229 a ibco:ListItem ;
        ibco:bbox "[97.181, 448.743, 304.259, 481.72]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0224 ;
        ibco:precedes ibc:ibc2021-1009.5 ;
        ibco:sourcePage 314 ;
        ibco:text "5. Areas of refuge are not required for elevators accessed from a refuge area in conjunction with a horizontal exit." .

    ibc:ibc2021-ch10-list_item-0238 a ibco:ListItem ;
        ibco:bbox "[358.204, 237.887, 565.201, 270.865]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0237 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0239 ;
        ibco:sourcePage 314 ;
        ibco:text "1. Areas of refuge located within an enclosure for interior exit stairways complying with Section 1023." .

    ibc:ibc2021-ch10-list_item-0239 a ibco:ListItem ;
        ibco:bbox "[358.204, 274.6, 565.213, 296.661]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0237 ;
        ibco:precedes ibc:ibc2021-1009.6.5 ;
        ibco:sourcePage 314 ;
        ibco:text "2. Areas of refuge in outdoor facilities where exit access is essentially open to the outside." .

    ibc:ibc2021-ch10-list_item-0250 a ibco:ListItem ;
        ibco:bbox "[70.781, 287.709, 289.823, 342.758]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0251 ;
        ibco:sourcePage 315 ;
        ibco:text "1. Two-way communication systems are not required at the landing serving each elevator or bank of elevators where the two-way communication system is provided within areas of refuge in accordance with Section 1009.6.5." .

    ibc:ibc2021-ch10-list_item-0251 a ibco:ListItem ;
        ibco:bbox "[70.781, 345.776, 289.823, 378.754]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0252 ;
        ibco:sourcePage 315 ;
        ibco:text "2. Two-way communication systems are not required on floors provided with ramps conforming to the provisions of Section 1012." .

    ibc:ibc2021-ch10-list_item-0252 a ibco:ListItem ;
        ibco:bbox "[70.781, 381.772, 289.823, 436.701]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0253 ;
        ibco:sourcePage 315 ;
        ibco:text "3. Two-way communication systems are not required at the landings serving only service elevators that are not designated as part of the accessible means of egress or serve as part of the required accessible route into a facility." .

    ibc:ibc2021-ch10-list_item-0253 a ibco:ListItem ;
        ibco:bbox "[70.781, 439.719, 289.823, 472.697]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0254 ;
        ibco:sourcePage 315 ;
        ibco:text "4. Two-way communication systems are not required at the landings serving only freight elevators." .

    ibc:ibc2021-ch10-list_item-0254 a ibco:ListItem ;
        ibco:bbox "[70.781, 475.714, 289.823, 508.692]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0255 ;
        ibco:sourcePage 315 ;
        ibco:text "5. Two-way communication systems are not required at the landing serving a private residence elevator." .

    ibc:ibc2021-ch10-list_item-0255 a ibco:ListItem ;
        ibco:bbox "[70.781, 511.71, 289.823, 533.771]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0249 ;
        ibco:precedes ibc:ibc2021-1009.8.1 ;
        ibco:sourcePage 315 ;
        ibco:text "6. Two-way communication systems are not required in Group I-2 or I-3 facilities." .

    ibc:ibc2021-ch10-list_item-0259 a ibco:ListItem ;
        ibco:bbox "[319.781, 95.601, 550.759, 128.579]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1009.9 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0260 ;
        ibco:sourcePage 315 ;
        ibco:text "1. Each door providing access to an area of refuge from an adjacent floor area shall be identified by a sign stating, \"AREA OF REFUGE.\"" .

    ibc:ibc2021-ch10-list_item-0260 a ibco:ListItem ;
        ibco:bbox "[307.769, 131.596, 550.839, 256.787]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1009.9 ;
        ibco:precedes ibc:ibc2021-1009.10 ;
        ibco:sourcePage 315 ;
        ibco:text "2. Each door providing access to an exterior area for assisted rescue shall be identified by a sign stating, \"EXTERIOR AREA FOR ASSISTED RESCUE.\" Signage shall comply with the ICC A117.1 requirements for visual characters and include the International Symbol of Accessibility. Where exit sign illumination is required by Section 1013.3, the signs shall be illuminated. Additionally, visual characters, raised character and braille signage complying with ICC A117.1 shall be located at each door to an area of refuge and exterior area for assisted rescue in accordance with Section 1013.4." .

    ibc:ibc2021-ch10-list_item-0262 a ibco:ListItem ;
        ibco:bbox "[319.799, 308.748, 550.919, 330.809]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1009.10 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0263 ;
        ibco:sourcePage 315 ;
        ibco:text "1. At exits serving a required accessible space but not providing an approved accessible means of egress." .

    ibc:ibc2021-ch10-list_item-0263 a ibco:ListItem ;
        ibco:bbox "[319.789, 333.827, 421.396, 344.853]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1009.10 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0264 ;
        ibco:sourcePage 315 ;
        ibco:text "2. At elevator landings." .

    ibc:ibc2021-ch10-list_item-0264 a ibco:ListItem ;
        ibco:bbox "[319.789, 347.751, 431.112, 358.777]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1009.10 ;
        ibco:precedes ibc:ibc2021-1009.11 ;
        ibco:sourcePage 315 ;
        ibco:text "3. Within areas of refuge." .

    ibc:ibc2021-ch10-list_item-0266 a ibco:ListItem ;
        ibco:bbox "[319.779, 421.774, 550.813, 443.835]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1009.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0267 ;
        ibco:sourcePage 315 ;
        ibco:text "1. Persons able to use the exit stairway do so as soon as possible, unless they are assisting others." .

    ibc:ibc2021-ch10-list_item-0267 a ibco:ListItem ;
        ibco:bbox "[319.779, 446.734, 550.936, 479.831]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1009.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0268 ;
        ibco:sourcePage 315 ;
        ibco:text "2. Information on planned availability of assistance in the use of stairs or supervised operation of elevators and how to summon such assistance." .

    ibc:ibc2021-ch10-list_item-0268 a ibco:ListItem ;
        ibco:bbox "[319.779, 482.729, 550.813, 504.791]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1009.11 ;
        ibco:precedes ibc:ibc2021-1010 ;
        ibco:sourcePage 315 ;
        ibco:text "3. Directions for use of the two-way communication system where provided." .

    ibc:ibc2021-ch10-list_item-0273 a ibco:ListItem ;
        ibco:bbox "[102.248, 264.836, 304.209, 319.765]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0274 ;
        ibco:sourcePage 316 ;
        ibco:text "1. In Group R-2 and R-3 dwelling and sleeping units that are not required to be an Accessible unit, Type A unit or Type B unit, the minimum width shall not apply to door openings that are not part of the required means of egress." .

    ibc:ibc2021-ch10-list_item-0274 a ibco:ListItem ;
        ibco:bbox "[102.248, 322.783, 304.258, 366.796]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0275 ;
        ibco:sourcePage 316 ;
        ibco:text "2. In Group I-3, door openings to resident sleeping units that are not required to be an Accessible unit shall have a minimum clear opening width of 28 inches (711 mm)." .

    ibc:ibc2021-ch10-list_item-0275 a ibco:ListItem ;
        ibco:bbox "[102.248, 369.814, 304.191, 402.826]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0276 ;
        ibco:sourcePage 316 ;
        ibco:text "3. Door openings to storage closets less than 10 square feet (0.93 m2) in area shall not be limited by the minimum clear opening width." .

    ibc:ibc2021-ch10-list_item-0276 a ibco:ListItem ;
        ibco:bbox "[102.244, 405.844, 304.212, 438.822]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0277 ;
        ibco:sourcePage 316 ;
        ibco:text "4. The maximum width of door leaves in revolving doors that comply with Section 1010.3.1 shall not be limited." .

    ibc:ibc2021-ch10-list_item-0277 a ibco:ListItem ;
        ibco:bbox "[102.244, 441.839, 304.169, 474.817]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0278 ;
        ibco:sourcePage 316 ;
        ibco:text "5. The maximum width of door leaves in poweroperated doors that comply with Section 1010.3.2 shall not be limited." .

    ibc:ibc2021-ch10-list_item-0278 a ibco:ListItem ;
        ibco:bbox "[102.254, 477.835, 304.186, 510.812]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0279 ;
        ibco:sourcePage 316 ;
        ibco:text "6. Door openings within a dwelling unit or sleeping unit shall have a minimum clear opening height of 78 inches (1981 mm)." .

    ibc:ibc2021-ch10-list_item-0279 a ibco:ListItem ;
        ibco:bbox "[102.264, 513.83, 304.258, 568.76]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0280 ;
        ibco:sourcePage 316 ;
        ibco:text "7. In dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, exterior door openings other than the required exit door shall have a minimum clear opening height of 76 inches (1930 mm)." .

    ibc:ibc2021-ch10-list_item-0280 a ibco:ListItem ;
        ibco:bbox "[102.284, 571.778, 304.349, 626.827]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0281 ;
        ibco:sourcePage 316 ;
        ibco:text "8. In Groups I-1, R-2, R-3 and R-4, in dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, the minimum clear opening widths shall not apply to interior egress doors." .

    ibc:ibc2021-ch10-list_item-0281 a ibco:ListItem ;
        ibco:bbox "[102.284, 629.725, 304.244, 673.738]" ;
        ibco:label "9" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0282 ;
        ibco:sourcePage 316 ;
        ibco:text "9. Door openings required to be accessible within Type B units intended for user passage shall have a minimum clear opening width of 31.75 inches (806 mm)." .

    ibc:ibc2021-ch10-list_item-0282 a ibco:ListItem ;
        ibco:bbox "[97.234, 676.756, 304.253, 720.822]" ;
        ibco:label "10" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0283 ;
        ibco:sourcePage 316 ;
        ibco:text "10. Doors to walk-in freezers and coolers less than 1,000 square feet (93 m2) in area shall have a maximum width of 60 inches (1524 mm) nominal." .

    ibc:ibc2021-ch10-list_item-0283 a ibco:ListItem ;
        ibco:bbox "[358.201, 69.717, 586.799, 132.227]" ;
        ibco:label "11" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0272 ;
        ibco:precedes ibc:ibc2021-1010.1.1.1 ;
        ibco:sourcePage 316 ;
        ibco:text "11. Doors serving nonaccessible single-user shower or sauna compartments, toilet stalls or dressing, fitting or changing rooms shall have a minimum clear opening width of 20 inches (508 mm). " .

    ibc:ibc2021-ch10-list_item-0288 a ibco:ListItem ;
        ibco:bbox "[358.201, 309.773, 565.185, 331.715]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0289 ;
        ibco:sourcePage 316 ;
        ibco:text "1. Private garages, office areas, factory and storage areas with an occupant load of 10 or less." .

    ibc:ibc2021-ch10-list_item-0289 a ibco:ListItem ;
        ibco:bbox "[358.201, 334.733, 565.169, 356.794]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0290 ;
        ibco:sourcePage 316 ;
        ibco:text "2. Group I-3 occupancies used as a place of detention." .

    ibc:ibc2021-ch10-list_item-0290 a ibco:ListItem ;
        ibco:bbox "[358.201, 359.693, 565.126, 381.754]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0291 ;
        ibco:sourcePage 316 ;
        ibco:text "3. Critical or intensive care patient rooms within suites of health care facilities." .

    ibc:ibc2021-ch10-list_item-0291 a ibco:ListItem ;
        ibco:bbox "[358.201, 384.772, 565.215, 406.714]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0292 ;
        ibco:sourcePage 316 ;
        ibco:text "4. Doors within or serving a single dwelling unit in Groups R-2 and R-3." .

    ibc:ibc2021-ch10-list_item-0292 a ibco:ListItem ;
        ibco:bbox "[358.201, 409.732, 565.173, 431.793]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0293 ;
        ibco:sourcePage 316 ;
        ibco:text "5. In other than Group H occupancies, revolving doors complying with Section 1010.3.1." .

    ibc:ibc2021-ch10-list_item-0293 a ibco:ListItem ;
        ibco:bbox "[358.201, 434.692, 565.251, 478.705]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0294 ;
        ibco:sourcePage 316 ;
        ibco:text "6. In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies complying with Section 1010.3.3." .

    ibc:ibc2021-ch10-list_item-0294 a ibco:ListItem ;
        ibco:bbox "[358.201, 481.723, 565.152, 503.784]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0295 ;
        ibco:sourcePage 316 ;
        ibco:text "7. Power-operated doors in accordance with Section 1010.3.2." .

    ibc:ibc2021-ch10-list_item-0295 a ibco:ListItem ;
        ibco:bbox "[358.201, 506.682, 565.242, 528.744]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0296 ;
        ibco:sourcePage 316 ;
        ibco:text "8. Doors serving a bathroom within an individual sleeping unit in Group R-1." .

    ibc:ibc2021-ch10-list_item-0296 a ibco:ListItem ;
        ibco:bbox "[358.201, 531.762, 565.197, 575.775]" ;
        ibco:label "9" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0287 ;
        ibco:precedes ibc:ibc2021-1010.1.2.1 ;
        ibco:sourcePage 316 ;
        ibco:text "9. In other than Group H occupancies, manually operated horizontal sliding doors are permitted in a means of egress from spaces with an occupant load of 10 or less." .

    ibc:ibc2021-ch10-list_item-0299 a ibco:ListItem ;
        ibco:bbox "[346.2, 664.688, 565.264, 697.665]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0300 ;
        ibco:sourcePage 316 ;
        ibco:text "1. Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)." .

    ibc:ibc2021-ch10-list_item-0300 a ibco:ListItem ;
        ibco:bbox "[346.2, 700.683, 565.264, 733.661]",
            "[58.797, 69.725, 289.895, 91.786]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0301 ;
        ibco:sourcePage 316,
            317 ;
        ibco:text "2. Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm). The force to open doors shall comply with the following:" .

    ibc:ibc2021-ch10-list_item-0301 a ibco:ListItem ;
        ibco:bbox "[70.799, 94.804, 289.829, 138.817]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0302 ;
        ibco:sourcePage 317 ;
        ibco:text "1. For interior swinging egress doors that are manually operated, other than doors required to be fire rated, the force for pushing or pulling open the door shall not exceed 5 pounds (22 N)." .

    ibc:ibc2021-ch10-list_item-0302 a ibco:ListItem ;
        ibco:bbox "[70.799, 141.716, 289.84, 207.8]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.1.3 ;
        ibco:precedes ibc:ibc2021-1010.1.3.1 ;
        ibco:sourcePage 317 ;
        ibco:text "2. For other swinging doors, sliding doors or folding doors, and doors required to be fire rated, the door shall require not more than a 30-pound (133 N) force to be set in motion and shall move to a fullopen position when subjected to not more than a 15-pound (67 N) force." .

    ibc:ibc2021-ch10-list_item-0307 a ibco:ListItem ;
        ibco:bbox "[82.801, 381.772, 289.886, 436.701]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0308 ;
        ibco:sourcePage 317 ;
        ibco:text "1. At doors serving individual dwelling units or sleeping units in Groups R-2 and R-3 : a door is permitted to open at the top step of an interior flight of stairs, provided that the door does not swing over the top step." .

    ibc:ibc2021-ch10-list_item-0308 a ibco:ListItem ;
        ibco:bbox "[82.801, 439.719, 289.834, 527.755]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0309 ;
        ibco:sourcePage 317 ;
        ibco:text "2. At exterior doors serving Groups F, H, R-2 and S and where such doors are not part of an accessible route, the landing at an exterior door shall not be more than 7 inches (178 mm) below the landing on the egress side of the door, provided that the door, other than an exterior storm or screen door, does not swing over the landing." .

    ibc:ibc2021-ch10-list_item-0309 a ibco:ListItem ;
        ibco:bbox "[82.801, 530.654, 289.784, 640.774]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0310 ;
        ibco:sourcePage 317 ;
        ibco:text "3. At exterior doors serving Group U and individual dwelling units and sleeping units in Groups R-2 and R-3, and where such units are not required to be Accessible units, Type A units or Type B units, the landing at an exterior doorway shall be not more than 73/4 inches (197 mm) below the landing on the egress side of the door. Such doors, including storm or screen doors, shall be permitted to swing over either landing." .

    ibc:ibc2021-ch10-list_item-0310 a ibco:ListItem ;
        ibco:bbox "[82.797, 643.792, 289.977, 667.415]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0311 ;
        ibco:sourcePage 317 ;
        ibco:text "4. Variations in elevation due to differences in finish materials, but not more than 1/2 inch (12.7 mm)." .

    ibc:ibc2021-ch10-list_item-0311 a ibco:ListItem ;
        ibco:bbox "[82.794, 668.769, 289.939, 734.853]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0312 ;
        ibco:sourcePage 317 ;
        ibco:text "5. Exterior decks, patios or balconies that are part of Type B dwelling units or sleeping units, that have impervious surfaces and that are not more than 4 inches (102 mm) below the finished floor level of the adjacent interior space of the dwelling unit or sleeping unit." .

    ibc:ibc2021-ch10-list_item-0312 a ibco:ListItem ;
        ibco:bbox "[343.795, 69.705, 550.794, 146.706]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0306 ;
        ibco:precedes ibc:ibc2021-1010.1.5 ;
        ibco:sourcePage 317 ;
        ibco:text "6. Doors serving equipment spaces not required to be accessible in accordance with Section 1103.2.9 and serving an occupant load of five or less shall be permitted to have a landing on one side to be not more than 7 inches (178 mm) above or below the landing on the egress side of the door." .

    ibc:ibc2021-ch10-list_item-0318 a ibco:ListItem ;
        ibco:bbox "[372.6, 456.836, 550.759, 478.778]" ;
        ibco:label "1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0317 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0319 ;
        ibco:sourcePage 317 ;
        ibco:text "1.1. The door is not part of the required means of egress." .

    ibc:ibc2021-ch10-list_item-0319 a ibco:ListItem ;
        ibco:bbox "[372.6, 482.752, 550.786, 504.813]" ;
        ibco:label "1.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0317 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0320 ;
        ibco:sourcePage 317 ;
        ibco:text "1.2. The door is not part of an accessible route as required by Chapter 11." .

    ibc:ibc2021-ch10-list_item-0320 a ibco:ListItem ;
        ibco:bbox "[372.59, 508.787, 550.899, 530.849]" ;
        ibco:label "1.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0317 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0321 ;
        ibco:sourcePage 317 ;
        ibco:text "1.3. The door is not part of an Accessible unit, Type A unit or Type B unit." .

    ibc:ibc2021-ch10-list_item-0321 a ibco:ListItem ;
        ibco:bbox "[343.796, 533.747, 550.804, 621.826]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0316 ;
        ibco:precedes ibc:ibc2021-1010.1.7 ;
        ibco:sourcePage 317 ;
        ibco:text "2. In Type B units, where Exception 5 to Section 1010.1.4 permits a 4-inch (102 mm) elevation change at the door, the threshold height on the exterior side of the door shall not exceed 43/4 inches (120 mm) in height above the exterior deck, patio or balcony for sliding doors or 41/2 inches (114 mm) above the exterior deck, patio or balcony for other doors." .

    ibc:ibc2021-ch10-list_item-0325 a ibco:ListItem ;
        ibco:bbox "[97.199, 69.725, 304.265, 113.738]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0324 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0326 ;
        ibco:sourcePage 318 ;
        ibco:text "2. Storm and screen doors serving individual dwelling units in Groups R-2 and R-3 need not be spaced 48 inches (1219 mm) from the other door." .

    ibc:ibc2021-ch10-list_item-0326 a ibco:ListItem ;
        ibco:bbox "[97.199, 116.756, 304.222, 149.733]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0324 ;
        ibco:precedes ibc:ibc2021-1010.2 ;
        ibco:sourcePage 318 ;
        ibco:text "3. Doors within individual dwelling units in Groups R-2 and R-3 other than within Type A dwelling units." .

    ibc:ibc2021-ch10-list_item-0330 a ibco:ListItem ;
        ibco:bbox "[97.209, 264.801, 239.879, 275.827]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0329 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0331 ;
        ibco:sourcePage 318 ;
        ibco:text "1. Places of detention or restraint." .

    ibc:ibc2021-ch10-list_item-0331 a ibco:ListItem ;
        ibco:bbox "[97.209, 278.725, 304.213, 300.787]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0329 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0332 ;
        ibco:sourcePage 318 ;
        ibco:text "2. Where manually operated bolt locks are permitted by Section 1010.2.5." .

    ibc:ibc2021-ch10-list_item-0332 a ibco:ListItem ;
        ibco:bbox "[97.209, 303.805, 304.143, 325.747]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0329 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0333 ;
        ibco:sourcePage 318 ;
        ibco:text "3. Doors with automatic flush bolts as permitted by Section 1010.2.4, Item 4." .

    ibc:ibc2021-ch10-list_item-0333 a ibco:ListItem ;
        ibco:bbox "[97.209, 328.765, 304.156, 361.742]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0329 ;
        ibco:precedes ibc:ibc2021-1010.2.2 ;
        ibco:sourcePage 318 ;
        ibco:text "4. Doors from individual dwelling units and sleeping units of Group R occupancies as permitted by Section 1010.2.4, Item 5." .

    ibc:ibc2021-ch10-list_item-0338 a ibco:ListItem ;
        ibco:bbox "[90.137, 612.724, 227.675, 623.75]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0339 ;
        ibco:sourcePage 318 ;
        ibco:text "1. Places of detention or restraint." .

    ibc:ibc2021-ch10-list_item-0339 a ibco:ListItem ;
        ibco:bbox "[90.137, 626.648, 304.295, 725.72]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0340 ;
        ibco:sourcePage 318 ;
        ibco:text "2. In Group I-1, Condition 2 and Group I-2 occupancies where the clinical needs of persons receiving care require containment or where persons receiving care pose a security threat, provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times." .

    ibc:ibc2021-ch10-list_item-0341 a ibco:ListItem ;
        ibco:bbox "[372.613, 138.558, 565.195, 160.62]" ;
        ibco:label "3.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0340 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0342 ;
        ibco:sourcePage 318 ;
        ibco:text "3.1. The locking device is readily distinguishable as locked." .

    ibc:ibc2021-ch10-list_item-0342 a ibco:ListItem ;
        ibco:bbox "[372.613, 163.638, 565.234, 240.638]" ;
        ibco:label "3.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0340 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0343 ;
        ibco:sourcePage 318 ;
        ibco:text "3.2. A readily visible durable sign is posted on the egress side on or adjacent to the door stating: THIS DOOR TO REMAIN UNLOCKED WHEN THIS SPACE IS OCCUPIED. The sign shall be in letters 1 inch (25 mm) high on a contrasting background." .

    ibc:ibc2021-ch10-list_item-0343 a ibco:ListItem ;
        ibco:bbox "[372.613, 243.656, 565.23, 276.634]" ;
        ibco:label "3.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0340 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0344 ;
        ibco:sourcePage 318 ;
        ibco:text "3.3. The use of the key-operated locking device is revocable by the building official for due cause." .

    ibc:ibc2021-ch10-list_item-0344 a ibco:ListItem ;
        ibco:bbox "[351.139, 279.652, 565.223, 334.581]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0345 ;
        ibco:sourcePage 318 ;
        ibco:text "4. Where egress doors are used in pairs, approved automatic flush bolts shall be permitted to be used, provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware." .

    ibc:ibc2021-ch10-list_item-0345 a ibco:ListItem ;
        ibco:bbox "[351.139, 337.599, 565.268, 403.564]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0346 ;
        ibco:sourcePage 318 ;
        ibco:text "5. Doors from individual dwelling or sleeping units of Group R occupancies having an occupant load of 10 or less are permitted to be equipped with a night latch, dead bolt or security chain, provided such devices are openable from the inside without the use of a key or tool." .

    ibc:ibc2021-ch10-list_item-0346 a ibco:ListItem ;
        ibco:bbox "[351.139, 406.582, 565.181, 439.56]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0347 ;
        ibco:sourcePage 318 ;
        ibco:text "6. Fire doors after the minimum elevated temperature has disabled the unlatching mechanism in accordance with listed fire door test procedures." .

    ibc:ibc2021-ch10-list_item-0347 a ibco:ListItem ;
        ibco:bbox "[351.139, 442.578, 565.282, 475.787]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-1010.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0348 ;
        ibco:sourcePage 318 ;
        ibco:text "7. Doors serving roofs not intended to be occupied shall be permitted to be locked preventing entry to the building from the roof." .

    ibc:ibc2021-ch10-list_item-0349 a ibco:ListItem ;
        ibco:bbox "[372.594, 547.787, 565.227, 613.753]" ;
        ibco:label "8.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0348 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0350 ;
        ibco:sourcePage 318 ;
        ibco:text "8.1. The maximum occupant load shall be posted where required by Section 1004.9. Such signage shall be permanently affixed inside the building and shall be posted in a conspicuous space near all the exit access doorways." .

    ibc:ibc2021-ch10-list_item-0350 a ibco:ListItem ;
        ibco:bbox "[372.584, 616.77, 565.212, 682.735]" ;
        ibco:label "8.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0348 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0351 ;
        ibco:sourcePage 318 ;
        ibco:text "8.2. A weatherproof telephone or two-way communication system installed in accordance with Sections 1009.8.1 and 1009.8.2 shall be located adjacent to not less than one required exit access door on the exterior side." .

    ibc:ibc2021-ch10-list_item-0352 a ibco:ListItem ;
        ibco:bbox "[97.199, 69.725, 289.861, 124.778]" ;
        ibco:label "8.4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0351 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0353 ;
        ibco:sourcePage 319 ;
        ibco:text "8.4. A clear window or glazed door opening, not less than 5 square feet (0.46 m2) in area, shall be provided at each exit access door to determine if there are occupants using the outdoor area." .

    ibc:ibc2021-ch10-list_item-0353 a ibco:ListItem ;
        ibco:bbox "[97.199, 127.796, 289.99, 226.749]" ;
        ibco:label "8.5" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0351 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0354 ;
        ibco:sourcePage 319 ;
        ibco:text "8.5. A readily visible, durable sign shall be posted on the interior side on or adjacent to each locked required exit access door serving the exterior area stating, \"THIS DOOR TO REMAIN UNLOCKED WHEN THE OUTDOOR AREA IS OCCUPIED.\" The letters on the sign shall be not less than 1 inch (25.4 mm) high on a contrasting background." .

    ibc:ibc2021-ch10-list_item-0354 a ibco:ListItem ;
        ibco:bbox "[97.199, 229.766, 289.758, 262.744]" ;
        ibco:label "8.6" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0351 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0355 ;
        ibco:sourcePage 319 ;
        ibco:text "8.6. The occupant load of the occupied exterior area shall not exceed 300 occupants in accordance with Section 1004." .

    ibc:ibc2021-ch10-list_item-0355 a ibco:ListItem ;
        ibco:bbox "[75.726, 265.762, 289.789, 298.739]" ;
        ibco:label "9" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0348 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0356 ;
        ibco:sourcePage 319 ;
        ibco:text "9. Locking devices are permitted on doors to balconies, decks or other exterior spaces serving individual dwelling or sleeping units." .

    ibc:ibc2021-ch10-list_item-0356 a ibco:ListItem ;
        ibco:bbox "[70.805, 301.757, 289.781, 345.826]" ;
        ibco:label "10" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0348 ;
        ibco:precedes ibc:ibc2021-1010.2.5 ;
        ibco:sourcePage 319 ;
        ibco:text "10. Locking devices are permitted on doors to balconies, decks or other exterior spaces of 250 square feet (23.23 m2) or less serving a private office space." .

    ibc:ibc2021-ch10-list_item-0359 a ibco:ListItem ;
        ibco:bbox "[82.797, 390.835, 289.803, 412.777]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0358 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0360 ;
        ibco:sourcePage 319 ;
        ibco:text "1. On doors not required for egress in individual dwelling units or sleeping units." .

    ibc:ibc2021-ch10-list_item-0360 a ibco:ListItem ;
        ibco:bbox "[82.797, 415.795, 289.766, 459.808]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0358 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0361 ;
        ibco:sourcePage 319 ;
        ibco:text "2. Where a pair of doors serves a storage or equipment room, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:ibc2021-ch10-list_item-0361 a ibco:ListItem ;
        ibco:bbox "[82.797, 462.826, 289.873, 539.827]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0358 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0362 ;
        ibco:sourcePage 319 ;
        ibco:text "3. Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:ibc2021-ch10-list_item-0362 a ibco:ListItem ;
        ibco:bbox "[82.797, 542.725, 289.838, 652.714]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0358 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0363 ;
        ibco:sourcePage 319 ;
        ibco:text "4. Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:ibc2021-ch10-list_item-0363 a ibco:ListItem ;
        ibco:bbox "[361.807, 69.625, 550.764, 91.687]",
            "[82.807, 655.731, 289.871, 721.697]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0358 ;
        ibco:precedes ibc:ibc2021-1010.2.6 ;
        ibco:sourcePage 319 ;
        ibco:text "5. Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:ibc2021-ch10-list_item-0367 a ibco:ListItem ;
        ibco:bbox "[343.809, 173.648, 550.798, 206.625]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0366 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0368 ;
        ibco:sourcePage 319 ;
        ibco:text "1. Stairway discharge doors shall be openable from the egress side and shall only be locked from the opposite side." .

    ibc:ibc2021-ch10-list_item-0368 a ibco:ListItem ;
        ibco:bbox "[343.809, 209.643, 550.797, 231.704]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0366 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0369 ;
        ibco:sourcePage 319 ;
        ibco:text "2. This section shall not apply to doors arranged in accordance with Section 403.5.3." .

    ibc:ibc2021-ch10-list_item-0369 a ibco:ListItem ;
        ibco:bbox "[343.809, 234.722, 550.787, 322.639]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0366 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0370 ;
        ibco:sourcePage 319 ;
        ibco:text "3. Stairway exit doors are permitted to be locked from the side opposite the egress side, provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building." .

    ibc:ibc2021-ch10-list_item-0370 a ibco:ListItem ;
        ibco:bbox "[343.809, 325.657, 550.884, 391.622]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0366 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0371 ;
        ibco:sourcePage 319 ;
        ibco:text "4. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group B, F, M and S occupancies where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:ibc2021-ch10-list_item-0371 a ibco:ListItem ;
        ibco:bbox "[343.809, 394.64, 550.846, 460.605]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0366 ;
        ibco:precedes ibc:ibc2021-1010.2.8 ;
        ibco:sourcePage 319 ;
        ibco:text "5. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group R-2 occupancies where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:ibc2021-ch10-list_item-0373 a ibco:ListItem ;
        ibco:bbox "[331.801, 545.761, 550.797, 578.858]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0374 ;
        ibco:sourcePage 319 ;
        ibco:text "1. The door shall be capable of being unlocked from outside the room with a key or other approved means." .

    ibc:ibc2021-ch10-list_item-0374 a ibco:ListItem ;
        ibco:bbox "[331.801, 581.756, 550.769, 603.818]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0375 ;
        ibco:sourcePage 319 ;
        ibco:text "2. The door shall be openable from within the room in accordance with Section 1010.2." .

    ibc:ibc2021-ch10-list_item-0375 a ibco:ListItem ;
        ibco:bbox "[331.801, 606.835, 550.781, 628.777]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0376 ;
        ibco:sourcePage 319 ;
        ibco:text "3. Modifications shall not be made to listed panic hardware, fire door hardware or door closers." .

    ibc:ibc2021-ch10-list_item-0376 a ibco:ListItem ;
        ibco:bbox "[319.799, 631.795, 550.892, 690.808]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.8 ;
        ibco:precedes ibc:ibc2021-1010.2.9 ;
        ibco:sourcePage 319 ;
        ibco:text "4. Modifications to fire door assemblies shall be in accordance with NFPA 80. Remote locking or unlocking of doors from an approved location shall be permitted in addition to the unlocking operation in Item 1." .

    ibc:ibc2021-ch10-list_item-0379 a ibco:ListItem ;
        ibco:bbox "[97.213, 121.796, 304.229, 154.773]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0378 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0380 ;
        ibco:sourcePage 320 ;
        ibco:text "1. A main exit of a Group A occupancy shall be permitted to have locking devices in accordance with Section 1010.2.4, Item 3." .

    ibc:ibc2021-ch10-list_item-0380 a ibco:ListItem ;
        ibco:bbox "[97.213, 157.791, 304.253, 212.721]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0378 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0381 ;
        ibco:sourcePage 320 ;
        ibco:text "2. Doors provided with panic hardware or fire exit hardware and serving a Group A or E occupancy shall be permitted to be electrically locked in accordance with Section 1010.2.11 or 1010.2.12." .

    ibc:ibc2021-ch10-list_item-0381 a ibco:ListItem ;
        ibco:bbox "[97.213, 215.738, 304.186, 248.836]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0378 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0382 ;
        ibco:sourcePage 320 ;
        ibco:text "3. Exit access doors serving occupied exterior areas shall be permitted to be locked in accordance with Section 1010.2.4, Item 8." .

    ibc:ibc2021-ch10-list_item-0382 a ibco:ListItem ;
        ibco:bbox "[39.599, 251.734, 304.215, 280.011]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0378 ;
        ibco:precedes ibc:ibc2021-1010.2.9.1 ;
        ibco:sourcePage 320 ;
        ibco:text "4. Courtrooms shall be permitted to be locked in accordance with Section 1010.2.13, Item 3. " .

    ibc:ibc2021-ch10-list_item-0386 a ibco:ListItem ;
        ibco:bbox "[97.198, 520.737, 304.308, 542.799]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.9.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0387 ;
        ibco:sourcePage 320 ;
        ibco:text "1. Panic hardware shall be listed in accordance with UL 305." .

    ibc:ibc2021-ch10-list_item-0387 a ibco:ListItem ;
        ibco:bbox "[97.198, 545.697, 304.168, 567.758]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.9.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0388 ;
        ibco:sourcePage 320 ;
        ibco:text "2. Fire exit hardware shall be listed in accordance with UL 10C and UL 305." .

    ibc:ibc2021-ch10-list_item-0388 a ibco:ListItem ;
        ibco:bbox "[97.198, 570.776, 304.215, 603.754]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.9.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0389 ;
        ibco:sourcePage 320 ;
        ibco:text "3. The actuating portion of the releasing device shall extend not less than one-half of the door leaf width." .

    ibc:ibc2021-ch10-list_item-0389 a ibco:ListItem ;
        ibco:bbox "[97.198, 606.772, 304.231, 628.714]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.9.3 ;
        ibco:precedes ibc:ibc2021-1010.2.9.4 ;
        ibco:sourcePage 320 ;
        ibco:text "4. The maximum unlatching force shall not exceed 15 pounds (67 N)." .

    ibc:ibc2021-ch10-list_item-0393 a ibco:ListItem ;
        ibco:bbox "[346.198, 165.593, 565.191, 198.691]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0394 ;
        ibco:sourcePage 320 ;
        ibco:text "1. The door hardware that is affixed to the door leaf has an obvious method of operation that is readily operated under all lighting conditions." .

    ibc:ibc2021-ch10-list_item-0394 a ibco:ListItem ;
        ibco:bbox "[346.198, 201.589, 565.222, 234.686]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0395 ;
        ibco:sourcePage 320 ;
        ibco:text "2. The door hardware is capable of being operated with one hand and shall comply with Section 1010.2.1." .

    ibc:ibc2021-ch10-list_item-0395 a ibco:ListItem ;
        ibco:bbox "[346.198, 237.704, 565.275, 270.682]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0396 ;
        ibco:sourcePage 320 ;
        ibco:text "3. Operation of the door hardware directly interrupts the power to the electric lock and unlocks the door immediately." .

    ibc:ibc2021-ch10-list_item-0396 a ibco:ListItem ;
        ibco:bbox "[346.198, 273.699, 565.186, 295.641]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0397 ;
        ibco:sourcePage 320 ;
        ibco:text "4. Loss of power to the electric locking system automatically unlocks the door." .

    ibc:ibc2021-ch10-list_item-0397 a ibco:ListItem ;
        ibco:bbox "[346.198, 298.659, 565.262, 331.637]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0398 ;
        ibco:sourcePage 320 ;
        ibco:text "5. Where panic or fire exit hardware is required by Section 1010.2.9, operation of the panic or fire exit hardware also releases the electric lock." .

    ibc:ibc2021-ch10-list_item-0398 a ibco:ListItem ;
        ibco:bbox "[346.189, 334.655, 565.167, 356.716]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1010.2.11 ;
        ibco:precedes ibc:ibc2021-1010.2.12 ;
        ibco:sourcePage 320 ;
        ibco:text "6. The locking system units shall be listed in accordance with UL 294." .

    ibc:ibc2021-ch10-list_item-0400 a ibco:ListItem ;
        ibco:bbox "[346.204, 419.756, 565.227, 463.77]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0401 ;
        ibco:sourcePage 320 ;
        ibco:text "1. The sensor shall be installed on the egress side, arranged to detect an occupant approaching the doors, and shall cause the electric locking system to unlock." .

    ibc:ibc2021-ch10-list_item-0401 a ibco:ListItem ;
        ibco:bbox "[346.204, 466.787, 565.254, 488.849]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0402 ;
        ibco:sourcePage 320 ;
        ibco:text "2. The electric locks shall be arranged to unlock by a signal from or loss of power to the sensor." .

    ibc:ibc2021-ch10-list_item-0402 a ibco:ListItem ;
        ibco:bbox "[346.204, 491.747, 565.185, 513.809]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0403 ;
        ibco:sourcePage 320 ;
        ibco:text "3. Loss of power to the lock or locking system shall automatically unlock the electric locks." .

    ibc:ibc2021-ch10-list_item-0403 a ibco:ListItem ;
        ibco:bbox "[346.204, 516.826, 565.253, 648.767]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0404 ;
        ibco:sourcePage 320 ;
        ibco:text "4. The doors shall be arranged to unlock from a manual unlocking device located 40 inches to 48 inches (1016 mm to 1219 mm) vertically above the floor and within 5 feet (1524 mm) of the secured doors. Ready access shall be provided to the manual unlocking device and the device shall be clearly identified by a sign that reads “PUSH TO EXIT.” When operated, the manual unlocking device shall result in direct interruption of power to the electric lock—independent of other electronics—and the electric lock shall remain unlocked for not less than 30 seconds." .

    ibc:ibc2021-ch10-list_item-0404 a ibco:ListItem ;
        ibco:bbox "[346.204, 651.784, 565.251, 706.714]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0405 ;
        ibco:sourcePage 320 ;
        ibco:text "5. Activation of the building fire alarm system, where provided, shall automatically unlock the electric lock, and the electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:ibc2021-ch10-list_item-0405 a ibco:ListItem ;
        ibco:bbox "[346.194, 709.732, 565.361, 731.793]",
            "[88.559, 69.725, 289.809, 102.822]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0406 ;
        ibco:sourcePage 320,
            321 ;
        ibco:text "6. Activation of the building automatic sprinkler system or fire detection system, where provided, shall automatically unlock the electric lock. The electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:ibc2021-ch10-list_item-0406 a ibco:ListItem ;
        ibco:bbox "[70.8, 105.72, 289.851, 127.782]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0407 ;
        ibco:sourcePage 321 ;
        ibco:text "7. Emergency lighting shall be provided on the egress side of the door." .

    ibc:ibc2021-ch10-list_item-0407 a ibco:ListItem ;
        ibco:bbox "[70.8, 130.8, 289.74, 152.741]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-1010.2.12 ;
        ibco:precedes ibc:ibc2021-1010.2.13 ;
        ibco:sourcePage 321 ;
        ibco:text "8. The door locking system units shall be listed in accordance with UL 294." .

    ibc:ibc2021-ch10-list_item-0409 a ibco:ListItem ;
        ibco:bbox "[70.79, 237.81, 258.638, 248.836]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.13 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0410 ;
        ibco:sourcePage 321 ;
        ibco:text "1. Group B, F, I, M, R, S and U occupancies." .

    ibc:ibc2021-ch10-list_item-0410 a ibco:ListItem ;
        ibco:bbox "[70.79, 251.734, 289.689, 273.795]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.13 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0411 ;
        ibco:sourcePage 321 ;
        ibco:text "2. Group E classrooms with an occupant load of less than 50." .

    ibc:ibc2021-ch10-list_item-0412 a ibco:ListItem ;
        ibco:bbox "[88.559, 342.788, 128.499, 353.814]" ;
        ibco:label "903.3.1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0411 ;
        ibco:precedes ibc:ibc2021-1010.2.13.1 ;
        ibco:sourcePage 321 ;
        ibco:text "903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0414 a ibco:ListItem ;
        ibco:bbox "[82.802, 394.74, 289.852, 449.788]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0415 ;
        ibco:sourcePage 321 ;
        ibco:text "1. The delay electronics of the delayed egress locking system shall deactivate upon actuation of the automatic sprinkler system or automatic fire detection system, allowing immediate free egress." .

    ibc:ibc2021-ch10-list_item-0415 a ibco:ListItem ;
        ibco:bbox "[82.812, 452.687, 289.858, 496.7]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0416 ;
        ibco:sourcePage 321 ;
        ibco:text "2. The delay electronics of the delayed egress locking system shall deactivate upon loss of power controlling the lock or lock mechanism, allowing immediate free egress." .

    ibc:ibc2021-ch10-list_item-0416 a ibco:ListItem ;
        ibco:bbox "[82.812, 499.718, 289.794, 532.696]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0417 ;
        ibco:sourcePage 321 ;
        ibco:text "3. The delayed egress locking system shall have the capability of being deactivated at the fire command center and other approved locations." .

    ibc:ibc2021-ch10-list_item-0417 a ibco:ListItem ;
        ibco:bbox "[82.812, 535.713, 289.826, 645.702]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0418 ;
        ibco:sourcePage 321 ;
        ibco:text "4. An attempt to egress shall initiate an irreversible process that shall allow such egress in not more than 15 seconds when a physical effort to exit is applied to the egress side door hardware for not more than 3 seconds. Initiation of the irreversible process shall activate an audible signal in the vicinity of the door. Once the delay electronics have been deactivated, rearming the delay electronics shall be by manual means only." .

    ibc:ibc2021-ch10-list_item-0419 a ibco:ListItem ;
        ibco:bbox "[343.804, 69.585, 550.863, 102.682]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0418 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0420 ;
        ibco:sourcePage 321 ;
        ibco:text "5. The egress path from any point shall not pass through more than one delayed egress locking system." .

    ibc:ibc2021-ch10-list_item-0421 a ibco:ListItem ;
        ibco:bbox "[394.202, 121.656, 550.867, 209.573]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0420 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0422 ;
        ibco:sourcePage 321 ;
        ibco:text "1. In Group I-1, Condition 2, Group I-2 or I-3 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided that the combined delay does not exceed 30 seconds." .

    ibc:ibc2021-ch10-list_item-0422 a ibco:ListItem ;
        ibco:bbox "[394.202, 212.591, 550.957, 333.615]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0420 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0423 ;
        ibco:sourcePage 321 ;
        ibco:text "2. In Group I-1, Condition 1 or Group I-4 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided the combined delay does not exceed 30 seconds and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0423 a ibco:ListItem ;
        ibco:bbox "[343.804, 336.633, 550.793, 369.631]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0420 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0424 ;
        ibco:sourcePage 321 ;
        ibco:text "6. A sign shall be provided on the door and shall be located above and within 12 inches (305 mm) of the door exit hardware:" .

    ibc:ibc2021-ch10-list_item-0425 a ibco:ListItem ;
        ibco:bbox "[379.797, 443.744, 550.792, 498.793]" ;
        ibco:label "6.1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0424 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0426 ;
        ibco:sourcePage 321 ;
        ibco:text "6.1. For doors that swing in the direction of egress, the sign shall read, \"PUSH UNTIL ALARM SOUNDS. DOOR CAN BE OPENED IN 15 [30] SECONDS.\"" .

    ibc:ibc2021-ch10-list_item-0426 a ibco:ListItem ;
        ibco:bbox "[379.797, 501.81, 550.811, 556.74]" ;
        ibco:label "6.2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0424 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0427 ;
        ibco:sourcePage 321 ;
        ibco:text "6.2. For doors that swing in the opposite direction of egress, the sign shall read, \"PULL UNTIL ALARM SOUNDS. DOOR CAN BE OPENED IN 15 [30] SECONDS.\"" .

    ibc:ibc2021-ch10-list_item-0427 a ibco:ListItem ;
        ibco:bbox "[379.797, 559.758, 550.847, 592.735]" ;
        ibco:label "6.3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0424 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0428 ;
        ibco:sourcePage 321 ;
        ibco:text "6.3. The sign shall comply with the visual character requirements in ICC A117.1." .

    ibc:ibc2021-ch10-list_item-0428 a ibco:ListItem ;
        ibco:bbox "[343.801, 595.753, 550.841, 617.815]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0424 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0429 ;
        ibco:sourcePage 321 ;
        ibco:text "7. Emergency lighting shall be provided on the egress side of the door." .

    ibc:ibc2021-ch10-list_item-0429 a ibco:ListItem ;
        ibco:bbox "[343.801, 620.713, 550.824, 642.774]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0424 ;
        ibco:precedes ibc:ibc2021-1010.2.14 ;
        ibco:sourcePage 321 ;
        ibco:text "8. The delayed egress locking system units shall be listed in accordance with UL 294." .

    ibc:ibc2021-ch10-list_item-0432 a ibco:ListItem ;
        ibco:bbox "[85.211, 216.675, 304.197, 249.772]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0433 ;
        ibco:sourcePage 322 ;
        ibco:text "1. The door locks shall unlock on actuation of the automatic sprinkler system or automatic smoke detection system." .

    ibc:ibc2021-ch10-list_item-0433 a ibco:ListItem ;
        ibco:bbox "[85.191, 252.79, 304.174, 274.732]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0434 ;
        ibco:sourcePage 322 ;
        ibco:text "2. The door locks shall unlock on loss of power controlling the lock or lock mechanism." .

    ibc:ibc2021-ch10-list_item-0434 a ibco:ListItem ;
        ibco:bbox "[85.191, 277.749, 304.23, 332.798]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0435 ;
        ibco:sourcePage 322 ;
        ibco:text "3. The door locking system shall be installed to have the capability of being unlocked by a switch located at the fire command center, a nursing station or other approved location. The switch shall directly break power to the lock." .

    ibc:ibc2021-ch10-list_item-0435 a ibco:ListItem ;
        ibco:bbox "[85.191, 335.697, 304.22, 379.71]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0436 ;
        ibco:sourcePage 322 ;
        ibco:text "4. A building occupant shall not be required to pass through more than one door equipped with a controlled egress locking system before entering an exit." .

    ibc:ibc2021-ch10-list_item-0436 a ibco:ListItem ;
        ibco:bbox "[85.191, 382.728, 304.248, 426.741]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0437 ;
        ibco:sourcePage 322 ;
        ibco:text "5. The procedures for unlocking the doors shall be described and approved as part of the emergency planning and preparedness required by Chapter 4 of the International Fire Code." .

    ibc:ibc2021-ch10-list_item-0437 a ibco:ListItem ;
        ibco:bbox "[85.191, 429.759, 304.199, 462.737]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0438 ;
        ibco:sourcePage 322 ;
        ibco:text "6. All clinical staff shall have the keys, codes or other means necessary to operate the locking systems." .

    ibc:ibc2021-ch10-list_item-0438 a ibco:ListItem ;
        ibco:bbox "[85.191, 465.754, 301.19, 476.78]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0439 ;
        ibco:sourcePage 322 ;
        ibco:text "7. Emergency lighting shall be provided at the door." .

    ibc:ibc2021-ch10-list_item-0439 a ibco:ListItem ;
        ibco:bbox "[85.191, 479.678, 304.131, 501.74]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0431 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0440 ;
        ibco:sourcePage 322 ;
        ibco:text "8. The door locking system units shall be listed in accordance with UL 294." .

    ibc:ibc2021-ch10-list_item-0441 a ibco:ListItem ;
        ibco:bbox "[125.987, 520.714, 304.199, 586.679]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0440 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0442 ;
        ibco:sourcePage 322 ;
        ibco:text "1. Items 1 through 4 shall not apply to doors to areas occupied by persons who, because of clinical needs, require restraint or containment as part of the function of a psychiatric or cognitive treatment area." .

    ibc:ibc2021-ch10-list_item-0442 a ibco:ListItem ;
        ibco:bbox "[125.987, 590.653, 304.182, 656.737]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0440 ;
        ibco:precedes ibc:ibc2021-1010.2.15 ;
        ibco:sourcePage 322 ;
        ibco:text "2. Items 1 through 4 shall not apply to doors to areas where a listed egress control system is utilized to reduce the risk of child abduction from nursery and obstetric areas of a Group I-2 hospital." .

    ibc:ibc2021-ch10-list_item-0444 a ibco:ListItem ;
        ibco:bbox "[346.203, 95.601, 565.319, 117.662]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.2.15 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0445 ;
        ibco:sourcePage 322 ;
        ibco:text "1. Activation of an automatic sprinkler system installed in accordance with Section 903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0445 a ibco:ListItem ;
        ibco:bbox "[346.213, 120.561, 563.859, 131.586]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.2.15 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0446 ;
        ibco:sourcePage 322 ;
        ibco:text "2. Activation of an approved manual fire alarm box." .

    ibc:ibc2021-ch10-list_item-0446 a ibco:ListItem ;
        ibco:bbox "[346.213, 134.604, 544.666, 145.63]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.15 ;
        ibco:precedes ibc:ibc2021-1010.3 ;
        ibco:sourcePage 322 ;
        ibco:text "3. A signal from a constantly attended location." .

    ibc:ibc2021-ch10-list_item-0449 a ibco:ListItem ;
        ibco:bbox "[346.203, 212.752, 565.224, 245.849]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0450 ;
        ibco:sourcePage 322 ;
        ibco:text "1. Revolving doors shall comply with BHMA A156.27 and shall be installed in accordance with the manufacturer’s instructions." .

    ibc:ibc2021-ch10-list_item-0450 a ibco:ListItem ;
        ibco:bbox "[346.203, 248.747, 565.224, 292.761]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0451 ;
        ibco:sourcePage 322 ;
        ibco:text "2. Each revolving door shall be capable of breakout in accordance with BHMA A156.27 and shall provide an aggregate width of not less than 36 inches (914 mm)." .

    ibc:ibc2021-ch10-list_item-0451 a ibco:ListItem ;
        ibco:bbox "[346.203, 295.778, 565.276, 350.827]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0452 ;
        ibco:sourcePage 322 ;
        ibco:text "3. A revolving door shall not be located within 10 feet (3048 mm) of the foot or top of stairways or escalators. A dispersal area shall be provided between the stairways or escalators and the revolving doors." .

    ibc:ibc2021-ch10-list_item-0452 a ibco:ListItem ;
        ibco:bbox "[346.203, 353.726, 565.246, 419.81]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0453 ;
        ibco:sourcePage 322 ;
        ibco:text "4. The revolutions per minute (rpm) for a revolving door shall not exceed the maximum rpm as specified in BHMA A156.27. Manual revolving doors shall comply with Table 1010.3.1(1). Automatic or power-operated revolving doors shall comply with Table 1010.3.1(2)." .

    ibc:ibc2021-ch10-list_item-0453 a ibco:ListItem ;
        ibco:bbox "[346.203, 422.709, 565.268, 510.745]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0454 ;
        ibco:sourcePage 322 ;
        ibco:text "5. An emergency stop switch shall be provided near each entry point of power or automatic operated revolving doors within 48 inches (1219 mm) of the door and between 34 inches (864 mm) and 48 inches (1219 mm) above the floor. The activation area of the emergency stop switch button shall be not less than 1 inch (25 mm) in diameter and shall be red." .

    ibc:ibc2021-ch10-list_item-0454 a ibco:ListItem ;
        ibco:bbox "[346.203, 513.763, 565.182, 557.776]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0455 ;
        ibco:sourcePage 322 ;
        ibco:text "6. Each revolving door shall have a side-hinged swinging door that complies with Section 1010.1 in the same wall and within 10 feet (3048 mm) of the revolving door." .

    ibc:ibc2021-ch10-list_item-0455 a ibco:ListItem ;
        ibco:bbox "[322.202, 560.675, 565.184, 725.067]",
            "[46.794, 70.112, 289.731, 309.026]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-1010.3.1.1 ;
        ibco:sourcePage 322,
            323 ;
        ibco:text "7. Revolving doors shall not be part of an accessible route required by Section 1009 and Chapter 11. TABLE 1010.3.1(1) MAXIMUM DOOR SPEED MANUAL REVOLVING DOORS For SI: 1 inch = 25.4 mm, 1 foot = 304.8 mm. TABLE 1010.3.1(2) MAXIMUM DOOR SPEED AUTOMATIC OR POWER-OPERATED REVOLVING DOORS For SI: 1 inch = 25.4 mm, 1 foot = 304.8 mm." .

    ibc:ibc2021-ch10-list_item-0457 a ibco:ListItem ;
        ibco:bbox "[82.811, 349.796, 289.808, 382.774]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.3.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0458 ;
        ibco:sourcePage 323 ;
        ibco:text "1. Revolving doors shall not be given credit for more than 50 percent of the minimum width or required capacity." .

    ibc:ibc2021-ch10-list_item-0458 a ibco:ListItem ;
        ibco:bbox "[82.811, 385.792, 289.829, 418.769]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.3.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0459 ;
        ibco:sourcePage 323 ;
        ibco:text "2. Each revolving door shall be credited with a capacity based on not more than a 50-person occupant load." .

    ibc:ibc2021-ch10-list_item-0459 a ibco:ListItem ;
        ibco:bbox "[82.811, 421.787, 289.817, 465.8]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.3.1.1 ;
        ibco:precedes ibc:ibc2021-1010.3.1.2 ;
        ibco:sourcePage 323 ;
        ibco:text "3. Each revolving door shall provide for egress in accordance with BHMA A156.27 with a breakout force of not more than 130 pounds (578 N)." .

    ibc:ibc2021-ch10-list_item-0462 a ibco:ListItem ;
        ibco:bbox "[97.213, 598.737, 289.765, 631.714]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0461 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0463 ;
        ibco:sourcePage 323 ;
        ibco:text "1. There is a power failure or power is removed to the device holding the door wings in position." .

    ibc:ibc2021-ch10-list_item-0463 a ibco:ListItem ;
        ibco:bbox "[97.213, 634.732, 289.821, 667.71]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0461 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0464 ;
        ibco:sourcePage 323 ;
        ibco:text "2. There is an actuation of the automatic sprinkler system where such system is provided." .

    ibc:ibc2021-ch10-list_item-0464 a ibco:ListItem ;
        ibco:bbox "[97.203, 670.727, 289.809, 725.776]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0461 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0465 ;
        ibco:sourcePage 323 ;
        ibco:text "3. There is an actuation of a smoke detection system that is installed in accordance with Section 907 to provide coverage in areas within the building that are within 75 feet (22 860 mm) of the revolving doors." .

    ibc:ibc2021-ch10-list_item-0465 a ibco:ListItem ;
        ibco:bbox "[358.205, 69.631, 550.798, 113.645]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0461 ;
        ibco:precedes ibc:ibc2021-1010.3.2 ;
        ibco:sourcePage 323 ;
        ibco:text "4. There is an actuation of a manual control switch, in an approved location and clearly identified, that reduces the breakout force to not more than 130 pounds (578 N)." .

    ibc:ibc2021-ch10-list_item-0468 a ibco:ListItem ;
        ibco:bbox "[343.813, 345.663, 467.883, 356.689]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0467 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0469 ;
        ibco:sourcePage 323 ;
        ibco:text "1. Occupancies in Group I-3." .

    ibc:ibc2021-ch10-list_item-0469 a ibco:ListItem ;
        ibco:bbox "[343.813, 359.587, 550.863, 392.684]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0467 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0470 ;
        ibco:sourcePage 323 ;
        ibco:text "2. Special purpose horizontal sliding, accordion or folding doors complying with Section 1010.3.3." .

    ibc:ibc2021-ch10-list_item-0470 a ibco:ListItem ;
        ibco:bbox "[343.813, 395.583, 550.832, 483.818]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0467 ;
        ibco:precedes ibc:ibc2021-1010.3.3 ;
        ibco:sourcePage 323 ;
        ibco:text "3. For a biparting door in the emergency breakout mode, a door leaf located within a multiple-leaf opening shall be exempt from the minimum 32-inch (813 mm) single-leaf requirement of Section 1010.1.1, provided that a minimum 32inch (813 mm) clear opening is provided when the two biparting leaves meeting in the center are broken out." .

    ibc:ibc2021-ch10-list_item-0472 a ibco:ListItem ;
        ibco:bbox "[331.8, 557.731, 550.864, 590.828]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0473 ;
        ibco:sourcePage 323 ;
        ibco:text "1. The doors shall be power operated and shall be capable of being operated manually in the event of power failure." .

    ibc:ibc2021-ch10-list_item-0473 a ibco:ListItem ;
        ibco:bbox "[331.8, 593.727, 550.778, 626.824]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0474 ;
        ibco:sourcePage 323 ;
        ibco:text "2. The doors shall be openable by a simple method without special knowledge or effort from the egress side or sides." .

    ibc:ibc2021-ch10-list_item-0474 a ibco:ListItem ;
        ibco:bbox "[331.8, 629.722, 550.852, 673.735]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.3.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0475 ;
        ibco:sourcePage 323 ;
        ibco:text "3. The force required to operate the door shall not exceed 30 pounds (133 N) to set the door in motion and 15 pounds (67 N) to close the door or open it to the minimum required width." .

    ibc:ibc2021-ch10-list_item-0476 a ibco:ListItem ;
        ibco:bbox "[85.199, 69.725, 304.339, 135.809]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0475 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0477 ;
        ibco:sourcePage 324 ;
        ibco:text "5. The door assembly shall comply with the applicable fire protection rating and, where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716.2.6.6, shall be installed in accordance with NFPA 80 and shall comply with Section 716." .

    ibc:ibc2021-ch10-list_item-0477 a ibco:ListItem ;
        ibco:bbox "[85.209, 138.708, 304.19, 160.769]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0475 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0478 ;
        ibco:sourcePage 324 ;
        ibco:text "6. The door assembly shall have an integrated standby power supply." .

    ibc:ibc2021-ch10-list_item-0478 a ibco:ListItem ;
        ibco:bbox "[85.209, 163.787, 304.226, 185.729]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0475 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0479 ;
        ibco:sourcePage 324 ;
        ibco:text "7. The door assembly power supply shall be electrically supervised." .

    ibc:ibc2021-ch10-list_item-0479 a ibco:ListItem ;
        ibco:bbox "[85.209, 188.747, 304.187, 221.724]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0475 ;
        ibco:precedes ibc:ibc2021-1010.3.4 ;
        ibco:sourcePage 324 ;
        ibco:text "8. The door shall open to the minimum required width within 10 seconds after activation of the operating device." .

    ibc:ibc2021-ch10-list_item-0486 a ibco:ListItem ;
        ibco:bbox "[85.199, 634.656, 304.146, 667.634]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.5.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0487 ;
        ibco:sourcePage 324 ;
        ibco:text "1. Each device shall turn free in the direction of egress travel when primary power is lost and on the manual release by an employee in the area." .

    ibc:ibc2021-ch10-list_item-0487 a ibco:ListItem ;
        ibco:bbox "[85.199, 670.651, 304.133, 692.713]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.5.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0488 ;
        ibco:sourcePage 324 ;
        ibco:text "2. Such devices are not given credit for more than 50 percent of the required egress capacity or width." .

    ibc:ibc2021-ch10-list_item-0488 a ibco:ListItem ;
        ibco:bbox "[363.924, 69.293, 565.121, 82.415]",
            "[85.199, 695.611, 304.161, 717.673]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.5.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0489 ;
        ibco:sourcePage 324 ;
        ibco:text "3. Each device is not more than 39 inches (991 mm) high. Each device has not less than 161/2 inches (419" .

    ibc:ibc2021-ch10-list_item-0489 a ibco:ListItem ;
        ibco:bbox "[346.201, 69.565, 565.23, 124.774]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.5.1 ;
        ibco:precedes ibc:ibc2021-1010.5.1.1 ;
        ibco:sourcePage 324 ;
        ibco:text "4. mm) clear width at and below a height of 39 inches (991 mm) and not less than 22 inches (559 mm) clear width at heights above 39 inches (991 mm)." .

    ibc:ibc2021-ch10-list_item-0492 a ibco:ListItem ;
        ibco:bbox "[346.198, 268.746, 565.19, 301.723]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0493 ;
        ibco:sourcePage 324 ;
        ibco:text "1. The building is protected throughout by an approved, supervised automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0493 a ibco:ListItem ;
        ibco:bbox "[346.198, 304.741, 565.257, 337.719]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0494 ;
        ibco:sourcePage 324 ;
        ibco:text "2. Each security access turnstile lane configuration has a minimum clear passage width of 22 inches (559 mm)." .

    ibc:ibc2021-ch10-list_item-0494 a ibco:ListItem ;
        ibco:bbox "[346.198, 340.737, 565.238, 384.75]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0495 ;
        ibco:sourcePage 324 ;
        ibco:text "3. Any security access turnstile lane configuration providing a clear passage width of less than 32 inches (810 mm) shall be credited with a maximum egress capacity of 50 persons." .

    ibc:ibc2021-ch10-list_item-0495 a ibco:ListItem ;
        ibco:bbox "[346.198, 387.768, 565.242, 442.697]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0496 ;
        ibco:sourcePage 324 ;
        ibco:text "4. Any security access turnstile lane configuration providing a clear passage width of 32 inches (810 mm) or more shall be credited with a maximum egress capacity as calculated in accordance with Section 1005." .

    ibc:ibc2021-ch10-list_item-0497 a ibco:ListItem ;
        ibco:bbox "[372.592, 492.746, 565.177, 525.724]" ;
        ibco:label "5.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0496 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0498 ;
        ibco:sourcePage 324 ;
        ibco:text "5.1. Upon loss of power to the turnstile or any part of the access control system that secures the physical barrier." .

    ibc:ibc2021-ch10-list_item-0499 a ibco:ListItem ;
        ibco:bbox "[408.597, 619.676, 565.146, 641.738]" ;
        ibco:label "5.2.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0498 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0500 ;
        ibco:sourcePage 324 ;
        ibco:text "5.2.1. On the egress side of each security access turnstile lane." .

    ibc:ibc2021-ch10-list_item-0500 a ibco:ListItem ;
        ibco:bbox "[408.597, 644.636, 565.25, 699.685]" ;
        ibco:label "5.2.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0498 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0501 ;
        ibco:sourcePage 324 ;
        ibco:text "5.2.2. At an approved location where it can be actuated by an employee assigned to the area at all times that the building is occupied." .

    ibc:ibc2021-ch10-list_item-0501 a ibco:ListItem ;
        ibco:bbox "[118.799, 69.725, 289.75, 102.822]",
            "[372.592, 702.703, 565.211, 724.645]" ;
        ibco:label "5.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0496 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0502 ;
        ibco:sourcePage 324,
            325 ;
        ibco:text "5.3. Upon actuation of the building fire alarm system, if provided, after which the physical barrier remains in the open position until the fire alarm system is manually reset." .

    ibc:ibc2021-ch10-list_item-0503 a ibco:ListItem ;
        ibco:bbox "[97.196, 133.07, 289.801, 188.119]" ;
        ibco:label "5.4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0502 ;
        ibco:precedes ibc:ibc2021-1010.5.3 ;
        ibco:sourcePage 325 ;
        ibco:text "5.4. Upon actuation of the building automatic sprinkler system or fire detection system, after which the physical barrier remains in the open position until the fire alarm system is manually reset." .

    ibc:ibc2021-ch10-list_item-0512 a ibco:ListItem ;
        ibco:bbox "[70.792, 539.289, 289.755, 572.267]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0511 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0513 ;
        ibco:sourcePage 325 ;
        ibco:text "1. Stairways serving an occupant load of less than 50 shall have a width of not less than 36 inches (914 mm)." .

    ibc:ibc2021-ch10-list_item-0513 a ibco:ListItem ;
        ibco:bbox "[70.792, 575.404, 289.768, 597.465]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0511 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0514 ;
        ibco:sourcePage 325 ;
        ibco:text "2. Spiral stairways as provided for in Section 1011.10." .

    ibc:ibc2021-ch10-list_item-0514 a ibco:ListItem ;
        ibco:bbox "[70.792, 600.483, 289.811, 688.52]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0511 ;
        ibco:precedes ibc:ibc2021-1011.3 ;
        ibco:sourcePage 325 ;
        ibco:text "3. Where an incline platform lift or stairway chairlift is installed on stairways serving occupancies in Group R-3, or within dwelling units in occupancies in Group R-2, a clear passage width not less than 20 inches (508 mm) shall be provided. Where the seat and platform can be folded when not in use, the distance shall be measured from the folded position." .

    ibc:ibc2021-ch10-list_item-0517 a ibco:ListItem ;
        ibco:bbox "[331.794, 123.419, 550.824, 156.407]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0516 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0518 ;
        ibco:sourcePage 325 ;
        ibco:text "1. Spiral stairways complying with Section 1011.10 are permitted a 78-inch (1981 mm) headroom clearance." .

    ibc:ibc2021-ch10-list_item-0518 a ibco:ListItem ;
        ibco:bbox "[331.794, 160.381, 550.838, 272.135]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0516 ;
        ibco:precedes ibc:ibc2021-1011.4 ;
        ibco:sourcePage 325 ;
        ibco:text "2. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R-3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; where the nosings of treads at the side of a flight extend under the edge of a floor opening through which the stair passes, the floor opening shall be allowed to project horizontally into the required headroom not more than 43/4 inches (121 mm)." .

    ibc:ibc2021-ch10-list_item-0524 a ibco:ListItem ;
        ibco:bbox "[343.78, 607.806, 550.751, 629.868]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0523 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0525 ;
        ibco:sourcePage 325 ;
        ibco:text "1. Spiral stairways in accordance with Section 1011.10." .

    ibc:ibc2021-ch10-list_item-0525 a ibco:ListItem ;
        ibco:bbox "[343.78, 633.722, 550.816, 666.819]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0523 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0526 ;
        ibco:sourcePage 325 ;
        ibco:text "2. Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to use the riser/tread dimension in Section 1030.14.2." .

    ibc:ibc2021-ch10-list_item-0526 a ibco:ListItem ;
        ibco:bbox "[115.194, 69.725, 304.207, 168.822]",
            "[343.78, 670.674, 550.841, 738.455]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0523 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0527 ;
        ibco:sourcePage 325,
            326 ;
        ibco:text "3. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R- 3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; the maximum riser height shall be 73/4 inches (197 mm); the minimum tread depth shall be 10 inches (254 mm); the minimum winder tread depth at the walkline shall be 10 inches (254 mm); and the minimum winder tread depth shall be 6 inches (152 mm). A nosing projection not less than 3/4 inch (19.1 mm) but not more than 11/4 inches (32 mm) shall be provided on stairways with solid risers where the tread depth is less than 11 inches (279 mm)." .

    ibc:ibc2021-ch10-list_item-0527 a ibco:ListItem ;
        ibco:bbox "[97.197, 171.72, 304.188, 204.817]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0523 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0528 ;
        ibco:sourcePage 326 ;
        ibco:text "4. See Section 503.1 of the International Existing Building Code for the replacement of existing stairways." .

    ibc:ibc2021-ch10-list_item-0528 a ibco:ListItem ;
        ibco:bbox "[97.187, 207.716, 304.337, 284.858]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0523 ;
        ibco:precedes ibc:ibc2021-1011.5.3 ;
        ibco:sourcePage 326 ;
        ibco:text "5. In Group I-3 facilities, stairways providing access to guard towers, observation stations and control rooms, not more than 250 square feet (23 m2) in area, shall be permitted to have a maximum riser height of 8 inches (203 mm) and a minimum tread depth of 9 inches (229 mm)." .

    ibc:ibc2021-ch10-list_item-0531 a ibco:ListItem ;
        ibco:bbox "[97.202, 340.783, 304.115, 362.845]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0530 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0532 ;
        ibco:sourcePage 326 ;
        ibco:text "1. Curved stairways in accordance with Section 1011.9." .

    ibc:ibc2021-ch10-list_item-0532 a ibco:ListItem ;
        ibco:bbox "[97.202, 365.743, 304.162, 387.805]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0530 ;
        ibco:precedes ibc:ibc2021-1011.5.4 ;
        ibco:sourcePage 326 ;
        ibco:text "2. Spiral stairways in accordance with Section 1011.10." .

    ibc:ibc2021-ch10-list_item-0535 a ibco:ListItem ;
        ibco:bbox "[97.202, 487.804, 304.176, 531.818]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0534 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0536 ;
        ibco:sourcePage 326 ;
        ibco:text "1. Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to comply with the dimensional nonuniformity in Section 1030.14.2." .

    ibc:ibc2021-ch10-list_item-0536 a ibco:ListItem ;
        ibco:bbox "[97.202, 534.835, 304.216, 567.813]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0534 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0537 ;
        ibco:sourcePage 326 ;
        ibco:text "2. Consistently shaped winders, complying with Section 1011.5, differing from rectangular treads in the same flight of stairs." .

    ibc:ibc2021-ch10-list_item-0537 a ibco:ListItem ;
        ibco:bbox "[97.202, 570.831, 304.179, 592.773]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0534 ;
        ibco:precedes ibc:ibc2021-1011.5.4.1 ;
        ibco:sourcePage 326 ;
        ibco:text "3. Nonuniform riser dimension complying with Section 1011.5.4.1." .

    ibc:ibc2021-ch10-list_item-0541 a ibco:ListItem ;
        ibco:bbox "[346.199, 209.333, 565.199, 231.83]" ;
        ibco:label "(nosings)" ;
        ibco:partOf ibc:ibc2021-1011.5.5.1 ;
        ibco:precedes ibc:ibc2021-1011.5.5.2 ;
        ibco:sourcePage 326 ;
        ibco:text "(nosings) of treads shall project not more than 11/4 inches (32 mm) beyond the tread below." .

    ibc:ibc2021-ch10-list_item-0545 a ibco:ListItem ;
        ibco:bbox "[372.593, 313.791, 565.221, 379.756]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0544 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0546 ;
        ibco:sourcePage 326 ;
        ibco:text "1. Solid risers are not required for stairways that are not required to comply with Section 1009.3, provided that the opening between treads does not permit the passage of a sphere with a diameter of 4 inches (102 mm)." .

    ibc:ibc2021-ch10-list_item-0546 a ibco:ListItem ;
        ibco:bbox "[372.593, 382.774, 565.215, 437.823]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0544 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0547 ;
        ibco:sourcePage 326 ;
        ibco:text "2. Solid risers are not required for occupancies in Group I-3 or in Group F, H and S occupancies other than areas accessible to the public. The size of the opening in the riser is not restricted." .

    ibc:ibc2021-ch10-list_item-0547 a ibco:ListItem ;
        ibco:bbox "[372.593, 440.722, 565.192, 473.819]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0544 ;
        ibco:precedes ibc:ibc2021-1011.6 ;
        ibco:sourcePage 326 ;
        ibco:text "3. Solid risers are not required for spiral stairways constructed in accordance with Section 1011.10." .

    ibc:ibc2021-ch10-list_item-0550 a ibco:ListItem ;
        ibco:bbox "[346.189, 661.694, 565.34, 716.743]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0549 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0551 ;
        ibco:sourcePage 326 ;
        ibco:text "1. Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030." .

    ibc:ibc2021-ch10-list_item-0551 a ibco:ListItem ;
        ibco:bbox "[70.799, 69.725, 289.82, 146.726]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0549 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0552 ;
        ibco:sourcePage 327 ;
        ibco:text "2. Where curved stairways of constant radius have intermediate landings, the landing depth shall be measured horizontally between the intersection of the walkline of the lower flight at the landing nosing and the intersection of the walkline of the upper flight at the nosing of the lowest tread of the upper flight." .

    ibc:ibc2021-ch10-list_item-0552 a ibco:ListItem ;
        ibco:bbox "[70.779, 149.743, 289.827, 215.709]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0549 ;
        ibco:precedes ibc:ibc2021-1011.7 ;
        ibco:sourcePage 327 ;
        ibco:text "3. Where a landing turns 90 degrees (1.57 rad) or more, the minimum landing depth in accordance with this section shall not be required where the landing provided is not less than that described by an arc with a radius equal to the width of the flight served." .

    ibc:ibc2021-ch10-list_item-0555 a ibco:ListItem ;
        ibco:bbox "[70.789, 271.754, 289.791, 293.815]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0554 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0556 ;
        ibco:sourcePage 327 ;
        ibco:text "1. Wood handrails shall be permitted in all types of construction." .

    ibc:ibc2021-ch10-list_item-0557 a ibco:ListItem ;
        ibco:bbox "[88.548, 307.749, 113.478, 318.775]" ;
        ibco:label "510.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0556 ;
        ibco:precedes ibc:ibc2021-1011.7.1 ;
        ibco:sourcePage 327 ;
        ibco:text "510.2." .

    ibc:ibc2021-ch10-list_item-0560 a ibco:ListItem ;
        ibco:bbox "[82.791, 407.688, 289.792, 473.854]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0559 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0561 ;
        ibco:sourcePage 327 ;
        ibco:text "1. Openings in stair walking surfaces shall be a size that does not permit the passage of 1/2inch-diameter (12.7 mm) sphere. Elongated openings shall be placed so that the long dimension is perpendicular to the direction of travel." .

    ibc:ibc2021-ch10-list_item-0561 a ibco:ListItem ;
        ibco:bbox "[82.797, 476.752, 289.846, 542.866]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0559 ;
        ibco:precedes ibc:ibc2021-1011.7.2 ;
        ibco:sourcePage 327 ;
        ibco:text "2. In Group F, H and S occupancies, other than areas of parking structures accessible to the public, openings in treads and landings shall not be prohibited provided that a sphere with a diameter of 11/8 inches (29 mm) cannot pass through the opening." .

    ibc:ibc2021-ch10-list_item-0571 a ibco:ListItem ;
        ibco:bbox "[307.795, 342.836, 550.81, 434.862]" ;
        ibco:label "410.5" ;
        ibco:partOf ibc:ibc2021-1011.10 ;
        ibco:precedes ibc:ibc2021-1011.11 ;
        ibco:sourcePage 327 ;
        ibco:text "410.5. A spiral stairway shall have a 63/4-inch (171 mm) minimum clear tread depth at a point 12 inches (305 mm) from the narrow edge. The risers shall be sufficient to provide a headroom of 78 inches (1981 mm) minimum, but riser height shall not be more than 91/2 inches (241 mm). The minimum stairway clear width at and below the handrail shall be 26 inches (660 mm)." .

    ibc:ibc2021-ch10-list_item-0574 a ibco:ListItem ;
        ibco:bbox "[331.812, 501.823, 550.809, 534.8]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0573 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0575 ;
        ibco:sourcePage 327 ;
        ibco:text "1. Flights of stairways within dwelling units and flights of spiral stairways are permitted to have a handrail on one side only." .

    ibc:ibc2021-ch10-list_item-0575 a ibco:ListItem ;
        ibco:bbox "[331.812, 537.818, 550.84, 592.748]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0573 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0576 ;
        ibco:sourcePage 327 ;
        ibco:text "2. Decks, patios and walkways that have a single change in elevation where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails." .

    ibc:ibc2021-ch10-list_item-0576 a ibco:ListItem ;
        ibco:bbox "[331.812, 595.766, 550.902, 628.743]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0573 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0577 ;
        ibco:sourcePage 327 ;
        ibco:text "3. In Group R-3 occupancies, a change in elevation consisting of a single riser at an entrance or egress door does not require handrails." .

    ibc:ibc2021-ch10-list_item-0577 a ibco:ListItem ;
        ibco:bbox "[331.803, 631.761, 550.818, 664.739]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0573 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0578 ;
        ibco:sourcePage 327 ;
        ibco:text "4. Changes in room elevations of three or fewer risers within dwelling units and sleeping units in Groups R-2 and R-3 do not require handrails." .

    ibc:ibc2021-ch10-list_item-0579 a ibco:ListItem ;
        ibco:bbox "[111.594, 94.804, 304.15, 116.746]" ;
        ibco:label "5.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0578 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0580 ;
        ibco:sourcePage 328 ;
        ibco:text "5.1. The stairway contains not more than two risers." .

    ibc:ibc2021-ch10-list_item-0580 a ibco:ListItem ;
        ibco:bbox "[111.584, 119.764, 304.197, 152.741]" ;
        ibco:label "5.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0578 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0581 ;
        ibco:sourcePage 328 ;
        ibco:text "5.2. A handhold, positioned horizontally or vertically, is located on one side of the stairway adjacent to the top landing." .

    ibc:ibc2021-ch10-list_item-0581 a ibco:ListItem ;
        ibco:bbox "[111.594, 155.759, 304.183, 199.772]" ;
        ibco:label "5.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0578 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0582 ;
        ibco:sourcePage 328 ;
        ibco:text "5.3. The handhold is located not less than 34 inches (864 mm) and not more than 42 inches (1067 mm) above the bottom landing of the stairway." .

    ibc:ibc2021-ch10-list_item-0582 a ibco:ListItem ;
        ibco:bbox "[111.594, 202.79, 304.2, 235.768]" ;
        ibco:label "5.4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0578 ;
        ibco:precedes ibc:ibc2021-1011.12 ;
        ibco:sourcePage 328 ;
        ibco:text "5.4. The handhold gripping surface complies with Section 1014.3, and is not less than 4.5 inches (114 mm) in length." .

    ibc:ibc2021-ch10-list_item-0597 a ibco:ListItem ;
        ibco:bbox "[334.209, 588.819, 565.213, 610.761]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0598 ;
        ibco:sourcePage 328 ;
        ibco:text "1. Spaces frequented only by personnel for maintenance, repair or monitoring of equipment." .

    ibc:ibc2021-ch10-list_item-0598 a ibco:ListItem ;
        ibco:bbox "[334.209, 613.779, 565.23, 646.757]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0599 ;
        ibco:sourcePage 328 ;
        ibco:text "2. Nonoccupiable spaces accessed only by catwalks, crawl spaces, freight elevators or very narrow passageways." .

    ibc:ibc2021-ch10-list_item-0599 a ibco:ListItem ;
        ibco:bbox "[334.209, 649.774, 565.195, 693.788]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0600 ;
        ibco:sourcePage 328 ;
        ibco:text "3. Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands." .

    ibc:ibc2021-ch10-list_item-0600 a ibco:ListItem ;
        ibco:bbox "[334.209, 696.806, 565.252, 718.747]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0601 ;
        ibco:sourcePage 328 ;
        ibco:text "4. Elevated levels in Group U not open to the general public." .

    ibc:ibc2021-ch10-list_item-0601 a ibco:ListItem ;
        ibco:bbox "[58.799, 69.725, 289.742, 102.822]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0602 ;
        ibco:sourcePage 329 ;
        ibco:text "5. Nonoccupied roofs that are not required to have stairway access in accordance with Section 1011.12.1." .

    ibc:ibc2021-ch10-list_item-0602 a ibco:ListItem ;
        ibco:bbox "[58.799, 105.72, 289.804, 138.817]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1011.16 ;
        ibco:precedes ibc:ibc2021-1012 ;
        ibco:sourcePage 329 ;
        ibco:text "6. Where permitted to access equipment and appliances in accordance with Section 306.5 of the International Mechanical Code." .

    ibc:ibc2021-ch10-list_item-0606 a ibco:ListItem ;
        ibco:bbox "[70.801, 226.784, 289.743, 248.846]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0605 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0607 ;
        ibco:sourcePage 329 ;
        ibco:text "1. Ramped aisles within assembly rooms or spaces shall comply with the provisions in Section 1030." .

    ibc:ibc2021-ch10-list_item-0607 a ibco:ListItem ;
        ibco:bbox "[70.801, 251.744, 263.485, 262.77]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0605 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0608 ;
        ibco:sourcePage 329 ;
        ibco:text "2. Curb ramps shall comply with ICC A117.1." .

    ibc:ibc2021-ch10-list_item-0608 a ibco:ListItem ;
        ibco:bbox "[70.801, 265.788, 289.802, 331.753]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0605 ;
        ibco:precedes ibc:ibc2021-1012.2 ;
        ibco:sourcePage 329 ;
        ibco:text "3. Vehicle ramps in parking garages for pedestrian exit access shall not be required to comply with Sections 1012.3 through 1012.10 where they are not an accessible route serving accessible parking spaces, other required accessible elements or part of an accessible means of egress." .

    ibc:ibc2021-ch10-list_item-0621 a ibco:ListItem ;
        ibco:bbox "[343.788, 232.758, 550.883, 287.807]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0620 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0622 ;
        ibco:sourcePage 329 ;
        ibco:text "1. In Group R-2 and R-3 individual dwelling and sleeping units that are not required to be Accessible units, Type A units or Type B units in accordance with Section 1108, landings are permitted to be 36 inches (914 mm) minimum." .

    ibc:ibc2021-ch10-list_item-0622 a ibco:ListItem ;
        ibco:bbox "[343.788, 290.705, 550.798, 334.718]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0620 ;
        ibco:precedes ibc:ibc2021-1012.6.4 ;
        ibco:sourcePage 329 ;
        ibco:text "2. Where the ramp is not a part of an accessible route, the length of the landing shall not be required to be more than 48 inches (1219 mm) in the direction of travel." .

    ibc:ibc2021-ch10-list_item-0633 a ibco:ListItem ;
        ibco:bbox "[85.193, 121.796, 304.186, 165.809]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0632 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0634 ;
        ibco:sourcePage 330 ;
        ibco:text "1. Edge protection is not required on ramps that are not required to have handrails, provided they have flared sides that comply with the ICC A117.1 curb ramp provisions." .

    ibc:ibc2021-ch10-list_item-0634 a ibco:ListItem ;
        ibco:bbox "[85.183, 168.707, 304.251, 201.804]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0632 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0635 ;
        ibco:sourcePage 330 ;
        ibco:text "2. Edge protection is not required on the sides of ramp landings serving an adjoining ramp run or stairway." .

    ibc:ibc2021-ch10-list_item-0635 a ibco:ListItem ;
        ibco:bbox "[85.173, 204.703, 304.193, 259.782]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0632 ;
        ibco:precedes ibc:ibc2021-1012.10.1 ;
        ibco:sourcePage 330 ;
        ibco:text "3. Edge protection is not required on the sides of ramp landings having a vertical dropoff of not more than 1/2 inch (12.7 mm) within 10 inches (254 mm) horizontally of the required landing area." .

    ibc:ibc2021-ch10-list_item-0641 a ibco:ListItem ;
        ibco:bbox "[85.194, 586.709, 304.177, 608.771]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0640 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0642 ;
        ibco:sourcePage 330 ;
        ibco:text "1. Exit signs are not required in rooms or areas that require only one exit or exit access." .

    ibc:ibc2021-ch10-list_item-0642 a ibco:ListItem ;
        ibco:bbox "[85.194, 611.669, 304.213, 655.682]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0640 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0643 ;
        ibco:sourcePage 330 ;
        ibco:text "2. Main exterior exit doors or gates that are obviously and clearly identifiable as exits need not have exit signs where approved by the building official." .

    ibc:ibc2021-ch10-list_item-0643 a ibco:ListItem ;
        ibco:bbox "[85.184, 658.7, 304.175, 691.678]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0640 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0644 ;
        ibco:sourcePage 330 ;
        ibco:text "3. Exit signs are not required in occupancies in Group U and individual sleeping units or dwelling units in Group R-1, R-2 or R-3." .

    ibc:ibc2021-ch10-list_item-0644 a ibco:ListItem ;
        ibco:bbox "[85.174, 694.696, 304.156, 716.757]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0640 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0645 ;
        ibco:sourcePage 330 ;
        ibco:text "4. Exit signs are not required in dayrooms, sleeping rooms or dormitories in occupancies in Group I-3." .

    ibc:ibc2021-ch10-list_item-0645 a ibco:ListItem ;
        ibco:bbox "[346.176, 69.606, 565.271, 146.607]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0640 ;
        ibco:precedes ibc:ibc2021-1013.2 ;
        ibco:sourcePage 330 ;
        ibco:text "5. In occupancies in Groups A-4 and A-5, exit signs are not required on the seating side of vomitories or openings into seating areas where exit signs are provided in the concourse that are readily apparent from the vomitories. Egress lighting is provided to identify each vomitory or opening within the seating area in an emergency." .

    ibc:ibc2021-ch10-list_item-0660 a ibco:ListItem ;
        ibco:bbox "[70.761, 532.676, 289.829, 576.689]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0659 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0661 ;
        ibco:sourcePage 331 ;
        ibco:text "1. Where handrail fittings or bendings are used to provide continuous transition between flights, the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:ibc2021-ch10-list_item-0661 a ibco:ListItem ;
        ibco:bbox "[70.761, 579.707, 289.866, 700.611]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0659 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0662 ;
        ibco:sourcePage 331 ;
        ibco:text "2. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are associated with a Group R-3 occupancy or associated with individual dwelling units in Group R-2 occupancies; where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:ibc2021-ch10-list_item-0662 a ibco:ListItem ;
        ibco:bbox "[70.771, 703.629, 289.771, 736.782]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0659 ;
        ibco:precedes ibc:ibc2021-1014.3 ;
        ibco:sourcePage 331 ;
        ibco:text "3. Handrails on top of a guard where permitted along stepped aisles and ramped aisles in accordance with Section 1030.16." .

    ibc:ibc2021-ch10-list_item-0669 a ibco:ListItem ;
        ibco:bbox "[331.801, 512.757, 550.746, 534.819]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0668 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0670 ;
        ibco:sourcePage 331 ;
        ibco:text "1. Handrails within dwelling units are permitted to be interrupted by a newel post at a turn or landing." .

    ibc:ibc2021-ch10-list_item-0670 a ibco:ListItem ;
        ibco:bbox "[331.801, 539.749, 550.777, 572.846]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0668 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0671 ;
        ibco:sourcePage 331 ;
        ibco:text "2. Within a dwelling unit, the use of a volute, turnout, starting easing or starting newel is allowed over the lowest tread." .

    ibc:ibc2021-ch10-list_item-0671 a ibco:ListItem ;
        ibco:bbox "[331.801, 577.776, 550.84, 687.826]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0668 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0672 ;
        ibco:sourcePage 331 ;
        ibco:text "3. Handrail brackets or balusters attached to the bottom surface of the handrail that do not project horizontally beyond the sides of the handrail within 11/2 inches (38 mm) of the bottom of the handrail shall not be considered obstructions. For each 1/2 inch (12.7 mm) of additional handrail perimeter dimension above 4 inches (102 mm), the vertical clearance dimension of 11/2 inches (38 mm) shall be permitted to be reduced by 1/8 inch (3.2 mm)." .

    ibc:ibc2021-ch10-list_item-0672 a ibco:ListItem ;
        ibco:bbox "[102.959, 69.725, 304.16, 91.786]",
            "[331.806, 692.756, 550.827, 736.77]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0668 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0673 ;
        ibco:sourcePage 331,
            332 ;
        ibco:text "4. Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards." .

    ibc:ibc2021-ch10-list_item-0673 a ibco:ListItem ;
        ibco:bbox "[85.2, 95.043, 304.201, 128.14]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0668 ;
        ibco:precedes ibc:ibc2021-1014.5 ;
        ibco:sourcePage 332 ;
        ibco:text "5. Handrails serving stepped aisles or ramped aisles are permitted to be discontinuous in accordance with Section 1030.16.1." .

    ibc:ibc2021-ch10-list_item-0677 a ibco:ListItem ;
        ibco:bbox "[85.18, 310.259, 304.211, 343.237]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0676 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0678 ;
        ibco:sourcePage 332 ;
        ibco:text "1. Handrails within a dwelling unit that is not required to be accessible need extend only from the top riser to the bottom riser." .

    ibc:ibc2021-ch10-list_item-0678 a ibco:ListItem ;
        ibco:bbox "[85.181, 346.493, 304.242, 390.507]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0676 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0679 ;
        ibco:sourcePage 332 ;
        ibco:text "2. Handrails serving aisles in rooms or spaces used for assembly purposes are permitted to comply with the handrail extensions in accordance with Section 1030.16." .

    ibc:ibc2021-ch10-list_item-0679 a ibco:ListItem ;
        ibco:bbox "[85.181, 393.764, 304.172, 459.848]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0676 ;
        ibco:precedes ibc:ibc2021-1014.7 ;
        ibco:sourcePage 332 ;
        ibco:text "3. Handrails for alternating tread devices and ships ladders are permitted to terminate at a location vertically above the top and bottom risers. Handrails for alternating tread devices are not required to be continuous between flights or to extend beyond the top or bottom risers." .

    ibc:ibc2021-ch10-list_item-0687 a ibco:ListItem ;
        ibco:bbox "[346.169, 315.722, 546.303, 326.747]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0688 ;
        ibco:sourcePage 332 ;
        ibco:text "1. On the loading side of loading docks or piers." .

    ibc:ibc2021-ch10-list_item-0688 a ibco:ListItem ;
        ibco:bbox "[346.169, 329.646, 565.136, 362.743]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0689 ;
        ibco:sourcePage 332 ;
        ibco:text "2. On the audience side of stages and raised platforms, including stairs leading up to the stage and raised platforms." .

    ibc:ibc2021-ch10-list_item-0689 a ibco:ListItem ;
        ibco:bbox "[346.169, 365.641, 565.184, 398.738]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0690 ;
        ibco:sourcePage 332 ;
        ibco:text "3. On raised stage and platform floor areas, such as runways, ramps and side stages used for entertainment or presentations." .

    ibc:ibc2021-ch10-list_item-0690 a ibco:ListItem ;
        ibco:bbox "[346.159, 401.637, 565.184, 423.827]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0691 ;
        ibco:sourcePage 332 ;
        ibco:text "4. At vertical openings in the performance area of stages and platforms." .

    ibc:ibc2021-ch10-list_item-0691 a ibco:ListItem ;
        ibco:bbox "[346.199, 426.845, 565.209, 459.826]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0692 ;
        ibco:sourcePage 332 ;
        ibco:text "5. At elevated walking surfaces appurtenant to stages and platforms for access to and utilization of special lighting or equipment." .

    ibc:ibc2021-ch10-list_item-0692 a ibco:ListItem ;
        ibco:bbox "[346.201, 462.844, 565.254, 484.786]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0693 ;
        ibco:sourcePage 332 ;
        ibco:text "6. Along vehicle service pits not accessible to the public." .

    ibc:ibc2021-ch10-list_item-0693 a ibco:ListItem ;
        ibco:bbox "[346.201, 487.804, 565.166, 509.865]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0694 ;
        ibco:sourcePage 332 ;
        ibco:text "7. In assembly seating areas at cross aisles in accordance with Section 1030.17.2." .

    ibc:ibc2021-ch10-list_item-0694 a ibco:ListItem ;
        ibco:bbox "[346.201, 512.763, 565.167, 534.825]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0686 ;
        ibco:precedes ibc:ibc2021-1015.2.1 ;
        ibco:sourcePage 332 ;
        ibco:text "8. On the loading side of station platforms on fixed guideway transit or passenger rail systems." .

    ibc:ibc2021-ch10-list_item-0697 a ibco:ListItem ;
        ibco:bbox "[334.209, 634.773, 496.83, 645.799]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1015.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0698 ;
        ibco:sourcePage 332 ;
        ibco:text "1. From the adjacent walking surfaces." .

    ibc:ibc2021-ch10-list_item-0698 a ibco:ListItem ;
        ibco:bbox "[334.209, 648.817, 565.209, 670.759]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1015.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0699 ;
        ibco:sourcePage 332 ;
        ibco:text "2. On stairways and stepped aisles, from the line connecting the leading edges of the tread nosings." .

    ibc:ibc2021-ch10-list_item-0699 a ibco:ListItem ;
        ibco:bbox "[334.209, 673.777, 565.172, 695.838]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1015.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0700 ;
        ibco:sourcePage 332 ;
        ibco:text "3. On ramps and ramped aisles, from the ramp surface at the guard." .

    ibc:ibc2021-ch10-list_item-0701 a ibco:ListItem ;
        ibco:bbox "[346.191, 714.812, 565.207, 736.754]",
            "[88.559, 69.725, 289.866, 135.809]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0702 ;
        ibco:sourcePage 332,
            333 ;
        ibco:text "1. For occupancies in Group R-3 not more than three stories above grade in height and within individual dwelling units in occupancies in Group R-2 not more than three stories above grade in height with separate means of egress, required guards shall be not less than 36 inches (914 mm) in height measured vertically above the adjacent walking surfaces." .

    ibc:ibc2021-ch10-list_item-0702 a ibco:ListItem ;
        ibco:bbox "[70.8, 138.708, 289.815, 204.792]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0703 ;
        ibco:sourcePage 333 ;
        ibco:text "2. For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, guards on the open sides of stairs shall have a height not less than 34 inches (864 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:ibc2021-ch10-list_item-0703 a ibco:ListItem ;
        ibco:bbox "[70.79, 207.691, 289.812, 284.811]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0704 ;
        ibco:sourcePage 333 ;
        ibco:text "3. For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, where the top of the guard serves as a handrail on the open sides of stairs, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:ibc2021-ch10-list_item-0704 a ibco:ListItem ;
        ibco:bbox "[70.781, 287.71, 289.828, 309.771]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0705 ;
        ibco:sourcePage 333 ;
        ibco:text "4. The guard height in assembly seating areas shall comply with Section 1030.17 as applicable." .

    ibc:ibc2021-ch10-list_item-0705 a ibco:ListItem ;
        ibco:bbox "[70.781, 312.789, 289.806, 378.754]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0706 ;
        ibco:sourcePage 333 ;
        ibco:text "5. Along alternating tread devices and ships ladders, guards where the top rail serves as a handrail shall have height not less than 30 inches (762 mm) and not more than 34 inches (864 mm), measured vertically from the leading edge of the device tread nosing." .

    ibc:ibc2021-ch10-list_item-0706 a ibco:ListItem ;
        ibco:bbox "[70.781, 381.772, 289.866, 469.689]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0700 ;
        ibco:precedes ibc:ibc2021-1015.4 ;
        ibco:sourcePage 333 ;
        ibco:text "6. In Group F occupancies where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:ibc2021-ch10-list_item-0709 a ibco:ListItem ;
        ibco:bbox "[70.78, 536.65, 289.787, 580.787]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0710 ;
        ibco:sourcePage 333 ;
        ibco:text "1. From a height of 36 inches (914 mm) to 42 inches (1067 mm), guards shall not have openings that allow passage of a sphere 43/8 inches (111 mm) in diameter." .

    ibc:ibc2021-ch10-list_item-0710 a ibco:ListItem ;
        ibco:bbox "[70.801, 583.804, 289.844, 627.818]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0711 ;
        ibco:sourcePage 333 ;
        ibco:text "2. The triangular openings at the open sides of a stair, formed by the riser, tread and bottom rail shall not allow passage of a sphere 6 inches (152 mm) in diameter." .

    ibc:ibc2021-ch10-list_item-0711 a ibco:ListItem ;
        ibco:bbox "[70.801, 630.836, 289.966, 685.765]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0712 ;
        ibco:sourcePage 333 ;
        ibco:text "3. At elevated walking surfaces for access to and use of electrical, mechanical or plumbing systems or equipment, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:ibc2021-ch10-list_item-0712 a ibco:ListItem ;
        ibco:bbox "[349.561, 69.689, 550.798, 91.751]",
            "[70.801, 688.783, 289.841, 721.76]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0713 ;
        ibco:sourcePage 333 ;
        ibco:text "4. In areas that are not open to the public within occupancies in Group I-3, F, H or S, and for alternating tread devices and ships ladders, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:ibc2021-ch10-list_item-0713 a ibco:ListItem ;
        ibco:bbox "[331.803, 94.768, 550.857, 193.721]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0714 ;
        ibco:sourcePage 333 ;
        ibco:text "5. In assembly seating areas, guards required at the end of aisles in accordance with Section 1030.17.4 shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter up to a height of 26 inches (660 mm). From a height of 26 inches (660 mm) to 42 inches (1067 mm) above the adjacent walking surfaces, guards shall not have openings that allow passage of a sphere 8 inches (203 mm) in diameter." .

    ibc:ibc2021-ch10-list_item-0714 a ibco:ListItem ;
        ibco:bbox "[331.803, 196.739, 550.851, 251.866]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0708 ;
        ibco:precedes ibc:ibc2021-1015.5 ;
        ibco:sourcePage 333 ;
        ibco:text "6. Within individual dwelling units and sleeping units in Group R-2 and R-3 occupancies, guards on the open sides of stairs shall not have openings that allow passage of a sphere 43/8 (111 mm) inches in diameter." .

    ibc:ibc2021-ch10-list_item-0721 a ibco:ListItem ;
        ibco:bbox "[319.774, 664.678, 550.742, 719.727]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1015.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0722 ;
        ibco:sourcePage 333 ;
        ibco:text "1. Operable windows where the top of the sill of the opening is located more than 75 feet (22 860 mm) above the finished grade or other surface below and that are provided with window fall prevention devices that comply with ASTM F2006." .

    ibc:ibc2021-ch10-list_item-0722 a ibco:ListItem ;
        ibco:bbox "[73.199, 69.725, 304.221, 113.738]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1015.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0723 ;
        ibco:sourcePage 334 ;
        ibco:text "2. Operable windows where the openings will not allow a 4-inch-diameter (102 mm) sphere to pass through the opening when the window is in its largest opened position." .

    ibc:ibc2021-ch10-list_item-0723 a ibco:ListItem ;
        ibco:bbox "[73.199, 116.756, 304.161, 149.733]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1015.8 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0724 ;
        ibco:sourcePage 334 ;
        ibco:text "3. Operable windows where the openings are provided with window fall prevention devices that comply with ASTM F2090." .

    ibc:ibc2021-ch10-list_item-0724 a ibco:ListItem ;
        ibco:bbox "[73.199, 152.751, 304.233, 185.729]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1015.8 ;
        ibco:precedes ibc:ibc2021-1015.8.1 ;
        ibco:sourcePage 334 ;
        ibco:text "4. Operable windows that are provided with window opening control devices that comply with Section 1015.8.1." .

    ibc:ibc2021-ch10-list_item-0729 a ibco:ListItem ;
        ibco:bbox "[73.209, 376.742, 304.308, 497.766]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1016.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0730 ;
        ibco:sourcePage 334 ;
        ibco:text "1. Exit access through an enclosed elevator lobby is permitted. Where access to two or more exits or exit access doorways is required in Section 1006.2.1, access to not less than one of the required exits shall be provided without travel through the enclosed elevator lobbies required by Section 3006. Where the path of exit access travel passes through an enclosed elevator lobby, the level of protection required for the enclosed elevator lobby is not required to be extended to the exit unless direct access to an exit is required by other sections of this code." .

    ibc:ibc2021-ch10-list_item-0730 a ibco:ListItem ;
        ibco:bbox "[73.199, 500.664, 304.213, 566.749]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1016.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0731 ;
        ibco:sourcePage 334 ;
        ibco:text "2. Egress from a room or space shall not pass through adjoining or intervening rooms or areas, except where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit." .

    ibc:ibc2021-ch10-list_item-0732 a ibco:ListItem ;
        ibco:bbox "[73.189, 629.626, 304.156, 651.688]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0731 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0733 ;
        ibco:sourcePage 334 ;
        ibco:text "3. An exit access shall not pass through a room that can be locked to prevent egress." .

    ibc:ibc2021-ch10-list_item-0733 a ibco:ListItem ;
        ibco:bbox "[73.189, 654.705, 304.192, 687.683]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0731 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0734 ;
        ibco:sourcePage 334 ;
        ibco:text "4. Means of egress from dwelling units or sleeping areas shall not lead through other sleeping areas, toilet rooms or bathrooms." .

    ibc:ibc2021-ch10-list_item-0734 a ibco:ListItem ;
        ibco:bbox "[334.191, 69.575, 565.258, 91.637]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0731 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0735 ;
        ibco:sourcePage 334 ;
        ibco:text "5. Egress shall not pass through kitchens, storage rooms, closets or spaces used for similar purposes." .

    ibc:ibc2021-ch10-list_item-0736 a ibco:ListItem ;
        ibco:bbox "[381.949, 110.611, 565.193, 154.624]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0735 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0737 ;
        ibco:sourcePage 334 ;
        ibco:text "1. Means of egress are not prohibited through a kitchen area serving adjoining rooms constituting part of the same dwelling unit or sleeping unit." .

    ibc:ibc2021-ch10-list_item-0738 a ibco:ListItem ;
        ibco:bbox "[406.192, 205.629, 565.23, 238.607]" ;
        ibco:label "2.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0737 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0739 ;
        ibco:sourcePage 334 ;
        ibco:text "2.1. The stock is of the same hazard classification as that found in the main retail area." .

    ibc:ibc2021-ch10-list_item-0739 a ibco:ListItem ;
        ibco:bbox "[406.192, 241.624, 565.173, 274.602]" ;
        ibco:label "2.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0737 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0740 ;
        ibco:sourcePage 334 ;
        ibco:text "2.2. Not more than 50 percent of the exit access is through the stockroom." .

    ibc:ibc2021-ch10-list_item-0740 a ibco:ListItem ;
        ibco:bbox "[406.192, 277.62, 565.167, 299.681]" ;
        ibco:label "2.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0737 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0741 ;
        ibco:sourcePage 334 ;
        ibco:text "2.3. The stockroom is not subject to locking from the egress side." .

    ibc:ibc2021-ch10-list_item-0741 a ibco:ListItem ;
        ibco:bbox "[406.192, 302.58, 565.241, 390.81]" ;
        ibco:label "2.4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0737 ;
        ibco:precedes ibc:ibc2021-1016.2.1 ;
        ibco:sourcePage 334 ;
        ibco:text "2.4. There is a demarcated, minimum 44-inch-wide (1118 mm) aisle defined by full- or partial-height fixed walls or similar construction that will maintain the required width and lead directly from the retail area to the exit without obstructions." .

    ibc:ibc2021-ch10-list_item-0747 a ibco:ListItem ;
        ibco:bbox "[46.799, 311.305, 289.841, 510.057]" ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0748 ;
        ibco:sourcePage 335 ;
        ibco:text "a. See the following sections for modifications to exit access travel distance requirements: Section 402.8: For the distance limitation in malls. Section 407.4: For the distance limitation in Group I-2. Sections 408.6.1 and 408.8.1: For the distance limitations in Group I-3. Section 411.2: For the distance limitation in special amusement areas. Section 412.6: For the distance limitations in aircraft manufacturing facilities. Section 1006.2.2.2: For the distance limitation in refrigeration machinery rooms. Section 1006.2.2.3: For the distance limitation in refrigerated rooms and spaces. Section 1006.3.4: For buildings with one exit. Section 1017.2.2: For increased distance limitation in Groups F-1 and S-1. Section 1030.7: For increased limitation in assembly seating. Section 3103.4: For temporary structures. Section 3104.9: For pedestrian walkways." .

    ibc:ibc2021-ch10-list_item-0748 a ibco:ListItem ;
        ibco:bbox "[46.807, 512.33, 289.941, 548.089]" ;
        ibco:label "b" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0749 ;
        ibco:sourcePage 335 ;
        ibco:text "b. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2. See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0749 a ibco:ListItem ;
        ibco:bbox "[46.807, 549.285, 289.939, 567.049]" ;
        ibco:label "c" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0750 ;
        ibco:sourcePage 335 ;
        ibco:text "c. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0750 a ibco:ListItem ;
        ibco:bbox "[46.807, 568.245, 289.791, 586.01]" ;
        ibco:label "d" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0751 ;
        ibco:sourcePage 335 ;
        ibco:text "d. Group H occupancies equipped throughout with an automatic sprinkler system in accordance with Section 903.2.5.1." .

    ibc:ibc2021-ch10-list_item-0751 a ibco:ListItem ;
        ibco:bbox "[46.807, 587.324, 289.877, 623.083]" ;
        ibco:label "e" ;
        ibco:partOf ibc:ibc2021-1017.2 ;
        ibco:precedes ibc:ibc2021-1017.2.1 ;
        ibco:sourcePage 335 ;
        ibco:text "e. Group R-3 and R-4 buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3. See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:ibc2021-ch10-list_item-0754 a ibco:ListItem ;
        ibco:bbox "[331.793, 117.677, 550.773, 139.739]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1017.2.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0755 ;
        ibco:sourcePage 335 ;
        ibco:text "1. The portion of the building classified as Group F- 1 or S-1 is limited to one story in height." .

    ibc:ibc2021-ch10-list_item-0755 a ibco:ListItem ;
        ibco:bbox "[331.793, 142.757, 550.812, 175.734]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1017.2.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0756 ;
        ibco:sourcePage 335 ;
        ibco:text "2. The minimum height from the finished floor to the bottom of the ceiling or roof slab or deck is 24 feet (7315 mm)." .

    ibc:ibc2021-ch10-list_item-0757 a ibco:ListItem ;
        ibco:bbox "[349.551, 200.704, 389.491, 211.73]" ;
        ibco:label "903.3.1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0756 ;
        ibco:precedes ibc:ibc2021-1017.3 ;
        ibco:sourcePage 335 ;
        ibco:text "903.3.1.1." .

    ibc:ibc2021-ch10-list_item-0760 a ibco:ListItem ;
        ibco:bbox "[331.813, 300.762, 550.916, 344.775]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0759 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0761 ;
        ibco:sourcePage 335 ;
        ibco:text "1. In open parking garages, exit access travel distance is permitted to be measured to the closest riser of an exit access stairway or the closest slope of an exit access ramp." .

    ibc:ibc2021-ch10-list_item-0761 a ibco:ListItem ;
        ibco:bbox "[331.793, 347.674, 550.794, 380.771]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0759 ;
        ibco:precedes ibc:ibc2021-1017.3.1 ;
        ibco:sourcePage 335 ;
        ibco:text "2. In smoke protected seating and open air assembly seating, exit access travel distance shall be measured in accordance with Section 1030.7." .

    ibc:ibc2021-ch10-list_item-0782 a ibco:ListItem ;
        ibco:bbox "[346.238, 180.675, 565.4, 224.689]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0783 ;
        ibco:sourcePage 336 ;
        ibco:text "1. Exit access stairways and ramps that serve or atmospherically communicate between only two adjacent stories. Such interconnected stories shall not be open to other stories." .

    ibc:ibc2021-ch10-list_item-0783 a ibco:ListItem ;
        ibco:bbox "[346.238, 227.706, 565.328, 271.72]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0784 ;
        ibco:sourcePage 336 ;
        ibco:text "2. In Group R-1, R-2 or R-3 occupancies, exit access stairways and ramps connecting four stories or less serving and contained within an individual dwelling unit or sleeping unit or live/work unit." .

    ibc:ibc2021-ch10-list_item-0784 a ibco:ListItem ;
        ibco:bbox "[346.238, 274.738, 565.242, 307.715]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0785 ;
        ibco:sourcePage 336 ;
        ibco:text "3. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility are not required to be enclosed." .

    ibc:ibc2021-ch10-list_item-0785 a ibco:ListItem ;
        ibco:bbox "[346.238, 310.733, 565.312, 431.757]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0786 ;
        ibco:sourcePage 336 ;
        ibco:text "4. Exit access stairways and ramps in buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, where the area of the vertical opening between stories does not exceed twice the horizontal projected area of the stairway or ramp and the opening is protected by a draft curtain and closely spaced sprinklers in accordance with NFPA 13. In other than Group B and M occupancies, this provision is limited to openings that do not connect more than four stories." .

    ibc:ibc2021-ch10-list_item-0786 a ibco:ListItem ;
        ibco:bbox "[346.238, 434.655, 565.227, 456.717]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0787 ;
        ibco:sourcePage 336 ;
        ibco:text "5. Exit access stairways and ramps within an atrium complying with the provisions of Section 404." .

    ibc:ibc2021-ch10-list_item-0787 a ibco:ListItem ;
        ibco:bbox "[346.238, 459.735, 565.176, 481.686]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0788 ;
        ibco:sourcePage 336 ;
        ibco:text "6. Exit access stairways and ramps in open parking garages that serve only the parking garage." .

    ibc:ibc2021-ch10-list_item-0788 a ibco:ListItem ;
        ibco:bbox "[346.238, 484.704, 565.256, 528.822]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0789 ;
        ibco:sourcePage 336 ;
        ibco:text "7. Exit access stairways and ramps serving smokeprotected or open-air assembly seating complying with the exit access travel distance requirements of Section 1030.7." .

    ibc:ibc2021-ch10-list_item-0789 a ibco:ListItem ;
        ibco:bbox "[346.199, 531.839, 565.248, 586.769]" ;
        ibco:label "8" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0790 ;
        ibco:sourcePage 336 ;
        ibco:text "8. Exit access stairways and ramps between the balcony, gallery or press box and the main assembly floor in occupancies such as theaters, places of religious worship, auditoriums and sports facilities." .

    ibc:ibc2021-ch10-list_item-0790 a ibco:ListItem ;
        ibco:bbox "[346.199, 589.787, 565.258, 611.848]" ;
        ibco:label "9" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0781 ;
        ibco:precedes ibc:ibc2021-1019.4 ;
        ibco:sourcePage 336 ;
        ibco:text "9. Exterior exit access stairways or ramps between occupied roofs." .

    ibc:ibc2021-ch10-list_item-0797 a ibco:ListItem ;
        ibco:bbox "[70.811, 195.699, 289.808, 283.735]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0798 ;
        ibco:sourcePage 337 ;
        ibco:text "1. A fire-resistance rating is not required for corridors in an occupancy in Group E where each room that is used for instruction has not less than one door opening directly to the exterior and rooms for assembly purposes have not less than one-half of the required means of egress doors opening directly to the exterior. Exterior doors specified in this exception are required to be at ground level." .

    ibc:ibc2021-ch10-list_item-0798 a ibco:ListItem ;
        ibco:bbox "[70.811, 286.753, 289.762, 319.731]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0799 ;
        ibco:sourcePage 337 ;
        ibco:text "2. A fire-resistance rating is not required for corridors contained within a dwelling unit or sleeping unit in an occupancy in Groups I-1 and R." .

    ibc:ibc2021-ch10-list_item-0799 a ibco:ListItem ;
        ibco:bbox "[70.811, 322.749, 289.762, 344.81]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0800 ;
        ibco:sourcePage 337 ;
        ibco:text "3. A fire-resistance rating is not required for corridors in open parking garages." .

    ibc:ibc2021-ch10-list_item-0800 a ibco:ListItem ;
        ibco:bbox "[70.801, 347.709, 289.84, 391.722]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0801 ;
        ibco:sourcePage 337 ;
        ibco:text "4. A fire-resistance rating is not required for corridors in an occupancy in Group B that is a space requiring only a single means of egress complying with Section 1006.2." .

    ibc:ibc2021-ch10-list_item-0801 a ibco:ListItem ;
        ibco:bbox "[70.801, 394.74, 289.869, 477.947]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0802 ;
        ibco:sourcePage 337 ;
        ibco:text "5. Corridors adjacent to the exterior walls of buildings shall be permitted to have unprotected openings on unrated exterior walls where unrated walls are permitted by Table 705.5 and unprotected openings are permitted by Table 705.8. TABLE 1020.2 CORRIDOR FIRE-RESISTANCE RATING" .

    ibc:ibc2021-ch10-list_item-0803 a ibco:ListItem ;
        ibco:bbox "[55.794, 642.256, 75.774, 651.023]" ;
        ibco:label "407.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0802 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0804 ;
        ibco:sourcePage 337 ;
        ibco:text "407.3." .

    ibc:ibc2021-ch10-list_item-0804 a ibco:ListItem ;
        ibco:bbox "[46.797, 652.338, 289.743, 670.102]" ;
        ibco:label "b" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0805 ;
        ibco:sourcePage 337 ;
        ibco:text "b. For a reduction in the fire-resistance rating for occupancies in Group I-3, see Section 408.8." .

    ibc:ibc2021-ch10-list_item-0805 a ibco:ListItem ;
        ibco:bbox "[46.797, 671.298, 289.929, 689.063]" ;
        ibco:label "c" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0806 ;
        ibco:sourcePage 337 ;
        ibco:text "c. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 where allowed." .

    ibc:ibc2021-ch10-list_item-0806 a ibco:ListItem ;
        ibco:bbox "[46.797, 690.259, 289.867, 726.018]" ;
        ibco:label "d" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-1020.2.1 ;
        ibco:sourcePage 337 ;
        ibco:text "d. Group R-3 and R-4 buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3. See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:ibc2021-ch10-list_item-0814 a ibco:ListItem ;
        ibco:bbox "[331.803, 530.743, 550.814, 563.84]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0813 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0815 ;
        ibco:sourcePage 337 ;
        ibco:text "1. In Group I-3, Condition 2, 3 or 4, occupancies, the dead end in a corridor shall not exceed 50 feet (15 240 mm)." .

    ibc:ibc2021-ch10-list_item-0815 a ibco:ListItem ;
        ibco:bbox "[331.803, 566.739, 550.833, 632.823]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0813 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0816 ;
        ibco:sourcePage 337 ;
        ibco:text "2. In occupancies in Groups B, E, F, I-1, M, R-1, R- 2, S and U, where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, the length of the dead-end corridors shall not exceed 50 feet (15 240 mm)." .

    ibc:ibc2021-ch10-list_item-0816 a ibco:ListItem ;
        ibco:bbox "[331.813, 635.721, 550.863, 679.735]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0813 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0817 ;
        ibco:sourcePage 337 ;
        ibco:text "3. A dead-end corridor shall not be limited in length where the length of the dead-end corridor is less than 2.5 times the least width of the dead-end corridor." .

    ibc:ibc2021-ch10-list_item-0817 a ibco:ListItem ;
        ibco:bbox "[331.833, 682.753, 550.871, 726.766]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0813 ;
        ibco:precedes ibc:ibc2021-1020.6 ;
        ibco:sourcePage 337 ;
        ibco:text "4. In Group I-2, Condition 2 occupancies, the length of dead-end corridors that do not serve patient rooms or patient treatment spaces shall not exceed 30 feet (9144 mm)." .

    ibc:ibc2021-ch10-list_item-0820 a ibco:ListItem ;
        ibco:bbox "[85.203, 121.796, 304.221, 209.713]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0819 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0821 ;
        ibco:sourcePage 338 ;
        ibco:text "1. Use of a corridor as a source of makeup air for exhaust systems in rooms that open directly onto such corridors, including toilet rooms, bathrooms, dressing rooms, smoking lounges and janitor closets, shall be permitted, provided that each such corridor is directly supplied with outdoor air at a rate greater than the rate of makeup air taken from the corridor." .

    ibc:ibc2021-ch10-list_item-0821 a ibco:ListItem ;
        ibco:bbox "[85.203, 212.73, 304.352, 245.828]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0819 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0822 ;
        ibco:sourcePage 338 ;
        ibco:text "2. Where located within a dwelling unit, the use of corridors for conveying return air shall not be prohibited." .

    ibc:ibc2021-ch10-list_item-0822 a ibco:ListItem ;
        ibco:bbox "[85.203, 248.726, 304.181, 281.866]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0819 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0823 ;
        ibco:sourcePage 338 ;
        ibco:text "3. Where located within tenant spaces of 1,000 square feet (93 m2) or less in area, utilization of corridors for conveying return air is permitted." .

    ibc:ibc2021-ch10-list_item-0823 a ibco:ListItem ;
        ibco:bbox "[85.197, 284.764, 304.251, 317.862]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0819 ;
        ibco:precedes ibc:ibc2021-1020.6.1 ;
        ibco:sourcePage 338 ;
        ibco:text "4. Transfer air movement required to maintain the pressurization difference within health care facilities in accordance with ASHRAE 170." .

    ibc:ibc2021-ch10-list_item-0825 a ibco:ListItem ;
        ibco:bbox "[85.197, 369.823, 304.155, 391.765]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1020.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0826 ;
        ibco:sourcePage 338 ;
        ibco:text "1. The corridor is not required to be of fire-resistance-rated construction." .

    ibc:ibc2021-ch10-list_item-0826 a ibco:ListItem ;
        ibco:bbox "[85.187, 394.783, 304.267, 416.844]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1020.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0827 ;
        ibco:sourcePage 338 ;
        ibco:text "2. The corridor is separated from the plenum by fireresistance-rated construction." .

    ibc:ibc2021-ch10-list_item-0827 a ibco:ListItem ;
        ibco:bbox "[85.187, 419.742, 304.221, 463.756]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1020.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0828 ;
        ibco:sourcePage 338 ;
        ibco:text "3. The air-handling system serving the corridor is shut down upon activation of the air-handling unit smoke detectors required by the International Mechanical Code." .

    ibc:ibc2021-ch10-list_item-0828 a ibco:ListItem ;
        ibco:bbox "[85.187, 466.774, 304.214, 510.787]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1020.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0829 ;
        ibco:sourcePage 338 ;
        ibco:text "4. The air-handling system serving the corridor is shut down upon detection of sprinkler water flow where the building is equipped throughout with an automatic sprinkler system." .

    ibc:ibc2021-ch10-list_item-0829 a ibco:ListItem ;
        ibco:bbox "[85.197, 513.805, 304.208, 557.818]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1020.6.1 ;
        ibco:precedes ibc:ibc2021-1020.7 ;
        ibco:sourcePage 338 ;
        ibco:text "5. The space between the corridor ceiling and the floor or roof structure above the corridor is used as a component of an approved engineered smoke control system." .

    ibc:ibc2021-ch10-list_item-0832 a ibco:ListItem ;
        ibco:bbox "[85.177, 679.718, 304.149, 712.696]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0831 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0833 ;
        ibco:sourcePage 338 ;
        ibco:text "1. Foyers, lobbies or reception rooms constructed as required for corridors shall not be construed as intervening rooms." .

    ibc:ibc2021-ch10-list_item-0833 a ibco:ListItem ;
        ibco:bbox "[346.179, 69.628, 565.204, 102.726]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0831 ;
        ibco:precedes ibc:ibc2021-1021 ;
        ibco:sourcePage 338 ;
        ibco:text "2. Enclosed elevator lobbies as permitted by Item 1 of Section 1016.2 shall not be construed as intervening rooms." .

    ibc:ibc2021-ch10-list_item-0840 a ibco:ListItem ;
        ibco:bbox "[334.199, 378.815, 425.253, 389.84]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1021.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0841 ;
        ibco:sourcePage 338 ;
        ibco:text "1. Adjacent lot lines." .

    ibc:ibc2021-ch10-list_item-0841 a ibco:ListItem ;
        ibco:bbox "[334.199, 392.739, 474.084, 403.765]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1021.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0842 ;
        ibco:sourcePage 338 ;
        ibco:text "2. Other portions of the building." .

    ibc:ibc2021-ch10-list_item-0842 a ibco:ListItem ;
        ibco:bbox "[322.187, 406.782, 565.25, 476.831]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1021.4 ;
        ibco:precedes ibc:ibc2021-1022 ;
        ibco:sourcePage 338 ;
        ibco:text "3. Other buildings on the same lot unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance. For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:ibc2021-ch10-list_item-0852 a ibco:ListItem ;
        ibco:bbox "[70.821, 360.756, 289.811, 393.734]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0851 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0853 ;
        ibco:sourcePage 339 ;
        ibco:text "1. Interior exit stairways and ramps in Group I-3 occupancies in accordance with the provisions of Section 408.3.8." .

    ibc:ibc2021-ch10-list_item-0853 a ibco:ListItem ;
        ibco:bbox "[70.821, 396.752, 289.775, 418.693]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0851 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0854 ;
        ibco:sourcePage 339 ;
        ibco:text "2. Interior exit stairways within an atrium enclosed in accordance with Section 404.6." .

    ibc:ibc2021-ch10-list_item-0855 a ibco:ListItem ;
        ibco:bbox "[88.58, 432.747, 113.51, 443.773]" ;
        ibco:label "510.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0854 ;
        ibco:precedes ibc:ibc2021-1023.3 ;
        ibco:sourcePage 339 ;
        ibco:text "510.2." .

    ibc:ibc2021-ch10-list_item-0860 a ibco:ListItem ;
        ibco:bbox "[343.808, 132.659, 550.797, 154.72]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0859 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0861 ;
        ibco:sourcePage 339 ;
        ibco:text "1. Penetrations of the fire barrier in accordance with Section 1023.5 shall be permitted." .

    ibc:ibc2021-ch10-list_item-0861 a ibco:ListItem ;
        ibco:bbox "[343.808, 157.738, 550.871, 201.751]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0859 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0862 ;
        ibco:sourcePage 339 ;
        ibco:text "2. Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where there are no openings into the exit passageway extension." .

    ibc:ibc2021-ch10-list_item-0862 a ibco:ListItem ;
        ibco:bbox "[343.807, 204.65, 550.814, 259.699]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0859 ;
        ibco:precedes ibc:ibc2021-1023.4 ;
        ibco:sourcePage 339 ;
        ibco:text "3. Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where the interior exit stairway and the exit passageway extension are pressurized in accordance with Section 909.20.5." .

    ibc:ibc2021-ch10-list_item-0865 a ibco:ListItem ;
        ibco:bbox "[319.791, 411.819, 550.842, 433.761]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0866 ;
        ibco:sourcePage 339 ;
        ibco:text "1. Equipment and ductwork necessary for independent ventilation or pressurization." .

    ibc:ibc2021-ch10-list_item-0866 a ibco:ListItem ;
        ibco:bbox "[319.791, 436.779, 434.122, 447.804]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0867 ;
        ibco:sourcePage 339 ;
        ibco:text "2. Fire protection systems." .

    ibc:ibc2021-ch10-list_item-0867 a ibco:ListItem ;
        ibco:bbox "[319.791, 450.822, 407.756, 461.848]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0868 ;
        ibco:sourcePage 339 ;
        ibco:text "3. Security systems." .

    ibc:ibc2021-ch10-list_item-0868 a ibco:ListItem ;
        ibco:bbox "[319.791, 464.746, 477.496, 475.772]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0869 ;
        ibco:sourcePage 339 ;
        ibco:text "4. Two-way communication systems." .

    ibc:ibc2021-ch10-list_item-0869 a ibco:ListItem ;
        ibco:bbox "[319.791, 478.79, 550.758, 500.851]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0870 ;
        ibco:sourcePage 339 ;
        ibco:text "5. Electrical raceway for fire department communication systems." .

    ibc:ibc2021-ch10-list_item-0870 a ibco:ListItem ;
        ibco:bbox "[319.791, 503.75, 550.802, 536.87]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0871 ;
        ibco:sourcePage 339 ;
        ibco:text "6. Electrical raceway serving the interior exit stairway and ramp and terminating at a steel box not exceeding 16 square inches (0.010 m2)." .

    ibc:ibc2021-ch10-list_item-0871 a ibco:ListItem ;
        ibco:bbox "[307.805, 539.769, 550.858, 609.817]" ;
        ibco:label "7" ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0872 ;
        ibco:sourcePage 339 ;
        ibco:text "7. Structural elements supporting the interior exit stairway or ramp or enclosure, such as beams or joists. Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communication openings, whether protected or not, between adjacent interior exit stairways and ramps." .

    ibc:ibc2021-ch10-list_item-0873 a ibco:ListItem ;
        ibco:bbox "[319.807, 646.779, 352.306, 657.805]" ;
        ibco:label "714.4.2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0872 ;
        ibco:precedes ibc:ibc2021-1023.6 ;
        ibco:sourcePage 339 ;
        ibco:text "714.4.2." .

    ibc:ibc2021-ch10-list_item-0875 a ibco:ListItem ;
        ibco:bbox "[73.201, 106.796, 304.168, 150.809]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1023.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0876 ;
        ibco:sourcePage 340 ;
        ibco:text "1. Such equipment and ductwork shall be located exterior to the building and shall be directly connected to the interior exit stairway and ramp by ductwork enclosed in construction as required for shafts." .

    ibc:ibc2021-ch10-list_item-0876 a ibco:ListItem ;
        ibco:bbox "[73.191, 153.708, 304.235, 219.792]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1023.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0877 ;
        ibco:sourcePage 340 ;
        ibco:text "2. Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:ibc2021-ch10-list_item-0877 a ibco:ListItem ;
        ibco:bbox "[61.159, 222.691, 304.242, 351.762]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1023.6 ;
        ibco:precedes ibc:ibc2021-1023.7 ;
        ibco:sourcePage 340 ;
        ibco:text "3. Where located within the building, such equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts. In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures. The interior exit stairway and ramp ventilation systems shall be independent of other building ventilation systems." .

    ibc:ibc2021-ch10-list_item-0882 a ibco:ListItem ;
        ibco:bbox "[346.183, 95.675, 565.212, 117.737]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0883 ;
        ibco:sourcePage 340 ;
        ibco:text "1. The signs shall be a minimum size of 18 inches (457 mm) by 12 inches (305 mm)." .

    ibc:ibc2021-ch10-list_item-0883 a ibco:ListItem ;
        ibco:bbox "[346.183, 120.635, 565.24, 155.495]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0884 ;
        ibco:sourcePage 340 ;
        ibco:text "2. The letters designating the identification of the interior exit stairway and ramp shall be not less than 11/2 inches (38 mm) in height." .

    ibc:ibc2021-ch10-list_item-0884 a ibco:ListItem ;
        ibco:bbox "[346.195, 156.729, 565.235, 189.826]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0885 ;
        ibco:sourcePage 340 ;
        ibco:text "3. The number designating the floor level shall be not less than 5 inches (127 mm) in height and located in the center of the sign." .

    ibc:ibc2021-ch10-list_item-0885 a ibco:ListItem ;
        ibco:bbox "[346.195, 192.724, 565.162, 214.786]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0886 ;
        ibco:sourcePage 340 ;
        ibco:text "4. Other lettering and numbers shall be not less than 1 inch (25 mm) in height." .

    ibc:ibc2021-ch10-list_item-0886 a ibco:ListItem ;
        ibco:bbox "[346.195, 217.804, 565.284, 272.853]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0887 ;
        ibco:sourcePage 340 ;
        ibco:text "5. Characters and their background shall have a nonglare finish. Characters shall contrast with their background, with either light characters on a dark background or dark characters on a light background." .

    ibc:ibc2021-ch10-list_item-0887 a ibco:ListItem ;
        ibco:bbox "[346.195, 275.751, 565.282, 330.8]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1023.9.1 ;
        ibco:precedes ibc:ibc2021-1023.10 ;
        ibco:sourcePage 340 ;
        ibco:text "6. Where signs required by Section 1023.9 are installed in the interior exit stairways and ramps of buildings subject to Section 1025, the signs shall be made of the same materials as required by Section 1025.4." .

    ibc:ibc2021-ch10-list_item-0893 a ibco:ListItem ;
        ibco:bbox "[100.799, 69.725, 289.798, 102.822]",
            "[358.197, 695.625, 565.183, 728.722]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0892 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0894 ;
        ibco:sourcePage 340,
            341 ;
        ibco:text "1. Openings in the exit passageway serving a smokeproof enclosure are permitted where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors." .

    ibc:ibc2021-ch10-list_item-0894 a ibco:ListItem ;
        ibco:bbox "[82.801, 105.72, 289.825, 160.769]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0892 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0895 ;
        ibco:sourcePage 341 ;
        ibco:text "2. The fire barrier separating the smokeproof enclosure from the exit passageway is not required, provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure." .

    ibc:ibc2021-ch10-list_item-0895 a ibco:ListItem ;
        ibco:bbox "[82.821, 163.787, 289.856, 207.8]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0892 ;
        ibco:precedes ibc:ibc2021-1023.12.2 ;
        ibco:sourcePage 341 ;
        ibco:text "3. A smokeproof enclosure shall be permitted to egress through areas on the level of exit discharge or vestibules as permitted by Section 1028." .

    ibc:ibc2021-ch10-list_item-0898 a ibco:ListItem ;
        ibco:bbox "[70.82, 281.714, 108.229, 292.739]" ;
        ibco:label "909.20.5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0897 ;
        ibco:precedes ibc:ibc2021-1023.13 ;
        ibco:sourcePage 341 ;
        ibco:text "909.20.5." .

    ibc:ibc2021-ch10-list_item-0900 a ibco:ListItem ;
        ibco:bbox "[46.816, 318.785, 71.746, 329.81]" ;
        ibco:label "905.4" ;
        ibco:partOf ibc:ibc2021-1023.13 ;
        ibco:precedes ibc:ibc2021-1024 ;
        ibco:sourcePage 341 ;
        ibco:text "905.4." .

    ibc:ibc2021-ch10-list_item-0909 a ibco:ListItem ;
        ibco:bbox "[319.773, 173.731, 550.824, 195.792]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0910 ;
        ibco:sourcePage 341 ;
        ibco:text "1. Equipment and ductwork necessary for independent ventilation or pressurization." .

    ibc:ibc2021-ch10-list_item-0910 a ibco:ListItem ;
        ibco:bbox "[319.773, 198.691, 433.528, 209.716]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0911 ;
        ibco:sourcePage 341 ;
        ibco:text "2. Fire protection systems." .

    ibc:ibc2021-ch10-list_item-0911 a ibco:ListItem ;
        ibco:bbox "[319.773, 212.734, 407.738, 223.76]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0912 ;
        ibco:sourcePage 341 ;
        ibco:text "3. Security systems." .

    ibc:ibc2021-ch10-list_item-0912 a ibco:ListItem ;
        ibco:bbox "[319.773, 226.778, 477.478, 237.804]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0913 ;
        ibco:sourcePage 341 ;
        ibco:text "4. Two-way communication systems." .

    ibc:ibc2021-ch10-list_item-0913 a ibco:ListItem ;
        ibco:bbox "[319.773, 240.821, 550.824, 262.763]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0914 ;
        ibco:sourcePage 341 ;
        ibco:text "5. Electrical raceway for fire department communication." .

    ibc:ibc2021-ch10-list_item-0914 a ibco:ListItem ;
        ibco:bbox "[307.809, 265.781, 550.827, 346.778]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-1024.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0915 ;
        ibco:sourcePage 341 ;
        ibco:text "6. Electrical raceway serving the exit passageway and terminating at a steel box not exceeding 16 square inches (0.010 m2). Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communicating openings, whether protected or not, between adjacent exit passageways." .

    ibc:ibc2021-ch10-list_item-0917 a ibco:ListItem ;
        ibco:bbox "[319.811, 424.774, 550.767, 468.788]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1024.7 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0918 ;
        ibco:sourcePage 341 ;
        ibco:text "1. The equipment and ductwork shall be located exterior to the building and shall be directly connected to the exit passageway by ductwork enclosed in construction as required for shafts." .

    ibc:ibc2021-ch10-list_item-0918 a ibco:ListItem ;
        ibco:bbox "[319.791, 471.806, 550.849, 537.771]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1024.7 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0919 ;
        ibco:sourcePage 341 ;
        ibco:text "2. Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:ibc2021-ch10-list_item-0919 a ibco:ListItem ;
        ibco:bbox "[307.779, 540.789, 550.971, 669.741]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1024.7 ;
        ibco:precedes ibc:ibc2021-1024.8 ;
        ibco:sourcePage 341 ;
        ibco:text "3. Where located within the building, the equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts. In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures. Exit passageway ventilation systems shall be independent of other building ventilation systems." .

    ibc:ibc2021-ch10-list_item-0922 a ibco:ListItem ;
        ibco:bbox "[61.204, 205.783, 86.134, 216.809]" ;
        ibco:label "905.4" ;
        ibco:partOf ibc:ibc2021-1024.9 ;
        ibco:precedes ibc:ibc2021-1025 ;
        ibco:sourcePage 342 ;
        ibco:text "905.4." .

    ibc:ibc2021-ch10-list_item-0947 a ibco:ListItem ;
        ibco:bbox "[58.804, 552.765, 115.055, 563.79]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1025.4 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0948 ;
        ibco:sourcePage 343 ;
        ibco:text "1. UL 1994." .

    ibc:ibc2021-ch10-list_item-0948 a ibco:ListItem ;
        ibco:bbox "[58.804, 566.689, 289.855, 621.738]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1025.4 ;
        ibco:precedes ibc:ibc2021-1025.5 ;
        ibco:sourcePage 343 ;
        ibco:text "2. ASTM E2072, except that the charging source shall be 1 footcandle (11 lux) of fluorescent illumination for 60 minutes, and the minimum luminance shall be 30 milicandelas per square meter at 10 minutes and 5 milicandelas per square meter after 90 minutes." .

    ibc:ibc2021-ch10-list_item-0953 a ibco:ListItem ;
        ibco:bbox "[331.818, 191.625, 550.814, 224.603]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0952 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0954 ;
        ibco:sourcePage 343 ;
        ibco:text "1. Horizontal exits are permitted to comprise twothirds of the required exits from any building or floor area for occupancies in Group I-2." .

    ibc:ibc2021-ch10-list_item-0954 a ibco:ListItem ;
        ibco:bbox "[331.818, 227.62, 550.946, 293.705]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0952 ;
        ibco:precedes ibc:ibc2021-1026.2 ;
        ibco:sourcePage 343 ;
        ibco:text "2. Horizontal exits are permitted to comprise 100 percent of the exits required for occupancies in Group I-3. Not less than 6 square feet (0.6 m2) of accessible space per occupant shall be provided on each side of the horizontal exit for the total number of people in adjoining compartments." .

    ibc:ibc2021-ch10-list_item-0956 a ibco:ListItem ;
        ibco:bbox "[307.799, 374.59, 550.782, 440.849]" ;
        ibco:label "716" ;
        ibco:partOf ibc:ibc2021-1026.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0957 ;
        ibco:sourcePage 343 ;
        ibco:text "716. Duct and air transfer openings in a fire wall or fire barrier that serves as a horizontal exit shall also comply with Section 717. The horizontal exit separation shall extend vertically through all levels of the building unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings." .

    ibc:ibc2021-ch10-list_item-0964 a ibco:ListItem ;
        ibco:bbox "[61.193, 356.681, 86.123, 367.707]" ;
        ibco:label "905.4" ;
        ibco:partOf ibc:ibc2021-1026.5 ;
        ibco:precedes ibc:ibc2021-1027 ;
        ibco:sourcePage 344 ;
        ibco:text "905.4." .

    ibc:ibc2021-ch10-list_item-0971 a ibco:ListItem ;
        ibco:bbox "[334.203, 95.727, 425.257, 106.753]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1027.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0972 ;
        ibco:sourcePage 344 ;
        ibco:text "1. Adjacent lot lines." .

    ibc:ibc2021-ch10-list_item-0972 a ibco:ListItem ;
        ibco:bbox "[334.203, 109.77, 474.088, 120.796]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1027.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0973 ;
        ibco:sourcePage 344 ;
        ibco:text "2. Other portions of the building." .

    ibc:ibc2021-ch10-list_item-0973 a ibco:ListItem ;
        ibco:bbox "[322.191, 123.695, 565.254, 193.743]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1027.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0974 ;
        ibco:sourcePage 344 ;
        ibco:text "3. Other buildings on the same lot unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance. For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:ibc2021-ch10-list_item-0977 a ibco:ListItem ;
        ibco:bbox "[346.195, 352.715, 565.254, 418.68]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0976 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0978 ;
        ibco:sourcePage 344 ;
        ibco:text "1. Separation from the interior of the building is not required for occupancies, other than those in Group R-1 or R-2, in buildings that are not more than two stories above grade plane where a level of exit discharge serving such occupancies is the first story above grade plane." .

    ibc:ibc2021-ch10-list_item-0978 a ibco:ListItem ;
        ibco:bbox "[346.185, 421.698, 565.244, 531.801]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0976 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0979 ;
        ibco:sourcePage 344 ;
        ibco:text "2. Separation from the interior of the building is not required where the exterior exit stairway or ramp is served by an exterior exit ramp or balcony that connects two remote exterior exit stairways or other approved exits with a perimeter that is not less than 50 percent open. To be considered open, the opening shall be not less than 50 percent of the height of the enclosing wall, with the top of the openings not less than 7 feet (2134 mm) above the top of the balcony." .

    ibc:ibc2021-ch10-list_item-0980 a ibco:ListItem ;
        ibco:bbox "[372.604, 581.731, 565.249, 636.78]" ;
        ibco:label "3.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0979 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0981 ;
        ibco:sourcePage 344 ;
        ibco:text "3.1. The building, including open-ended corridors, and stairways and ramps, shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:ibc2021-ch10-list_item-0981 a ibco:ListItem ;
        ibco:bbox "[372.604, 639.797, 565.15, 661.739]" ;
        ibco:label "3.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0979 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0982 ;
        ibco:sourcePage 344 ;
        ibco:text "3.2. The open-ended corridors comply with Section 1020." .

    ibc:ibc2021-ch10-list_item-0982 a ibco:ListItem ;
        ibco:bbox "[372.594, 664.757, 565.273, 697.735]" ;
        ibco:label "3.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0979 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0983 ;
        ibco:sourcePage 344 ;
        ibco:text "3.3. The open-ended corridors are connected on each end to an exterior exit stairway or ramp complying with Section 1027." .

    ibc:ibc2021-ch10-list_item-0983 a ibco:ListItem ;
        ibco:bbox "[97.199, 69.725, 289.865, 102.822]" ;
        ibco:label "3.4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0979 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0984 ;
        ibco:sourcePage 345 ;
        ibco:text "3.4. The exterior walls and openings adjacent to the exterior exit stairway or ramp comply with Section 1023.7." .

    ibc:ibc2021-ch10-list_item-0984 a ibco:ListItem ;
        ibco:bbox "[97.209, 105.72, 289.876, 204.809]" ;
        ibco:label "3.5" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0979 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0985 ;
        ibco:sourcePage 345 ;
        ibco:text "3.5. At any location in an open-ended corridor where a change of direction exceeding 45 degrees (0.79 rad) occurs, a clear opening of not less than 35 square feet (3.3 m2) or an exterior stairway or ramp shall be provided. Where clear openings are provided, they shall be located so as to minimize the accumulation of smoke or toxic gases." .

    ibc:ibc2021-ch10-list_item-0985 a ibco:ListItem ;
        ibco:bbox "[70.799, 207.708, 289.86, 273.792]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0976 ;
        ibco:precedes ibc:ibc2021-1028 ;
        ibco:sourcePage 345 ;
        ibco:text "4. In Group R-3 occupancies not more than four stories in height, exterior exit stairways and ramps serving individual dwelling units are not required to be separated from the interior of the building where the exterior exit stairway or ramp discharges directly to grade." .

    ibc:ibc2021-ch10-list_item-0991 a ibco:ListItem ;
        ibco:bbox "[97.153, 522.753, 289.771, 588.718]" ;
        ibco:label "1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0990 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0992 ;
        ibco:sourcePage 345 ;
        ibco:text "1.1. Discharge of interior exit stairways and ramps shall be provided with a free and unobstructed path of travel to an exterior exit door and such exit is readily visible and identifiable from the point of termination of the enclosure." .

    ibc:ibc2021-ch10-list_item-0992 a ibco:ListItem ;
        ibco:bbox "[97.143, 591.736, 289.829, 635.749]" ;
        ibco:label "1.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0990 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0993 ;
        ibco:sourcePage 345 ;
        ibco:text "1.2. The entire area of the level of exit discharge is separated from areas below by construction conforming to the fireresistance rating for the enclosure." .

    ibc:ibc2021-ch10-list_item-0993 a ibco:ListItem ;
        ibco:bbox "[379.768, 69.583, 550.812, 135.818]",
            "[97.143, 638.647, 289.777, 715.648]" ;
        ibco:label "1.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0990 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0994 ;
        ibco:sourcePage 345 ;
        ibco:text "1.3. The egress path from the interior exit stairway and ramp on the level of exit discharge is protected throughout by an approved automatic sprinkler system. Portions of the level of exit discharge with access to the egress path shall be either equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, or separated from the egress path in accordance with the requirements for the enclosure of interior exit stairways or ramps." .

    ibc:ibc2021-ch10-list_item-0994 a ibco:ListItem ;
        ibco:bbox "[358.196, 138.716, 550.955, 325.716]" ;
        ibco:label "1.4" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0990 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0995 ;
        ibco:sourcePage 345 ;
        ibco:text "1.4. Where a required interior exit stairway or ramp and an exit access stairway or ramp serve the same floor level and terminate at the same level of exit discharge, the termination of the exit access stairway or ramp and the exit discharge door of the interior exit stairway or ramp shall be separated by a distance of not less than 30 feet (9144 mm) or not less than one-fourth the length of the maximum overall diagonal dimension of the building, whichever is less. The distance shall be measured in a straight line between the exit discharge door from the interior exit stairway or ramp and the last tread of the exit access stairway or termination of slope of the exit access ramp." .

    ibc:ibc2021-ch10-list_item-0996 a ibco:ListItem ;
        ibco:bbox "[358.186, 386.681, 550.864, 441.73]" ;
        ibco:label "2.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0995 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0997 ;
        ibco:sourcePage 345 ;
        ibco:text "2.1. The entire area of the vestibule is separated from areas below by construction conforming to the fire-resistance rating of the interior exit stairway or ramp enclosure." .

    ibc:ibc2021-ch10-list_item-0997 a ibco:ListItem ;
        ibco:bbox "[358.196, 444.747, 550.84, 488.761]" ;
        ibco:label "2.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0995 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0998 ;
        ibco:sourcePage 345 ;
        ibco:text "2.2. The depth from the exterior of the building is not greater than 10 feet (3048 mm) and the length is not greater than 30 feet (9144 mm)." .

    ibc:ibc2021-ch10-list_item-0998 a ibco:ListItem ;
        ibco:bbox "[358.196, 491.659, 550.876, 535.672]" ;
        ibco:label "2.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-0995 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0999 ;
        ibco:sourcePage 345 ;
        ibco:text "2.3. The area is separated from the remainder of the level of exit discharge by a fire partition constructed in accordance with Section 708." .

    ibc:ibc2021-ch10-list_item-1000 a ibco:ListItem ;
        ibco:bbox "[358.196, 565.682, 550.849, 587.743]" ;
        ibco:label "2.4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0999 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1001 ;
        ibco:sourcePage 345 ;
        ibco:text "2.4. The area is used only for means of egress and exits directly to the outside." .

    ibc:ibc2021-ch10-list_item-1001 a ibco:ListItem ;
        ibco:bbox "[331.792, 590.641, 550.762, 623.739]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0999 ;
        ibco:precedes ibc:ibc2021-1028.3 ;
        ibco:sourcePage 345 ;
        ibco:text "3. Horizontal exits complying with Section 1026 shall not be required to discharge directly to the exterior of the building." .

    ibc:ibc2021-ch10-list_item-1006 a ibco:ListItem ;
        ibco:bbox "[85.183, 132.712, 304.2, 154.79]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1005 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1007 ;
        ibco:sourcePage 346 ;
        ibco:text "1. The area shall be of a size to accommodate not less than 5 square feet (0.46 m2) for each person." .

    ibc:ibc2021-ch10-list_item-1007 a ibco:ListItem ;
        ibco:bbox "[85.202, 157.808, 304.167, 190.786]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1005 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1008 ;
        ibco:sourcePage 346 ;
        ibco:text "2. The area shall be located on the same lot not less than 50 feet (15 240 mm) away from the building requiring egress." .

    ibc:ibc2021-ch10-list_item-1008 a ibco:ListItem ;
        ibco:bbox "[85.202, 193.804, 304.144, 215.746]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1005 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1009 ;
        ibco:sourcePage 346 ;
        ibco:text "3. The area shall be permanently maintained and identified as a safe dispersal area." .

    ibc:ibc2021-ch10-list_item-1009 a ibco:ListItem ;
        ibco:bbox "[32.159, 218.763, 304.201, 252.709]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1005 ;
        ibco:precedes ibc:ibc2021-1029 ;
        ibco:sourcePage 346 ;
        ibco:text "4. The area shall be provided with a safe and unobstructed path of travel from the building. **" .

    ibc:ibc2021-ch10-list_item-1016 a ibco:ListItem ;
        ibco:bbox "[85.197, 560.764, 304.115, 582.826]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1015 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1017 ;
        ibco:sourcePage 346 ;
        ibco:text "1. Egress courts serving an occupant load of less than 10." .

    ibc:ibc2021-ch10-list_item-1017 a ibco:ListItem ;
        ibco:bbox "[85.197, 585.844, 237.559, 596.869]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1015 ;
        ibco:precedes ibc:ibc2021-1030 ;
        ibco:sourcePage 346 ;
        ibco:text "2. Egress courts serving Group R-3." .

    ibc:ibc2021-ch10-list_item-1023 a ibco:ListItem ;
        ibco:bbox "[372.593, 154.765, 565.249, 176.75]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1022 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1024 ;
        ibco:sourcePage 346 ;
        ibco:text "1. Ticket booths less than 100 square feet (9.29 m2) in area." .

    ibc:ibc2021-ch10-list_item-1024 a ibco:ListItem ;
        ibco:bbox "[372.603, 179.768, 448.031, 190.794]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1022 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1025 ;
        ibco:sourcePage 346 ;
        ibco:text "2. Toilet rooms." .

    ibc:ibc2021-ch10-list_item-1025 a ibco:ListItem ;
        ibco:bbox "[372.603, 193.812, 565.269, 237.822]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1022 ;
        ibco:precedes ibc:ibc2021-1030.2 ;
        ibco:sourcePage 346 ;
        ibco:text "3. Other accessory use areas 1,000 square feet (92.9 m2) or less in area and equipped with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-ch10-list_item-1032 a ibco:ListItem ;
        ibco:bbox "[70.793, 198.687, 289.804, 264.772]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1030.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1033 ;
        ibco:sourcePage 347 ;
        ibco:text "1. Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings." .

    ibc:ibc2021-ch10-list_item-1033 a ibco:ListItem ;
        ibco:bbox "[70.793, 267.789, 289.825, 311.803]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1030.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1034 ;
        ibco:sourcePage 347 ;
        ibco:text "2. Not less than 0.005 inch (0.127 mm) of additional aisle capacity for each occupant shall be provided for each 0.10 inch (2.5 mm) of riser height above 7 inches (178 mm)." .

    ibc:ibc2021-ch10-list_item-1034 a ibco:ListItem ;
        ibco:bbox "[70.793, 314.701, 289.844, 380.786]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1030.6.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1035 ;
        ibco:sourcePage 347 ;
        ibco:text "3. Where egress requires stepped aisle descent, not less than 0.075 inch (1.9 mm) of additional aisle capacity for each occupant shall be provided on those portions of aisle capacity that do not have a handrail within a horizontal distance of 30 inches (762 mm)." .

    ibc:ibc2021-ch10-list_item-1035 a ibco:ListItem ;
        ibco:bbox "[70.793, 383.684, 289.83, 482.756]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-1030.6.1 ;
        ibco:precedes ibc:ibc2021-1030.6.2 ;
        ibco:sourcePage 347 ;
        ibco:text "4. Ramped aisles, where slopes are steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.22 inch (5.6 mm) of clear aisle capacity for each occupant served. Level or ramped aisles, where slopes are not steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.20 inch (5.1 mm) of clear aisle capacity for each occupant served." .

    ibc:ibc2021-ch10-list_item-1042 a ibco:ListItem ;
        ibco:bbox "[358.206, 368.731, 550.783, 423.78]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1041 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1043 ;
        ibco:sourcePage 347 ;
        ibco:text "1. The floor area used for contests, performances or entertainment provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:ibc2021-ch10-list_item-1043 a ibco:ListItem ;
        ibco:bbox "[358.206, 426.798, 572.399, 458.507]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1041 ;
        ibco:precedes ibc:ibc2021-1030.6.3 ;
        ibco:sourcePage 347 ;
        ibco:text "2. Press boxes and storage facilities less than 1,000 square feet (93 m2) in area. " .

    ibc:ibc2021-ch10-list_item-1048 a ibco:ListItem ;
        ibco:bbox "[111.603, 143.748, 304.179, 198.797]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1047 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1049 ;
        ibco:sourcePage 348 ;
        ibco:text "1. The floor area used for contests, performances or entertainment, provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:ibc2021-ch10-list_item-1049 a ibco:ListItem ;
        ibco:bbox "[111.603, 201.695, 304.142, 223.79]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1047 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1050 ;
        ibco:sourcePage 348 ;
        ibco:text "2. Press boxes and storage facilities less than 1,000 square feet (93 m2) in area." .

    ibc:ibc2021-ch10-list_item-1050 a ibco:ListItem ;
        ibco:bbox "[111.598, 226.808, 304.236, 259.786]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1047 ;
        ibco:precedes ibc:ibc2021-1030.7 ;
        ibco:sourcePage 348 ;
        ibco:text "3. Open-air assembly seating facilities where seating and the means of egress in the seating area are essentially open to the outside." .

    ibc:ibc2021-ch10-list_item-1054 a ibco:ListItem ;
        ibco:bbox "[111.578, 439.753, 304.084, 461.815]" ;
        ibco:label "1.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1053 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1055 ;
        ibco:sourcePage 348 ;
        ibco:text "1.1. The closest riser of an exit access stairway." .

    ibc:ibc2021-ch10-list_item-1055 a ibco:ListItem ;
        ibco:bbox "[111.588, 464.713, 296.366, 475.739]" ;
        ibco:label "1.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1053 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1056 ;
        ibco:sourcePage 348 ;
        ibco:text "1.2. The closest slope of an exit access ramp." .

    ibc:ibc2021-ch10-list_item-1056 a ibco:ListItem ;
        ibco:bbox "[111.598, 478.756, 165.335, 489.782]" ;
        ibco:label "1.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1053 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1057 ;
        ibco:sourcePage 348 ;
        ibco:text "1.3. An exit." .

    ibc:ibc2021-ch10-list_item-1058 a ibco:ListItem ;
        ibco:bbox "[111.598, 539.712, 304.104, 561.773]" ;
        ibco:label "2.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1057 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1059 ;
        ibco:sourcePage 348 ;
        ibco:text "2.1. The closest riser of an exit access stairway." .

    ibc:ibc2021-ch10-list_item-1059 a ibco:ListItem ;
        ibco:bbox "[111.608, 564.791, 295.908, 575.817]" ;
        ibco:label "2.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1057 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1060 ;
        ibco:sourcePage 348 ;
        ibco:text "2.2. The closest slope of an exit access ramp." .

    ibc:ibc2021-ch10-list_item-1060 a ibco:ListItem ;
        ibco:bbox "[111.608, 578.715, 165.345, 589.741]" ;
        ibco:label "2.3" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1057 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1061 ;
        ibco:sourcePage 348 ;
        ibco:text "2.3. An exit." .

    ibc:ibc2021-ch10-list_item-1061 a ibco:ListItem ;
        ibco:bbox "[85.204, 592.759, 304.286, 625.736]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1052 ;
        ibco:precedes ibc:ibc2021-1030.8 ;
        ibco:sourcePage 348 ;
        ibco:text "3. In facilities with open-air assembly seating of Type I or II construction, the total exit access travel distance shall not be limited." .

    ibc:ibc2021-ch10-list_item-1064 a ibco:ListItem ;
        ibco:bbox "[85.214, 692.697, 304.202, 725.794]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1063 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1065 ;
        ibco:sourcePage 348 ;
        ibco:text "1. For areas serving less than 50 occupants, the common path of egress travel shall not exceed 75 feet (22 860 mm)." .

    ibc:ibc2021-ch10-list_item-1065 a ibco:ListItem ;
        ibco:bbox "[346.216, 69.649, 565.212, 102.747]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1063 ;
        ibco:precedes ibc:ibc2021-1030.8.1 ;
        ibco:sourcePage 348 ;
        ibco:text "2. For smoke-protected or open-air assembly seating, the common path of egress travel shall not exceed 50 feet (15 240 mm)." .

    ibc:ibc2021-ch10-list_item-1070 a ibco:ListItem ;
        ibco:bbox "[346.194, 342.806, 565.235, 364.748]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1030.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1071 ;
        ibco:sourcePage 348 ;
        ibco:text "1. Forty-eight inches (1219 mm) for stepped aisles having seating on both sides." .

    ibc:ibc2021-ch10-list_item-1072 a ibco:ListItem ;
        ibco:bbox "[346.184, 394.758, 565.225, 416.819]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1071 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1073 ;
        ibco:sourcePage 348 ;
        ibco:text "2. Thirty-six inches (914 mm) for stepped aisles having seating on only one side." .

    ibc:ibc2021-ch10-list_item-1074 a ibco:ListItem ;
        ibco:bbox "[346.174, 468.78, 565.202, 512.793]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1073 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1075 ;
        ibco:sourcePage 348 ;
        ibco:text "3. Twenty-three inches (584 mm) between a stepped aisle handrail or guard and seating where the stepped aisle is subdivided by a mid-aisle handrail." .

    ibc:ibc2021-ch10-list_item-1075 a ibco:ListItem ;
        ibco:bbox "[346.194, 515.692, 565.153, 537.753]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1073 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1076 ;
        ibco:sourcePage 348 ;
        ibco:text "4. Forty-two inches (1067 mm) for level or ramped aisles having seating on both sides." .

    ibc:ibc2021-ch10-list_item-1077 a ibco:ListItem ;
        ibco:bbox "[381.951, 556.727, 565.171, 578.788]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1076 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1078 ;
        ibco:sourcePage 348 ;
        ibco:text "1. Thirty-six inches (914 mm) where the aisle serves less than 50 seats." .

    ibc:ibc2021-ch10-list_item-1078 a ibco:ListItem ;
        ibco:bbox "[381.961, 582.762, 565.236, 615.74]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1076 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1079 ;
        ibco:sourcePage 348 ;
        ibco:text "2. Thirty inches (762 mm) where the aisle serves less than 15 seats and does not serve as part of an accessible route." .

    ibc:ibc2021-ch10-list_item-1079 a ibco:ListItem ;
        ibco:bbox "[346.194, 618.758, 565.149, 640.7]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1076 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1080 ;
        ibco:sourcePage 348 ;
        ibco:text "5. Thirty-six inches (914 mm) for level or ramped aisles having seating on only one side." .

    ibc:ibc2021-ch10-list_item-1086 a ibco:ListItem ;
        ibco:bbox "[82.813, 276.793, 289.737, 298.735]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1085 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1087 ;
        ibco:sourcePage 349 ;
        ibco:text "1. Dead-end aisles shall be not greater than 20 feet (6096 mm) in length." .

    ibc:ibc2021-ch10-list_item-1087 a ibco:ListItem ;
        ibco:bbox "[82.813, 301.753, 289.841, 400.706]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1085 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1088 ;
        ibco:sourcePage 349 ;
        ibco:text "2. Dead-end aisles longer than 16 rows are permitted where seats beyond the 16th row dead-end aisle are not more than 24 seats from another aisle, measured along a row of seats having a minimum clear width of 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:ibc2021-ch10-list_item-1088 a ibco:ListItem ;
        ibco:bbox "[82.833, 403.724, 289.859, 436.701]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1085 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1089 ;
        ibco:sourcePage 349 ;
        ibco:text "3. For smoke-protected or open-air assembly seating, the dead-end aisle length of vertical aisles shall not exceed a distance of 21 rows." .

    ibc:ibc2021-ch10-list_item-1089 a ibco:ListItem ;
        ibco:bbox "[82.843, 439.719, 289.886, 549.707]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1085 ;
        ibco:precedes ibc:ibc2021-1030.9.6 ;
        ibco:sourcePage 349 ;
        ibco:text "4. For smoke-protected or open-air assembly seating, a longer dead-end aisle is permitted where seats beyond the 21-row dead-end aisle are not more than 40 seats from another aisle, measured along a row of seats having an aisle accessway with a minimum clear width of 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:ibc2021-ch10-list_item-1100 a ibco:ListItem ;
        ibco:bbox "[343.806, 390.745, 550.807, 423.723]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1030.10.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1101 ;
        ibco:sourcePage 349 ;
        ibco:text "1. A depth of not less than 22 inches (559 mm) where the treads on the descending side of the transition have greater depth." .

    ibc:ibc2021-ch10-list_item-1101 a ibco:ListItem ;
        ibco:bbox "[343.806, 426.741, 550.807, 459.718]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1030.10.2.1 ;
        ibco:precedes ibc:ibc2021-1030.10.2.2 ;
        ibco:sourcePage 349 ;
        ibco:text "2. A depth of not less than 30 inches (762 mm) where the treads on the descending side of the transition have lesser depth." .

    ibc:ibc2021-ch10-list_item-1134 a ibco:ListItem ;
        ibco:bbox "[358.198, 369.81, 550.804, 413.823]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1133 ;
        ibco:precedes ibc:ibc2021-1030.14.2.2.1 ;
        ibco:sourcePage 351 ;
        ibco:text "2. Riser heights not exceeding 9 inches (229 mm) shall be permitted where they are necessitated by the slope of the adjacent seating areas to maintain sightlines." .

    ibc:ibc2021-ch10-list_item-1141 a ibco:ListItem ;
        ibco:bbox "[85.203, 121.796, 304.272, 176.725]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1142 ;
        ibco:sourcePage 352 ;
        ibco:text "1. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with 200 or fewer seats, the seats shall not be required to be fastened to the floor." .

    ibc:ibc2021-ch10-list_item-1142 a ibco:ListItem ;
        ibco:bbox "[85.203, 179.743, 304.23, 234.792]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1143 ;
        ibco:sourcePage 352 ;
        ibco:text "2. In a building, room or space used for assembly purposes or portions thereof with seating at tables and without ramped or tiered floors for seating, the seats shall not be required to be fastened to the floor." .

    ibc:ibc2021-ch10-list_item-1143 a ibco:ListItem ;
        ibco:bbox "[85.203, 237.81, 304.288, 303.775]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1144 ;
        ibco:sourcePage 352 ;
        ibco:text "3. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with greater than 200 seats, the seats shall be fastened together in groups of not less than three or the seats shall be securely fastened to the floor." .

    ibc:ibc2021-ch10-list_item-1144 a ibco:ListItem ;
        ibco:bbox "[85.203, 306.793, 304.244, 383.794]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1145 ;
        ibco:sourcePage 352 ;
        ibco:text "4. In a building, room or space used for assembly purposes where flexibility of the seating arrangement is an integral part of the design and function of the space and seating is on tiered levels, not more than 200 seats shall not be required to be fastened to the floor. Plans showing seating, tiers and aisles shall be submitted for approval." .

    ibc:ibc2021-ch10-list_item-1145 a ibco:ListItem ;
        ibco:bbox "[85.203, 386.692, 304.3, 452.776]" ;
        ibco:label "5" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1146 ;
        ibco:sourcePage 352 ;
        ibco:text "5. Groups of seats within a building, room or space used for assembly purposes separated from other seating by railings, guards, partial height walls or similar barriers with level floors and having not more than 14 seats per group shall not be required to be fastened to the floor." .

    ibc:ibc2021-ch10-list_item-1146 a ibco:ListItem ;
        ibco:bbox "[85.203, 455.675, 304.227, 499.688]" ;
        ibco:label "6" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1140 ;
        ibco:precedes ibc:ibc2021-1030.16 ;
        ibco:sourcePage 352 ;
        ibco:text "6. Seats intended for musicians or other performers and separated by railings, guards, partial height walls or similar barriers shall not be required to be fastened to the floor." .

    ibc:ibc2021-ch10-list_item-1149 a ibco:ListItem ;
        ibco:bbox "[85.193, 632.624, 304.123, 654.686]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1148 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1150 ;
        ibco:sourcePage 352 ;
        ibco:text "1. Handrails are not required for ramped aisles with seating on both sides." .

    ibc:ibc2021-ch10-list_item-1150 a ibco:ListItem ;
        ibco:bbox "[85.193, 657.703, 304.206, 701.717]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1148 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1151 ;
        ibco:sourcePage 352 ;
        ibco:text "2. Handrails are not required where, at the side of the aisle, there is a guard with a top surface that complies with the graspability requirements of handrails in accordance with Section 1014.3." .

    ibc:ibc2021-ch10-list_item-1151 a ibco:ListItem ;
        ibco:bbox "[346.185, 69.575, 565.154, 102.673]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1148 ;
        ibco:precedes ibc:ibc2021-1030.16.1 ;
        ibco:sourcePage 352 ;
        ibco:text "3. Handrail extensions are not required at the top and bottom of stepped aisles and ramped aisles to permit crossovers within the aisles." .

    ibc:ibc2021-ch10-list_item-1160 a ibco:ListItem ;
        ibco:bbox "[358.196, 666.694, 565.184, 688.786]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1159 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1161 ;
        ibco:sourcePage 352 ;
        ibco:text "1. Guards that impact sightlines shall be permitted to comply with Section 1030.17.3." .

    ibc:ibc2021-ch10-list_item-1161 a ibco:ListItem ;
        ibco:bbox "[100.799, 69.725, 289.771, 113.738]",
            "[358.201, 691.804, 565.23, 713.866]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1159 ;
        ibco:precedes ibc:ibc2021-1030.17.2 ;
        ibco:sourcePage 352,
            353 ;
        ibco:text "2. Bleachers, grandstands and folding and telescopic seating shall not be required to have perimeter guards where the seating is located adjacent to a wall and the space between the wall and the seating is less than 4 inches (102 mm)." .

    ibc:ibc2021-ch10-list_item-1169 a ibco:ListItem ;
        ibco:bbox "[58.838, 562.675, 289.792, 595.653]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-1031.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1170 ;
        ibco:sourcePage 353 ;
        ibco:text "1. Group R-2 occupancies located in stories with only one exit or access to only one exit as permitted by Tables 1006.3.4(1) and 1006.3.4(2)." .

    ibc:ibc2021-ch10-list_item-1170 a ibco:ListItem ;
        ibco:bbox "[307.848, 69.565, 550.768, 91.791]",
            "[46.856, 598.671, 289.833, 679.635]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-1031.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1171 ;
        ibco:sourcePage 353 ;
        ibco:text "2. Group R-3 and R-4 occupancies. Basements and sleeping rooms below the fourth story above grade plane shall have not fewer than one emergency escape and rescue opening in accordance with this section. Where basements contain one or more sleeping rooms, an emergency escape and rescue opening shall be required in each sleeping room, but shall not be required in adjoining areas of the basement. Such openings shall open directly into a public way or to a yard or court that opens to a public way." .

    ibc:ibc2021-ch10-list_item-1172 a ibco:ListItem ;
        ibco:bbox "[331.781, 110.764, 550.799, 143.742]" ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1171 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1173 ;
        ibco:sourcePage 353 ;
        ibco:text "1. Basements with a ceiling height of less than 80 inches (2032 mm) shall not be required to have emergency escape and rescue openings." .

    ibc:ibc2021-ch10-list_item-1173 a ibco:ListItem ;
        ibco:bbox "[331.781, 146.76, 550.898, 201.809]" ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1171 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1174 ;
        ibco:sourcePage 353 ;
        ibco:text "2. Emergency escape and rescue openings are not required from basements or sleeping rooms that have an exit door or exit access door that opens directly into a public way or to a yard, court or exterior egress balcony that opens to a public way." .

    ibc:ibc2021-ch10-list_item-1174 a ibco:ListItem ;
        ibco:bbox "[331.791, 204.707, 550.786, 248.862]" ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1171 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1175 ;
        ibco:sourcePage 353 ;
        ibco:text "3. Basements without habitable spaces and having not more than 200 square feet (18.6 m2) in floor area shall not be required to have emergency escape and rescue openings." .

    ibc:ibc2021-ch10-list_item-1175 a ibco:ListItem ;
        ibco:bbox "[331.797, 251.76, 550.829, 284.857]" ;
        ibco:label "4" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1171 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1176 ;
        ibco:sourcePage 353 ;
        ibco:text "4. Storm shelters are not required to comply with this section where the shelter is constructed in accordance with ICC 500." .

    ibc:ibc2021-ch10-list_item-1177 a ibco:ListItem ;
        ibco:bbox "[358.201, 378.81, 550.78, 400.752]" ;
        ibco:label "5.1" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1176 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1178 ;
        ibco:sourcePage 353 ;
        ibco:text "5.1. One means of egress and one emergency escape and rescue opening." .

    ibc:ibc2021-ch10-list_item-1178 a ibco:ListItem ;
        ibco:bbox "[358.201, 403.77, 467.014, 414.796]" ;
        ibco:label "5.2" ;
        ibco:partOf ibc:ibc2021-ch10-list_item-1176 ;
        ibco:precedes ibc:ibc2021-1031.2.1 ;
        ibco:sourcePage 353 ;
        ibco:text "5.2. Two means of egress." .

    ibc:ibc2021-ch10-note-0002 a ibco:BuildingCodeEntity ;
        ibco:bbox "[61.199, 128.191, 565.243, 299.03]" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1001 ;
        ibco:sourcePage 304 ;
        ibco:text "User notes: About this chapter: Chapter 10 provides the general criteria for designing the means of egress established as the primary method for protection of people in buildings by allowing timely relocation or evacuation of building occupants. Both prescriptive and performance language is utilized in this chapter to provide for a basic approach in the determination of a safe exiting system for all occupancies. It addresses all portions of the egress system (exit access, exits and exit discharge) and includes design requirements as well as provisions regulating individual components. The requirements detail the size, arrangement, number and protection of means of egress components. Functional and operational characteristics that will permit the safe use of components without special knowledge or effort are specified. The means of egress protection requirements work in coordination with other sections of the code, such as protection of vertical openings (see Chapter 7), interior finish (see Chapter 8), fire suppression and detection systems (see Chapter 9) and numerous others, all having an impact on life safety. Chapter 10 is subdivided into four main sections: general (Sections 1003–1015), exit access (Sections 1016–1021), exit (Sections 1022–1027) and exit discharge (Sections 1028–1029). Special allowances for the unique requirements for assembly spaces (Section 1030) and emergency escape and rescue openings (Section 1031) complete the chapter. Chapter 10 of this code is duplicated in Chapter 10 of the International Fire Code®; however, the International Fire Code contains one additional section on maintenance of the means of egress system in existing buildings. Section 1010 was extensively reorganized for the 2021 edition. For complete information, see the moved sections table in the preface information for the International Building Code." .

    ibc:ibc2021-1003.2 a ibco:Provision ;
        ibco:bbox "[322.209, 358.72, 565.319, 391.698]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0012 ;
        ibco:heading "Ceiling height" ;
        ibco:label "1003.2" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0012 ;
        ibco:sourcePage 304 ;
        ibco:text "1003.2 Ceiling height. The means of egress shall have a ceiling height of not less than 7 feet 6 inches (2286 mm) above the finished floor." .

    ibc:ibc2021-1003.3.1 a ibco:Provision ;
        ibco:bbox "[334.221, 659.652, 565.324, 692.749]",
            "[58.799, 69.725, 289.774, 113.738]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0023 ;
        ibco:heading "Headroom" ;
        ibco:label "1003.3.1" ;
        ibco:partOf ibc:ibc2021-1003.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0023 ;
        ibco:sourcePage 304,
            305 ;
        ibco:text "1003.3.1 Headroom. Protruding objects are permitted to extend below the minimum ceiling height required by Section 1003.2 where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways. Not more than 50 percent of the ceiling area of a means of egress shall be reduced in height by protruding objects." .

    ibc:ibc2021-1003.3.2 a ibco:Provision ;
        ibco:bbox "[58.789, 202.771, 289.823, 323.795]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0025 ;
        ibco:heading "Post-mounted objects" ;
        ibco:label "1003.3.2" ;
        ibco:partOf ibc:ibc2021-1003.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0025 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.3.2 Post-mounted objects. A free-standing object mounted on a post or pylon shall not overhang that post or pylon more than 4 inches (102 mm) where the lowest point of the leading edge is more than 27 inches (686 mm) and less than 80 inches (2032 mm) above the finished floor. Where a sign or other obstruction is mounted between posts or pylons and the clear distance between the posts or pylons is greater than 12 inches (305 mm), the lowest edge of such sign or obstruction shall be 27 inches (686 mm) maximum or 80 inches (2032 mm) minimum above the finished floor or ground." .

    ibc:ibc2021-1003.3.3 a ibco:Provision ;
        ibco:bbox "[58.789, 364.72, 289.864, 419.769]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0027 ;
        ibco:heading "Horizontal projections" ;
        ibco:label "1003.3.3" ;
        ibco:partOf ibc:ibc2021-1003.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0027 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.3.3 Horizontal projections. Objects with leading edges more than 27 inches (685 mm) and not more than 80 inches (2030 mm) above the finished floor shall not project horizontally more than 4 inches (102 mm) into the circulation path." .

    ibc:ibc2021-1003.5 a ibco:Provision ;
        ibco:bbox "[46.786, 512.751, 289.808, 600.788]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0031 ;
        ibco:heading "Elevation change" ;
        ibco:label "1003.5" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0031 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.5 Elevation change. Where changes in elevation of less than 12 inches (305 mm) exist in the means of egress, sloped surfaces shall be used. Where the slope is greater than one unit vertical in 20 units horizontal (5-percent slope), ramps complying with Section 1012 shall be used. Where the difference in elevation is 6 inches (152 mm) or less, the ramp shall be equipped with either handrails or floor finish materials that contrast with adjacent floor finish materials." .

    ibc:ibc2021-1003.7 a ibco:Provision ;
        ibco:bbox "[307.787, 326.619, 550.775, 370.632]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0037 ;
        ibco:heading "Elevators, escalators and moving walks" ;
        ibco:label "1003.7" ;
        ibco:partOf ibc:ibc2021-1003 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0037 ;
        ibco:sourcePage 305 ;
        ibco:text "1003.7 Elevators, escalators and moving walks. Elevators, escalators and moving walks shall not be used as a component of a required means of egress from any other part of the building." .

    ibc:ibc2021-1004.6 a ibco:Provision ;
        ibco:bbox "[322.798, 69.516, 554.357, 727.47]",
            "[61.199, 518.622, 304.212, 728.841]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0050 ;
        ibco:heading "Fixed seating" ;
        ibco:label "1004.6" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0050 ;
        ibco:sourcePage 306 ;
        ibco:text "1004.6 Fixed seating. For areas having fixed seats and aisles, the occupant load shall be determined by the number of fixed seats installed therein. The occupant load for areas in which fixed seating is not installed, such as waiting spaces, shall be determined in accordance with Section 1004.5 and added to the number of fixed seats. The occupant load of wheelchair spaces and the associated companion seat shall be based on one occupant for each wheelchair space and one occupant for the associated companion seat provided in accordance with Section 1109.2.3. For areas having fixed seating without dividing arms, the occupant load shall be not less than the number of seats based on one person for each 18 inches (457 mm) of seating length. The occupant load of seating booths shall be based on one person for each 24 inches (610 mm) of booth seat length measured at the backrest of the seating booth. TABLE 1004.5 MAXIMUM FLOOR AREA ALLOWANCES PER OCCUPANT For SI: 1 foot = 304.8 mm, 1 square foot = 0.0929 m2." .

    ibc:ibc2021-1004.7 a ibco:Provision ;
        ibco:bbox "[46.789, 69.725, 289.863, 190.749]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0052 ;
        ibco:heading "Outdoor areas" ;
        ibco:label "1004.7" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0052 ;
        ibco:sourcePage 307 ;
        ibco:text "1004.7 Outdoor areas. Yards, patios, occupied roofs, courts and similar outdoor areas accessible to and usable by the building occupants shall be provided with means of egress as required by this chapter. The occupant load of such outdoor areas shall be assigned by the building official in accordance with the anticipated use. Where outdoor areas are to be used by persons in addition to the occupants of the building, and the path of egress travel from the outdoor areas passes through the building, means of egress requirements for the building shall be based on the sum of the occupant loads of the building plus the outdoor areas." .

    ibc:ibc2021-1005.1 a ibco:Provision ;
        ibco:bbox "[46.776, 498.816, 289.842, 520.758]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0059 ;
        ibco:heading "General" ;
        ibco:label "1005.1" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0059 ;
        ibco:sourcePage 307 ;
        ibco:text "1005.1 General. All portions of the means of egress system shall be sized in accordance with this section." .

    ibc:ibc2021-1005.3.1 a ibco:Provision ;
        ibco:bbox "[319.76, 69.63, 550.725, 91.691]",
            "[58.758, 668.694, 289.778, 734.779]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0063 ;
        ibco:heading "Stairways" ;
        ibco:label "1005.3.1" ;
        ibco:partOf ibc:ibc2021-1005.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0063 ;
        ibco:sourcePage 307 ;
        ibco:text "1005.3.1 Stairways. The capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.3 inch (7.6 mm) per occupant. Where stairways serve more than one story, only the occupant load of each story considered individually shall be used in calculating the required capacity of the stairways serving that story." .

    ibc:ibc2021-1005.3.2 a ibco:Provision ;
        ibco:bbox "[319.822, 395.731, 550.792, 450.78]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0069 ;
        ibco:heading "Other egress components" ;
        ibco:label "1005.3.2" ;
        ibco:partOf ibc:ibc2021-1005.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0069 ;
        ibco:sourcePage 307 ;
        ibco:text "1005.3.2 Other egress components. The capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant." .

    ibc:ibc2021-1005.7.1 a ibco:Provision ;
        ibco:bbox "[73.178, 342.768, 304.197, 386.782]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0078 ;
        ibco:heading "Doors" ;
        ibco:label "1005.7.1" ;
        ibco:partOf ibc:ibc2021-1005.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0078 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.7.1 Doors. Doors, when fully opened, shall not reduce the required width by more than 7 inches (178 mm). Doors in any position shall not reduce the required width by more than one-half." .

    ibc:ibc2021-1005.7.2 a ibco:Provision ;
        ibco:bbox "[73.168, 596.629, 304.19, 662.866]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0084 ;
        ibco:heading "Other projections" ;
        ibco:label "1005.7.2" ;
        ibco:partOf ibc:ibc2021-1005.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0084 ;
        ibco:sourcePage 308 ;
        ibco:text "1005.7.2 Other projections. Handrail projections shall be in accordance with the provisions of Section 1014.8. Other nonstructural projections such as trim and similar decorative features shall be permitted to project into the required width not more than 11/2 inches (38 mm) on each side." .

    ibc:ibc2021-1006.2.2.3 a ibco:Provision ;
        ibco:bbox "[331.779, 69.696, 550.885, 91.758]",
            "[70.769, 224.722, 328.989, 370.547]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0099 ;
        ibco:heading "Refrigerated rooms or spaces" ;
        ibco:label "1006.2.2.3" ;
        ibco:partOf ibc:ibc2021-1006.2.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0099 ;
        ibco:sourcePage 309 ;
        ibco:text "1006.2.2.3 Refrigerated rooms or spaces. Rooms or spaces having a floor area larger than 1,000 square feet (93 m2), containing a refrigerant evaporator and maintained at a temperature below 68°F (20°C), shall have access to not less than two exits or exit access doorways. Exit access travel distance shall be determined as specified in Section 1017.1, but all portions of a refrigerated room or space shall be within 150 feet (45 720 mm) of an exit or exit access doorway where such rooms are not protected by an approved automatic TABLE 1006.2.1 sprinkler system. Egress is allowed through adjoining refrigerated rooms or spaces." .

    ibc:ibc2021-1006.3.2 a ibco:Provision ;
        ibco:bbox "[73.197, 224.722, 304.224, 257.82]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0113 ;
        ibco:heading "Path of egress travel" ;
        ibco:label "1006.3.2" ;
        ibco:partOf ibc:ibc2021-1006.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0113 ;
        ibco:sourcePage 310 ;
        ibco:text "1006.3.2 Path of egress travel. The path of egress travel to an exit shall not pass through more than one adjacent story." .

    ibc:ibc2021-1007 a ibco:Section ;
        ibco:bbox "[98.042, 421.665, 238.322, 454.733]" ;
        ibco:hasChild ibc:ibc2021-1007.1 ;
        ibco:heading "EXIT AND EXIT ACCESS" ;
        ibco:label "1007" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1007.1 ;
        ibco:sourcePage 311 ;
        ibco:text "SECTION 1007 EXIT AND EXIT ACCESS DOORWAY CONFIGURATION" .

    ibc:ibc2021-1007.1.3 a ibco:Provision ;
        ibco:bbox "[319.781, 663.713, 550.905, 718.778]" ;
        ibco:hasChild ibc:ibc2021-1007.1.3.1 ;
        ibco:label "1007.1.3" ;
        ibco:partOf ibc:ibc2021-1007.1 ;
        ibco:precedes ibc:ibc2021-1007.1.3.1 ;
        ibco:sourcePage 311 ;
        ibco:text "1007.1.3 Remoteness of exit access stairways or ramps. Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps." .

    ibc:ibc2021-1008.2.1 a ibco:Provision ;
        ibco:bbox "[73.197, 339.81, 304.232, 416.811]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0159 ;
        ibco:heading "Illumination level under normal power" ;
        ibco:label "1008.2.1" ;
        ibco:partOf ibc:ibc2021-1008.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0159 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.2.1 Illumination level under normal power. The means of egress illumination level shall be not less than 1 footcandle (11 lux) at the walking surface. Along exit access stairways, exit stairways and at their required landings, the illumination level shall not be less than 10 footcandles (108 lux) at the walking surface when the stairway is in use." .

    ibc:ibc2021-1008.2.3 a ibco:Provision ;
        ibco:bbox "[334.199, 69.595, 565.18, 102.692]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0164 ;
        ibco:heading "Exit discharge" ;
        ibco:label "1008.2.3" ;
        ibco:partOf ibc:ibc2021-1008.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0164 ;
        ibco:sourcePage 312 ;
        ibco:text "1008.2.3 Exit discharge. Illumination shall be provided along the path of travel for the exit discharge from each exit to the public way." .

    ibc:ibc2021-1009.1 a ibco:Provision ;
        ibco:bbox "[46.797, 259.752, 289.878, 336.753]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0188 ;
        ibco:heading "Accessible means of egress required" ;
        ibco:label "1009.1" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0188 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.1 Accessible means of egress required. Accessible means of egress shall comply with this section. Accessible spaces shall be provided with not less than one accessible means of egress. Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress." .

    ibc:ibc2021-1009.2.1 a ibco:Provision ;
        ibco:bbox "[319.781, 69.615, 550.716, 91.677]",
            "[58.779, 694.705, 289.807, 727.682]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0203 ;
        ibco:heading "Elevators required" ;
        ibco:label "1009.2.1" ;
        ibco:partOf ibc:ibc2021-1009.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0203 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.2.1 Elevators required. In buildings where a required accessible floor or occupied roof is four or more stories above or below a level of exit discharge, not less than one required accessible means of egress shall be an elevator complying with Section 1009.4." .

    ibc:ibc2021-1009.3.1 a ibco:Provision ;
        ibco:bbox "[319.817, 286.758, 550.875, 319.735]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0208 ;
        ibco:heading "Exit access stairways" ;
        ibco:label "1009.3.1" ;
        ibco:partOf ibc:ibc2021-1009.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0208 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.3.1 Exit access stairways. Exit access stairways that connect levels in the same story are not permitted as part of an accessible means of egress." .

    ibc:ibc2021-1009.3.2 a ibco:Provision ;
        ibco:bbox "[319.787, 360.78, 550.763, 393.758]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0210 ;
        ibco:heading "Stairway width" ;
        ibco:label "1009.3.2" ;
        ibco:partOf ibc:ibc2021-1009.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0210 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.3.2 Stairway width. Stairways shall have a clear width of 48 inches (1219 mm) minimum between handrails." .

    ibc:ibc2021-1009.3.3 a ibco:Provision ;
        ibco:bbox "[319.777, 518.666, 550.782, 562.68]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0214 ;
        ibco:heading "Area of refuge" ;
        ibco:label "1009.3.3" ;
        ibco:partOf ibc:ibc2021-1009.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0214 ;
        ibco:sourcePage 313 ;
        ibco:text "1009.3.3 Area of refuge. Stairways shall either incorporate an area of refuge within an enlarged floor-level landing or shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:ibc2021-1009.4.2 a ibco:Provision ;
        ibco:bbox "[73.178, 252.81, 304.129, 274.751]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0224 ;
        ibco:heading "Area of refuge" ;
        ibco:label "1009.4.2" ;
        ibco:partOf ibc:ibc2021-1009.4 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0224 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.4.2 Area of refuge. The elevator shall be accessed from an area of refuge complying with Section 1009.6." .

    ibc:ibc2021-1009.6.2 a ibco:Provision ;
        ibco:bbox "[73.168, 629.656, 304.246, 673.789]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0234 ;
        ibco:heading "Stairway or elevator access" ;
        ibco:label "1009.6.2" ;
        ibco:partOf ibc:ibc2021-1009.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0234 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6.2 Stairway or elevator access. Every required area of refuge shall have direct access to a stairway complying with Sections 1009.3 and 1023 or an elevator complying with Section 1009.4." .

    ibc:ibc2021-1009.6.4 a ibco:Provision ;
        ibco:bbox "[334.201, 162.43, 565.217, 217.479]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0237 ;
        ibco:heading "Separation" ;
        ibco:label "1009.6.4" ;
        ibco:partOf ibc:ibc2021-1009.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0237 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.6.4 Separation. Each area of refuge shall be separated from the remainder of the story by a smoke barrier complying with Section 709 or a horizontal exit complying with Section 1026. Each area of refuge shall be designed to minimize the intrusion of smoke." .

    ibc:ibc2021-1009.7.2 a ibco:Provision ;
        ibco:bbox "[334.189, 474.218, 565.248, 650.353]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0244 ;
        ibco:heading "Separation" ;
        ibco:label "1009.7.2" ;
        ibco:partOf ibc:ibc2021-1009.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0244 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.7.2 Separation. Exterior walls separating the exterior area of assisted rescue from the interior of the building shall have a minimum fire-resistance rating of 1 hour, rated for exposure to fire from the inside. The fireresistance-rated exterior wall construction shall extend horizontally not less than 10 feet (3048 mm) beyond the landing on either side of the landing or equivalent fireresistance-rated construction is permitted to extend out perpendicular to the exterior wall not less than 4 feet (1219 mm) on the side of the landing. The fire-resistancerated construction shall extend vertically from the ground to a point not less than 10 feet (3048 mm) above the floor level of the area for assisted rescue or to the roof line, whichever is lower. Openings within such fire-resistancerated exterior walls shall be protected in accordance with Section 716." .

    ibc:ibc2021-1009.7.4 a ibco:Provision ;
        ibco:bbox "[58.799, 106.796, 289.918, 150.809]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0247 ;
        ibco:heading "Stairways" ;
        ibco:label "1009.7.4" ;
        ibco:partOf ibc:ibc2021-1009.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0247 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.7.4 Stairways. Stairways that are part of the means of egress for the exterior area for assisted rescue shall provide a minimum clear width of 48 inches (1219 mm) between handrails." .

    ibc:ibc2021-1010.1.1.1 a ibco:Provision ;
        ibco:bbox "[346.2, 128.74, 565.345, 205.741]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0285 ;
        ibco:heading "Projections into clear opening" ;
        ibco:label "1010.1.1.1" ;
        ibco:partOf ibc:ibc2021-1010.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0285 ;
        ibco:sourcePage 316 ;
        ibco:text "1010.1.1.1 Projections into clear opening. There shall not be projections into the required clear opening width lower than 34 inches (864 mm) above the floor or ground. Projections into the clear opening width between 34 inches (864 mm) and 80 inches (2032 mm) above the floor or ground shall not exceed 4 inches (102 mm)." .

    ibc:ibc2021-1010.1.4 a ibco:Provision ;
        ibco:bbox "[58.797, 296.713, 289.838, 362.798]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0306 ;
        ibco:heading "Floor elevation" ;
        ibco:label "1010.1.4" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0306 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.4 Floor elevation. There shall be a floor or landing on each side of a door. Such floor or landing shall be at the same elevation on each side of the door. Landings shall be level except for exterior landings, which are permitted to have a slope not to exceed 0.25 unit vertical in 12 units horizontal (2-percent slope)." .

    ibc:ibc2021-1010.1.5 a ibco:Provision ;
        ibco:bbox "[319.792, 150.68, 550.849, 249.752]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0314 ;
        ibco:heading "Landings at doors" ;
        ibco:label "1010.1.5" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0314 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.5 Landings at doors. Landings shall have a width not less than the width of the stairway or the door, whichever is greater. Doors in the fully open position shall not reduce a required dimension by more than 7 inches (178 mm). Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width. Landings shall have a length measured in the direction of travel of not less than 44 inches (1118 mm)." .

    ibc:ibc2021-1010.1.6 a ibco:Provision ;
        ibco:bbox "[319.792, 290.677, 550.897, 378.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0316 ;
        ibco:heading "Thresholds" ;
        ibco:label "1010.1.6" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0316 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.6 Thresholds. Thresholds at doorways shall not exceed 3/4 inch (19.1 mm) in height above the finished floor or landing for sliding doors serving dwelling units or 1/2 inch (12.7 mm) above the finished floor or landing for other doors. Raised thresholds and floor level changes greater than 1/4 inch (6.4 mm) at doorways shall be beveled with a slope not greater than one unit vertical in two units horizontal (50-percent slope)." .

    ibc:ibc2021-1010.1.7 a ibco:Provision ;
        ibco:bbox "[319.798, 625.8, 550.971, 680.849]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0323 ;
        ibco:heading "Door arrangement" ;
        ibco:label "1010.1.7" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0323 ;
        ibco:sourcePage 317 ;
        ibco:text "1010.1.7 Door arrangement. Space between two doors in a series shall be 48 inches (1219 mm) minimum plus the width of a door swinging into the space. Doors in a series shall swing either in the same direction or away from the space between the doors." .

    ibc:ibc2021-1010.2.1 a ibco:Provision ;
        ibco:bbox "[73.205, 201.695, 304.196, 245.828]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0329 ;
        ibco:heading "Unlatching" ;
        ibco:label "1010.2.1" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0329 ;
        ibco:sourcePage 318 ;
        ibco:text "1010.2.1 Unlatching. The unlatching of any door or leaf for egress shall require not more than one motion in a single linear or rotational direction to release all latching and all locking devices." .

    ibc:ibc2021-1010.2.3 a ibco:Provision ;
        ibco:bbox "[73.215, 413.703, 304.221, 479.788]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0336 ;
        ibco:heading "Hardware height" ;
        ibco:label "1010.2.3" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0336 ;
        ibco:sourcePage 318 ;
        ibco:text "1010.2.3 Hardware height. Door handles, pulls, latches, locks and other operating devices shall be installed 34 inches (864 mm) minimum and 48 inches (1219 mm) maximum above the finished floor. Locks used only for security purposes and not used for normal operation are permitted at any height." .

    ibc:ibc2021-1010.2.5 a ibco:Provision ;
        ibco:bbox "[58.794, 349.8, 289.786, 371.862]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0358 ;
        ibco:heading "Bolt locks" ;
        ibco:label "1010.2.5" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0358 ;
        ibco:sourcePage 319 ;
        ibco:text "1010.2.5 Bolt locks. Manually operated flush bolts or surface bolts are not permitted." .

    ibc:ibc2021-1010.2.7 a ibco:Provision ;
        ibco:bbox "[319.806, 121.696, 550.861, 154.674]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0366 ;
        ibco:heading "Stairway doors" ;
        ibco:label "1010.2.7" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0366 ;
        ibco:sourcePage 319 ;
        ibco:text "1010.2.7 Stairway doors. Interior stairway means of egress doors shall be openable from both sides without the use of a key or special knowledge or effort." .

    ibc:ibc2021-1010.3.1.2 a ibco:Provision ;
        ibco:bbox "[70.809, 469.775, 289.784, 535.74]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0461 ;
        ibco:heading "Other than egress component" ;
        ibco:label "1010.3.1.2" ;
        ibco:partOf ibc:ibc2021-1010.3.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0461 ;
        ibco:sourcePage 323 ;
        ibco:text "1010.3.1.2 Other than egress component. A revolving door used as other than a component of a means of egress shall comply with Section 1010.3.1. The breakout force of a revolving door not used as a component of a means of egress shall not be more than 180 pounds (801 N)." .

    ibc:ibc2021-1010.3.2 a ibco:Provision ;
        ibco:bbox "[319.809, 117.619, 550.939, 326.689]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0467 ;
        ibco:heading "Power-operated doors" ;
        ibco:label "1010.3.2" ;
        ibco:partOf ibc:ibc2021-1010.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0467 ;
        ibco:sourcePage 323 ;
        ibco:text "1010.3.2 Power-operated doors. Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress. The forces required to open these doors manually shall not exceed those specified in Section 1010.1.3, except that the force to set the door in motion shall not exceed 50 pounds (220 N). The door shall be capable of opening from any position to the full width of the opening in which such door is installed when a force is applied to the door on the side from which egress is made. Power-operated swinging doors, power-operated sliding doors and power-operated folding doors shall comply with BHMA A156.10. Power-assisted swinging doors and low-energy power-operated swinging doors shall comply with BHMA A156.19. Low-energy poweroperated sliding doors and low-energy power-operated folding doors shall comply with BHMA A156.38." .

    ibc:ibc2021-1010.5.4 a ibco:Provision ;
        ibco:bbox "[58.8, 240.32, 289.822, 284.333]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0506 ;
        ibco:heading "Additional door" ;
        ibco:label "1010.5.4" ;
        ibco:partOf ibc:ibc2021-1010.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0506 ;
        ibco:sourcePage 325 ;
        ibco:text "1010.5.4 Additional door. Where serving an occupant load greater than 300, each turnstile that is not portable shall have a side-hinged swinging door that conforms to Section 1010.1 within 50 feet (15 240 mm)." .

    ibc:ibc2021-1011.1 a ibco:Provision ;
        ibco:bbox "[46.798, 368.694, 289.811, 434.779]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0509 ;
        ibco:heading "General" ;
        ibco:label "1011.1" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0509 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.1 General. Stairways serving occupied portions of a building shall comply with the requirements of Sections 1011.2 through 1011.13. Alternating tread devices shall comply with Section 1011.14. Ship’s ladders shall comply with Section 1011.15. Ladders shall comply with Section 1011.16." .

    ibc:ibc2021-1011.10 a ibco:Provision ;
        ibco:bbox "[307.746, 287.702, 550.791, 342.826]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0571 ;
        ibco:heading "Spiral stairways" ;
        ibco:label "1011.10" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0571 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.10 Spiral stairways. Spiral stairways are permitted to be used as a component in the means of egress only within dwelling units or from a space not more than 250 square feet (23 m2) in area and serving not more than five occupants, or from technical production areas in accordance with Section" .

    ibc:ibc2021-1011.11 a ibco:Provision ;
        ibco:bbox "[307.799, 438.836, 550.843, 482.849]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0573 ;
        ibco:heading "Handrails" ;
        ibco:label "1011.11" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0573 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.11 Handrails. Flights of stairways shall have handrails on each side and shall comply with Section 1014. Where glass is used to provide the handrail, the handrail shall comply with Section 2407." .

    ibc:ibc2021-1011.12.2 a ibco:Provision ;
        ibco:bbox "[73.199, 394.739, 304.199, 427.717]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0587 ;
        ibco:heading "Roof access" ;
        ibco:label "1011.12.2" ;
        ibco:partOf ibc:ibc2021-1011.12 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0587 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.12.2 Roof access. Where a stairway is provided to a roof, access to the roof shall be provided through a penthouse complying with Section 1511.2." .

    ibc:ibc2021-1011.14.2 a ibco:Provision ;
        ibco:bbox "[334.198, 69.706, 565.261, 223.753]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0592 ;
        ibco:heading "Treads of alternating tread devices" ;
        ibco:label "1011.14.2" ;
        ibco:partOf ibc:ibc2021-1011.14 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0592 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.14.2 Treads of alternating tread devices. Alternating tread devices shall have a minimum tread depth of 5 inches (127 mm), a minimum projected tread depth of 81/2 inches (216 mm), a minimum tread width of 7 inches (178 mm) and a maximum riser height of 91/2 inches (241 mm). The tread depth shall be measured horizontally between the vertical planes of the foremost projections of adjacent treads. The riser height shall be measured vertically between the leading edges of adjacent treads. The riser height and tread depth provided shall result in an angle of ascent from the horizontal of between 50 and 70 degrees (0.87 and 1.22 rad). The initial tread of the device shall begin at the same elevation as the platform, landing or floor surface." .

    ibc:ibc2021-1011.2 a ibco:Provision ;
        ibco:bbox "[46.798, 465.027, 289.805, 519.957]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0511 ;
        ibco:heading "Width and capacity" ;
        ibco:label "1011.2" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0511 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.2 Width and capacity. The required capacity of stairways shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm). See Section 1009.3 for accessible means of egress stairways." .

    ibc:ibc2021-1011.3 a ibco:Provision ;
        ibco:bbox "[307.78, 69.556, 550.811, 102.653]",
            "[46.778, 692.613, 289.767, 736.627]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0516 ;
        ibco:heading "Headroom" ;
        ibco:label "1011.3" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0516 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.3 Headroom. Stairways shall have a headroom clearance of not less than 80 inches (2032 mm) measured vertically from a line connecting the edge of the nosings. Such headroom shall be continuous above the stairway to the point where the line intersects the landing below, one tread depth beyond the bottom riser. The minimum clearance shall be maintained the full width of the stairway and landing." .

    ibc:ibc2021-1011.5.2 a ibco:Provision ;
        ibco:bbox "[319.777, 433.148, 550.845, 587.04]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0523 ;
        ibco:heading "Riser height and tread depth" ;
        ibco:label "1011.5.2" ;
        ibco:partOf ibc:ibc2021-1011.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0523 ;
        ibco:sourcePage 325 ;
        ibco:text "1011.5.2 Riser height and tread depth. Stair riser heights shall be 7 inches (178 mm) maximum and 4 inches (102 mm) minimum. The riser height shall be measured vertically between the nosings of adjacent treads or between the stairway landing and the adjacent tread. Rectangular tread depths shall be 11 inches (279 mm) minimum measured horizontally between the vertical planes of the foremost projection of adjacent treads and at a right angle to the tread’s nosing. Winder treads shall have a minimum tread depth of 11 inches (279 mm) between the vertical planes of the foremost projection of adjacent treads at the intersections with the walkline and a minimum tread depth of 10 inches (254 mm) within the clear width of the stair." .

    ibc:ibc2021-1011.5.3 a ibco:Provision ;
        ibco:bbox "[73.198, 288.832, 304.194, 321.81]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0530 ;
        ibco:heading "Winder treads" ;
        ibco:label "1011.5.3" ;
        ibco:partOf ibc:ibc2021-1011.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0530 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.3 Winder treads. Winder treads are not permitted in means of egress stairways except within a dwelling unit." .

    ibc:ibc2021-1011.5.5.1 a ibco:Provision ;
        ibco:bbox "[346.201, 198.708, 565.203, 209.734]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0541 ;
        ibco:heading "Nosing projection size" ;
        ibco:label "1011.5.5.1" ;
        ibco:partOf ibc:ibc2021-1011.5.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0541 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.5.1 Nosing projection size. The leading edge" .

    ibc:ibc2021-1011.5.5.3 a ibco:Provision ;
        ibco:bbox "[346.199, 283.792, 526.903, 294.818]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0544 ;
        ibco:heading "Solid risers" ;
        ibco:label "1011.5.5.3" ;
        ibco:partOf ibc:ibc2021-1011.5.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0544 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.5.3 Solid risers. Risers shall be solid." .

    ibc:ibc2021-1011.6 a ibco:Provision ;
        ibco:bbox "[322.185, 477.793, 565.253, 642.72]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0549 ;
        ibco:heading "Stairway landings" ;
        ibco:label "1011.6" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0549 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.6 Stairway landings. There shall be a floor or landing at the top and bottom of each stairway. The width of landings, measured perpendicularly to the direction of travel, shall be not less than the width of stairways served. Every landing shall have a minimum depth, measured parallel to the direction of travel, equal to the width of the stairway or 48 inches (1219 mm), whichever is less. Doors opening onto a landing shall not reduce the landing to less than one-half the required width. When fully open, the door shall not project more than 7 inches (178 mm) into the required width of a landing. Where wheelchair spaces are required on the stairway landing in accordance with Section 1009.6.3, the wheelchair space shall not be located in the required width of the landing and doors shall not swing over the wheelchair spaces." .

    ibc:ibc2021-1011.7.1 a ibco:Provision ;
        ibco:bbox "[58.787, 322.749, 289.806, 388.714]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0559 ;
        ibco:heading "Stairway walking surface" ;
        ibco:label "1011.7.1" ;
        ibco:partOf ibc:ibc2021-1011.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0559 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.7.1 Stairway walking surface. The walking surface of treads and landings of a stairway shall not be sloped steeper than one unit vertical in 48 units horizontal (2percent slope) in any direction. Stairway treads and landings shall have a solid surface. Finish floor surfaces shall be securely attached." .

    ibc:ibc2021-1011.7.3 a ibco:Provision ;
        ibco:bbox "[58.802, 583.792, 289.887, 660.792]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0564 ;
        ibco:heading "Enclosures under interior stairways" ;
        ibco:label "1011.7.3" ;
        ibco:partOf ibc:ibc2021-1011.7 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0564 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.7.3 Enclosures under interior stairways. The walls and soffits within enclosed usable spaces under enclosed and unenclosed stairways shall be protected by 1-hour fire-resistance-rated construction or the fire-resistance rating of the stairway enclosure, whichever is greater. Access to the enclosed space shall not be directly from within the stairway enclosure." .

    ibc:ibc2021-1011.8 a ibco:Provision ;
        ibco:bbox "[307.776, 139.776, 550.923, 172.753]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0567 ;
        ibco:heading "Vertical rise" ;
        ibco:label "1011.8" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0567 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.8 Vertical rise. A flight of stairs shall not have a vertical rise greater than 12 feet (3658 mm) between floor levels or landings." .

    ibc:ibc2021-1011.9 a ibco:Provision ;
        ibco:bbox "[307.766, 202.763, 550.807, 246.776]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0569 ;
        ibco:heading "Curved stairways" ;
        ibco:label "1011.9" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0569 ;
        ibco:sourcePage 327 ;
        ibco:text "1011.9 Curved stairways. Curved stairways with winder treads shall have treads and risers in accordance with Section 1011.5 and the smallest radius shall be not less than twice the minimum width or required capacity of the stairway." .

    ibc:ibc2021-1012.1 a ibco:Provision ;
        ibco:bbox "[46.787, 185.749, 289.875, 207.81]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0605 ;
        ibco:heading "Scope" ;
        ibco:label "1012.1" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0605 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.1 Scope. The provisions of this section shall apply to ramps used as a component of a means of egress." .

    ibc:ibc2021-1012.6.3 a ibco:Provision ;
        ibco:bbox "[319.784, 191.722, 550.838, 213.784]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0620 ;
        ibco:heading "Length" ;
        ibco:label "1012.6.3" ;
        ibco:partOf ibc:ibc2021-1012.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0620 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6.3 Length. The landing length shall be 60 inches (1525 mm) minimum." .

    ibc:ibc2021-1012.6.4 a ibco:Provision ;
        ibco:bbox "[319.794, 338.692, 550.731, 382.705]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0624 ;
        ibco:heading "Change in direction" ;
        ibco:label "1012.6.4" ;
        ibco:partOf ibc:ibc2021-1012.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0624 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.6.4 Change in direction. Where changes in direction of travel occur at landings provided between ramp runs, the landing shall be 60 inches by 60 inches (1524 mm by 1524 mm) minimum." .

    ibc:ibc2021-1013.1 a ibco:Provision ;
        ibco:bbox "[61.19, 435.795, 304.197, 567.735]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0640 ;
        ibco:heading "Where required" ;
        ibco:label "1013.1" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0640 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.1 Where required. Exits and exit access doors shall be marked by an approved exit sign readily visible from any direction of egress travel. The path of egress travel to exits and within exits shall be marked by readily visible exit signs to clearly indicate the direction of egress travel in cases where the exit or the path of egress travel is not immediately visible to the occupants. Intervening means of egress doors within exits shall be marked by exit signs. Exit sign placement shall be such that any point in an exit access corridor or exit passageway is within 100 feet (30 480 mm) or the listed viewing distance of the sign, whichever is less, from the nearest visible exit sign." .

    ibc:ibc2021-1013.3 a ibco:Provision ;
        ibco:bbox "[322.172, 268.627, 565.185, 290.688]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0648 ;
        ibco:heading "Illumination" ;
        ibco:label "1013.3" ;
        ibco:partOf ibc:ibc2021-1013 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0648 ;
        ibco:sourcePage 330 ;
        ibco:text "1013.3 Illumination. Exit signs shall be internally or externally illuminated." .

    ibc:ibc2021-1013.6.3 a ibco:Provision ;
        ibco:bbox "[58.799, 106.796, 289.989, 205.749]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0655 ;
        ibco:heading "Power source" ;
        ibco:label "1013.6.3" ;
        ibco:partOf ibc:ibc2021-1013.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0655 ;
        ibco:sourcePage 331 ;
        ibco:text "1013.6.3 Power source. Exit signs shall be illuminated at all times. To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator. The installation of the emergency power system shall be in accordance with Chapter 27. Group I-2, Condition 2 exit sign illumination shall not be provided by unit equipment batteries only." .

    ibc:ibc2021-1014.2 a ibco:Provision ;
        ibco:bbox "[46.757, 436.701, 289.847, 513.702]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0659 ;
        ibco:heading "Height" ;
        ibco:label "1014.2" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0659 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.2 Height. Handrail height, measured above stair tread nosings, or finish surface of ramp slope, shall be uniform, not less than 34 inches (864 mm) and not more than 38 inches (965 mm). Handrail height of alternating tread devices and ships ladders, measured above tread nosings, shall be uniform, not less than 30 inches (762 mm) and not more than 34 inches (864 mm)." .

    ibc:ibc2021-1014.4 a ibco:Provision ;
        ibco:bbox "[307.797, 456.842, 550.928, 489.82]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0668 ;
        ibco:heading "Continuity" ;
        ibco:label "1014.4" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0668 ;
        ibco:sourcePage 331 ;
        ibco:text "1014.4 Continuity. Handrail gripping surfaces shall be continuous, without interruption by newel posts or other obstructions." .

    ibc:ibc2021-1014.6 a ibco:Provision ;
        ibco:bbox "[61.177, 158.628, 304.235, 290.688]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0676 ;
        ibco:heading "Handrail extensions" ;
        ibco:label "1014.6" ;
        ibco:partOf ibc:ibc2021-1014 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0676 ;
        ibco:sourcePage 332 ;
        ibco:text "1014.6 Handrail extensions. Handrails shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent flight of stairs or ramp run. Where handrails are not continuous between flights, the handrails shall extend horizontally not less than 12 inches (305 mm) beyond the top riser and continue to slope for the depth of one tread beyond the bottom riser. At ramps where handrails are not continuous between runs, the handrails shall extend horizontally above the landing 12 inches (305 mm) minimum beyond the top and bottom of ramp runs. The extensions of handrails shall be in the same direction of the flights of stairs at stairways and the ramp runs at ramps." .

    ibc:ibc2021-1015.4 a ibco:Provision ;
        ibco:bbox "[46.777, 473.663, 289.781, 517.676]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0708 ;
        ibco:heading "Opening limitations" ;
        ibco:label "1015.4" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0708 ;
        ibco:sourcePage 333 ;
        ibco:text "1015.4 Opening limitations. Required guards shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter from the walking surface to the required guard height." .

    ibc:ibc2021-1015.6 a ibco:Provision ;
        ibco:bbox "[307.792, 303.827, 550.854, 402.78]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0717 ;
        ibco:label "1015.6" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0717 ;
        ibco:sourcePage 333 ;
        ibco:text "1015.6 Mechanical equipment, systems and devices. Guards shall be provided where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of such components. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:ibc2021-1015.7 a ibco:Provision ;
        ibco:bbox "[307.782, 443.706, 550.88, 542.778]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0719 ;
        ibco:heading "Roof access" ;
        ibco:label "1015.7" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0719 ;
        ibco:sourcePage 333 ;
        ibco:text "1015.7 Roof access. Guards shall be provided where the roof hatch opening is located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of the hatch parallel to the roof edge. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:ibc2021-1016.2.1 a ibco:Provision ;
        ibco:bbox "[334.201, 394.784, 565.224, 460.749]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0743 ;
        ibco:heading "Multiple tenants" ;
        ibco:label "1016.2.1" ;
        ibco:partOf ibc:ibc2021-1016.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0743 ;
        ibco:sourcePage 334 ;
        ibco:text "1016.2.1 Multiple tenants. Where more than one tenant occupies any one floor of a building or structure, each tenant space, dwelling unit and sleeping unit shall be provided with access to the required exits without passing through adjacent tenant spaces, dwelling units and sleeping units." .

    ibc:ibc2021-1018.1 a ibco:Provision ;
        ibco:bbox "[61.197, 95.76, 304.212, 172.761]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0769 ;
        ibco:heading "General" ;
        ibco:label "1018.1" ;
        ibco:partOf ibc:ibc2021-1018 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0769 ;
        ibco:sourcePage 336 ;
        ibco:text "1018.1 General. Aisles and aisle accessways serving as a portion of the exit access in the means of egress system shall comply with the requirements of this section. Aisles or aisle accessways shall be provided from all occupied portions of the exit access that contain seats, tables, furnishings, displays and similar fixtures or equipment. The minimum width or required capacity of aisles shall be unobstructed." .

    ibc:ibc2021-1018.3 a ibco:Provision ;
        ibco:bbox "[61.198, 239.722, 304.201, 283.735]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0772 ;
        ibco:heading "Aisles in Groups B and M" ;
        ibco:label "1018.3" ;
        ibco:partOf ibc:ibc2021-1018 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0772 ;
        ibco:sourcePage 336 ;
        ibco:text "1018.3 Aisles in Groups B and M. In Group B and M occupancies, the minimum clear aisle width shall be determined by Section 1005.1 for the occupant load served, but shall be not less than that required for corridors by Section 1020.3." .

    ibc:ibc2021-1018.4 a ibco:Provision ;
        ibco:bbox "[61.158, 324.781, 304.182, 445.685]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0774 ;
        ibco:heading "Aisle accessways in Group M" ;
        ibco:label "1018.4" ;
        ibco:partOf ibc:ibc2021-1018 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0774 ;
        ibco:sourcePage 336 ;
        ibco:text "1018.4 Aisle accessways in Group M. An aisle accessway shall be provided on not less than one side of each element within the merchandise pad. The minimum clear width for an aisle accessway not required to be accessible shall be 30 inches (762 mm). The required clear width of the aisle accessway shall be measured perpendicular to the elements and merchandise within the merchandise pad. The 30-inch (762 mm) minimum clear width shall be maintained to provide a path to an adjacent aisle or aisle accessway. The common path of egress travel shall not exceed 30 feet (9144 mm) from any point in the merchandise pad." .

    ibc:ibc2021-1018.5 a ibco:Provision ;
        ibco:bbox "[61.168, 486.73, 304.135, 552.695]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0776 ;
        ibco:label "1018.5" ;
        ibco:partOf ibc:ibc2021-1018 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0776 ;
        ibco:sourcePage 336 ;
        ibco:text "1018.5 Aisles in other than assembly spaces and Groups B and M. In other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005.1 for the occupant load served, but the width shall be not less than that required for corridors by Section 1020.3." .

    ibc:ibc2021-1019.3 a ibco:Provision ;
        ibco:bbox "[322.234, 106.772, 565.311, 161.702]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0781 ;
        ibco:heading "Occupancies other than Groups I-2 and I-3" ;
        ibco:label "1019.3" ;
        ibco:partOf ibc:ibc2021-1019 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0781 ;
        ibco:sourcePage 336 ;
        ibco:text "1019.3 Occupancies other than Groups I-2 and I-3. In other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:ibc2021-1019.4 a ibco:Provision ;
        ibco:bbox "[322.196, 615.822, 565.198, 670.752]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0792 ;
        ibco:heading "Group I-2 and I-3 occupancies" ;
        ibco:label "1019.4" ;
        ibco:partOf ibc:ibc2021-1019 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0792 ;
        ibco:sourcePage 336 ;
        ibco:text "1019.4 Group I-2 and I-3 occupancies. In Group I-2 and I- 3 occupancies, floor openings between stories containing exit access stairways or ramps are required to be enclosed with a shaft enclosure constructed in accordance with Section 713." .

    ibc:ibc2021-1020.3 a ibco:Provision ;
        ibco:bbox "[307.797, 106.796, 550.871, 150.809]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0809 ;
        ibco:heading "Width and capacity" ;
        ibco:label "1020.3" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0809 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.3 Width and capacity. The required capacity of corridors shall be determined as specified in Section 1005.1, but the minimum width shall be not less than that specified in Table 1020.3." .

    ibc:ibc2021-1020.4 a ibco:Provision ;
        ibco:bbox "[307.799, 415.805, 550.797, 437.866]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0811 ;
        ibco:heading "Obstruction" ;
        ibco:label "1020.4" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0811 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.4 Obstruction. The minimum width or required capacity of corridors shall be unobstructed." .

    ibc:ibc2021-1020.5 a ibco:Provision ;
        ibco:bbox "[307.789, 467.756, 550.83, 511.769]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0813 ;
        ibco:heading "Dead ends" ;
        ibco:label "1020.5" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0813 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.5 Dead ends. Where more than one exit or exit access doorway is required, the exit access shall be arranged such that dead-end corridors do not exceed 20 feet (6096 mm) in length." .

    ibc:ibc2021-1020.7 a ibco:Provision ;
        ibco:bbox "[61.173, 561.792, 304.287, 660.745]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0831 ;
        ibco:heading "Corridor continuity" ;
        ibco:label "1020.7" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0831 ;
        ibco:sourcePage 338 ;
        ibco:text "1020.7 Corridor continuity. Fire-resistance-rated corridors shall be continuous from the point of entry to an exit, and shall not be interrupted by intervening rooms. Where the path of egress travel within a fire-resistance-rated corridor to the exit includes travel along unenclosed exit access stairways or ramps, the fire-resistance rating shall be continuous for the length of the stairway or ramp and for the length of the connecting corridor on the adjacent floor leading to the exit." .

    ibc:ibc2021-1021.2 a ibco:Provision ;
        ibco:bbox "[322.175, 197.644, 565.123, 230.622]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0837 ;
        ibco:heading "Wall separation" ;
        ibco:label "1021.2" ;
        ibco:partOf ibc:ibc2021-1021 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0837 ;
        ibco:sourcePage 338 ;
        ibco:text "1021.2 Wall separation. Exterior egress balconies shall be separated from the interior of the building by walls and opening protectives as required for corridors." .

    ibc:ibc2021-1023.12.1 a ibco:Provision ;
        ibco:bbox "[334.183, 544.711, 565.319, 676.651]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0892 ;
        ibco:heading "Termination and extension" ;
        ibco:label "1023.12.1" ;
        ibco:partOf ibc:ibc2021-1023.12 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0892 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.12.1 Termination and extension. A smokeproof enclosure shall terminate at an exit discharge or a public way. The smokeproof enclosure shall be permitted to be extended by an exit passageway in accordance with Section 1023.3. The exit passageway shall be without openings other than the fire door assembly required by Section 1023.3.1 and those necessary for egress from the exit passageway. The exit passageway shall be separated from the remainder of the building by 2-hour fire barriers constructed in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both." .

    ibc:ibc2021-1023.12.2 a ibco:Provision ;
        ibco:bbox "[58.818, 211.774, 289.906, 244.752]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0897 ;
        ibco:heading "Enclosure access" ;
        ibco:label "1023.12.2" ;
        ibco:partOf ibc:ibc2021-1023.12 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0897 ;
        ibco:sourcePage 341 ;
        ibco:text "1023.12.2 Enclosure access. Access to the stairway or ramp within a smokeproof enclosure shall be by way of a vestibule or an open exterior balcony." .

    ibc:ibc2021-1023.13 a ibco:Provision ;
        ibco:bbox "[46.816, 296.713, 289.82, 318.775]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0900 ;
        ibco:heading "Standpipes" ;
        ibco:label "1023.13" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0900 ;
        ibco:sourcePage 341 ;
        ibco:text "1023.13 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:ibc2021-1023.2 a ibco:Provision ;
        ibco:bbox "[46.807, 209.723, 289.849, 341.782]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0851 ;
        ibco:heading "Construction" ;
        ibco:label "1023.2" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0851 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.2 Construction. Enclosures for interior exit stairways and ramps shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both. Interior exit stairway and ramp enclosures shall have a fire-resistance rating of not less than 2 hours where connecting four stories or more and not less than 1 hour where connecting less than four stories. The number of stories connected by the interior exit stairways or ramps shall include any basements, but not any mezzanines. Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours." .

    ibc:ibc2021-1023.3.1 a ibco:Provision ;
        ibco:bbox "[319.794, 69.672, 550.869, 113.685]",
            "[58.792, 543.828, 289.854, 653.816]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0859 ;
        ibco:heading "Extension" ;
        ibco:label "1023.3.1" ;
        ibco:partOf ibc:ibc2021-1023.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0859 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.3.1 Extension. Where interior exit stairways and ramps are extended to an exit discharge or a public way by an exit passageway, the interior exit stairway and ramp shall be separated from the exit passageway by a fire barrier constructed in accordance with Section 707 or a horizontal assembly constructed in accordance with Section 711, or both. The fire-resistance rating shall be not less than that required for the interior exit stairway and ramp. A fire door assembly complying with Section 716 shall be installed in the fire barrier to provide a means of egress from the interior exit stairway and ramp to the exit passageway. Openings in the fire barrier other than the fire door assembly are prohibited. Penetrations of the fire barrier are prohibited." .

    ibc:ibc2021-1023.9 a ibco:Provision ;
        ibco:bbox "[61.187, 594.811, 304.292, 726.751]" ;
        ibco:hasChild ibc:ibc2021-1023.9.1 ;
        ibco:heading "Stairway identification signs" ;
        ibco:label "1023.9" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.9.1 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.9 Stairway identification signs. A sign shall be provided at each floor landing in an interior exit stairway and ramp connecting more than three stories designating the floor level, the terminus of the top and bottom of the interior exit stairway and ramp and the identification of the stairway or ramp. The signage shall state the story of and direction to the exit discharge, and the availability of roof access from the interior exit stairway and ramp for the fire department. The bottom of the sign shall be located not less than 5 feet (1524 mm) above the floor landing in a position that is readily visible when the doors are in the open and closed positions." .

    ibc:ibc2021-1024.2 a ibco:Provision ;
        ibco:bbox "[46.826, 435.765, 289.938, 512.766]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0904 ;
        ibco:heading "Width and capacity" ;
        ibco:label "1024.2" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0904 ;
        ibco:sourcePage 341 ;
        ibco:text "1024.2 Width and capacity. The required capacity of exit passageways shall be determined as specified in Section 1005.1 but the minimum width shall be not less than 44 inches (1118 mm), except that exit passageways serving an occupant load of less than 50 shall be not less than 36 inches (914 mm) in width. The minimum width or required capacity of exit passageways shall be unobstructed." .

    ibc:ibc2021-1024.9 a ibco:Provision ;
        ibco:bbox "[61.204, 183.712, 304.197, 205.773]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0922 ;
        ibco:heading "Standpipes" ;
        ibco:label "1024.9" ;
        ibco:partOf ibc:ibc2021-1024 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0922 ;
        ibco:sourcePage 342 ;
        ibco:text "1024.9 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:ibc2021-1025.1 a ibco:Provision ;
        ibco:bbox "[61.204, 263.741, 304.163, 307.754]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0925 ;
        ibco:heading "General" ;
        ibco:label "1025.1" ;
        ibco:partOf ibc:ibc2021-1025 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0925 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.1 General. Approved luminous egress path markings delineating the exit path shall be provided in high-rise buildings of Group A, B, E, I-1, M or R-1 occupancies in accordance with this section." .

    ibc:ibc2021-1025.2.1 a ibco:Provision ;
        ibco:bbox "[73.195, 407.703, 304.223, 517.787]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0928 ;
        ibco:heading "Steps" ;
        ibco:label "1025.2.1" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0928 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.1 Steps. A solid and continuous stripe shall be applied to the horizontal leading edge of each step and shall extend for the full length of the step. Outlining stripes shall have a minimum horizontal width of 1 inch (25 mm) and a maximum width of 2 inches (51 mm). The leading edge of the stripe shall be placed not more than 1/2 inch (12.7 mm) from the leading edge of the step and the stripe shall not overlap the leading edge of the step by not more than 1/2 inch (12.7 mm) down the vertical face of the step." .

    ibc:ibc2021-1025.2.3 a ibco:Provision ;
        ibco:bbox "[73.195, 595.783, 304.278, 683.82]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0931 ;
        ibco:heading "Handrails" ;
        ibco:label "1025.2.3" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0931 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.3 Handrails. Handrails and handrail extensions shall be marked with a solid and continuous stripe having a minimum width of 1 inch (25 mm). The stripe shall be placed on the top surface of the handrail for the entire length of the handrail, including extensions and newel post caps. Where handrails or handrail extensions bend or turn corners, the stripe shall not have a gap of more than 4 inches (102 mm)." .

    ibc:ibc2021-1025.2.4.1 a ibco:Provision ;
        ibco:bbox "[346.208, 198.628, 565.296, 264.713]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0935 ;
        ibco:heading "Floor-mounted demarcation lines" ;
        ibco:label "1025.2.4.1" ;
        ibco:partOf ibc:ibc2021-1025.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0935 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.4.1 Floor-mounted demarcation lines. Perimeter demarcation lines shall be placed within 4 inches (102 mm) of the wall and shall extend to within 2 inches (51 mm) of the markings on the leading edge of landings. The demarcation lines shall continue across the floor in front of all doors." .

    ibc:ibc2021-1025.2.4.2 a ibco:Provision ;
        ibco:bbox "[346.208, 316.674, 565.255, 459.65]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0937 ;
        ibco:heading "Wall-mounted demarcation lines" ;
        ibco:label "1025.2.4.2" ;
        ibco:partOf ibc:ibc2021-1025.2.4 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0937 ;
        ibco:sourcePage 342 ;
        ibco:text "1025.2.4.2 Wall-mounted demarcation lines. Perimeter demarcation lines shall be placed on the wall with the bottom edge of the stripe not more than 4 inches (102 mm) above the finished floor. At the top or bottom of the stairs, demarcation lines shall drop vertically to the floor within 2 inches (51 mm) of the step or landing edge. Demarcation lines on walls shall transition vertically to the floor and then extend across the floor where a line on the floor is the only practical method of outlining the path. Where the wall line is broken by a door, demarcation lines on walls shall continue across the face of the door or transition to the floor and extend across the floor in front of such door." .

    ibc:ibc2021-1025.2.5 a ibco:Provision ;
        ibco:bbox "[334.199, 581.551, 565.31, 702.81]",
            "[58.799, 69.725, 289.802, 91.786]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0940 ;
        ibco:heading "Obstacles" ;
        ibco:label "1025.2.5" ;
        ibco:partOf ibc:ibc2021-1025.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0940 ;
        ibco:sourcePage 342,
            343 ;
        ibco:text "1025.2.5 Obstacles. Obstacles at or below 6 feet 6 inches (1981 mm) in height and projecting more than 4 inches (102 mm) into the egress path shall be outlined with markings not less than 1 inch (25 mm) in width comprised of a pattern of alternating equal bands, of luminous material and black, with the alternating bands not more than 2 inches (51 mm) thick and angled at 45 degrees (0.79 rad). Obstacles shall include, but are not limited to, standpipes, hose cabinets, wall projections and restricted height areas. However, such markings shall not conceal any required information or indicators including but not limited to instructions to occupants for the use of standpipes." .

    ibc:ibc2021-1026.1 a ibco:Provision ;
        ibco:bbox "[307.814, 95.65, 550.838, 172.651]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0952 ;
        ibco:heading "General" ;
        ibco:label "1026.1" ;
        ibco:partOf ibc:ibc2021-1026 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0952 ;
        ibco:sourcePage 343 ;
        ibco:text "1026.1 General. Horizontal exits serving as an exit in a means of egress system shall comply with the requirements of this section. A horizontal exit shall not serve as the only exit from a portion of a building, and where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits." .

    ibc:ibc2021-1026.4.2 a ibco:Provision ;
        ibco:bbox "[73.194, 161.744, 304.27, 249.78]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0962 ;
        ibco:heading "Number of exits" ;
        ibco:label "1026.4.2" ;
        ibco:partOf ibc:ibc2021-1026.4 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0962 ;
        ibco:sourcePage 344 ;
        ibco:text "1026.4.2 Number of exits. The refuge area into which a horizontal exit leads shall be provided with exits adequate to meet the occupant requirements of this chapter, but not including the added occupant load imposed by persons entering the refuge area through horizontal exits from other areas. Not less than one refuge area exit shall lead directly to the exterior or to an interior exit stairway or ramp." .

    ibc:ibc2021-1026.5 a ibco:Provision ;
        ibco:bbox "[61.193, 334.729, 304.186, 356.791]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0964 ;
        ibco:heading "Standpipes" ;
        ibco:label "1026.5" ;
        ibco:partOf ibc:ibc2021-1026 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0964 ;
        ibco:sourcePage 344 ;
        ibco:text "1026.5 Standpipes. Standpipes and standpipe hose connections shall be provided where required by Sections 905.3 and" .

    ibc:ibc2021-1027.6 a ibco:Provision ;
        ibco:bbox "[322.181, 234.788, 565.175, 333.741]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0976 ;
        ibco:heading "Exterior exit stairway and ramp protection" ;
        ibco:label "1027.6" ;
        ibco:partOf ibc:ibc2021-1027 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0976 ;
        ibco:sourcePage 344 ;
        ibco:text "1027.6 Exterior exit stairway and ramp protection. Exterior exit stairways and ramps shall be separated from the interior of the building as required in Section 1023.2. Openings shall be limited to those necessary for egress from normally occupied spaces. Where a vertical plane projecting from the edge of an exterior exit stairway or ramp and landings is exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the exterior wall shall be rated in accordance with Section 1023.7." .

    ibc:ibc2021-1028.5 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.207, 91.786]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1005 ;
        ibco:heading "Access to a public way" ;
        ibco:label "1028.5" ;
        ibco:partOf ibc:ibc2021-1028 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1005 ;
        ibco:sourcePage 346 ;
        ibco:text "1028.5 Access to a public way. The exit discharge shall provide a direct and unobstructed access to a public way." .

    ibc:ibc2021-1029.2 a ibco:Provision ;
        ibco:bbox "[61.208, 324.828, 304.294, 423.78]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1013 ;
        ibco:heading "Width or capacity" ;
        ibco:label "1029.2" ;
        ibco:partOf ibc:ibc2021-1029 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1013 ;
        ibco:sourcePage 346 ;
        ibco:text "1029.2 Width or capacity. The required capacity of egress courts shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm), except as specified herein. Egress courts serving Group R-3 and U occupancies shall be not less than 36 inches (914 mm) in width. The required capacity and width of egress courts shall be unobstructed to a height of 7 feet (2134 mm). The width of the egress court shall be not less than the required capacity." .

    ibc:ibc2021-1029.3 a ibco:Provision ;
        ibco:bbox "[61.188, 453.79, 304.257, 543.455]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1015 ;
        ibco:heading "Construction and openings" ;
        ibco:label "1029.3" ;
        ibco:partOf ibc:ibc2021-1029 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1015 ;
        ibco:sourcePage 346 ;
        ibco:text "1029.3 Construction and openings. Where an egress court serving a building or portion thereof is less than 10 feet (3048 mm) in width, the egress court walls shall have not less than 1-hour fire-resistance-rated construction for a distance of 10 feet (3048 mm) above the floor of the egress court. Openings within such walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour." .

    ibc:ibc2021-1030.1 a ibco:Provision ;
        ibco:bbox "[61.194, 643.801, 304.162, 676.778]" ;
        ibco:hasChild ibc:ibc2021-1030.1.1 ;
        ibco:heading "General" ;
        ibco:label "1030.1" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.1.1 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.1 General. A room or space used for assembly purposes that contains seats, tables, displays, equipment or other material shall comply with this section." .

    ibc:ibc2021-1030.1.1 a ibco:Provision ;
        ibco:bbox "[73.186, 680.752, 304.18, 713.849]" ;
        ibco:hasChild ibc:ibc2021-1030.1.1.1 ;
        ibco:heading "Bleachers" ;
        ibco:label "1030.1.1" ;
        ibco:partOf ibc:ibc2021-1030.1 ;
        ibco:precedes ibc:ibc2021-1030.1.1.1 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.1.1 Bleachers. Bleachers, grandstands and folding and telescopic seating, that are not building elements, shall comply with ICC 300." .

    ibc:ibc2021-1030.1.1.1 a ibco:Provision ;
        ibco:bbox "[346.189, 69.706, 565.173, 135.791]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1022 ;
        ibco:label "1030.1.1.1" ;
        ibco:partOf ibc:ibc2021-1030.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1022 ;
        ibco:sourcePage 346 ;
        ibco:text "1030.1.1.1 Spaces under grandstands and bleachers. Spaces under grandstands or bleachers shall be separated by fire barriers complying with Section 707 and horizontal assemblies complying with Section 711 with not less than 1-hour fire-resistance-rated construction." .

    ibc:ibc2021-1030.13.1.1 a ibco:Provision ;
        ibco:bbox "[85.201, 512.646, 304.29, 611.858]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1115 ;
        ibco:label "1030.13.1.1" ;
        ibco:partOf ibc:ibc2021-1030.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1115 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.1.1 Aisle accessway capacity and width for seating at tables. Aisle accessways serving arrangements of seating at tables or counters shall comply with the capacity requirements of Section 1005.1 but shall not have less than 12 inches (305 mm) of width plus 1/2 inch (12.7 mm) of width for each additional 1 foot (305 mm), or fraction thereof, beyond 12 feet (3658 mm) of aisle accessway length measured from the center of the seat farthest from an aisle." .

    ibc:ibc2021-1030.13.2.1 a ibco:Provision ;
        ibco:bbox "[346.165, 264.742, 565.207, 363.695]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1120 ;
        ibco:heading "Dual access" ;
        ibco:label "1030.13.2.1" ;
        ibco:partOf ibc:ibc2021-1030.13.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1120 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.2.1 Dual access. For rows of seating served by aisles or doorways at both ends, there shall be not more than 100 seats per row. The minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.3 inch (7.6 mm) for every additional seat beyond 14 seats where seats have backrests or beyond 21 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:ibc2021-1030.13.2.2 a ibco:Provision ;
        ibco:bbox "[346.155, 426.692, 565.27, 514.609]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1122 ;
        ibco:heading "Single access" ;
        ibco:label "1030.13.2.2" ;
        ibco:partOf ibc:ibc2021-1030.13.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1122 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13.2.2 Single access. For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.6 inch (15.2 mm) for every additional seat beyond seven seats where seats have backrests or beyond 10 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)." .

    ibc:ibc2021-1030.14.1.3 a ibco:Provision ;
        ibco:bbox "[70.799, 363.819, 289.809, 396.797]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1128 ;
        ibco:heading "Edge protection" ;
        ibco:label "1030.14.1.3" ;
        ibco:partOf ibc:ibc2021-1030.14.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1128 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.1.3 Edge protection. Ramped aisles shall have edge protection in accordance with Sections 1012.10 and 1012.10.1." .

    ibc:ibc2021-1030.14.2.3 a ibco:Provision ;
        ibco:bbox "[331.808, 564.836, 550.81, 630.801]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1137 ;
        ibco:heading "Tread contrasting marking stripe" ;
        ibco:label "1030.14.2.3" ;
        ibco:partOf ibc:ibc2021-1030.14.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1137 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.2.3 Tread contrasting marking stripe. A contrasting marking stripe shall be provided on each tread at the nosing or leading edge such that the location of each tread is readily apparent when viewed in descent. Such stripe shall be not less than 1 inch (25 mm) and not more than 2 inches (51 mm) wide." .

    ibc:ibc2021-1030.15 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.181, 102.822]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1140 ;
        ibco:heading "Seat stability" ;
        ibco:label "1030.15" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1140 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.15 Seat stability. In a building, room or space used for assembly purposes, the seats shall be securely fastened to the floor." .

    ibc:ibc2021-1030.16.3 a ibco:Provision ;
        ibco:bbox "[334.193, 279.798, 565.359, 334.728]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1155 ;
        ibco:heading "Mid-aisle termination" ;
        ibco:label "1030.16.3" ;
        ibco:partOf ibc:ibc2021-1030.16 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1155 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.16.3 Mid-aisle termination. Mid-aisle handrails shall not extend beyond the lowest riser and shall terminate within 18 inches (381 mm), measured horizontally, from the lowest riser. Handrail extensions are not required." .

    ibc:ibc2021-1030.17.1 a ibco:Provision ;
        ibco:bbox "[334.193, 526.687, 565.286, 647.711]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1159 ;
        ibco:heading "Perimeter guards" ;
        ibco:label "1030.17.1" ;
        ibco:partOf ibc:ibc2021-1030.17 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1159 ;
        ibco:sourcePage 352 ;
        ibco:text "1030.17.1 Perimeter guards. Perimeter guards shall be provided where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below. Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard. Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface. Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015.3." .

    ibc:ibc2021-1030.17.2 a ibco:Provision ;
        ibco:bbox "[58.798, 117.712, 289.886, 198.797]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1163 ;
        ibco:heading "Cross aisles" ;
        ibco:label "1030.17.2" ;
        ibco:partOf ibc:ibc2021-1030.17 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1163 ;
        ibco:sourcePage 353 ;
        ibco:text "1030.17.2 Cross aisles. Cross aisles located more than 30 inches (762 mm) above the floor or grade below shall have guards in accordance with Section 1015. Where an elevation change of 30 inches (762 mm) or less occurs between a cross aisle and the adjacent floor or grade below, guards not less than 26 inches (660 mm) above the aisle floor shall be provided." .

    ibc:ibc2021-1030.6.2.2 a ibco:Provision ;
        ibco:bbox "[331.794, 187.631, 550.769, 231.645]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1039 ;
        ibco:heading "Roof height" ;
        ibco:label "1030.6.2.2" ;
        ibco:partOf ibc:ibc2021-1030.6.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1039 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.2.2 Roof height. A smoke-protected assembly seating area with a roof shall have the lowest portion of the roof deck not less than 15 feet (4572 mm) above the highest aisle or aisle accessway." .

    ibc:ibc2021-1030.6.2.3 a ibco:Provision ;
        ibco:bbox "[331.802, 294.828, 550.892, 349.757]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1041 ;
        ibco:heading "Automatic sprinklers" ;
        ibco:label "1030.6.2.3" ;
        ibco:partOf ibc:ibc2021-1030.6.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1041 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.2.3 Automatic sprinklers. Enclosed areas with walls and ceilings in buildings or structures containing smoke-protected assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-1030.6.3.1 a ibco:Provision ;
        ibco:bbox "[85.199, 69.725, 304.187, 124.774]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1047 ;
        ibco:heading "Automatic sprinklers" ;
        ibco:label "1030.6.3.1" ;
        ibco:partOf ibc:ibc2021-1030.6.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1047 ;
        ibco:sourcePage 348 ;
        ibco:text "1030.6.3.1 Automatic sprinklers. Enclosed areas with walls and ceilings in buildings or structures containing open-air assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:ibc2021-1030.7 a ibco:Provision ;
        ibco:bbox "[61.19, 263.76, 304.2, 307.773]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1052 ;
        ibco:heading "Travel distance" ;
        ibco:label "1030.7" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1052 ;
        ibco:sourcePage 348 ;
        ibco:text "1030.7 Travel distance. The exit access travel distance shall comply with Section 1017. Where aisles are provided for seating, the distance shall be measured along the aisles and aisle accessways without travel over or on the seats." .

    ibc:ibc2021-1030.8.1 a ibco:Provision ;
        ibco:bbox "[334.214, 106.721, 565.259, 194.638]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1067 ;
        ibco:heading "Path through adjacent row" ;
        ibco:label "1030.8.1" ;
        ibco:partOf ibc:ibc2021-1030.8 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1067 ;
        ibco:sourcePage 348 ;
        ibco:text "1030.8.1 Path through adjacent row. Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there shall be not more than 24 seats between the two aisles, and the minimum clear width between rows for the row between the two aisles shall be 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row between aisles." .

    ibc:ibc2021-1030.9.5 a ibco:Provision ;
        ibco:bbox "[58.809, 213.687, 289.779, 257.82]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1085 ;
        ibco:heading "Dead-end aisles" ;
        ibco:label "1030.9.5" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1085 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.5 Dead-end aisles. Each end of an aisle shall be continuous to a cross aisle, foyer, doorway, vomitory, concourse or stairway in accordance with Section 1030.9.7 having access to an exit." .

    ibc:ibc2021-1030.9.6.1 a ibco:Provision ;
        ibco:bbox "[70.841, 627.704, 289.966, 660.682]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1093 ;
        ibco:heading "Assembly aisle obstructions" ;
        ibco:label "1030.9.6.1" ;
        ibco:partOf ibc:ibc2021-1030.9.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1093 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.6.1 Assembly aisle obstructions. There shall not be obstructions in the minimum width or required capacity of aisles." .

    ibc:ibc2021-1031.3.1 a ibco:Provision ;
        ibco:bbox "[319.795, 536.696, 550.786, 569.87]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1182 ;
        ibco:heading "Minimum size" ;
        ibco:label "1031.3.1" ;
        ibco:partOf ibc:ibc2021-1031.3 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1182 ;
        ibco:sourcePage 353 ;
        ibco:text "1031.3.1 Minimum size. Emergency escape and rescue openings shall have a minimum net clear opening of 5.7 square feet (0.53 m2)." .

    ibc:ibc2021-1031.5.1 a ibco:Provision ;
        ibco:bbox "[73.196, 202.771, 304.311, 257.858]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1188 ;
        ibco:heading "Minimum size" ;
        ibco:label "1031.5.1" ;
        ibco:partOf ibc:ibc2021-1031.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1188 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5.1 Minimum size. The minimum horizontal area of the area well shall be 9 square feet (0.84 m2), with a horizontal projection and width of not less than 36 inches (914 mm). The area well shall allow the emergency escape and rescue opening to be fully opened." .

    ibc:ibc2021-1031.5.3 a ibco:Provision ;
        ibco:bbox "[73.186, 519.756, 304.253, 552.733]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1193 ;
        ibco:heading "Drainage" ;
        ibco:label "1031.5.3" ;
        ibco:partOf ibc:ibc2021-1031.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1193 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5.3 Drainage. Area wells shall be designed for proper drainage by connecting to the building’s foundation drainage system required by Section 1805." .

    ibc:ibc2021-ch10-exception-0323 a ibco:Exception ;
        ibco:bbox "[331.799, 684.823, 381.678, 695.849]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0324 ;
        ibco:partOf ibc:ibc2021-1010.1.7 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0324 ;
        ibco:sourcePage 317 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0418 a ibco:Exception ;
        ibco:bbox "[118.808, 649.676, 289.83, 682.653]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0419 ;
        ibco:partOf ibc:ibc2021-1010.2.13.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0419 ;
        ibco:sourcePage 321 ;
        ibco:text "Exception: Where approved, a delay of not more than 30 seconds is permitted on a delayed egress door." .

    ibc:ibc2021-ch10-exception-0502 a ibco:Exception ;
        ibco:bbox "[130.801, 106.915, 289.789, 128.977]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0503 ;
        ibco:partOf ibc:ibc2021-1010.5.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0503 ;
        ibco:sourcePage 325 ;
        ibco:text "Exception: Actuation of a manual fire alarm box." .

    ibc:ibc2021-ch10-exception-0872 a ibco:Exception ;
        ibco:bbox "[319.807, 613.791, 550.796, 646.769]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0873 ;
        ibco:partOf ibc:ibc2021-1023.5 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0873 ;
        ibco:sourcePage 339 ;
        ibco:text "Exception: Membrane penetrations shall be permitted on the outside of the interior exit stairway and ramp. Such penetrations shall be protected in accordance with Section" .

    ibc:ibc2021-ch10-exception-0897 a ibco:Exception ;
        ibco:bbox "[70.82, 248.726, 289.837, 281.823]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0898 ;
        ibco:partOf ibc:ibc2021-1023.12.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0898 ;
        ibco:sourcePage 341 ;
        ibco:text "Exception: Access is not required by way of a vestibule or exterior balcony for stairways and ramps using the pressurization alternative complying with Section" .

    ibc:ibc2021-ch10-exception-1071 a ibco:Exception ;
        ibco:bbox "[370.188, 368.722, 565.165, 390.784]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1072 ;
        ibco:partOf ibc:ibc2021-1030.9.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1072 ;
        ibco:sourcePage 348 ;
        ibco:text "Exception: Thirty-six inches (914 mm) where the stepped aisles serve less than 50 seats." .

    ibc:ibc2021-ch10-exception-1132 a ibco:Exception ;
        ibco:bbox "[82.795, 629.748, 132.674, 640.774]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1133 ;
        ibco:partOf ibc:ibc2021-1030.14.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1133 ;
        ibco:sourcePage 351 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-list_item-0065 a ibco:ListItem ;
        ibco:bbox "[343.763, 234.707, 550.82, 311.858]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0066 ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0063 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0066 ;
        ibco:sourcePage 307 ;
        ibco:text "2. Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section" .

    ibc:ibc2021-ch10-list_item-0411 a ibco:ListItem ;
        ibco:bbox "[70.8, 276.813, 289.805, 342.778]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0412 ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1010.2.13 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0412 ;
        ibco:sourcePage 321 ;
        ibco:text "3. In courtrooms in Group A-3 and B occupancies, delayed egress locking systems shall be permitted to be installed on exit or exit access doors, other than the main exit or exit access door, in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:ibc2021-ch10-list_item-0556 a ibco:ListItem ;
        ibco:bbox "[70.789, 296.713, 289.79, 307.739]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0557 ;
        ibco:label "2" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0554 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0557 ;
        ibco:sourcePage 327 ;
        ibco:text "2. Interior exit stairways in accordance with Section" .

    ibc:ibc2021-ch10-list_item-0756 a ibco:ListItem ;
        ibco:bbox "[331.793, 178.752, 550.755, 200.694]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0757 ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-1017.2.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0757 ;
        ibco:sourcePage 335 ;
        ibco:text "3. The building is equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:ibc2021-ch10-list_item-0802 a ibco:ListItem ;
        ibco:bbox "[46.797, 633.259, 289.746, 642.026]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0803 ;
        ibco:label "a" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0796 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0803 ;
        ibco:sourcePage 337 ;
        ibco:text "a. For requirements for occupancies in Group I-2, see Sections 407.2 and" .

    ibc:ibc2021-ch10-list_item-0854 a ibco:ListItem ;
        ibco:bbox "[70.821, 421.711, 289.822, 432.737]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0855 ;
        ibco:label "3" ;
        ibco:partOf ibc:ibc2021-ch10-exception-0851 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0855 ;
        ibco:sourcePage 339 ;
        ibco:text "3. Interior exit stairways in accordance with Section" .

    ibc:ibc2021-ch10-list_item-1133 a ibco:ListItem ;
        ibco:bbox "[379.801, 267.84, 550.879, 366.792]",
            "[97.197, 644.748, 289.827, 710.87]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1134 ;
        ibco:label "1" ;
        ibco:partOf ibc:ibc2021-ch10-exception-1132 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1134 ;
        ibco:sourcePage 351 ;
        ibco:text "1. Riser height nonuniformity shall be limited to the extent necessitated by changes in the gradient of the adjoining seating area to maintain adequate sightlines. Where nonuniformities exceed 3/16 inch (4.8 mm) between adjacent risers, the exact location of such nonuniformities shall be indicated with a distinctive marking stripe on each tread at the nosing or leading edge adjacent to the nonuniform risers. Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide. The edge marking stripe shall be distinctively different from the contrasting marking stripe." .

    ibc:ibc2021-1001 a ibco:Section ;
        ibco:bbox "[139.443, 332.625, 226.073, 354.776]" ;
        ibco:hasChild ibc:ibc2021-1001.1,
            ibc:ibc2021-1001.2 ;
        ibco:heading "ADMINISTRATION" ;
        ibco:label "1001" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1001.1 ;
        ibco:sourcePage 304 ;
        ibco:text "SECTION 1001 ADMINISTRATION" .

    ibc:ibc2021-1002 a ibco:Section ;
        ibco:bbox "[115.211, 493.629, 250.132, 515.78]" ;
        ibco:hasChild ibc:ibc2021-1002.1,
            ibc:ibc2021-1002.2 ;
        ibco:heading "MAINTENANCE AND PLANS" ;
        ibco:label "1002" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1002.1 ;
        ibco:sourcePage 304 ;
        ibco:text "[F] SECTION 1002 MAINTENANCE AND PLANS" .

    ibc:ibc2021-1004.5 a ibco:Provision ;
        ibco:bbox "[61.209, 209.723, 304.229, 319.711]" ;
        ibco:hasChild ibc:ibc2021-1004.5.1,
            ibc:ibc2021-ch10-exception-0047 ;
        ibco:heading "Areas without fixed seating" ;
        ibco:label "1004.5" ;
        ibco:partOf ibc:ibc2021-1004 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0047 ;
        ibco:sourcePage 306 ;
        ibco:text "1004.5 Areas without fixed seating. The number of occupants shall be computed at the rate of one occupant per unit of area as prescribed in Table 1004.5. For areas without fixed seating, the occupant load shall be not less than that number determined by dividing the floor area under consideration by the occupant load factor assigned to the function of the space as set forth in Table 1004.5. Where an intended function is not listed in Table 1004.5, the building official shall establish a function based on a listed function that most nearly resembles the intended function." .

    ibc:ibc2021-1005.3 a ibco:Provision ;
        ibco:bbox "[46.766, 609.791, 289.77, 664.72]" ;
        ibco:hasChild ibc:ibc2021-1005.3.1,
            ibc:ibc2021-1005.3.2 ;
        ibco:heading "Required capacity based on occupant load" ;
        ibco:label "1005.3" ;
        ibco:partOf ibc:ibc2021-1005 ;
        ibco:precedes ibc:ibc2021-1005.3.1 ;
        ibco:sourcePage 307 ;
        ibco:text "1005.3 Required capacity based on occupant load. The required capacity, in inches (mm), of the means of egress for any room, area, space or story shall be not less than that determined in accordance with Sections 1005.3.1 and 1005.3.2." .

    ibc:ibc2021-1006.2 a ibco:Provision ;
        ibco:bbox "[322.172, 156.311, 565.28, 200.324]" ;
        ibco:hasChild ibc:ibc2021-1006.2.1,
            ibc:ibc2021-1006.2.2 ;
        ibco:heading "Egress from spaces" ;
        ibco:label "1006.2" ;
        ibco:partOf ibc:ibc2021-1006 ;
        ibco:precedes ibc:ibc2021-1006.2.1 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.2 Egress from spaces. Rooms, areas or spaces, including mezzanines, within a story or basement shall be provided with the number of exits or access to exits in accordance with this section." .

    ibc:ibc2021-1006.2.1 a ibco:Provision ;
        ibco:bbox "[334.173, 205.135, 565.296, 293.171]" ;
        ibco:hasChild ibc:ibc2021-1006.2.1.1,
            ibc:ibc2021-ch10-exception-0090 ;
        ibco:label "1006.2.1" ;
        ibco:partOf ibc:ibc2021-1006.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0090 ;
        ibco:sourcePage 308 ;
        ibco:text "1006.2.1 Egress based on occupant load and common path of egress travel distance. Two exits or exit access doorways from any space shall be provided where the design occupant load or the common path of egress travel distance exceeds the values listed in Table 1006.2.1. The cumulative occupant load from adjacent rooms, areas or spaces shall be determined in accordance with Section 1004.2." .

    ibc:ibc2021-1007.1.1 a ibco:Provision ;
        ibco:bbox "[58.779, 506.744, 289.865, 605.816]" ;
        ibco:hasChild ibc:ibc2021-1007.1.1.1,
            ibc:ibc2021-ch10-exception-0140 ;
        ibco:heading "Two exits or exit access doorways" ;
        ibco:label "1007.1.1" ;
        ibco:partOf ibc:ibc2021-1007.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0140 ;
        ibco:sourcePage 311 ;
        ibco:text "1007.1.1 Two exits or exit access doorways. Where two exits, exit access doorways, exit access stairways or ramps, or any combination thereof, are required from any portion of the exit access, they shall be placed a distance apart equal to not less than one-half of the length of the maximum overall diagonal dimension of the building or area to be served measured in a straight line between them. Interlocking or scissor stairways shall be counted as one exit stairway." .

    ibc:ibc2021-1009.4 a ibco:Provision ;
        ibco:bbox "[61.176, 156.715, 304.119, 189.812]" ;
        ibco:hasChild ibc:ibc2021-1009.4.1,
            ibc:ibc2021-1009.4.2 ;
        ibco:heading "Elevators" ;
        ibco:label "1009.4" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-1009.4.1 ;
        ibco:sourcePage 314 ;
        ibco:text "1009.4 Elevators. In order to be considered part of an accessible means of egress, an elevator shall comply with Sections 1009.4.1 and 1009.4.2." .

    ibc:ibc2021-1009.9 a ibco:Provision ;
        ibco:bbox "[307.779, 69.566, 550.768, 91.627]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0259,
            ibc:ibc2021-ch10-list_item-0260 ;
        ibco:heading "Signage" ;
        ibco:label "1009.9" ;
        ibco:partOf ibc:ibc2021-1009 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0259 ;
        ibco:sourcePage 315 ;
        ibco:text "1009.9 Signage. Signage indicating special accessibility provisions shall be provided as shown:" .

    ibc:ibc2021-1010.1.1 a ibco:Provision ;
        ibco:bbox "[73.199, 69.725, 304.303, 245.742]" ;
        ibco:hasChild ibc:ibc2021-1010.1.1.1,
            ibc:ibc2021-ch10-exception-0272 ;
        ibco:heading "Size of doors" ;
        ibco:label "1010.1.1" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0272 ;
        ibco:sourcePage 316 ;
        ibco:text "1010.1.1 Size of doors. The required capacity of each door opening shall be sufficient for the occupant load thereof and shall provide a minimum clear opening width of 32 inches (813 mm). The clear opening width of doorways with swinging doors shall be measured between the face of the door and the stop, with the door open 90 degrees (1.57 rad). Where this section requires a minimum clear opening width of 32 inches (813 mm) and a door opening includes two door leaves without a mullion, one leaf shall provide a minimum clear opening width of 32 inches (813 mm). In Group I-2, doors serving as means of egress doors where used for the movement of beds shall provide a minimum clear opening width of 411/2 inches (1054 mm). The minimum clear opening height of doors shall be not less than 80 inches (2032 mm)." .

    ibc:ibc2021-1010.1.2 a ibco:Provision ;
        ibco:bbox "[334.198, 257.702, 565.196, 290.799]" ;
        ibco:hasChild ibc:ibc2021-1010.1.2.1,
            ibc:ibc2021-ch10-exception-0287 ;
        ibco:heading "Egress door types" ;
        ibco:label "1010.1.2" ;
        ibco:partOf ibc:ibc2021-1010.1 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0287 ;
        ibco:sourcePage 316 ;
        ibco:text "1010.1.2 Egress door types. Egress doors shall be of the side-hinged swinging door, pivoted door, or balanced door types." .

    ibc:ibc2021-1010.2.14 a ibco:Provision ;
        ibco:bbox "[73.199, 69.725, 304.161, 80.75]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0440,
            ibc:ibc2021-ch10-list_item-0431 ;
        ibco:label "1010.2.14" ;
        ibco:partOf ibc:ibc2021-1010.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0431 ;
        ibco:sourcePage 322 ;
        ibco:text "1010.2.14 Controlled egress doors in Groups I-1 and I-" .

    ibc:ibc2021-1010.4 a ibco:Provision ;
        ibco:bbox "[61.196, 339.78, 304.139, 383.794]" ;
        ibco:hasChild ibc:ibc2021-1010.4.1,
            ibc:ibc2021-ch10-exception-0482 ;
        ibco:heading "Gates" ;
        ibco:label "1010.4" ;
        ibco:partOf ibc:ibc2021-1010 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0482 ;
        ibco:sourcePage 324 ;
        ibco:text "1010.4 Gates. Gates serving the means of egress system shall comply with the requirements of this section. Gates used as a component in a means of egress shall conform to the applicable requirements for doors." .

    ibc:ibc2021-1011.14 a ibco:Provision ;
        ibco:bbox "[61.195, 571.771, 304.288, 681.818]" ;
        ibco:hasChild ibc:ibc2021-1011.14.1,
            ibc:ibc2021-1011.14.2 ;
        ibco:heading "Alternating tread devices" ;
        ibco:label "1011.14" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-1011.14.1 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.14 Alternating tread devices. Alternating tread devices are limited to an element of a means of egress in buildings of Groups F, H and S from a mezzanine not more than 250 square feet (23 m2) in area and that serves not more than five occupants; in buildings of Group I-3 from a guard tower, observation station or control room not more than 250 square feet (23 m2) in area and for access to unoccupied roofs. Alternating tread devices used as a means of egress shall not have a rise greater than 20 feet (6096 mm) between floor levels or landings." .

    ibc:ibc2021-1011.15 a ibco:Provision ;
        ibco:bbox "[322.184, 319.796, 565.209, 407.854]" ;
        ibco:hasChild ibc:ibc2021-1011.15.1,
            ibc:ibc2021-1011.15.2 ;
        ibco:heading "Ship’s ladders" ;
        ibco:label "1011.15" ;
        ibco:partOf ibc:ibc2021-1011 ;
        ibco:precedes ibc:ibc2021-1011.15.1 ;
        ibco:sourcePage 328 ;
        ibco:text "1011.15 Ship’s ladders. Ship’s ladders are permitted to be used in Group I-3 as a component of a means of egress to and from control rooms or elevated facility observation stations not more than 250 square feet (23 m2) with not more than three occupants and for access to unoccupied roofs. The minimum clear width at and below the handrails shall be 20 inches (508 mm). Ship’s ladders shall be designed for the live loads indicated in Section 1607.17." .

    ibc:ibc2021-1011.5.4 a ibco:Provision ;
        ibco:bbox "[73.188, 391.779, 304.317, 470.495]" ;
        ibco:hasChild ibc:ibc2021-1011.5.4.1,
            ibc:ibc2021-ch10-exception-0534 ;
        ibco:heading "Dimensional uniformity" ;
        ibco:label "1011.5.4" ;
        ibco:partOf ibc:ibc2021-1011.5 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0534 ;
        ibco:sourcePage 326 ;
        ibco:text "1011.5.4 Dimensional uniformity. Stair treads and risers shall be of uniform size and shape. The tolerance between the largest and smallest riser height or between the largest and smallest tread depth shall not exceed 3/8 inch (9.5 mm) in any flight of stairs. The greatest winder tread depth at the walkline within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm)." .

    ibc:ibc2021-1012.7 a ibco:Provision ;
        ibco:bbox "[307.773, 493.69, 550.813, 537.703]" ;
        ibco:hasChild ibc:ibc2021-1012.7.1,
            ibc:ibc2021-1012.7.2 ;
        ibco:heading "Ramp construction" ;
        ibco:label "1012.7" ;
        ibco:partOf ibc:ibc2021-1012 ;
        ibco:precedes ibc:ibc2021-1012.7.1 ;
        ibco:sourcePage 329 ;
        ibco:text "1012.7 Ramp construction. Ramps shall be built of materials consistent with the types permitted for the type of construction of the building, except that wood handrails shall be permitted for all types of construction." .

    ibc:ibc2021-1015.2 a ibco:Provision ;
        ibco:bbox "[322.156, 197.676, 565.234, 285.712]" ;
        ibco:hasChild ibc:ibc2021-1015.2.1,
            ibc:ibc2021-ch10-exception-0686 ;
        ibco:heading "Where required" ;
        ibco:label "1015.2" ;
        ibco:partOf ibc:ibc2021-1015 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0686 ;
        ibco:sourcePage 332 ;
        ibco:text "1015.2 Where required. Guards shall be located along open-sided walking surfaces, including mezzanines, equipment platforms, aisles, stairs, ramps and landings that are located more than 30 inches (762 mm) measured vertically to the floor or grade below at any point within 36 inches (914 mm) horizontally to the edge of the open side. Guards shall be adequate in strength and attachment in accordance with Section 1607.9." .

    ibc:ibc2021-1016 a ibco:Section ;
        ibco:bbox "[147.959, 287.58, 217.433, 309.731]" ;
        ibco:hasChild ibc:ibc2021-1016.1,
            ibc:ibc2021-1016.2 ;
        ibco:heading "EXIT ACCESS" ;
        ibco:label "1016" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1016.1 ;
        ibco:sourcePage 334 ;
        ibco:text "SECTION 1016 EXIT ACCESS" .

    ibc:ibc2021-1020.2 a ibco:Provision ;
        ibco:bbox "[46.798, 132.712, 289.834, 176.725]" ;
        ibco:hasChild ibc:ibc2021-1020.2.1,
            ibc:ibc2021-ch10-exception-0796 ;
        ibco:heading "Construction" ;
        ibco:label "1020.2" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0796 ;
        ibco:sourcePage 337 ;
        ibco:text "1020.2 Construction. Corridors shall be fire-resistance rated in accordance with Table 1020.2. The corridor walls required to be fire-resistance rated shall comply with Section 708 for fire partitions." .

    ibc:ibc2021-1020.6 a ibco:Provision ;
        ibco:bbox "[61.199, 69.725, 304.258, 102.822]" ;
        ibco:hasChild ibc:ibc2021-1020.6.1,
            ibc:ibc2021-ch10-exception-0819 ;
        ibco:heading "Air movement in corridors" ;
        ibco:label "1020.6" ;
        ibco:partOf ibc:ibc2021-1020 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0819 ;
        ibco:sourcePage 338 ;
        ibco:text "1020.6 Air movement in corridors. Corridors shall not serve as supply, return, exhaust, relief or ventilation air ducts." .

    ibc:ibc2021-1022 a ibco:Section ;
        ibco:bbox "[408.949, 497.588, 478.423, 519.739]" ;
        ibco:hasChild ibc:ibc2021-1022.1,
            ibc:ibc2021-1022.2 ;
        ibco:heading "EXITS" ;
        ibco:label "1022" ;
        ibco:partOf ibc:ibc2021-ch10-chapter-0001 ;
        ibco:precedes ibc:ibc2021-1022.1 ;
        ibco:sourcePage 338 ;
        ibco:text "SECTION 1022 EXITS" .

    ibc:ibc2021-1022.2 a ibco:Provision ;
        ibco:bbox "[322.187, 615.773, 565.169, 648.751]" ;
        ibco:hasChild ibc:ibc2021-1022.2.1,
            ibc:ibc2021-1022.2.2 ;
        ibco:heading "Exterior exit doors" ;
        ibco:label "1022.2" ;
        ibco:partOf ibc:ibc2021-1022 ;
        ibco:precedes ibc:ibc2021-1022.2.1 ;
        ibco:sourcePage 338 ;
        ibco:text "1022.2 Exterior exit doors. Buildings or structures used for human occupancy shall have not less than one exterior door that meets the requirements of Section 1010.1.1." .

    ibc:ibc2021-1023.12 a ibco:Provision ;
        ibco:bbox "[322.181, 496.723, 565.207, 540.737]" ;
        ibco:hasChild ibc:ibc2021-1023.12.1,
            ibc:ibc2021-1023.12.2 ;
        ibco:heading "Smokeproof enclosures" ;
        ibco:label "1023.12" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-1023.12.1 ;
        ibco:sourcePage 340 ;
        ibco:text "1023.12 Smokeproof enclosures. Where required by Section 403.5.4, 405.7.2 or 412.2.2.1, interior exit stairways and ramps shall be smokeproof enclosures in accordance with Section 909.20." .

    ibc:ibc2021-1023.3 a ibco:Provision ;
        ibco:bbox "[46.817, 447.747, 289.838, 469.689]" ;
        ibco:hasChild ibc:ibc2021-1023.3.1,
            ibc:ibc2021-ch10-exception-0857 ;
        ibco:heading "Termination" ;
        ibco:label "1023.3" ;
        ibco:partOf ibc:ibc2021-1023 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0857 ;
        ibco:sourcePage 339 ;
        ibco:text "1023.3 Termination. Interior exit stairways and ramps shall terminate at an exit discharge or a public way." .

    ibc:ibc2021-1025.4 a ibco:Provision ;
        ibco:bbox "[46.803, 471.79, 289.851, 548.791]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0947,
            ibc:ibc2021-ch10-list_item-0948 ;
        ibco:heading "Self-luminous and photoluminescent" ;
        ibco:label "1025.4" ;
        ibco:partOf ibc:ibc2021-1025 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0947 ;
        ibco:sourcePage 343 ;
        ibco:text "1025.4 Self-luminous and photoluminescent. Luminous egress path markings shall be permitted to be made of any material, including paint, provided that an electrical charge is not required to maintain the required luminance. Such materials shall include, but not be limited to, self-luminous materials and photoluminescent materials. Materials shall comply with either of the following standards:" .

    ibc:ibc2021-1026.2 a ibco:Provision ;
        ibco:bbox "[307.804, 297.679, 550.9, 374.68]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0957,
            ibc:ibc2021-ch10-list_item-0956 ;
        ibco:heading "Separation" ;
        ibco:label "1026.2" ;
        ibco:partOf ibc:ibc2021-1026 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0956 ;
        ibco:sourcePage 343 ;
        ibco:text "1026.2 Separation. The separation between buildings or refuge areas connected by a horizontal exit shall be provided by a fire wall complying with Section 706; or by a fire barrier complying with Section 707 or a horizontal assembly complying with Section 711, or both. The minimum fireresistance rating of the separation shall be 2 hours. Opening protectives in horizontal exits shall also comply with Section" .

    ibc:ibc2021-1026.4 a ibco:Provision ;
        ibco:bbox "[307.799, 610.737, 550.852, 709.69]" ;
        ibco:hasChild ibc:ibc2021-1026.4.1,
            ibc:ibc2021-1026.4.2 ;
        ibco:heading "Refuge area" ;
        ibco:label "1026.4" ;
        ibco:partOf ibc:ibc2021-1026 ;
        ibco:precedes ibc:ibc2021-1026.4.1 ;
        ibco:sourcePage 343 ;
        ibco:text "1026.4 Refuge area. The refuge area of a horizontal exit shall be a space occupied by the same tenant or a public area and each such refuge area shall be adequate to accommodate the original occupant load of the refuge area plus the occupant load anticipated from the adjoining compartment. The anticipated occupant load from the adjoining compartment shall be based on the capacity of the horizontal exit doors entering the refuge area or the total occupant load of the adjoining compartment, whichever is less." .

    ibc:ibc2021-1028.2 a ibco:Provision ;
        ibco:bbox "[46.776, 357.795, 289.855, 434.796]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-0989,
            ibc:ibc2021-ch10-exception-0999 ;
        ibco:heading "Exit discharge" ;
        ibco:label "1028.2" ;
        ibco:partOf ibc:ibc2021-1028 ;
        ibco:precedes ibc:ibc2021-ch10-exception-0989 ;
        ibco:sourcePage 345 ;
        ibco:text "1028.2 Exit discharge. Exits shall discharge directly to the exterior of the building. The exit discharge shall be at grade or shall provide a direct path of egress travel to grade. The exit discharge shall not reenter a building. The combined use of Exceptions 1 and 2 shall not exceed 50 percent of the number and minimum width or required capacity of the required exits." .

    ibc:ibc2021-1030.10.2 a ibco:Provision ;
        ibco:bbox "[319.802, 283.735, 550.756, 338.784]" ;
        ibco:hasChild ibc:ibc2021-1030.10.2.1,
            ibc:ibc2021-1030.10.2.2 ;
        ibco:label "1030.10.2" ;
        ibco:partOf ibc:ibc2021-1030.10 ;
        ibco:precedes ibc:ibc2021-1030.10.2.1 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10.2 Transitions to stairways that do not maintain stepped aisle riser and tread dimensions. Transitions between stairways and stepped aisles having different riser and tread dimensions shall comply with Sections 1030.10.2.1 through 1030.10.3." .

    ibc:ibc2021-1030.10.2.1 a ibco:Provision ;
        ibco:bbox "[331.804, 342.758, 550.79, 386.771]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-1100,
            ibc:ibc2021-ch10-list_item-1101 ;
        ibco:label "1030.10.2.1" ;
        ibco:partOf ibc:ibc2021-1030.10.2 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-1100 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.10.2.1 Stairways and stepped aisles in a straight run. Where stairways and stepped aisles are in a straight run, transitions shall have one of the following:" .

    ibc:ibc2021-1030.11 a ibco:Provision ;
        ibco:bbox "[307.787, 614.761, 550.927, 669.81]" ;
        ibco:hasChild ibc:ibc2021-1030.11.1,
            ibc:ibc2021-1030.11.2 ;
        ibco:heading "Stepped aisles at vomitories" ;
        ibco:label "1030.11" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.11.1 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.11 Stepped aisles at vomitories. Stepped aisles that change direction at vomitories shall comply with Section 1030.11.1 Transitions between a stepped aisle above a vomitory and a stepped aisle to the side of a vomitory shall comply with Section 1030.11.2." .

    ibc:ibc2021-1030.13 a ibco:Provision ;
        ibco:bbox "[61.167, 313.745, 304.204, 357.758]" ;
        ibco:hasChild ibc:ibc2021-1030.13.1,
            ibc:ibc2021-1030.13.2 ;
        ibco:heading "Aisle accessways" ;
        ibco:label "1030.13" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.13.1 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.13 Aisle accessways. Aisle accessways for seating at tables shall comply with Section 1030.13.1. Aisle accessways for seating in rows shall comply with Section 1030.13.2." .

    ibc:ibc2021-1030.14 a ibco:Provision ;
        ibco:bbox "[322.142, 577.606, 565.182, 621.619]" ;
        ibco:hasChild ibc:ibc2021-1030.14.1,
            ibc:ibc2021-1030.14.2 ;
        ibco:heading "Assembly aisle walking surfaces" ;
        ibco:label "1030.14" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-1030.14.1 ;
        ibco:sourcePage 350 ;
        ibco:text "1030.14 Assembly aisle walking surfaces. Ramped aisles shall comply with Sections 1030.14.1 through 1030.14.1.3. Stepped aisles shall comply with Sections 1030.14.2 through 1030.14.2.4." .

    ibc:ibc2021-1030.14.2.1 a ibco:Provision ;
        ibco:bbox "[70.789, 507.781, 289.845, 540.759]" ;
        ibco:hasChild ibc:ibc2021-ch10-exception-1131,
            ibc:ibc2021-ch10-exception-1132 ;
        ibco:heading "Treads" ;
        ibco:label "1030.14.2.1" ;
        ibco:partOf ibc:ibc2021-1030.14.2 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1131 ;
        ibco:sourcePage 351 ;
        ibco:text "1030.14.2.1 Treads. Tread depths shall be not less than 11 inches (279 mm) and shall have dimensional uniformity." .

    ibc:ibc2021-1030.6.3 a ibco:Provision ;
        ibco:bbox "[319.782, 452.764, 550.841, 518.849]" ;
        ibco:hasChild ibc:ibc2021-1030.6.3.1,
            ibc:ibc2021-ch10-exception-1045 ;
        ibco:heading "Open-air assembly seating" ;
        ibco:label "1030.6.3" ;
        ibco:partOf ibc:ibc2021-1030.6 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1045 ;
        ibco:sourcePage 347 ;
        ibco:text "1030.6.3 Open-air assembly seating. In open-air assembly seating, the required capacity in inches (mm) of aisles shall be not less than the total occupant load served by the egress element multiplied by 0.08 (2.0 mm) where egress is by stepped aisle and multiplied by 0.06 (1.52 mm) where egress is by level aisles and ramped aisles." .

    ibc:ibc2021-1030.8 a ibco:Provision ;
        ibco:bbox "[61.21, 629.71, 304.179, 673.723]" ;
        ibco:hasChild ibc:ibc2021-1030.8.1,
            ibc:ibc2021-ch10-exception-1063 ;
        ibco:heading "Common path of egress travel" ;
        ibco:label "1030.8" ;
        ibco:partOf ibc:ibc2021-1030 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1063 ;
        ibco:sourcePage 348 ;
        ibco:text "1030.8 Common path of egress travel. The common path of egress travel shall not exceed 30 feet (9144 mm) from any seat to a point where an occupant has a choice of two paths of egress travel to two exits." .

    ibc:ibc2021-1030.9.6 a ibco:Provision ;
        ibco:bbox "[58.839, 553.681, 289.786, 586.659]" ;
        ibco:hasChild ibc:ibc2021-1030.9.6.1,
            ibc:ibc2021-ch10-exception-1091 ;
        ibco:heading "Aisle measurement" ;
        ibco:label "1030.9.6" ;
        ibco:partOf ibc:ibc2021-1030.9 ;
        ibco:precedes ibc:ibc2021-ch10-exception-1091 ;
        ibco:sourcePage 349 ;
        ibco:text "1030.9.6 Aisle measurement. The clear width for aisles shall be measured to walls, edges of seating and tread edges except for permitted projections." .

    ibc:ibc2021-1031.5.2 a ibco:Provision ;
        ibco:bbox "[73.186, 309.819, 304.343, 397.736]" ;
        ibco:hasChild ibc:ibc2021-1031.5.2.1,
            ibc:ibc2021-1031.5.2.2 ;
        ibco:heading "Ladders or steps" ;
        ibco:label "1031.5.2" ;
        ibco:partOf ibc:ibc2021-1031.5 ;
        ibco:precedes ibc:ibc2021-1031.5.2.1 ;
        ibco:sourcePage 354 ;
        ibco:text "1031.5.2 Ladders or steps. Area wells with a vertical depth of more than 44 inches (1118 mm) shall be equipped with an approved permanently affixed ladder or steps. The ladder or steps shall not be obstructed by the emergency escape and rescue opening when the window or door is in the open position. Ladders or steps required by this section shall not be required to comply with Section 1011." .

    ibc:ibc2021-ch10-exception-0052 a ibco:Exception ;
        ibco:bbox "[58.801, 194.723, 108.799, 205.749]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0053,
            ibc:ibc2021-ch10-list_item-0054 ;
        ibco:partOf ibc:ibc2021-1004.7 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0053 ;
        ibco:sourcePage 307 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0078 a ibco:Exception ;
        ibco:bbox "[85.18, 390.756, 135.058, 401.781]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0079,
            ibc:ibc2021-ch10-list_item-0082 ;
        ibco:partOf ibc:ibc2021-1005.7.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0079 ;
        ibco:sourcePage 308 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0140 a ibco:Exception ;
        ibco:bbox "[70.781, 609.79, 120.66, 620.815]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0141,
            ibc:ibc2021-ch10-list_item-0142 ;
        ibco:partOf ibc:ibc2021-1007.1.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0141 ;
        ibco:sourcePage 311 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0159 a ibco:Exception ;
        ibco:bbox "[85.199, 420.785, 304.218, 497.786]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0160,
            ibc:ibc2021-ch10-list_item-0161 ;
        ibco:partOf ibc:ibc2021-1008.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0160 ;
        ibco:sourcePage 312 ;
        ibco:text "Exception: For auditoriums, theaters, concert or opera halls and similar assembly occupancies, the illumination at the walking surface is permitted to be reduced during performances by one of the following methods provided that the required illumination is automatically restored upon activation of a premises’ fire alarm system:" .

    ibc:ibc2021-ch10-exception-0164 a ibco:Exception ;
        ibco:bbox "[346.191, 106.666, 565.213, 139.644]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0165,
            ibc:ibc2021-ch10-list_item-0166 ;
        ibco:partOf ibc:ibc2021-1008.2.3 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0165 ;
        ibco:sourcePage 312 ;
        ibco:text "Exception: Illumination shall not be required where the path of the exit discharge meets both of the following requirements:" .

    ibc:ibc2021-ch10-exception-0188 a ibco:Exception ;
        ibco:bbox "[58.799, 340.727, 108.797, 351.752]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0189,
            ibc:ibc2021-ch10-list_item-0190 ;
        ibco:partOf ibc:ibc2021-1009.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0189 ;
        ibco:sourcePage 313 ;
        ibco:text "Exceptions:" .

    ibc:ibc2021-ch10-exception-0203 a ibco:Exception ;
        ibco:bbox "[331.783, 95.661, 381.661, 106.687]" ;
        ibco:hasChild ibc:ibc2021-ch10-list_item-0204,
            ibc:ibc2021-ch10-list_item-0205 ;
        ibco:partOf ibc:ibc2021-1009.2.1 ;
        ibco:precedes ibc:ibc2021-ch10-list_item-0204 ;
        ibco:sourcePage 313 ;
