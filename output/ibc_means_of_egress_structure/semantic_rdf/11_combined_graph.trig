        ibco:statementType "declarative" ;
        ibco:text "1.3. An exit." .

    ibc:sem-ibc2021-ch10-list_item-1057 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1057 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1057-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1057-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1057 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In facilities with open-air assembly seating of Type III, IV or V construction, the total exit access travel distance to one of the following shall not exceed 400 feet (122 m):" .

    ibc:sem-ibc2021-ch10-list_item-1058 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1058 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1058 ;
        ibco:statementType "declarative" ;
        ibco:text "2.1. The closest riser of an exit access stairway." .

    ibc:sem-ibc2021-ch10-list_item-1059 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1059 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1059 ;
        ibco:statementType "declarative" ;
        ibco:text "2.2. The closest slope of an exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-1060 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1060 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1060 ;
        ibco:statementType "declarative" ;
        ibco:text "2.3. An exit." .

    ibc:sem-ibc2021-ch10-list_item-1061 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1061 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1061-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1061 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. In facilities with open-air assembly seating of Type I or II construction, the total exit access travel distance shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-1064 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1064 ;
        ibco:appliesTo ibc:concept-for-areas-serving-less-than-50-occupants-the-common-path-of-egress-travel ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1064-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1064-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1064 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. For areas serving less than 50 occupants, the common path of egress travel shall not exceed 75 feet (22 860 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1065 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1065 ;
        ibco:appliesTo ibc:concept-for-smoke-protected-or-open-air-assembly-seating-the-common-path-of-egress-travel ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1065-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1065-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1065 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. For smoke-protected or open-air assembly seating, the common path of egress travel shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1070 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1070 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1070 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Forty-eight inches (1219 mm) for stepped aisles having seating on both sides." .

    ibc:sem-ibc2021-ch10-list_item-1072 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1072 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1072 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Thirty-six inches (914 mm) for stepped aisles having seating on only one side." .

    ibc:sem-ibc2021-ch10-list_item-1074 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1074 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1074-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1074 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Twenty-three inches (584 mm) between a stepped aisle handrail or guard and seating where the stepped aisle is subdivided by a mid-aisle handrail." .

    ibc:sem-ibc2021-ch10-list_item-1075 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1075 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1075 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Forty-two inches (1067 mm) for level or ramped aisles having seating on both sides." .

    ibc:sem-ibc2021-ch10-list_item-1077 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1077 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1077-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1077 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Thirty-six inches (914 mm) where the aisle serves less than 50 seats." .

    ibc:sem-ibc2021-ch10-list_item-1078 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1078 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1078-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1078 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Thirty inches (762 mm) where the aisle serves less than 15 seats and does not serve as part of an accessible route." .

    ibc:sem-ibc2021-ch10-list_item-1079 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1079 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1079 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Thirty-six inches (914 mm) for level or ramped aisles having seating on only one side." .

    ibc:sem-ibc2021-ch10-list_item-1086 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1086 ;
        ibco:appliesTo ibc:concept-dead-end-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1086-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1086-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1086 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Dead-end aisles shall be not greater than 20 feet (6096 mm) in length." .

    ibc:sem-ibc2021-ch10-list_item-1087 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1087 ;
        ibco:appliesTo ibc:concept-dead-end-aisles-longer-than-16-rows-are ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1087-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1087-condition-1,
            ibc:sem-ibc2021-ch10-list_item-1087-condition-2,
            ibc:sem-ibc2021-ch10-list_item-1087-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1087-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1087-measurement-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1087 ;
        ibco:statementType "permission" ;
        ibco:text "2. Dead-end aisles longer than 16 rows are permitted where seats beyond the 16th row dead-end aisle are not more than 24 seats from another aisle, measured along a row of seats having a minimum clear width of 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1088 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1088 ;
        ibco:appliesTo ibc:concept-for-smoke-protected-or-open-air-assembly-seating-the-dead-end-aisle-length-of-vertical-aisles ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1088-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1088 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. For smoke-protected or open-air assembly seating, the dead-end aisle length of vertical aisles shall not exceed a distance of 21 rows." .

    ibc:sem-ibc2021-ch10-list_item-1089 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1089 ;
        ibco:appliesTo ibc:concept-for-smoke-protected-or-open-air-assembly-seating-a-longer-dead-end-aisle-is ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1089-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1089-condition-1,
            ibc:sem-ibc2021-ch10-list_item-1089-condition-2,
            ibc:sem-ibc2021-ch10-list_item-1089-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1089-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1089-measurement-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1089 ;
        ibco:statementType "permission" ;
        ibco:text "4. For smoke-protected or open-air assembly seating, a longer dead-end aisle is permitted where seats beyond the 21-row dead-end aisle are not more than 40 seats from another aisle, measured along a row of seats having an aisle accessway with a minimum clear width of 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row." .

    ibc:sem-ibc2021-ch10-list_item-1100 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1100 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1100-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1100-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1100 ;
        ibco:statementType "declarative" ;
        ibco:text "1. A depth of not less than 22 inches (559 mm) where the treads on the descending side of the transition have greater depth." .

    ibc:sem-ibc2021-ch10-list_item-1101 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1101 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1101-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1101-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1101 ;
        ibco:statementType "declarative" ;
        ibco:text "2. A depth of not less than 30 inches (762 mm) where the treads on the descending side of the transition have lesser depth." .

    ibc:sem-ibc2021-ch10-list_item-1133 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1133 ;
        ibco:appliesTo ibc:concept-riser-height-nonuniformity ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1133-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-1133-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-1133-atomic-3,
            ibc:sem-ibc2021-ch10-list_item-1133-atomic-4 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1133-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1133-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1133-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-1133-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1133 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Riser height nonuniformity shall be limited to the extent necessitated by changes in the gradient of the adjoining seating area to maintain adequate sightlines. Where nonuniformities exceed 3/16 inch (4.8 mm) between adjacent risers, the exact location of such nonuniformities shall be indicated with a distinctive marking stripe on each tread at the nosing or leading edge adjacent to the nonuniform risers. Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide. The edge marking stripe shall be distinctively different from the contrasting marking stripe." .

    ibc:sem-ibc2021-ch10-list_item-1134 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1134 ;
        ibco:appliesTo ibc:concept-riser-heights-not-exceeding-9-inches-229-mm ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1134-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1134-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1134-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1134 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Riser heights not exceeding 9 inches (229 mm) shall be permitted where they are necessitated by the slope of the adjacent seating areas to maintain sightlines." .

    ibc:sem-ibc2021-ch10-list_item-1141 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1141 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1141-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1141 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with 200 or fewer seats, the seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1142 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1142 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1142-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1142 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In a building, room or space used for assembly purposes or portions thereof with seating at tables and without ramped or tiered floors for seating, the seats shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1143 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1143 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1143-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1143 ;
        ibco:statementType "obligation" ;
        ibco:text "3. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with greater than 200 seats, the seats shall be fastened together in groups of not less than three or the seats shall be securely fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1144 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1144 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1144-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-1144-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1144-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1144 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. In a building, room or space used for assembly purposes where flexibility of the seating arrangement is an integral part of the design and function of the space and seating is on tiered levels, not more than 200 seats shall not be required to be fastened to the floor. Plans showing seating, tiers and aisles shall be submitted for approval." .

    ibc:sem-ibc2021-ch10-list_item-1145 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1145 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1145-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1145 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. Groups of seats within a building, room or space used for assembly purposes separated from other seating by railings, guards, partial height walls or similar barriers with level floors and having not more than 14 seats per group shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1146 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1146 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1146-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1146 ;
        ibco:statementType "prohibition" ;
        ibco:text "6. Seats intended for musicians or other performers and separated by railings, guards, partial height walls or similar barriers shall not be required to be fastened to the floor." .

    ibc:sem-ibc2021-ch10-list_item-1149 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1149 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1149-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1149 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Handrails are not required for ramped aisles with seating on both sides." .

    ibc:sem-ibc2021-ch10-list_item-1150 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1150 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1150-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1150-condition-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1014.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1150 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Handrails are not required where, at the side of the aisle, there is a guard with a top surface that complies with the graspability requirements of handrails in accordance with Section 1014.3." .

    ibc:sem-ibc2021-ch10-list_item-1151 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1151 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1151-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1151 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Handrail extensions are not required at the top and bottom of stepped aisles and ramped aisles to permit crossovers within the aisles." .

    ibc:sem-ibc2021-ch10-list_item-1160 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1160 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1160-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.17.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1160 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Guards that impact sightlines shall be permitted to comply with Section 1030.17.3." .

    ibc:sem-ibc2021-ch10-list_item-1161 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1161 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1161-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1161-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1161-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1161 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Bleachers, grandstands and folding and telescopic seating shall not be required to have perimeter guards where the seating is located adjacent to a wall and the space between the wall and the seating is less than 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1169 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1169 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1169-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1169 ;
        ibco:statementType "permission" ;
        ibco:text "1. Group R-2 occupancies located in stories with only one exit or access to only one exit as permitted by Tables 1006.3.4(1) and 1006.3.4(2)." .

    ibc:sem-ibc2021-ch10-list_item-1170 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1170 ;
        ibco:appliesTo ibc:concept-group-r-3-and-r-4-occupancies-basements-and-sleeping-rooms-below-the-fourth-story-above-grade-plane ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1170-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-1170-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-1170-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1170-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1170 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Group R-3 and R-4 occupancies. Basements and sleeping rooms below the fourth story above grade plane shall have not fewer than one emergency escape and rescue opening in accordance with this section. Where basements contain one or more sleeping rooms, an emergency escape and rescue opening shall be required in each sleeping room, but shall not be required in adjoining areas of the basement. Such openings shall open directly into a public way or to a yard or court that opens to a public way." .

    ibc:sem-ibc2021-ch10-list_item-1172 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1172 ;
        ibco:appliesTo ibc:concept-basements-with-a-ceiling-height-of-less-than-80-inches-2032-mm ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1172-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1172-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1172 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Basements with a ceiling height of less than 80 inches (2032 mm) shall not be required to have emergency escape and rescue openings." .

    ibc:sem-ibc2021-ch10-list_item-1173 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1173 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1173-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1173 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Emergency escape and rescue openings are not required from basements or sleeping rooms that have an exit door or exit access door that opens directly into a public way or to a yard, court or exterior egress balcony that opens to a public way." .

    ibc:sem-ibc2021-ch10-list_item-1174 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1174 ;
        ibco:appliesTo ibc:concept-basements-without-habitable-spaces-and-having-not-more-than-200-square-feet-18-6-m2-in-floor-area ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1174-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1174-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1174 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Basements without habitable spaces and having not more than 200 square feet (18.6 m2) in floor area shall not be required to have emergency escape and rescue openings." .

    ibc:sem-ibc2021-ch10-list_item-1175 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1175 ;
        ibco:appliesTo ibc:concept-storm-shelters ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1175-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1175-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1175 ;
        ibco:statementType "exemption" ;
        ibco:text "4. Storm shelters are not required to comply with this section where the shelter is constructed in accordance with ICC 500." .

    ibc:sem-ibc2021-ch10-list_item-1176 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1176 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1176-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1176-condition-1,
            ibc:sem-ibc2021-ch10-list_item-1176-condition-2 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1176 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. Within individual dwelling and sleeping units in Groups R-2 and R-3, where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1, 903.3.1.2 or 903.3.1.3, sleeping rooms in basements shall not be required to have emergency escape and rescue openings provided that the basement has one of the following:" .

    ibc:sem-ibc2021-ch10-list_item-1177 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1177 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1177 ;
        ibco:statementType "declarative" ;
        ibco:text "5.1. One means of egress and one emergency escape and rescue opening." .

    ibc:sem-ibc2021-ch10-list_item-1178 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1178 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1178 ;
        ibco:statementType "declarative" ;
        ibco:text "5.2. Two means of egress." .

