        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-1193 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: A drainage system for area wells is not required where the foundation is on well-drained soil or sand-gravel mixture soils in accordance with the United Soil Classification System, Group I Soils, in accordance with Section 1803.5.1." .

