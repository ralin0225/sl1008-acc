            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-exception-0569 ;
        ibco:statementType "exception" ;
        ibco:text "Exception: The radius restriction shall not apply to curved stairways in Group R-3 and within individual dwelling units in Group R-2." .

