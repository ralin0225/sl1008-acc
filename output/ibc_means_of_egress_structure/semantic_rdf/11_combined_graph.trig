        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0266 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Persons able to use the exit stairway do so as soon as possible, unless they are assisting others." .

    ibc:sem-ibc2021-ch10-list_item-0267 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0267 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0267 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Information on planned availability of assistance in the use of stairs or supervised operation of elevators and how to summon such assistance." .

    ibc:sem-ibc2021-ch10-list_item-0268 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0268 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0268-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0268 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Directions for use of the two-way communication system where provided." .

    ibc:sem-ibc2021-ch10-list_item-0273 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0273 ;
        ibco:appliesTo ibc:concept-accessibleunit,
            ibc:concept-door,
            ibc:concept-meansofegress,
            ibc:concept-sleepingunit,
            ibc:concept-typeaunit,
            ibc:concept-typebunit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0273-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0273 ;
        ibco:statementType "exemption" ;
        ibco:text "1. In Group R-2 and R-3 dwelling and sleeping units that are not required to be an Accessible unit, Type A unit or Type B unit, the minimum width shall not apply to door openings that are not part of the required means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0274 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0274 ;
        ibco:appliesTo ibc:concept-accessibleunit,
            ibc:concept-door,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0274-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0274-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0274 ;
        ibco:statementType "exemption" ;
        ibco:text "2. In Group I-3, door openings to resident sleeping units that are not required to be an Accessible unit shall have a minimum clear opening width of 28 inches (711 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0275 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0275 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0275-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0275-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0275 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Door openings to storage closets less than 10 square feet (0.93 m2) in area shall not be limited by the minimum clear opening width." .

    ibc:sem-ibc2021-ch10-list_item-0276 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0276 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0276-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0276 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. The maximum width of door leaves in revolving doors that comply with Section 1010.3.1 shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-0277 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0277 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0277-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1010.3.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0277 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. The maximum width of door leaves in poweroperated doors that comply with Section 1010.3.2 shall not be limited." .

    ibc:sem-ibc2021-ch10-list_item-0278 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0278 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0278-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0278-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0278 ;
        ibco:statementType "obligation" ;
        ibco:text "6. Door openings within a dwelling unit or sleeping unit shall have a minimum clear opening height of 78 inches (1981 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0279 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0279 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-sleepingunit,
            ibc:concept-typebunit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0279-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0279-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0279-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0279 ;
        ibco:statementType "exemption" ;
        ibco:text "7. In dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, exterior door openings other than the required exit door shall have a minimum clear opening height of 76 inches (1930 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0280 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0280 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-sleepingunit,
            ibc:concept-typebunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0280-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0280 ;
        ibco:statementType "exemption" ;
        ibco:text "8. In Groups I-1, R-2, R-3 and R-4, in dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, the minimum clear opening widths shall not apply to interior egress doors." .

    ibc:sem-ibc2021-ch10-list_item-0281 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0281 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-typebunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0281-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0281-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0281 ;
        ibco:statementType "obligation" ;
        ibco:text "9. Door openings required to be accessible within Type B units intended for user passage shall have a minimum clear opening width of 31.75 inches (806 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0282 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0282 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0282-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0282-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0282-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0282 ;
        ibco:statementType "obligation" ;
        ibco:text "10. Doors to walk-in freezers and coolers less than 1,000 square feet (93 m2) in area shall have a maximum width of 60 inches (1524 mm) nominal." .

    ibc:sem-ibc2021-ch10-list_item-0283 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0283 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0283-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0283-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0283 ;
        ibco:statementType "obligation" ;
        ibco:text "11. Doors serving nonaccessible single-user shower or sauna compartments, toilet stalls or dressing, fitting or changing rooms shall have a minimum clear opening width of 20 inches (508 mm). " .

    ibc:sem-ibc2021-ch10-list_item-0288 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0288 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0288 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Private garages, office areas, factory and storage areas with an occupant load of 10 or less." .

    ibc:sem-ibc2021-ch10-list_item-0289 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0289 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0289 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Group I-3 occupancies used as a place of detention." .

    ibc:sem-ibc2021-ch10-list_item-0290 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0290 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0290 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Critical or intensive care patient rooms within suites of health care facilities." .

    ibc:sem-ibc2021-ch10-list_item-0291 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0291 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0291 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Doors within or serving a single dwelling unit in Groups R-2 and R-3." .

    ibc:sem-ibc2021-ch10-list_item-0292 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0292 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0292-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0292 ;
        ibco:statementType "declarative" ;
        ibco:text "5. In other than Group H occupancies, revolving doors complying with Section 1010.3.1." .

    ibc:sem-ibc2021-ch10-list_item-0293 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0293 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0293-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1010.3.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0293 ;
        ibco:statementType "declarative" ;
        ibco:text "6. In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies complying with Section 1010.3.3." .

    ibc:sem-ibc2021-ch10-list_item-0294 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0294 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1010.3.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0294 ;
        ibco:statementType "declarative" ;
        ibco:text "7. Power-operated doors in accordance with Section 1010.3.2." .

    ibc:sem-ibc2021-ch10-list_item-0295 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0295 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0295 ;
        ibco:statementType "declarative" ;
        ibco:text "8. Doors serving a bathroom within an individual sleeping unit in Group R-1." .

    ibc:sem-ibc2021-ch10-list_item-0296 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0296 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-meansofegress,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0296-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0296-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0296 ;
        ibco:statementType "permission" ;
        ibco:text "9. In other than Group H occupancies, manually operated horizontal sliding doors are permitted in a means of egress from spaces with an occupant load of 10 or less." .

    ibc:sem-ibc2021-ch10-list_item-0299 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0299 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0299-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0299-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0299 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)." .

    ibc:sem-ibc2021-ch10-list_item-0300 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0300 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0300-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0300-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0300-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0300-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0300 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm). The force to open doors shall comply with the following:" .

    ibc:sem-ibc2021-ch10-list_item-0301 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0301 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0301-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0301-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0301 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. For interior swinging egress doors that are manually operated, other than doors required to be fire rated, the force for pushing or pulling open the door shall not exceed 5 pounds (22 N)." .

    ibc:sem-ibc2021-ch10-list_item-0302 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0302 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0302-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0302 ;
        ibco:statementType "obligation" ;
        ibco:text "2. For other swinging doors, sliding doors or folding doors, and doors required to be fire rated, the door shall require not more than a 30-pound (133 N) force to be set in motion and shall move to a fullopen position when subjected to not more than a 15-pound (67 N) force." .

    ibc:sem-ibc2021-ch10-list_item-0307 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0307 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0307-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0307-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0307 ;
        ibco:statementType "permission" ;
        ibco:text "1. At doors serving individual dwelling units or sleeping units in Groups R-2 and R-3 : a door is permitted to open at the top step of an interior flight of stairs, provided that the door does not swing over the top step." .

    ibc:sem-ibc2021-ch10-list_item-0308 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0308 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-door ;
        ibco:confidence 0.85 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0308-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0308-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0308-condition-2,
            ibc:sem-ibc2021-ch10-list_item-0308-condition-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0308-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0308 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. At exterior doors serving Groups F, H, R-2 and S and where such doors are not part of an accessible route, the landing at an exterior door shall not be more than 7 inches (178 mm) below the landing on the egress side of the door, provided that the door, other than an exterior storm or screen door, does not swing over the landing." .

    ibc:sem-ibc2021-ch10-list_item-0309 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0309 ;
        ibco:appliesTo ibc:concept-accessibleunit,
            ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit,
            ibc:concept-typeaunit,
            ibc:concept-typebunit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0309-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0309-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0309-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0309-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0309 ;
        ibco:statementType "exemption" ;
        ibco:text "3. At exterior doors serving Group U and individual dwelling units and sleeping units in Groups R-2 and R-3, and where such units are not required to be Accessible units, Type A units or Type B units, the landing at an exterior doorway shall be not more than 73/4 inches (197 mm) below the landing on the egress side of the door. Such doors, including storm or screen doors, shall be permitted to swing over either landing." .

    ibc:sem-ibc2021-ch10-list_item-0310 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0310 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0310-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0310 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Variations in elevation due to differences in finish materials, but not more than 1/2 inch (12.7 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0311 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0311 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0311-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0311 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Exterior decks, patios or balconies that are part of Type B dwelling units or sleeping units, that have impervious surfaces and that are not more than 4 inches (102 mm) below the finished floor level of the adjacent interior space of the dwelling unit or sleeping unit." .

    ibc:sem-ibc2021-ch10-list_item-0312 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0312 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0312-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0312-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1103.2.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0312 ;
        ibco:statementType "exemption" ;
        ibco:text "6. Doors serving equipment spaces not required to be accessible in accordance with Section 1103.2.9 and serving an occupant load of five or less shall be permitted to have a landing on one side to be not more than 7 inches (178 mm) above or below the landing on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0317 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0317 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0317-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0317-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0317-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0317 ;
        ibco:statementType "obligation" ;
        ibco:text "1. In occupancy Group R-2 or R-3, threshold heights for sliding and side-hinged exterior doors shall be permitted to be up to 73/4 inches (197 mm) in height if all of the following apply:" .

    ibc:sem-ibc2021-ch10-list_item-0318 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0318 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0318 ;
        ibco:statementType "declarative" ;
        ibco:text "1.1. The door is not part of the required means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0319 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0319 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0319 ;
        ibco:statementType "declarative" ;
        ibco:text "1.2. The door is not part of an accessible route as required by Chapter 11." .

    ibc:sem-ibc2021-ch10-list_item-0320 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0320 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0320 ;
        ibco:statementType "declarative" ;
        ibco:text "1.3. The door is not part of an Accessible unit, Type A unit or Type B unit." .

    ibc:sem-ibc2021-ch10-list_item-0321 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0321 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-typebunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0321-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0321-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0321-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0321-measurement-2 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1010.1.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0321 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In Type B units, where Exception 5 to Section 1010.1.4 permits a 4-inch (102 mm) elevation change at the door, the threshold height on the exterior side of the door shall not exceed 43/4 inches (120 mm) in height above the exterior deck, patio or balcony for sliding doors or 41/2 inches (114 mm) above the exterior deck, patio or balcony for other doors." .

    ibc:sem-ibc2021-ch10-list_item-0324 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0324 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0324-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0324-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0324 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The minimum distance between horizontal sliding power-operated doors in a series shall be 48 inches (1219 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0325 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0325 ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0325-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0325-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0325 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Storm and screen doors serving individual dwelling units in Groups R-2 and R-3 need not be spaced 48 inches (1219 mm) from the other door." .

    ibc:sem-ibc2021-ch10-list_item-0326 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0326 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0326-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0326 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Doors within individual dwelling units in Groups R-2 and R-3 other than within Type A dwelling units." .

    ibc:sem-ibc2021-ch10-list_item-0330 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0330 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0330 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Places of detention or restraint." .

    ibc:sem-ibc2021-ch10-list_item-0331 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0331 ;
        ibco:appliesTo ibc:concept-where-manually-operated-bolt-locks-are ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0331-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0331-condition-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1010.2.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0331 ;
        ibco:statementType "permission" ;
        ibco:text "2. Where manually operated bolt locks are permitted by Section 1010.2.5." .

    ibc:sem-ibc2021-ch10-list_item-0332 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0332 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0332-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1010.2.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0332 ;
        ibco:statementType "permission" ;
        ibco:text "3. Doors with automatic flush bolts as permitted by Section 1010.2.4, Item 4." .

    ibc:sem-ibc2021-ch10-list_item-0333 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0333 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0333-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1010.2.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0333 ;
        ibco:statementType "permission" ;
        ibco:text "4. Doors from individual dwelling units and sleeping units of Group R occupancies as permitted by Section 1010.2.4, Item 5." .

    ibc:sem-ibc2021-ch10-list_item-0338 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0338 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0338 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Places of detention or restraint." .

    ibc:sem-ibc2021-ch10-list_item-0339 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0339 ;
        ibco:confidence 0.73 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0339-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0339-condition-2,
            ibc:sem-ibc2021-ch10-list_item-0339-condition-3 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0339 ;
        ibco:statementType "declarative" ;
        ibco:text "2. In Group I-1, Condition 2 and Group I-2 occupancies where the clinical needs of persons receiving care require containment or where persons receiving care pose a security threat, provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times." .

    ibc:sem-ibc2021-ch10-list_item-0340 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0340 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0340-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0340 ;
        ibco:statementType "permission" ;
        ibco:text "3. In buildings in occupancy Group A having an occupant load of 300 or less, Groups B, F, M and S, and in places of religious worship, the main door or doors are permitted to be equipped with key-operated locking devices from the egress side provided:" .

    ibc:sem-ibc2021-ch10-list_item-0341 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0341 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0341 ;
        ibco:statementType "declarative" ;
        ibco:text "3.1. The locking device is readily distinguishable as locked." .

    ibc:sem-ibc2021-ch10-list_item-0342 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0342 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0342-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0342-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0342 ;
        ibco:statementType "obligation" ;
        ibco:text "3.2. A readily visible durable sign is posted on the egress side on or adjacent to the door stating: THIS DOOR TO REMAIN UNLOCKED WHEN THIS SPACE IS OCCUPIED. The sign shall be in letters 1 inch (25 mm) high on a contrasting background." .

    ibc:sem-ibc2021-ch10-list_item-0343 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0343 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0343 ;
        ibco:statementType "declarative" ;
        ibco:text "3.3. The use of the key-operated locking device is revocable by the building official for due cause." .

    ibc:sem-ibc2021-ch10-list_item-0344 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0344 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0344-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0344-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0344-condition-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0344 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Where egress doors are used in pairs, approved automatic flush bolts shall be permitted to be used, provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware." .

    ibc:sem-ibc2021-ch10-list_item-0345 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0345 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0345-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0345 ;
        ibco:statementType "permission" ;
        ibco:text "5. Doors from individual dwelling or sleeping units of Group R occupancies having an occupant load of 10 or less are permitted to be equipped with a night latch, dead bolt or security chain, provided such devices are openable from the inside without the use of a key or tool." .

    ibc:sem-ibc2021-ch10-list_item-0346 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0346 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0346 ;
        ibco:statementType "declarative" ;
        ibco:text "6. Fire doors after the minimum elevated temperature has disabled the unlatching mechanism in accordance with listed fire door test procedures." .

    ibc:sem-ibc2021-ch10-list_item-0347 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0347 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0347-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0347 ;
        ibco:statementType "obligation" ;
        ibco:text "7. Doors serving roofs not intended to be occupied shall be permitted to be locked preventing entry to the building from the roof." .

    ibc:sem-ibc2021-ch10-list_item-0348 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0348 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0348-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0348-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0348-condition-2,
            ibc:sem-ibc2021-ch10-list_item-0348-condition-3 ;
        ibco:modality "must" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0348 ;
        ibco:statementType "obligation" ;
        ibco:text "8. Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0349 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0349 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-occupantload,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0349-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0349-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0349-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1004.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0349 ;
        ibco:statementType "obligation" ;
        ibco:text "8.1. The maximum occupant load shall be posted where required by Section 1004.9. Such signage shall be permanently affixed inside the building and shall be posted in a conspicuous space near all the exit access doorways." .

    ibc:sem-ibc2021-ch10-list_item-0350 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0350 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0350-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1009.8.1,
            ibc:ibc2021-1009.8.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0350 ;
        ibco:statementType "obligation" ;
        ibco:text "8.2. A weatherproof telephone or two-way communication system installed in accordance with Sections 1009.8.1 and 1009.8.2 shall be located adjacent to not less than one required exit access door on the exterior side." .

    ibc:sem-ibc2021-ch10-list_item-0351 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0351 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0351-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0351 ;
        ibco:statementType "obligation" ;
        ibco:text "8.3. The egress door locking device is readily distinguishable as locked and shall be a key-operated locking device." .

    ibc:sem-ibc2021-ch10-list_item-0352 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0352 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0352-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0352-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0352-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0352 ;
        ibco:statementType "obligation" ;
        ibco:text "8.4. A clear window or glazed door opening, not less than 5 square feet (0.46 m2) in area, shall be provided at each exit access door to determine if there are occupants using the outdoor area." .

    ibc:sem-ibc2021-ch10-list_item-0353 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0353 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0353-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0353-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0353 ;
        ibco:statementType "obligation" ;
        ibco:text "8.5. A readily visible, durable sign shall be posted on the interior side on or adjacent to each locked required exit access door serving the exterior area stating, \"THIS DOOR TO REMAIN UNLOCKED WHEN THE OUTDOOR AREA IS OCCUPIED.\" The letters on the sign shall be not less than 1 inch (25.4 mm) high on a contrasting background." .

    ibc:sem-ibc2021-ch10-list_item-0354 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0354 ;
        ibco:appliesTo ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0354-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1004 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0354 ;
        ibco:statementType "prohibition" ;
        ibco:text "8.6. The occupant load of the occupied exterior area shall not exceed 300 occupants in accordance with Section 1004." .

    ibc:sem-ibc2021-ch10-list_item-0355 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0355 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0355-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0355 ;
        ibco:statementType "permission" ;
        ibco:text "9. Locking devices are permitted on doors to balconies, decks or other exterior spaces serving individual dwelling or sleeping units." .

    ibc:sem-ibc2021-ch10-list_item-0356 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0356 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0356-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0356-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0356 ;
        ibco:statementType "permission" ;
        ibco:text "10. Locking devices are permitted on doors to balconies, decks or other exterior spaces of 250 square feet (23.23 m2) or less serving a private office space." .

    ibc:sem-ibc2021-ch10-list_item-0359 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0359 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0359-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0359 ;
        ibco:statementType "exemption" ;
        ibco:text "1. On doors not required for egress in individual dwelling units or sleeping units." .

    ibc:sem-ibc2021-ch10-list_item-0360 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0360 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0360-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0360-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0360 ;
        ibco:statementType "permission" ;
        ibco:text "2. Where a pair of doors serves a storage or equipment room, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf." .

    ibc:sem-ibc2021-ch10-list_item-0361 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0361 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0361-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0361-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0361-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0361 ;
        ibco:statementType "permission" ;
        ibco:text "3. Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0362 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0362 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0362-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0362-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0362-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0362-condition-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0362 ;
        ibco:statementType "permission" ;
        ibco:text "4. Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0363 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0363 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0363-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0363-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0363-condition-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0363 ;
        ibco:statementType "permission" ;
        ibco:text "5. Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware." .

    ibc:sem-ibc2021-ch10-list_item-0367 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0367 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0367-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0367 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Stairway discharge doors shall be openable from the egress side and shall only be locked from the opposite side." .

    ibc:sem-ibc2021-ch10-list_item-0368 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0368 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0368-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0368 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. This section shall not apply to doors arranged in accordance with Section 403.5.3." .

    ibc:sem-ibc2021-ch10-list_item-0369 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0369 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0369-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0369-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0369-condition-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0369 ;
        ibco:statementType "permission" ;
        ibco:text "3. Stairway exit doors are permitted to be locked from the side opposite the egress side, provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building." .

    ibc:sem-ibc2021-ch10-list_item-0370 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0370 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0370-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0370-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0370-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0370 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group B, F, M and S occupancies where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:sem-ibc2021-ch10-list_item-0371 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0371 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-dwellingunit,
            ibc:concept-exit,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0371-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0371-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0371-condition-2 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1006.3.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0371 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group R-2 occupancies where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006.3.4." .

    ibc:sem-ibc2021-ch10-list_item-0373 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0373 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0373-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0373 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The door shall be capable of being unlocked from outside the room with a key or other approved means." .

    ibc:sem-ibc2021-ch10-list_item-0374 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0374 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0374-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0374 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The door shall be openable from within the room in accordance with Section 1010.2." .

    ibc:sem-ibc2021-ch10-list_item-0375 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0375 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0375-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0375 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Modifications shall not be made to listed panic hardware, fire door hardware or door closers." .

    ibc:sem-ibc2021-ch10-list_item-0376 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0376 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0376-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0376-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0376 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Modifications to fire door assemblies shall be in accordance with NFPA 80. Remote locking or unlocking of doors from an approved location shall be permitted in addition to the unlocking operation in Item 1." .

    ibc:sem-ibc2021-ch10-list_item-0379 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0379 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0379-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0379 ;
        ibco:statementType "obligation" ;
        ibco:text "1. A main exit of a Group A occupancy shall be permitted to have locking devices in accordance with Section 1010.2.4, Item 3." .

    ibc:sem-ibc2021-ch10-list_item-0380 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0380 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0380-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.11,
            ibc:ibc2021-1010.2.12 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0380 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Doors provided with panic hardware or fire exit hardware and serving a Group A or E occupancy shall be permitted to be electrically locked in accordance with Section 1010.2.11 or 1010.2.12." .

    ibc:sem-ibc2021-ch10-list_item-0381 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0381 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0381-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0381 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Exit access doors serving occupied exterior areas shall be permitted to be locked in accordance with Section 1010.2.4, Item 8." .

    ibc:sem-ibc2021-ch10-list_item-0382 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0382 ;
        ibco:appliesTo ibc:concept-courtrooms ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0382-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.13 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0382 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Courtrooms shall be permitted to be locked in accordance with Section 1010.2.13, Item 3. " .

    ibc:sem-ibc2021-ch10-list_item-0386 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0386 ;
        ibco:appliesTo ibc:concept-panic-hardware ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0386-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0386 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Panic hardware shall be listed in accordance with UL 305." .

    ibc:sem-ibc2021-ch10-list_item-0387 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0387 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0387-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0387 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Fire exit hardware shall be listed in accordance with UL 10C and UL 305." .

    ibc:sem-ibc2021-ch10-list_item-0388 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0388 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0388-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0388 ;
        ibco:statementType "obligation" ;
        ibco:text "3. The actuating portion of the releasing device shall extend not less than one-half of the door leaf width." .

    ibc:sem-ibc2021-ch10-list_item-0389 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0389 ;
        ibco:appliesTo ibc:concept-the-maximum-unlatching-force ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0389-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0389 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. The maximum unlatching force shall not exceed 15 pounds (67 N)." .

    ibc:sem-ibc2021-ch10-list_item-0393 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0393 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0393 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The door hardware that is affixed to the door leaf has an obvious method of operation that is readily operated under all lighting conditions." .

    ibc:sem-ibc2021-ch10-list_item-0394 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0394 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0394-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.2.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0394 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The door hardware is capable of being operated with one hand and shall comply with Section 1010.2.1." .

    ibc:sem-ibc2021-ch10-list_item-0395 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0395 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0395 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Operation of the door hardware directly interrupts the power to the electric lock and unlocks the door immediately." .

    ibc:sem-ibc2021-ch10-list_item-0396 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0396 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0396 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Loss of power to the electric locking system automatically unlocks the door." .

    ibc:sem-ibc2021-ch10-list_item-0397 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0397 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0397-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0397-condition-1 ;
        ibco:modality "required" ;
        ibco:references ibc:ibc2021-1010.2.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0397 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Where panic or fire exit hardware is required by Section 1010.2.9, operation of the panic or fire exit hardware also releases the electric lock." .

    ibc:sem-ibc2021-ch10-list_item-0398 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0398 ;
        ibco:appliesTo ibc:concept-the-locking-system-units ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0398-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0398 ;
        ibco:statementType "obligation" ;
        ibco:text "6. The locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0400 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0400 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0400-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0400 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The sensor shall be installed on the egress side, arranged to detect an occupant approaching the doors, and shall cause the electric locking system to unlock." .

    ibc:sem-ibc2021-ch10-list_item-0401 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0401 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0401-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0401 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The electric locks shall be arranged to unlock by a signal from or loss of power to the sensor." .

    ibc:sem-ibc2021-ch10-list_item-0402 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0402 ;
        ibco:appliesTo ibc:concept-loss-of-power-to-the-lock-or-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0402-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0402 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Loss of power to the lock or locking system shall automatically unlock the electric locks." .

    ibc:sem-ibc2021-ch10-list_item-0403 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0403 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0403-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0403-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0403-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0403-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0403-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0403 ;
        ibco:statementType "obligation" ;
        ibco:text "4. The doors shall be arranged to unlock from a manual unlocking device located 40 inches to 48 inches (1016 mm to 1219 mm) vertically above the floor and within 5 feet (1524 mm) of the secured doors. Ready access shall be provided to the manual unlocking device and the device shall be clearly identified by a sign that reads “PUSH TO EXIT.” When operated, the manual unlocking device shall result in direct interruption of power to the electric lock—independent of other electronics—and the electric lock shall remain unlocked for not less than 30 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0404 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0404 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0404-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0404-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0404 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Activation of the building fire alarm system, where provided, shall automatically unlock the electric lock, and the electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:sem-ibc2021-ch10-list_item-0405 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0405 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0405-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0405-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0405-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0405 ;
        ibco:statementType "obligation" ;
        ibco:text "6. Activation of the building automatic sprinkler system or fire detection system, where provided, shall automatically unlock the electric lock. The electric lock shall remain unlocked until the fire alarm system has been reset." .

    ibc:sem-ibc2021-ch10-list_item-0406 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0406 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0406-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0406 ;
        ibco:statementType "obligation" ;
        ibco:text "7. Emergency lighting shall be provided on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0407 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0407 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0407-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0407 ;
        ibco:statementType "obligation" ;
        ibco:text "8. The door locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0409 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0409 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0409 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Group B, F, I, M, R, S and U occupancies." .

    ibc:sem-ibc2021-ch10-list_item-0410 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0410 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0410 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Group E classrooms with an occupant load of less than 50." .

    ibc:sem-ibc2021-ch10-list_item-0411 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0411 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0411-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0411-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0411 ;
        ibco:statementType "obligation" ;
        ibco:text "3. In courtrooms in Group A-3 and B occupancies, delayed egress locking systems shall be permitted to be installed on exit or exit access doors, other than the main exit or exit access door, in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0412 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0412 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0412 ;
        ibco:statementType "declarative" ;
        ibco:text "903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0414 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0414 ;
        ibco:appliesTo ibc:concept-the-delay-electronics-of-the-delayed-egress-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0414-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0414 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The delay electronics of the delayed egress locking system shall deactivate upon actuation of the automatic sprinkler system or automatic fire detection system, allowing immediate free egress." .

    ibc:sem-ibc2021-ch10-list_item-0415 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0415 ;
        ibco:appliesTo ibc:concept-the-delay-electronics-of-the-delayed-egress-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0415-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0415 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The delay electronics of the delayed egress locking system shall deactivate upon loss of power controlling the lock or lock mechanism, allowing immediate free egress." .

    ibc:sem-ibc2021-ch10-list_item-0416 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0416 ;
        ibco:appliesTo ibc:concept-the-delayed-egress-locking-system ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0416-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0416 ;
        ibco:statementType "obligation" ;
        ibco:text "3. The delayed egress locking system shall have the capability of being deactivated at the fire command center and other approved locations." .

    ibc:sem-ibc2021-ch10-list_item-0417 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0417 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0417-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0417-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0417-atomic-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0417 ;
        ibco:statementType "obligation" ;
        ibco:text "4. An attempt to egress shall initiate an irreversible process that shall allow such egress in not more than 15 seconds when a physical effort to exit is applied to the egress side door hardware for not more than 3 seconds. Initiation of the irreversible process shall activate an audible signal in the vicinity of the door. Once the delay electronics have been deactivated, rearming the delay electronics shall be by manual means only." .

    ibc:sem-ibc2021-ch10-list_item-0419 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0419 ;
        ibco:appliesTo ibc:concept-the-egress-path-from-any-point ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0419-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0419 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. The egress path from any point shall not pass through more than one delayed egress locking system." .

    ibc:sem-ibc2021-ch10-list_item-0421 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0421 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0421-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0421-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0421 ;
        ibco:statementType "obligation" ;
        ibco:text "1. In Group I-1, Condition 2, Group I-2 or I-3 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided that the combined delay does not exceed 30 seconds." .

    ibc:sem-ibc2021-ch10-list_item-0422 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0422 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0422-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0422 ;
        ibco:statementType "obligation" ;
        ibco:text "2. In Group I-1, Condition 1 or Group I-4 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided the combined delay does not exceed 30 seconds and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0423 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0423 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0423-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0423-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0423 ;
        ibco:statementType "obligation" ;
        ibco:text "6. A sign shall be provided on the door and shall be located above and within 12 inches (305 mm) of the door exit hardware:" .

    ibc:sem-ibc2021-ch10-list_item-0425 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0425 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0425-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0425 ;
        ibco:statementType "obligation" ;
        ibco:text "6.1. For doors that swing in the direction of egress, the sign shall read, \"PUSH UNTIL ALARM SOUNDS. DOOR CAN BE OPENED IN 15 [30] SECONDS.\"" .

    ibc:sem-ibc2021-ch10-list_item-0426 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0426 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0426-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0426 ;
        ibco:statementType "obligation" ;
        ibco:text "6.2. For doors that swing in the opposite direction of egress, the sign shall read, \"PULL UNTIL ALARM SOUNDS. DOOR CAN BE OPENED IN 15 [30] SECONDS.\"" .

    ibc:sem-ibc2021-ch10-list_item-0427 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0427 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0427-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0427 ;
        ibco:statementType "obligation" ;
        ibco:text "6.3. The sign shall comply with the visual character requirements in ICC A117.1." .

    ibc:sem-ibc2021-ch10-list_item-0428 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0428 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0428-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0428 ;
        ibco:statementType "obligation" ;
        ibco:text "7. Emergency lighting shall be provided on the egress side of the door." .

    ibc:sem-ibc2021-ch10-list_item-0429 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0429 ;
        ibco:appliesTo ibc:concept-the-delayed-egress-locking-system-units ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0429-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0429 ;
        ibco:statementType "obligation" ;
        ibco:text "8. The delayed egress locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0431 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0431 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0431-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0431-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0431-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0431-condition-2,
            ibc:sem-ibc2021-ch10-list_item-0431-condition-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0431 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Electric locking systems, including electro-mechanical locking systems and electromagnetic locking systems, shall be permitted to be locked in the means of egress in Group I-1 or I-2 occupancies where the clinical needs of persons receiving care require their containment. Controlled egress doors shall be permitted in such occupancies where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke detection system installed in accordance with Section 907, provided that the doors are installed and operate in accordance with all of the following:" .

    ibc:sem-ibc2021-ch10-list_item-0432 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0432 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0432-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0432 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The door locks shall unlock on actuation of the automatic sprinkler system or automatic smoke detection system." .

    ibc:sem-ibc2021-ch10-list_item-0433 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0433 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0433-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0433 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The door locks shall unlock on loss of power controlling the lock or lock mechanism." .

    ibc:sem-ibc2021-ch10-list_item-0434 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0434 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0434-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0434-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0434 ;
        ibco:statementType "obligation" ;
        ibco:text "3. The door locking system shall be installed to have the capability of being unlocked by a switch located at the fire command center, a nursing station or other approved location. The switch shall directly break power to the lock." .

    ibc:sem-ibc2021-ch10-list_item-0435 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0435 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0435-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0435 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. A building occupant shall not be required to pass through more than one door equipped with a controlled egress locking system before entering an exit." .

    ibc:sem-ibc2021-ch10-list_item-0436 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0436 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0436-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0436 ;
        ibco:statementType "obligation" ;
        ibco:text "5. The procedures for unlocking the doors shall be described and approved as part of the emergency planning and preparedness required by Chapter 4 of the International Fire Code." .

    ibc:sem-ibc2021-ch10-list_item-0437 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0437 ;
        ibco:appliesTo ibc:concept-all-clinical-staff ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0437-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0437 ;
        ibco:statementType "obligation" ;
        ibco:text "6. All clinical staff shall have the keys, codes or other means necessary to operate the locking systems." .

    ibc:sem-ibc2021-ch10-list_item-0438 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0438 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0438-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0438 ;
        ibco:statementType "obligation" ;
        ibco:text "7. Emergency lighting shall be provided at the door." .

    ibc:sem-ibc2021-ch10-list_item-0439 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0439 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0439-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0439 ;
        ibco:statementType "obligation" ;
        ibco:text "8. The door locking system units shall be listed in accordance with UL 294." .

    ibc:sem-ibc2021-ch10-list_item-0441 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0441 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0441-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0441 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Items 1 through 4 shall not apply to doors to areas occupied by persons who, because of clinical needs, require restraint or containment as part of the function of a psychiatric or cognitive treatment area." .

    ibc:sem-ibc2021-ch10-list_item-0442 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0442 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0442-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0442-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0442 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Items 1 through 4 shall not apply to doors to areas where a listed egress control system is utilized to reduce the risk of child abduction from nursery and obstetric areas of a Group I-2 hospital." .

    ibc:sem-ibc2021-ch10-list_item-0444 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0444 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0444 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Activation of an automatic sprinkler system installed in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0445 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0445 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0445 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Activation of an approved manual fire alarm box." .

    ibc:sem-ibc2021-ch10-list_item-0446 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0446 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0446 ;
        ibco:statementType "declarative" ;
        ibco:text "3. A signal from a constantly attended location." .

    ibc:sem-ibc2021-ch10-list_item-0449 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0449 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0449-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0449 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Revolving doors shall comply with BHMA A156.27 and shall be installed in accordance with the manufacturer’s instructions." .

    ibc:sem-ibc2021-ch10-list_item-0450 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0450 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0450-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0450-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0450 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Each revolving door shall be capable of breakout in accordance with BHMA A156.27 and shall provide an aggregate width of not less than 36 inches (914 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0451 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0451 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0451-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0451-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0451-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0451 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. A revolving door shall not be located within 10 feet (3048 mm) of the foot or top of stairways or escalators. A dispersal area shall be provided between the stairways or escalators and the revolving doors." .

    ibc:sem-ibc2021-ch10-list_item-0452 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0452 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0452-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0452-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0452-atomic-3 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0452 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. The revolutions per minute (rpm) for a revolving door shall not exceed the maximum rpm as specified in BHMA A156.27. Manual revolving doors shall comply with Table 1010.3.1(1). Automatic or power-operated revolving doors shall comply with Table 1010.3.1(2)." .

    ibc:sem-ibc2021-ch10-list_item-0453 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0453 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0453-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0453-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0453-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0453-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0453-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0453-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0453 ;
        ibco:statementType "obligation" ;
        ibco:text "5. An emergency stop switch shall be provided near each entry point of power or automatic operated revolving doors within 48 inches (1219 mm) of the door and between 34 inches (864 mm) and 48 inches (1219 mm) above the floor. The activation area of the emergency stop switch button shall be not less than 1 inch (25 mm) in diameter and shall be red." .

    ibc:sem-ibc2021-ch10-list_item-0454 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0454 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0454-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0454-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0454 ;
        ibco:statementType "obligation" ;
        ibco:text "6. Each revolving door shall have a side-hinged swinging door that complies with Section 1010.1 in the same wall and within 10 feet (3048 mm) of the revolving door." .

    ibc:sem-ibc2021-ch10-list_item-0455 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0455 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0455-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0455-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0455-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0455-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0455-measurement-4 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1009,
            ibc:ibc2021-1010.3.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0455 ;
        ibco:statementType "prohibition" ;
        ibco:text "7. Revolving doors shall not be part of an accessible route required by Section 1009 and Chapter 11. TABLE 1010.3.1(1) MAXIMUM DOOR SPEED MANUAL REVOLVING DOORS For SI: 1 inch = 25.4 mm, 1 foot = 304.8 mm. TABLE 1010.3.1(2) MAXIMUM DOOR SPEED AUTOMATIC OR POWER-OPERATED REVOLVING DOORS For SI: 1 inch = 25.4 mm, 1 foot = 304.8 mm." .

    ibc:sem-ibc2021-ch10-list_item-0457 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0457 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0457-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0457-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0457 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Revolving doors shall not be given credit for more than 50 percent of the minimum width or required capacity." .

    ibc:sem-ibc2021-ch10-list_item-0458 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0458 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-occupantload ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0458-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0458 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Each revolving door shall be credited with a capacity based on not more than a 50-person occupant load." .

    ibc:sem-ibc2021-ch10-list_item-0459 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0459 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0459-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0459 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Each revolving door shall provide for egress in accordance with BHMA A156.27 with a breakout force of not more than 130 pounds (578 N)." .

    ibc:sem-ibc2021-ch10-list_item-0462 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0462 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0462 ;
        ibco:statementType "declarative" ;
        ibco:text "1. There is a power failure or power is removed to the device holding the door wings in position." .

    ibc:sem-ibc2021-ch10-list_item-0463 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0463 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0463-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0463 ;
        ibco:statementType "declarative" ;
        ibco:text "2. There is an actuation of the automatic sprinkler system where such system is provided." .

    ibc:sem-ibc2021-ch10-list_item-0464 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0464 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0464-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0464 ;
        ibco:statementType "declarative" ;
        ibco:text "3. There is an actuation of a smoke detection system that is installed in accordance with Section 907 to provide coverage in areas within the building that are within 75 feet (22 860 mm) of the revolving doors." .

    ibc:sem-ibc2021-ch10-list_item-0465 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0465 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0465 ;
        ibco:statementType "declarative" ;
        ibco:text "4. There is an actuation of a manual control switch, in an approved location and clearly identified, that reduces the breakout force to not more than 130 pounds (578 N)." .

    ibc:sem-ibc2021-ch10-list_item-0468 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0468 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0468 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Occupancies in Group I-3." .

    ibc:sem-ibc2021-ch10-list_item-0469 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0469 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1010.3.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0469 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Special purpose horizontal sliding, accordion or folding doors complying with Section 1010.3.3." .

    ibc:sem-ibc2021-ch10-list_item-0470 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0470 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0470-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0470-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0470-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1010.1.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0470 ;
        ibco:statementType "obligation" ;
        ibco:text "3. For a biparting door in the emergency breakout mode, a door leaf located within a multiple-leaf opening shall be exempt from the minimum 32-inch (813 mm) single-leaf requirement of Section 1010.1.1, provided that a minimum 32inch (813 mm) clear opening is provided when the two biparting leaves meeting in the center are broken out." .

    ibc:sem-ibc2021-ch10-list_item-0472 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0472 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0472-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0472 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The doors shall be power operated and shall be capable of being operated manually in the event of power failure." .

    ibc:sem-ibc2021-ch10-list_item-0473 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0473 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0473-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0473 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The doors shall be openable by a simple method without special knowledge or effort from the egress side or sides." .

    ibc:sem-ibc2021-ch10-list_item-0474 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0474 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0474-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0474 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. The force required to operate the door shall not exceed 30 pounds (133 N) to set the door in motion and 15 pounds (67 N) to close the door or open it to the minimum required width." .

    ibc:sem-ibc2021-ch10-list_item-0475 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0475 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0475-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0475 ;
        ibco:statementType "obligation" ;
        ibco:text "4. The door shall be openable with a force not to exceed 15 pounds (67 N) when a force of 250 pounds (1100 N) is applied perpendicular to the door adjacent to the operating device." .

    ibc:sem-ibc2021-ch10-list_item-0476 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0476 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0476-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0476-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0476 ;
        ibco:statementType "obligation" ;
        ibco:text "5. The door assembly shall comply with the applicable fire protection rating and, where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716.2.6.6, shall be installed in accordance with NFPA 80 and shall comply with Section 716." .

    ibc:sem-ibc2021-ch10-list_item-0477 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0477 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0477-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0477 ;
        ibco:statementType "obligation" ;
        ibco:text "6. The door assembly shall have an integrated standby power supply." .

    ibc:sem-ibc2021-ch10-list_item-0478 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0478 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0478-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0478 ;
        ibco:statementType "obligation" ;
        ibco:text "7. The door assembly power supply shall be electrically supervised." .

    ibc:sem-ibc2021-ch10-list_item-0479 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0479 ;
        ibco:appliesTo ibc:concept-door ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0479-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0479 ;
        ibco:statementType "obligation" ;
        ibco:text "8. The door shall open to the minimum required width within 10 seconds after activation of the operating device." .

    ibc:sem-ibc2021-ch10-list_item-0486 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0486 ;
        ibco:appliesTo ibc:concept-each-device ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0486-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0486 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Each device shall turn free in the direction of egress travel when primary power is lost and on the manual release by an employee in the area." .

    ibc:sem-ibc2021-ch10-list_item-0487 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0487 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0487-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0487 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Such devices are not given credit for more than 50 percent of the required egress capacity or width." .

    ibc:sem-ibc2021-ch10-list_item-0488 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0488 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0488-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0488-measurement-2 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0488 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Each device is not more than 39 inches (991 mm) high. Each device has not less than 161/2 inches (419" .

    ibc:sem-ibc2021-ch10-list_item-0489 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0489 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0489-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0489-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0489-measurement-3 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0489 ;
        ibco:statementType "declarative" ;
        ibco:text "4. mm) clear width at and below a height of 39 inches (991 mm) and not less than 22 inches (559 mm) clear width at heights above 39 inches (991 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0492 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0492 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0492 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The building is protected throughout by an approved, supervised automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0493 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0493 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0493-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0493 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Each security access turnstile lane configuration has a minimum clear passage width of 22 inches (559 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0494 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0494 ;
        ibco:appliesTo ibc:concept-any-security-access-turnstile-lane-configuration-providing-a-clear-passage-width-of-less-than-32-inches-810-mm ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0494-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0494-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0494 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Any security access turnstile lane configuration providing a clear passage width of less than 32 inches (810 mm) shall be credited with a maximum egress capacity of 50 persons." .

    ibc:sem-ibc2021-ch10-list_item-0495 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0495 ;
        ibco:appliesTo ibc:concept-any-security-access-turnstile-lane-configuration-providing-a-clear-passage-width-of-32-inches-810-mm-or-more ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0495-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0495-measurement-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1005 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0495 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Any security access turnstile lane configuration providing a clear passage width of 32 inches (810 mm) or more shall be credited with a maximum egress capacity as calculated in accordance with Section 1005." .

    ibc:sem-ibc2021-ch10-list_item-0496 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0496 ;
        ibco:appliesTo ibc:concept-each-secured-physical-barrier ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0496-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0496 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Each secured physical barrier shall automatically retract or swing to an unobstructed open position in the direction of egress, under each of the following conditions:" .

    ibc:sem-ibc2021-ch10-list_item-0497 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0497 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0497 ;
        ibco:statementType "declarative" ;
        ibco:text "5.1. Upon loss of power to the turnstile or any part of the access control system that secures the physical barrier." .

    ibc:sem-ibc2021-ch10-list_item-0498 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0498 ;
        ibco:appliesTo ibc:concept-upon-actuation-of-a-clearly-identified-manual-release-device-with-ready-access-that-results-in-direct-interruption-of-power-to-each-secured-physical-barrier-after-which-such-barriers-remain-in-the-open-position-for-not-less-than-30-seconds-the-manual-release-device ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0498-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0498 ;
        ibco:statementType "obligation" ;
        ibco:text "5.2. Upon actuation of a clearly identified manual release device with ready access that results in direct interruption of power to each secured physical barrier, after which such barriers remain in the open position for not less than 30 seconds. The manual release device shall be positioned at one of the following locations:" .

    ibc:sem-ibc2021-ch10-list_item-0499 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0499 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0499 ;
        ibco:statementType "declarative" ;
        ibco:text "5.2.1. On the egress side of each security access turnstile lane." .

    ibc:sem-ibc2021-ch10-list_item-0500 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0500 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0500-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0500 ;
        ibco:statementType "declarative" ;
        ibco:text "5.2.2. At an approved location where it can be actuated by an employee assigned to the area at all times that the building is occupied." .

    ibc:sem-ibc2021-ch10-list_item-0501 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0501 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0501-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0501 ;
        ibco:statementType "declarative" ;
        ibco:text "5.3. Upon actuation of the building fire alarm system, if provided, after which the physical barrier remains in the open position until the fire alarm system is manually reset." .

    ibc:sem-ibc2021-ch10-list_item-0503 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0503 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0503 ;
        ibco:statementType "declarative" ;
        ibco:text "5.4. Upon actuation of the building automatic sprinkler system or fire detection system, after which the physical barrier remains in the open position until the fire alarm system is manually reset." .

    ibc:sem-ibc2021-ch10-list_item-0512 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0512 ;
        ibco:appliesTo ibc:concept-occupantload,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0512-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0512-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0512 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Stairways serving an occupant load of less than 50 shall have a width of not less than 36 inches (914 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0513 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0513 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.10 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0513 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Spiral stairways as provided for in Section 1011.10." .

    ibc:sem-ibc2021-ch10-list_item-0514 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0514 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0514-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0514-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0514-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0514-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0514-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0514 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Where an incline platform lift or stairway chairlift is installed on stairways serving occupancies in Group R-3, or within dwelling units in occupancies in Group R-2, a clear passage width not less than 20 inches (508 mm) shall be provided. Where the seat and platform can be folded when not in use, the distance shall be measured from the folded position." .

    ibc:sem-ibc2021-ch10-list_item-0517 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0517 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0517-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1011.10 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0517 ;
        ibco:statementType "permission" ;
        ibco:text "1. Spiral stairways complying with Section 1011.10 are permitted a 78-inch (1981 mm) headroom clearance." .

    ibc:sem-ibc2021-ch10-list_item-0518 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0518 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0518-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0518-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0518-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0518 ;
        ibco:statementType "obligation" ;
        ibco:text "2. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R-3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; where the nosings of treads at the side of a flight extend under the edge of a floor opening through which the stair passes, the floor opening shall be allowed to project horizontally into the required headroom not more than 43/4 inches (121 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0524 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0524 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.10 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0524 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Spiral stairways in accordance with Section 1011.10." .

    ibc:sem-ibc2021-ch10-list_item-0525 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0525 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0525-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0525 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to use the riser/tread dimension in Section 1030.14.2." .

    ibc:sem-ibc2021-ch10-list_item-0526 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0526 ;
        ibco:appliesTo ibc:concept-dwellingunit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0526-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0526-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0526-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0526-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-4,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-5,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-6,
            ibc:sem-ibc2021-ch10-list_item-0526-measurement-7 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0526 ;
        ibco:statementType "obligation" ;
        ibco:text "3. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R- 3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; the maximum riser height shall be 73/4 inches (197 mm); the minimum tread depth shall be 10 inches (254 mm); the minimum winder tread depth at the walkline shall be 10 inches (254 mm); and the minimum winder tread depth shall be 6 inches (152 mm). A nosing projection not less than 3/4 inch (19.1 mm) but not more than 11/4 inches (32 mm) shall be provided on stairways with solid risers where the tread depth is less than 11 inches (279 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0527 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0527 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0527 ;
        ibco:statementType "declarative" ;
        ibco:text "4. See Section 503.1 of the International Existing Building Code for the replacement of existing stairways." .

    ibc:sem-ibc2021-ch10-list_item-0528 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0528 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-guard,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0528-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0528-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0528-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0528-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0528 ;
        ibco:statementType "obligation" ;
        ibco:text "5. In Group I-3 facilities, stairways providing access to guard towers, observation stations and control rooms, not more than 250 square feet (23 m2) in area, shall be permitted to have a maximum riser height of 8 inches (203 mm) and a minimum tread depth of 9 inches (229 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0531 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0531 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0531 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Curved stairways in accordance with Section 1011.9." .

    ibc:sem-ibc2021-ch10-list_item-0532 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0532 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.10 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0532 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Spiral stairways in accordance with Section 1011.10." .

    ibc:sem-ibc2021-ch10-list_item-0535 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0535 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0535-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.14.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0535 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to comply with the dimensional nonuniformity in Section 1030.14.2." .

    ibc:sem-ibc2021-ch10-list_item-0536 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0536 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0536 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Consistently shaped winders, complying with Section 1011.5, differing from rectangular treads in the same flight of stairs." .

    ibc:sem-ibc2021-ch10-list_item-0537 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0537 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1011.5.4.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0537 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Nonuniform riser dimension complying with Section 1011.5.4.1." .

    ibc:sem-ibc2021-ch10-list_item-0541 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0541 ;
        ibco:appliesTo ibc:concept-of-treads ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0541-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0541-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0541 ;
        ibco:statementType "obligation" ;
        ibco:text "(nosings) of treads shall project not more than 11/4 inches (32 mm) beyond the tread below." .

    ibc:sem-ibc2021-ch10-list_item-0545 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0545 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0545-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0545-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0545-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1009.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0545 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Solid risers are not required for stairways that are not required to comply with Section 1009.3, provided that the opening between treads does not permit the passage of a sphere with a diameter of 4 inches (102 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0546 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0546 ;
        ibco:appliesTo ibc:concept-solid-risers ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0546-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0546-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0546 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Solid risers are not required for occupancies in Group I-3 or in Group F, H and S occupancies other than areas accessible to the public. The size of the opening in the riser is not restricted." .

    ibc:sem-ibc2021-ch10-list_item-0547 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0547 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0547-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1011.10 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0547 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Solid risers are not required for spiral stairways constructed in accordance with Section 1011.10." .

    ibc:sem-ibc2021-ch10-list_item-0550 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0550 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0550-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0550-condition-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1030 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0550 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0551 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0551 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0551-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0551-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0551 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Where curved stairways of constant radius have intermediate landings, the landing depth shall be measured horizontally between the intersection of the walkline of the lower flight at the landing nosing and the intersection of the walkline of the upper flight at the nosing of the lowest tread of the upper flight." .

    ibc:sem-ibc2021-ch10-list_item-0552 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0552 ;
        ibco:appliesTo ibc:concept-where-a-landing-turns-90-degrees-1-57-rad-or-more-the-minimum-landing-depth-in-accordance-with-this-section ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0552-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0552-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0552-condition-2 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0552 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Where a landing turns 90 degrees (1.57 rad) or more, the minimum landing depth in accordance with this section shall not be required where the landing provided is not less than that described by an arc with a radius equal to the width of the flight served." .

    ibc:sem-ibc2021-ch10-list_item-0555 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0555 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0555-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0555 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Wood handrails shall be permitted in all types of construction." .

    ibc:sem-ibc2021-ch10-list_item-0556 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0556 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0556 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Interior exit stairways in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0557 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0557 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0557 ;
        ibco:statementType "declarative" ;
        ibco:text "510.2." .

    ibc:sem-ibc2021-ch10-list_item-0560 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0560 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0560-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0560-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0560-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0560 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Openings in stair walking surfaces shall be a size that does not permit the passage of 1/2inch-diameter (12.7 mm) sphere. Elongated openings shall be placed so that the long dimension is perpendicular to the direction of travel." .

    ibc:sem-ibc2021-ch10-list_item-0561 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0561 ;
        ibco:appliesTo ibc:concept-in-group-f-h-and-s-occupancies-other-than-areas-of-parking-structures-accessible-to-the-public-openings-in-treads-and-landings ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0561-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0561-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0561-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0561-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0561 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In Group F, H and S occupancies, other than areas of parking structures accessible to the public, openings in treads and landings shall not be prohibited provided that a sphere with a diameter of 11/8 inches (29 mm) cannot pass through the opening." .

    ibc:sem-ibc2021-ch10-list_item-0571 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0571 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0571-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0571-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0571-atomic-3 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0571-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0571-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0571-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0571-measurement-4 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "fuzzy",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0571 ;
        ibco:statementType "obligation" ;
        ibco:text "410.5. A spiral stairway shall have a 63/4-inch (171 mm) minimum clear tread depth at a point 12 inches (305 mm) from the narrow edge. The risers shall be sufficient to provide a headroom of 78 inches (1981 mm) minimum, but riser height shall not be more than 91/2 inches (241 mm). The minimum stairway clear width at and below the handrail shall be 26 inches (660 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0574 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0574 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0574-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0574 ;
        ibco:statementType "permission" ;
        ibco:text "1. Flights of stairways within dwelling units and flights of spiral stairways are permitted to have a handrail on one side only." .

    ibc:sem-ibc2021-ch10-list_item-0575 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0575 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0575-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0575-condition-1 ;
        ibco:modality "required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0575 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Decks, patios and walkways that have a single change in elevation where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails." .

    ibc:sem-ibc2021-ch10-list_item-0576 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0576 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0576 ;
        ibco:statementType "declarative" ;
        ibco:text "3. In Group R-3 occupancies, a change in elevation consisting of a single riser at an entrance or egress door does not require handrails." .

    ibc:sem-ibc2021-ch10-list_item-0577 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0577 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0577 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Changes in room elevations of three or fewer risers within dwelling units and sleeping units in Groups R-2 and R-3 do not require handrails." .

    ibc:sem-ibc2021-ch10-list_item-0578 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0578 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0578-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0578-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0578-condition-2 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0578 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. Where a platform lift is in a stationary position and the floor of the platform lift serves as the upper landing of a stairway, handrails shall not be required on the stairway, provided that all of the following criteria are met:" .

    ibc:sem-ibc2021-ch10-list_item-0579 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0579 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0579 ;
        ibco:statementType "declarative" ;
        ibco:text "5.1. The stairway contains not more than two risers." .

    ibc:sem-ibc2021-ch10-list_item-0580 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0580 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0580 ;
        ibco:statementType "declarative" ;
        ibco:text "5.2. A handhold, positioned horizontally or vertically, is located on one side of the stairway adjacent to the top landing." .

    ibc:sem-ibc2021-ch10-list_item-0581 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0581 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0581-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0581-measurement-2 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0581 ;
        ibco:statementType "declarative" ;
        ibco:text "5.3. The handhold is located not less than 34 inches (864 mm) and not more than 42 inches (1067 mm) above the bottom landing of the stairway." .

    ibc:sem-ibc2021-ch10-list_item-0582 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0582 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0582-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1014.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0582 ;
        ibco:statementType "declarative" ;
        ibco:text "5.4. The handhold gripping surface complies with Section 1014.3, and is not less than 4.5 inches (114 mm) in length." .

    ibc:sem-ibc2021-ch10-list_item-0597 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0597 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0597 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Spaces frequented only by personnel for maintenance, repair or monitoring of equipment." .

    ibc:sem-ibc2021-ch10-list_item-0598 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0598 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0598 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Nonoccupiable spaces accessed only by catwalks, crawl spaces, freight elevators or very narrow passageways." .

    ibc:sem-ibc2021-ch10-list_item-0599 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0599 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0599 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands." .

    ibc:sem-ibc2021-ch10-list_item-0600 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0600 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0600 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Elevated levels in Group U not open to the general public." .

    ibc:sem-ibc2021-ch10-list_item-0601 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0601 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0601-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1011.12.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0601 ;
        ibco:statementType "exemption" ;
        ibco:text "5. Nonoccupied roofs that are not required to have stairway access in accordance with Section 1011.12.1." .

    ibc:sem-ibc2021-ch10-list_item-0602 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0602 ;
        ibco:appliesTo ibc:concept-where ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0602-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0602-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0602 ;
        ibco:statementType "permission" ;
        ibco:text "6. Where permitted to access equipment and appliances in accordance with Section 306.5 of the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-list_item-0606 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0606 ;
        ibco:appliesTo ibc:concept-ramped-aisles-within-assembly-rooms-or-spaces ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0606-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0606 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Ramped aisles within assembly rooms or spaces shall comply with the provisions in Section 1030." .

    ibc:sem-ibc2021-ch10-list_item-0607 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0607 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0607-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0607 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Curb ramps shall comply with ICC A117.1." .

    ibc:sem-ibc2021-ch10-list_item-0608 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0608 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-meansofegress,
            ibc:concept-parkingspace,
            ibc:concept-ramp ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0608-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0608-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1012.10,
            ibc:ibc2021-1012.3 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0608 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Vehicle ramps in parking garages for pedestrian exit access shall not be required to comply with Sections 1012.3 through 1012.10 where they are not an accessible route serving accessible parking spaces, other required accessible elements or part of an accessible means of egress." .

    ibc:sem-ibc2021-ch10-list_item-0621 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0621 ;
        ibco:appliesTo ibc:concept-accessibleunit,
            ibc:concept-sleepingunit,
            ibc:concept-typeaunit,
            ibc:concept-typebunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0621-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0621-measurement-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1108 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0621 ;
        ibco:statementType "exemption" ;
        ibco:text "1. In Group R-2 and R-3 individual dwelling and sleeping units that are not required to be Accessible units, Type A units or Type B units in accordance with Section 1108, landings are permitted to be 36 inches (914 mm) minimum." .

    ibc:sem-ibc2021-ch10-list_item-0622 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0622 ;
        ibco:appliesTo ibc:concept-accessibleroute,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0622-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0622-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0622-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0622 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Where the ramp is not a part of an accessible route, the length of the landing shall not be required to be more than 48 inches (1219 mm) in the direction of travel." .

    ibc:sem-ibc2021-ch10-list_item-0633 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0633 ;
        ibco:appliesTo ibc:concept-handrail,
            ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0633-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0633 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Edge protection is not required on ramps that are not required to have handrails, provided they have flared sides that comply with the ICC A117.1 curb ramp provisions." .

    ibc:sem-ibc2021-ch10-list_item-0634 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0634 ;
        ibco:appliesTo ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0634-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0634 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Edge protection is not required on the sides of ramp landings serving an adjoining ramp run or stairway." .

    ibc:sem-ibc2021-ch10-list_item-0635 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0635 ;
        ibco:appliesTo ibc:concept-ramp ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0635-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0635-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0635-measurement-2 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0635 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Edge protection is not required on the sides of ramp landings having a vertical dropoff of not more than 1/2 inch (12.7 mm) within 10 inches (254 mm) horizontally of the required landing area." .

    ibc:sem-ibc2021-ch10-list_item-0641 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0641 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0641-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0641 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Exit signs are not required in rooms or areas that require only one exit or exit access." .

    ibc:sem-ibc2021-ch10-list_item-0642 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0642 ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0642-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0642-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0642 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Main exterior exit doors or gates that are obviously and clearly identifiable as exits need not have exit signs where approved by the building official." .

    ibc:sem-ibc2021-ch10-list_item-0643 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0643 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-exit,
            ibc:concept-signage,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0643-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0643 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Exit signs are not required in occupancies in Group U and individual sleeping units or dwelling units in Group R-1, R-2 or R-3." .

    ibc:sem-ibc2021-ch10-list_item-0644 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0644 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0644-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0644 ;
        ibco:statementType "exemption" ;
        ibco:text "4. Exit signs are not required in dayrooms, sleeping rooms or dormitories in occupancies in Group I-3." .

    ibc:sem-ibc2021-ch10-list_item-0645 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0645 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0645-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0645-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0645 ;
        ibco:statementType "exemption" ;
        ibco:text "5. In occupancies in Groups A-4 and A-5, exit signs are not required on the seating side of vomitories or openings into seating areas where exit signs are provided in the concourse that are readily apparent from the vomitories. Egress lighting is provided to identify each vomitory or opening within the seating area in an emergency." .

    ibc:sem-ibc2021-ch10-list_item-0660 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0660 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0660-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0660-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0660 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Where handrail fittings or bendings are used to provide continuous transition between flights, the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0661 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0661 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0661-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0661-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0661-condition-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0661 ;
        ibco:statementType "obligation" ;
        ibco:text "2. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are associated with a Group R-3 occupancy or associated with individual dwelling units in Group R-2 occupancies; where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height." .

    ibc:sem-ibc2021-ch10-list_item-0662 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0662 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0662-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0662-condition-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1030.16 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0662 ;
        ibco:statementType "permission" ;
        ibco:text "3. Handrails on top of a guard where permitted along stepped aisles and ramped aisles in accordance with Section 1030.16." .

    ibc:sem-ibc2021-ch10-list_item-0669 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0669 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0669-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0669 ;
        ibco:statementType "permission" ;
        ibco:text "1. Handrails within dwelling units are permitted to be interrupted by a newel post at a turn or landing." .

    ibc:sem-ibc2021-ch10-list_item-0670 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0670 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0670 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Within a dwelling unit, the use of a volute, turnout, starting easing or starting newel is allowed over the lowest tread." .

    ibc:sem-ibc2021-ch10-list_item-0671 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0671 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0671-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0671-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0671-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0671-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0671-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0671-measurement-4,
            ibc:sem-ibc2021-ch10-list_item-0671-measurement-5 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0671 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Handrail brackets or balusters attached to the bottom surface of the handrail that do not project horizontally beyond the sides of the handrail within 11/2 inches (38 mm) of the bottom of the handrail shall not be considered obstructions. For each 1/2 inch (12.7 mm) of additional handrail perimeter dimension above 4 inches (102 mm), the vertical clearance dimension of 11/2 inches (38 mm) shall be permitted to be reduced by 1/8 inch (3.2 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0672 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0672 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0672-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0672-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0672-condition-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0672 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards." .

    ibc:sem-ibc2021-ch10-list_item-0673 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0673 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0673-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1030.16.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0673 ;
        ibco:statementType "permission" ;
        ibco:text "5. Handrails serving stepped aisles or ramped aisles are permitted to be discontinuous in accordance with Section 1030.16.1." .

    ibc:sem-ibc2021-ch10-list_item-0677 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0677 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0677-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0677 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Handrails within a dwelling unit that is not required to be accessible need extend only from the top riser to the bottom riser." .

    ibc:sem-ibc2021-ch10-list_item-0678 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0678 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0678-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1030.16 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0678 ;
        ibco:statementType "permission" ;
        ibco:text "2. Handrails serving aisles in rooms or spaces used for assembly purposes are permitted to comply with the handrail extensions in accordance with Section 1030.16." .

    ibc:sem-ibc2021-ch10-list_item-0679 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0679 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0679-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0679-atomic-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0679 ;
        ibco:statementType "permission" ;
        ibco:text "3. Handrails for alternating tread devices and ships ladders are permitted to terminate at a location vertically above the top and bottom risers. Handrails for alternating tread devices are not required to be continuous between flights or to extend beyond the top or bottom risers." .

    ibc:sem-ibc2021-ch10-list_item-0687 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0687 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0687 ;
        ibco:statementType "declarative" ;
        ibco:text "1. On the loading side of loading docks or piers." .

    ibc:sem-ibc2021-ch10-list_item-0688 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0688 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0688 ;
        ibco:statementType "declarative" ;
        ibco:text "2. On the audience side of stages and raised platforms, including stairs leading up to the stage and raised platforms." .

    ibc:sem-ibc2021-ch10-list_item-0689 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0689 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0689 ;
        ibco:statementType "declarative" ;
        ibco:text "3. On raised stage and platform floor areas, such as runways, ramps and side stages used for entertainment or presentations." .

    ibc:sem-ibc2021-ch10-list_item-0690 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0690 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0690 ;
        ibco:statementType "declarative" ;
        ibco:text "4. At vertical openings in the performance area of stages and platforms." .

    ibc:sem-ibc2021-ch10-list_item-0691 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0691 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0691 ;
        ibco:statementType "declarative" ;
        ibco:text "5. At elevated walking surfaces appurtenant to stages and platforms for access to and utilization of special lighting or equipment." .

    ibc:sem-ibc2021-ch10-list_item-0692 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0692 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0692 ;
        ibco:statementType "declarative" ;
        ibco:text "6. Along vehicle service pits not accessible to the public." .

    ibc:sem-ibc2021-ch10-list_item-0693 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0693 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1030.17.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0693 ;
        ibco:statementType "declarative" ;
        ibco:text "7. In assembly seating areas at cross aisles in accordance with Section 1030.17.2." .

    ibc:sem-ibc2021-ch10-list_item-0694 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0694 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0694 ;
        ibco:statementType "declarative" ;
        ibco:text "8. On the loading side of station platforms on fixed guideway transit or passenger rail systems." .

    ibc:sem-ibc2021-ch10-list_item-0697 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0697 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0697 ;
        ibco:statementType "declarative" ;
        ibco:text "1. From the adjacent walking surfaces." .

    ibc:sem-ibc2021-ch10-list_item-0698 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0698 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0698 ;
        ibco:statementType "declarative" ;
        ibco:text "2. On stairways and stepped aisles, from the line connecting the leading edges of the tread nosings." .

    ibc:sem-ibc2021-ch10-list_item-0699 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0699 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0699 ;
        ibco:statementType "declarative" ;
        ibco:text "3. On ramps and ramped aisles, from the ramp surface at the guard." .

    ibc:sem-ibc2021-ch10-list_item-0701 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0701 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-guard,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0701-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0701-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0701 ;
        ibco:statementType "obligation" ;
        ibco:text "1. For occupancies in Group R-3 not more than three stories above grade in height and within individual dwelling units in occupancies in Group R-2 not more than three stories above grade in height with separate means of egress, required guards shall be not less than 36 inches (914 mm) in height measured vertically above the adjacent walking surfaces." .

    ibc:sem-ibc2021-ch10-list_item-0702 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0702 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-guard,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0702-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0702-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0702 ;
        ibco:statementType "obligation" ;
        ibco:text "2. For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, guards on the open sides of stairs shall have a height not less than 34 inches (864 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0703 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0703 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-guard,
            ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0703-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0703-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0703-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0703-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0703 ;
        ibco:statementType "obligation" ;
        ibco:text "3. For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, where the top of the guard serves as a handrail on the open sides of stairs, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0704 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0704 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0704-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.17 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0704 ;
        ibco:statementType "obligation" ;
        ibco:text "4. The guard height in assembly seating areas shall comply with Section 1030.17 as applicable." .

    ibc:sem-ibc2021-ch10-list_item-0705 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0705 ;
        ibco:appliesTo ibc:concept-guard,
            ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0705-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0705-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0705-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0705-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0705 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Along alternating tread devices and ships ladders, guards where the top rail serves as a handrail shall have height not less than 30 inches (762 mm) and not more than 34 inches (864 mm), measured vertically from the leading edge of the device tread nosing." .

    ibc:sem-ibc2021-ch10-list_item-0706 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0706 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-guard,
            ibc:concept-handrail,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0706-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0706-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0706-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0706-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0706-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0706 ;
        ibco:statementType "obligation" ;
        ibco:text "6. In Group F occupancies where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads." .

    ibc:sem-ibc2021-ch10-list_item-0709 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0709 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0709-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0709-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0709-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0709-measurement-3 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0709 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. From a height of 36 inches (914 mm) to 42 inches (1067 mm), guards shall not have openings that allow passage of a sphere 43/8 inches (111 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0710 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0710 ;
        ibco:appliesTo ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0710-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0710-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0710 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. The triangular openings at the open sides of a stair, formed by the riser, tread and bottom rail shall not allow passage of a sphere 6 inches (152 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0711 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0711 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0711-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0711-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0711 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. At elevated walking surfaces for access to and use of electrical, mechanical or plumbing systems or equipment, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0712 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0712 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0712-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0712-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0712 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. In areas that are not open to the public within occupancies in Group I-3, F, H or S, and for alternating tread devices and ships ladders, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0713 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0713 ;
        ibco:appliesTo ibc:concept-guard ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0713-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0713-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0713-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0713-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0713-measurement-3,
            ibc:sem-ibc2021-ch10-list_item-0713-measurement-4,
            ibc:sem-ibc2021-ch10-list_item-0713-measurement-5 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1030.17.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0713 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. In assembly seating areas, guards required at the end of aisles in accordance with Section 1030.17.4 shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter up to a height of 26 inches (660 mm). From a height of 26 inches (660 mm) to 42 inches (1067 mm) above the adjacent walking surfaces, guards shall not have openings that allow passage of a sphere 8 inches (203 mm) in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0714 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0714 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-guard,
            ibc:concept-sleepingunit,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0714-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0714 ;
        ibco:statementType "prohibition" ;
        ibco:text "6. Within individual dwelling units and sleeping units in Group R-2 and R-3 occupancies, guards on the open sides of stairs shall not have openings that allow passage of a sphere 43/8 (111 mm) inches in diameter." .

    ibc:sem-ibc2021-ch10-list_item-0721 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0721 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0721-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0721-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0721 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Operable windows where the top of the sill of the opening is located more than 75 feet (22 860 mm) above the finished grade or other surface below and that are provided with window fall prevention devices that comply with ASTM F2006." .

    ibc:sem-ibc2021-ch10-list_item-0722 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0722 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0722-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0722 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Operable windows where the openings will not allow a 4-inch-diameter (102 mm) sphere to pass through the opening when the window is in its largest opened position." .

    ibc:sem-ibc2021-ch10-list_item-0723 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0723 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0723-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0723 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Operable windows where the openings are provided with window fall prevention devices that comply with ASTM F2090." .

    ibc:sem-ibc2021-ch10-list_item-0724 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0724 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1015.8.1 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0724 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Operable windows that are provided with window opening control devices that comply with Section 1015.8.1." .

    ibc:sem-ibc2021-ch10-list_item-0729 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0729 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.73 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0729-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0729-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0729-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0729-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0729-condition-2,
            ibc:sem-ibc2021-ch10-list_item-0729-condition-3 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1006.2.1,
            ibc:ibc2021-3006 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0729 ;
        ibco:statementType "permission" ;
        ibco:text "1. Exit access through an enclosed elevator lobby is permitted. Where access to two or more exits or exit access doorways is required in Section 1006.2.1, access to not less than one of the required exits shall be provided without travel through the enclosed elevator lobbies required by Section 3006. Where the path of exit access travel passes through an enclosed elevator lobby, the level of protection required for the enclosed elevator lobby is not required to be extended to the exit unless direct access to an exit is required by other sections of this code." .

    ibc:sem-ibc2021-ch10-list_item-0730 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0730 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0730-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0730-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0730 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Egress from a room or space shall not pass through adjoining or intervening rooms or areas, except where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit." .

    ibc:sem-ibc2021-ch10-list_item-0732 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0732 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0732-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0732 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. An exit access shall not pass through a room that can be locked to prevent egress." .

    ibc:sem-ibc2021-ch10-list_item-0733 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0733 ;
        ibco:appliesTo ibc:concept-dwellingunit,
            ibc:concept-meansofegress,
            ibc:concept-toiletroom ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0733-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0733 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. Means of egress from dwelling units or sleeping areas shall not lead through other sleeping areas, toilet rooms or bathrooms." .

    ibc:sem-ibc2021-ch10-list_item-0734 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0734 ;
        ibco:appliesTo ibc:concept-egress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0734-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0734 ;
        ibco:statementType "prohibition" ;
        ibco:text "5. Egress shall not pass through kitchens, storage rooms, closets or spaces used for similar purposes." .

    ibc:sem-ibc2021-ch10-list_item-0736 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0736 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0736 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Means of egress are not prohibited through a kitchen area serving adjoining rooms constituting part of the same dwelling unit or sleeping unit." .

    ibc:sem-ibc2021-ch10-list_item-0737 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0737 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0737-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0737 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Means of egress are not prohibited through stockrooms in Group M occupancies where all of the following are met:" .

    ibc:sem-ibc2021-ch10-list_item-0738 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0738 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0738 ;
        ibco:statementType "declarative" ;
        ibco:text "2.1. The stock is of the same hazard classification as that found in the main retail area." .

    ibc:sem-ibc2021-ch10-list_item-0739 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0739 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0739-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0739 ;
        ibco:statementType "declarative" ;
        ibco:text "2.2. Not more than 50 percent of the exit access is through the stockroom." .

    ibc:sem-ibc2021-ch10-list_item-0740 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0740 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0740 ;
        ibco:statementType "declarative" ;
        ibco:text "2.3. The stockroom is not subject to locking from the egress side." .

    ibc:sem-ibc2021-ch10-list_item-0741 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0741 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0741 ;
        ibco:statementType "declarative" ;
        ibco:text "2.4. There is a demarcated, minimum 44-inch-wide (1118 mm) aisle defined by full- or partial-height fixed walls or similar construction that will maintain the required width and lead directly from the retail area to the exit without obstructions." .

    ibc:sem-ibc2021-ch10-list_item-0747 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0747 ;
        ibco:confidence 0.73 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1006.2.2.2,
            ibc:ibc2021-1006.2.2.3,
            ibc:ibc2021-1006.3.4,
            ibc:ibc2021-1017.2.2,
            ibc:ibc2021-1030.7,
            ibc:ibc2021-3103.4,
            ibc:ibc2021-3104.9 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0747 ;
        ibco:statementType "declarative" ;
        ibco:text "a. See the following sections for modifications to exit access travel distance requirements: Section 402.8: For the distance limitation in malls. Section 407.4: For the distance limitation in Group I-2. Sections 408.6.1 and 408.8.1: For the distance limitations in Group I-3. Section 411.2: For the distance limitation in special amusement areas. Section 412.6: For the distance limitations in aircraft manufacturing facilities. Section 1006.2.2.2: For the distance limitation in refrigeration machinery rooms. Section 1006.2.2.3: For the distance limitation in refrigerated rooms and spaces. Section 1006.3.4: For buildings with one exit. Section 1017.2.2: For increased distance limitation in Groups F-1 and S-1. Section 1030.7: For increased limitation in assembly seating. Section 3103.4: For temporary structures. Section 3104.9: For pedestrian walkways." .

    ibc:sem-ibc2021-ch10-list_item-0748 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0748 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0748-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0748-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0748 ;
        ibco:statementType "permission" ;
        ibco:text "b. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2. See Section 903 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0749 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0749 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0749 ;
        ibco:statementType "declarative" ;
        ibco:text "c. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0750 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0750 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0750 ;
        ibco:statementType "declarative" ;
        ibco:text "d. Group H occupancies equipped throughout with an automatic sprinkler system in accordance with Section 903.2.5.1." .

    ibc:sem-ibc2021-ch10-list_item-0751 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0751 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0751-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0751-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0751 ;
        ibco:statementType "permission" ;
        ibco:text "e. Group R-3 and R-4 buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3. See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:sem-ibc2021-ch10-list_item-0754 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0754 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0754 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The portion of the building classified as Group F- 1 or S-1 is limited to one story in height." .

    ibc:sem-ibc2021-ch10-list_item-0755 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0755 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0755-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0755 ;
        ibco:statementType "declarative" ;
        ibco:text "2. The minimum height from the finished floor to the bottom of the ceiling or roof slab or deck is 24 feet (7315 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0756 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0756 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0756 ;
        ibco:statementType "declarative" ;
        ibco:text "3. The building is equipped throughout with an automatic sprinkler system in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0757 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0757 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0757 ;
        ibco:statementType "declarative" ;
        ibco:text "903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-0760 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0760 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0760-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0760 ;
        ibco:statementType "permission" ;
        ibco:text "1. In open parking garages, exit access travel distance is permitted to be measured to the closest riser of an exit access stairway or the closest slope of an exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-0761 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0761 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0761-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1030.7 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0761 ;
        ibco:statementType "obligation" ;
        ibco:text "2. In smoke protected seating and open air assembly seating, exit access travel distance shall be measured in accordance with Section 1030.7." .

    ibc:sem-ibc2021-ch10-list_item-0782 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0782 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0782-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0782 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Exit access stairways and ramps that serve or atmospherically communicate between only two adjacent stories. Such interconnected stories shall not be open to other stories." .

    ibc:sem-ibc2021-ch10-list_item-0783 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0783 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0783 ;
        ibco:statementType "declarative" ;
        ibco:text "2. In Group R-1, R-2 or R-3 occupancies, exit access stairways and ramps connecting four stories or less serving and contained within an individual dwelling unit or sleeping unit or live/work unit." .

    ibc:sem-ibc2021-ch10-list_item-0784 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0784 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0784-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0784 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility are not required to be enclosed." .

    ibc:sem-ibc2021-ch10-list_item-0785 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0785 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0785-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0785-condition-2 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0785 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Exit access stairways and ramps in buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, where the area of the vertical opening between stories does not exceed twice the horizontal projected area of the stairway or ramp and the opening is protected by a draft curtain and closely spaced sprinklers in accordance with NFPA 13. In other than Group B and M occupancies, this provision is limited to openings that do not connect more than four stories." .

    ibc:sem-ibc2021-ch10-list_item-0786 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0786 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0786 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Exit access stairways and ramps within an atrium complying with the provisions of Section 404." .

    ibc:sem-ibc2021-ch10-list_item-0787 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0787 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0787 ;
        ibco:statementType "declarative" ;
        ibco:text "6. Exit access stairways and ramps in open parking garages that serve only the parking garage." .

    ibc:sem-ibc2021-ch10-list_item-0788 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0788 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1030.7 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0788 ;
        ibco:statementType "declarative" ;
        ibco:text "7. Exit access stairways and ramps serving smokeprotected or open-air assembly seating complying with the exit access travel distance requirements of Section 1030.7." .

    ibc:sem-ibc2021-ch10-list_item-0789 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0789 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0789 ;
        ibco:statementType "declarative" ;
        ibco:text "8. Exit access stairways and ramps between the balcony, gallery or press box and the main assembly floor in occupancies such as theaters, places of religious worship, auditoriums and sports facilities." .

    ibc:sem-ibc2021-ch10-list_item-0790 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0790 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0790 ;
        ibco:statementType "declarative" ;
        ibco:text "9. Exterior exit access stairways or ramps between occupied roofs." .

    ibc:sem-ibc2021-ch10-list_item-0797 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0797 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-door,
            ibc:concept-meansofegress ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0797-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0797-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0797-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0797 ;
        ibco:statementType "exemption" ;
        ibco:text "1. A fire-resistance rating is not required for corridors in an occupancy in Group E where each room that is used for instruction has not less than one door opening directly to the exterior and rooms for assembly purposes have not less than one-half of the required means of egress doors opening directly to the exterior. Exterior doors specified in this exception are required to be at ground level." .

    ibc:sem-ibc2021-ch10-list_item-0798 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0798 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-dwellingunit,
            ibc:concept-sleepingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0798-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0798 ;
        ibco:statementType "exemption" ;
        ibco:text "2. A fire-resistance rating is not required for corridors contained within a dwelling unit or sleeping unit in an occupancy in Groups I-1 and R." .

    ibc:sem-ibc2021-ch10-list_item-0799 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0799 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0799-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0799 ;
        ibco:statementType "exemption" ;
        ibco:text "3. A fire-resistance rating is not required for corridors in open parking garages." .

    ibc:sem-ibc2021-ch10-list_item-0800 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0800 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-meansofegress ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0800-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:references ibc:ibc2021-1006.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0800 ;
        ibco:statementType "exemption" ;
        ibco:text "4. A fire-resistance rating is not required for corridors in an occupancy in Group B that is a space requiring only a single means of egress complying with Section 1006.2." .

    ibc:sem-ibc2021-ch10-list_item-0801 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0801 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0801-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0801-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1020.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0801 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Corridors adjacent to the exterior walls of buildings shall be permitted to have unprotected openings on unrated exterior walls where unrated walls are permitted by Table 705.5 and unprotected openings are permitted by Table 705.8. TABLE 1020.2 CORRIDOR FIRE-RESISTANCE RATING" .

    ibc:sem-ibc2021-ch10-list_item-0802 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0802 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0802 ;
        ibco:statementType "declarative" ;
        ibco:text "a. For requirements for occupancies in Group I-2, see Sections 407.2 and" .

    ibc:sem-ibc2021-ch10-list_item-0803 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0803 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0803 ;
        ibco:statementType "declarative" ;
        ibco:text "407.3." .

    ibc:sem-ibc2021-ch10-list_item-0804 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0804 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0804 ;
        ibco:statementType "declarative" ;
        ibco:text "b. For a reduction in the fire-resistance rating for occupancies in Group I-3, see Section 408.8." .

    ibc:sem-ibc2021-ch10-list_item-0805 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0805 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0805-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0805 ;
        ibco:statementType "declarative" ;
        ibco:text "c. Buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 where allowed." .

    ibc:sem-ibc2021-ch10-list_item-0806 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0806 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0806-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0806-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0806 ;
        ibco:statementType "permission" ;
        ibco:text "d. Group R-3 and R-4 buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3. See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3." .

    ibc:sem-ibc2021-ch10-list_item-0814 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0814 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0814-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0814-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0814 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. In Group I-3, Condition 2, 3 or 4, occupancies, the dead end in a corridor shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0815 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0815 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0815-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0815-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0815-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0815 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. In occupancies in Groups B, E, F, I-1, M, R-1, R- 2, S and U, where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, the length of the dead-end corridors shall not exceed 50 feet (15 240 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0816 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0816 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0816-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0816-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0816 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. A dead-end corridor shall not be limited in length where the length of the dead-end corridor is less than 2.5 times the least width of the dead-end corridor." .

    ibc:sem-ibc2021-ch10-list_item-0817 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0817 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0817-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0817-measurement-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0817 ;
        ibco:statementType "prohibition" ;
        ibco:text "4. In Group I-2, Condition 2 occupancies, the length of dead-end corridors that do not serve patient rooms or patient treatment spaces shall not exceed 30 feet (9144 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0820 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0820 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-toiletroom ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0820-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0820-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0820 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Use of a corridor as a source of makeup air for exhaust systems in rooms that open directly onto such corridors, including toilet rooms, bathrooms, dressing rooms, smoking lounges and janitor closets, shall be permitted, provided that each such corridor is directly supplied with outdoor air at a rate greater than the rate of makeup air taken from the corridor." .

    ibc:sem-ibc2021-ch10-list_item-0821 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0821 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-dwellingunit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0821-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0821-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0821 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Where located within a dwelling unit, the use of corridors for conveying return air shall not be prohibited." .

    ibc:sem-ibc2021-ch10-list_item-0822 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0822 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0822-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0822-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0822-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0822 ;
        ibco:statementType "permission" ;
        ibco:text "3. Where located within tenant spaces of 1,000 square feet (93 m2) or less in area, utilization of corridors for conveying return air is permitted." .

    ibc:sem-ibc2021-ch10-list_item-0823 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0823 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0823 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Transfer air movement required to maintain the pressurization difference within health care facilities in accordance with ASHRAE 170." .

    ibc:sem-ibc2021-ch10-list_item-0825 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0825 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0825-atomic-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0825 ;
        ibco:statementType "exemption" ;
        ibco:text "1. The corridor is not required to be of fire-resistance-rated construction." .

    ibc:sem-ibc2021-ch10-list_item-0826 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0826 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0826 ;
        ibco:statementType "declarative" ;
        ibco:text "2. The corridor is separated from the plenum by fireresistance-rated construction." .

    ibc:sem-ibc2021-ch10-list_item-0827 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0827 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0827 ;
        ibco:statementType "declarative" ;
        ibco:text "3. The air-handling system serving the corridor is shut down upon activation of the air-handling unit smoke detectors required by the International Mechanical Code." .

    ibc:sem-ibc2021-ch10-list_item-0828 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0828 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0828-condition-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0828 ;
        ibco:statementType "declarative" ;
        ibco:text "4. The air-handling system serving the corridor is shut down upon detection of sprinkler water flow where the building is equipped throughout with an automatic sprinkler system." .

    ibc:sem-ibc2021-ch10-list_item-0829 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0829 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0829 ;
        ibco:statementType "declarative" ;
        ibco:text "5. The space between the corridor ceiling and the floor or roof structure above the corridor is used as a component of an approved engineered smoke control system." .

    ibc:sem-ibc2021-ch10-list_item-0832 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0832 ;
        ibco:appliesTo ibc:concept-corridor ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0832-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0832 ;
        ibco:statementType "prohibition" ;
        ibco:text "1. Foyers, lobbies or reception rooms constructed as required for corridors shall not be construed as intervening rooms." .

    ibc:sem-ibc2021-ch10-list_item-0833 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0833 ;
        ibco:appliesTo ibc:concept-enclosed-elevator-lobbies-as ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0833-atomic-1 ;
        ibco:modality "may" ;
        ibco:references ibc:ibc2021-1016.2 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0833 ;
        ibco:statementType "permission" ;
        ibco:text "2. Enclosed elevator lobbies as permitted by Item 1 of Section 1016.2 shall not be construed as intervening rooms." .

    ibc:sem-ibc2021-ch10-list_item-0840 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0840 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0840 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Adjacent lot lines." .

    ibc:sem-ibc2021-ch10-list_item-0841 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0841 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0841 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Other portions of the building." .

    ibc:sem-ibc2021-ch10-list_item-0842 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0842 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0842-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0842-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0842 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Other buildings on the same lot unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance. For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:sem-ibc2021-ch10-list_item-0852 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0852 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0852 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Interior exit stairways and ramps in Group I-3 occupancies in accordance with the provisions of Section 408.3.8." .

    ibc:sem-ibc2021-ch10-list_item-0853 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0853 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0853 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Interior exit stairways within an atrium enclosed in accordance with Section 404.6." .

    ibc:sem-ibc2021-ch10-list_item-0854 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0854 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0854 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Interior exit stairways in accordance with Section" .

    ibc:sem-ibc2021-ch10-list_item-0855 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0855 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0855 ;
        ibco:statementType "declarative" ;
        ibco:text "510.2." .

    ibc:sem-ibc2021-ch10-list_item-0860 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0860 ;
        ibco:appliesTo ibc:concept-penetrations-of-the-fire-barrier-in-accordance-with-section-1023-5 ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0860-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.5 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0860 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Penetrations of the fire barrier in accordance with Section 1023.5 shall be permitted." .

    ibc:sem-ibc2021-ch10-list_item-0861 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0861 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0861-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0861-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0861 ;
        ibco:statementType "prohibition" ;
        ibco:text "2. Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where there are no openings into the exit passageway extension." .

    ibc:sem-ibc2021-ch10-list_item-0862 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0862 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0862-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0862-condition-1 ;
        ibco:modality "shall_not" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0862 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Separation between an interior exit stairway or ramp and the exit passageway extension shall not be required where the interior exit stairway and the exit passageway extension are pressurized in accordance with Section 909.20.5." .

    ibc:sem-ibc2021-ch10-list_item-0865 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0865 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0865 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Equipment and ductwork necessary for independent ventilation or pressurization." .

    ibc:sem-ibc2021-ch10-list_item-0866 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0866 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0866 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Fire protection systems." .

    ibc:sem-ibc2021-ch10-list_item-0867 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0867 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0867 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Security systems." .

    ibc:sem-ibc2021-ch10-list_item-0868 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0868 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0868 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Two-way communication systems." .

    ibc:sem-ibc2021-ch10-list_item-0869 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0869 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0869 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Electrical raceway for fire department communication systems." .

    ibc:sem-ibc2021-ch10-list_item-0870 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0870 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0870 ;
        ibco:statementType "declarative" ;
        ibco:text "6. Electrical raceway serving the interior exit stairway and ramp and terminating at a steel box not exceeding 16 square inches (0.010 m2)." .

    ibc:sem-ibc2021-ch10-list_item-0871 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0871 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0871-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0871-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0871 ;
        ibco:statementType "obligation" ;
        ibco:text "7. Structural elements supporting the interior exit stairway or ramp or enclosure, such as beams or joists. Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communication openings, whether protected or not, between adjacent interior exit stairways and ramps." .

    ibc:sem-ibc2021-ch10-list_item-0873 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0873 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0873 ;
        ibco:statementType "declarative" ;
        ibco:text "714.4.2." .

    ibc:sem-ibc2021-ch10-list_item-0875 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0875 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0875-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0875 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Such equipment and ductwork shall be located exterior to the building and shall be directly connected to the interior exit stairway and ramp by ductwork enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0876 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0876 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0876-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0876-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0876 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0877 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0877 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0877-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0877-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0877-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0877-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0877 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Where located within the building, such equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts. In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures. The interior exit stairway and ramp ventilation systems shall be independent of other building ventilation systems." .

    ibc:sem-ibc2021-ch10-list_item-0882 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0882 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0882-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0882-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0882-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0882 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The signs shall be a minimum size of 18 inches (457 mm) by 12 inches (305 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0883 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0883 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0883-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0883-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0883 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The letters designating the identification of the interior exit stairway and ramp shall be not less than 11/2 inches (38 mm) in height." .

    ibc:sem-ibc2021-ch10-list_item-0884 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0884 ;
        ibco:appliesTo ibc:concept-signage ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0884-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0884-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0884 ;
        ibco:statementType "obligation" ;
        ibco:text "3. The number designating the floor level shall be not less than 5 inches (127 mm) in height and located in the center of the sign." .

    ibc:sem-ibc2021-ch10-list_item-0885 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0885 ;
        ibco:appliesTo ibc:concept-other-lettering-and-numbers ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0885-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0885-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0885 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Other lettering and numbers shall be not less than 1 inch (25 mm) in height." .

    ibc:sem-ibc2021-ch10-list_item-0886 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0886 ;
        ibco:appliesTo ibc:concept-characters-and-their-background ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0886-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0886-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0886 ;
        ibco:statementType "obligation" ;
        ibco:text "5. Characters and their background shall have a nonglare finish. Characters shall contrast with their background, with either light characters on a dark background or dark characters on a light background." .

    ibc:sem-ibc2021-ch10-list_item-0887 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0887 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-signage,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0887-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0887-condition-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1023.9,
            ibc:ibc2021-1025,
            ibc:ibc2021-1025.4 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0887 ;
        ibco:statementType "obligation" ;
        ibco:text "6. Where signs required by Section 1023.9 are installed in the interior exit stairways and ramps of buildings subject to Section 1025, the signs shall be made of the same materials as required by Section 1025.4." .

    ibc:sem-ibc2021-ch10-list_item-0893 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0893 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0893-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0893-condition-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0893 ;
        ibco:statementType "permission" ;
        ibco:text "1. Openings in the exit passageway serving a smokeproof enclosure are permitted where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors." .

    ibc:sem-ibc2021-ch10-list_item-0894 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0894 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0894-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0894-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0894 ;
        ibco:statementType "exemption" ;
        ibco:text "2. The fire barrier separating the smokeproof enclosure from the exit passageway is not required, provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0895 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0895 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0895-atomic-1 ;
        ibco:modality "shall" ;
        ibco:references ibc:ibc2021-1028 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0895 ;
        ibco:statementType "obligation" ;
        ibco:text "3. A smokeproof enclosure shall be permitted to egress through areas on the level of exit discharge or vestibules as permitted by Section 1028." .

    ibc:sem-ibc2021-ch10-list_item-0898 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0898 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0898 ;
        ibco:statementType "declarative" ;
        ibco:text "909.20.5." .

    ibc:sem-ibc2021-ch10-list_item-0900 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0900 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0900 ;
        ibco:statementType "declarative" ;
        ibco:text "905.4." .

    ibc:sem-ibc2021-ch10-list_item-0909 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0909 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0909 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Equipment and ductwork necessary for independent ventilation or pressurization." .

    ibc:sem-ibc2021-ch10-list_item-0910 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0910 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0910 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Fire protection systems." .

    ibc:sem-ibc2021-ch10-list_item-0911 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0911 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0911 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Security systems." .

    ibc:sem-ibc2021-ch10-list_item-0912 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0912 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0912 ;
        ibco:statementType "declarative" ;
        ibco:text "4. Two-way communication systems." .

    ibc:sem-ibc2021-ch10-list_item-0913 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0913 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0913 ;
        ibco:statementType "declarative" ;
        ibco:text "5. Electrical raceway for fire department communication." .

    ibc:sem-ibc2021-ch10-list_item-0914 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0914 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0914-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0914-atomic-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0914 ;
        ibco:statementType "obligation" ;
        ibco:text "6. Electrical raceway serving the exit passageway and terminating at a steel box not exceeding 16 square inches (0.010 m2). Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communicating openings, whether protected or not, between adjacent exit passageways." .

    ibc:sem-ibc2021-ch10-list_item-0917 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0917 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0917-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0917 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The equipment and ductwork shall be located exterior to the building and shall be directly connected to the exit passageway by ductwork enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0918 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0918 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0918-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0918-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0918 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts." .

    ibc:sem-ibc2021-ch10-list_item-0919 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0919 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0919-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0919-atomic-2,
            ibc:sem-ibc2021-ch10-list_item-0919-atomic-3 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0919-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0919 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Where located within the building, the equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts. In each case, openings into the fire-resistance-rated construction shall be limited to those needed for maintenance and operation and shall be protected by opening protectives in accordance with Section 716 for shaft enclosures. Exit passageway ventilation systems shall be independent of other building ventilation systems." .

    ibc:sem-ibc2021-ch10-list_item-0922 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0922 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0922 ;
        ibco:statementType "declarative" ;
        ibco:text "905.4." .

    ibc:sem-ibc2021-ch10-list_item-0947 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0947 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0947 ;
        ibco:statementType "declarative" ;
        ibco:text "1. UL 1994." .

    ibc:sem-ibc2021-ch10-list_item-0948 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0948 ;
        ibco:appliesTo ibc:concept-astm-e2072-except-that-the-charging-source ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0948-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0948 ;
        ibco:statementType "obligation" ;
        ibco:text "2. ASTM E2072, except that the charging source shall be 1 footcandle (11 lux) of fluorescent illumination for 60 minutes, and the minimum luminance shall be 30 milicandelas per square meter at 10 minutes and 5 milicandelas per square meter after 90 minutes." .

    ibc:sem-ibc2021-ch10-list_item-0953 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0953 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0953-atomic-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0953 ;
        ibco:statementType "permission" ;
        ibco:text "1. Horizontal exits are permitted to comprise twothirds of the required exits from any building or floor area for occupancies in Group I-2." .

    ibc:sem-ibc2021-ch10-list_item-0954 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0954 ;
        ibco:appliesTo ibc:concept-exit ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0954-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0954-atomic-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0954-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0954-measurement-2 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0954 ;
        ibco:statementType "permission" ;
        ibco:text "2. Horizontal exits are permitted to comprise 100 percent of the exits required for occupancies in Group I-3. Not less than 6 square feet (0.6 m2) of accessible space per occupant shall be provided on each side of the horizontal exit for the total number of people in adjoining compartments." .

    ibc:sem-ibc2021-ch10-list_item-0956 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0956 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0956-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0956-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0956-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0956 ;
        ibco:statementType "obligation" ;
        ibco:text "716. Duct and air transfer openings in a fire wall or fire barrier that serves as a horizontal exit shall also comply with Section 717. The horizontal exit separation shall extend vertically through all levels of the building unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings." .

    ibc:sem-ibc2021-ch10-list_item-0964 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0964 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0964 ;
        ibco:statementType "declarative" ;
        ibco:text "905.4." .

    ibc:sem-ibc2021-ch10-list_item-0971 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0971 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0971 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Adjacent lot lines." .

    ibc:sem-ibc2021-ch10-list_item-0972 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0972 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0972 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Other portions of the building." .

    ibc:sem-ibc2021-ch10-list_item-0973 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0973 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0973-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0973-condition-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0973 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Other buildings on the same lot unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance. For the purposes of this section, other portions of the building shall be treated as separate buildings." .

    ibc:sem-ibc2021-ch10-list_item-0977 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0977 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-exitdischarge ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0977-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0977-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0977-condition-2 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0977 ;
        ibco:statementType "exemption" ;
        ibco:text "1. Separation from the interior of the building is not required for occupancies, other than those in Group R-1 or R-2, in buildings that are not more than two stories above grade plane where a level of exit discharge serving such occupancies is the first story above grade plane." .

    ibc:sem-ibc2021-ch10-list_item-0978 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0978 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0978-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0978-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0978-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0978-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0978-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-0978-measurement-3 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0978 ;
        ibco:statementType "exemption" ;
        ibco:text "2. Separation from the interior of the building is not required where the exterior exit stairway or ramp is served by an exterior exit ramp or balcony that connects two remote exterior exit stairways or other approved exits with a perimeter that is not less than 50 percent open. To be considered open, the opening shall be not less than 50 percent of the height of the enclosing wall, with the top of the openings not less than 7 feet (2134 mm) above the top of the balcony." .

    ibc:sem-ibc2021-ch10-list_item-0979 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0979 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0979-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0979-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0979 ;
        ibco:statementType "exemption" ;
        ibco:text "3. Separation from the open-ended corridor of the building is not required for exterior exit stairways or ramps, provided that Items 3.1 through 3.5 are met:" .

    ibc:sem-ibc2021-ch10-list_item-0980 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0980 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-corridor,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0980-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0980 ;
        ibco:statementType "obligation" ;
        ibco:text "3.1. The building, including open-ended corridors, and stairways and ramps, shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2." .

    ibc:sem-ibc2021-ch10-list_item-0981 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0981 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1020 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0981 ;
        ibco:statementType "declarative" ;
        ibco:text "3.2. The open-ended corridors comply with Section 1020." .

    ibc:sem-ibc2021-ch10-list_item-0982 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0982 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1027 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0982 ;
        ibco:statementType "declarative" ;
        ibco:text "3.3. The open-ended corridors are connected on each end to an exterior exit stairway or ramp complying with Section 1027." .

    ibc:sem-ibc2021-ch10-list_item-0983 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0983 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:references ibc:ibc2021-1023.7 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0983 ;
        ibco:statementType "declarative" ;
        ibco:text "3.4. The exterior walls and openings adjacent to the exterior exit stairway or ramp comply with Section 1023.7." .

    ibc:sem-ibc2021-ch10-list_item-0984 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0984 ;
        ibco:appliesTo ibc:concept-corridor,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0984-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0984-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0984-condition-1,
            ibc:sem-ibc2021-ch10-list_item-0984-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0984-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0984 ;
        ibco:statementType "obligation" ;
        ibco:text "3.5. At any location in an open-ended corridor where a change of direction exceeding 45 degrees (0.79 rad) occurs, a clear opening of not less than 35 square feet (3.3 m2) or an exterior stairway or ramp shall be provided. Where clear openings are provided, they shall be located so as to minimize the accumulation of smoke or toxic gases." .

    ibc:sem-ibc2021-ch10-list_item-0985 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0985 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-dwellingunit,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0985-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0985-condition-1 ;
        ibco:modality "not_required" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0985 ;
        ibco:statementType "exemption" ;
        ibco:text "4. In Group R-3 occupancies not more than four stories in height, exterior exit stairways and ramps serving individual dwelling units are not required to be separated from the interior of the building where the exterior exit stairway or ramp discharges directly to grade." .

    ibc:sem-ibc2021-ch10-list_item-0990 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0990 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0990-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0990-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0990-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0990 ;
        ibco:statementType "permission" ;
        ibco:text "1. Not more than 50 percent of the number and minimum width or required capacity of interior exit stairways and ramps is permitted to egress through areas, including atriums, on the level of discharge provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0991 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0991 ;
        ibco:appliesTo ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0991-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0991 ;
        ibco:statementType "obligation" ;
        ibco:text "1.1. Discharge of interior exit stairways and ramps shall be provided with a free and unobstructed path of travel to an exterior exit door and such exit is readily visible and identifiable from the point of termination of the enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0992 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0992 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0992 ;
        ibco:statementType "declarative" ;
        ibco:text "1.2. The entire area of the level of exit discharge is separated from areas below by construction conforming to the fireresistance rating for the enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0993 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0993 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0993-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0993 ;
        ibco:statementType "obligation" ;
        ibco:text "1.3. The egress path from the interior exit stairway and ramp on the level of exit discharge is protected throughout by an approved automatic sprinkler system. Portions of the level of exit discharge with access to the egress path shall be either equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, or separated from the egress path in accordance with the requirements for the enclosure of interior exit stairways or ramps." .

    ibc:sem-ibc2021-ch10-list_item-0994 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0994 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-door,
            ibc:concept-exit,
            ibc:concept-exitaccess,
            ibc:concept-exitdischarge,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.81 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0994-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-0994-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0994-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0994-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0994 ;
        ibco:statementType "obligation" ;
        ibco:text "1.4. Where a required interior exit stairway or ramp and an exit access stairway or ramp serve the same floor level and terminate at the same level of exit discharge, the termination of the exit access stairway or ramp and the exit discharge door of the interior exit stairway or ramp shall be separated by a distance of not less than 30 feet (9144 mm) or not less than one-fourth the length of the maximum overall diagonal dimension of the building, whichever is less. The distance shall be measured in a straight line between the exit discharge door from the interior exit stairway or ramp and the last tread of the exit access stairway or termination of slope of the exit access ramp." .

    ibc:sem-ibc2021-ch10-list_item-0995 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0995 ;
        ibco:appliesTo ibc:concept-exit,
            ibc:concept-ramp,
            ibc:concept-stairway ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-0995-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-0995-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0995-measurement-1 ;
        ibco:modality "may" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0995 ;
        ibco:statementType "permission" ;
        ibco:text "2. Not more than 50 percent of the number and minimum width or required capacity of the interior exit stairways and ramps is permitted to egress through a vestibule provided that all of the following conditions are met:" .

    ibc:sem-ibc2021-ch10-list_item-0996 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0996 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0996 ;
        ibco:statementType "declarative" ;
        ibco:text "2.1. The entire area of the vestibule is separated from areas below by construction conforming to the fire-resistance rating of the interior exit stairway or ramp enclosure." .

    ibc:sem-ibc2021-ch10-list_item-0997 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0997 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-0997-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-0997-measurement-2 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0997 ;
        ibco:statementType "declarative" ;
        ibco:text "2.2. The depth from the exterior of the building is not greater than 10 feet (3048 mm) and the length is not greater than 30 feet (9144 mm)." .

    ibc:sem-ibc2021-ch10-list_item-0998 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-0998 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-0998 ;
        ibco:statementType "declarative" ;
        ibco:text "2.3. The area is separated from the remainder of the level of exit discharge by a fire partition constructed in accordance with Section 708." .

    ibc:sem-ibc2021-ch10-list_item-1000 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1000 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1000 ;
        ibco:statementType "declarative" ;
        ibco:text "2.4. The area is used only for means of egress and exits directly to the outside." .

    ibc:sem-ibc2021-ch10-list_item-1001 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1001 ;
        ibco:appliesTo ibc:concept-buildingorfacility,
            ibc:concept-exit ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1001-atomic-1 ;
        ibco:modality "shall_not" ;
        ibco:references ibc:ibc2021-1026 ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1001 ;
        ibco:statementType "prohibition" ;
        ibco:text "3. Horizontal exits complying with Section 1026 shall not be required to discharge directly to the exterior of the building." .

    ibc:sem-ibc2021-ch10-list_item-1006 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1006 ;
        ibco:appliesTo ibc:concept-the-area ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1006-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1006-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1006 ;
        ibco:statementType "obligation" ;
        ibco:text "1. The area shall be of a size to accommodate not less than 5 square feet (0.46 m2) for each person." .

    ibc:sem-ibc2021-ch10-list_item-1007 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1007 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1007-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1007-measurement-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1007 ;
        ibco:statementType "obligation" ;
        ibco:text "2. The area shall be located on the same lot not less than 50 feet (15 240 mm) away from the building requiring egress." .

    ibc:sem-ibc2021-ch10-list_item-1008 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1008 ;
        ibco:appliesTo ibc:concept-the-area ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1008-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1008 ;
        ibco:statementType "obligation" ;
        ibco:text "3. The area shall be permanently maintained and identified as a safe dispersal area." .

    ibc:sem-ibc2021-ch10-list_item-1009 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1009 ;
        ibco:appliesTo ibc:concept-buildingorfacility ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1009-atomic-1 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1009 ;
        ibco:statementType "obligation" ;
        ibco:text "4. The area shall be provided with a safe and unobstructed path of travel from the building. **" .

    ibc:sem-ibc2021-ch10-list_item-1016 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1016 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1016 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Egress courts serving an occupant load of less than 10." .

    ibc:sem-ibc2021-ch10-list_item-1017 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1017 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1017 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Egress courts serving Group R-3." .

    ibc:sem-ibc2021-ch10-list_item-1023 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1023 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1023-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1023 ;
        ibco:statementType "declarative" ;
        ibco:text "1. Ticket booths less than 100 square feet (9.29 m2) in area." .

    ibc:sem-ibc2021-ch10-list_item-1024 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1024 ;
        ibco:confidence 0.81 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "categorical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1024 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Toilet rooms." .

    ibc:sem-ibc2021-ch10-list_item-1025 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1025 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1025-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1025 ;
        ibco:statementType "declarative" ;
        ibco:text "3. Other accessory use areas 1,000 square feet (92.9 m2) or less in area and equipped with an automatic sprinkler system in accordance with Section 903.3.1.1." .

    ibc:sem-ibc2021-ch10-list_item-1032 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1032 ;
        ibco:appliesTo ibc:concept-not-less-than-0-3-inch-7-6-mm-of-aisle-capacity-for-each-occupant-served ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1032-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1032-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1032-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-1032-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1032 ;
        ibco:statementType "obligation" ;
        ibco:text "1. Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings." .

    ibc:sem-ibc2021-ch10-list_item-1033 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1033 ;
        ibco:appliesTo ibc:concept-not-less-than-0-005-inch-0-127-mm-of-additional-aisle-capacity-for-each-occupant ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1033-atomic-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1033-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1033-measurement-2,
            ibc:sem-ibc2021-ch10-list_item-1033-measurement-3 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1033 ;
        ibco:statementType "obligation" ;
        ibco:text "2. Not less than 0.005 inch (0.127 mm) of additional aisle capacity for each occupant shall be provided for each 0.10 inch (2.5 mm) of riser height above 7 inches (178 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1034 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1034 ;
        ibco:appliesTo ibc:concept-handrail ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1034-atomic-1 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1034-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1034-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1034-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical",
            "topological" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1034 ;
        ibco:statementType "obligation" ;
        ibco:text "3. Where egress requires stepped aisle descent, not less than 0.075 inch (1.9 mm) of additional aisle capacity for each occupant shall be provided on those portions of aisle capacity that do not have a handrail within a horizontal distance of 30 inches (762 mm)." .

    ibc:sem-ibc2021-ch10-list_item-1035 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1035 ;
        ibco:appliesTo ibc:concept-ramped-aisles-where-slopes-are-steeper-than-one-unit-vertical-in-12-units-horizontal-8-percent-slope ;
        ibco:confidence 0.93 ;
        ibco:hasAtomicRule ibc:sem-ibc2021-ch10-list_item-1035-atomic-1,
            ibc:sem-ibc2021-ch10-list_item-1035-atomic-2 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1035-condition-1,
            ibc:sem-ibc2021-ch10-list_item-1035-condition-2 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1035-measurement-1,
            ibc:sem-ibc2021-ch10-list_item-1035-measurement-2 ;
        ibco:modality "shall" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1035 ;
        ibco:statementType "obligation" ;
        ibco:text "4. Ramped aisles, where slopes are steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.22 inch (5.6 mm) of clear aisle capacity for each occupant served. Level or ramped aisles, where slopes are not steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.20 inch (5.1 mm) of clear aisle capacity for each occupant served." .

    ibc:sem-ibc2021-ch10-list_item-1042 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1042 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1042-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1042-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1042 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The floor area used for contests, performances or entertainment provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:sem-ibc2021-ch10-list_item-1043 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1043 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1043-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1043 ;
        ibco:statementType "declarative" ;
        ibco:text "2. Press boxes and storage facilities less than 1,000 square feet (93 m2) in area. " .

    ibc:sem-ibc2021-ch10-list_item-1048 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1048 ;
        ibco:confidence 0.81 ;
        ibco:hasCondition ibc:sem-ibc2021-ch10-list_item-1048-condition-1 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1048-measurement-1 ;
        ibco:modality "unspecified" ;
        ibco:reviewStatus "unreviewed" ;
        ibco:ruleType "logical",
            "numerical" ;
        ibco:sourceNode ibc:ibc2021-ch10-list_item-1048 ;
        ibco:statementType "declarative" ;
        ibco:text "1. The floor area used for contests, performances or entertainment, provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses." .

    ibc:sem-ibc2021-ch10-list_item-1049 a ibco:Requirement ;
        prov:wasDerivedFrom ibc:ibc2021-ch10-list_item-1049 ;
        ibco:confidence 0.81 ;
        ibco:hasMeasurement ibc:sem-ibc2021-ch10-list_item-1049-measurement-1 ;
