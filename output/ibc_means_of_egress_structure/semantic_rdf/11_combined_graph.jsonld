        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 336
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1019.3 Occupancies other than Groups I-2 and I-3. In other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.1.5",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[319.792, 150.68, 550.849, 249.752]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0314"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Landings at doors"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.1.5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
