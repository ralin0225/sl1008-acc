    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Horizontal sliding or swinging gates exceeding the 4-foot (1219 mm) maximum leaf width limitation are permitted in fences and walls surrounding a stadium."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1008.3.4",
