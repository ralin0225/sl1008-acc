    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1017.2 Limitations. Exit access travel distance shall not exceed the values given in Table 1017.2. TABLE 1017.2 EXIT ACCESS TRAVEL DISTANCEa For SI: 1 foot = 304.8 mm."
