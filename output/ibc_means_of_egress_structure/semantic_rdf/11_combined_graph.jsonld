    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the top of the sill of the opening is located more than 75 feet (22 860 mm) above the finished grade or other surface below and that are provided with window fall prevention devices that comply with ASTM F2006."
      }
    ]
  },
  {
