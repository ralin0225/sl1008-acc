    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. One accessible means of egress is required from an accessible mezzanine level in accordance with Section 1009.3, 1009.4 or 1009.5."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0711-atomic-1",
