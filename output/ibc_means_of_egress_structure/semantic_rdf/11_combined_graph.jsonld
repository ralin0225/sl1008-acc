      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The extensions of handrails shall be in the same direction of the flights of stairs at stairways and the ramp runs at ramps."
      }
    ]
  },
  {
