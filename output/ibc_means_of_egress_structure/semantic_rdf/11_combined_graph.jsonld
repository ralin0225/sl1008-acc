    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.12.2 Enclosure access. Access to the stairway or ramp within a smokeproof enclosure shall be by way of a vestibule or an open exterior balcony."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.2.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
