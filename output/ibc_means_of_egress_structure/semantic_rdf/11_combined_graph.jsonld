      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Permanent ladders shall be permitted to provide access to the following areas:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0730-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0416-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The delayed egress locking system shall have the capability of being deactivated at the fire command center and other approved locations."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0324-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum distance between horizontal sliding power-operated doors in a series shall be 48 inches (1219 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-protruding-objects",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
