        "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1034-measurement-1"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "topological"
      },
      {
        "@value": "numerical"
      },
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1034"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Where egress requires stepped aisle descent, not less than 0.075 inch (1.9 mm) of additional aisle capacity for each occupant shall be provided on those portions of aisle capacity that do not have a handrail within a horizontal distance of 30 inches (762 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.2",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
