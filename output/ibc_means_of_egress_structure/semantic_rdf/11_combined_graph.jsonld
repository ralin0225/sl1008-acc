      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.3 Handrail graspability. Required handrails shall comply with Section 1014.3.1 or shall provide equivalent graspability."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0345-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
