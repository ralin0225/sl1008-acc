      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. The occupant load, number of dwelling units and exit access travel distance do not exceed the values in Table 1006.3.4(1) or 1006.3.4(2)."
      }
    ]
  },
