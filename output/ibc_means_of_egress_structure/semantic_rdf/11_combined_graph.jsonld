      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.2 Minimum width based on component. The minimum width, in inches (mm), of any means of egress components shall be not less than that specified for such component, elsewhere in this code."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0274-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
