    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.4 Opening limitations. Required guards shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter from the walking surface to the required guard height."
      }
    ]
  },
