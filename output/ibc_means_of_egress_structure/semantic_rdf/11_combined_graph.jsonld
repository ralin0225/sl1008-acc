      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In Group I-1, Condition 2 and Group I-2 occupancies where the clinical needs of persons receiving care require containment or where persons receiving care pose a security threat, provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0025-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
