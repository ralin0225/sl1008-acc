        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 351
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.14.1.1 Cross slope. The slope measured perpendicular to the direction of travel of a ramped aisle shall not be steeper than 1 unit vertical in 48 units horizontal (2-percent slope)."
      }
    ]
  },
