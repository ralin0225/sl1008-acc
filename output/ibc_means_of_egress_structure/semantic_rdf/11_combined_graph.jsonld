      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.2 Cumulative occupant loads. Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
