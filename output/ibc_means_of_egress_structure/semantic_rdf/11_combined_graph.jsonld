      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "At ramps where handrails are not continuous between runs, the handrails shall extend horizontally above the landing 12 inches (305 mm) minimum beyond the top and bottom of ramp runs."
      }
    ]
  },
