    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.5 Distribution of minimum width and required capacity. Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width."
      }
    ]
  },
