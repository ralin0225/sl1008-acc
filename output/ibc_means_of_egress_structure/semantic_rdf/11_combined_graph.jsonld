      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.179, 361.732, 304.238, 471.72]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.13.1.1"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.13.1.2"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1113"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Seating at tables"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.13.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.13"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1113"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 350
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.13.1 Seating at tables. Where seating is located at a table or counter and is adjacent to an aisle or aisle accessway, the measurement of required clear width of the aisle or aisle accessway shall be made to a line 19 inches (483 mm) away from and parallel to the edge of the table or counter. The 19-inch (483 mm) distance shall be measured perpendicular to the side of the table or counter. In the case of other side boundaries for aisles or aisle accessways, the clear width shall be measured to walls, edges of seating and tread edges."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.2.2.6-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
