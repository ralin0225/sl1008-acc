      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1026.3-condition-1",
