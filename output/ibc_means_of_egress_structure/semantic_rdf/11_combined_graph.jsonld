      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1020.2 Construction. Corridors shall be fire-resistance rated in accordance with Table 1020.2. The corridor walls required to be fire-resistance rated shall comply with Section 708 for fire partitions."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.7-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Space between two doors in a series shall be 48 inches (1219 mm) minimum plus the width of a door swinging into the space."
      }
    ]
  },
  {
