      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.9 Guards. Guards shall be provided where required by Section 1015 and shall be constructed in accordance with Section 1015."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.5-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
