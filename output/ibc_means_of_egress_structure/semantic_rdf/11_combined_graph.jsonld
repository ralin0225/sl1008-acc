      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Door closers, overhead door stops, power door operators, and electromagnetic door locks shall be permitted to be 78 inches (1980 mm) minimum above the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9.2-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Rooms containing electrical equipment rated 800 amperes or more that contain overcurrent devices, switching devices or control devices and where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.8.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0331-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
