      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[346.2, 664.688, 565.264, 697.665]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.1.3"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0300"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 316
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0431-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1008.2.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[334.199, 69.595, 565.18, 102.692]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0164"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Exit discharge"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1008.2.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1008.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0164"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 312
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.2.3 Exit discharge. Illumination shall be provided along the path of travel for the exit discharge from each exit to the public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0370-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.6.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Every required area of refuge shall have direct access to a stairway complying with Sections 1009.3 and 1023 or an elevator complying with Section 1009.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0919-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exit passageway ventilation systems shall be independent of other building ventilation systems."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.1.1.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Spaces under grandstands or bleachers shall be separated by fire barriers complying with Section 707 and horizontal assemblies complying with Section 711 with not less than 1-hour fire-resistance-rated construction."
      }
    ]
