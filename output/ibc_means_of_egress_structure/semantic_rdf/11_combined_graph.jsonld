      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Stairway walking surface"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1011.7.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.7"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0559"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 327
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.7.1 Stairway walking surface. The walking surface of treads and landings of a stairway shall not be sloped steeper than one unit vertical in 48 units horizontal (2percent slope) in any direction. Stairway treads and landings shall have a solid surface. Finish floor surfaces shall be securely attached."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.16.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrail extensions are not required."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.5.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where required by the building official, an approved aisle, seating or fixed equipment diagram substantiating any increase in occupant load shall be submitted."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.1-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
