      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The anticipated occupant load from the adjoining compartment shall be based on the capacity of the horizontal exit doors entering the refuge area or the total occupant load of the adjoining compartment, whichever is less."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1193-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
