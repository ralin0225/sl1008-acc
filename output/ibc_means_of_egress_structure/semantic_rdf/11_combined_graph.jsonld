    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.198, 557.647, 565.309, 656.719]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Foyers and lobbies"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 346
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.4 Foyers and lobbies. In Group A-1 occupancies, where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress. Such foyer, if not directly connected to a public street by all the main entrances or exits, shall have a straight and unobstructed corridor or path of travel to every such main entrance or exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0982",
