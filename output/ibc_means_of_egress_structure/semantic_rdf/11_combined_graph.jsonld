    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Where using refrigerants in quantities limited to the amounts based on the volume set forth in the International Mechanical Code."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0661-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are associated with a Group R-3 occupancy or associated with individual dwelling units in Group R-2 occupancies; where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.7.2-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Other nonstructural projections such as trim and similar decorative features shall be permitted to project into the required width not more than 11/2 inches (38 mm) on each side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0495-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Any security access turnstile lane configuration providing a clear passage width of 32 inches (810 mm) or more shall be credited with a maximum egress capacity as calculated in accordance with Section 1005."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0582",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
