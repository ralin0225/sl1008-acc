    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.2.1 Intervening spaces or accessory areas. Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces. Design of egress path capacity shall be based on the cumulative portion of occupant loads of all rooms, areas or spaces to that point along the path of egress travel."
      }
    ]
  },
