    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.2.1 Elevators required. In buildings where a required accessible floor or occupied roof is four or more stories above or below a level of exit discharge, not less than one required accessible means of egress shall be an elevator complying with Section 1009.4."
      }
    ]
  },
