    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.8.2 Directions. Directions for the use of the twoway communication system, instructions for summoning assistance via the two-way communication system and written identification of the location shall be posted adjacent to the two-way communication system. Signage shall comply with the ICC A117.1 requirements for visual characters."
      }
