      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The separation distance to exit or exit access doorways shall be measured to any point along the width of the doorway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1008.2.3-atomic-1",
