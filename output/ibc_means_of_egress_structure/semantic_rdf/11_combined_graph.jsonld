    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 326
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.5.4 Dimensional uniformity. Stair treads and risers shall be of uniform size and shape. The tolerance between the largest and smallest riser height or between the largest and smallest tread depth shall not exceed 3/8 inch (9.5 mm) in any flight of stairs. The greatest winder tread depth at the walkline within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm)."
      }
    ]
  },
  {
