      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. The building is protected throughout by an approved, supervised automatic sprinkler system in accordance with Section 903.3.1.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0397-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
