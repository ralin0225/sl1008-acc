    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Guards shall be provided where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below."
      }
    ]
  },
  {
