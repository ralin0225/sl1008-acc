      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Ramped aisles shall have edge protection in accordance with Sections 1012.10 and 1012.10.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-where-a-wall-mounted-demarcation-line-transitions-to-a-floor-mounted-demarcation-line-or-vice-versa-the-wall-mounted-demarcation-line",
