    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3.1. The building, including open-ended corridors, and stairways and ramps, shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2."
      }
    ]
  },
