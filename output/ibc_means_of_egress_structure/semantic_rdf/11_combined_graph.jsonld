      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1029.2 Width or capacity. The required capacity of egress courts shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm), except as specified herein. Egress courts serving Group R-3 and U occupancies shall be not less than 36 inches (914 mm) in width. The required capacity and width of egress courts shall be unobstructed to a height of 7 feet (2134 mm). The width of the egress court shall be not less than the required capacity."
      }
    ]
  },
