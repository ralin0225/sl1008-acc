      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.6.4 Separation. Each area of refuge shall be separated from the remainder of the story by a smoke barrier complying with Section 709 or a horizontal exit complying with Section 1026. Each area of refuge shall be designed to minimize the intrusion of smoke."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0871-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
