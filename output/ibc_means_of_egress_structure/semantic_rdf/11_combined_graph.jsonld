    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where access to two or more exits or exit access doorways is required in Section 1006.2.1, access to not less than one of the required exits shall be provided without travel through the enclosed elevator lobbies required by Section 3006."
      }
    ]
  },
