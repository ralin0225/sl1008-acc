        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 308
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.4 Continuity. The minimum width or required capacity of the means of egress required from any story of a building shall not be reduced along the path of egress travel until arrival at the public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-exception-the-minimum-net-clear-opening-for-gradefloor-emergency-escape-and-rescue-openings",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Exception: The minimum net clear opening for gradefloor emergency escape and rescue openings"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.6-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Every landing shall have a minimum depth, measured parallel to the direction of travel, equal to the width of the stairway or 48 inches (1219 mm), whichever is less."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0339-condition-3",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that all clinical staff can readily unlock doors at all times, and all such locks are keyed to keys carried by all clinical staff at all times or all clinical staff have the codes or other means necessary to operate the locks at all times."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0643-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exit signs are not required in occupancies in Group U and individual sleeping units or dwelling units in Group R-1, R-2 or R-3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-egress",
