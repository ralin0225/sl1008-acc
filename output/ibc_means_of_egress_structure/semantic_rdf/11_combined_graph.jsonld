      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1146"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 352
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Groups of seats within a building, room or space used for assembly purposes separated from other seating by railings, guards, partial height walls or similar barriers with level floors and having not more than 14 seats per group shall not be required to be fastened to the floor."
      }
    ]
  },
