      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 351
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 350
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.14.1 Ramped aisles. Aisles that are sloped more than 1 unit vertical in 20 units horizontal (5-percent slope) shall be considered to be a ramped aisle. Ramped aisles that serve as part of an accessible route in accordance with Sections 1009 and 1109.2 shall have a maximum slope of 1 unit vertical in 12 units horizontal (8-percent slope). The slope of other ramped aisles shall not exceed 1 unit vertical in 8 units horizontal (12.5percent slope). TABLE 1030.13.2.1 SMOKE-PROTECTED OR OPEN-AIR ASSEMBLY AISLE ACCESSWAYS For SI: 1 inch = 25.4 mm."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0234-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "unspecified"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "An interior area of refuge at the level of exit discharge that provides direct access to an exterior exit door."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1039-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A roof canopy in an outdoor stadium shall be permitted to be less than 15 feet (4572 mm) above the highest aisle or aisle accessway provided that there are no objects less than 80 inches (2032 mm) above the highest aisle or aisle accessway."
      }
    ]
  },
  {
