      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Electrical raceway serving the interior exit stairway and ramp and terminating at a steel box not exceeding 16 square inches (0.010 m2)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.7-atomic-1",
    "@type": [
