        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The separation between buildings or refuge areas connected by a horizontal exit shall be provided by a fire wall complying with Section 706; or by a fire barrier complying with Section 707 or a horizontal assembly complying with Section 711, or both."
      }
    ]
  },
  {
