      {
        "@value": "1010.3 Special doors. Special doors and security grilles shall comply with the requirements of Sections 1010.3.1 through 1010.3.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0492",
