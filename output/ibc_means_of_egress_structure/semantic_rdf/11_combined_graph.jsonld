        "@value": 304
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.3 Protruding objects. Protruding objects on circulation paths shall comply with the requirements of Sections 1003.3.1 through 1003.3.4."
      }
    ]
  },
  {
