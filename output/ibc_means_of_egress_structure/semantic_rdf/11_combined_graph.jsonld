      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "topological"
      },
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0141"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Where interior exit stairways or ramps are interconnected by a 1-hour fire-resistance-rated corridor conforming to the requirements of Section 1020, the required exit separation shall be measured along the shortest direct line of travel within the corridor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
