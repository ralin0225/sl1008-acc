    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Consistently shaped winders, complying with Section 1011.5, differing from rectangular treads in the same flight of stairs."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0205-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
