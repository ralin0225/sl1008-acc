  {
    "@id": "https://example.org/ibc/2021/ibc2021-1004.9",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[46.776, 374.764, 289.944, 451.765]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Posting of occupant load"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1004.9"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1005"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 307
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.9 Posting of occupant load. Every room or space that is an assembly occupancy shall have the occupant load of the room or space posted in a conspicuous place, near the main exit or exit access doorway from the room or space, for the intended configurations. Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0027",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[70.791, 423.293, 289.799, 445.79]"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1003.3.3"
      }
    ],
