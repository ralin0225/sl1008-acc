      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0033-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A stair with a single riser or with two risers and a tread is permitted at locations not required to be accessible by Chapter 11 where the risers and treads comply with Section 1011.5, the minimum depth of the tread is 13 inches (330 mm) and not less than one handrail complying with Section 1014 is provided within 30 inches (762 mm) of the centerline of the normal path of egress travel on the stair."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0250-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Two-way communication systems are not required at the landing serving each elevator or bank of elevators where the two-way communication system is provided within areas of refuge in accordance with Section 1009.6.5."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.16.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-for-rows-of-seating-served-by-an-aisle-or-doorway-at-only-one-end-of-the-row-the-minimum-clear-width-of-12-inches-305-mm-between-rows",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.2",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
