    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where approved by the building official, the occupant load for concentrated business use areas shall be the actual occupant load, but not less than one occupant per 50 square feet (4.65 m2) of gross occupiable floor space."
      }
    ]
  },
