      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0363"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0400",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
