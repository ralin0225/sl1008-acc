      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The equipment and ductwork shall be located exterior to the building and shall be directly connected to the exit passageway by ductwork enclosed in construction as required for shafts."
      }
    ]
  },
