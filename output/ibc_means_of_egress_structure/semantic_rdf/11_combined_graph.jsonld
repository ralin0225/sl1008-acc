    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, exterior door openings other than the required exit door shall have a minimum clear opening height of 76 inches (1930 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.2.9.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[85.197, 632.688, 304.226, 687.737]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Balanced doors"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.2.9.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.9"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.10"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 320
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.9.4 Balanced doors. If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.2.2",
