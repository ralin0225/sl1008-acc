      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required capacity of each door opening shall be sufficient for the occupant load thereof and shall provide a minimum clear opening width of 32 inches (813 mm)."
      }
    ]
  },
