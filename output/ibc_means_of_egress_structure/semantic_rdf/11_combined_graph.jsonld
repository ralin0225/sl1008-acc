    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.2 Illumination required. The means of egress serving a room or space shall be illuminated at all times that the room or space is occupied."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.9.3-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles."
      }
    ]
  },
  {
