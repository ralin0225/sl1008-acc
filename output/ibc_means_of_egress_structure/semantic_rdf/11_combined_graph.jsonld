    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. In Group R-3 occupancies, a change in elevation consisting of a single riser at an entrance or egress door does not require handrails."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.12-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "unless the roof has a slope steeper than four units vertical in 12 units horizontal (33-percent slope)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0023",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.789, 117.712, 289.802, 198.797]"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1003.3.1"
