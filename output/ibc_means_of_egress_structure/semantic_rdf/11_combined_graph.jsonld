  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than one means of egress is required by Section 1006."
      }
    ]
  },
  {
