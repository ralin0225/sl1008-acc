    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1016.2 Egress through intervening spaces. Egress through intervening spaces shall comply with this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1151-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
