        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0380"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 320
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. A main exit of a Group A occupancy shall be permitted to have locking devices in accordance with Section 1010.2.4, Item 3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.1-atomic-3",
