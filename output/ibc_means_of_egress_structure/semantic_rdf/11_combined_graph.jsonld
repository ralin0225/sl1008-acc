        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairways shall have a clear width of 48 inches (1219 mm) minimum between handrails."
      }
    ]
  },
  {
