      {
        "@value": "Areas of refuge are not required at elevators serving smoke-protected or open-air assembly seating areas complying with Sections 1030.6.2 and 1030.6.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.11",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
