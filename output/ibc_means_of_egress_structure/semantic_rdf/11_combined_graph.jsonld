    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.1.3 Forces to unlatch and open doors. The forces to unlatch doors shall comply with the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1007.1.3.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[85.199, 69.725, 304.241, 124.774]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1007.1.3.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1007.1.3"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1008"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 312
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1007.1.3.1 Three or more exit access stairways or ramps. Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007.1.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1028.2-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The combined use of Exceptions 1 and 2 shall not exceed 50 percent of the number and minimum width or required capacity of the required exits."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.1-measurement-4",
