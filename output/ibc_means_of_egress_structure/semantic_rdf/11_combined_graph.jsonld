      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 338
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1021.1 General. Balconies used for egress purposes shall conform to the same requirements as corridors for minimum width, required capacity, headroom, dead ends and projections."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.11-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
