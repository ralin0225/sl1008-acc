      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Areas of refuge shall be provided with a two-way communication system complying with Sections 1009.8.1 and 1009.8.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.8-atomic-2",
