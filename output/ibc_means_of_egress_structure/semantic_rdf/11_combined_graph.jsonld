      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Transitions between stairways and stepped aisles shall comply with Section 1030.10."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.2.2.2-atomic-7",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
