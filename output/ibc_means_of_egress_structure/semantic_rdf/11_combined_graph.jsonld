      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Spiral stairways complying with Section 1011.10 are permitted a 78-inch (1981 mm) headroom clearance."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.12.1-atomic-2",
