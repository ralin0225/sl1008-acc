      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Decks, patios and walkways that have a single change in elevation where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails."
      }
    ]
  },
