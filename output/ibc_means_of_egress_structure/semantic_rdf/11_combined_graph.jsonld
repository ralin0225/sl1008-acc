      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors serving nonaccessible single-user shower or sauna compartments, toilet stalls or dressing, fitting or changing rooms shall have a minimum clear opening width of 20 inches (508 mm). "
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.4-atomic-2",
