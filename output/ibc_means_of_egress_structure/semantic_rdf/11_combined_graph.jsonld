    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.3.1 Exit access stairways. Exit access stairways that connect levels in the same story are not permitted as part of an accessible means of egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.2-atomic-2",
