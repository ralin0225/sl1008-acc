    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Exit access stairways and ramps within an atrium complying with the provisions of Section 404."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1133-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
