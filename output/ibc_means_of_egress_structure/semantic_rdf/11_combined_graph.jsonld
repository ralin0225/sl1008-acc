      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The ladder or steps required by Section 1031.5.2 shall be permitted to encroach not more than 6 inches (152 mm) into the required dimensions of the area well."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0860-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
