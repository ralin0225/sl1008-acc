        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Tread depths shall be not less than 11 inches (279 mm) and shall have dimensional uniformity."
      }
    ]
  },
