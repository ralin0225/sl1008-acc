    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.12.2 Outdoor conditions. Outdoor aisles, stepped aisles and ramped aisles and outdoor approaches to aisles, stepped aisles and ramped aisles shall be designed so that water will not accumulate on the walking surface."
      }
    ]
  },
