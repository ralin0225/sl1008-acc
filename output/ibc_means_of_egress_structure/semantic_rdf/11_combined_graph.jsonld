    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2.2.6 Groups R-3 and R-4. Where Group R-3 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with Section 903.3.1.3, the exit access travel distance for Group R-3 shall be not more than 125 feet (38 100 mm). Where Group R-4 occupancies are permitted by Section 903.2.8 to be protected by an automatic sprinkler system installed in accordance with SPACES WITH ONE EXIT OR EXIT ACCESS DOORWAY For SI: 1 foot = 304.8 mm. NP = Not Permitted."
      }
    ]
  },
