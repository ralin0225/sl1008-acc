    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.5.2 Security access turnstiles. Security access turnstiles that inhibit travel in the direction of egress utilizing a physical barrier shall be permitted to be considered as a component of the means of egress, provided that all of the following criteria are met:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.2.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017."
      }
    ]
  },
  {
