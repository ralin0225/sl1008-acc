      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Emergency lighting facilities shall be arranged to provide initial illumination that is not less than an average of 1 footcandle (11 lux) and a minimum at any point of 0.1 footcandle (1 lux) measured along the path of egress at floor level."
      }
    ]
  },
  {
