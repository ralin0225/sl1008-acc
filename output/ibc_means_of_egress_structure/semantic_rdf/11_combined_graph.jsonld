    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1007.1.1.1 Measurement point. The separation distance required in Section 1007.1.1 shall be measured in accordance with the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-elevator-hoistway-openings",
