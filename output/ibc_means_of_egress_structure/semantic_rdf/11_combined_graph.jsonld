    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0126",
