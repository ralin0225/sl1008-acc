    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where located within the building, such equipment and ductwork shall be separated from the remainder of the building, including other mechanical equipment, with construction as required for shafts."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0082-atomic-1",
    "@type": [
