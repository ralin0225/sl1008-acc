      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Egress shall not pass through kitchens, storage rooms, closets or spaces used for similar purposes."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0885-atomic-1",
