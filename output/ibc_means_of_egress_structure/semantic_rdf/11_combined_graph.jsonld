    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. In Group I-3 facilities, stairways providing access to guard towers, observation stations and control rooms, not more than 250 square feet (23 m2) in area, shall be permitted to have a maximum riser height of 8 inches (203 mm) and a minimum tread depth of 9 inches (229 mm)."
      }
