    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.4 Slip-resistant surface. Circulation paths of the means of egress shall have a slip-resistant surface and be securely attached."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4.1-atomic-2",
