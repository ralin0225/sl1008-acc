        "@value": "[46.777, 473.663, 289.781, 517.676]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0708"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Opening limitations"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1015.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0708"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 333
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.4 Opening limitations. Required guards shall not have openings that allow passage of a sphere 4 inches (102 mm) in diameter from the walking surface to the required guard height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0703-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, where the top of the guard serves as a handrail on the open sides of stairs, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1031.5.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Area wells with a vertical depth of more than 44 inches (1118 mm) shall be equipped with an approved permanently affixed ladder or steps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0660-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where handrail fittings or bendings are used to provide continuous transition between flights, the fittings or bendings shall be permitted to exceed the maximum height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
