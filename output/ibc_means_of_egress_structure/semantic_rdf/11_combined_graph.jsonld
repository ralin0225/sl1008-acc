        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The occupant load factor for concentrated business use shall be applied to telephone call centers, trading floors, electronic data processing centers and similar business use areas with a higher density of occupants than would normally be expected in a typical business occupancy environment."
      }
    ]
  },
