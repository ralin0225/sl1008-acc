      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Exit access stairways and ramps in open parking garages that serve only the parking garage."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1027.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[61.199, 532.684, 304.306, 631.774]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Open side"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1027.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1027"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1027.4"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 344
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1027.3 Open side. Exterior exit stairways and ramps serving as an element of a required means of egress shall be open on not less than one side, except for required structural columns, beams, handrails and guards. An open side shall have not less than 35 square feet (3.3 m2) of aggregate open area adjacent to each floor level and the level of each intermediate landing. The required open area shall be located not less than 42 inches (1067 mm) above the adjacent floor or landing level."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1008.2.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.197, 596.659, 304.224, 673.659]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Group I-2"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1008.2.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1008.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
