      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7.1-measurement-1"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "numerical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.7.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.7.1 Stairway walking surface. The walking surface of treads and landings of a stairway shall not be sloped steeper than one unit vertical in 48 units horizontal (2percent slope) in any direction. Stairway treads and landings shall have a solid surface. Finish floor surfaces shall be securely attached."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.8-atomic-5",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1003.3",
