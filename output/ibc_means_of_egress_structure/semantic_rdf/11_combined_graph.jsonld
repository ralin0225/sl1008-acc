        "@value": "equal_or_context_dependent"
      }
    ],
    "https://example.org/ibc/ontology/unitCode": [
      {
        "@value": "FT"
      }
    ],
    "https://example.org/ibc/ontology/value": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "100.0"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-accessibleroute",
