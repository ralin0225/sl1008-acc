      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 335
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In smoke protected seating and open air assembly seating, exit access travel distance shall be measured in accordance with Section 1030.7."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0300-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.3.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
