    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Roofs and penthouses containing elevator equipment that must be accessed for maintenance are required to be accessed by a stairway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1021.2",
