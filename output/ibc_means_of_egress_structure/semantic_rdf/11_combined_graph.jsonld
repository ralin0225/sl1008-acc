    "https://example.org/ibc/ontology/text": [
      {
        "@value": "other than stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0437-atomic-1",
