        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group E occupancies, Group B educational occupancies and Group I-4 occupancies, egress doors from classrooms, offices and other occupied rooms with locking arrangements designed to keep intruders from entering the room shall comply with all of the following conditions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0592-measurement-4",
