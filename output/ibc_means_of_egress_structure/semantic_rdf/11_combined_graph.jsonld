      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. For smoke-protected or open-air assembly seating, the dead-end aisle length of vertical aisles shall not exceed a distance of 21 rows."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.5-atomic-2",
