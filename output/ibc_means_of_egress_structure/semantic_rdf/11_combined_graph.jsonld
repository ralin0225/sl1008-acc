    "https://example.org/ibc/ontology/text": [
      {
        "@value": "7. Structural elements supporting the interior exit stairway or ramp or enclosure, such as beams or joists. Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communication openings, whether protected or not, between adjacent interior exit stairways and ramps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0721-condition-1",
