      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Forty-eight inches (1219 mm) for stepped aisles having seating on both sides."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0435-atomic-1",
