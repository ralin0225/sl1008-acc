      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.3.1 Headroom. Protruding objects are permitted to extend below the minimum ceiling height required by Section 1003.2 where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways. Not more than 50 percent of the ceiling area of a means of egress shall be reduced in height by protruding objects."
      }
    ]
  },
