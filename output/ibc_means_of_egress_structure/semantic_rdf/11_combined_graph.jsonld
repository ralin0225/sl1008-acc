      {
        "@value": "6. Two-way communication systems are not required in Group I-2 or I-3 facilities."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.8-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
