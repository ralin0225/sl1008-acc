      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.2 Slope. Ramps used as part of a means of egress shall have a running slope not steeper than 1 unit vertical in 12 units horizontal (8.3-percent slope). The slope of other pedestrian ramps shall not be steeper than 1 unit vertical in 8 units horizontal (12.5-percent slope)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0817-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
