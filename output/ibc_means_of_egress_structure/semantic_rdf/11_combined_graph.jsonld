        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In assembly areas with ramped aisles or stepped aisles, one accessible means of egress is permitted where the common path of egress travel is accessible and meets the requirements in Section 1030.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4.1-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The distinctive marking stripe shall be visible in descent of the stair and shall have a slipresistant surface."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1006.2.2.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
