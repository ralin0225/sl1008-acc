      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Operable windows where the top of the sill of the opening is located more than 75 feet (22 860 mm) above the finished grade or other surface below and that are provided with window fall prevention devices that comply with ASTM F2006."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.3.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.15-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
