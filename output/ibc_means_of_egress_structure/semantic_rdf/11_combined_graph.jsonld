    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.3.1.1 Egress component. A revolving door used as a component of a means of egress shall comply with Section 1010.3.1 and the following three conditions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
