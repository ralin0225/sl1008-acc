      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": ""
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0421-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the combined delay does not exceed 30 seconds."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1031.5.2.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[85.187, 460.733, 304.214, 515.782]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Steps"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1031.5.2.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1031.5.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1031.5.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 354
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.5.2.2 Steps. Steps shall have an inside width of not less than 12 inches (305 mm), shall have treads greater than 5 inches (127 mm) in depth and a riser height not greater than 18 inches (457 mm) for the full height of the area well."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1009.8.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.779, 537.745, 289.888, 647.734]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "System requirements"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1009.8.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.8"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.8.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 315
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.8.1 System requirements. Two-way communication systems shall provide communication between each required location and the fire command center or a central control point location approved by the fire department. Where the central control point is not a constantly attended location, the two-way communication system shall have timed, automatic telephone dial-out capability that provides two-way communication with an approved supervising station or 9-1-1. The two-way communication system shall include both audible and visible signals."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0954-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Horizontal exits are permitted to comprise 100 percent of the exits required for occupancies in Group I-3."
      }
    ]
  },
  {
