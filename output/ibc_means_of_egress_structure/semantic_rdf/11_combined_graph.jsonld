    "https://example.org/ibc/ontology/text": [
      {
        "@value": "c. This table is used for R-2 occupancies consisting of sleeping units. For R-2 occupancies consisting of dwelling units, use Table 1006.3.4(1)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.6-atomic-3",
