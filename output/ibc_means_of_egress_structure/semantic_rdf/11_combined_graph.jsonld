        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Revolving doors shall not be given credit for more than 50 percent of the minimum width or required capacity."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1018.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[61.198, 239.722, 304.201, 283.735]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0772"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Aisles in Groups B and M"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1018.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1018"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
