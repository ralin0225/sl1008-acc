    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0797",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[70.811, 195.699, 289.808, 283.735]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0796"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0798"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 337
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. A fire-resistance rating is not required for corridors in an occupancy in Group E where each room that is used for instruction has not less than one door opening directly to the exterior and rooms for assembly purposes have not less than one-half of the required means of egress doors opening directly to the exterior. Exterior doors specified in this exception are required to be at ground level."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0509",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.8, 438.872, 289.723, 460.814]"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 325
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Within rooms or spaces used for assembly purposes, stepped aisles shall comply with Section 1030."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0362-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.1-measurement-3",
