      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Such fire safety and evacuation plans shall comply with the applicable provisions of Sections 401.2 and 404 of the International Fire Code."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1053-atomic-2",
