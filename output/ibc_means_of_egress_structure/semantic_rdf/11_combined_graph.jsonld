    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[319.801, 539.739, 550.907, 627.776]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Intervening spaces or accessory areas"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1004.2.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004.2.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 305
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.2.1 Intervening spaces or accessory areas. Where occupants egress from one or more rooms, areas or spaces through others, the design occupant load shall be the combined occupant load of interconnected accessory or intervening spaces. Design of egress path capacity shall be based on the cumulative portion of occupant loads of all rooms, areas or spaces to that point along the path of egress travel."
      }
    ]
  },
  {
