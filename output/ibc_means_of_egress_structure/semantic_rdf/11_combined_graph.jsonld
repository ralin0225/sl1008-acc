    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.6 Mechanical equipment, systems and devices. Guards shall be provided where various components that require service are located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of such components. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter."
      }
    ]
  },
