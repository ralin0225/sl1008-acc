        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where door hardware operates by rotation, the operational force to unlatch the door shall not exceed 28 inch-pounds (315 N-cm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.7.4",
