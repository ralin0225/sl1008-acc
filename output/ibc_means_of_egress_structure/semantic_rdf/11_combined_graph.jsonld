      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The leading edge of landings shall be marked with a stripe consistent with the dimensional requirements for steps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1028.5-atomic-1",
