      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to use the riser/tread dimension in Section 1030.14.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.3-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the line intersects the landing below, one tread depth beyond the bottom riser."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.2-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In a building, room or space used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity."
      }
    ]
  },
  {
