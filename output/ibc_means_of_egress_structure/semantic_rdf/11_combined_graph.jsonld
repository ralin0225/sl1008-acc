    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.3.1 Stairways. The capacity, in inches, of means of egress stairways shall be calculated by multiplying the occupant load served by such stairways by a means of egress capacity factor of 0.3 inch (7.6 mm) per occupant. Where stairways serve more than one story, only the occupant load of each story considered individually shall be used in calculating the required capacity of the stairways serving that story."
      }
    ]
  },
