    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. A sign shall be provided on the door and shall be located above and within 12 inches (305 mm) of the door exit hardware:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.6-atomic-3",
