      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Decks, patios and walkways that have a single change in elevation where the landing depth on each side of the change of elevation is greater than what is required for a landing do not require handrails."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0409",
