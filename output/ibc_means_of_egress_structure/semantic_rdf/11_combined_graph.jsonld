      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A stairway that connects a stepped aisle to a cross aisle or concourse shall be permitted to comply with the assembly aisle walking surface requirements of Section 1030.14."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.3.2-measurement-6",
