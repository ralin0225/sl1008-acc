        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The demarcation lines shall continue across the floor in front of all doors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0994-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
