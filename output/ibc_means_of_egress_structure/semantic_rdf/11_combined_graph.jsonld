      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Two-way communication systems are not required at the landing serving a private residence elevator."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0226-atomic-1",
