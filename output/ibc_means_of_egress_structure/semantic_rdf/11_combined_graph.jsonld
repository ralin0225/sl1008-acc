      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.3.3 Area of refuge. Stairways shall either incorporate an area of refuge within an enlarged floor-level landing or shall be accessed from an area of refuge complying with Section 1009.6."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.6.2.2-measurement-1",
    "@type": [
      "https://example.org/ibc/ontology/Measurement"
