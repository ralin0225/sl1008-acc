      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "categorical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0400"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. The sensor shall be installed on the egress side, arranged to detect an occupant approaching the doors, and shall cause the electric locking system to unlock."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.11",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
