      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In order to be considered part of an accessible means of egress, an elevator shall comply with Sections 1009.4.1 and 1009.4.2."
      }
    ]
  },
  {
