      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Aisle accessways for seating at tables shall comply with Section 1030.13.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.1",
