    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards."
      }
