      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. The delay electronics of the delayed egress locking system shall deactivate upon loss of power controlling the lock or lock mechanism, allowing immediate free egress."
      }
    ]
  },
