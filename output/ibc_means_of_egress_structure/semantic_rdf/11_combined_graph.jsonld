      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: A roof canopy in an outdoor stadium shall be permitted to be less than 15 feet (4572 mm) above the highest aisle or aisle accessway provided that there are no objects less than 80 inches (2032 mm) above the highest aisle or aisle accessway."
      }
    ]
  },
