        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Seats intended for musicians or other performers and separated by railings, guards, partial height walls or similar barriers shall not be required to be fastened to the floor."
      }
    ]
  },
