  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0363-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Guards shall be located along open-sided walking surfaces, including mezzanines, equipment platforms, aisles, stairs, ramps and landings that are located more than 30 inches (762 mm) measured vertically to the floor or grade below at any point within 36 inches (914 mm) horizontally to the edge of the open side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A solid and continuous stripe shall be applied to the horizontal leading edge of each step and shall extend for the full length of the step."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-the-exterior-area-for-assisted-rescue",
