      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Locks used only for security purposes and not used for normal operation are permitted at any height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.9.7-atomic-2",
