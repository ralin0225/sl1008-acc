    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8.4. A clear window or glazed door opening, not less than 5 square feet (0.46 m2) in area, shall be provided at each exit access door to determine if there are occupants using the outdoor area."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The walkline across winder treads shall be concentric to the direction of travel through the turn and located 12 inches (305 mm) from the side where the winders are narrower."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4",
