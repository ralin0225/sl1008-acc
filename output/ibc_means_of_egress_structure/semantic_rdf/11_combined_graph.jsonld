    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.15 Locking arrangements in buildings within correctional facilities. In buildings within correctional and detention facilities, doors in means of egress serving rooms or spaces occupied by persons whose movements are controlled for security reasons shall be permitted to be locked where equipped with egress control devices that shall unlock manually and by not less than one of the following means:"
      }
    ]
  },
