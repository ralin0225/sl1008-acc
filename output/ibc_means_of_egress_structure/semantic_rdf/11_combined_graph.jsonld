      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Areas of refuge are not required at stairways in buildings equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1002.2-atomic-2",
