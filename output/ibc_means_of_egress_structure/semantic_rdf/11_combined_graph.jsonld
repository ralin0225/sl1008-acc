      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exits shall be continuous from the point of entry into the exit to the exit discharge."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0308-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "At exterior doors serving Groups F, H, R-2 and S and where such doors are not part of an accessible route, the landing at an exterior door shall not be more than 7 inches (178 mm) below the landing on the egress side of the door, provided that the door, other than an exterior storm or screen door, does not swing over the landing."
      }
    ]
  },
  {
