    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Horizontal exits are permitted to comprise 100 percent of the exits required for occupancies in Group I-3. Not less than 6 square feet (0.6 m2) of accessible space per occupant shall be provided on each side of the horizontal exit for the total number of people in adjoining compartments."
      }
    ]
  },
