    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Each revolving door shall have a side-hinged swinging door that complies with Section 1010.1 in the same wall and within 10 feet (3048 mm) of the revolving door."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1016.1-atomic-2",
