      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The greatest winder tread depth at the walkline within any flight of stairs shall not exceed the smallest by more than 3/8 inch (9.5 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1008.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
