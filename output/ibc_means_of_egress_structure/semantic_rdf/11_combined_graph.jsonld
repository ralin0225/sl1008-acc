      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. The force required to operate the door shall not exceed 30 pounds (133 N) to set the door in motion and 15 pounds (67 N) to close the door or open it to the minimum required width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0234",
