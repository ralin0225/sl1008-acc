      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum horizontal area of the area well shall be 9 square feet (0.84 m2), with a horizontal projection and width of not less than 36 inches (914 mm)."
      }
    ]
  },
