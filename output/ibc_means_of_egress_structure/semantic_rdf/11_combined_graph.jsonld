      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each area of refuge shall be separated from the remainder of the story by a smoke barrier complying with Section 709 or a horizontal exit complying with Section 1026."
      }
    ]
  },
