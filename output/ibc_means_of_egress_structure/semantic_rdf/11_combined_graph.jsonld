      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 317
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.1.5 Landings at doors. Landings shall have a width not less than the width of the stairway or the door, whichever is greater. Doors in the fully open position shall not reduce a required dimension by more than 7 inches (178 mm). Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width. Landings shall have a length measured in the direction of travel of not less than 44 inches (1118 mm)."
      }
    ]
  },
