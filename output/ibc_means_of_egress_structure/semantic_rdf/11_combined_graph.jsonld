      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The installation of the emergency power system shall be in accordance with Section 2702."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1007-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
