        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 312
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.1 Means of egress illumination. Illumination shall be provided in the means of egress in accordance with Section 1008.2. Under emergency power, means of egress illumination shall comply with Section 1008.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
