        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Alternating tread devices used as a means of egress shall not have a rise greater than 20 feet (6096 mm) between floor levels or landings."
      }
    ]
  },
