      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "categorical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0161"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Steps, landings and the sides of ramps shall be permitted to be marked with self-luminous materials in accordance with Sections 1025.2.1, 1025.2.2 and 1025.2.4 by systems listed in accordance with UL 1994."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0962",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[85.196, 253.754, 304.246, 330.755]"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 344
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The adjoining compartment shall not be required to have a stairway or door leading directly outside, provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1009.6.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[334.191, 69.703, 565.327, 157.739]"
      },
      {
        "@value": "[73.199, 714.832, 304.142, 736.774]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Size"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1009.6.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.6"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.6.4"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 314
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.6.3 Size. Each area of refuge shall be sized to accommodate one wheelchair space of 30 inches by 52 inches (762 mm by 1320 mm) for each 200 occupants or portion thereof, based on the occupant load of the area of refuge and areas served by the area of refuge. Such wheelchair spaces shall not reduce the means of egress minimum width or required capacity. Access to any of the required wheelchair spaces in an area of refuge shall not be obstructed by more than one adjoining wheelchair space."
      }
    ]
  },
  {
