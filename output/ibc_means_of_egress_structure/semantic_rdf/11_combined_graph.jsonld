      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Main exterior exit doors or gates that are obviously and clearly identifiable as exits need not have exit signs where approved by the building official."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0937-atomic-1",
