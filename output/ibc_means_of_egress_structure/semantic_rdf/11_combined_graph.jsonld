      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.13"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.13 Delayed egress. Delayed egress locking systems shall be permitted to be installed on doors serving the following occupancies in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke or heat detection system installed in accordance with Section 907."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.1-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Once a given level of exit protection is achieved, such level of protection shall not be reduced until arrival at the exit discharge."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0375",
