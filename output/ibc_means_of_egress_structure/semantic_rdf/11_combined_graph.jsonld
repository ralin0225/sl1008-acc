        "@value": 327
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The radius restriction shall not apply to curved stairways in Group R-3 and within individual dwelling units in Group R-2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
