    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[61.209, 209.723, 304.229, 319.711]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0047"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004.5.1"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Areas without fixed seating"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1004.5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0047"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 306
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.5 Areas without fixed seating. The number of occupants shall be computed at the rate of one occupant per unit of area as prescribed in Table 1004.5. For areas without fixed seating, the occupant load shall be not less than that number determined by dividing the floor area under consideration by the occupant load factor assigned to the function of the space as set forth in Table 1004.5. Where an intended function is not listed in Table 1004.5, the building official shall establish a function based on a listed function that most nearly resembles the intended function."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0857",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.802, 473.663, 289.935, 539.854]"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.3"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.3.1"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 339
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: A combination of interior exit stairways, interior exit ramps and exit passageways, constructed in accordance with Sections 1023.2, 1023.3.1 and 1024, respectively, and forming a continuous protected enclosure, shall be permitted to extend an interior exit stairway or ramp to the exit discharge or a public way."
      }
    ]
  },
  {
