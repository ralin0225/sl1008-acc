    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.4 Gates. Gates serving the means of egress system shall comply with the requirements of this section. Gates used as a component in a means of egress shall conform to the applicable requirements for doors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0701",
