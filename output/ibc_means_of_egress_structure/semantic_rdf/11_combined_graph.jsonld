    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2 Egress from spaces. Rooms, areas or spaces, including mezzanines, within a story or basement shall be provided with the number of exits or access to exits in accordance with this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1020.6.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
