      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Where panic or fire exit hardware is required by Section 1010.2.9, operation of the panic or fire exit hardware also releases the electric lock."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0799",
