    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the exit or exit access door is less than 25 feet (7620 mm) from the equipment working space as required by NFPA 70, such doors shall not be provided with a latch or lock other than panic hardware or fire exit hardware."
      }
    ]
  },
  {
