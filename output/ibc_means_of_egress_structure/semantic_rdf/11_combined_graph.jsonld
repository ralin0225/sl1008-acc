      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "numerical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0160"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Externally illuminated walking surfaces shall be permitted to be illuminated to not less than 0.2 footcandle (2.15 lux)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.3.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[319.809, 117.619, 550.939, 326.689]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0467"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Power-operated doors"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.3.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.3"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0467"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 323
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.3.2 Power-operated doors. Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress. The forces required to open these doors manually shall not exceed those specified in Section 1010.1.3, except that the force to set the door in motion shall not exceed 50 pounds (220 N). The door shall be capable of opening from any position to the full width of the opening in which such door is installed when a force is applied to the door on the side from which egress is made. Power-operated swinging doors, power-operated sliding doors and power-operated folding doors shall comply with BHMA A156.10. Power-assisted swinging doors and low-energy power-operated swinging doors shall comply with BHMA A156.19. Low-energy poweroperated sliding doors and low-energy power-operated folding doors shall comply with BHMA A156.38."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0757",
