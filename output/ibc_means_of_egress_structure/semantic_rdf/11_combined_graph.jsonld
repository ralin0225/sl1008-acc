      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For doors that swing in the direction of egress, the sign shall read, \"PUSH UNTIL ALARM SOUNDS."
      }
    ]
  },
  {
