    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1020.3 Width and capacity. The required capacity of corridors shall be determined as specified in Section 1005.1, but the minimum width shall be not less than that specified in Table 1020.3."
      }
    ]
  },
