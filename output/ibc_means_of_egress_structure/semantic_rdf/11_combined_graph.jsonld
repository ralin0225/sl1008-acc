      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "e. The common path of egress travel distance shall only apply in a Group R-3 occupancy located in a mixed occupancy building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1024.8-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
