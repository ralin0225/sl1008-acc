      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. The fire barrier separating the smokeproof enclosure from the exit passageway is not required, provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0453-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "An emergency stop switch shall be provided near each entry point of power or automatic operated revolving doors within 48 inches (1219 mm) of the door and between 34 inches (864 mm) and 48 inches (1219 mm) above the floor."
      }
    ]
  },
  {
