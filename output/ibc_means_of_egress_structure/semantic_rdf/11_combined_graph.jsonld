        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Panic hardware is not required on gates surrounding stadiums where such gates are under constant immediate supervision while the public is present, and where safe dispersal areas based on 3 square feet (0.28 m2) per occupant are located between the fence and enclosed space."
      }
    ]
  },
