    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates."
      }
    ]
  },
