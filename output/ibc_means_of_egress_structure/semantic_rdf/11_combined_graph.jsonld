      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.13.2.1 Dual access. For rows of seating served by aisles or doorways at both ends, there shall be not more than 100 seats per row. The minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.3 inch (7.6 mm) for every additional seat beyond 14 seats where seats have backrests or beyond 21 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)."
      }
    ]
  },
