    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030."
      }
    ]
  },
