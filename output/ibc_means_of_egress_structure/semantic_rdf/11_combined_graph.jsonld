        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.6.2",
