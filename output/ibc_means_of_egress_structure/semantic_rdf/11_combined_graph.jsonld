      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 340
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.10 Elevator lobby identification signs. At landings in interior exit stairways where two or more doors lead to the floor level, any door with direct access to an enclosed elevator lobby shall be identified by signage located on the door or directly adjacent to the door stating “Elevator Lobby.” Signage shall be in accordance with Section 1023.9.1, Items 4, 5 and 6."
      }
    ]
  },
