    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0517-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
