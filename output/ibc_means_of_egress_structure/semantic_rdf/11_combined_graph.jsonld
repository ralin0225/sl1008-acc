      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Other buildings on the same lot unless the adjacent building exterior walls and openings are protected in accordance with Section 705 based on fire separation distance. For the purposes of this section, other portions of the building shall be treated as separate buildings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1005.4",
