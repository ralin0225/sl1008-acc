    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In smoke protected seating and open air assembly seating, exit access travel distance shall be measured in accordance with Section 1030.7."
      }
    ]
  },
