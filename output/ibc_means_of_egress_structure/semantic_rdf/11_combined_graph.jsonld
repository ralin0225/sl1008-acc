    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Permanent ladders shall not serve as a part of the means of egress from occupied spaces within a building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1003.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
