      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Areas of refuge are not required at the elevator in open parking garages."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0518",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
