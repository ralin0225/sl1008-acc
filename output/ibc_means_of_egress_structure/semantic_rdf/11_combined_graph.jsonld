    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.9.5 Dead-end aisles. Each end of an aisle shall be continuous to a cross aisle, foyer, doorway, vomitory, concourse or stairway in accordance with Section 1030.9.7 having access to an exit."
      }
    ]
  },
