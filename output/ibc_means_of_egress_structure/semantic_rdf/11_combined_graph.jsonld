        "@id": "https://example.org/ibc/2021/ibc2021-1028"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 345
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. In Group R-3 occupancies not more than four stories in height, exterior exit stairways and ramps serving individual dwelling units are not required to be separated from the interior of the building where the exterior exit stairway or ramp discharges directly to grade."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1007.1.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[319.781, 663.713, 550.905, 718.778]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1007.1.3.1"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1007.1.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1007.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1007.1.3.1"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 311
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1007.1.3 Remoteness of exit access stairways or ramps. Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0772-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Nonpublic aisles serving less than 50 people and not required to be accessible by Chapter 11 need not exceed 28 inches (711 mm) in width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
