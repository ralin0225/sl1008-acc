      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.1 Design occupant load. In determining means of egress requirements, the number of occupants for whom means of egress facilities are provided shall be determined in accordance with this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0598",
