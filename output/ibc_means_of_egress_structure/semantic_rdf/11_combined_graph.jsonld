    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.3.1 Type I. Handrails with a circular cross section shall have an outside diameter of not less than 11/4 inches (32 mm) and not greater than 2 inches (51 mm). Where the handrail is not circular, it shall have a perimeter dimension of not less than 4 inches (102 mm) and not greater than 61/4 inches (160 mm) with a maximum crosssectional dimension of 21/4 inches (57 mm) and minimum cross-sectional dimension of 1 inch (25 mm). Edges shall have a minimum radius of 0.01 inch (0.25 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0796-atomic-1",
