      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Mid-aisle handrails shall be permitted to extend beyond the lowest riser where the handrail extensions do not obstruct the width of the cross aisle."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0914-atomic-1",
