      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Items 1 through 4 shall not apply to doors to areas occupied by persons who, because of clinical needs, require restraint or containment as part of the function of a psychiatric or cognitive treatment area."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.1.1-atomic-2",
