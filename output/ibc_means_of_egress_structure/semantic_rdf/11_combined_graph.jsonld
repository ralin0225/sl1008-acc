      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. The door assembly shall comply with the applicable fire protection rating and, where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716.2.6.6, shall be installed in accordance with NFPA 80 and shall comply with Section 716."
      }
    ]
  },
  {
