      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.6 Closet doors. Closet doors that latch in the closed position shall be openable from inside the closet."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0452-atomic-3",
