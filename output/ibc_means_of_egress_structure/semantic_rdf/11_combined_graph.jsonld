    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.6.1-atomic-2",
