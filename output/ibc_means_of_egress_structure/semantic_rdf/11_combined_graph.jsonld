        "@value": 327
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.8 Vertical rise. A flight of stairs shall not have a vertical rise greater than 12 feet (3658 mm) between floor levels or landings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1025",
