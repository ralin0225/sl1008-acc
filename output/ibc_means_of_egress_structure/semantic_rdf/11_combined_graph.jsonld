    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The adjoining compartment shall not be required to have a stairway or door leading directly outside, provided that the refuge area into which a horizontal exit leads has stairways or doors leading directly outside and are so arranged that egress shall not require the occupants to return through the compartment from which egress originates."
      }
    ]
  },
  {
