    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.1 Where required. Handrails serving flights of stairways, ramps, stepped aisles and ramped aisles shall be adequate in strength and attachment in accordance with Section 1607.9. Handrails required for flights of stairways by Section 1011.11 shall comply with Sections 1014.2 through 1014.9. Handrails required for ramps by Section 1012.8 shall comply with Sections 1014.2 through 1014.8. Handrails for stepped aisles and ramped aisles required by Section 1030.16 shall comply with Sections 1014.2 through 1014.8."
      }
    ]
  },
