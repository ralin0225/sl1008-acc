      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. A depth of not less than 22 inches (559 mm) where the treads on the descending side of the transition have greater depth."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1045-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
