        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 319
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Stairway discharge doors shall be openable from the egress side and shall only be locked from the opposite side."
      }
    ]
  },
