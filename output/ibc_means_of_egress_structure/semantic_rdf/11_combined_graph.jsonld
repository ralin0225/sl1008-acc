    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.3.1.2 Other than egress component. A revolving door used as other than a component of a means of egress shall comply with Section 1010.3.1. The breakout force of a revolving door not used as a component of a means of egress shall not be more than 180 pounds (801 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.14.2.4",
