      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the self-latching devices are not also self-locking devices operated by means of a key, electronic opener or integral combination lock."
      }
    ]
  },
