    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Platform lifts"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1009.5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.6"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 314
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.5 Platform lifts. Platform lifts shall be permitted to serve as part of an accessible means of egress where allowed as part of a required accessible route in Section 1110.9 except for Item 10. Standby power for the platform lift shall be provided in accordance with Chapter 27."
      }
    ]
  },
