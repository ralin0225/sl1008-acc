      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Projections are permitted in corridors within Group I-2, Condition 1 in accordance with Section 407.4.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0705-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
