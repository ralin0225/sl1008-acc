        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0952"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "General"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1026.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0952"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.1 General. Horizontal exits serving as an exit in a means of egress system shall comply with the requirements of this section. A horizontal exit shall not serve as the only exit from a portion of a building, and where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.5.1.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where located as part of an accessible route, turnstiles shall have not less than 36 inches (914 mm) clear width at and below a height of 34 inches (864 mm), not less than 32 inches (813 mm) clear width between 34 inches (864 mm) and 80 inches (2032 mm) and shall consist of a mechanism other than a revolving device."
      }
    ]
  },
