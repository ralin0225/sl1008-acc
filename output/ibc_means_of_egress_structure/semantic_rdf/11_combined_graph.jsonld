      }
    ],
    "https://example.org/ibc/ontology/value": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "12.0"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Interior exit stairways and ramps shall be enclosed and lead directly to the exterior of the building or shall be extended to the exterior of the building with an exit passageway conforming to the requirements of Section 1024, except as permitted in Section 1028.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1173-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Emergency escape and rescue openings are not required from basements or sleeping rooms that have an exit door or exit access door that opens directly into a public way or to a yard, court or exterior egress balcony that opens to a public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1031.5.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
