      }
    ],
    "https://example.org/ibc/ontology/confidence": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.93"
      }
    ],
    "https://example.org/ibc/ontology/hasAtomicRule": [
      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.2-atomic-1"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/references": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "rule_validated"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "topological"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1018.2"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1018.2 Aisles in assembly spaces. Aisles and aisle accessways serving a room or space used for assembly purposes shall comply with Section 1030."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1-atomic-5",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors, gates and turnstiles provided for egress purposes in numbers greater than required by this code shall comply with the requirements of this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1024.5-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Except as permitted in Section 402.8.7, openings in exit passageways other than unprotected exterior openings shall be limited to those necessary for exit access to the exit passageway from normally occupied spaces and for egress from the exit passageway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-luminous-egress-path-markings",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Luminous egress path markings"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0369-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.4-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Such materials shall include, but not be limited to, self-luminous materials and photoluminescent materials."
      }
    ]
  },
  {
