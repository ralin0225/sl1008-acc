      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. There is an actuation of a manual control switch, in an approved location and clearly identified, that reduces the breakout force to not more than 130 pounds (578 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1013.3",
