    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Other accessory use areas 1,000 square feet (92.9 m2) or less in area and equipped with an automatic sprinkler system in accordance with Section 903.3.1.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
