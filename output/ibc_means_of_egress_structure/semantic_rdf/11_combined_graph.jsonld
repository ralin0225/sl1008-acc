        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 352
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with 200 or fewer seats, the seats shall not be required to be fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.2-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
