      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Ship’s ladders shall have a minimum tread depth of 5 inches (127 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1027.2",
