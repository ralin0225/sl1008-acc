    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Other lettering and numbers shall be not less than 1 inch (25 mm) in height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1048-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the roof construction is more than 50 feet (15 240 mm) above the floor level and the use is restricted to low fire hazard uses."
      }
    ]
  },
