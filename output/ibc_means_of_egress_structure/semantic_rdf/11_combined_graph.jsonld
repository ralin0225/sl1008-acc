      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.1-atomic-1",
