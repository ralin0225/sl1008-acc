      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. At doors serving individual dwelling units or sleeping units in Groups R-2 and R-3 : a door is permitted to open at the top step of an interior flight of stairs, provided that the door does not swing over the top step."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1008.3.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
