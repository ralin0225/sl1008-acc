    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8. Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:"
      }
    ]
  },
  {
