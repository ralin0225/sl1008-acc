    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "topological"
      },
      {
        "@value": "numerical"
      },
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.2"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.2 Construction. Enclosures for interior exit stairways and ramps shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both. Interior exit stairway and ramp enclosures shall have a fire-resistance rating of not less than 2 hours where connecting four stories or more and not less than 1 hour where connecting less than four stories. The number of stories connected by the interior exit stairways or ramps shall include any basements, but not any mezzanines. Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0475-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The door shall be openable with a force not to exceed 15 pounds (67 N) when a force of 250 pounds (1100 N) is applied perpendicular to the door adjacent to the operating device."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0293-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies complying with Section 1010."
      }
    ]
  },
