    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Door closers and stops shall not reduce headroom to less than 78 inches (1981 mm). A barrier shall be provided where the vertical clearance above a circulation path is less than 80 inches (2032 mm) high above the finished floor. The leading edge of such a barrier shall be located 27 inches (686 mm) maximum above the finished floor."
      }
    ]
