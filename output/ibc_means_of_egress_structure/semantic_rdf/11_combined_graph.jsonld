    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.2.2 Group I-2. In Group I-2 occupancies where two or more exits are required, on the exterior landings required by Section 1010.1.5, means of egress illumination levels for the exit discharge shall be provided such that failure of a single lamp in a luminaire shall not reduce the illumination level on that landing to less than 1 footcandle (11 lux)."
      }
    ]
  },
