      {
        "@value": "Exception: Tactile signs required by Section 1013.4 need not be provided with illumination."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0451",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
