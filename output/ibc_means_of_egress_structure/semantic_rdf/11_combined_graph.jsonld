        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.10.1-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
