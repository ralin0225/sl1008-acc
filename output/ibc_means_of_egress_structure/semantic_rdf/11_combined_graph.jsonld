      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1.3. The door is not part of an Accessible unit, Type A unit or Type B unit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0340-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
