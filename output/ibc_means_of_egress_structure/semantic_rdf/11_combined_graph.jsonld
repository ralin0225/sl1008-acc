        "@value": 312
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Interior and exterior exit stairways and ramps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.13.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.5.2",
