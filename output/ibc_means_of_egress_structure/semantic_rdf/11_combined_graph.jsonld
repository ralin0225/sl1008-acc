      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Corridors adjacent to the exterior walls of buildings shall be permitted to have unprotected openings on unrated exterior walls where unrated walls are permitted by Table 705.5 and unprotected openings are permitted by Table 705.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0918-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
