      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Operable windows where the openings will not allow a 4-inch-diameter (102 mm) sphere to pass through the opening when the window is in its largest opened position."
      }
    ]
  },
  {
