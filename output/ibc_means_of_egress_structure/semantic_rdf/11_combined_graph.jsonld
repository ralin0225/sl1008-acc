      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum width of 1 inch (25 mm) shall not apply to outlining stripes listed in accordance with UL 1994."
      }
    ]
  },
