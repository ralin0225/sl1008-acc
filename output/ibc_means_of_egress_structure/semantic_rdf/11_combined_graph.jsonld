    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the path of egress travel includes intervening rooms, areas or spaces, cumulative occupant loads shall be determined in accordance with this section."
      }
    ]
  },
  {
