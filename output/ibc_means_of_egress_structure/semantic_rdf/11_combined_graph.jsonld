      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Courtrooms shall be permitted to be locked in accordance with Section 1010.2.13, Item 3. "
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.8-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
