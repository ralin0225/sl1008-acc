    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Facilities with smoke-protected assembly seating shall be permitted to use the capacity factors in Table 1030.6.2 indicated for stepped aisles for exit access or exit stairways where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section"
      }
    ]
  },
