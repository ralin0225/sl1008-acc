      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The open areas adjoining exterior exit stairways or ramps shall be either yards, courts or public ways; the remaining sides are permitted to be enclosed by the exterior walls of the building."
      }
    ]
  },
  {
