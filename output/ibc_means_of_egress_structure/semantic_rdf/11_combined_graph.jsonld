      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Areas of refuge are not required in buildings and facilities equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2."
      }
    ]
  },
