    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.2-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours."
      }
    ]
  },
