      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group R-2 occupancies where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006.3.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0496-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each secured physical barrier shall automatically retract or swing to an unobstructed open position in the direction of egress, under each of the following conditions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stair riser heights shall be 7 inches (178 mm) maximum and 4 inches (102 mm) minimum."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.16-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where two handrails are required, one of the handrails shall be within 30 inches (762 mm) horizontally of the stepped aisle."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4.1",
