        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 332
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.1 General. Guards shall comply with the provisions of Sections 1015.2 through 1015.7. Operable windows with sills located more than 72 inches (1829 mm) above finished grade or other surface below shall comply with Section 1015.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0403-measurement-3",
    "@type": [
      "https://example.org/ibc/ontology/Measurement"
    ],
    "https://example.org/ibc/ontology/operator": [
      {
        "@value": "equal_or_context_dependent"
      }
    ],
    "https://example.org/ibc/ontology/unitCode": [
      {
        "@value": "FT"
      }
    ],
    "https://example.org/ibc/ontology/value": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "5.0"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1029.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
