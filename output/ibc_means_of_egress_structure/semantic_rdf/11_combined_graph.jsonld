      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2.2.4 Electrical rooms. T he location and number of exit or exit access doorways shall be provided for electrical rooms in accordance with Section 110.26 of NFPA 70 for electrical equipment rated 1,000 volts or less, and Section 110.33 of NFPA 70 for electrical equipment rated over 1,000 volts. Panic hardware shall be provided where required in accordance with Section 1010.2.9.2. "
      }
    ]
  },
