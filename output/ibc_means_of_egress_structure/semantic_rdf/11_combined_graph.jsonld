    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.6 Ventilation. Equipment and ductwork for interior exit stairway and ramp ventilation as permitted by Section 1023.5 shall comply with one of the following items:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.2.1",
