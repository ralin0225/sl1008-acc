    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent."
      }
    ]
  },
