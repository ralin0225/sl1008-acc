      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 336
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Nonpublic aisles serving less than 50 people and not required to be accessible by Chapter 11 need not exceed 28 inches (711 mm) in width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0561",
