      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In areas of refuge and exterior areas for assisted rescue, instructions on the use of the area under emergency conditions shall be posted."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.5.2-atomic-1",
