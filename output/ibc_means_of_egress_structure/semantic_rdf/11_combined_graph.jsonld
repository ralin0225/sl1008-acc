    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.3.3 Special purpose horizontal sliding, accordion or folding doors. In other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010.1.2 shall comply with all of the following criteria:"
      }
