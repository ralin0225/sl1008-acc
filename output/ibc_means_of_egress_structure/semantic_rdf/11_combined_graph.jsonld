      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The clear width of aisles adjacent to seating at tables shall be permitted to be measured in accordance with Section 1030.13.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0362-atomic-2",
    "@type": [
