    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.15 Seat stability. In a building, room or space used for assembly purposes, the seats shall be securely fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9.4-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "If balanced doors are used and panic hardware is required, the panic hardware shall be the push-pad type and the pad shall not extend more than one-half the width of the door measured from the latch side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1163-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the backs of seats on the front of the cross aisle project 24 inches (610 mm) or more above the adjacent floor of the aisle, a guard need not be provided."
      }
    ]
  },
  {
