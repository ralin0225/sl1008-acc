        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors to walk-in freezers and coolers less than 1,000 square feet (93 m2) in area shall have a maximum width of 60 inches (1524 mm) nominal."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.16.4-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0350-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
