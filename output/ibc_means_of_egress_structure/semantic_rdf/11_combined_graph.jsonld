      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required capacity of egress courts shall be determined as specified in Section 1005.1, but the minimum width shall be not less than 44 inches (1118 mm), except as specified herein."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0244",
    "@type": [
      "https://example.org/ibc/ontology/Exception"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[346.181, 655.044, 565.194, 710.093]"
