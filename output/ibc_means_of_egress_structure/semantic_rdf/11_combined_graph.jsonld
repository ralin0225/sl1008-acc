      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716."
      }
    ]
  },
  {
