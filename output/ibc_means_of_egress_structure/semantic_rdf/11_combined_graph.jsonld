      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Riser heights not exceeding 9 inches (229 mm) shall be permitted where they are necessitated by the slope of the adjacent seating areas to maintain sightlines."
      }
    ]
  },
