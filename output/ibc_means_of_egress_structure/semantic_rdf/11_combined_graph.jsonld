    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.7 Travel distance. The exit access travel distance shall comply with Section 1017. Where aisles are provided for seating, the distance shall be measured along the aisles and aisle accessways without travel over or on the seats."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1025.2.6.2",
