      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. The portion of the building classified as Group F- 1 or S-1 is limited to one story in height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.7.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The sides other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.1-atomic-5",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum clear opening height of doors shall be not less than 80 inches (2032 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.8-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
