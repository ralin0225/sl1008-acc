      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group I-2, Condition 2 occupancies, the length of dead-end corridors that do not serve patient rooms or patient treatment spaces shall not exceed 30 feet (9144 mm)."
      }
    ]
  },
