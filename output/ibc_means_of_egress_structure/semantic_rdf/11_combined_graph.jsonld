      {
        "@value": "Illumination shall not be required where the path of the exit discharge meets both of the following requirements:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1026.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.814, 95.65, 550.838, 172.651]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
