        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 354
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.5.3 Drainage. Area wells shall be designed for proper drainage by connecting to the building’s foundation drainage system required by Section 1805."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1149-atomic-1",
