        "@value": 322
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. All clinical staff shall have the keys, codes or other means necessary to operate the locking systems."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.5",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
