        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Edge protection is not required on the sides of ramp landings serving an adjoining ramp run or stairway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0475",
