    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Refrigeration machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exit or exit access doorways that swing in the direction of egress travel and shall be equipped with panic hardware or fire exit hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0431-condition-3",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the doors are installed and operate in accordance with all of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.5",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.188, 660.693, 565.275, 726.659]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Interior balcony and gallery means of egress"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.6"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 346
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.5 Interior balcony and gallery means of egress. For balconies, galleries or press boxes having a seating capacity of 50 or more located in a building, room or space used for assembly purposes, not less than two means of egress shall be provided, with one from each side of every balcony, gallery or press box."
      }
    ]
  },
