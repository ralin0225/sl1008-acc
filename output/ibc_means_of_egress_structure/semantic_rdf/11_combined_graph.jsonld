      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.1 General. The number of exits or exit access doorways required within the means of egress system shall comply with the provisions of Section 1006.2 for spaces, including mezzanines, and Section 1006.3 for stories or occupied roofs."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0204-atomic-1",
