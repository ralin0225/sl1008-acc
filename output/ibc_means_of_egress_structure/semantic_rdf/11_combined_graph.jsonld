      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0433",
