      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: An interior area of refuge at the level of exit discharge that provides direct access to an exterior exit door."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1013.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[61.19, 435.795, 304.197, 567.735]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0640"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Where required"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1013.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0640"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.1 Where required. Exits and exit access doors shall be marked by an approved exit sign readily visible from any direction of egress travel. The path of egress travel to exits and within exits shall be marked by readily visible exit signs to clearly indicate the direction of egress travel in cases where the exit or the path of egress travel is not immediately visible to the occupants. Intervening means of egress doors within exits shall be marked by exit signs. Exit sign placement shall be such that any point in an exit access corridor or exit passageway is within 100 feet (30 480 mm) or the listed viewing distance of the sign, whichever is less, from the nearest visible exit sign."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.16.1-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0717-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Guards are not required where personal fall arrest anchorage connector devices that comply with ANSI/ASSE Z 359.1 are installed."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.166, 138.653, 565.15, 193.702]"
