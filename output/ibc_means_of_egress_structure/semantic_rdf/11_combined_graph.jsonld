      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For each 1/2 inch (12.7 mm) of additional handrail perimeter dimension above 4 inches (102 mm), the vertical clearance dimension of 11/2 inches (38 mm) shall be permitted to be reduced by 1/8 inch (3.2 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0954-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Not less than 6 square feet (0.6 m2) of accessible space per occupant shall be provided on each side of the horizontal exit for the total number of people in adjoining compartments."
      }
    ]
  },
  {
