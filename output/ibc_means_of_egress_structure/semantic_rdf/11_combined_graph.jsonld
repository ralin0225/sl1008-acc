      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Other than where required by Section 1011.12.1, in buildings without an occupied roof access to the roof from the top story shall be permitted to be by an alternating tread device, a ships ladder or a permanent ladder."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1029.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
