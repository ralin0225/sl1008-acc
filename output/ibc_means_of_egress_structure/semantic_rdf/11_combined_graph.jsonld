      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group R-3 occupancies not more than four stories in height, exterior exit stairways and ramps serving individual dwelling units are not required to be separated from the interior of the building where the exterior exit stairway or ramp discharges directly to grade."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0743-atomic-2",
