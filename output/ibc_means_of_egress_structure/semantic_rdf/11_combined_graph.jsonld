    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.17.4 Guards at the end of aisles. A fascia or railing system complying with the guard requirements of Section 1015 shall be provided for the full width of the aisle where the foot of the aisle is more than 30 inches (762 mm) above the floor or grade below. The fascia or railing shall be not less than 36 inches (914 mm) high and shall provide not less than 42 inches (1067 mm) measured diagonally between the top of the rail and the nosing of the nearest tread."
      }
    ]
  },
