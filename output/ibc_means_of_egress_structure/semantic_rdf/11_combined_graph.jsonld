        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The width of the handrail above the recess shall be not less than 11/4 inches (32 mm) to not greater than 23/4 inches (70 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0450-measurement-1",
