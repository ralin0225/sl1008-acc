    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts."
      }
    ]
