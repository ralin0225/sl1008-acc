      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.5.4 Additional door. Where serving an occupant load greater than 300, each turnstile that is not portable shall have a side-hinged swinging door that conforms to Section 1010.1 within 50 feet (15 240 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1003.3.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
