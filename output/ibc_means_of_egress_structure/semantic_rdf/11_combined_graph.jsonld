      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Outdoor aisles, stepped aisles and ramped aisles and outdoor approaches to aisles, stepped aisles and ramped aisles shall be designed so that water will not accumulate on the walking surface."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
