    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1019.1 General. Exit access stairways and ramps serving as an exit access component in a means of egress system shall comply with the requirements of this section. The number of stories connected by exit access stairways and ramps shall include basements, but not mezzanines."
      }
    ]
  },
