    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors from individual dwelling or sleeping units of Group R occupancies having an occupant load of 10 or less are permitted to be equipped with a night latch, dead bolt or security chain, provided such devices are openable from the inside without the use of a key or tool."
      }
    ]
  },
