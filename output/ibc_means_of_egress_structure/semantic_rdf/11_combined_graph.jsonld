        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1159"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Perimeter guards"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.17.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.17"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1159"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 352
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.17.1 Perimeter guards. Perimeter guards shall be provided where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below. Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard. Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface. Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015.3."
      }
    ]
  },
