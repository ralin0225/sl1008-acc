    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Raised character and braille exit signs"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1013.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.4 Raised character and braille exit signs. Where exit signs are provided at an area of refuge with direct access to a stairway, an exterior area for assisted rescue, an exit stairway or ramp, an exit passageway, a horizontal exit and the exit discharge, a sign stating \"EXIT\" in visual characters, raised characters and braille and complying with ICC A117.1 shall be provided."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.775, 275.401, 550.833, 363.438]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Walkline"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1011.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 325
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.4 Walkline. The walkline across winder treads shall be concentric to the direction of travel through the turn and located 12 inches (305 mm) from the side where the winders are narrower. The 12-inch (305 mm) dimension shall be measured from the widest point of the clear stair width at the walking surface of the winder. Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.14.2.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Nosing and riser profile shall comply with Sections 1011.5.5 through 1011.5.5.3."
      }
    ]
  },
  {
