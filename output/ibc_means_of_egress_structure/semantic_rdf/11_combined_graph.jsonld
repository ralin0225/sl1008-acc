      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For smoke-protected or open-air assembly seating there shall be not more than 40 seats between the two aisles and the minimum clear width shall be 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat."
      }
    ]
  },
  {
