      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The slope measured perpendicular to the direction of travel of a ramped aisle shall not be steeper than 1 unit vertical in 48 units horizontal (2-percent slope)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.9.7-atomic-1",
