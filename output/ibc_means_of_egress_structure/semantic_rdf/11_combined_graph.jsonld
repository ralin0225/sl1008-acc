      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrails for stepped aisles and ramped aisles required by Section 1030.16 shall comply with Sections 1014.2 through 1014.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1131-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the gradient of stepped aisles is to be the same as the gradient of adjoining seating areas, the riser height shall be not less than 4 inches (102 mm) nor more than 8 inches (203 mm) and shall be uniform within each flight."
      }
    ]
  },
