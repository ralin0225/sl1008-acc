        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0792"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Group I-2 and I-3 occupancies"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1019.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1019"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0792"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 336
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1019.4 Group I-2 and I-3 occupancies. In Group I-2 and I- 3 occupancies, floor openings between stories containing exit access stairways or ramps are required to be enclosed with a shaft enclosure constructed in accordance with Section 713."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0331-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where manually operated bolt locks are permitted by Section 1010."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.5-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For areas without fixed seating, the occupant load shall be not less than that number determined by dividing the floor area under consideration by the occupant load factor assigned to the function of the space as set forth in Table 1004.5."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1039-measurement-2",
