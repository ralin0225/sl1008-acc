      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Projections into the clear opening width between 34 inches (864 mm) and 80 inches (2032 mm) above the floor or ground shall not exceed 4 inches (102 mm)."
      }
    ]
  },
