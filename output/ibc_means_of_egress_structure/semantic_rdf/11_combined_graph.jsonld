      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.6 Capacity of aisle for assembly. The required capacity of aisles shall be not less than that determined in accordance with Section 1030.6.1 where smoke-protected assembly seating is not provided, Section 1030.6.2 where smoke-protected assembly seating is provided and Section 1030.6.3 where open-air assembly seating is provided."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0371-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the only interior access to the dwelling unit is from a single exit stairway where permitted in Section 1006."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.1-atomic-1",
