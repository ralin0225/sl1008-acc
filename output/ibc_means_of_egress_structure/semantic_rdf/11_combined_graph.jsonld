      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1020.1 General. Corridors serving as an exit access component in a means of egress system shall comply with the requirements of Sections 1020.2 through 1020.7."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0332",
