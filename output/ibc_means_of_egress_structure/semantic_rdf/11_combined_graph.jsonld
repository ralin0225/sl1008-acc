    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Where a pair of doors serves a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf provided that such inactive leaf is not needed to meet egress capacity requirements and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
  },
