      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 349
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.9.3 Converging aisles. Where aisles converge to form a single path of egress travel, the required capacity of that path shall be not less than the combined required capacity of the converging aisles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-aisles-and-aisle-accessways-serving-a-room-or-space-used-for-assembly-purposes",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Aisles and aisle accessways serving a room or space used for assembly purposes"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0280-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
