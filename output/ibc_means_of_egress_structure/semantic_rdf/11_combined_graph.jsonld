    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.12.1 Stairway to elevator equipment. Roofs and penthouses containing elevator equipment that must be accessed for maintenance are required to be accessed by a stairway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1014.9",
