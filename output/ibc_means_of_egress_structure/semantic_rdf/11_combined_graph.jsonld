      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exits and exit access doors shall be marked by an approved exit sign readily visible from any direction of egress travel."
      }
    ]
  },
