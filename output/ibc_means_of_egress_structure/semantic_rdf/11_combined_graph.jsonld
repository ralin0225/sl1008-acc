    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.3.2 Path of egress travel. The path of egress travel to an exit shall not pass through more than one adjacent story."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.11",
