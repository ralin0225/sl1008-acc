    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1022.2 Exterior exit doors. Buildings or structures used for human occupancy shall have not less than one exterior door that meets the requirements of Section 1010.1.1."
      }
    ]
  },
  {
