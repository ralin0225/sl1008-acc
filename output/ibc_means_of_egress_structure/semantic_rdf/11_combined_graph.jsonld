    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.3.2 Minimum dimensions. The minimum net clear opening height dimension shall be 24 inches (610 mm). The minimum net clear opening width dimension shall be 20 inches (508 mm). The net clear opening dimensions shall be the result of normal operation of the opening."
      }
