      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8.5. A readily visible, durable sign shall be posted on the interior side on or adjacent to each locked required exit access door serving the exterior area stating, \"THIS DOOR TO REMAIN UNLOCKED WHEN THE OUTDOOR AREA IS OCCUPIED.\" The letters on the sign shall be not less than 1 inch (25.4 mm) high on a contrasting background."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-those-portions-of-aisles-where-egress-is-possible-in-either-of-two-directions",
    "@type": [
