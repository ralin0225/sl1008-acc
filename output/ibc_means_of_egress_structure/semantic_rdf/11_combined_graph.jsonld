    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Raised areas used primarily for purposes of security, life safety or fire safety including, but not limited to, observation galleries, prison guard towers, fire towers or lifeguard stands."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.2-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
