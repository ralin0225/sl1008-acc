        "@id": "https://example.org/ibc/2021/ibc2021-1003.3.4"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 305
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Handrails are permitted to protrude 41/2 inches (114 mm) from the wall or guard."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.9.5-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each end of an aisle shall be continuous to a cross aisle, foyer, doorway, vomitory, concourse or stairway in accordance with Section 1030.9.7 having access to an exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1005.7.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.168, 596.629, 304.19, 662.866]"
      }
    ],
