    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.6.2 Stairway or elevator access. Every required area of refuge shall have direct access to a stairway complying with Sections 1009.3 and 1023 or an elevator complying with Section 1009.4."
      }
    ]
  },
