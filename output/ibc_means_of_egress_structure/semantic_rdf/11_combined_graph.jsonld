      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0329"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 318
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.1 Unlatching. The unlatching of any door or leaf for egress shall require not more than one motion in a single linear or rotational direction to release all latching and all locking devices."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group A-1 occupancies, where persons are admitted to the building at times when seats are not available, such persons shall be allowed to wait in a lobby or similar space, provided that such lobby or similar space shall not encroach on the minimum width or required capacity of the means of egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1026.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.799, 610.737, 550.852, 709.69]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4.1"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4.2"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Refuge area"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1026.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4.1"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.4 Refuge area. The refuge area of a horizontal exit shall be a space occupied by the same tenant or a public area and each such refuge area shall be adequate to accommodate the original occupant load of the refuge area plus the occupant load anticipated from the adjoining compartment. The anticipated occupant load from the adjoining compartment shall be based on the capacity of the horizontal exit doors entering the refuge area or the total occupant load of the adjoining compartment, whichever is less."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1131-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The tolerance between adjacent treads shall not exceed 3/16 inch (4.8 mm). 1030.14.2.2 Risers."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-each-secured-physical-barrier",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
