      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress."
      }
    ]
  },
