        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Ship’s ladders are permitted to be used in Group I-3 as a component of a means of egress to and from control rooms or elevated facility observation stations not more than 250 square feet (23 m2) with not more than three occupants and for access to unoccupied roofs."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0806-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where automatic sprinkler systems are permitted in accordance with Section 903."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.5.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The occupant load permitted in any building, or portion thereof, is permitted to be increased from that number established for the occupancies in Table 1004.5, provided that all other requirements of the code are met based on such modified number and the occupant load does not exceed one occupant per 7 square feet (0.65 m2) of occupiable floor space."
      }
    ]
  },
