    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where changes in elevation of less than 12 inches (305 mm) exist in the means of egress, sloped surfaces shall be used."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.17.1-atomic-1",
