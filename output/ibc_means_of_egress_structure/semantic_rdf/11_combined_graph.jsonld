        "@value": 345
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1028.2 Exit discharge. Exits shall discharge directly to the exterior of the building. The exit discharge shall be at grade or shall provide a direct path of egress travel to grade. The exit discharge shall not reenter a building. The combined use of Exceptions 1 and 2 shall not exceed 50 percent of the number and minimum width or required capacity of the required exits."
      }
    ]
  },
