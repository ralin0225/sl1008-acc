    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. In areas that are not open to the public within occupancies in Group I-3, F, H or S, and for alternating tread devices and ships ladders, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1032-measurement-2",
