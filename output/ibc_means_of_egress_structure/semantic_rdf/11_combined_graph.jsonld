      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0350"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 318
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8.1. The maximum occupant load shall be posted where required by Section 1004.9. Such signage shall be permanently affixed inside the building and shall be posted in a conspicuous space near all the exit access doorways."
      }
    ]
  },
