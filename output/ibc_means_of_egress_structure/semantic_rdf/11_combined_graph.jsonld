    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The restrictions on door swing shall not apply to doors within individual dwelling units and sleeping units of Group R-2 occupancies and dwelling units of Group R-3 occupancies."
      }
    ]
  },
