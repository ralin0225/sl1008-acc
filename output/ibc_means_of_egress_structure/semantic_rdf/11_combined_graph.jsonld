      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2 Markings within exit components. Egress path markings shall be provided in interior exit stairways, interior exit ramps and exit passageways, in accordance with Sections 1025.2.1 through 1025.2.6.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.3.4.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
