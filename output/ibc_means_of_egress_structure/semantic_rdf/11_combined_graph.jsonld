        "@value": "[73.189, 629.626, 304.156, 651.688]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0731"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0733"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 334
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. An exit access shall not pass through a room that can be locked to prevent egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1089",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[82.843, 439.719, 289.886, 549.707]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1085"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.9.6"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 349
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. For smoke-protected or open-air assembly seating, a longer dead-end aisle is permitted where seats beyond the 21-row dead-end aisle are not more than 40 seats from another aisle, measured along a row of seats having an aisle accessway with a minimum clear width of 12 inches (305 mm) plus 0.3 inch (7.6 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0635-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Edge protection is not required on the sides of ramp landings having a vertical dropoff of not more than 1/2 inch (12.7 mm) within 10 inches (254 mm) horizontally of the required landing area."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1006.2.2.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[331.779, 132.683, 572.399, 228.227]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Electrical rooms"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1006.2.2.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.2.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.2.2.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 309
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2.2.4 Electrical rooms. T he location and number of exit or exit access doorways shall be provided for electrical rooms in accordance with Section 110.26 of NFPA 70 for electrical equipment rated 1,000 volts or less, and Section 110.33 of NFPA 70 for electrical equipment rated over 1,000 volts. Panic hardware shall be provided where required in accordance with Section 1010.2.9.2. "
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.9",
