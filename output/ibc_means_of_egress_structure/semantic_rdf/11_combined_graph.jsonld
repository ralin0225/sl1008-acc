    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the path of egress travel is not at the level of exit discharge from the atrium, that portion of the total permitted exit access travel distance that occurs within the atrium shall be not greater than 200 feet (60 960 mm)."
      }
    ]
  },
