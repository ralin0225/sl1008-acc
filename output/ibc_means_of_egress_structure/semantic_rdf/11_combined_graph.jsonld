  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1007.1.3.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than two exit access stairways or ramps provide the required means of egress, not less than two shall be arranged in accordance with Section 1007."
      }
    ]
  },
