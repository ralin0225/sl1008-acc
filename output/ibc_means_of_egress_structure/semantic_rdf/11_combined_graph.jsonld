    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Exit access stairways serving and contained within a Group R-3 congregate residence or a Group R-4 facility are not required to be enclosed."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.4-atomic-1",
