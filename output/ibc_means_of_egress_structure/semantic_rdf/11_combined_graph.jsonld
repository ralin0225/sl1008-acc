      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0785-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "other than Group B and M occupancies, this provision is limited to openings that do not connect more than four stories."
      }
    ]
  },
