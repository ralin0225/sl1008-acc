      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. For occupancies in Group R-3, and within individual dwelling units in occupancies in Group R-2, guards on the open sides of stairs shall have a height not less than 34 inches (864 mm) measured vertically from a line connecting the leading edges of the treads."
      }
    ]
  },
