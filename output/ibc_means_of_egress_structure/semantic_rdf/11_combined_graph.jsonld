      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Areas of refuge are not required at exit access stairways where two-way communication is provided at the elevator landing in accordance with Section 1009.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1004.2",
