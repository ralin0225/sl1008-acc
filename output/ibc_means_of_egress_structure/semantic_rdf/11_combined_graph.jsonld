    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required capacity in inches (mm) of the aisle for smokeprotected assembly seating shall be not less than the occupant load served by the egress element multiplied by the appropriate factor in Table 1030.6.2."
      }
    ]
  },
  {
