      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407.5.3, 408.6.2, 420.6.1 and 422.3.2 as applicable."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.5-condition-1",
