  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.3.2-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.6-atomic-3",
