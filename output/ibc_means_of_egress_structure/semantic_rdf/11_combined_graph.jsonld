      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031."
      }
    ]
  },
