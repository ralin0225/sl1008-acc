        "@value": 332
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Handrails serving aisles in rooms or spaces used for assembly purposes are permitted to comply with the handrail extensions in accordance with Section 1030.16."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.1.2-condition-1",
