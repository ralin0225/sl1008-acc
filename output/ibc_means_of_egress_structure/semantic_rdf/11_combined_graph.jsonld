      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The door shall open to the minimum required width within 10 seconds after activation of the operating device."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.5.3",
