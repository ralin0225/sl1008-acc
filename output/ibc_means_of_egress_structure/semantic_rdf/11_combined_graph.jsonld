    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. The number of exits from foyers, lobbies, vestibules or similar spaces need not be based on cumulative occupant loads for areas discharging through such spaces, but the capacity of the exits from such spaces shall be based on applicable cumulative occupant loads."
      }
    ]
  },
  {
