      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where personal fall arrest anchorage connector devices that comply with ANSI/ASSE Z 359."
      }
    ]
  },
  {
