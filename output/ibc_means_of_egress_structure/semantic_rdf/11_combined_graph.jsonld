    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 329
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.5.3 Restrictions. Means of egress ramps shall not reduce in width in the direction of egress travel. Projections into the required ramp and landing width are prohibited. Doors opening onto a landing shall not reduce the clear width to less than 42 inches (1067 mm)."
      }
    ]
  },
  {
