        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Modifications shall not be made to listed panic hardware, fire door hardware or door closers."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1027.6",
