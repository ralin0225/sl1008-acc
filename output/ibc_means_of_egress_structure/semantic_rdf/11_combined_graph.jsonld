      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where electrical systems that monitor or record egress activity are incorporated, the locking system shall comply with Section 1010.2.11, 1010.2.12, 1010.2.13, 1010.2.14 or 1010.2.15 or shall be readily openable from the egress side without the use of a key or special knowledge or effort."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1006.1",
