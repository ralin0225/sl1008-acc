    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.10.2.1",
