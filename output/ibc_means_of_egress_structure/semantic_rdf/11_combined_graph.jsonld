    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Security systems."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0935-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
