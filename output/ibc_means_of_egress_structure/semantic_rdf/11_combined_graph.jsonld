        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.5 Illumination. Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.5-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The number of occupants shall be computed at the rate of one occupant per unit of area as prescribed in Table 1004.5."
      }
    ]
  },
