      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The clear width of a ramp between handrails, if provided, or other permissible projections shall be 36 inches (914 mm) minimum."
      }
    ]
  },
  {
