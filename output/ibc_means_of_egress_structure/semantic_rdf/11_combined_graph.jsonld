      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where means of egress doors are operated or assisted by power, the design shall be such that in the event of power failure, the door is capable of being opened manually to permit means of egress travel or closed where necessary to safeguard means of egress."
      }
    ]
  },
  {
