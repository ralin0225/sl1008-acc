        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Delayed egress locking systems shall be permitted to be installed on doors serving the following occupancies in buildings that are equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or an approved automatic smoke or heat detection system installed in accordance with Section 907."
      }
    ]
  },
