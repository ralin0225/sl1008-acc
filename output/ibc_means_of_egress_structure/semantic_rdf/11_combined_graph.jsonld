      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Solid risers are not required for stairways that are not required to comply with Section 1009.3, provided that the opening between treads does not permit the passage of a sphere with a diameter of 4 inches (102 mm)."
      }
    ]
  },
  {
