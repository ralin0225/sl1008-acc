      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. The delayed egress locking system shall have the capability of being deactivated at the fire command center and other approved locations."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0671-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
