    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 314
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.6 Areas of refuge. Every required area of refuge shall be accessible from the space it serves by an accessible means of egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.8-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of intermediate handrails are provided within the stairway width without a walking surface between the pair of intermediate handrails and the distance between the pair of intermediate handrails is greater than 6 inches (152 mm), the available egress width shall be reduced by the distance between the closest edges of each such intermediate pair of handrails that is greater than 6 inches (152 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.5-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a landing serves an occupant load of 50 or more, doors in any position shall not reduce the landing to less than one-half its required width."
      }
    ]
  },
