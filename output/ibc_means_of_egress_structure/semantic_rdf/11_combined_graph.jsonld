        "@id": "https://example.org/ibc/2021/concept-exception-for-auditoriums-theaters-concert-or-opera-halls-and-similar-assembly-occupancies-the-illumination-at-the-walking-surface-is"
      }
    ],
    "https://example.org/ibc/ontology/confidence": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.9"
      }
    ],
    "https://example.org/ibc/ontology/hasAtomicRule": [
      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0159-atomic-1"
      }
    ],
