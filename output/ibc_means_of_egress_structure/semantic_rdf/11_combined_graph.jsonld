    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with 200 or fewer seats, the seats shall not be required to be fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0837-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the exterior egress balcony is served by not less than two stairways and a dead-end travel condition does not require travel past an unprotected opening to reach a stairway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1023.10",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
