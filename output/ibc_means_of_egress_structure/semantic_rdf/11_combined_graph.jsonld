      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Penetrations of the fire barrier in accordance with Section 1023.5 shall be permitted."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.5.1-atomic-1",
