        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In determining means of egress requirements, the number of occupants for whom means of egress facilities are provided shall be determined in accordance with this section."
      }
    ]
  },
