      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.3 Multiple function occupant load. Where an area under consideration contains multiple functions having different occupant load factors, the design occupant load for such area shall be based on the floor area of each function calculated independently."
      }
    ]
