    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.10.2.1 Stairways and stepped aisles in a straight run. Where stairways and stepped aisles are in a straight run, transitions shall have one of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0379-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
