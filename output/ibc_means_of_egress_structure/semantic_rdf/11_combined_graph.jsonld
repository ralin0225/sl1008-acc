    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Rooms, areas or spaces, including mezzanines, within a story or basement shall be provided with the number of exits or access to exits in accordance with this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.14.2-atomic-4",
