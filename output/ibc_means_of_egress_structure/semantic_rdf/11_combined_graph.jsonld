      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0254-atomic-1",
