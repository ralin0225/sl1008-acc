    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Dead-end aisles shall be not greater than 20 feet (6096 mm) in length."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.7.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
