      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required number of exits, or exit access stairways or ramps providing access to exits, from any story or occupied roof shall be maintained until arrival at the exit discharge or a public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.3-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "other than Group H occupancies, special purpose horizontal sliding, accordion or folding door assemblies permitted to be a component of a means of egress in accordance with Exception 6 to Section 1010."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.17.4-atomic-2",
