        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrails and handrail extensions shall be marked with a solid and continuous stripe having a minimum width of 1 inch (25 mm)."
      }
    ]
  },
