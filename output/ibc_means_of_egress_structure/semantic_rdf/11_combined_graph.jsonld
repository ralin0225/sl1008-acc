      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: In assembly spaces with fixed seating, edge protection is not required on the sides of ramped aisles where the ramped aisles provide access to the adjacent seating and aisle accessways."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0285-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
