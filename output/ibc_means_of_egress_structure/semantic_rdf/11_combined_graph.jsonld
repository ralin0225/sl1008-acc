      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 310
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Rooms, areas and spaces complying with Section 1006.2.1 with exits that discharge directly to the exterior at the level of exit discharge, are permitted to have one exit or access to a single exit."
      }
    ]
  },
