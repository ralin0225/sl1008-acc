      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.4.2 Number of exits. The refuge area into which a horizontal exit leads shall be provided with exits adequate to meet the occupant requirements of this chapter, but not including the added occupant load imposed by persons entering the refuge area through horizontal exits from other areas. Not less than one refuge area exit shall lead directly to the exterior or to an interior exit stairway or ramp."
      }
    ]
  },
