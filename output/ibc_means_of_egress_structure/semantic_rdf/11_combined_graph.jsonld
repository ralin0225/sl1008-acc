        "@value": 337
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: In Group I-2 occupancies, corridors are not required to have a clear width of 96 inches (2438 mm) in areas where there will not be stretcher or bed movement for access to care or as part of the defend-in-place strategy. TABLE 1020.3 MINIMUM CORRIDOR WIDTH For SI: 1 inch = 25.4 mm."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.1-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
