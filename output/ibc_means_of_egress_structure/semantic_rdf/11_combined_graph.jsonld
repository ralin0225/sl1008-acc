      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The maximum exit access travel distance shall be 400 feet (122 m) in Group F-1 or S-1 occupancies where all of the following conditions are met:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.3.2-atomic-4",
