    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Solid risers are not required for spiral stairways constructed in accordance with Section 1011.10."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1007.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exits, exit access doorways, and exit access stairways and ramps serving spaces, including individual building stories, shall be separated in accordance with the provisions of this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0454-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each revolving door shall have a side-hinged swinging door that complies with Section 1010.1 in the same wall and within 10 feet (3048 mm) of the revolving door."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0956-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The horizontal exit separation shall extend vertically through all levels of the building unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings."
      }
    ]
  },
