    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "These requirements shall not apply to sloping portions of handrails between the top and bottom riser of stairs and above the ramp run."
      }
    ]
  },
  {
