    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf. The inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
