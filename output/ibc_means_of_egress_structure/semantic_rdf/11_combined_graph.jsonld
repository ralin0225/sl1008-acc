        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.3.4 Security grilles. In Groups B, F, M and S, horizontal sliding or vertical security grilles are permitted at the main exit and shall be openable from the inside without the use of a key or special knowledge or effort during periods that the space is occupied. The grilles shall remain secured in the full-open position during the period of occupancy by the general public. Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-corridor",
    "@type": [
      "https://example.org/ibc/ontology/Corridor"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Corridor"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1120-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum width, in inches (mm), of any means of egress components shall be not less than that specified for such component, elsewhere in this code."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
