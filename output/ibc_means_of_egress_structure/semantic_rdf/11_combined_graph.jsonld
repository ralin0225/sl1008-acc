        "@value": "2. Toilet rooms."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0820-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that each such corridor is directly supplied with outdoor air at a rate greater than the rate of makeup air taken from the corridor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.14.2",
