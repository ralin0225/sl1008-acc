      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles."
      }
    ]
  },
  {
