      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.13.1 Delayed egress locking system. The delayed egress locking system shall be installed and operated in accordance with all of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1033-measurement-1",
