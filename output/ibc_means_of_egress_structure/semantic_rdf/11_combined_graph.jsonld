      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairways shall be built of materials consistent with the types permitted for the type of construction of the building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.15-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
