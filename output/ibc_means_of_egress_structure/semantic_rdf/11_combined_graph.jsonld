      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8. The delayed egress locking system units shall be listed in accordance with UL 294."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1020.4-atomic-1",
