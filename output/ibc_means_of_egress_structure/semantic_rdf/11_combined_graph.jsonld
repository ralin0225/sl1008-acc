      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.5 Internally illuminated exit signs. Electrically powered, self-luminous and photoluminescent exit signs shall be listed and labeled in accordance with UL 924 and shall be installed in accordance with the manufacturer’s instructions and Chapter 27. Exit signs shall be illuminated at all times."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1005.7.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
