      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The fire-resistancerated construction shall extend vertically from the ground to a point not less than 10 feet (3048 mm) above the floor level of the area for assisted rescue or to the roof line, whichever is lower."
      }
    ]
  },
