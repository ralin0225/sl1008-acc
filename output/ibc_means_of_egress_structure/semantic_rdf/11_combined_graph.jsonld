      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.7.2 Outdoor conditions. Outdoor stairways and outdoor approaches to stairways shall be designed so that water will not accumulate on walking surfaces."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4.1-measurement-2",
