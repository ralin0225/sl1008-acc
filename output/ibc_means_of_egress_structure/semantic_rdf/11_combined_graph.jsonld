    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Seats intended for musicians or other performers and separated by railings, guards, partial height walls or similar barriers shall not be required to be fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.6.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
