      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A spiral stairway shall have a 63/4-inch (171 mm) minimum clear tread depth at a point 12 inches (305 mm) from the narrow edge."
      }
    ]
  },
  {
