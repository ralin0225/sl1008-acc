      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.7.2 Outdoor conditions. Outdoor ramps and outdoor approaches to ramps shall be designed so that water will not accumulate on walking surfaces."
      }
    ]
  },
  {
