        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.2 Ceiling height. The means of egress shall have a ceiling height of not less than 7 feet 6 inches (2286 mm) above the finished floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.5.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
