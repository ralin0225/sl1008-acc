        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Exit signs are not required in dayrooms, sleeping rooms or dormitories in occupancies in Group I-3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Outdoor stairways and outdoor approaches to stairways shall be designed so that water will not accumulate on walking surfaces."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.17.3-condition-2",
