      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum width or required capacity of the means of egress required from any story of a building shall not be reduced along the path of egress travel until arrival at the public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0569",
