    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Areas of refuge are not required for elevators accessed from a refuge area in conjunction with a horizontal exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
