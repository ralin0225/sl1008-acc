      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "d. Group R-3 and R-4 buildings equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.3. See Section 903.2.8 for occupancies where automatic sprinkler systems are permitted in accordance with Section 903.3.1.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0345",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0345"
      }
    ],
    "https://example.org/ibc/ontology/appliesTo": [
