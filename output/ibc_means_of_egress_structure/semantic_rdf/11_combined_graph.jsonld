    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.16.4 Rails. Where mid-aisle handrails are provided in stepped aisles, there shall be an additional rail located approximately 12 inches (305 mm) below the handrail. The rail shall be adequate in strength and attachment in accordance with Section 1607.9.1.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0474",
