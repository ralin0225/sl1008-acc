      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "At the top or bottom of the stairs, demarcation lines shall drop vertically to the floor within 2 inches (51 mm) of the step or landing edge."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0071-condition-1",
