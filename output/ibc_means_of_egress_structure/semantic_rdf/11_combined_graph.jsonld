    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In buildings in occupancy Group A having an occupant load of 300 or less, Groups B, F, M and S, and in places of religious worship, the main door or doors are permitted to be equipped with key-operated locking devices from the egress side provided:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1013.4",
