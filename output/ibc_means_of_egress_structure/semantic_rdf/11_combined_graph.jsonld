    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2.3. The area is separated from the remainder of the level of exit discharge by a fire partition constructed in accordance with Section 708."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0263",
