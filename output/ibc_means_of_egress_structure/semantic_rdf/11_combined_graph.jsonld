        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Fire safety and evacuation plans shall be provided for all occupancies and buildings where required by the International Fire Code."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.3-atomic-2",
