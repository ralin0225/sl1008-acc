        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairways serving occupied portions of a building shall comply with the requirements of Sections 1011.2 through 1011.13."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1031.5.2",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
