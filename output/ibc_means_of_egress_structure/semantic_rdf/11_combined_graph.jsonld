      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Membrane penetrations shall be permitted on the outside of the exit passageway. Such penetrations shall be protected in accordance with Section 714.4.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.7-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
