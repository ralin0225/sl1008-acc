        "@value": 345
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Horizontal exits complying with Section 1026 shall not be required to discharge directly to the exterior of the building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.3-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.12-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where required by Section 403.5.4, 405.7.2 or 412.2.2.1, interior exit stairways and ramps shall be smokeproof enclosures in accordance with Section 909.20."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
