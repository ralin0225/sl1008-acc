      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group I-3, Condition 2, 3 or 4, occupancies, the dead end in a corridor shall not exceed 50 feet (15 240 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.2",
