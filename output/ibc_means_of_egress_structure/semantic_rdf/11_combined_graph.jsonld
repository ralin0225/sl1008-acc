      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat."
      }
    ]
  },
