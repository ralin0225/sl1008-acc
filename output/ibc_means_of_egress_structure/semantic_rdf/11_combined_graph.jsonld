      {
        "@value": "Exception: For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0957-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
