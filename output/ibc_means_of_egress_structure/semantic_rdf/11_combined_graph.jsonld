    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each area of refuge shall be sized to accommodate one wheelchair space of 30 inches by 52 inches (762 mm by 1320 mm) for each 200 occupants or portion thereof, based on the occupant load of the area of refuge and areas served by the area of refuge."
      }
    ]
  },
