    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of doors serves a storage or equipment room, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0339",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
