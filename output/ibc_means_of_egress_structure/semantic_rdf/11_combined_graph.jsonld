    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1028.3 Exit discharge width or capacity. The minimum width or required capacity of the exit discharge shall be not less than the minimum width or required capacity of the exits being served."
      }
    ]
  },
  {
