      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "10. Doors to walk-in freezers and coolers less than 1,000 square feet (93 m2) in area shall have a maximum width of 60 inches (1524 mm) nominal."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1080-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
