      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. A fire-resistance rating is not required for corridors in an occupancy in Group B that is a space requiring only a single means of egress complying with Section 1006.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0713-measurement-2",
