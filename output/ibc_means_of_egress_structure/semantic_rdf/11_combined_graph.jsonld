    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Except as specifically permitted by this section, egress doors shall be readily openable from the egress side without the use of a key or special knowledge or effort."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1007.1.2-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where access to three or more exits is required, not less than two exit or exit access doorways shall be arranged in accordance with the provisions of Section 1007."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1137",
