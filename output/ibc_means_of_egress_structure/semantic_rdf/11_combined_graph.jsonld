      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.15"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0446"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 322
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Activation of an approved manual fire alarm box."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0421-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group I-1, Condition 2, Group I-2 or I-3 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided that the combined delay does not exceed 30 seconds."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1013.6.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.799, 106.796, 289.989, 205.749]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0655"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Power source"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1013.6.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013.6"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0655"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 331
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.6.3 Power source. Exit signs shall be illuminated at all times. To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator. The installation of the emergency power system shall be in accordance with Chapter 27. Group I-2, Condition 2 exit sign illumination shall not be provided by unit equipment batteries only."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1029.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where an egress court serving a building or portion thereof is less than 10 feet (3048 mm) in width, the egress court walls shall have not less than 1-hour fire-resistance-rated construction for a distance of 10 feet (3048 mm) above the floor of the egress court."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0641",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
