        "@value": 348
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Thirty inches (762 mm) where the aisle serves fewer than 15 seats and does not serve as part of an accessible route."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.15-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
