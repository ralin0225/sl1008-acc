        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Marking stripes shall have a width of not less than 1 inch (25 mm) but not more than 2 inches (51 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.6-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
