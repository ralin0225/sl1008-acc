      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.3 Handrails. Handrails and handrail extensions shall be marked with a solid and continuous stripe having a minimum width of 1 inch (25 mm). The stripe shall be placed on the top surface of the handrail for the entire length of the handrail, including extensions and newel post caps. Where handrails or handrail extensions bend or turn corners, the stripe shall not have a gap of more than 4 inches (102 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.2.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407."
      }
    ]
  },
