    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The exit passageway shall be separated from the remainder of the building by 2-hour fire barriers constructed in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both."
      }
    ]
  },
