    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5.2. Upon actuation of a clearly identified manual release device with ready access that results in direct interruption of power to each secured physical barrier, after which such barriers remain in the open position for not less than 30 seconds. The manual release device shall be positioned at one of the following locations:"
      }
    ]
  },
