      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The measurement along ramps shall be made on the walking surface in the center of the ramp and landings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1008.3.4-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
