    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each door providing access to an area of refuge from an adjacent floor area shall be identified by a sign stating, \"AREA OF REFUGE.\""
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0799-atomic-1",
