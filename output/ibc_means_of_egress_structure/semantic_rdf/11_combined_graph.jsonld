    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.9.4 Uniform width and capacity. Those portions of aisles, where egress is possible in either of two directions, shall be uniform in minimum width or required capacity."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
