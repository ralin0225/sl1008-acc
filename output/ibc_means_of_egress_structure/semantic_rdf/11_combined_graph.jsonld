    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The triangular openings at the open sides of a stair, formed by the riser, tread and bottom rail shall not allow passage of a sphere 6 inches (152 mm) in diameter."
      }
    ]
  },
