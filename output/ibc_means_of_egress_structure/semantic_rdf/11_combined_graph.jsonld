    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required capacity of aisles shall be not less than that determined in accordance with Section 1030.6.1 where smoke-protected assembly seating is not provided, Section 1030.6.2 where smoke-protected assembly seating is provided and Section 1030.6.3 where open-air assembly seating is provided."
      }
    ]
  },
