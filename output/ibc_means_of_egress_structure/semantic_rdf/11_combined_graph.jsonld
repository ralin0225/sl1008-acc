        "@value": 350
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.13.1.1 Aisle accessway capacity and width for seating at tables. Aisle accessways serving arrangements of seating at tables or counters shall comply with the capacity requirements of Section 1005.1 but shall not have less than 12 inches (305 mm) of width plus 1/2 inch (12.7 mm) of width for each additional 1 foot (305 mm), or fraction thereof, beyond 12 feet (3658 mm) of aisle accessway length measured from the center of the seat farthest from an aisle."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0494-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Any security access turnstile lane configuration providing a clear passage width of less than 32 inches (810 mm) shall be credited with a maximum egress capacity of 50 persons."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.6.2-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The total number of seats specified shall be those within the space exposed to the same smoke-protected environment."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1006.3.1",
