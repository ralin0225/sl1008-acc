    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where panic or fire exit hardware is required by Section 1010.2.9, operation of the panic or fire exit hardware also releases the electric lock."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.7-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
