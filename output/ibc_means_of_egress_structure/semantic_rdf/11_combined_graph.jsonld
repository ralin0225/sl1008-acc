    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A dispersal area shall be illuminated to a level not less than 1 footcandle (11 lux) at the walking surface."
      }
    ]
  },
  {
