      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Level or ramped aisles, where slopes are not steeper than one unit vertical in 12 units horizontal (8-percent slope), shall have not less than 0.20 inch (5.1 mm) of clear aisle capacity for each occupant served."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.2-atomic-5",
