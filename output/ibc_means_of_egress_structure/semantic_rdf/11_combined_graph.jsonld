      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Hardware"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.2.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 318
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.2 Hardware. Door handles, pulls, latches, locks and other operating devices on doors required to be accessible by Chapter 11 shall not require tight grasping, tight pinching or twisting of the wrist to operate."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1009.7.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
