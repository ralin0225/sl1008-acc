      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exit passageway opening protectives shall be in accordance with the requirements of Section 716."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0300-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
