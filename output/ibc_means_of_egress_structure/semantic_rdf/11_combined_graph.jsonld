    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In Group I-1, Condition 1 or Group I-4 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided the combined delay does not exceed 30 seconds and the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1."
      }
    ]
  },
  {
