    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The word “EXIT” shall be in high contrast with the background and shall be clearly discernible when the means of exit sign illumination is or is not energized."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.2.1-atomic-1",
