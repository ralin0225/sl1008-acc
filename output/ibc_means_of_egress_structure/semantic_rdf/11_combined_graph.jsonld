      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.4.3 Transition. Where a wall-mounted demarcation line transitions to a floor-mounted demarcation line, or vice versa, the wall-mounted demarcation line shall drop vertically to the floor to meet a complimentary extension of the floor-mounted demarcation line, thus forming a continuous marking."
      }
    ]
  },
  {
