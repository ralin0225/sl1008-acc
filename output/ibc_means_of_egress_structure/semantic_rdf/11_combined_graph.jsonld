      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "unless they are assisting others."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1008.3.2-atomic-1",
