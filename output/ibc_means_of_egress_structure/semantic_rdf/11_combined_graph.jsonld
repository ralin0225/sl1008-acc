      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.3 Opening protectives. Fire doors in horizontal exits shall be self-closing or automatic-closing when activated by a smoke detector in accordance with Section 716.2.6.6. Doors, where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716.2.6.6."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.3-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width."
      }
    ]
  },
