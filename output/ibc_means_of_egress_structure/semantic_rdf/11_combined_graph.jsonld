    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.13 Aisle accessways. Aisle accessways for seating at tables shall comply with Section 1030.13.1. Aisle accessways for seating in rows shall comply with Section 1030.13.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1008.3.5",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.799, 69.725, 289.834, 212.701]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1008.3.5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
