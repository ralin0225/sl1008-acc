        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exit or exit access doors serving transformer vaults, rooms designated for batteries or energy storage systems, or modular data centers shall be equipped with panic hardware or fire exit hardware."
      }
    ]
  },
