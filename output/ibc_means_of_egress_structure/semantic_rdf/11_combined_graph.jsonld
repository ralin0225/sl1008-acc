    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where located in a cross-corridor condition, shall be automatic-closing by activation of a smoke detector installed in accordance with Section 716."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.3-atomic-1",
