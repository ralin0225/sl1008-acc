        "@value": 328
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5.4. The handhold gripping surface complies with Section 1014.3, and is not less than 4.5 inches (114 mm) in length."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0979-atomic-1",
