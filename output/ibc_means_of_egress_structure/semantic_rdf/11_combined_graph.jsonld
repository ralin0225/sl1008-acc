      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required open area shall be located not less than 42 inches (1067 mm) above the adjacent floor or landing level."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0956",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.799, 374.59, 550.782, 440.849]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "716"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0957"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "716. Duct and air transfer openings in a fire wall or fire barrier that serves as a horizontal exit shall also comply with Section 717. The horizontal exit separation shall extend vertically through all levels of the building unless floor assemblies have a fire-resistance rating of not less than 2 hours and do not have unprotected openings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0123",
