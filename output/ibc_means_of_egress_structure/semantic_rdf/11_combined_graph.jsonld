      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A weatherproof telephone or two-way communication system installed in accordance with Sections 1009.8.1 and 1009.8.2 shall be located adjacent to not less than one required exit access door on the exterior side."
      }
    ]
  },
  {
