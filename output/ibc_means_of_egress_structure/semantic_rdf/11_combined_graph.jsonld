      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "11. Doors serving nonaccessible single-user shower or sauna compartments, toilet stalls or dressing, fitting or changing rooms shall have a minimum clear opening width of 20 inches (508 mm). "
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0474-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
