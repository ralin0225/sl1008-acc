    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1027.2"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1027.2 Use in a means of egress. Exterior exit stairways shall not be used as an element of a required means of egress for Group I-2 occupancies. For occupancies in other than Group I-2, exterior exit stairways and ramps shall be permitted as an element of a required means of egress for buildings not exceeding six stories above grade plane or that are not high-rise buildings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7.1",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.7.1"
      }
    ],
    "https://example.org/ibc/ontology/appliesTo": [
      {
        "@id": "https://example.org/ibc/2021/concept-stairway"
      }
    ],
    "https://example.org/ibc/ontology/confidence": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.81"
      }
    ],
    "https://example.org/ibc/ontology/hasAtomicRule": [
      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7.1-atomic-3"
