      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.1 General. Horizontal exits serving as an exit in a means of egress system shall comply with the requirements of this section. A horizontal exit shall not serve as the only exit from a portion of a building, and where two or more exits are required, not more than one-half of the total number of exits or total exit minimum width or required capacity shall be horizontal exits."
      }
    ]
  },
