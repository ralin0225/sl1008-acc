        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 337
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. A fire-resistance rating is not required for corridors contained within a dwelling unit or sleeping unit in an occupancy in Groups I-1 and R."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Buildings or structures used for human occupancy shall have not less than one exterior door that meets the requirements of Section 1010.1.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1078-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the aisle serves less than 15 seats and does not serve as part of an accessible route."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.7.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.802, 583.792, 289.887, 660.792]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
