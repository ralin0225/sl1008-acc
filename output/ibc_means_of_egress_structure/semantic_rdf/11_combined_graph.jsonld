        "@value": "[70.806, 353.744, 289.854, 430.745]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Door frame markings"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1025.2.6.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1025.2.6"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1025.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.6.3 Door frame markings. The top and sides of the door frame shall be marked with a solid and continuous 1-inch- to 2-inch-wide (25 mm to 51 mm) stripe. Where the door molding does not provide sufficient flat surface on which to locate the stripe, the stripe shall be permitted to be located on the wall surrounding the frame."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1026.4.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.194, 69.725, 304.337, 157.77]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Capacity"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1026.4.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1026.4.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 344
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1026.4.1 Capacity. The capacity of the refuge area shall be computed based on a net floor area allowance of 3 square feet (0.2787 m2) for each occupant to be accommodated therein. Where the horizontal exit also forms a smoke compartment, the capacity of the refuge area for Group I-1, I-2 and I-3 occupancies and Group B ambulatory care facilities shall comply with Sections 407.5.3, 408.6.2, 420.6.1 and 422.3.2 as applicable."
      }
    ]
  },
