      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.6.2 Door hardware markings. Door hardware shall be marked with not less than 16 square inches (10323 mm2) of luminous material. This marking shall be located behind, immediately adjacent to, or on the door handle or escutcheon. Where a panic bar is installed, such material shall be not less than 1 inch (25 mm) wide for the entire length of the actuating bar or touchpad."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0336-condition-1",
