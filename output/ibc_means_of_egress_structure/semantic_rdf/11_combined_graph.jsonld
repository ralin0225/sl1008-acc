    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way."
      }
    ]
  },
  {
