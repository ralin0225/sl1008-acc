    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.1 General. Stairways serving occupied portions of a building shall comply with the requirements of Sections 1011.2 through 1011.13. Alternating tread devices shall comply with Section 1011.14. Ship’s ladders shall comply with Section 1011.15. Ladders shall comply with Section 1011.16."
      }
