      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Such openings shall open directly into a public way or to a yard or court that opens to a public way."
      }
    ]
  },
  {
