      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where door hardware operates by push or pull, the operational force to unlatch the door shall not exceed 15 pounds (67 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.4-condition-1",
