        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.6.1 Emergency exit symbol. The doors shall be identified by a low-location luminous emergency exit symbol complying with NFPA 170. The exit symbol shall be not less than 4 inches (102 mm) in height and shall be mounted on the door, centered horizontally, with the top of the symbol not higher than 18 inches (457 mm) above the finished floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0347-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors serving roofs not intended to be occupied shall be permitted to be locked preventing entry to the building from the roof."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0706-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-upon-actuation-of-a-clearly-identified-manual-release-device-with-ready-access-that-results-in-direct-interruption-of-power-to-each-secured-physical-barrier-after-which-such-barriers-remain-in-the-open-position-for-not-less-than-30-seconds-the-manual-release-device",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Upon actuation of a clearly identified manual release device with ready access that results in direct interruption of power to each secured physical barrier, after which such barriers remain in the open position for not less than 30 seconds. The manual release device"
      }
    ]
  },
