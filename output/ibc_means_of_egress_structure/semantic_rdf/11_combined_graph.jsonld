    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where such units are not required to be Accessible units, Type A units or Type B units, the landing at an exterior doorway shall be not more than 73/4 inches (197 mm) below the landing on the egress side of the door."
      }
    ]
  },
