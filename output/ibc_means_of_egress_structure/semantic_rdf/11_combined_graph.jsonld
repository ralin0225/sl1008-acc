    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The slope measured perpendicular to the direction of travel of a ramp shall not be steeper than one unit vertical in 48 units horizontal (2-percent slope)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0894-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0260",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.769, 131.596, 550.839, 256.787]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.9"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.10"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 315
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Each door providing access to an exterior area for assisted rescue shall be identified by a sign stating, \"EXTERIOR AREA FOR ASSISTED RESCUE.\" Signage shall comply with the ICC A117.1 requirements for visual characters and include the International Symbol of Accessibility. Where exit sign illumination is required by Section 1013.3, the signs shall be illuminated. Additionally, visual characters, raised character and braille signage complying with ICC A117.1 shall be located at each door to an area of refuge and exterior area for assisted rescue in accordance with Section 1013.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.9.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.809, 117.712, 289.771, 161.725]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Converging aisles"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.9.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.9"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
