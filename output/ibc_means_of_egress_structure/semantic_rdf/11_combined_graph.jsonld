      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A building occupant shall not be required to pass through more than one door equipped with a controlled egress locking system before entering an exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.3-atomic-1",
