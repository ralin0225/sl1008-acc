  {
    "@id": "https://example.org/ibc/2021/concept-stairway",
    "@type": [
      "https://example.org/ibc/ontology/Stairway"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Stairway"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.13.2.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.6 inch (15.2 mm) for every additional seat beyond seven seats where seats have backrests or beyond 10 where seats are without backrests."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1145-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Groups of seats within a building, room or space used for assembly purposes separated from other seating by railings, guards, partial height walls or similar barriers with level floors and having not more than 14 seats per group shall not be required to be fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1034",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
