      }
    ],
    "https://example.org/ibc/ontology/hasException": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0188"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/references": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.2"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.3"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "numerical"
      },
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.1 Accessible means of egress required. Accessible means of egress shall comply with this section. Accessible spaces shall be provided with not less than one accessible means of egress. Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0361-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a pair of doors serves an occupant load of less than 50 persons in a Group B, F or S occupancy, manually operated edge- or surface-mounted bolts are permitted on the inactive leaf."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0672-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where handrails are provided along walking surfaces with slopes not steeper than 1:20, the bottoms of the handrail gripping surfaces shall be permitted to be obstructed along their entire length where they are integral to crash rails or bumper guards."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exterior exit doors shall comply with the applicable requirements of Section 1010.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0405",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[88.559, 69.725, 289.809, 102.822]"
      },
      {
        "@value": "[346.194, 709.732, 565.361, 731.793]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "6"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.12"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0406"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 321
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 320
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Activation of the building automatic sprinkler system or fire detection system, where provided, shall automatically unlock the electric lock. The electric lock shall remain unlocked until the fire alarm system has been reset."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1004.6",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.798, 69.516, 554.357, 727.47]"
      },
      {
        "@value": "[61.199, 518.622, 304.212, 728.841]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0050"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Fixed seating"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1004.6"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0050"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 306
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.6 Fixed seating. For areas having fixed seats and aisles, the occupant load shall be determined by the number of fixed seats installed therein. The occupant load for areas in which fixed seating is not installed, such as waiting spaces, shall be determined in accordance with Section 1004.5 and added to the number of fixed seats. The occupant load of wheelchair spaces and the associated companion seat shall be based on one occupant for each wheelchair space and one occupant for the associated companion seat provided in accordance with Section 1109.2.3. For areas having fixed seating without dividing arms, the occupant load shall be not less than the number of seats based on one person for each 18 inches (457 mm) of seating length. The occupant load of seating booths shall be based on one person for each 24 inches (610 mm) of booth seat length measured at the backrest of the seating booth. TABLE 1004.5 MAXIMUM FLOOR AREA ALLOWANCES PER OCCUPANT For SI: 1 foot = 304.8 mm, 1 square foot = 0.0929 m2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.5-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.14.2.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[331.808, 564.836, 550.81, 630.801]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1137"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Tread contrasting marking stripe"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.14.2.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.14.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1137"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 351
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.14.2.3 Tread contrasting marking stripe. A contrasting marking stripe shall be provided on each tread at the nosing or leading edge such that the location of each tread is readily apparent when viewed in descent. Such stripe shall be not less than 1 inch (25 mm) and not more than 2 inches (51 mm) wide."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.1",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
