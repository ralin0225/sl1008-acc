    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1017.3 Measurement. Exit access travel distance shall be measured from the most remote point of each room, area or space along the natural and unobstructed path of horizontal and vertical egress travel to the entrance to an exit. Where more than one exit is required, exit access travel distance shall be measured to the nearest exit."
      }
