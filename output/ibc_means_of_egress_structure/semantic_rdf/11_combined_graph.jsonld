    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Exit access stairways and ramps between the balcony, gallery or press box and the main assembly floor in occupancies such as theaters, places of religious worship, auditoriums and sports facilities."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.15.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[334.188, 437.744, 565.199, 503.87]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Treads of ship’s ladders"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1011.15.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.15"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
