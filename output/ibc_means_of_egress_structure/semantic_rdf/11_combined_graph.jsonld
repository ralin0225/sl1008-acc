        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0366"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 319
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.7 Stairway doors. Interior stairway means of egress doors shall be openable from both sides without the use of a key or special knowledge or effort."
      }
    ]
  },
  {
