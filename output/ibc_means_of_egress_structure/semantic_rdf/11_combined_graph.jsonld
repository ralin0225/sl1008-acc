      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.2 Height. Handrail height, measured above stair tread nosings, or finish surface of ramp slope, shall be uniform, not less than 34 inches (864 mm) and not more than 38 inches (965 mm). Handrail height of alternating tread devices and ships ladders, measured above tread nosings, shall be uniform, not less than 30 inches (762 mm) and not more than 34 inches (864 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0985",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[70.799, 207.708, 289.86, 273.792]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
