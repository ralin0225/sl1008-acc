    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.3 Height. Required guards shall be not less than 42 inches (1067 mm) high, measured vertically as follows:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.10-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
