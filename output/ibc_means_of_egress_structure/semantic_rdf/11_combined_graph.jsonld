        "@value": 352
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.15 Seat stability. In a building, room or space used for assembly purposes, the seats shall be securely fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.7.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1hour fire-resistance-rated construction."
      }
    ]
  },
  {
