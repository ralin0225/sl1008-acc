    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.6.1 Without smoke protection. The required capacity in inches (mm) of the aisles for assembly seating without smoke protection shall be not less than the occupant load served by the egress element in accordance with all of the following, as applicable:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.6-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
