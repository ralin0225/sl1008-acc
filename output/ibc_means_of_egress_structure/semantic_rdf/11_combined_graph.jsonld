    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.4 Locks and latches. Locks and latches shall be permitted to prevent operation of doors where any of the following exist:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9.1",
