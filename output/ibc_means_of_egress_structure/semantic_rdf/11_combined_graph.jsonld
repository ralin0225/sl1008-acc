      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0759"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 335
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1017.3 Measurement. Exit access travel distance shall be measured from the most remote point of each room, area or space along the natural and unobstructed path of horizontal and vertical egress travel to the entrance to an exit. Where more than one exit is required, exit access travel distance shall be measured to the nearest exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.6-atomic-6",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where wheelchair spaces are required on the stairway landing in accordance with Section 1009.6.3, the wheelchair space shall not be located in the required width of the landing and doors shall not swing over the wheelchair spaces."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.10",
