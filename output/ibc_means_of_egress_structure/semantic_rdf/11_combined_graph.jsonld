      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. A revolving door shall not be located within 10 feet (3048 mm) of the foot or top of stairways or escalators. A dispersal area shall be provided between the stairways or escalators and the revolving doors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1023.11",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.181, 415.749, 565.197, 492.749]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Tactile floor-level signs"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1023.11"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.12"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 340
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.11 Tactile floor-level signs. Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117.1 shall be located at each floor-level landing adjacent to the door leading from the interior exit stairway and ramp into the corridor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0333-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Doors from individual dwelling units and sleeping units of Group R occupancies as permitted by Section 1010.2.4, Item 5."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1176-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Within individual dwelling and sleeping units in Groups R-2 and R-3, where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1, 903.3.1.2 or 903.3.1.3, sleeping rooms in basements shall not be required to have emergency escape and rescue openings provided that the basement has one of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.3.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-wheelchairspace",
    "@type": [
      "https://example.org/ibc/ontology/WheelchairSpace"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "WheelchairSpace"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0918",
