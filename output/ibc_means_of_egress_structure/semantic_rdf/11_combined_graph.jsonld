      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. The area shall be permanently maintained and identified as a safe dispersal area."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0434-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
