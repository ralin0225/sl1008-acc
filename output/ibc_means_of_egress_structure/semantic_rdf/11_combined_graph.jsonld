    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Items 1 through 4 shall not apply to doors to areas where a listed egress control system is utilized to reduce the risk of child abduction from nursery and obstetric areas of a Group I-2 hospital."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0918-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the equipment and ductwork is located within the exit passageway, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or the air shall be conveyed through ducts enclosed in construction as required for shafts."
      }
    ]
  },
  {
