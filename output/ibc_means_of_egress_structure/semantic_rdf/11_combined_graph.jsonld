        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Means of egress from dwelling units or sleeping areas shall not lead through other sleeping areas, toilet rooms or bathrooms."
      }
    ]
  },
