      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "At elevated walking surfaces for access to and use of electrical, mechanical or plumbing systems or equipment, guards shall not have openings that allow passage of a sphere 21 inches (533 mm) in diameter."
      }
    ]
  },
