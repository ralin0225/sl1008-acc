      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The tolerance between adjacent treads shall not exceed 3/16 inch (4.8 mm). 1030.14.2.2 Risers. Where the gradient of stepped aisles is to be the same as the gradient of adjoining seating areas, the riser height shall be not less than 4 inches (102 mm) nor more than 8 inches (203 mm) and shall be uniform within each flight."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0144-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
