      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1007.1.3 Remoteness of exit access stairways or ramps. Where two exit access stairways or ramps provide the required means of egress to exits at another story, the required separation distance shall be maintained for all portions of such exit access stairways or ramps."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1023.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.789, 263.673, 550.852, 370.774]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Openings"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1023.4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.5"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 339
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.4 Openings. Interior exit stairway and ramp opening protectives shall be in accordance with the requirements of Section 716. Openings in interior exit stairways and ramps other than unprotected exterior openings shall be limited to those required for exit access to the enclosure from normally occupied spaces and for egress from the enclosure. Elevators shall not open into interior exit stairways and ramps."
      }
    ]
  },
