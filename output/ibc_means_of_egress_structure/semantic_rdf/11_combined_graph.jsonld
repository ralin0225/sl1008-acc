      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Doors with automatic flush bolts as permitted by Section 1010.2.4, Item 4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0363",
