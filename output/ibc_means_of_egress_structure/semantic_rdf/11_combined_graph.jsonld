        "@value": 310
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Group R-3 and R-4 occupancies shall be permitted to have one exit or access to a single exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0877",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
