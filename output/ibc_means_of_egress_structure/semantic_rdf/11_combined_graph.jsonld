      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the entire path for means of egress from the seating to the exit discharge is provided with a smoke control system complying with Section 909."
      }
    ]
  },
