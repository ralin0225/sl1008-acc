    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The required capacity in inches (mm) of aisles shall be permitted to comply with Section 1030.6.2 for the number of seats in the open-air assembly seating where Section 1030.6.2 permits less capacity. CAPACITY FOR AISLES FOR SMOKE-PROTECTED ASSEMBLY For SI: 1 inch = 25.4 mm."
      }
    ]
  },
