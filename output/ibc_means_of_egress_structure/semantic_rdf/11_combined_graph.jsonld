      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1017.3.2.1 Egress not through the atrium. Where required access to the exits is not through the atrium, exit access travel distance shall comply with Section 1017.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0250-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the two-way communication system is provided within areas of refuge in accordance with Section 1009."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0441-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
