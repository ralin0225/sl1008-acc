      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Gates serving the means of egress system shall comply with the requirements of this section."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.15",
