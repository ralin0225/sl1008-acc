      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3.4. The exterior walls and openings adjacent to the exterior exit stairway or ramp comply with Section 1023.7."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.8-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
