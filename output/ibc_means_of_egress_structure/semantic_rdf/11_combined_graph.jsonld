    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.14.1.2 Landings. Ramped aisles shall have landings in accordance with Sections 1012.6 through 1012.6.5. Landings for ramped aisles shall be permitted to overlap required aisles or cross aisles."
      }
