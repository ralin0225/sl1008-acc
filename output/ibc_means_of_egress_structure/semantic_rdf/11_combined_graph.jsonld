        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.3 Illumination. Exit signs shall be internally or externally illuminated."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0561",
