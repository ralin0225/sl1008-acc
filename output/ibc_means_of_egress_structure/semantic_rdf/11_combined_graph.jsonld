        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Alternating tread devices used as an element of a means of egress in buildings from a mezzanine area not more than 250 square feet (23 m2) in area that serves not more than five occupants shall have a minimum tread depth of 3 inches (76 mm) with a minimum projected tread depth of 101/2 inches (267 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1014.3.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
