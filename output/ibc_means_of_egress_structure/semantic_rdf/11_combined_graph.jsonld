      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a sign or other obstruction is mounted between posts or pylons and the clear distance between the posts or pylons is greater than 12 inches (305 mm), the lowest edge of such sign or obstruction shall be 27 inches (686 mm) maximum or 80 inches (2032 mm) minimum above the finished floor or ground."
      }
    ]
  },
