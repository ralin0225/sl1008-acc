    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are accessory to a Group R-3 occupancy or accessory to individual dwelling units in Group R-2 occupancies; handrails shall be Type I in accordance with Section 1014.3.1, Type II in accordance with Section 1014.3.2 or shall provide equivalent graspability."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0266-condition-1",
