      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 308
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.7.2 Other projections. Handrail projections shall be in accordance with the provisions of Section 1014.8. Other nonstructural projections such as trim and similar decorative features shall be permitted to project into the required width not more than 11/2 inches (38 mm) on each side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1012.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[46.797, 335.727, 289.808, 390.776]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Slope"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1012.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1012"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1012.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 329
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.2 Slope. Ramps used as part of a means of egress shall have a running slope not steeper than 1 unit vertical in 12 units horizontal (8.3-percent slope). The slope of other pedestrian ramps shall not be steeper than 1 unit vertical in 8 units horizontal (12.5-percent slope)."
      }
    ]
  },
