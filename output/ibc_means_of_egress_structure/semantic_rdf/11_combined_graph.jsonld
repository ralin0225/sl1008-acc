      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrails are not required where, at the side of the aisle, there is a guard with a top surface that complies with the graspability requirements of handrails in accordance with Section 1014.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0644",
