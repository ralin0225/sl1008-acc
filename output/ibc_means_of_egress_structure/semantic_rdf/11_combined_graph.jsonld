      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Cross aisles located more than 30 inches (762 mm) above the floor or grade below shall have guards in accordance with Section 1015."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0953-atomic-1",
    "@type": [
