      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Two-way communication systems are not required at the landing serving each elevator or bank of elevators where the two-way communication system is provided within areas of refuge in accordance with Section 1009.6.5."
      }
    ]
  },
