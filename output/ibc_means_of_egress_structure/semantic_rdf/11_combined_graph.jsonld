        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In a building, room or space used for assembly purposes where flexibility of the seating arrangement is an integral part of the design and function of the space and seating is on tiered levels, not more than 200 seats shall not be required to be fastened to the floor."
      }
    ]
  },
