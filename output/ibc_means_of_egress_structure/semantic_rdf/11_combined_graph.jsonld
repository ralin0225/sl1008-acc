        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1018.5 Aisles in other than assembly spaces and Groups B and M. In other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005.1 for the occupant load served, but the width shall be not less than that required for corridors by Section 1020.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0072-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Facilities with open-air assembly seating shall be permitted to the capacity factors in Section 1030.6.3 indicated for level or ramped aisles for means of egress components other than stairways where the entire path for means of egress from the seating to the exit discharge is open to the outdoors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0547-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Solid risers are not required for spiral stairways constructed in accordance with Section 1011.10."
      }
    ]
  },
  {
