      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.6 Egress convergence. Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger."
      }
    ]
  },
