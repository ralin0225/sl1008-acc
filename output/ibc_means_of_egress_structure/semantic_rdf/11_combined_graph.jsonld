    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where an incline platform lift or stairway chairlift is installed on stairways serving occupancies in Group R-3, or within dwelling units in occupancies in Group R-2, a clear passage width not less than 20 inches (508 mm) shall be provided."
      }
    ]
  },
