    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2.1. The entire area of the vestibule is separated from areas below by construction conforming to the fire-resistance rating of the interior exit stairway or ramp enclosure."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.15",
