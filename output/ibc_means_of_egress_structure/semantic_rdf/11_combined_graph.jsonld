    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.6 Externally illuminated exit signs. Externally illuminated exit signs shall comply with Sections 1013.6.1 through 1013.6.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.17.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
