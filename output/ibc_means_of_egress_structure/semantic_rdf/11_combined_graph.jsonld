      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where applicable, cumulative occupant loads from adjacent occupancies shall be considered to be in accordance with the provisions of Section 1004.1."
      }
    ]
  },
  {
