      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. In Group F occupancies where exit access stairways serve fewer than three stories and such stairways are not open to the public, and where the top of the guard also serves as a handrail, the top of the guard shall be not less than 34 inches (864 mm) and not more than 38 inches (965 mm) measured vertically from a line connecting the leading edges of the treads."
      }
    ]
  },
  {
