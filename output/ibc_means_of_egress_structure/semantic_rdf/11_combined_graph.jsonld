      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "topological"
      },
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.1 General. Interior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section. Interior exit stairways and ramps shall be enclosed and lead directly to the exterior of the building or shall be extended to the exterior of the building with an exit passageway conforming to the requirements of Section 1024, except as permitted in Section 1028.2. An interior exit stairway or ramp shall not be used for any purpose other than as a means of egress and a circulation path."
      }
    ]
  },
