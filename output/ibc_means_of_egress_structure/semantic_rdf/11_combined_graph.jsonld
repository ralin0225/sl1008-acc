      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. In open parking garages, exit access travel distance is permitted to be measured to the closest riser of an exit access stairway or the closest slope of an exit access ramp."
      }
    ]
  },
  {
