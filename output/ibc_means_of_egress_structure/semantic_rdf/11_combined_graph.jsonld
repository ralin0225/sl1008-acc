      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The forces required to open these doors manually shall not exceed those specified in Section 1010.1.3, except that the force to set the door in motion shall not exceed 50 pounds (220 N)."
      }
    ]
  },
