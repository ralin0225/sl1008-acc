  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0388-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The actuating portion of the releasing device shall extend not less than one-half of the door leaf width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.6-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Thresholds at doorways shall not exceed 3/4 inch (19.1 mm) in height above the finished floor or landing for sliding doors serving dwelling units or 1/2 inch (12.7 mm) above the finished floor or landing for other doors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1013.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[322.172, 150.581, 565.232, 264.653]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Low-level exit signs in Group R-1"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1013.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1013.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 330
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1013.2 Low-level exit signs in Group R-1. Where exit signs are required in Group R-1 occupancies by Section 1013.1, additional low-level exit signs shall be provided in all areas serving guest rooms in Group R-1 occupancies and shall comply with Section 1013.5. The bottom of the sign shall be not less than 10 inches (254 mm) nor more than 18 inches (455 mm) above the floor level. The sign shall be flush mounted to the door or wall. Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side."
      }
    ]
  },
  {
