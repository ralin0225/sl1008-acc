  {
    "@id": "https://example.org/ibc/2021/concept-exception-for-smoke-protected-or-open-air-assembly-seating-the-row-length-limits-for-a-12-inch-wide-305-mm-aisle-accessway-beyond-which-the-aisle-accessway-minimum-clear-width",
