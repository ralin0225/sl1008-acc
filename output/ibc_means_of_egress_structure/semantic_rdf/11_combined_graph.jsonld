    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Spaces under stairways serving and contained within a single residential dwelling unit in Group R-2 or R-3 shall be permitted to be protected on the enclosed side with 1/2-inch (12.7 mm) gypsum board."
      }
    ]
  },
  {
