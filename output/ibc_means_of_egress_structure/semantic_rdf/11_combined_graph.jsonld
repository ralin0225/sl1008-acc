    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The capacity of the refuge area shall be computed based on a net floor area allowance of 3 square feet (0.2787 m2) for each occupant to be accommodated therein."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.1.6",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[319.792, 290.677, 550.897, 378.822]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0316"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Thresholds"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.1.6"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0316"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 317
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.1.6 Thresholds. Thresholds at doorways shall not exceed 3/4 inch (19.1 mm) in height above the finished floor or landing for sliding doors serving dwelling units or 1/2 inch (12.7 mm) above the finished floor or landing for other doors. Raised thresholds and floor level changes greater than 1/4 inch (6.4 mm) at doorways shall be beveled with a slope not greater than one unit vertical in two units horizontal (50-percent slope)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.16",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
