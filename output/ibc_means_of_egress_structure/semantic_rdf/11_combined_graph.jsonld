      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings."
      }
