      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1020.5-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than one exit or exit access doorway is required, the exit access shall be arranged such that dead-end corridors do not exceed 20 feet (6096 mm) in length."
      }
    ]
  },
  {
