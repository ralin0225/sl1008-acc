    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1027.5 Location. Exterior exit stairways and ramps shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the stairway or ramps, including landings, to:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1001.1-atomic-1",
