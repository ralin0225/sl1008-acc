    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.2.1 Illumination level under normal power. The means of egress illumination level shall be not less than 1 footcandle (11 lux) at the walking surface. Along exit access stairways, exit stairways and at their required landings, the illumination level shall not be less than 10 footcandles (108 lux) at the walking surface when the stairway is in use."
      }
    ]
  },
