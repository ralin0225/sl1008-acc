      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The radius restriction shall not apply to curved stairways in Group R-3 and within individual dwelling units in Group R-2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
