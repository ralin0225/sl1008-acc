      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Openings in the exit passageway serving a smokeproof enclosure are permitted where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0979-condition-1",
