      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Within a dwelling unit, the use of a volute, turnout, starting easing or starting newel is allowed over the lowest tread."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
