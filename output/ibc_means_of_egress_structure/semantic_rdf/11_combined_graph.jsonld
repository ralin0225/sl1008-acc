    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.10.2 Transitions to stairways that do not maintain stepped aisle riser and tread dimensions. Transitions between stairways and stepped aisles having different riser and tread dimensions shall comply with Sections 1030.10.2.1 through 1030.10.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.3-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
