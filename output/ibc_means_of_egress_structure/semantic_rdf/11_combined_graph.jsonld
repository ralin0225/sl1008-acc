      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrails are permitted to project into the required width of stepped aisles and ramped aisles in accordance with Section 1014.8."
      }
    ]
  },
  {
