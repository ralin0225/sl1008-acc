      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Alternating tread devices shall have a minimum tread depth of 5 inches (127 mm), a minimum projected tread depth of 81/2 inches (216 mm), a minimum tread width of 7 inches (178 mm) and a maximum riser height of 91/2 inches (241 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-any-security-access-turnstile-lane-configuration-providing-a-clear-passage-width-of-32-inches-810-mm-or-more",
