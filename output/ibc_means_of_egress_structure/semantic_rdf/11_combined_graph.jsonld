      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.10.3 Transition marking. A distinctive marking stripe shall be provided at each nosing or leading edge adjacent to the transition. Such stripe shall be not less than 1 inch (25 mm), and not more than 2 inches (51 mm), wide. The edge marking stripe shall be distinctively different from the stepped aisle contrasting marking stripe."
      }
    ]
  },
