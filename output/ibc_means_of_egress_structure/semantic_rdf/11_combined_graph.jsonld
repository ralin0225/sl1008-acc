    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where the openings will not allow a 4-inch-diameter (102 mm) sphere to pass through the opening when the window is in its largest opened position."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.3.1-atomic-1",
