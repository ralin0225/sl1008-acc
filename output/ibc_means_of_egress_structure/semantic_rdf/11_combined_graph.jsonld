    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1018.4 Aisle accessways in Group M. An aisle accessway shall be provided on not less than one side of each element within the merchandise pad. The minimum clear width for an aisle accessway not required to be accessible shall be 30 inches (762 mm). The required clear width of the aisle accessway shall be measured perpendicular to the elements and merchandise within the merchandise pad. The 30-inch (762 mm) minimum clear width shall be maintained to provide a path to an adjacent aisle or aisle accessway. The common path of egress travel shall not exceed 30 feet (9144 mm) from any point in the merchandise pad."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1018.5-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In other than rooms or spaces used for assembly purposes and Group B and M occupancies, the minimum clear aisle capacity shall be determined by Section 1005.1 for the occupant load served, but the width shall be not less than that required for corridors by Section 1020.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0347",
