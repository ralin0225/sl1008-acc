        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A flight of stairs shall not have a vertical rise greater than 12 feet (3658 mm) between floor levels or landings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.8-atomic-1",
