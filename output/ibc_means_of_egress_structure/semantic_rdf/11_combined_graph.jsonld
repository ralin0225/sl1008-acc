      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. The fire barrier separating the smokeproof enclosure from the exit passageway is not required, provided that the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure."
      }
    ]
  },
  {
