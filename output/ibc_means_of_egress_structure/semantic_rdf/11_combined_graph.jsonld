        "@value": "numerical"
      },
      {
        "@value": "topological"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1014.9"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.9 Intermediate handrails. Stairways shall have intermediate handrails located in such a manner that all portions of the stairway minimum width or required capacity are within 30 inches (762 mm) of a handrail. On monumental stairs, handrails shall be located along the most direct path of egress travel."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0621-atomic-1",
