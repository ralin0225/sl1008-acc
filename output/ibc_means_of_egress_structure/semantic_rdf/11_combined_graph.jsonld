      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Elevated levels in Group U not open to the general public."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0957-atomic-1",
