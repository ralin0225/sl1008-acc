      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with greater than 200 seats, the seats shall be fastened together in groups of not less than three or the seats shall be securely fastened to the floor."
      }
    ]
  },
  {
