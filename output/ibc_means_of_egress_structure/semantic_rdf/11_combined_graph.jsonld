    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1017.3.2.2 Exit access travel distance at the level of exit discharge. Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017.2."
      }
    ]
  },
