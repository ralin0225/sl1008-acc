      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.2 Where required. Guards shall be located along open-sided walking surfaces, including mezzanines, equipment platforms, aisles, stairs, ramps and landings that are located more than 30 inches (762 mm) measured vertically to the floor or grade below at any point within 36 inches (914 mm) horizontally to the edge of the open side. Guards shall be adequate in strength and attachment in accordance with Section 1607.9."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.2-atomic-2",
