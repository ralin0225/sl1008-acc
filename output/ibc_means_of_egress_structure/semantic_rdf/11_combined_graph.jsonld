    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. The electric locks shall be arranged to unlock by a signal from or loss of power to the sensor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.7-atomic-2",
