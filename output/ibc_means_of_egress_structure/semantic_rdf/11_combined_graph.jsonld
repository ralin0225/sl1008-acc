        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. In Group I-1, Condition 2, Group I-2 or I-3 occupancies, the egress path from any point in the building shall pass through not more than two delayed egress locking systems provided that the combined delay does not exceed 30 seconds."
      }
    ]
  },
