      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Operable windows with sills located more than 72 inches (1829 mm) above finished grade or other surface below shall comply with Section 1015.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-for-smoke-protected-or-open-air-assembly-seating-the-common-path-of-egress-travel",
