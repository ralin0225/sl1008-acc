        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 339
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Membrane penetrations shall be permitted on the outside of the interior exit stairway and ramp. Such penetrations shall be protected in accordance with Section"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1025.2.6.3",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
