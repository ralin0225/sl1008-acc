    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In occupancies in Groups B, E, F, I-1, M, R-1, R- 2, S and U, where the building is equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1, the length of the dead-end corridors shall not exceed 50 feet (15 240 mm)."
      }
    ]
  },
  {
