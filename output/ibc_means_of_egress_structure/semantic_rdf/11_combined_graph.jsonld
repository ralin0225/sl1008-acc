      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Door openings to storage closets less than 10 square feet (0.93 m2) in area shall not be limited by the minimum clear opening width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1005.6",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
