      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Initiation of the irreversible process shall activate an audible signal in the vicinity of the door."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.12",
