    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0661"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In Group R-3 occupancies; within dwelling units in Group R-2 occupancies; and in Group U occupancies that are associated with a Group R-3 occupancy or associated with individual dwelling units in Group R-2 occupancies; where handrail fittings or bendings are used to provide continuous transition between flights, transition at winder treads, transition from handrail to guard, or where used at the start of a flight, the handrail height at the fittings or bendings shall be permitted to exceed the maximum height."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1023.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[46.807, 209.723, 289.849, 341.782]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0851"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Construction"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1023.2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0851"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 339
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.2 Construction. Enclosures for interior exit stairways and ramps shall be constructed as fire barriers in accordance with Section 707 or horizontal assemblies constructed in accordance with Section 711, or both. Interior exit stairway and ramp enclosures shall have a fire-resistance rating of not less than 2 hours where connecting four stories or more and not less than 1 hour where connecting less than four stories. The number of stories connected by the interior exit stairways or ramps shall include any basements, but not any mezzanines. Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4-measurement-2",
    "@type": [
      "https://example.org/ibc/ontology/Measurement"
