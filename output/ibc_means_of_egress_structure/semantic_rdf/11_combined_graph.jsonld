      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "10. Locking devices are permitted on doors to balconies, decks or other exterior spaces of 250 square feet (23.23 m2) or less serving a private office space."
      }
    ]
  },
  {
