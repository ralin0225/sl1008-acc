      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the difference in elevation is 6 inches (152 mm) or less, the ramp shall be equipped with either handrails or floor finish materials that contrast with adjacent floor finish materials."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1007.1.1-atomic-2",
