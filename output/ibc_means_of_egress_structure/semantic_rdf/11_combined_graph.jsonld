      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.7 Exterior areas for assisted rescue. Exterior areas for assisted rescue shall be accessed by an accessible route from the area served. Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009.7.1 through 1009.7.4."
      }
    ]
  },
