    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.11.2 Stepped aisle transitions at the top of vomitories. Transitions between the stepped aisle above a vomitory and stepped aisles to the side of a vomitory shall have a depth of not less than 11 inches (280 mm) or the stepped aisle tread depth, whichever is greater."
      }
