    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where mounted on the wall, the edge of the sign shall be within 4 inches (102 mm) of the door frame on the latch side."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.11-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where floor level signs are provided in interior exit stairways and ramps, a floorlevel sign identifying the floor level in visual characters, raised characters and braille complying with ICC A117."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0642",
