        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Emergency escape and rescue openings shall have a minimum net clear opening of 5.7 square feet (0.53 m2)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1014.1-atomic-1",
