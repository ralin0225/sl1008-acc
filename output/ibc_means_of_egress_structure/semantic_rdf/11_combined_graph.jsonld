    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The elevator shall be accessed from an area of refuge complying with Section 1009.6."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0283-atomic-1",
