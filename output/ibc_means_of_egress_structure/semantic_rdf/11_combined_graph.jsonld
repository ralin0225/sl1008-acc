      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1020.6.1 Corridor ceiling. Use of the space between the corridor ceiling and the floor or roof structure above as a return air plenum is permitted for one or more of the following conditions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In a building used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits for each level shall be permitted to be distributed around the perimeter of the building, provided that the total width of egress is not less than 100 percent of the required width."
      }
    ]
  },
  {
