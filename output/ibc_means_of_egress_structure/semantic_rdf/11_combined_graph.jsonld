        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8.6. The occupant load of the occupied exterior area shall not exceed 300 occupants in accordance with Section 1004."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0578-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a platform lift is in a stationary position and the floor of the platform lift serves as the upper landing of a stairway, handrails shall not be required on the stairway, provided that all of the following criteria are met:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.4-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0633",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0633"
