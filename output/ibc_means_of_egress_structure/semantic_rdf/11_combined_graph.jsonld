        "@value": "Exception: Handrails are permitted to protrude 41/2 inches (114 mm) from the wall or guard."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0353-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
