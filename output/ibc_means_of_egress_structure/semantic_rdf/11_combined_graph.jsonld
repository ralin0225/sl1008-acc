        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In other than Group I-2 and I-3 occupancies, floor openings containing exit access stairways or ramps shall be enclosed with a shaft enclosure constructed in accordance with Section 713."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0126-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Group R-3 and R-4 occupancies shall be permitted to have one exit or access to a single exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1023.4",
