    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1027.5 Location. Exterior exit stairways and ramps shall have a minimum fire separation distance of 10 feet (3048 mm) measured at right angles from the exterior edge of the stairway or ramps, including landings, to:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Side-hinged swinging doors, pivoted doors and balanced doors shall swing in the direction of egress travel where serving a room or area containing an occupant load of 50 or more persons or a Group H occupancy. "
      }
    ]
  },
  {
