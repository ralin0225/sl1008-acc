        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairways connecting stepped aisles to cross aisles or concourses shall be permitted to comply with the dimensional nonuniformity in Section 1030.14.2."
      }
    ]
  },
