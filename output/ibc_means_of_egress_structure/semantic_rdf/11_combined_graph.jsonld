      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "b. Group H occupancies equipped throughout with an automatic sprinkler system in accordance with Section 903.2.5."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1023.8",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[61.197, 524.752, 304.361, 590.837]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Barrier at level of exit discharge"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1023.8"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1023.9"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 340
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1023.8 Barrier at level of exit discharge. An interior exit stairway and ramp shall not continue below its level of exit discharge unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below. Directional exit signs shall be provided as specified in Section 1013."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9.4",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
