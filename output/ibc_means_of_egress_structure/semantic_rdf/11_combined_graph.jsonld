  {
    "@id": "https://example.org/ibc/2021/concept-occupantload",
    "@type": [
      "https://example.org/ibc/ontology/OccupantLoad"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "OccupantLoad"
      }
