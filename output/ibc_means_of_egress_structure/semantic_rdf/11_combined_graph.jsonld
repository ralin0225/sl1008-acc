        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Nosing projections of the leading edges shall be of uniform size, including the projections of the nosing’s leading edge of the floor at the top of a flight."
      }
    ]
  },
