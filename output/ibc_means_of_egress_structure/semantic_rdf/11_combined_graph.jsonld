    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.10 Edge protection. Edge protection complying with Section 1012.10.1 or 1012.10.2 shall be provided on each side of ramp runs and at each side of ramp landings."
      }
    ]
  },
  {
