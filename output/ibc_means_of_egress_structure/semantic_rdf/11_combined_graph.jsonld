        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the exit discharge does not include an accessible route from an exit located on the level of exit discharge to a public way, an exterior area of assisted rescue shall be provided on the exterior landing in accordance with Sections 1009.7.1 through 1009.7.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.8-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
