        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrails located on the side of stepped aisles shall return to a wall, guard or the walking surface or shall be continuous to the handrail of an adjacent stepped aisle flight."
      }
    ]
  },
  {
