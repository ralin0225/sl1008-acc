      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 304
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.2 Ceiling height. The means of egress shall have a ceiling height of not less than 7 feet 6 inches (2286 mm) above the finished floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.2-condition-3",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.16.2",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
