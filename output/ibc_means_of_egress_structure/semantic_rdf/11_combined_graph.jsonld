      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Elevators used as an accessible means of egress in accordance with Section 1009.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
