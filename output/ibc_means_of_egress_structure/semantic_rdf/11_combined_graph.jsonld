      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The area shall be located on the same lot not less than 50 feet (15 240 mm) away from the building requiring egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0754",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
