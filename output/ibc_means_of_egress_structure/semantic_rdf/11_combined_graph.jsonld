    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.5 Area wells. An emergency escape and rescue opening with the bottom of the clear opening below the adjacent grade shall be provided with an area well in accordance with Sections 1031.5.1 through 1031.5.3."
      }
    ]
  },
  {
