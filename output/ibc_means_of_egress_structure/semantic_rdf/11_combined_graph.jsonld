      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.6.1 Slope. Landings shall have a slope not steeper than one unit vertical in 48 units horizontal (2-percent slope) in any direction. Changes in level are not permitted."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0872-atomic-2",
