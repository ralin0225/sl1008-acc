    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.14.1 Handrails of alternating tread devices. Handrails shall be provided on both sides of alternating tread devices and shall comply with Section 1014."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4.3-condition-1",
