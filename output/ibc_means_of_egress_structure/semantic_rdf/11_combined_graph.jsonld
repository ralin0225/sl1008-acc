    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. An emergency stop switch shall be provided near each entry point of power or automatic operated revolving doors within 48 inches (1219 mm) of the door and between 34 inches (864 mm) and 48 inches (1219 mm) above the floor. The activation area of the emergency stop switch button shall be not less than 1 inch (25 mm) in diameter and shall be red."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0452",
