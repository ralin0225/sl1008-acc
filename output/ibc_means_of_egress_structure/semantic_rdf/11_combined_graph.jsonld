    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Emergency escape and rescue openings are not required from basements or sleeping rooms that have an exit door or exit access door that opens directly into a public way or to a yard, court or exterior egress balcony that opens to a public way."
