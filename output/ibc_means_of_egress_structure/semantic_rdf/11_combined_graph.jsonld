      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The separation distance to exit access stairways shall be measured to the closest riser."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4.2-atomic-3",
