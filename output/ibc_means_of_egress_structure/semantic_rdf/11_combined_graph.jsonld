      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stair treads and risers shall comply with Sections 1011.5.1 through 1011.5.5.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1011.6",
