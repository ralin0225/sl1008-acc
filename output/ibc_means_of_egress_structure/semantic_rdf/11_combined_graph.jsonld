      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A main exit of a Group A occupancy shall be permitted to have locking devices in accordance with Section 1010.2.4, Item 3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0344-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where egress doors are used in pairs, approved automatic flush bolts shall be permitted to be used, provided that the door leaf having the automatic flush bolts does not have a doorknob or surface-mounted hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0915-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
