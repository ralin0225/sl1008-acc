      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.9 Posting of occupant load. Every room or space that is an assembly occupancy shall have the occupant load of the room or space posted in a conspicuous place, near the main exit or exit access doorway from the room or space, for the intended configurations. Posted signs shall be of an approved legible permanent design and shall be maintained by the owner or the owner’s authorized agent."
      }
    ]
  },
