      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Such headroom shall be continuous above the stairway to the point where the line intersects the landing below, one tread depth beyond the bottom riser."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0080",
