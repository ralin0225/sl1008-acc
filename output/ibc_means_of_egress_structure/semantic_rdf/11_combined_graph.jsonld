        "@value": "[70.811, 180.699, 289.848, 257.82]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Emergency exit symbol"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1025.2.6.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1025.2.6"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1025.2.6.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 343
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.6.1 Emergency exit symbol. The doors shall be identified by a low-location luminous emergency exit symbol complying with NFPA 170. The exit symbol shall be not less than 4 inches (102 mm) in height and shall be mounted on the door, centered horizontally, with the top of the symbol not higher than 18 inches (457 mm) above the finished floor."
      }
    ]
  },
  {
