        "@value": 318
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8.3. The egress door locking device is readily distinguishable as locked and shall be a key-operated locking device."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0445",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
