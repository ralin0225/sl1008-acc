    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.3.1 General. In the event of power supply failure in rooms and spaces that require two or more exits or access to exits, an emergency electrical system shall automatically illuminate all of the following areas:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0822",
