      "https://example.org/ibc/ontology/AccessibleRoute"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AccessibleRoute"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.12.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The surface of aisles, stepped aisles and ramped aisles shall be of slip-resistant materials that are securely attached."
      }
    ]
  },
