      {
        "@value": "Exceptions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.5-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1087",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[82.813, 301.753, 289.841, 400.706]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1085"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1088"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 349
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Dead-end aisles longer than 16 rows are permitted where seats beyond the 16th row dead-end aisle are not more than 24 seats from another aisle, measured along a row of seats having a minimum clear width of 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row where seats have backrests or beyond 10 where seats are without backrests in the row."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0133",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[46.197, 362.302, 551.999, 371.07]"
      },
      {
        "@value": "[55.202, 370.222, 305.096, 378.99]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "a"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.3.4.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0134"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 311
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "a. Buildings classified as Group R-2 equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2 and provided with emergency escape and rescue openings in accordance with Section 1031."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0732",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
