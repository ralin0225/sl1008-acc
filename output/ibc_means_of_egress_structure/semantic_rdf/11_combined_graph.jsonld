      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "c. For a room or space used for assembly purposes having fixed seating, see Section 1030.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0837-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "not_required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Separation is not required where the exterior egress balcony is served by not less than two stairways and a dead-end travel condition does not require travel past an unprotected opening to reach a stairway."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0414",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
