      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a manual horizontal sliding door is required to latch, the latch or other mechanism shall prevent the door from rebounding into a partially open position when the door is closed."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1137-atomic-1",
