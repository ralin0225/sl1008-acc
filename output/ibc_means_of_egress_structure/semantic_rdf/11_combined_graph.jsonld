        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrail extensions are not required at the top and bottom of stepped aisles and ramped aisles to permit crossovers within the aisles."
      }
    ]
  },
  {
