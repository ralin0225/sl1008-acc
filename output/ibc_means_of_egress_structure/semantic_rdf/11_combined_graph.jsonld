        "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.3.1-condition-1"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "rule_validated"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      },
      {
        "@value": "topological"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.3.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.3.1 Occupant load. Where stairways serve more than one story, or more than one story and an occupied roof, only the occupant load of each story or occupied roof, considered individually, shall be used when calculating the required number of exits or access to exits serving that story."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1024.9-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where required by Sections 905."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1031.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In addition to the means of egress required by this chapter, emergency escape and rescue openings shall be provided in the following occupancies:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.14.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Aisles with a slope exceeding one unit vertical in eight units horizontal (12.5-percent slope) shall consist of a series of risers and treads that extends across the full width of aisles and complies with Sections 1030.14.2.1 through 1030.14.2.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0281-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Door openings required to be accessible within Type B units intended for user passage shall have a minimum clear opening width of 31.75 inches (806 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0393",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
