    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.6.3 Length. The landing length shall be 60 inches (1525 mm) minimum."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0729-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the path of exit access travel passes through an enclosed elevator lobby, the level of protection required for the enclosed elevator lobby is not required to be extended to the exit unless direct access to an exit is required by other sections of this code."
      }
    ]
  },
