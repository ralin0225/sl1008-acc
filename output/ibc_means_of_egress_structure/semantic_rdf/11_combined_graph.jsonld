      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Handrails for alternating tread devices and ships ladders are permitted to terminate at a location vertically above the top and bottom risers. Handrails for alternating tread devices are not required to be continuous between flights or to extend beyond the top or bottom risers."
      }
    ]
  },
  {
