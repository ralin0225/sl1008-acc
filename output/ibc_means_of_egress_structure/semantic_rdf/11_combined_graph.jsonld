      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For smoke-protected or open-air assembly seating, the row length limits for a 12-inch-wide (305 mm) aisle accessway, beyond which the aisle accessway minimum clear width shall be increased, are in Table 1030.13.2.1."
      }
    ]
  },
  {
