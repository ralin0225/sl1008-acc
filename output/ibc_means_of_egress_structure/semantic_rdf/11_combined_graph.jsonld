      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. A dispersal area shall be illuminated to a level not less than 1 footcandle (11 lux) at the walking surface."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.5",
