    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1008.2.3 Exit discharge. Illumination shall be provided along the path of travel for the exit discharge from each exit to the public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1003.3.2-condition-2",
