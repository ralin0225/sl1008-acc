    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1016.1 General. The exit access shall comply with the applicable provisions of Sections 1003 through 1015. Exit access arrangement shall comply with Sections 1016 through 1021."
      }
    ]
  },
