    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Egress from a room or space shall not pass through adjoining or intervening rooms or areas, except where such adjoining rooms or areas and the area served are accessory to one or the other, are not a Group H occupancy and provide a discernible path of egress travel to an exit."
      }
    ]
  },
