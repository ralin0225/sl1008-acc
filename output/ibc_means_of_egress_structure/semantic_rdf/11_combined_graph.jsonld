      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairways shall either incorporate an area of refuge within an enlarged floor-level landing or shall be accessed from an area of refuge complying with Section 1009.6."
      }
    ]
  },
