      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Flights of stairways within dwelling units and flights of spiral stairways are permitted to have a handrail on one side only."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.7.2",
