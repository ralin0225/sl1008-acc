    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.11 Instructions. In areas of refuge and exterior areas for assisted rescue, instructions on the use of the area under emergency conditions shall be posted. Signage shall comply with the ICC A117.1 requirements for visual characters. The instructions shall include all of the following:"
      }
    ]
  },
