    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "rule_validated"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1004.4"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1004.4 Multiple occupancies. Where a building contains two or more occupancies, the means of egress requirements shall apply to each portion of the building based on the occupancy of that space. Where two or more occupancies utilize portions of the same means of egress system, those egress components shall meet the more stringent requirements of all occupancies that are served."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.2.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[334.199, 538.799, 565.297, 604.764]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Glazing"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1015.2.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015.2"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015.3"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 332
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.2.1 Glazing. Where glass is used to provide a guard or as a portion of the guard system, the guard shall comply with Section 2407. Where the glazing provided does not meet the strength and attachment requirements of Section 1607.9, complying guards shall be located along glazed sides of open-sided walking surfaces."
      }
    ]
  },
