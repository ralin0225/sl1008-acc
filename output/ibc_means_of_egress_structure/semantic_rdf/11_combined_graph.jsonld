      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "rule_validated"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1006.2.1.1"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2.1.1 Three or more exits or exit access doorways. Three exits or exit access doorways shall be provided from any space with an occupant load of 501 to 1,000. Four exits or exit access doorways shall be provided from any space with an occupant load greater than 1,000."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.8.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[334.214, 106.721, 565.259, 194.638]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1067"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Path through adjacent row"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1030.8.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.8"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1067"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 348
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.8.1 Path through adjacent row. Where one of the two paths of travel is across the aisle through a row of seats to another aisle, there shall be not more than 24 seats between the two aisles, and the minimum clear width between rows for the row between the two aisles shall be 12 inches (305 mm) plus 0.6 inch (15.2 mm) for each additional seat above seven in the row between aisles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0857-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A combination of interior exit stairways, interior exit ramps and exit passageways, constructed in accordance with Sections 1023.2, 1023.3.1 and 1024, respectively, and forming a continuous protected enclosure, shall be permitted to extend an interior exit stairway or ramp to the exit discharge or a public way."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0369-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Stairway exit doors are permitted to be locked from the side opposite the egress side, provided that they are openable from the egress side and capable of being unlocked simultaneously without unlatching upon a signal from the fire command center, if present, or a signal by emergency personnel from a single location inside the main entrance to the building."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.12.2-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where a stairway is provided to a roof, access to the roof shall be provided through a penthouse complying with Section 1511."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1029.2",
