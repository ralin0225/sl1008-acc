      {
        "@value": "1. Group B, F, I, M, R, S and U occupancies."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0584-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
