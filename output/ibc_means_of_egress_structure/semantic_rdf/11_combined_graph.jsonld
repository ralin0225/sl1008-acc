    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.8 Locking arrangements in educational occupancies. In Group E occupancies, Group B educational occupancies and Group I-4 occupancies, egress doors from classrooms, offices and other occupied rooms with locking arrangements designed to keep intruders from entering the room shall comply with all of the following conditions:"
      }
    ]
  },
