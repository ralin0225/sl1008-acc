    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Variations in elevation due to differences in finish materials, but not more than 1/2 inch (12.7 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.3-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
