      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.7 Clearance. Clear space between a handrail and a wall or other surface shall be not less than 11/2 inches (38 mm). A handrail and a wall or other surface adjacent to the handrail shall be free of any sharp or abrasive elements."
      }
    ]
  },
