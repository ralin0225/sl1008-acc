        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The bottom of the sign shall be located not less than 5 feet (1524 mm) above the floor landing in a position that is readily visible when the doors are in the open and closed positions."
      }
    ]
  },
  {
