        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Steps, landings and the sides of ramps shall be permitted to be marked with self-luminous materials in accordance with Sections 1025.2.1, 1025.2.2 and 1025.2.4 by systems listed in accordance with UL 1994."
      }
    ]
  },
