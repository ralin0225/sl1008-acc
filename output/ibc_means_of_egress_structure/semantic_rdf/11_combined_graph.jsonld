    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Corridors serving as an exit access component in a means of egress system shall comply with the requirements of Sections 1020.2 through 1020.7."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.6.2-atomic-2",
