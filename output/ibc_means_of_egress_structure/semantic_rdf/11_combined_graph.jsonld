      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Risers shall be solid and vertical or sloped under the tread above from the underside of the nosing above at an angle not more than 30 degrees (0.52 rad) from the vertical."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-nosing-and-riser-profile",
    "@type": [
      "https://example.org/ibc/ontology/DomainConcept"
