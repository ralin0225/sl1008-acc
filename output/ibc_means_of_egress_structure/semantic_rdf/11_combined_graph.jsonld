      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where winders are adjacent within the flight, the point of the widest clear stair width of the adjacent winders shall be used."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.7.3-atomic-1",
