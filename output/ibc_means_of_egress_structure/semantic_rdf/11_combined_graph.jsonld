        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A fire-resistance rating is not required at horizontal exits between a building area and an abovegrade pedestrian walkway constructed in accordance with Section 3104, provided that the distance between connected buildings is more than 20 feet (6096 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.13-atomic-2",
