    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 347
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.6.3 Open-air assembly seating. In open-air assembly seating, the required capacity in inches (mm) of aisles shall be not less than the total occupant load served by the egress element multiplied by 0.08 (2.0 mm) where egress is by stepped aisle and multiplied by 0.06 (1.52 mm) where egress is by level aisles and ramped aisles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ch10-table-p003-01",
