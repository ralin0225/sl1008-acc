        "@id": "https://example.org/ibc/2021/ibc2021-1006.3.4"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0370"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Stairway exit doors shall be openable from the egress side and shall only be locked from the opposite side in Group B, F, M and S occupancies where the only interior access to the tenant space is from a single exit stairway where permitted in Section 1006.3.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.1.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.199, 69.725, 304.303, 245.742]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.1.1.1"
      },
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0272"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Size of doors"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.1.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.1"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0272"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 316
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.1.1 Size of doors. The required capacity of each door opening shall be sufficient for the occupant load thereof and shall provide a minimum clear opening width of 32 inches (813 mm). The clear opening width of doorways with swinging doors shall be measured between the face of the door and the stop, with the door open 90 degrees (1.57 rad). Where this section requires a minimum clear opening width of 32 inches (813 mm) and a door opening includes two door leaves without a mullion, one leaf shall provide a minimum clear opening width of 32 inches (813 mm). In Group I-2, doors serving as means of egress doors where used for the movement of beds shall provide a minimum clear opening width of 411/2 inches (1054 mm). The minimum clear opening height of doors shall be not less than 80 inches (2032 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.8.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.199, 189.703, 304.212, 266.823]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Window opening control devices"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1015.8.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015.8"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1016"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 334
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.8.1 Window opening control devices. Window opening control devices shall comply with ASTM F2090. The window opening control device, after operation to release the control device allowing the window to fully open, shall not reduce the minimum net clear opening area of the window unit to less than the area required by Section 1031.3.1."
      }
    ]
  },
  {
