        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.005"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1030.14.2.2.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
