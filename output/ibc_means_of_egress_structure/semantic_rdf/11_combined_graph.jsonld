    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Openings in the exit passageway serving a smokeproof enclosure are permitted where the exit passageway is protected and pressurized in the same manner as the smokeproof enclosure, and openings are protected as required for access from other floors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.1.4",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[58.797, 296.713, 289.838, 362.798]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
