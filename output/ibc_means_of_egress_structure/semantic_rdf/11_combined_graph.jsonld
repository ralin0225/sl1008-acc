      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The breakout force of a revolving door not used as a component of a means of egress shall not be more than 180 pounds (801 N)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.13.1.1-measurement-1",
