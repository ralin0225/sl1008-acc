    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. In a building, room or space used for assembly purposes or portions thereof with seating at tables and without ramped or tiered floors for seating, the seats shall not be required to be fastened to the floor."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1003.6",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.787, 223.692, 550.92, 322.645]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Means of egress continuity"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1003.6"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1003"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1003.7"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 305
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.6 Means of egress continuity. The path of egress travel along a means of egress shall not be interrupted by a building element other than a means of egress component as specified in this chapter. Obstructions shall not be placed in the minimum width or required capacity of a means of egress component except projections permitted by this chapter. The minimum width or required capacity of a means of egress system shall not be diminished along the path of egress travel."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0723",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[73.199, 116.756, 304.161, 149.733]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015.8"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0724"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 334
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3. Operable windows where the openings are provided with window fall prevention devices that comply with ASTM F2090."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1021.3-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The long side of an egress balcony shall be not less than 50 percent open, and the open area above the guards shall be so distributed as to minimize the accumulation of smoke or toxic gases."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.16-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
