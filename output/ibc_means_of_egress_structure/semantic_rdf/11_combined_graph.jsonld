    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0431"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0436"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 322
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. A building occupant shall not be required to pass through more than one door equipped with a controlled egress locking system before entering an exit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.3-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
