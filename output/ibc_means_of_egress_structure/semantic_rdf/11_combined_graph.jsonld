        "@value": 307
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.3.2 Other egress components. The capacity, in inches, of means of egress components other than stairways shall be calculated by multiplying the occupant load served by such component by a means of egress capacity factor of 0.2 inch (5.1 mm) per occupant."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-1188-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
