        "@value": "equal_or_context_dependent"
      }
    ],
    "https://example.org/ibc/ontology/unitCode": [
      {
        "@value": "IN"
      }
    ],
    "https://example.org/ibc/ontology/value": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "30.0"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.2.9.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
