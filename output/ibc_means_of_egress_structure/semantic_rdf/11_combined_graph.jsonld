      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Edges shall have a minimum radius of 0.01 inch (0.25 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0354-atomic-1",
