      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.7 Ramp construction. Ramps shall be built of materials consistent with the types permitted for the type of construction of the building, except that wood handrails shall be permitted for all types of construction."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0302",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
