    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Landing length in the direction of travel in Groups R-3 and U and within individual units of Group R-2 need not exceed 36 inches (914 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.14.2-measurement-1",
