      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Egress convergence"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1005.6"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1005"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1005.7"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 308
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1005.6 Egress convergence. Where the means of egress from stories above and below converge at an intermediate level, the capacity of the means of egress from the point of convergence shall be not less than the largest minimum width or the sum of the required capacities for the stairways or ramps serving the two adjacent stories, whichever is larger."
      }
    ]
  },
