    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3.1. The locking device is readily distinguishable as locked."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4.1-atomic-4",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
