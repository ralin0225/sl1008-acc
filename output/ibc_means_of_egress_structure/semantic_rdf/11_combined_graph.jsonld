      },
      {
        "@id": "https://example.org/ibc/2021/concept-occupantload"
      }
    ],
    "https://example.org/ibc/ontology/confidence": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.93"
      }
    ],
    "https://example.org/ibc/ontology/hasAtomicRule": [
