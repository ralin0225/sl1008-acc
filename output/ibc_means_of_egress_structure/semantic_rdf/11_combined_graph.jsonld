        "@value": "27.0"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0282-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
