      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.5.3 Winder treads. Winder treads are not permitted in means of egress stairways except within a dwelling unit."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.2.3-condition-2",
