        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Group I-3, door openings to resident sleeping units that are not required to be an Accessible unit shall have a minimum clear opening width of 28 inches (711 mm)."
      }
    ]
  },
  {
