    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.9.6.1 Assembly aisle obstructions. There shall not be obstructions in the minimum width or required capacity of aisles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.10.2.2-atomic-1",
