      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. Exit signs are not required in dayrooms, sleeping rooms or dormitories in occupancies in Group I-3."
      }
    ]
  },
  {
