        "@value": 354
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.5.2.1 Ladders. Ladders or rungs shall have an inside width of at least 12 inches (305 mm), shall project at least 3 inches (76 mm) from the wall and shall be spaced not more than 18 inches (457 mm) on center (o.c.) vertically for the full height of the area well."
      }
    ]
  },
