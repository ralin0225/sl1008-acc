      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The minimum dimensions of means of egress ramps shall comply with Sections 1012.5.1 through 1012.5.3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.1-atomic-3",
    "@type": [
