      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0476"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. The door assembly shall comply with the applicable fire protection rating and, where rated, shall be self-closing or automatic closing by smoke detection in accordance with Section 716.2.6.6, shall be installed in accordance with NFPA 80 and shall comply with Section 716."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1017.3.2.1",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
