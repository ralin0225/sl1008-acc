        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 314
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: The fire-resistance rating and opening protectives are not required in the exterior wall where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.6.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
