    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Activation of the building fire alarm system, where provided, shall automatically unlock the electric lock, and the electric lock shall remain unlocked until the fire alarm system has been reset."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1035",
