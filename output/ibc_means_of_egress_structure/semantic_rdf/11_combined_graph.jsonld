    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.2.6 Doors within the exit path. Doors through which occupants must pass in order to complete the exit path shall be provided with markings complying with Sections 1025.2.6.1 through 1025.2.6.3."
      }
    ]
  },
  {
