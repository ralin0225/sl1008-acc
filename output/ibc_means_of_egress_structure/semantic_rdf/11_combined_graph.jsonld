      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "[F] 1002.2 Fire safety and evacuation plans. Fire safety and evacuation plans shall be provided for all occupancies and buildings where required by the International Fire Code. Such fire safety and evacuation plans shall comply with the applicable provisions of Sections 401.2 and 404 of the International Fire Code."
      }
    ]
  },
