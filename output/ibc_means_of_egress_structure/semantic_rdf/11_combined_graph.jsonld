    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the roof hatch opening providing the required access is located within 10 feet (3049 mm) of the roof edge, such roof access or roof edge shall be protected by guards installed in accordance with Section 1015."
      }
    ]
  },
