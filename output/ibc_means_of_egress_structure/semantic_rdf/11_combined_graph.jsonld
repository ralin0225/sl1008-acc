    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1001.1 General. Buildings or portions thereof shall be provided with a means of egress system as required by this chapter. The provisions of this chapter shall control the design, construction and arrangement of means of egress components required to provide an approved means of egress from structures and portions thereof."
      }
    ]
  },
