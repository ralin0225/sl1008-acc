      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exceptions:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0190-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In assembly areas with ramped aisles or stepped aisles, one accessible means of egress is permitted where the common path of egress travel is accessible and meets the requirements in Section 1030.8."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1161",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[358.201, 691.804, 565.23, 713.866]"
      },
      {
        "@value": "[100.799, 69.725, 289.771, 113.738]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "2"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-1159"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1030.17.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 352
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 353
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Bleachers, grandstands and folding and telescopic seating shall not be required to have perimeter guards where the seating is located adjacent to a wall and the space between the wall and the seating is less than 4 inches (102 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.13-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Guards shall be provided along stairways and landings where required by Section 1015 and shall be constructed in accordance with Section 1015."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0403-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Ready access shall be provided to the manual unlocking device and the device shall be clearly identified by a sign that reads “PUSH TO EXIT.” When operated, the manual unlocking device shall result in direct interruption of power to the electric lock—independent of other electronics—and the electric lock shall remain unlocked for not less than 30 seconds."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0731",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0731"
      }
    ],
    "https://example.org/ibc/ontology/confidence": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.78"
      }
    ],
    "https://example.org/ibc/ontology/hasAtomicRule": [
      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0731-atomic-1"
      }
    ],
    "https://example.org/ibc/ontology/hasCondition": [
      {
        "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-exception-0731-condition-1"
      }
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "unspecified"
      }
    ],
    "https://example.org/ibc/ontology/reviewStatus": [
      {
        "@value": "unreviewed"
      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0731"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exception"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Means of egress are not prohibited through adjoining or intervening rooms or spaces in a Group H, S or F occupancy where the adjoining or intervening rooms or spaces are the same or a lesser hazard occupancy group."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.4-atomic-3",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where two or more exits or access to exits are required, not more than onehalf of the exits or exit access doorways shall be equipped with horizontal sliding or vertical security grilles."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1011.5.4.1-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the bottom or top riser adjoins a sloping public way, walkway or driveway having an established grade and serving as a landing, the bottom or top riser is permitted to be reduced along the slope to less than 4 inches (102 mm) in height, with the variation in height of the bottom or top riser not to exceed one unit vertical in 12 units horizontal (8-percent slope) of stair width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0705",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[70.781, 312.789, 289.806, 378.754]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "5"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0700"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0706"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 333
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Along alternating tread devices and ships ladders, guards where the top rail serves as a handrail shall have height not less than 30 inches (762 mm) and not more than 34 inches (864 mm), measured vertically from the leading edge of the device tread nosing."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0458-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each revolving door shall be credited with a capacity based on not more than a 50-person occupant load."
      }
    ]
  },
  {
