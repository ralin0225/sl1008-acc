        "@value": 327
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.7.4 Enclosures under exterior stairways. There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1hour fire-resistance-rated construction. The open space under exterior stairways shall not be used for any purpose."
      }
    ]
  },
