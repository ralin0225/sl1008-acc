      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Additional required exit or exit access doorways shall be arranged a reasonable distance apart so that if one becomes blocked, the others will be available."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-the-area",
