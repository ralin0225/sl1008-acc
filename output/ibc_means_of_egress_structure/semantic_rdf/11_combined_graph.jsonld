        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The required capacity of exit passageways shall be determined as specified in Section 1005.1 but the minimum width shall be not less than 44 inches (1118 mm), except that exit passageways serving an occupant load of less than 50 shall be not less than 36 inches (914 mm) in width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0321-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In Type B units, where Exception 5 to Section 1010.1.4 permits a 4-inch (102 mm) elevation change at the door, the threshold height on the exterior side of the door shall not exceed 43/4 inches (120 mm) in height above the exterior deck, patio or balcony for sliding doors or 41/2 inches (114 mm) above the exterior deck, patio or balcony for other doors."
      }
    ]
  },
  {
