    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1007.1 General. Exits, exit access doorways, and exit access stairways and ramps serving spaces, including individual building stories, shall be separated in accordance with the provisions of this section."
      }
    ]
  },
