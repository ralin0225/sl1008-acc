  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0417-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "An attempt to egress shall initiate an irreversible process that shall allow such egress in not more than 15 seconds when a physical effort to exit is applied to the egress side door hardware for not more than 3 seconds."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0064",
