        "@value": "logical"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009.7.3"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.7.3 Openness. The exterior area for assisted rescue shall be open to the outside air. The sides other than the separation walls shall be not less than 50 percent open, and the open area shall be distributed so as to minimize the accumulation of smoke or toxic gases."
      }
    ]
  },
  {
