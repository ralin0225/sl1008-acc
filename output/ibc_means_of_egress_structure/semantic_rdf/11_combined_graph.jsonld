      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Gates in the means of egress shall comply with the requirements of Sections 1010.4 and 1010.4.1."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0370",
