    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1006.2.2 Egress based on use. The numbers, configuration and types of components of exits or access to exits shall be provided in the uses described in Sections 1006.2.2.1 through 1006.2.2.6."
      }
    ]
  },
