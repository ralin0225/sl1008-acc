      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-1033"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 347
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0877",
