      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.11 Handrails. Flights of stairways shall have handrails on each side and shall comply with Section 1014. Where glass is used to provide the handrail, the handrail shall comply with Section 2407."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1006.2.2.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "required"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Two exit access doorways are required in boiler, incinerator and furnace rooms where the area is over 500 square feet (46 m2) and any fuel-fired equipment exceeds 400,000 British thermal units (Btu) (422 000 KJ) input capacity."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1015.7",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[307.782, 443.706, 550.88, 542.778]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0719"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Roof access"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1015.7"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1015"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0719"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 333
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1015.7 Roof access. Guards shall be provided where the roof hatch opening is located within 10 feet (3048 mm) of a roof edge or open side of a walking surface and such edge or open side is located more than 30 inches (762 mm) above the floor, roof or grade below. The guard shall extend not less than 30 inches (762 mm) beyond each end of the hatch parallel to the roof edge. The guard shall be constructed so as to prevent the passage of a sphere 21 inches (533 mm) in diameter."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1022.2.2-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exterior exit doors shall lead directly to the exit discharge or the public way."
      }
    ]
  },
  {
