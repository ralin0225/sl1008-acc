      }
    ],
    "https://example.org/ibc/ontology/ruleType": [
      {
        "@value": "logical"
      },
      {
        "@value": "topological"
      }
    ],
    "https://example.org/ibc/ontology/sourceNode": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0550"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1. Where stairways connect stepped aisles to cross aisles or concourses, stairway landings are not required at the transition between stairways and stepped aisles constructed in accordance with Section 1030."
      }
    ]
  },
