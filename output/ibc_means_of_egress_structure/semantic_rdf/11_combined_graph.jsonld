      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1014.5 Fittings. Handrails shall not rotate within their fittings."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1009.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[46.797, 259.752, 289.878, 336.753]"
      }
    ],
    "https://example.org/ibc/ontology/hasChild": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0188"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Accessible means of egress required"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1009.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1009"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0188"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 313
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1009.1 Accessible means of egress required. Accessible means of egress shall comply with this section. Accessible spaces shall be provided with not less than one accessible means of egress. Where more than one means of egress is required by Section 1006.2 or 1006.3 from any accessible space, each accessible portion of the space shall be served by not less than two accessible means of egress."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1030.14.2.2.1-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the stepped aisle is designed in accordance with Exception 1 of Section 1030.14.2.2, the stepped aisle shall be constructed so that each riser of unequal height, determined in the direction of descent, is not more than 3/8 inch (9.5 mm) in height different from adjacent risers where stepped aisle treads are less than 22 inches (560 mm) in depth and 3/4 inch (19.1 mm) in height different from adjacent risers where stepped aisle treads are 22 inches (560 mm) or greater in depth."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0451",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0451"
      }
    ],
    "https://example.org/ibc/ontology/appliesTo": [
      {
        "@id": "https://example.org/ibc/2021/concept-stairway"
      },
      {
        "@id": "https://example.org/ibc/2021/concept-door"
      }
    ],
    "https://example.org/ibc/ontology/confidence": [
