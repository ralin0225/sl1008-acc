    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.6.2.3 Automatic sprinklers. Enclosed areas with walls and ceilings in buildings or structures containing smoke-protected assembly seating shall be protected with an approved automatic sprinkler system in accordance with Section 903.3.1.1."
      }
