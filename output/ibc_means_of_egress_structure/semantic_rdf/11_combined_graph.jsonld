      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.9 Curved stairways. Curved stairways with winder treads shall have treads and risers in accordance with Section 1011.5 and the smallest radius shall be not less than twice the minimum width or required capacity of the stairway."
      }
    ]
  },
  {
