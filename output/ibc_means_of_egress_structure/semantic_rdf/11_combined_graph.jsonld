      {
        "@value": "exemption"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Areas of refuge are not required at stairways in Group R-2 occupancies."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0218-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
