      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Handrail brackets or balusters attached to the bottom surface of the handrail that do not project horizontally beyond the sides of the handrail within 11/2 inches (38 mm) of the bottom of the handrail shall not be considered obstructions."
      }
    ]
  },
  {
