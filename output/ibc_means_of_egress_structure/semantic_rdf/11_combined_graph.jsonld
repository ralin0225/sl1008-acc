      {
        "@value": "may"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Flights of stairways within dwelling units and flights of spiral stairways are permitted to have a handrail on one side only."
      }
    ]
  },
  {
