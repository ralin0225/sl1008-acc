      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.8 Common path of egress travel. The common path of egress travel shall not exceed 30 feet (9144 mm) from any seat to a point where an occupant has a choice of two paths of egress travel to two exits."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1027.2-atomic-1",
