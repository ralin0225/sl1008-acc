      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Headroom"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1003.3.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1003.3"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0023"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 304
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 305
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1003.3.1 Headroom. Protruding objects are permitted to extend below the minimum ceiling height required by Section 1003.2 where a minimum headroom of 80 inches (2032 mm) is provided over any circulation paths, including walks, corridors, aisles and passageways. Not more than 50 percent of the ceiling area of a means of egress shall be reduced in height by protruding objects."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.3.2-atomic-6",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Low-energy poweroperated sliding doors and low-energy power-operated folding doors shall comply with BHMA A156.38."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0341",
