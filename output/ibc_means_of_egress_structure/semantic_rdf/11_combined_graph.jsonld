        "@value": 316
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "8. In Groups I-1, R-2, R-3 and R-4, in dwelling and sleeping units that are not required to be Accessible, Type A or Type B units, the minimum clear opening widths shall not apply to interior egress doors."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0814-atomic-1",
