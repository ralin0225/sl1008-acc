        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "In facilities with smoke-protected assembly seating, the total exit access travel distance shall be not greater than 400 feet (122 m)."
      }
    ]
  },
