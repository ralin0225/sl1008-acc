    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1025.5 Illumination. Where photoluminescent exit path markings are installed, they shall be provided with not less than 1 footcandle (11 lux) of illumination for not less than 60 minutes prior to periods when the building is occupied and continuously during occupancy."
      }
    ]
