        "@value": "shall"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Each turnstile or similar device shall be credited with a capacity based on not more than a 50person occupant load where all of the following provisions are met:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1013.6.3",
    "@type": [
      "https://example.org/ibc/ontology/Requirement"
