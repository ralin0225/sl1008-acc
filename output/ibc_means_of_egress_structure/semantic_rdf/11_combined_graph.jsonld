      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The activation area of the emergency stop switch button shall be not less than 1 inch (25 mm) in diameter and shall be red."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1012.10.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
