    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Approved luminous egress path markings delineating the exit path shall be provided in high-rise buildings of Group A, B, E, I-1, M or R-1 occupancies in accordance with this section."
      }
    ]
  },
