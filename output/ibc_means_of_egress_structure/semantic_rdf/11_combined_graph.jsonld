    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where the path of egress travel is through an atrium space, exit access travel distance at the level of exit discharge shall be determined in accordance with Section 1017.2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0734-atomic-1",
