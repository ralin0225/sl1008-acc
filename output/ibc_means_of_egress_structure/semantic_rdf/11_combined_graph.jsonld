    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Means of egress are not prohibited through adjoining or intervening rooms or spaces in a Group H, S or F occupancy where the adjoining or intervening rooms or spaces are the same or a lesser hazard occupancy group."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1015.6-measurement-1",
