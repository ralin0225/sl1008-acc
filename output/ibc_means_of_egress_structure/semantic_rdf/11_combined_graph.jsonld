  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1005.5-condition-1",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where more than one exit, or access to more than one exit, is required, the means of egress shall be configured such that the loss of any one exit, or access to one exit, shall not reduce the available capacity or width to less than 50 percent of the required capacity or width."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1026.4-atomic-2",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
