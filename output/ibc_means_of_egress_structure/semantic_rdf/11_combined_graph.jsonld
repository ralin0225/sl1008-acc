    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6. Electrical raceway serving the exit passageway and terminating at a steel box not exceeding 16 square inches (0.010 m2). Such penetrations shall be protected in accordance with Section 714. There shall not be penetrations or communicating openings, whether protected or not, between adjacent exit passageways."
      }
