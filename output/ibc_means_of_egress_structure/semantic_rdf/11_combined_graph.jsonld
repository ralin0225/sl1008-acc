      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Enclosures under interior stairways"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1011.7.3"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1011.7"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0564"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 327
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1011.7.3 Enclosures under interior stairways. The walls and soffits within enclosed usable spaces under enclosed and unenclosed stairways shall be protected by 1-hour fire-resistance-rated construction or the fire-resistance rating of the stairway enclosure, whichever is greater. Access to the enclosed space shall not be directly from within the stairway enclosure."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0704",
    "@type": [
      "https://example.org/ibc/ontology/ListItem"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[70.781, 287.71, 289.828, 309.771]"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "4"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-exception-0700"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-ch10-list_item-0705"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 333
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "4. The guard height in assembly seating areas shall comply with Section 1030.17 as applicable."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0371-condition-2",
    "@type": [
      "https://example.org/ibc/ontology/Condition"
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "where permitted in Section 1006."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0348-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
    "https://example.org/ibc/ontology/modality": [
      {
        "@value": "must"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Other than egress courts, where occupants must egress from an exterior space through the building for means of egress, exit access doors shall be permitted to be equipped with an approved locking device where installed and operated in accordance with all of the following:"
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/concept-spaces-under-grandstands-and-bleachers-spaces-under-grandstands-or-bleachers",
