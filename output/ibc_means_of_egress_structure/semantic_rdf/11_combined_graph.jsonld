      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exception: Landing length in the direction of travel in Groups R-3 and U and within individual units of Group R-2 need not exceed 36 inches (914 mm)."
      }
    ]
  },
