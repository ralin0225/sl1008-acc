    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "A step is permitted in aisles serving seating that has a difference in elevation less than 12 inches (305 mm) at locations not required to be accessible by Chapter 11, provided that the risers and treads comply with Section 1030.14 and the aisle is provided with a handrail complying with Section 1030.16."
      }
    ]
  },
