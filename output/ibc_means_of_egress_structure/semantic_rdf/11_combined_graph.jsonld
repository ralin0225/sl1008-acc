        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Exterior exit stairways and ramps serving as an exit component in a means of egress system shall comply with the requirements of this section."
      }
    ]
  },
  {
