      {
        "@value": "declarative"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "2. Care suites in Group I-2 occupancies complying with Section 407.4."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1150-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
