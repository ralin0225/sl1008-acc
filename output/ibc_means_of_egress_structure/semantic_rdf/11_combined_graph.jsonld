      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-1089-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
