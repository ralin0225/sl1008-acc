      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "5. Where a pair of doors serves patient care rooms in Group I-2 occupancies, self-latching edgeor surface-mounted bolts are permitted on the inactive leaf provided that the inactive leaf is not needed to meet egress capacity requirements and the inactive leaf shall not contain doorknobs, panic bars or similar operating hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/ibc2021-1010.2.9.1",
    "@type": [
      "https://example.org/ibc/ontology/Provision"
    ],
    "https://example.org/ibc/ontology/bbox": [
      {
        "@value": "[85.197, 277.769, 304.295, 343.778]"
      }
    ],
    "https://example.org/ibc/ontology/heading": [
      {
        "@value": "Refrigeration machinery room"
      }
    ],
    "https://example.org/ibc/ontology/label": [
      {
        "@value": "1010.2.9.1"
      }
    ],
    "https://example.org/ibc/ontology/partOf": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.9"
      }
    ],
    "https://example.org/ibc/ontology/precedes": [
      {
        "@id": "https://example.org/ibc/2021/ibc2021-1010.2.9.2"
      }
    ],
    "https://example.org/ibc/ontology/sourcePage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 320
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1010.2.9.1 Refrigeration machinery room. Refrigeration machinery rooms larger than 1,000 square feet (93 m2) shall have not less than two exit or exit access doorways that swing in the direction of egress travel and shall be equipped with panic hardware or fire exit hardware."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1004.9-atomic-2",
    "@type": [
