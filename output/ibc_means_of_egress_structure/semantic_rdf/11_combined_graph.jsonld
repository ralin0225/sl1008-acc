        "@value": "shall_not"
      }
    ],
    "https://example.org/ibc/ontology/statementType": [
      {
        "@value": "prohibition"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "The tolerance between adjacent risers on a stepped aisle that were designed to be equal height shall not exceed 3/16 inch (4.8 mm)."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1010.5.1-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
