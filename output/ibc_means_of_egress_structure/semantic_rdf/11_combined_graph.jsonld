      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1031.4 Emergency escape and rescue doors. Where a door is provided as the required emergency escape and rescue opening, it shall be a swinging door or a sliding door."
      }
    ]
  },
