    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1030.13.2.2 Single access. For rows of seating served by an aisle or doorway at only one end of the row, the minimum clear width of 12 inches (305 mm) between rows shall be increased by 0.6 inch (15.2 mm) for every additional seat beyond seven seats where seats have backrests or beyond 10 where seats are without backrests. The minimum clear width is not required to exceed 22 inches (559 mm)."
      }
