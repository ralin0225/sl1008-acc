      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "1012.5.1 Width and capacity. The minimum width and required capacity of a means of egress ramp shall be not less than that required for corridors by Section 1020.3. The clear width of a ramp between handrails, if provided, or other permissible projections shall be 36 inches (914 mm) minimum."
      }
    ]
  },
