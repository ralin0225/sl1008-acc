      {
        "@value": "permission"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "Horizontal exits are permitted to comprise twothirds of the required exits from any building or floor area for occupancies in Group I-2."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1020.2-atomic-2",
