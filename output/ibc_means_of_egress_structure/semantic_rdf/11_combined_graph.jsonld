      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "3.3. The open-ended corridors are connected on each end to an exterior exit stairway or ramp complying with Section 1027."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-1025.2.4-atomic-1",
    "@type": [
      "https://example.org/ibc/ontology/AtomicRule"
    ],
