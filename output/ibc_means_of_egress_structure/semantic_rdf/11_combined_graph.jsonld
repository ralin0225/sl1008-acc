    "https://example.org/ibc/ontology/text": [
      {
        "@value": "provided that Items 3."
      }
    ]
  },
  {
    "@id": "https://example.org/ibc/2021/sem-ibc2021-ch10-list_item-0833-atomic-1",
    "@type": [
