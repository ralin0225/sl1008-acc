    "https://example.org/ibc/ontology/text": [
      {
        "@value": "6.1. For doors that swing in the direction of egress, the sign shall read, \"PUSH UNTIL ALARM SOUNDS. DOOR CAN BE OPENED IN 15 [30] SECONDS.\""
      }
    ]
  },
