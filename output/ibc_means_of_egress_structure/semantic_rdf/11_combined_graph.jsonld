        "@value": "obligation"
      }
    ],
    "https://example.org/ibc/ontology/text": [
      {
        "@value": "For doors that swing in the opposite direction of egress, the sign shall read, \"PULL UNTIL ALARM SOUNDS."
      }
    ]
  },
  {
